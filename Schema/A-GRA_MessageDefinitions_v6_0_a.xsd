				<xs:annotation>
					<xs:documentation>Indicates a search volume around the kinematics point or points.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalSurveillanceObjectBaseType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicate the object of the orbital surveillance task with the option to specify the kinematics source to use (ex: element set or single position state vector) and the kinematic data itself.</xs:documentation>
		</xs:annotation>
