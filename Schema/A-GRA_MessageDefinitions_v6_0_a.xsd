					<xs:documentation>The threshold value used by the current capability for tracks being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CoastSetting" type="uci:PO_CoastSettingValueType" minOccurs="0" maxOccurs="6">
