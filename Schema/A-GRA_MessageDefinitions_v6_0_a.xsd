	<xs:simpleType name="SMTI_CapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the first tier in the taxonomy of the radar Surface Moving Target Indicator (SMTI) Capability.  SMTI includes Ground Moving Target Indicator (GMTI) and Maritime Moving Target Indicator (MMTI) Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:annotation>
				<xs:documentation>For area, there is no requirement on the size of the area or the number of beams that can be used to cover it; spot indicates a small area that will be illuminated by a single beam and cued implies there will be an existing valid entity that is associated with the collection.</xs:documentation>
			</xs:annotation>
			<xs:enumeration value="AREA">
				<xs:annotation>
					<xs:documentation>Indicates a generally persistent SMTI Capability to search for moving targets within a large geospatial surface area, generally using many beams.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPOT">
				<xs:annotation>
					<xs:documentation>Indicates a generally short, focused SMTI Capability to search for moving targets at a point or small geospatial area, generally using a single beam.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CUED">
				<xs:annotation>
					<xs:documentation>Indicates a generally short, focused SMTI Capability to search for and acquire a specific surface moving target in a small geospatial area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SMTI_MessageOutputsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates messages that are an output by the Capability as the result of capability commands.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SMTI_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message.  For example, the ESM_Activity message for an ESM Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the ObservationMeasurementReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SMTI_SubCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates second tier in the taxonomy of the radar Surface Moving Target Indicator (SMTI) Capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MMTI">
				<xs:annotation>
					<xs:documentation>Indication that the radar should perform maritime MTI for the target or area of interest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GMTI">
				<xs:annotation>
					<xs:documentation>Indication that the radar should perform Ground MTI for the target or area of interest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_BALANCED">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of MMTI and GMTI beams. This specific enumeration value provides additional information to the radar indicating that the area of interest represents a fairly equal amount of water and land.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_MMTI_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of MMTI and GMTI beams.  This specific enumeration value provides additional information to the radar indicating that the area of interest is predominantly over water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_GMTI_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of MMTI and GMTI beams.  This specific enumeration value provides additional information to the radar indicating that the area of interest is predominantly over land.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
