	<xs:complexType name="OrbitalAnalysisObjectType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the specific details of the object that is to be analyzed for close approaches.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SpecificObject" type="uci:OrbitalObjectKinematicsSourceType">
				<xs:annotation>
					<xs:documentation>Indicates the orbital object that is the subject of the analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WorkingSOB_ID" type="uci:WorkingSOB_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the Space Order Of Battle that contains the record associated with the specific object that is the subject of the analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DebrisCloudID" type="uci:OrbitalDebrisCloudID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an orbital debris cloud that is the subject of the analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalConjunctionID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the unique ID of a previously identified orbital conjunction that is the basis for this debris estimate request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalConjunctionObjectType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Provides the details specific to the orbital object that is the subject of the analysis.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Identity" type="uci:SatelliteIdentityChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates a request for analysis based on the best/latest orbit data for the specified object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionKinematics" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematic state of the object at the time of conjunction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AnalyzedKinematics" type="uci:OrbitKinematicsReferencesType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a reference to the specific source of object kinematics that were assessed for the conjunction.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalConjunctionType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of orbital conjunction that is reported.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ConjunctionID" type="uci:OrbitalConjunctionID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Orbital Conjunction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time of closest approach.  The time indicated by this element should be less than the threshold in the request message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionType" type="uci:OrbitalConjunctionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of Orbital Conjunction that is reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the missed distance predicted by the Conjunction Assessment.  This range should be equal or less than the threshold in the conjunction assessment request message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalConjunctionObject" type="uci:OrbitalConjunctionObjectType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the details of the object or objects that are the subject of the Orbital Conjunction Assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionProbability" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the probability of a conjunction event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConjunctionConfidence" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the assurance level that the conjunction will happen.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisCloudID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the unique ID of an orbital debris cloud.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisCloudType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Details the orbital debris cloud included in an orbital debris estimate.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitalDebrisCloudID" type="uci:OrbitalDebrisCloudID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an orbital debris cloud.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:SatelliteIdentityChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the identity of the object in which the cloud debris is made up of.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EventTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Specifies the predicted or actual time of the event causing the debris cloud.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Debris" type="uci:OrbitalDebrisType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies the characteristics of the  debris within the orbital debris cloud.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DebrisCloudBoundary" type="uci:DebrisCloudBoundaryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the boundary attributes of the parent debris cloud.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to OrbitalDebris estimates.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateMDT" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>This data represents the characteristics that identify and describe an Orbital Debris Estimate.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitalDebrisEstimateID" type="uci:OrbitalDebrisEstimateID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID of this Orbital Debris Estimate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalDebrisEstimateRequestID" type="uci:RequestID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID of the associated OrbitalDebrisEstimateRequest.  This element is required when the estimate was made in response to an OrbitalDebrisEstimateRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CausalEvent" type="uci:OrbitBreakupEventDetailsType">
				<xs:annotation>
					<xs:documentation>Indicates the type of event for the orbital debris estimate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Estimate" type="uci:OrbitalDebrisEstimateType">
				<xs:annotation>
					<xs:documentation>Details the collection of orbital debris estimate information.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateMT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>This message contains the results of an Orbital Debris Assessment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:OrbitalDebrisEstimateMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateRequestMDT" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>This represents the characteristics that identify and describe an Orbital Debris Estimate Request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="EstimateType" type="uci:OrbitalBreakupEnum">
						<xs:annotation>
							<xs:documentation>Indicates the kind of debris creating event to model as the basis of the estimate.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EstimateResults" type="uci:OrbitalDebrisEstimateEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether the estimate results are provided as a file or detailed in the OrbitalDebrisEstimate message. In either case, an OrbitalDebrisEstimate message is still produced which identifies the FileMetadataID in the event that File is selected. The FileMetadata message does not reference the OrbitalDebrisEstimateID. The FileMetadataID is used to query for the file location/s of the associated file.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CausalEvent" type="uci:OrbitBreakupEventDetailsType">
						<xs:annotation>
							<xs:documentation>Indicates the type of event for the orbital debris estimate request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RespondBy" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time by which the request must be completed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AnalysisWindow" type="uci:TimeWindowType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies the time window of the orbital debris assessment, either by a range of dates or by a time duration.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateRequestMT" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>This message contains the request for an Orbital Debris Assessment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:OrbitalDebrisEstimateRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateRequestStatusMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>This represents the characteristics that identify and describe the status of an Orbital Debris Estimate Request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="CompletionStatus" type="uci:CompletionStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Intermediate status information for an assessment. Typically populated when sending periodic statuses of PROCESSING, but can also store start and finish times for this assessment.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitalDebrisEstimateID" type="uci:OrbitalDebrisEstimateID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the OrbitalDebrisEstimate that was generated in response to the OrbitalDebrisEstimateRequest.  This element is required when the sibling State element indicates COMPLETED.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>This message contains the status (Rejected, Pending, Completed) of an Orbital Debris Assessment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:OrbitalDebrisEstimateRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisEstimateType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the collection of Orbital Debris estimate information.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FileMetadataID" type="uci:FileMetadataID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the file associated with the specific debris estimate information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DebrisCloud" type="uci:OrbitalDebrisCloudType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Details the orbital debris cloud included in an orbital debris estimate. For single-object breakup events, there should only be one debris cloud. For collisions that involve 2 or more object, there will be a debris cloud for each object involved in the collision.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the unique ID of a particular piece of orbital debris which is associated with its unique characteristics.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalDebrisType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies the  debris within an orbital debris cloud.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitalDebrisID" type="uci:OrbitalDebrisID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a particular piece of orbital debris which is associated with unique characteristics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kinematics" type="uci:OrbitalKinematicsTLE_SV_Type">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the parent debris piece. This is represented in either state vector or element set form.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The mass of the orbital debris, in kilograms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Size" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The maximum length dimension of the piece of debris. Note, this value is in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDeltaVelocity_A_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type identifies the store values related to OPA DeltaV values. The DeltaVs may be optional when there are GEO station limits.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Hohmann" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Hohmann DeltaV is the minimum* delta velocity for the in-plane orbit change. The in-plane maneuvers change the semi-major axis (perigee and/or apogee).  [*It is the minimum assuming two maneuvers; a lower delta velocity is possible with bi-elliptic transfers involving three maneuvers.] Measured in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inclination" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Inclination DeltaV is the minimum delta velocity for the out-of-plane change, assuming alignment of the right ascensions. Measured in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Total" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Total DeltaV is the sum of the Hohmann and Inclination DeltaVs. Measured in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDeltaVelocity_B_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a difference in velocity, independent of frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the difference in the x value of velocity, in the frame of the values being compared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the difference in the y value of velocity, in the frame of the values being compared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the difference in the z value of velocity, in the frame of the values being compared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalDockingEventType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type identifies the specific details for a Docking Operational Proximity Analysis Event.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DockTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>The time at which two objects dock.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalElementSetParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the parameters for requesting an orbital element set. This information includes the time at which the element set is created and the orbital model used.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CreationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the orbital element set was created.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalModel" type="uci:OrbitalModelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orbital model used to create the element set.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalElementSetRequestParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the parameters for requesting an orbital element set. This information includes the time window of the element set results.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestWindow" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Time window within which orbital element set analysis/results are being requested.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalElementSetSourceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the source of the element set kinematics data.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SystemElementSetID" type="uci:SystemOrbitalElementSetID_Type">
				<xs:annotation>
					<xs:documentation>The unique identifier that correspond to a System's orbital element set (TLE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityElementSetID" type="uci:EntityOrbitalElementSetID_Type">
				<xs:annotation>
					<xs:documentation>The unique identifier that correspond to an Entity's orbital element set (TLE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExplicitElementSet" type="uci:TLE_BaseType">
				<xs:annotation>
					<xs:documentation>Indicates the default or "catalog" orbital element set (also known as two line element or TLE) for the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalEphemerisChoiceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the ephemeris expressed in one of several orbital kinematics standards.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StandardFrame" type="uci:OrbitalKinematicsStandardEphemerisType">
				<xs:annotation>
					<xs:documentation>Indicates ephemeris expressed in terms of a standard frame centered on a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitingObjectRelative" type="uci:OrbitalKinematicsRelativeEphemerisType">
				<xs:annotation>
					<xs:documentation>Indicates ephemeris expressed relative to a reference object that is in orbit around a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalEphemerisParametersType" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the parameters for requesting an orbital ephemeris. This information includes the time at which the element set is created, the interval between the ephemeris results, and the orbital model used.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CreationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the ephemeris was created.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepSize" type="xs:duration" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the interval between ephemeris results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PropagatorType" type="uci:EphemerisPropagatorChoiceType">
				<xs:annotation>
					<xs:documentation>The type of propagator used to create the ephemeris.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalEphemerisRequestParametersType" uci:version="001.001.001.001">
		<xs:annotation>
			<xs:documentation>Indicates the parameters for requesting an orbital ephemeris. This information includes the time window of the ephemeris results, the type of orbital model used, the interval between ephemeris results, and the ballistic and solar radiation pressure coefficients.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestWindow" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Time window within which ephemeris analysis/results are being requested.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PropagatorType" type="uci:EphemerisPropagatorChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The type of propagator to use.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalEphemerisSourceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the source of the ephemeris kinematics data.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SystemEphemerisID" type="uci:SystemOrbitalEphemerisID_Type">
				<xs:annotation>
					<xs:documentation>This element references the ephemeris ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityEphemerisID" type="uci:EntityOrbitalEphemerisID_Type">
				<xs:annotation>
					<xs:documentation>The ID type for UCI IDs that correspond to an ephemeris.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalEphemeris" type="uci:OrbitalEphemerisChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates ephemeris expressed in terms of a standard frame centered on a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalEphemerisType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>A series of points in the sky, separated in time by a specified time step, and covers the duration specified in the analysis window.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Window" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>The time window within which all the sibling StateVector elements (ephemerides) occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:EphemerisTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the ephemeris data.  See enumerate annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kinematics" type="uci:OrbitalEphemerisChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates an ephemeris expressed in either a standard frame or in relation to a reference object orbiting a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalFiltersQueryType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:QueryPET">
				<xs:sequence>
					<xs:element name="OrbitalFilterZone" type="uci:OpVolumeType">
						<xs:annotation>
							<xs:documentation>Indicates the zone to be filtered on.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RelationToOrbitalFilterZone" type="uci:ZoneRelationEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether the desired item is to be in relation to the associated zone.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsAccelerationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates an acceleration vector in the specified reference system.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the x value of acceleration in the specified reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the y value of acceleration in the specified reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the z value of acceleration in the specified  reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsChoiceType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the kinematics expressed in one of several orbital kinematics standards.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StandardFrame" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in terms of a standard frame centered on a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitingObjectRelative" type="uci:OrbitalKinematicsObjectRelativeType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed relative to a reference object that is in orbit around a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsFrameChoiceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Provides the choice of orbital kinematics reference frames.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OrbitalElements" type="uci:TLE_WithParametersType">
				<xs:annotation>
					<xs:documentation>Indicates the orbital element set for the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="J2K" type="uci:J2K_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Earth-Centered Inertial (ECI) J2000 (ECI-J2K) Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GCRS" type="uci:GCRS_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Geocentric Celestial Reference System (GCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BCRS" type="uci:BCRS_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Barycentric Celestial Reference System (BCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsObjectRelativeType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates kinematics for an orbital object, expressed in the Radial-Transverse-Normal Reference System, relative to another orbital object whose kinematics are relative to a celestial object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RelativeObjectKinematics" type="uci:RTN_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vectors for an orbital object, expressed in the Radial-Transverse-Normal Reference System, relative to the orbital object indicated by the sibling ReferenceObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceObjectKinematics" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vectors for an orbital object that serves as the reference for the relative kinematics given in the sibling RelativeObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceAsset" type="uci:AssetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the object whose kinematics are described in the sibling ReferenceObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsRelativeEphemerisType" uci:version="002.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates one or many kinematic vectors expressed, relative to the object described in the ReferenceObjectKinematics element.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RelativeStateVector" type="uci:OrbitalKinematicsRelativeStateVectorType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vectors for an orbital object that serves as the reference for the relative kinematics given by the sibling RelativeObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceAsset" type="uci:AssetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the object whose kinematics are described in the ReferenceObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsRelativeStateVectorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the kinematic vectors for an orbiting object used as a reference, and an orbiting object relative to the reference object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RelativeObjectKinematics" type="uci:RTN_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vectors for an orbital object, expressed in the Radial-Transverse-Normal reference system, relative to the orbital object indicated by the sibling ReferenceObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceObjectKinematics" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vectors for an orbital object that serves as the reference for the relative kinematics given by the sibling RelativeObjectKinematics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsStandardEphemerisType" uci:version="002.001.000.001">
		<xs:annotation>
			<xs:documentation>Indicates ephemeris expressed in terms of a standard reference frame centered on a celestial object.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="J2K_StateVector" type="uci:J2K_KinematicsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector(s) in the Earth-Centered Inertial (ECI) J2000 (ECI-J2K) reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GCRS_StateVector" type="uci:GCRS_KinematicsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector(s) in the Geocentric Celestial Reference System (GCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BCRS_StateVector" type="uci:BCRS_KinematicsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector(s) in the barycentric celestial reference system (BCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsStandardFrameChoiceType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides the choice of kinematics in terms of a standard coordinate reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="J2K" type="uci:J2K_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Earth-Centered Inertial (ECI) J2000 (ECI-J2K) Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GCRS" type="uci:GCRS_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Geocentric Celestial Reference System (GCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BCRS" type="uci:BCRS_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematic vector or vectors in the Barycentric Celestial Reference System (BCRS).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsTLE_SV_Type" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the choice between two-line element kinematic data or state vector (ECI J2K) kinematic data.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StateVector" type="uci:J2K_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates the object's kinematic state vector or vectors in the Earth-Centered Inertial (ECI) J2000 (ECI-J2K) reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TLE" type="uci:TLE_BaseType">
				<xs:annotation>
					<xs:documentation>Indicates the orbital element set (also known as two line element or TLE) of the object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitalKinematicsVelocityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a velocity vector in the specified reference system.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the x value of velocity in the specified reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the y value of velocity in the specified reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the z value of velocity in the specified reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalManeuverDetailsBaseType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>The common elements used to measure the impulse needed to perform a maneuver.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DeltaVelocity" type="uci:OrbitalDeltaVelocity_B_Type">
				<xs:annotation>
					<xs:documentation>The measure of the impulse needed to perform a maneuver.  It is used to determine the mass of propellant required for a given maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaVelocityMagnitude" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The magnitude of the velocity impulse needed to cause the spacecraft to transfer orbit. This value is equal to the RSS of the above DeltaVelocity X/Y/Z components.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaVelocityCovariance" type="uci:CovarianceMatrixType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The covariance matrix along with its associated category that defines the elements represented in the covariance matrix for the delta velocity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated rocket burn time to accomplish the maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaMass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The change in mass including the propellant.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalManeuverDetailsType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>Defines the maneuver details for a spacecraft to transfer orbit.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OrbitalManeuverDetailsBaseType">
				<xs:sequence>
					<xs:element name="StartEpoch" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>The time at which the maneuver started.  Formatted as UTC DateTime values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ManeuverType" type="uci:OrbitalManeuverTypeEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The reason why the maneuver was performed.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalManeuverID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type is the standard UCI ID type that correspond to an orbital maneuver.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalModelType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbital model used to create the ephemeris.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Name" type="uci:OrbitalModelNameEnum">
				<xs:annotation>
					<xs:documentation>The name of the orbital model.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Version" type="uci:VisibleString32Type">
				<xs:annotation>
					<xs:documentation>This field should contain the version number (i.e. 1.2.2).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalObjectComparisonDeltaType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type compares metrics for a Primary and Secondary Operational Proximity Analysis (OPA) object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PrimaryObject" type="uci:OrbitalObjectMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This type indicates the store values related to a single, primary OPA object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SecondaryObject" type="uci:OrbitalObjectMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This type indicates the store values related to a single, secondary OPA object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Difference" type="uci:OrbitalObjectMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This type indicates the store values related to the difference between the store values of primary and secondary OPA objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalObjectKinematicsSourceType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the Identity and Kinematics of a Resident Space Object (RSO).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Identity" type="uci:SatelliteIdentityChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the identity of an RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitKinematics" type="uci:OrbitKinematicsSourceType">
				<xs:annotation>
					<xs:documentation>Indicates the best/latest orbit data for the specified RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalObjectMetricsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type indicates the store values related to a single OPA object (Primary or Secondary).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Apogee" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The distance at which point the object is traveling the slowest on its orbit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Perigee" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The distance at which point the object is traveling the fastest on its orbit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inclination" type="uci:AngleHalfPositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The inclination, or vertical tilt, of the object's orbit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Longitude" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The longitude degree of the object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalProximityOperationsEventType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>This type specifies details for a Proximity Operations Operational Proximity Analysis Event. For canceled events, only the AnalysisEpoch is provided.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActorStateEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>State vector epoch time of the actor satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetStateEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>State vector epoch time of the target satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AnalysisEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Epoch time of the beginning of the analysis period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AnalysisDuration" type="xs:duration" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Timespan of the operations proximity analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DurationThreshold" type="xs:duration" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The threshold of the event duration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeThreshold" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The threshold of the event range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRangeEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Epoch time of the minimum range occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum range (apogee and perigee differences) within the event interval.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative speed of the event occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePosition" type="uci:RTN_PositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative position of the event occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeVelocity" type="uci:RTN_VelocityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative velocity of the event occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalRendezvousEventType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type specifies details for a Rendezvous Operational Proximity Analysis Event.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActorStateEpoch" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>State vector epoch time of the actor satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetStateEpoch" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>State vector epoch time of the target satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AnalysisEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Epoch time of the beginning of the analysis period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AnalysisDuration" type="xs:duration" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Timespan of the rendezvous analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EventIntervalCoverage" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Percentage of the event interval that is within the plane tolerance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberSubIntervals" type="xs:int">
				<xs:annotation>
					<xs:documentation>The number of oscillations within the event interval which are within the plane tolerance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum range (apogee and perigee differences) within the event interval.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRangeEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Epoch time of the minimum range occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRangeAnalysisDuration" type="xs:duration">
				<xs:annotation>
					<xs:documentation>Timespan of satellites within the range tolerance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumInPlaneSeparationAngle" type="uci:AngleHalfPositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum angle between the target's position and the projection of the actor's position into the target's nominal orbit plane over the event interval.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumInPlaneSeparationEpoch" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Epoch time of the minimum in-plane separation angle occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectComparisonAtEventStart" type="uci:OrbitalObjectComparisonDeltaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Difference in apogee, perigee, inclination, and longitude at start of event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectComparisonAtEventEnd" type="uci:OrbitalObjectComparisonDeltaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Difference in apogee, perigee, inclination, and longitude at end of event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectComparisonMeans" type="uci:OrbitalObjectComparisonDeltaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Difference in apogee, perigee, inclination, and longitude mean values across the event interval.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaV" type="uci:OrbitalDeltaVelocity_A_Type">
				<xs:annotation>
					<xs:documentation>Minimum delta velocity (m/sec) required to match the orbits, with components for the in-plane (Hohmann), inclination change, and total change.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ToleranceValues" type="uci:OrbitalToleranceValuesType">
				<xs:annotation>
					<xs:documentation>Rendezvous analysis threshold values for plane difference, range, delta velocity, longitude, and station limit longitude. These tolerance values indicate the allowable plus/minus values for each of these elements within this type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalSeparationEventType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type specifies details for a Separation Operational Proximity Analysis Event.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
