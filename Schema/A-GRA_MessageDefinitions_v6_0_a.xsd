	<xs:complexType name="OrientationCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RrRr" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 1 term of the result matrix. Roll Roll angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RrRp" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 2 term of the result matrix. Roll Pitch angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RrRy" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 3 term of the result matrix. Roll Yaw angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RpRp" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 2 Column 2 term of the result matrix. Pitch Pitch angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RpRy" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 2 Column 3 term of the result matrix. Pitch Yaw angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RyRy" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 3 Column 3 term of the result matrix. Yaw Yaw angle-angle covariance.  As radian is unitless result is unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrientationRateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the rate of change of the orientation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="YawRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Yaw.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PitchRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Pitch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RollRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Roll.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time, in Zulu format, at which the orientation rate data was measured, last known to be correct and/or predicted to occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrientationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Yaw" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the vehicle's rotation about the vertical axis (the axis from top to bottom through the aircraft) in a locally level, North-East-Down coordinate system centered on the vehicle.  By this definition, Yaw is zero when the aircraft is oriented toward true North and is equivalent to true North referenced heading.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Pitch" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the vehicle's rotation about the lateral axis (the axis parallel to the wings) in a locally level, North-East-Down coordinate system centered on the vehicle.  Pitch is zero when the aircraft is nose to tail level in the North-East plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Roll" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing vehicle's rotation about the longitudinal axis (the axis through the body of the vehicle from tail to nose) in a locally level, North-East-Down coordinate system centered on the vehicle.  Roll is zero when the aircraft is wing-tip to wing-tip level in the North-East plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time, in Zulu format, at which the orientation data was measured, last known to be correct and/or predicted to occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
