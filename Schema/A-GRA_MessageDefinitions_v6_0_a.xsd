					<xs:documentation>Radius of the hold turns in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Turn rate at which the hold turns are to be executed in radians per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnType" type="uci:MA_HoldTurnTypeEnum">
