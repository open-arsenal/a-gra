		</xs:annotation>
		<xs:sequence>
			<xs:element name="Priority" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Relative priority of asset being protected. 1 through 3 with 1 being highest priority.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Asset" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>The asset identifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProtectedAssetReturnPowerType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProtectedAsset" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Indicates an asset to be protected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProtectedAssetPredictedReturnPower" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the predicted main beam return power from the PE, observed by the threat emitter. Sibling ProtectedAsset must be present in order for ProtectedAssetPredictedReturnPower to be valid.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProtectedAssetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Priority" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Relative priority of asset being protected. 1 through 3 with 1 being highest priority.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Asset" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>The asset identifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProximityOperationsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This complex type allows for differentiating the type of proximity operation to perform.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RSO_ApproachType">
				<xs:sequence>
					<xs:element name="ProximityOrbit" type="uci:ProximityOrbitChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the type of proximity operation desired.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProximityOrbitChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This complex type provides the different types of proximity operations.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NaturalMotion" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates the proximity operation is a natural motion type. Natural motion circumnavigation where the orbital parameters are such that minimal stationkeeping is required to maintain proximity operations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForcedMotion" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates the proximity operation is a forced motion type. Forced motion requires consistent maneuvers to maintain proximity operations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="R_BarPerch" type="uci:R_BarApproachEnum">
				<xs:annotation>
					<xs:documentation>Indicates the proximity operation is an R-Bar Perch type. This means the proximity operation is along the radial vector of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="V_BarPerch" type="uci:V_BarApproachEnum">
				<xs:annotation>
					<xs:documentation>Indicates the proximity operation is a V-Bar Perch type. This means the proximity operation is along the velocity vector of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaOrbitalPlaneTolerance" type="uci:AngleHalfPairType">
				<xs:annotation>
					<xs:documentation>Indicates the proximity operation's orbital solution must be within the defined relative plane angles min and max.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PulseDataCollectCommandType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CollectionFrequency" type="uci:CollectionFrequencyType">
				<xs:annotation>
					<xs:documentation>Defines the single frequency for the Pulse Data collection to be used for all dwells defined in the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>The requested start time for the subsystem to begin the commanded pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellDuration" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Defines the length of each dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dwells" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Total number of collect dwells, to include the initial dwell and any repetitions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RepetitionInterval" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time (start-to-start) between dwells.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidth" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the expected PulseWidth of the desired Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the expected PRI of the desired Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalBandwidth" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the estimated bandwidth of the signal being processed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modulation" type="uci:ModulationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the modulation  type to be used for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataCollectType" type="uci:SignalTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of geolocation to be processed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SampleRate" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Set the sample rate for the collection, in Hz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FFT_PointsPerSample" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Set the number of points per sample that will be used in the Fast Fourier Transform processing on the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PulseDataID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to signals intelligence pulse data messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PulseDataMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PulseDataID" type="uci:PulseDataID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID of the Pulse Data message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:PulseDataSourceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates cross-referencing IDs for the Subsystem and/or Capability that is the source of the PulseData report; the Subsystem and/or Capability that detected the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NavData" type="uci:SignalNavDataType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Data describing the state of the platform and antenna at the time of pulse collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PhaseAndAmplitudeCalibrated" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the phase and amplitude data in the sibling Pulse element or elements is calibrated (TRUE) or uncalibrated/raw (FALSE).    Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Pulse" type="uci:PulseType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a signal intelligence Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PulseDataMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:PulseDataMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PulseDataSourceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Subsystem that collected the PulseData.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability that collected the PulseData.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Activity that collected the PulseData.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PulseType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the antenna component that collected the Pulse.  An antenna component could be a single antenna, an array or a logical grouping of antennas.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeSigmaType">
				<xs:annotation>
					<xs:documentation>Indicates a date and time stamp, in Zulu format, at which the Pulse was received.  Timestamp sigma may vary based on the frequency, signal to noise ratio and/or other characteristics of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Frequency" type="uci:FrequencyType">
				<xs:annotation>
					<xs:documentation>Indicates the frequency of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyDeviation" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the frequency deviation of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amplitude" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measured power level of the Pulse.  Note that this a normalized power as indicated by MilliwattPowerRatioType whose units are dBm.  The value may be raw or calibrated depending on PhaseAndAmplitudeCalibrated element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeAmplitude" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measured power level of the Pulse relative to receiver sensitivity.  The value may be raw or calibrated depending on PhaseAndAmplitudeCalibrated element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidth" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the pulse width of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthDeviation" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of the pulse width of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthChopped" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the sibling pulse width values are chopped and therefore could be erroneous.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseOnPulse" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the sibling pulse width values were measured during a pulse on pulse condition and therefore could be erroneous.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SNR" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the signal to noise ratio of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeLOS" type="uci:SignalRelativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the Relative line of sight (LOS) to the emitter of the Pulse, otherwise known as the angle of arrival (AOA).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModulationOnPulse" type="uci:ModulationOnPulseDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measured frequency and phase modulation characteristics of pulses of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DynamicRangeExceeded" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Pulse exceeded the dynamic range of the receiving Capability.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThresholdDetection" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates pulse train was formed from pulses near receiver threshold.  Some sibling measurements may be suspect.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HighPowerCorruption" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) corruption of the Pulse by an out-of-band high power signal is suspected and/or the Pulse is a harmonic spur of such a signal.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OnboardInterference" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) interference in the Pulse by an in-band signal transmitted by the same System as the Pulse receiver is suspected.  Such interference can be inferred based on blanking discretes, RF transmit reports, etc.  Optional when not measured/monitored.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PumpComponentExtendedStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the state of the pump by providing pressure, temperature, flow rate, flow direction, recirculating, line data, and/or valve data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ComponentExtendedStatusPET">
				<xs:sequence>
					<xs:element name="Pressure" type="uci:ComponentPressureType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the pressure data within the fuel pump.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Temperature" type="uci:ComponentTemperatureType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the temperature data within the fuel pump.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FlowRate" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the flow rate in liters per minute (lpm).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Direction" type="uci:VisibleString64Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the flow direction of the pump.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LineData" type="uci:LineDataStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the state of the line data within the pump by providing pressure, temperature, flow rate, and/or flow direction.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ValveData" type="uci:ValveDataStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the state of the valve data within the pump.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Recirculating" type="uci:EmptyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the tank is recirculating fuel.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="QualifyingTagsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="QualifiedSpecial" type="xs:unsignedShort" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to provide qualifying amplification to the reported object; Value of 0 indicates a simple notification that the object is elevated as "special" with respect to its defined Standard Identity, other values provide implementation specific qualification. A common range is [0,4094].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessSpecial" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the reported object should be treated with special care – tainted; Simple notification that object is tagged with some definition of "special" with respect to processing requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterOverride" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate that reported object should force through display or processing filters and be "included"; Indicate that the object should override any filtering associated with qualifying system id.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HighInterest" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the reported object should be treated as a high interest object with respect to processing requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Retain" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if this object should be automatically retained if updates aren't received.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QualifyingSource" type="uci:SystemMessageIdentifierType">
				<xs:annotation>
					<xs:documentation>Identifies the system that specified the qualification.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QuaternionAttitudeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Attitude" type="uci:QuaternionType">
				<xs:annotation>
					<xs:documentation>This element indicates the quaternion attitude in the corresponding coordinate reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AttitudeError" type="uci:QuaternionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element indicates the quaternion attitude error in the corresponding coordinate reference system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QuaternionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the quaternion attitude in the corresponding coordinate reference system. A quaternion rotation is made up of 4 numbers, whose values all have a minimum of -1 and a maximum of 1.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Qs" type="uci:UnitBallDoubleType">
				<xs:annotation>
					<xs:documentation>Indicates the scalar component of the quaternion that describes attitude in the reference system at the specified epoch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qx" type="uci:UnitBallDoubleType">
				<xs:annotation>
					<xs:documentation>Indicates the vector component of the quaternion that describes the x value of attitude in the reference system at the specified epoch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qy" type="uci:UnitBallDoubleType">
				<xs:annotation>
					<xs:documentation>Indicates the vector component of the quaternion that describes the y value of attitude in the reference system at the specified epoch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qz" type="uci:UnitBallDoubleType">
				<xs:annotation>
					<xs:documentation>Indicates the vector component of the quaternion that describes the z value of attitude in the reference system at the specified epoch.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryComparisonType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Tests if the specified Value is either less than, less than or equal to, greater than, or greater than or equal to any node in the sequence formed by the specified Step.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.  If not present, then the current context is evaluated.</xs:documentation>
				</xs:annotation>
