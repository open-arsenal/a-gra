			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AntennaPerformanceProfileType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DeltaInputPowerConsumption" type="uci:PowerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Additional (Delta) Input Power Required in Watts. "Delta" means the power above standby power utilized when the Activity is using the resource. Value represents OAP + Antenna Type being used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationFieldOfRegard" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>Indicates the elevation field of regard relative to its installation orientation/boresight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthFieldOfRegard" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>Indicates the azimuth field of regard relative to its installation orientation/boresight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DutyFactorLimit" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Maximum duty factor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamLimit" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Maximum number of beams.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Band" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>Indicates the bandwidth.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AntennaResourceAndBeamConfigurationsType" uci:version="002.002.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AntennaSupportCapabilityID" type="uci:SupportCapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Shared Antenna.  Shared Antennas are not taxonomically described in UCI.  It is left to external actors to organize, uniquely describe and identify them. Antenna ID is the same as the Antenna Support Capability ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberBeamConfigurationsRequested" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of Beam Configuration IDs requested to be allocated for the sibling AntennaID in this RF_Mode. This field determines the number of beam buffers (Beam Configuration Indices) needed per Antenna (e.g. to support beam steering). It is not necessary that the Number of Beam Configuration Index be the same for each RF_Mode. NumberBeamConfigurations is not necessarily equal to the number of instances of BeamBandWidthAndDataRate (if it is present) because each beam can have multiple beam configuration buffers for "in use" and "next possible" beam positions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResourceChoice" type="uci:AntennaResourceChoiceType">
				<xs:annotation>
					<xs:documentation>For a specified Antenna, the resource type or resource ID can be selected.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AntennaResourceChoiceType" uci:version="000.002.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AntennaResourceTypeID" type="uci:AntennaResourceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Resource Type (such a "Transmit, Quarter Sub-Array ") on a Shared Antenna. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResourceInstanceID" type="uci:AntennaResourceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific resource (such a "Transmit, Quarter Sub-Array Number Three") on a Shared Antenna. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="AntennaResourceID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique ID type that identifies Antenna Resources.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AntennaResourceInstanceStatusType" uci:version="001.002.000.001">
		<xs:annotation>
			<xs:documentation>Status of antenna resource instance.  Shared Antenna Resource Instances are not taxonomically described in UCI.  It is left to external actors to organize, uniquely describe and identify them.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AntennaResourceInstanceID" type="uci:AntennaResourceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific resource (such a "Transmit, Quarter Sub-Array Number Three") on a Shared Antenna. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Availability" type="uci:CapabilityAvailabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the availability of the Antenna Resource Instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaInputPowerConsumption" type="uci:PowerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Additional (Delta) Input Power Required in Watts. "Delta" means the power above standby power utilized when the Activity is using the resource. Value represents OAP + Antenna Type being used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccess" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The percent of time that the current resource instance is being utilized.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AntennaStatusType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents the status and settings for an Antenna that is shared by multiple back end functions.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BeamConfigurationSupport" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether or not this antenna accept beam configuration through the RF_ThreadInstanceSetupCommand.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a Capability whose use requires access to an antenna resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaPerformanceProfile" type="uci:AntennaPerformanceProfileType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides performance characterization on the AntennaID specified. AntennaID is the same as the Antenna SupportCapabilityID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResourceInstanceStatus" type="uci:AntennaResourceInstanceStatusType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides performance feedback on a given AntennaResourceInstance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedActivities" type="uci:ResourceAllocatorSupportedActivitiesType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the allocations to each supported Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AntennaType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AntennaID" type="uci:AntennaID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique identifier for this particular antenna.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaType" type="uci:AntennaTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of antenna that this antenna is.
 - OMNI antennas communicate in all directions
 - DIRECTIONAL antennas must be pointed in a specific direction for the antenna to be utilized.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedMode" type="uci:SupportedModeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the supported mode or modes of the antenna and its associated data rates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentUserLimit" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the number of unique users may utilize the antenna at the same time.  A value of 0 or a negative value indicates that there is no limit to the number of users.  A value of 1 indicates that only a single user may utilize the antenna at any given time.  Any other number indicates a firm or advised maximum number of concurrent users of the same antenna.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AO_ActivityCommandType" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="ChangeComponentSettings" type="uci:AO_ComponentSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Describes a command to change the AO sensor component settings.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeTarget" type="uci:TargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Change the target of the activity without stopping the activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the AO Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:AO_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of an AO Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AO_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:AO_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_ActivityType" uci:version="003.002.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="FOV" type="uci:NED_ConeType">
						<xs:annotation>
							<xs:documentation>Indicates the field of "view" (FOV), the pointing and angular extents, of the AO emission.  The FOV is referenced to the North-East-Down coordinate frame.  For optical systems that use a Turret SupportCapability for pointing, body referenced azimuth and elevation can be found in the Turret messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmissionFootPrint2D" type="uci:PolygonType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Footprint data is optionally provided if available.  Describes the extent of the emission cone reference point on the ground.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Target" type="uci:TargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Target data type is optional.  Describes specific target data for this Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentSettings" type="uci:AO_ComponentSettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This component is optional.  Indicates specific component settings for various elements for the AO sensor.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the repetition of the Activity.  If omitted, the Activity is not repetitive.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentRequired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Activity requires consent to transition from the ENABLED state to an ACTIVE state.  This element is required and shall be TRUE for Activities which require consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentState" type="uci:ConsentEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of consent for the Activity.  This element is required for Activities which require Consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityCommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="Target" type="uci:TargetType">
						<xs:annotation>
							<xs:documentation>Indicates the source of or explicit values for geospatial characteristics of the target of the OpticalCommand.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentSettings" type="uci:AO_ComponentSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Describes the component settings for the various AO sensors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmissionConstraints" type="uci:OpticalCollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This is an optional field.  Describes the various emission constraints for the Optical sensor components.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command.  If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:AO_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Describes an installed AO Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AO_Component" type="uci:AO_ComponentType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a Subsystem Component used to implement one or more AO Capabilities.  An AO Component's characteristics and performance directly influence those of the Capabilities.  A single Component can support multiple Capabilities.  Components may have settings/configuration independent of Capabilities.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityMT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:AO_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the AO_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentSetting" type="uci:AO_ComponentSettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the current settings for an AO component.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:AO_MessageOutputsEnum" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Specifies which messages are currently being output by the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultPackingPlan" type="uci:NITF_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current default NITF packing plan for the Capability. An AO_SettingsCommand can be used to change the current plan being used by the Capability to a commanded plan.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultJPEG_Settings" type="uci:JPEG_SettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current default JPEG settings for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:AO_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="AO_CapabilityType" uci:version="000.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:AO_CapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Active Optical taxonomy.  For AO, the first tier is an indication of the operational purpose or supported use case.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:AO_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EyeSafe" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability is operable when the host Subsystem is in an eye safe configuration.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command and control relevant Subsystem Component associated with the Capability.  Multiple Capabilities can use the same Component.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:AO_MessageOutputsEnum" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
