		</xs:annotation>
		<xs:sequence>
			<xs:element name="Function" type="uci:DamagedFunctionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a damaged function of the object.  Optional because the functional damage type enumeration is focused on threats but it is desirable to express damage for non-threat objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Level" type="uci:DamageLevelEnum">
				<xs:annotation>
					<xs:documentation>Indicates the level or amount of damage to the function given in the sibling Function element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The duration that the function is estimated to be non-operational.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Details" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Free text to handle specific details of the damage that cannot be covered in the other elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamagedHumanType" uci:version="000.000.000.000">
