			<xs:enumeration value="RD0">
				<xs:annotation>
					<xs:documentation>Ready, 0 - NFI; ready, but the degree of readiness cannot be determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RD1">
				<xs:annotation>
					<xs:documentation>Ready, 1 - Fully; fully capable of carrying out all mission requirements and/or has 75%–100% of wartime authorized equipment on hand.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RD2">
				<xs:annotation>
					<xs:documentation>Ready, 2 - Substantially; capable of carrying out most mission requirements but has significant degradation due to either personnel or equipment problems and/or has 50%–75% of wartime authorized equipment on hand.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RD3">
