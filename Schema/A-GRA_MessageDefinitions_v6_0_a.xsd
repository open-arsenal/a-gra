			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Entity which the Identification Command was initiated against.  If commanded against an Entity from the Subsystem, this Entity will also give the identity results and match the ID in the Results element.  If commanded against an Entity not from the Subsystem there will be two Entities with different IDs.  Additionally, upon successful completion, the Identification results are given in the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IdentificationResults" type="uci:IdentityConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the results of the Command for Identification.  Required upon successful completion of the Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_InteractiveType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Threshold" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the detection threshold level.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NoiseAdaptiveThresholdStatus" type="uci:NoiseAdaptiveThresholdStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Enables and disables the noise adaptive threshold.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GainControlMethod" type="uci:GainControlMethodEnum" minOccurs="0">
