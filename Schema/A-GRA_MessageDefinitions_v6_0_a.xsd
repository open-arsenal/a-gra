						</xs:annotation>
					</xs:element>
					<xs:element name="ForceTellIndicator" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates track data should be forced through controllable receive filters per MIL-STD-6016 DFI 354 DUI 002.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmergencyIndicator" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates vehicle has an emergency.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VoiceControl" type="uci:VoiceControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This type contains the connection data needed to communicate with a vehicle using voice radios.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivityBy" type="uci:ActivityByType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element indicates an activity, that isn't otherwise represented by UCI Tasks, Capability commands, etc. being performed by the Entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="Link16MetadataType" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The network connection on which this metadata will be sent and received.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceTrack" type="uci:Link16TrackNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Track Number string of the Link 16 PPLI reporting this unit. Must be reported on the network referenced in NetworkLinkID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportingSystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>SystemID of the Link 16 PPLI reporting this unit. Must be reported on the network referenced in NetworkLinkID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Airborne" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the associated vehicle is airborne per MIL-STD-6016 DFI 732 DUI 002.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ControlChannel" type="uci:Link16_ControlChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the channel used to control this vehicle per MIL-STD-6016 DFI 348 DUI 006.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FlightLeadIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates this vehicle is a flight lead per MIL-STD-6016 DFI 730 DUI 001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FlightLead" type="uci:TrackNumberOrEntityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The UUID of this vehicle's flight lead per MIL-STD-6016 DFI 769 DUI 039 or TN if there is no UUID for the TN. Can be a reference to the own vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenericUnitType" type="uci:GenericUnitTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of link on which the vehicle is reporting per MIL-STD-6016 DFI 1719 DUI 002.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionCommanderIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if this vehicle is the mission commander per MIL-STD-6016 DFI 1901 DUI 001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrecisionTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time when the precision position data was valid per MIL-STD-6016 DFI 792 DUI 008, 797/004, 380/001 and 380/008.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionTimeQuality" type="uci:PositionTimeQualityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Quality of the PrecisionTime field per MIL-STD-6016 DFI 283 DUI 007.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Site" type="uci:SiteEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of link unit being forwarded by the JTIDS/MIDS unit per MIL-STD-6016 DFI 1719 DUI 001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationalCapability" type="uci:OperationalCapabilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Air and Land Operational Capability based on MIL-STD-6016 DFI 753 DUIs 002 and 003.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Link16_Status" type="uci:ConnectionStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the availability of Link 16.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReconnaissanceStatus" type="uci:ReconnaissanceStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Status of installed RECCE systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkParticipationStatusIndicator" type="uci:NPSI_Enum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates to what degree the unit is participating in the Link 16 interface.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarChannelIndicator" type="uci:RadarChannelIndicatorEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the radar is operating in a single RF channel or an automatic frequency agility channel group.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarChannel" type="uci:Link16_RadarChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the Radar RF Channel or Automatic Frequency Agility Group selected. The frequency or frequencies associated with each radar channel or group is unique to each air specific type (SpecificVehicle).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissileChannel" type="uci:Link16_MissileChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the missile channel selected for the first weapon reported in StoreType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DefensiveJammerSystemInfo" type="uci:DefensiveJammerSystemInfoType" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates the type and status of a defensive jammer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="JammerStation" type="uci:JammerStationType" minOccurs="0" maxOccurs="10">
				<xs:annotation>
					<xs:documentation>Indicates the type of an external offensive jammer. Multiplicity size of 10 based on MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommCountermeasureSet" type="uci:CommCountermeasureSetEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type and status of the internal communication countermeasures set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActiveRelayIndicators" type="uci:Link16ActiveRelayIndicatorsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the status of a unit's re-control channel laying capability over various channels/networks.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionCommander" type="uci:TrackNumberOrEntityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The track number of the commander of a mission that the message originator is a member of. This track number may be own unit track number.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Link16ReferencePointDataStoreActionType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>Provides information about the Data Store actions along with the OpZone, OpVolume, OpLine, and OpPoint ID.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataStoreAction" type="uci:DataStoreActionEnum">
				<xs:annotation>
					<xs:documentation>Option of adding or removing item from data store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferencePointDataStoreID" type="uci:Link16ReferencePointDataStoreID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Stores the IDs of the OpLine, OpPoint, OpVolume, and OpZone.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Link16ReferencePointDataStoreID_ChoiceType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Provides information about the OpZone, OpVolume, OpLine, and OpPoint ID.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OpLineID" type="uci:OpLineID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to OpLines.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpPointID" type="uci:OpPointID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to OpPoints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpZoneID" type="uci:OpZoneID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to OpZones.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpVolumeID" type="uci:OpVolumeID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to OpVolumes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="Link16SystemMetadataType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base SystemMetadataPET. This specifies metadata for Link16.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SystemMetadataPET">
				<xs:sequence>
					<xs:element name="Data" type="uci:Link16MetadataType">
						<xs:annotation>
							<xs:documentation>Indicates the Link 16 Metadata for the System.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="Link16TextReportDataStoreActionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides the Data Store action and the ID of the Operator where the text report originates.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataStoreAction" type="uci:TextReportActionEnum">
				<xs:annotation>
					<xs:documentation>Option of enabling, disabling, or removing volatility.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorNotificationID" type="uci:OperatorNotificationID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to Operator Notifications.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Link16ThreatWarningDataStoreActionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides the Data Store action and the Relationship ID of the Threat Warning.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataStoreAction" type="uci:DataStoreActionEnum">
				<xs:annotation>
					<xs:documentation>Option of adding or removing item from data store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelationshipID" type="uci:RelationshipDesignationID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>UCI IDs that correspond to DisplayRelationships.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Link16TN_QuerySpecificDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Polymorphic extension of QuerySpecificDataPET that describes a query for Link 16-specific data related to a specified object, as identified by a Link 16 Track Number (TN).</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:QuerySpecificDataPET">
				<xs:sequence>
					<xs:element name="TrackIdentifier" type="uci:Link16TrackIdentifierType">
						<xs:annotation>
							<xs:documentation>Link 16 Track Number (TN) and optional reference to the specific external interface on which it is applicable.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="Link16TrackBlockType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a range of Link 16 Track Numbers (TNs).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LowTrackNumber" type="uci:Link16TrackNumberType">
				<xs:annotation>
					<xs:documentation>Indicates the track number of the lowest track in the block.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HighTrackNumber" type="uci:Link16TrackNumberType">
				<xs:annotation>
					<xs:documentation>Indicates the track number of the highest track in the block.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Link16TrackIdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TrackNumber" type="uci:Link16TrackNumberType">
				<xs:annotation>
					<xs:documentation>The Link 16 Track Number in string form. Limited to ZZ777.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExternalInterfaceID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The external interface that is reporting the associated track number for this entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LinkConnectionRequestType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ConnectCommand" type="uci:CommConnectionCommandEnum">
				<xs:annotation>
					<xs:documentation>Indicates a command to change the connection status of the individual data link.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommonSettingsChange" type="uci:CommControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to change waveform settings that are not waveform specific settings.  These are the generic settings that apply to most waveforms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkPortAssignments" type="uci:CommLinkPortMapType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the port assignments for this user data link. These can be separate from the primary network link used to establish network connectivity and serve to route data traffic through specific IO and or RF paths. The program related documentation will identify behavior for allowing port assignment changes to an Activity once connection is initiated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique identifier for this configuration of the individual data link network connection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LinkedRequirementType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of one of the Requirements which are linked with the intention to be executed in a coordinated way to achieve a common objective.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Required" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Identifies whether this Requirement is required when the coordinated Requirements are linked and executed in order to achieve the common objective.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LinkMetricsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LostRegained" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The number of communication links that failed and were subsequently re-established.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LostLinkSource" type="uci:LostLinkSourceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>The identifier of the lost link.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataRate" type="uci:DataRateType">
				<xs:annotation>
					<xs:documentation>The data rate of the communication link.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LinkRatesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UplinkRate" type="uci:DataRateType">
				<xs:annotation>
					<xs:documentation>Indicates the uplink data rate in bits per second of a communication system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownlinkRate" type="uci:DataRateType">
				<xs:annotation>
					<xs:documentation>Indicates the downlink data rate in bits per second of a communication system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LobeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PeakAmplitude" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measured peak RF power level of the Lobe.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeakTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the timestamp at which the PeakAmplitude occurred.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeInMainBeam" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measured time in main beam (TIMB), such as at the 3 dB points, of the Lobe.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GreatDepth" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates sufficient depth of modulation was measured on the lobe to enable lobe processing and therefore the sibling elements have met a minimum threshold of quality.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LocatedEllipseType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies an ellipse that has a location.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:EllipseType">
				<xs:sequence>
					<xs:element name="CenterPointChoice" type="uci:PointChoiceType">
						<xs:annotation>
							<xs:documentation>Point of intersection of the two axes.  This can be an absolute location or be specified relative to a separately defined reference frame.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LocatedRectangleType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Defines a rectangle that is relative to a geospatial location.  The geospatial location can be stationary or moving.  The moving location is relative to a reference specified in ReferenceFrame.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RectangleType">
				<xs:sequence>
					<xs:element name="CenterPointChoice" type="uci:PointChoiceType">
						<xs:annotation>
							<xs:documentation>The center point of the rectangle is the point of intersection of the two diagonals of the rectangle.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LocationAndStatusBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies the location and the availability of the product/file.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Status" type="uci:MediaLocationStatusEnum">
				<xs:annotation>
					<xs:documentation>Provides a rough indication of how long the product/file will be available at the sibling NetworkLocation.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Location" type="uci:ProductLocationType">
				<xs:annotation>
					<xs:documentation>The network and system location of the product/file.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LocationAndStatusExpireType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies the location and the availability of the product/file.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:LocationAndStatusBaseType">
				<xs:sequence>
					<xs:element name="Expires" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If this product (as identified by its ID) will not be available indefinitely, an expiration time should be provided to indicate the soonest time it may become inaccessible.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LocationFilterType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies that the content being filtered must be in the specified zone if the zone is marked inclusionary or outside of the zone if the zone is marked exclusionary.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Zone" type="uci:ZoneInclusionType">
				<xs:annotation>
					<xs:documentation>The geospatial zone to be used in the filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Location" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>A specific point location (2D or 3D) to be used in the filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="LocationType" uci:version="002.000.002.000">
