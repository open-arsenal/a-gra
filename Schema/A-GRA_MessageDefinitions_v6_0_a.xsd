					<xs:documentation>Indicates the delta transverse component of velocity in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalDelta" type="uci:SpeedType" minOccurs="0">
