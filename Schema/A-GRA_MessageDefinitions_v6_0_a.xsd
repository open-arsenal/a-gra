	<xs:complexType name="MissionDefinitionMDT" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="MissionDefinitionID" type="uci:MissionDefinitionID_Type">
						<xs:annotation>
							<xs:documentation>Uniquely identifies a mission definition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MissionID" type="uci:MissionID_Type">
						<xs:annotation>
							<xs:documentation>Uniquely identifies a mission.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ParentMissionID" type="uci:MissionID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifies one or more parent missions.  This defines a mission hierarchy which allows one mission type to be contained within other mission type or types.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrderTraceability" type="uci:OrderTraceabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an operational tasking order that is the source of the MissionDefinition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MissionType" type="uci:MissionCategoryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>An operator specified purpose or category of the mission.  This gives the ability for displays or services to filter missions by their type.  The absence of this element indicates that the mission has no special type.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MissionState" type="uci:MissionStateEnum">
						<xs:annotation>
							<xs:documentation>Indicates the current state of the mission: inactive or active.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TimeSpan" type="uci:DateTimeRangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time span for the mission.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Expired" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>This element indicates if the mission definition has expired per the ArchiveConfiguration element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AuthorizedSystemID" type="uci:SystemID_Type" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a system authorized to access mission definition. Systems who are listed are associated with planning or execution of the mission.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AuthorizedUserIdentifier" type="uci:UserIdentifierType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a user authorized to access mission definition. Users who are listed are associated with planning or execution of the mission.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ArchiveConfiguration" type="uci:ArchiveRequestType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Time reference for expiration of the stored mission definition and all associated persisted data.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MissionDefinitionMT" uci:version="002.000.003.000">
