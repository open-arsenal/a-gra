				</xs:annotation>
			</xs:element>
			<xs:element name="NextSegment" type="uci:SegmentEstimateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the RoutePlan Path and Segment that will be navigated following the sibling CurrentSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RoutePlanInterceptType" uci:version="000.000.000.000">
