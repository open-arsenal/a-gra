	<xs:simpleType name="SignalGeolocationControlEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the geolocation control state.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INITIATE">
				<xs:annotation>
					<xs:documentation>Initiate geolocation and stop at the discretion of the Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIATE_WITH_CLEAR">
				<xs:annotation>
					<xs:documentation>Clear the existing geolocation solution for the geolocation subject, then Initiate and proceed with geolocation per design, stopping at the discretion of the Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIATE_ONE_TIME">
				<xs:annotation>
					<xs:documentation>Initiate geolocation and stop after a single attempt.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIATE_UNTIL_STOP">
				<xs:annotation>
					<xs:documentation>Initiate geolocation and continue until the corresponding Activity is commanded to stop.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STOP">
				<xs:annotation>
					<xs:documentation>Stop geolocation for the specified geolocation subject.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SignalGeolocationMethodEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the method to be used for geolocation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TDOA">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via time difference of arrival (TDOA).  TDOA is precise temporal measurement of a signal from two or more known locations, resulting in data which can be used to solve for the emitter location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FDOA">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via frequency difference of arrival (FDOA).  FDOA is precise frequency measurement of a signal from two or more known locations, resulting in data which can be used to solve for the emitter location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRIANGULATION">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via triangulation of signal angles of arrival, usually from a signal received at two or more locations at (nearly) the same time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BEARINGS_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via interferometer phase difference measurements, updated over time as the detecting System moves relative to the emitter.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AZ_EL">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via azimuth AOA and elevation AOA, with or without DTED terrain correction.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AMPLITUDE">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined using a range estimate based on Apriori effective radiated power (ERP) and measured amplitude (assumed to be at the main beam peak).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ADVANCED">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via an advanced method.  This enumeration should only be used for methods whose name cannot be added to the schema.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial location of the emitter was determined via an unspecified method.  This enumeration should only be used temporarily while awaiting for a proposed named method to be added to the schema.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SignalLocationEnum" uci:version="000.000.000.000">
