				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_VelocitySigmaType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes a velocity in Radial-Transverse-Normal (RTN) sigmas.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadialSigma" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the radial sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransverseSigma" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the transverse sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalSigma" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the normal sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_VelocityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a velocity vector in the Radial-Transverse-Normal (RTN) reference frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Radial" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the radial component of velocity in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Transverse" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the transverse component of velocity in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Normal" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the normal component of velocity in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RuleResponseType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="RequirementsTemplate" type="uci:ResponseTemplateType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of processing a Requirements template.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivatePlan" type="uci:MissionPlanActivationCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of activating a specific, previously created MissionPlan or other sub-*Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenerateAlert" type="uci:ResponseAlertType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of generating a MissionContingencyAlert.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DoNothing" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates an explicit desire for no response when Option Rule is triggered.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RunwayCoordinatesType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies runway-specific coordinates.  These coordinates are specific to either takeoffs or landings as identified in AirfieldReportMDT.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Start" type="uci:Point3D_Type">
				<xs:annotation>
					<xs:documentation>The waypoint at the start of the runway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Threshold" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The waypoint at the nearest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Limit" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The waypoint at the furthest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RunwayID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to runways.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RunwayUsageDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies terms for using a runway.  These details can be used in the decision process when choosing a runway.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Priority" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field represents the runway priority to be considered when choosing between multiple available runways.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailableForEmergencyUse" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether this runway is available for use in case of emergency.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RxBeamType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This type references receive beam characteristics in use by an EA to perform tracking.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BeamID" type="uci:BeamID_Type">
				<xs:annotation>
					<xs:documentation>ID of the beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamWidths" type="uci:BeamWidthType">
				<xs:annotation>
					<xs:documentation>Widths of the beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackingMode" type="uci:EA_PointingEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element indicates the form of tracking being used to point the antenna.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamPointingReference" type="uci:BeamPointingReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates current beam pointing reference (Antenna, Body, Inertial, or Geodetic).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SafeAltitudeType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This field specifies a set of safe minimum approach altitudes and an emergency safe altitude.  This field also specifies the cylindrical area, defined by a center point and radius, where the altitudes apply.  This field defines minimum approach altitude and emergency safe altitude consistent with standard FAA instrument approach chart definitions (using UCI standard data types).  This information can, for example, be used to eliminate runways or extirpation points when the required altitude is not achievable during an anomaly.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CenterPointAndESA" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>This field specifies two pieces of information, the central point from which safe altitudes are defined, and (optionally) the emergency safe altitude.  The emergency safe altitude (ESA) is out to a 100 nm range.  ESA is defined by U.S. Air Force Terminal Instrument Procedures Service, document 8260.32.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumSafeAltitude" type="uci:AltitudeRadialPairType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This field defines the minimum safe altitudes (MSA) as defined by the FAA Instrument Procedures Handbook, Chapter 4 "Approaches", "Minimum Safe/Sector Altitude" section.  MSAs are published for emergency use on instrument approach charts.  MSAs provide 1,000 feet of clearance over all obstacles but do not necessarily assure acceptable navigation signal coverage.  Altitudes provided here are valid to a 25 nm radius range.  Each array element defines the MSA between the specified radial and the next element's radial.  As a result elements in the array need to have a radial greater than the preceding radial (i.e. in increasing radial order).  If only one element is provided, its radial is N/A as the MSA applies to the full circle.  Radials are measured inbounds to the center point, relative to true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SampleRateRangeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum sample rate the Service expects from a beam in samples per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the maximum sample rate the Service can accept from a beam, in samples per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_ActivityCommandType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="Attempt" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If specified, indicates the specific attempt of an activity to which this command applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapability" type="uci:SAR_CapabilityCommandSubCapabilityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the specific SAR SubCapability being invoked by the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TemporalConstraints" type="uci:CapabilityCommandTemporalConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates temporal constraints for the command. If omitted, the command should be scheduled immediately while satisfying other applicable constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OverrideRejection" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the Command shall be performed even though it was previously rejected.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command. If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:SAR_CollectionOptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates required optional aspects of SAR to be included in the Command. Only those options supported by the SAR Capability should be Commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:SAR_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlaneNormalUnitVector" type="uci:ECEF_UnitVectorType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unit normal vector for the plane in which imaging is to occur. If not included, the Capability determines the unit vector.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CoefficientOfTroposphericRefraction" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This coefficient is used to compensate for quadratic phase errors and geolocation errors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AtmosphericPropagation" type="uci:AtmosphericPropagationLossType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Atmospheric propagation information to be used when determining CNR or range/power levels.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DesiredWaveform" type="uci:SAR_DesiredWaveformType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines the desired waveform to use for the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PairIdentifier" type="uci:PairIdentifierEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Command's role in a pair collection. See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command. If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command. Only Products consistent with SAR and supported by the commanded SAR Capability should be requested. If omitted, no output Product should be produced. See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the SAR Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:SAR_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a SAR Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SAR_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_ActivityStatusDetailType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PercentageInFOR" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the radar is field of regard limited, this is the percentage of the volume that is currently in the radar FOR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualStartTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the first time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualStopTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the last time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentCoverage" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This represents the current percentage of the volume that has been successfully covered during the current attempt (as represented in the Attempts field).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntitiesReported" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is an indication of the number of current entities have are being reported as a result of this activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductsProduced" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Count of how many products have been produced as a result of this activity.  This does not include messages (e.g. Entity) produced.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedERP" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum estimated Effective Radiated Power (ERP) at the face of the array used for this activity attempt. If this attempt requires multiple spots, then this is the maximum estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumCNR" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum map Clutter to Noise Ratio (CNR) of imagery.  If this attempt requires multiple spots, this is the minimum estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AchievableEllipticity" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Achievable ellipticity ratio of range and azimuth resolution.  Magnitude between 1.0 and 4.0.  Sign specifies whether range or azimuth is favored. Positive values indicate better range resolution, negative values indicate better azimuth resolution.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AchievableResolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Achievable ground plane resolution for this attempt in meters/pixel.  If this attempt requires multiple spots, this is the maximum (finest) estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentActivity" type="uci:ConcurrentCollectionDetailsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This is the list of other activities that were executed concurrently with this activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentOccluded" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the percentage of the target SAR map area occluded as by terrain masking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeToService" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the amount of time that is needed for a single visit/service of the Target area. This is different from Revisit Period, since other Activities are not taken into account when calculating this metric.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentRadarTimeline" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the percentage of radar timeline which is taken up by this SAR activity. The Revisit Rate and Time to Service both affect this metric. For instance an Activity might execute frequently and require a long Time To Service, meaning it would take up much radar timeline.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentageInFOV" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the percentage of the volume that is currently in the radar FOV. The field of view is defined as the area where the radar can immediately see. The field of regard is defined as the area the radar can see after mechanical movement or rotation. Generally, the FOV is a subset of the FOR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeDirectionOfTarget" type="uci:RelativeDirectionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether target is on left or right side of the platform.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_ActivityType" uci:version="003.001.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:SAR_SubCapabilityEnum" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates a specific SubCapability associated with the Activity.  If omitted, all SubCapabilities of the associated Capability are applicable for the Activity.  This element is required whenever a subset of SubCapabilities of a Capability are used by the Activity. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Attempt" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>For activities that involve repetition parameters, this indicates the attempt to which this report applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RadarPointingTarget" type="uci:RadarPointingTargetType">
						<xs:annotation>
							<xs:documentation>Indicates details of the target that this Activity is directed against. The target can either be a discrete location defined by geospatial characteristics or a geographically referenced location specified by azimuth and elevation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Metrics" type="uci:SAR_ActivityStatusDetailType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates actual performance metrics that provide the system insight regarding the progress of an activity, description of the results of an activity and related stats. This is a list to provide reporting for all revisits between activity messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PolicyApplied" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>When TRUE, indicates the Activity could not be scheduled as requested but the radar was able to apply the command's CollectionPolicy and then successfully schedule or complete the activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AllProductsAndMessagesProduced" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Flag indicating whether or not all products (e.g. ProductLocation) and messages (e.g. Entity) expected to be produced by this activity have been output.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PredictedCollections" type="uci:SAR_PredictedCollectionsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Supports interaction with a capability assessment function. This allows a subsystem or a model of a subsystem to estimate future performance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEmployed" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which electronic protection IDs are in use for this activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MultistaticModeOptionsEmployed" type="uci:MultistaticModeOptionsEmployedType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which emitter IDs are in use for this activity and whether Multistatic Mode is enabled or disabled.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_AutomaticTargetDetectionParametersType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type extends SAR_ProcessingParametersType to provide processing parameters needed for Automatic Target Detection products from a SAR image product.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SAR_ProcessingParametersType">
				<xs:sequence>
					<xs:element name="MinimumSize" type="uci:DistanceType">
						<xs:annotation>
							<xs:documentation>The minimum size in meters of detections to find in the SAR image product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MaximumSize" type="uci:DistanceType">
						<xs:annotation>
							<xs:documentation>The maximum size in meters of detections to find in the SAR image product.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityCommandSubCapabilityType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates the subcapability, SAR or ISAR, for this command.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SAR" type="uci:SAR_SubCapabilityType">
				<xs:annotation>
					<xs:documentation>Indicates a subcapability of Synthetic Aperture Radar (SAR) for this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ISAR" type="uci:ISAR_SubCapabilityType">
				<xs:annotation>
					<xs:documentation>Indicates a subcapability of Inverse Synthetic Aperture Radar (ISAR) for this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityCommandType" uci:version="003.000.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:SAR_CapabilityCommandSubCapabilityType">
						<xs:annotation>
							<xs:documentation>Indicates the specific SAR SubCapability being invoked by the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MultistaticMode" type="uci:MultistaticModeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Multistatic Mode settings and associated data to be used for the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:SAR_CollectionOptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates required optional aspects of SAR to be included in the Command.  Only those options supported by the SAR Capability should be Commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:SAR_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlaneNormalUnitVector" type="uci:ECEF_UnitVectorType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unit normal vector for the plane in which imaging is to occur.  If not included, the Capability determines the unit vector.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CoefficientOfTroposphericRefraction" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This coefficient is used to compensate for quadratic phase errors and geolocation errors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AtmosphericPropagation" type="uci:AtmosphericPropagationLossType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Atmospheric propagation information to be used when determining CNR or range/power levels.  If multiple instances are given, each should be of a different band as indicated by the child element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DesiredWaveform" type="uci:SAR_DesiredWaveformType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines the desired waveform to use for the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PairIdentifier" type="uci:PairIdentifierEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Command's role in a pair collection.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command.  If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with SAR and supported by the commanded SAR Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:SAR_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed SAR Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SAR_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityOptionsType" uci:version="000.000.001.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the SAR_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPolicy" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the CollectionPolicy element in the SAR_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ATR" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports Automatic Target Recognition (ATR) element in the SAR_Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FTI_Supported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability can provide fixed target indication processing and generate the associated products. This processing can be initiated through the inclusion of the Fixed Target Indicator (FTI) flag in the SMTI command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceTxRxTaper" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the ForceTxRxTaper element in the SAR_Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentOperationSupported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the capability has the ability to run concurrently with at least one other capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MultistaticOptionsSupported" type="uci:MultistaticOptionsSupportedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the multistatic options supported by the Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicProtectionOptionsSupported" type="uci:ElectronicProtectionOptionsSupportedType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of EP capabilities that the current HW / SW allows an external actor to control for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedResolution" type="uci:SupportedResolutionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of Supported Sensor Resolution Capabilities that the current HW/SW allows an external actor to control for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COARPS_SAR_CollectionOption" type="uci:COARPS_SAR_CollectionOptionsEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a collection option for a COARPs SAR Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:SAR_CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Profile" type="uci:RF_ProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a RF Emission Profile currently applied to the Capability.  If omitted, there are no current profiles and the Capability is operating per its defaults and other constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:SAR_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates messages that are currently an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultPackingPlan" type="uci:NITF_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current default NITF packing plan for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultJPEG_Settings" type="uci:JPEG_SettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current default JPEG settings for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEnabled" type="uci:ElectronicProtectionOptionsEnabledType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which electronic protection options are currently enabled and will be used by this Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SAR_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityStatusType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusType">
				<xs:sequence>
					<xs:element name="SupportedResolutionAvailability" type="uci:SupportedResolutionAvailabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the availability of a supported resolution by ID.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CapabilityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:SAR_CapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the SAR taxonomy.  For SAR, the first tier is an indication of the geospatial extent of the resulting products.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:SAR_SubCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability of the SAR Capability; the second tier in the taxonomy of SAR.  For SAR, the second tier is an indication of the specific waveform and/or collection technique.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:SAR_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Band" type="uci:FrequencyRangeType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a frequency band/range used by the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NIIRS_Level" type="uci:NIIRS_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a NIIRS level supported by the Capability.  See annotations of the underlying type for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:SAR_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentFieldOfRegard" type="uci:ComponentFieldOfRegardType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Fields of Regard for each component in the capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CoherentChangeDetectionParametersType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type extends SAR_ProcessingParametersType to provide processing parameters needed for Coherent Change Detection products between two SAR image products.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SAR_ProcessingParametersType">
				<xs:sequence>
					<xs:element name="PercentResample" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>The percentage of resampling/downsampling that should occur when outputting the product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReferenceID" type="uci:ProductMetadataID_Type">
						<xs:annotation>
							<xs:documentation>Identifies which product in the InputProducts that should be used as the reference/base during processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MatchID" type="uci:ProductMetadataID_Type">
						<xs:annotation>
							<xs:documentation>Identifies which product in the InputProducts that should be used as the match during processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CollectionConstraintsQualityType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DesiredNIIRS" type="uci:NIIRS_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The desired NIIRS value.  See annotations of the underlying type for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumNIIRS" type="uci:NIIRS_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum required NIIRS value.  See annotations of the underlying type for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumResolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum acceptable SAE resolution for this collection.  This value may be used as an alternative to specifying a precise resolution value in CollectionOptions--&gt;CommandedResolution.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_CollectionConstraintsType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates a set of bounding requirements for the particular collection associated with this command. The subsystem should attempt to satisfy all specified constraints.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CollectionConstraintsType">
				<xs:sequence>
					<xs:element name="Quality" type="uci:SAR_CollectionConstraintsQualityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies the minimum and / or desired imagery Interpretability Rating Scale (IIRS) value or values for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ContinuousSpotAngle" type="uci:AngleQuarterType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Required sweep angle for the continuous spot scene.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AltitudeConstraints" type="uci:AltitudeRangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies the minimum and maximum sensor altitude for the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MaximumMappingTime" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the maximum time to be used for the current collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AzSubsetFraction" type="uci:AngleType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies azimuth constraints for the SAR collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LOS_BufferAngle" type="uci:AnglePositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies the acceptable tolerance about the commanded map angle.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NumImagesAzimuth" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies the number of images to collect along the azimuth of the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NumImagesRange" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies the number of images to collect along the range of the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PercentAzimuthCollection" type="uci:PercentType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to collect less imagery in azimuth than the default for the mode. Reduces collection time and resolution and is centered on the middle vector.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="HeadingDeviationTolerance" type="uci:AnglePositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Max heading deviation before subsystem aborts the scene.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CrossTrackDeviationTolerance" type="uci:DistanceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Max distance that the subsystem can be from the intended flight path before the scene is aborted.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Emcon" type="uci:EmconConstraintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to control the RF emissions associated with this command.  If this field is not populated, the service determines all parameters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MapGainAdjustment" type="uci:DecibelType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Relative gain adjustment to be used in post processing stages.  Positive values indicate additional gain to be applied.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OwnshipLocationConstraint" type="uci:PositionLocationUncertaintyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a location and a bound upon that location for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CollectionOptionsType" uci:version="001.000.000.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RadarCollectionOptionsType">
				<xs:sequence>
					<xs:element name="ATR" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a desire to perform Auto Target Recognition (ATR) processing on the results of the Task/Command (TRUE) or not (FALSE). Omission of the element is equivalent to FALSE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FTI" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a desire to perform Fixed Target Indicator (FTI) processing for the target of the Task/Command (TRUE) or not (FALSE). Omission of the element is equivalent to FALSE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ATR_NumberOfTargets" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the maximum allowed/expected number of targets/Entities that should result from the Auto Target Recognition (ATR) processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommandedResolution" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies the desired image resolution in meters/pixel.  This value must be one of the Resolution values in the SupportedResolution list from the SAR_Capability message.  CollectionConstraints--&gt;Quality--&gt;Minimum Resolution may be given as a lower bound on resolution as an alternative to this value.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SupportedResolutionID" type="uci:SupportedResolutionID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies the desired supported resolution id.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="COARPS_SAR_CollectionOption" type="uci:COARPS_SAR_CollectionOptionsEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a collection option for a COARPs SAR Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Band" type="uci:IEEE_FrequencyBandEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies the desired band to use for the collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CommandMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:SAR_CommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a SAR Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_CommandMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SAR_CommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CommandResponseType" uci:version="000.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Capability" type="uci:SAR_CapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates what type of target and / or processing is associated with this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapability" type="uci:SAR_SubCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Provides additional processing information for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductOutput" type="uci:ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with SAR and supported by the commanded SAR Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_CommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SAR_CommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_CommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:SAR_CapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of a SAR Capability.  Generally, if accepted, the command will result in one or more new SAR Activities being created and reported via the SAR_Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:SAR_ActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing SAR Activity (which was previously reported via the SAR_Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent SAR_Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SAR_DesiredWaveformType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="WaveformType" type="uci:SAR_WaveformSelectionEnum">
				<xs:annotation>
					<xs:documentation>This element defined the desired waveform to use for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForeignWaveform" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>This element defined the desired waveform to use for the collection as a foreign key type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SAR_DynamicImageParametersType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>This type extends SAR_ProcessingParametersType to provide processing parameters needed for Dynamic Image products of a SAR product.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SAR_ProcessingParametersType">
				<xs:sequence>
					<xs:element name="NumSubApertures" type="xs:unsignedByte">
						<xs:annotation>
							<xs:documentation>The number of subimages that the Dynamic Image should be processed into in the final product. A common range is [1,64].</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PercentAperture" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Percentage of the overall aperture used by the dynamic image.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResampleFactor" type="uci:DoublePositiveType">
						<xs:annotation>
							<xs:documentation>How much the output product should be resampled/downsampled. A common range is [1,3].</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EqualizeResolution" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Specifies whether the range and azimuth resolutions should be equal in the output product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DynamicProcessingType" type="uci:DynamicImageProcessingEnum">
						<xs:annotation>
							<xs:documentation>The type of Dynamic Image processing to take place.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_PredictedActivityDetailType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActivityState" type="uci:ActivityStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the current state of the Activity its state machine. See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityReason" type="uci:CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the sibling ActivityState element. This element is only expected when the Activity is in a potentially undesirable state such as constrained, failed or completed with less than optimum results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedStartTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the first time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedStopTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the last time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedERP" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum estimated Effective Radiated Power (ERP) at the face of the array used for this activity attempt. If this attempt requires multiple spots, then this is the maximum estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedMinimumCNR" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum map Clutter to Noise Ratio (CNR) of imagery. If this attempt requires multiple spots, this is the minimum estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedAchievableEllipticity" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Achievable ellipticity ratio of range and azimuth resolution. Magnitude between 1.0 and 4.0. Sign specifies whether range or azimuth is favored. Positive values indicate better range resolution, negative values indicate better azimuth resolution.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedAchievableResolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Achievable ground plane resolution for this attempt in meters/pixel. If this attempt requires multiple spots, this is the maximum (finest) estimate across all spots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedPercentageInFOR" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the radar is field of regard limited, this is the percentage of the area that is currently in the radar FOR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedPercentageOccluded" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the radar is line-of-sight limited, this is the percentage of the target that is currently in the radar FOR and not visible due to terrain occlusion.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentExecutionAssumed" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Flag to communicate whether or not the model assumed that concurrent execution was assumed in the model.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_PredictedCollectionsType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OwnshipLocation" type="uci:Point3D_Type">
				<xs:annotation>
					<xs:documentation>This defines the ownship location at the start of the predicted collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedCollectionMetrics" type="uci:SAR_PredictedActivityDetailType">
				<xs:annotation>
					<xs:documentation>Defines a set of fields which provide detailed information about the predicted activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_ProcessingParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base ProcessingParametersPET. It represents the base processing parameters needed for SAR processing. Specific algorithms will have an extended type for additional parameters. Available extension types include: SAR_AutomaticTargetDetectionParametersType, SAR_CoherentChangeDetectionParametersType, SAR_DynamicImageParametersType, SAR_TwoColorMultiViewParametersType.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProcessingParametersPET">
				<xs:sequence>
					<xs:element name="Weight" type="uci:ImageWeightEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The selected method for determining pixel values during image formation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Remap" type="uci:ImageRemapEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The selected algorithm to turn complex pixels into image pixels.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RegionOfInterest" type="uci:ImageRegionOfInterestPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies a sub-area to be processed within the image.  If the region of interest is omitted, the entire image will be processed.  In cases where processing is for paired products and a region is defined, the resulting product will contain as much of the region as possible within the overlapping area between the images and the region of interest.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SAR_SettingsCommandMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:SAR_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates messages that are an output by the Capability as the result of capability commands.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultPackingPlan" type="uci:NITF_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the default NITF packing plan for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultJPEG_Settings" type="uci:JPEG_SettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the default JPEG settings for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UnassignAll" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to break all current assignments of Activities to resources.  As a result, the resources could be assigned to other Activities, re-assigned to the original Activity or a combination of the two.  Equivalent to simultaneously commanding each current Activity to be Unassigned via the SAR_Command message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultEmcon" type="uci:EmconSettingType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defines the default emission control level to be applied to targets detected by this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEnabled" type="uci:ElectronicProtectionOptionsDefaultType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which advertised EP options should be applied to all Activities associated with this Capability. This list will completely replace any previously commanded list of EP options.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
