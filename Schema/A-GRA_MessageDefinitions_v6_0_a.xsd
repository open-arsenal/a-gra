				<xs:sequence>
					<xs:element name="MessageData" type="uci:StoreCarriageCapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreCarriageCapabilityStatusType" uci:version="002.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreCarriageCapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Subsystem which hosts the Strike Capabilities whose Activities are given in this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreCarriageCapabilityType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This reports the Carriage Capability Type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Support Capability corresponding to this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CarriageInformation" type="uci:StoreInformationBaseType">
				<xs:annotation>
					<xs:documentation>Indicates possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Verification" type="uci:StoreVerificationStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Verification state of the carriage if the carriage verification required by the system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreCarriageStatusType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>Possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreStatusType">
				<xs:sequence>
					<xs:element name="Configuration" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Configuration status of a piece of release equipment. For example, the rotation angle of a rotary launcher or the position of a trapeze.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InMotion" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates that the carriage is  in motion.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NextStoreStation" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>For stores systems that must move stores into release position, this commands the stores manager to move the specified store station into release position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextStoreType" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>For carriage systems that can carry a mixed load, this dictates what type of store is associated with the next release command.  The currently installed store types are reported in the StoreManagementStatus messages.  This is an alternative to selecting a specific store instance for release using the sibling NextStoreStation element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OverrideLAR" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When true, this commands the carriage to ignore LAR constraints when releasing a store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OverrideAttitudeConstraints" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When true, this commands the carriage to ignore the safety constraints placed on the host platform's attitude when releasing a store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MasterArm" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When true, the carriage is commanded to the armed state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReleaseConsent" type="uci:ReleaseConsentType">
				<xs:annotation>
					<xs:documentation>This provides the carriage the operator's consent to release or jettison a store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_CalculationWindHold" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>TRUE = hold the current wind velocity reported by the host platform and stop accepting updates.

FALSE = begin accepting wind velocity updates from the host platform and replace the previously held or override value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_CalculationWindOverride" type="uci:Velocity2D_Type">
				<xs:annotation>
					<xs:documentation>By specifying the wind velocity, the command source dictates the winds to be used in the calculation of the LAR for the hosted expendables.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerifyInventory" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Command to verify carriages and mission stores loaded onto a platform match an allowable configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="StoreConfidenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WeaponType" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>Indicates a type of weapon available. This element represents the MIL-STD-6016 specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the confidence of the declaration of the Entity's weapon identity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreInformationBaseType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Mnemonic" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Mnemonic representation of the store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Simulated" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates if this is a simulated Store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreLocation" type="xs:int" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Store location as defined by system related to int number of Store Point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="JettisonableOption" type="uci:StoreJettisonOptionsEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates if and in which situations a store can be jettisoned. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Powerable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the Store is powerable, i.e. can be turned on/off at will.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreInformationType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>Mission store representation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreInformationBaseType">
				<xs:sequence>
					<xs:element name="Ammo" type="xs:int">
						<xs:annotation>
							<xs:documentation>This represents the current available ammunition. As  ammunition is used, this value will decrease until it reaches zero or empty. For most bombs and missiles, this will be 0 or 1. For guns, it will be some integer greater than or equal to 0.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Fuzes" type="uci:FuzeType" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates the fuzes in the weapon.  Typically a weapon with a fuze will have them located in the nose, tail or both.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreItemType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>What store type Mission or Carriage.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Mission" type="uci:StoreLoadoutMissionType">
				<xs:annotation>
					<xs:documentation>A mission store in a loadout (i.e. a weapon).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Carriage" type="uci:StoreLoadoutCarriageType">
				<xs:annotation>
					<xs:documentation>A carriage within a loadout which may contain one or more weapons or other carriages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutCarriageType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An item in a loadout. Each item can have siblings in the tree, as well as hold other items.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Mnemonic" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>The mnemonic representations of this Carriage Store (i.e. name).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreLoadout" type="uci:StoreLoadoutChoiceType">
				<xs:annotation>
					<xs:documentation>A choice type to allow further recursion or a terminator to signal the end of recursion.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StoreList" type="uci:StoreLoadoutItemPET" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The list of all StoreType held  at this location and by any child StoreType carriage items in the order they appear in StoreType list.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Terminator" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>A uci:EmptyType used to signal the end of recursion.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutConfigurationID_Type" uci:version="000.000.000.000">
