	<xs:simpleType name="ExternalCommandExecutionStateEnum" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the status of an engagement.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EXECUTING">
				<xs:annotation>
					<xs:documentation>The entity is carrying out its mission or assignment.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CANCELED">
				<xs:annotation>
					<xs:documentation>The entity canceled the engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RECOMMEND_REATTACK">
				<xs:annotation>
					<xs:documentation>The entity has completed its mission against the target and recommends another airborne strike operation (ASO) mission be conducted against the same target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEAPON_ASSIGNED">
				<xs:annotation>
					<xs:documentation>Indicates preparation to engage or attack the target with an allocated weapon. Firing will not commence unless ordered or the target becomes eligible for destruction under existing doctrine and/or rules of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOCKED_ON">
				<xs:annotation>
					<xs:documentation>The entity's tracking radar is locked onto the target and ready to fire as soon as the target is within weapon range and the target is eligible for destruction.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGAGING">
				<xs:annotation>
					<xs:documentation>The entity is currently attacking the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEAPON_RELEASED">
				<xs:annotation>
					<xs:documentation>A weapon has been launched against the target, and the weapon has not yet impacted or timed out.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EFFECTIVE">
				<xs:annotation>
					<xs:documentation>The target has been engaged by the destroyed and is no longer a threat. Any previously reported engagement is broken.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PARTIALLY_EFFECTIVE">
				<xs:annotation>
					<xs:documentation>All targets have not been destroyed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_EFFECTIVE">
				<xs:annotation>
					<xs:documentation>Miss or abort; the target is not destroyed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGAGEMENT_BROKEN">
				<xs:annotation>
					<xs:documentation>The entity is terminating the previously reported or ordered action against the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HEADS_UP">
				<xs:annotation>
					<xs:documentation>The target constitutes a threat to friendly forces. The entity is unable to assure complete destruction of the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGAGEMENT_INTERRUPTED">
				<xs:annotation>
					<xs:documentation>Interpreted as ENGAGEMENT_BROKEN by US systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INVESTIGATING">
				<xs:annotation>
					<xs:documentation>This indicates the friendly is not yet tracking the target. The system will not fire on the target until ordered or the target becomes eligible for destruction under existing doctrine and/or rules of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHADOWING">
				<xs:annotation>
					<xs:documentation>The friendly is maintaining surveillance on the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERVENING">
				<xs:annotation>
					<xs:documentation>Then entity is taking action to divert the target from its intended flight path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COVERING">
				<xs:annotation>
					<xs:documentation>The friendly is maintaining a position relative to a designated target from which a successful intercept can take effect if needed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BDA_UNKNOWN">
				<xs:annotation>
					<xs:documentation>The friendly has completed its mission against the target and is reporting an unknown battle damage assessment (BDA).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TARGET_NOT_FOUND">
				<xs:annotation>
					<xs:documentation>The tasked target was not found.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EVALUATION_REPORT">
				<xs:annotation>
					<xs:documentation>The task is an evaluation report.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
