	<xs:complexType name="QueryMatchType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Performs the sub-query specified by Test for each node where the individual node is the context of the sub-query.  If the specified Step forms an empty sequence, then this sub-query evaluates to false.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Test" type="uci:QueryPET">
				<xs:annotation>
					<xs:documentation>The sub-query that is performed for each node of the sequence that is formed by the specified Step.  The context of the sub-query is an individual node of the sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryMessageType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>A data request for the messages matching the specified Message types and Query.  The Message types evaluated by the Query is restricted to only the ones specified by the MessageType field.  If neither MessageType nor Query is specified, then this query will yield all messages retained by the responder.</xs:documentation>
		</xs:annotation>
