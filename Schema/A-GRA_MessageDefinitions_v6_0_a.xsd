	<xs:complexType name="OrbitalSurveillanceLocationTargetType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the target of an Orbital Surveillance Task as defined by orbit kinematic data.</xs:documentation>
