			<xs:element name="Position" type="uci:InertialStateRelativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is used to specify the position to utilize as the last know position of the system to estimate.  This element is used as the starting time and location of position estimation. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>This element is used to specify the mission plan segment end point (waypoint) and capture time to utilize as the last known state/position of the system to estimate.  This element is used as the starting time and location of position estimation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CaptureTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time at which the starting segment was captured. If omitted, estimation should be based on a segment capture time of current system time.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EthernetSettingsType" uci:version="000.000.000.000">
