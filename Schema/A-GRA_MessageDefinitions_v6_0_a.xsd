	<xs:complexType name="MA_ActionPlanCommandMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommandID" type="uci:ActionPlanCommandID_Type">
				<xs:annotation>
					<xs:documentation>The ID of the Action Plan Command. Used to reference the command when providing status.</xs:documentation>
				</xs:annotation>
