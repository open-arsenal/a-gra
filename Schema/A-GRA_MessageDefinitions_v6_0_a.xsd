					<xs:documentation>Indicates the current setting of the target tracker setting on whether to attempt to acquire a target, lock onto the target, or release the target and stop tracking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackArea" type="uci:IncreaseDecreaseEnum" minOccurs="0">
