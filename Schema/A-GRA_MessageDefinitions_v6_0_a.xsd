		</xs:annotation>
		<xs:sequence>
			<xs:element name="Applicability" type="uci:PlanApplicabilityType">
				<xs:annotation>
					<xs:documentation>Indicates the System or Systems which have a direct relationship with the TaskPlan.  See annotations for the underlying type and its child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time window when the plan applies; the time window within which all the effects of the plan would occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parts" type="uci:TaskPlanPartsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts are included in the Plan.  Required when any sibling AllocatedTask elements are given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllocatedTask" type="uci:TaskAllocationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Task allocated to the System which the TaskPlan is allocated/applicable to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
