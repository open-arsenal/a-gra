	<xs:complexType name="ImageAugmentationParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type extends AugmentationProcessingParametersType to provide augmentation parameters specific to image processing.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:AugmentationProcessingParametersType">
				<xs:sequence>
					<xs:element name="FieldSet" type="uci:VisibleString1024Type">
						<xs:annotation>
							<xs:documentation>Represents the name of a configuration to apply to the product. The configuration identifies which data elements or fields of the product should be augmented.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ImageGeoRegistrationProcessingResultsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base ProcessingResultsPET for data output from a generic image geo-registration algorithm.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProcessingResultsPET">
				<xs:sequence>
					<xs:element name="GeoRegistrationQuality" type="uci:UnitBallDoubleType">
						<xs:annotation>
							<xs:documentation>The relative quality of the geo-registration process.

negative = the process completed but the registration accuracy was made worse.

0 = the process completed but the registration accuracy was not improved.

positive = the process completed with improved registration accuracy.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RegistrationResidual" type="xs:double">
						<xs:annotation>
							<xs:documentation>[meters]
This represents the average geo-registration residual error (in meters) after the process has completed.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ImagePixelGeoLocationProcessingParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base ProcessingParametersPET. It represents the base processing parameters needed for Image pixel geolocation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProcessingParametersPET">
				<xs:sequence>
					<xs:element name="PixelData" type="uci:PixelDataType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>These are the specific pixels from the source image for which the processing algorithms should generate geo-locations.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ImagePixelGeoLocationProcessingResultsType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base ProcessingResultsPET for data output from a generic pixel geo-location algorithm.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProcessingResultsPET">
				<xs:sequence>
					<xs:element name="Pixel" type="uci:PixelOutputDataType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>These are the specific pixels from the source image for which the processing algorithms should generate geo-locations.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ImageRegionOfInterestPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A base type for representing geographic areas of interest with regards to image processing.  Available extension types include CenterPointImageRegionOfInterestType,  CornerPointImageRegionOfInterestType.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="ImageSubheaderRevA_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TargetIdentifier" type="uci:VisibleString17Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. This field contains the identification of the primary target in the format, BBBBBBBBBBOOOOOCC, consisting of ten characters of Basic Encyclopedia (BE) identifier, followed by five characters of facility OSUFFIX, followed by the two character Country Code as specified in FIPS PUB 10-4. Default is ASCII spaces for all or any sub-part of this field. For use in the NITF Image Subheader TGTID, available from a concatenation of ACTDF BE Number and ACTDF Country Code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IID2" type="uci:IID2_ChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>NITF ImageSubheader Image Identifier 2, defined herein for either non-IPON-compliant NTIF producers or IPON-compliant NITF producers, mutually exclusively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSecurityClassification" type="uci:NITF_FileSecurityClassificationType">
				<xs:annotation>
					<xs:documentation>See simple type documentation. REQUIRED FIELD. NITF Image Subheader ISCLAS from ACTDF Primary Imagery Marking Guidance section Classification field. This field shall contain a valid value representing the classification level of the entire file. Valid values are T (=Top Secret), S (=Secret), C (=Confidential), R (=Restricted), U (=Unclassified).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSecurityClassificationSystem" type="uci:CharOrSpacePairsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCLSY from ACTDF Primary Imagery Marking Guidance section Image Security Classification System. This field shall contain valid values indicating the national or multinational security system used to classify the file. Country Codes per FIPS PUB 10-4 shall be used to indicate national security systems. The designator "XN" is for classified data generated by a component using NATO security system marking guidance. This code is outside the FIPS 10-4 document listing, and was selected to not duplicate that document's existing codes. If this field is all ECS spaces (0x20), it shall imply that no security classification system applies to the file.  NOTE: If ISCLAS is T, S, C, or R, then ISCLSY must be populated with a valid code for the security classification system used.  NOTE: If any of the following fields are populated with anything other than spaces, then FileClassificationSystem (FSCLSY) must be populated with a valid code for the security classification system used: ISCODE, ISREL, ISDCTP, ISDCDT, ISDCXM, ISDG, ISDGDT, ISCLTX, ISCATP, ISCAUT, ISCRSN, ISSRDT, and ISCTLN.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageCodewords" type="uci:NITF_CodewordsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCODE from ACTDF Primary Imagery Marking Guidance section Image Codewords. This field shall contain a valid indicator of the security compartments associated with the file. Values include zero to four of the digraphs found in MIL-STD-2500x Table A-4 (2 CAP alphas) each separated by a single ECS space (0x20): The selection of a relevant set of codewords is application specific. If this field is all ECS spaces (0x20), it shall imply that no codewords apply to the file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageControlAndHandling" type="uci:NITF_ControlAndHandlingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCTLH from ACTDF Primary Imagery Marking Guidance section Image Control and Handling. This field shall contain valid additional security control and/or handling instructions (caveats) associated with the file. Values include any one of the digraphs found in MIL-STD-2500x Table A-4 - the digraph in the OTHER CODEWORDS row may indicate single or multiple caveats and apparently may be any two ECS-A characters, not just CAP alphas. The selection of a relevant caveat or caveats is application specific. If this field is all ECS spaces (0x20), it shall imply that no additional control and handling instructions apply to the file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageReleasingInstructions" type="uci:NITF_ReleasingInstructionsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISREL from ACTDF Primary Imagery Marking Guidance section Releasable To. This field shall contain a valid list of country and/or multilateral entity codes to which countries and/or multilateral entities the file is authorized for release. Valid items in the list are one to 7 country codes as found in FIPS PUB 10-4 separated by a single ECS space (0x20). If this field is all ECS spaces (0x20), it shall imply that no file release instructions apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageDeclassificationType" type="uci:NITF_DeclassificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISDCTP from ACTDF Primary Imagery Marking Guidance section Image Declassification Type. This field shall contain a valid indicator of the type of security declassification or downgrading instructions which apply to the file. Valid values are DD (=declassify on a specific date), DE (=declassify upon occurrence of an event), GD (=downgrade to a specified level on a specific date), GE (=downgrade to a specified level upon occurrence of an event), O (=OADR), and X (= exempt from automatic declassification). If this field is not present, it implies that no file security declassification or downgrading instructions apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageDeclassificationDate" type="uci:NITF_DateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISDCDT from ACTDF Primary Imagery Marking Guidance section Declass Date. This field shall indicate the date (CCYYMMDD) on which a file is to be declassified if the value in File Declassification Type is DD. If this field is all ECS spaces (0x20), it shall imply that no file declassification date applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageDeclassificationExemption" type="uci:NITF_DeclassificationExemptionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISDCXM from ACTDF Primary Imagery Marking Guidance section Declass Exception. This field shall indicate the reason the file is exempt from automatic declassification if the value in File Declassification Type is X. Valid values are X1 to X8 and X251 to X259. X1 to X8 correspond to the declassification exemptions found in DOD 5200.1-R, paragraphs 4-202b(1) to (8) for material exempt from the 10-year rule. X251 to X259 correspond to the declassification exemptions found in DOD 5200.1-R, paragraphs 4-301a(1) to (9) for permanently valuable material exempt from the 25-year declassification system. If this field is all ESC spaces (0x20), it shall imply that a file declassification exemption does not apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageDowngrade" type="uci:NITF_DowngradeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISDG from ACTDF Primary Imagery Marking Guidance section Image Downgrade. This field shall indicate the classification level to which a file is to be downgraded if the values in File Declassification Type are GD or GE. Valid values are S (=Secret), C (=Confidential), R (=Restricted). If this field contains an ECS space (0x20), it shall imply that file security downgrading does not apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageDowngradeDate" type="uci:NITF_DateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISDGDT from ACTDF Primary Imagery Marking Guidance section Image Downgrade Date. This field shall indicate the date (CCYYMMDD) on which a file is to be downgraded if the value in File Declassification Type is GD. If this field is all ECS spaces (0x20), it shall imply that a file security downgrading date does not apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageClassificationText" type="uci:VisibleLatin1String43Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCLTX from ACTDF Primary Imagery Marking Guidance section File Classification Text. This field shall be used to provide additional information about file classification to include identification of a declassification or downgrading event if the values in File Declassification Type are DE or GE. It may also be used to identify multiple classification sources and/or any other special handling rules. Values are user defined free text. If this field is all ECS spaces (0x20), it shall imply that additional information about file classification does not apply.Note that chars in the range 0xA0 to 0xFF should be avoided.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageClassificationAuthorityType" type="uci:NITF_ClassificationAuthorityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCATP from ACTDF Primary Imagery Marking Guidance section Image Classification Authority Type. This field indicates the type of authority used to classify the file. Valid values are O (= original classification authority), D (= derivative from a single source), and M (= derivative from multiple sources). If this field contains an ECS space (0x20), it implies that file classification authority type does not apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageClassificationAuthority" type="uci:VisibleLatin1String40Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Image Classification Authority aka Image Classified By. See simple type documentation. NITF Image Subheader ISCAUT from ACTDF Primary Imagery Marking Guidance section Classified By. This field shall identify the classification authority for the file dependent upon the value in File Classification Authority Type. Values are user defined free text which should contain the following information: original classification authority name and position or personal identifier if the value in File Classification Authority Type is O; title of the document or security classification guide used to classify the file if the value in File Classification Authority Type is D; and Derive-Multiple if the file classification was derived from multiple sources and the value of the ISCATP field is M. In the latter case, the file originator will maintain a record of the sources used in accordance with existing security directives. One of the multiple sources may also be identified in File Classification Text if desired. If this field is all ECS spaces (0x20), it shall imply that no file classification authority applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageClassificationReason" type="uci:NITF_ClassificationReasonType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCRSN from ACTDF Primary Imagery Marking Guidance section Image Classification Reason. This field contains values indicating the reason for classifying the file. Valid values are A to G. These correspond to the reasons for original classification per E.O. 12958, Section 1.5.(a) to (g). If this field contains an ASCII space (0x20), it means that no file classification reason applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSecuritySourceDate" type="uci:NITF_DateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISSRDT from ACTDF Primary Imagery Marking Guidance section Image Security Source Date in form CCYYMMDD. This field shall indicate the date of the source used to derive the classification of the file. In the case of multiple sources, the date of the most recent source shall be used. If this field is all ECS spaces (0x20), it shall imply that a file security source date does not apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSecurityControlNumber" type="uci:VisibleLatin1String15Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader ISCTLN from ACTDF Primary Imagery Marking Guidance section Image Security Control Number. This field shall contain a valid security control number associated with the file. The format of the security control number shall be in accordance with the regulations governing the appropriate security channel or channels. If this field is all ECS spaces (0x20), it shall imply that no file security control number applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ImageSubheaderType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ImageSource" type="uci:AlphanumericDashSpaceUnderscoreString17OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field contains a description of the source of the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrimaryTargetIdentifier" type="uci:AlphanumericDashSpaceUnderscoreString3OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field contains the identification of the primary target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageIdentifier1" type="uci:AlphanumericDashSpaceUnderscoreString11OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field contains a valid alphanumeric identification code associated with the image. The valid codes are determined by the application.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageIdentifier2" type="uci:AlphanumericDashSpaceUnderscoreString9OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field can contain the identification of additional information about the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ICOM_N" type="uci:AlphanumericDashSpaceUnderscoreString21OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Image comment; free form ECS text.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ImpactConditionsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>The desired weapon impact conditions. Provided together with store/store variant type and quantity as part of a weaponeered DMPI.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Fuze" type="uci:FuzeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates mode and settings for a fuze of the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The desired weapon impact speed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactPoint" type="uci:ImpactPointType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired impact point on the body.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactAngle" type="uci:AzElReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired weapon impact angle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpinRate" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The rate of store rotation in RPM that the store is commanded to achieve at endgame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ImpactDetailsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the impact details of the munition or weapon.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApproachAngle" type="uci:ApproachAngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the approach angle of the impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactPoint" type="uci:ImpactPointType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the point of impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed at time of impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactPointDistanceFromDMPI" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the distance between the actual impact point and the specified DMPI of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccelerometerRecordedImpact" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present, indicates whether an accelerometer on board the munition or weapon detected an impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EffectIndicators" type="uci:WeaponEffectIndicatorsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the effect on stored weapons caused by the impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ImpactPointType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the point of impact.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="BodyLocation" type="uci:OffsetLocationErrorType">
				<xs:annotation>
					<xs:documentation>Indicates a body location as an X,Y,Z offset relative to the body coordinate system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BodyFace" type="uci:BodyFaceType">
				<xs:annotation>
					<xs:documentation>Indicates a body face and radial offset.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IncompleteProcessingType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>When processing multiple items (e.g. vehicle mission plans, route vulnerability assessments), this represents an item that failed to process successfully.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IncompleteItemID" type="uci:ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the item (message, System, Task, etc.) that failed to process. For example, if information for a particular vehicle was incomplete then the vehicle's SystemID might be given here to indicated planning/processing for that vehicle is/was incomplete.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reason" type="uci:CannotComplyEnum">
				<xs:annotation>
					<xs:documentation>Indicates the reason why the processing on the item failed and/or generally cannot be completed satisfactorily. See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A human-readable text description of the reason the processing can not complete satisfactorily.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IncRaPeriodVolumeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a volume defined by Inclination, Period, and Right Ascension deltas from the reference object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DeltaInclination" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>The delta inclination of the search volume measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaRightAscension" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>The delta inclination of the search volume measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaPeriod" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>The delta period of the search volume measured in seconds.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IncrementalChangeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element specifies the details of an incremental change.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ChangeWeight" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>How fast or slow the change will occur. The exact meaning of this value is left up to the implementation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeType" type="uci:IncrementalChangeEnum">
				<xs:annotation>
					<xs:documentation>The direction of change at a rate determined by the implementation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InertialStateRelativeType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:PointChoice4D_Type">
				<xs:annotation>
					<xs:documentation>Physical location of the referenced item in geospatial coordinates.  The use of the timestamp in this context represents the time the positional data was last measured. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionUncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Uncertainty of the physical location of the referenced item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainVelocity" type="uci:Velocity3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Vehicle's velocity in the current operating domain of the system.  Air vehicle components are in True Air Speed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GroundVelocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Representation of the vehicle's ground velocity as directional speed components.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeVelocity" type="uci:Velocity3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the vehicle's velocity, in units of m/s, in the separately defined reference frame referenced in the sibling Position element. This element should only be used when the RelativePoint choice is selected and the seperately defined reference frame is itself moving.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainAcceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vehicle's acceleration in the current operating domain of the system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the rate of orientation change of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InertialStateType" uci:version="001.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:Point4D_Type">
				<xs:annotation>
					<xs:documentation>Physical location of the referenced item in geospatial coordinates.  The use of the timestamp in this context represents the time the positional data was last measured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionUncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Uncertainty of the physical location of the referenced item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainVelocity" type="uci:Velocity3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Vehicle's velocity in the current operating domain of the system.  Air vehicle components are in True Air Speed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GroundVelocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Representation of the vehicle's ground velocity as directional speed components.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainAcceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vehicle's acceleration in the current operating domain of the system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the rate of orientation change of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Link16PositionQuality" type="uci:Link16_PositionQualityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The level of geodetic position uncertainty as estimated by the unit reporting its position via Link 16, where higher number indicates lower uncertainty and better quality. Values range from 0 to 15. (Based on MIL-STD-6016 DFI: 283 DUI: 001).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IngressEgressType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntryPoint" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The required entry point for the OpZone.  If omitted, the OpZone can be entered from any point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExitPoint" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The required exit point for the OpZone.  If omitted, the OpZone can be exited from any point.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InputProductType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ProductReference" type="uci:ProductReferenceType">
				<xs:annotation>
					<xs:documentation>Identifies a specific product instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductTypeReference" type="uci:ProductFilterType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies a product type and source.  If there is more than one filter type defined, treat the filters as a logical AND, where all criteria must be met to satisfy the filters.

This element can be used in 2 ways:

1.)  Streaming products:  Streaming products stream continuously and product management functions are applied to them continuously.  For example, continuous dissemination, classification, and processing of an EOIR video stream.  Streams may or may not have associated product metadata; therefore, type and source can be used to identify a specific stream as an input product to a product management function.

2.)  Discrete products:  For discrete products, this element can be used to make reference to all discrete products of a specified type.  This use is typically used to reference products that have already been created and is not intended to override a product management plan (download, dissemination, classification, etc.) over some indefinite time period in the future.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="InstallationDetailsType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Location" type="uci:OffsetLocationType">
				<xs:annotation>
					<xs:documentation>Indicates the location details associated with the physical installation of the Subsystem. Offsets are from the navigational center of the System to the Component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:ComponentOrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orientation details associated with the physical installation of the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Boresight" type="uci:ComponentOrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the boresight details associated with the physical installation of the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IntegerMinMaxType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Generic type for xs:int minimum and maximum allowable settings values.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="xs:int">
				<xs:annotation>
					<xs:documentation>Minimum allowable value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="xs:int">
				<xs:annotation>
					<xs:documentation>Maximum allowable value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IntegratorSettingsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Contains the parameters to control numerical integration used for the propagation of a spacecraft.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IntegrationMethod" type="uci:IntegrationMethodEnum">
				<xs:annotation>
					<xs:documentation>The method of integration to use.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsFixedStepSize" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Controls whether the integration step size is fixed or variable. When true, the integration step size is the same at every integration step. When false, the step size at any given integration step is determined by the integrator and may vary at each step.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialStepSize" type="uci:DoublePositiveType">
				<xs:annotation>
					<xs:documentation>The specified initial step size used by the integrator. For fixed-step integrators, this is the fixed step size. A common range is [0.001,9999.999].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ErrorTolerance" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The integration error used to control automatic step size changes. Not used for fixed-step integration methods.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumStepSize" type="uci:DoublePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum step size to be taken by the integrator when using adaptive step sizes. Not used for fixed-step integration methods. A common range is [0.001,9999.999].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumStepSize" type="uci:DoublePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The maximum step size to be taken by the integrator when using adaptive step sizes. Not used for fixed-step integration methods. A common range is [0.001,9999.999].</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InternationalDesignatorType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Year" type="xs:unsignedByte">
				<xs:annotation>
					<xs:documentation>Indicates a two-digit unsigned integer capable of representing the year of an event, such as when an Earth-orbiting object was launched. A common range is [0,99].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Number" type="xs:unsignedShort">
				<xs:annotation>
					<xs:documentation>Indicates the launch number of the year that the object was a part of. A common range is [1,999]. This is part of the unique designation for an Earth orbiting object assigned by the World Data Center-A for Rockets and Satellites (WDC-A-RS).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Piece" type="uci:LaunchPieceType">
				<xs:annotation>
					<xs:documentation>Identifier for the specific piece of a launch for the object.  This is typically an A-Z value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IntervalChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
