				<xs:annotation>
					<xs:documentation>Source coverage characteristics. If corresponding source coverage values are fixed for all measurements use the ObservationMeasurementSourceType fields, otherwise use this element within each measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeReported" type="uci:AltitudeReferenceUncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Altitude reference as reported by an external source.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceAngularExtent" type="uci:FOV_ExtentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Source angular extent characteristics. If corresponding source angular extent values are fixed for all measurements use the  ObservationMeasurementSourceType fields, otherwise use this element within each measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceResolution" type="uci:SourceResolutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Source resolution characteristics. If corresponding source resolution values are fixed for all measurements use the ObservationMeasurementSourceType fields, otherwise use this element within each measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CenterFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Center frequency of collection for measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Bandwidth" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Bandwidth of collection for measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceSpecifiedCharacteristics" type="uci:SourceCharacteristicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specified values of source characteristics for corresponding measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetIrradiance" type="uci:IrradianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Target irradiance measured detection range in Watts/meter/meter. Specific to IR sensors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfDetection" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Probably of detection for measurement, overrides value in Sensor Characteristics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfFalseAlarm" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Probability of false alarm for measurement, overrides value in Sensor Characteristics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SNR" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Signal-to-Noise ratio for measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SBR" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Signal-to-Background ratio for measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarCrossSection" type="uci:RCS_MedianType" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates the measured radar cross section of the object being observed which is the median of the RCS hits that participated in the formation of the observation. If sensor supports dual polarizations, then collection can provide output for two RCS median values, one per polarization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpaceObjectVisualData" type="uci:SpaceObjectVisualDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates supplemental data for visual measurements of space objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CustomCharacteristics" type="uci:NameValuePairType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>These supplemental characteristics are measurement specific and may not be relevant to all producers. Reference the data provider's interface control document or service specification to determine if this data will be provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MeasurementDurationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Timespan" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>The timespan for the data collection.  Both the Begin and End elements are mandatory.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfDwells" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Total number of collect dwells, to include the initial dwell and any repetitions.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MeasurementGroupID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>ID observed with a measurement group.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MeasurementID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>ID observed with a measurement.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MeasurementKinematicsChoiceType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="LOS_AzEl" type="uci:LOS_MeasurementWithUncertaintyType">
				<xs:annotation>
					<xs:documentation>Measurements provided in sensor relative line of sight frame (body or inertial) expressed in Azimuth/Elevation/Slant Range.  Reference kinematics are found in the Source element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LOS_Equatorial" type="uci:EquatorialKinematicsType">
				<xs:annotation>
					<xs:documentation>Measurements provided in the equatorial coordinate system expressed as Right Ascension/Declination/Range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orbital" type="uci:OrbitalKinematicsChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in one of several orbital kinematics frames/standards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WGS" type="uci:KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed according to the World Geodetic System (WGS) frame/standard.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ECEF_Kinematics" type="uci:ECEF_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed according to the Earth-Centered, Earth-Fixed frame/standard.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MeasurementSourceIdentityType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an Capability that generated the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaskID" type="uci:TaskID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier for the associated sensor tasking which caused the measurements to be created.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an Activity that generated the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the System that generated the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Service that generated the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Subsystem that generated the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Entity that generated these measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorSystemIdentity" type="xs:unsignedShort" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The unique identifier for the sensor system producing the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Satellite" type="uci:SatelliteIdentifierType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Catalog information for the satellite which generated these measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MeasurementType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MeasurementID" type="uci:MeasurementID_Type">
				<xs:annotation>
					<xs:documentation>Unique identifier for the measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IndependentMeasurement" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>If TRUE, indicates that the measurement may be treated as an independent input for fusion.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncorrelatedMeasurement" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that this measurement that did not correlate to a known object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Time at which the measurement is valid. Date/Time stamps provided within kinematic representations in sibling MeasurementData take precedence over this element when they are given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MeasurementGroupID" type="uci:MeasurementGroupID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates which measurements correspond to same object(s) (multipath processing).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LocalTrackIdentifier" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates local track identifier which measurements correspond to same object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an EntityID that's associated with the Observation Measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseDataID" type="uci:PulseDataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents the unique identifier(s) of the PulseData message(s) associated with the sibling MeasurementID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents the unique identifier(s) associated with the sibling MeasurementID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectIdentity" type="uci:IdentityConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the identity and confidence of the object being measured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedObjectKinematics" type="uci:ObjectKinematicsChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates kinematic data about the object known/predicted prior to collecting the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MeasurementCharacteristics" type="uci:MeasurementCharacteristicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the characteristics associated with the measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MeasurementKinematics" type="uci:MeasurementKinematicsChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measurement kinematics data with a choice of how its represented. If this does not exist, it indicates that no measurement was made with respect to the object identifying sibling elements (e.g., EntityID, local track identifier, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceKinematics" type="uci:SensorKinematicsChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics to be used as a reference location for the sibling values.  If omitted, the SourceKinematics in the ancestor Source element should be used as the reference location.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MessageConfigurationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a Message Configuration ID.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageConfigurationType" uci:version="003.001.002.001">
		<xs:annotation>
			<xs:documentation>A filter for messages. Each component has an 'and' relationship with the others.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MessageConfigurationID" type="uci:MessageConfigurationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is a unique ID of the particular message configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterID" type="uci:FilterID_Type">
				<xs:annotation>
					<xs:documentation>Represents the ID for a specific filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Filter" type="uci:QueryMessageType">
				<xs:annotation>
					<xs:documentation>Indicates the type of message being transmitted and filter parameters applicable. Filter elements with cardinality greater than 1 are logically ORed.  Sibling filter elements are logically ANDed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterStatus" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates if this filter is enabled (true) or disabled (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterDirection" type="uci:CommDataDirectionFiltrationEnum">
				<xs:annotation>
					<xs:documentation>Indicates the applicability of a filter in regards to the direction of data flow.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterInclusionType" type="uci:InclusionEnum">
				<xs:annotation>
					<xs:documentation>A message list can be inclusive or exclusive.  An inclusive list would contain all object IDs that a system should publish to other UCI systems.  An exclusive list implies that all object IDs for the specified message type should be published to other UCI systems except those object IDS specified in the list.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConnectionKey" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies an implementation specific Connection ID. This allows this message configuration to be applied to a specific Connection therefore only applying to message traffic on that connection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoteSystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>System ID of a remote System. If System ID is empty, It is assumed this is a broadcast.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitPeriodicity" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If specified, denotes the rate at which this message should be transmitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkNativeFilter" type="uci:DataLinkNativeFilterPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Extension point to allow for the unique data-link specific methods of addressing the native methods to control data ingress - egress.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Rank" type="uci:ComparableRankingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The importance of an item Task, Capability Command, Capability Activity, etc).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfigurationState" type="uci:CommConfigurationStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies whether this message is new or updated.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MessageDestinationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Forms the unique pair of a SystemID to a Data-Link specific ID.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>System ID of a remote Destination for Product and Message Data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidSystemStatus" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the referenced SystemID maps to a valid SystemStatus message. Otherwise the SystemID is a reference used to connect a DataDestination to a SystemID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataDestinationID" type="uci:DataDestinationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier for this data link destination. Allows a data link destination to be created before the UCI System has become active or associated with the data link connection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkNativeInfo" type="uci:DataLinkNativeInfoPET" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Extension point to allow for the unique data-link specific methods of addressing the native IDs required to properly adhere to its standard.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionFilterRecordDRLE" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="MessageTransmissionFilterRecordID" type="uci:MessageTransmissionFilterRecordID_Type">
						<xs:annotation>
							<xs:documentation>The unique ID of the message transmission list entry.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionFilterRecordID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a Message Transmission List Entry.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionFilterRecordMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageTransmissionFilterRecordDRLE">
				<xs:sequence>
					<xs:element name="MessageFilterParameters" type="uci:MessageConfigurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If specified, indicates the message topics, filters, and gateways.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionFilterRecordMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MessageTransmissionFilterRecordMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionListDRL" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordListBaseType">
				<xs:sequence>
					<xs:element name="ManagedLists" type="uci:MessageTransmissionListML">
						<xs:annotation>
							<xs:documentation>This element contains the managed lists within this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionListID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a Message Transmission List.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordListID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MessageTransmissionListMDT" uci:version="001.001.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageTransmissionListDRL">
				<xs:sequence>
					<xs:element name="MessageTransmissionListID" type="uci:MessageTransmissionListID_Type">
						<xs:annotation>
							<xs:documentation>The unique ID of the message transmission list.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SourceSystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>The source system to which the transmission list applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DestinationSystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The destination system(s) to which the transmission list applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
