			<xs:element name="RouteDeconfliction" type="uci:RouteDeconflictionAssessmentType">
				<xs:annotation>
					<xs:documentation>This element defines the response to a route deconfliction assessment request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteVulnerabilityMetrics" type="uci:RouteVulnerabilityMetricsAssessmentType">
				<xs:annotation>
					<xs:documentation>Indicates the results of assessment of vulnerability along a route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteThreatAssessment" type="uci:RouteThreatAssessmentType">
				<xs:annotation>
					<xs:documentation>Indicates the results of assessment of threats along a route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetMobility" type="uci:TargetMobilityAssessmentType">
				<xs:annotation>
					<xs:documentation>This element defines the response to a target mobility assessment request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleThreatAssessment" type="uci:VehicleThreatAssessmentType">
				<xs:annotation>
					<xs:documentation>This element defines the response to a vehicle threat assessment request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThreatNominationAssessment" type="uci:ThreatNominationAssessmentType">
				<xs:annotation>
					<xs:documentation>This element defines the response to a threat nomination assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AchievabilityAssessment" type="uci:AchievabilityAssessmentPET">
				<xs:annotation>
					<xs:documentation>This element defines the response to an achievability assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CoverageAssessment" type="uci:MA_CoverageAssessmentType">
				<xs:annotation>
					<xs:documentation>This element defines the response to a coverage assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_AssetFilterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="System" type="uci:MA_SystemFilterType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a filter on characteristics of a System asset. The asset filter is satisfied if a match is found in this element OR the sibling Entity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Entity" type="uci:MA_EntityFilterType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a filter on characteristics of an Entity asset. The asset filter is satisfied if a match is found in this element OR the sibling System element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_AuthorityCriteriaType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApprovalAuthorityID" type="uci:ApprovalAuthorityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This identifies the Approval Policy and the Operator Role Type that are the Authority. Specific C2 systems can be specified using the NonOperatorIdentifier field.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApprovalPolicyID" type="uci:ApprovalPolicyID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This identifies the Approval Policy that specifies the Requirements that can be used to set an EntityMT as a Target. If this field is not empty, the ApprovalAuthorityID must also be included and this field must match what is in the Approval Authority message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AuthorizedOperatorRoles" type="uci:OperatorRoleType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This identifies the Operator Role directly but must also match what is specified in the Approval Authority above. The ApprovalAuthorityID field must not be empty if this field is not empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_AuthorizationMDT" uci:version="002.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="AuthorizationID" type="uci:AuthorizationID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the authorization.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UserIdentifier" type="uci:MA_UserType">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the User being granted authorization to task. User types are SystemID, OperatorRoleID, or UserIdentifier</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the System which the User, given in the sibling UserIdentifier element, is authorized to task.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Precedence" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>This element indicates the precedence level at which the User is authorized to task the System. The larger the number, the higher the precedence. Any Tasks or Commands created by the User must not exceed this precedence level.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByPlanActivation" type="uci:MA_PlanAuthorizationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates authorization to send Plan Activation commands.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByRequirementExecution" type="uci:MA_RequirementAuthorizationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which Requirement (Effect, Action, Task, [Capability]Command, Response) execution/performance related activities are authorized.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByDataModification" type="uci:MA_DataModificationAuthorizationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which types of data messages are authorized to be created, modified or deleted.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByDataActivation" type="uci:MA_DataActivationAuthorizationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which types of data are authorized to be activated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByOperatorRequest" type="uci:MA_OperatorRequestAuthorizationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which types of request messages are authorized to be sent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PackageAuthorization" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates authorization to create, modify and dissolve teams.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ByPlatformSettingsModification" type="uci:MA_SettingsModficationAuthorizationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates authorization to send settings commands.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AuthorizedTime" type="uci:DateTimeRangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates the time range during which the Authorization applies. More specifically, this is the time range in which the User must create/submit Tasks in order for them to be allocated to the specified System. If omitted, the Authorization is applicable until removed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AuthorizedArea" type="uci:MA_AuthorizedZoneChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This choice type indicates the area over which the authorization applies. It contains either a zone defined in this message or the ID of an existing OpZone  </xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_AuthorizationMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_AuthorizationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_AuthorizedZoneChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AuthorizedZone" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>This element indicates the area over which the authorization applies. More specifically, this is the geospatial zone in which the target of Tasks created by the User must fall in order for them to be allocated to the specified System. If omitted, the Authorization is applicable to all areas.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AuthorizedOpZoneID" type="uci:OpZoneID_Type">
				<xs:annotation>
					<xs:documentation>This element indicates the area defined by an existing OpZone over which the authorization applies. More specifically, this is the geospatial zone in which the target of Tasks created by the User must fall in order for them to be allocated to the specified System. If omitted, the Authorization is applicable to all areas.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_AutonomousPlanCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the settings/usage of a planning process for autonomous planning.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningProcessID" type="uci:PlanningProcessID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the planning process whose autonomous invocation is described the sibling elements. Planning process are declared in the ControlStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstrainingPlans" type="uci:AutonomousPlanningConstrainingPlansType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates existing types of *Plans that can be used as constraints when invoking the planning process indicated by the sibling PlanningProcessID. The types of *Plans indicated here should be consistent with those supported by the planning process as indicated in the ControlStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherSystemConstrainingPlans" type="uci:AutonomousPlanningOtherSystemConstrainingPlansType" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates existing plans of another System that constrain planning. One for each descendant ConstraintUsage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutputPlanParts" type="uci:MA_PlanPartsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific Plan parts of the sibling PlanningType that the System can produce and include in the output Plan. The child choice in this element should match the sibling PlanningType. When omitted, the System can produce all of the Plan parts for the sibling PlanningType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResultsInMissionPlan" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>In some cases, the commanding service or HMI may not want to receive the planning process summarized in a MissionPlan message. If TRUE, the results will be published in individual *Plan messages and summarized in a published MissionPlan message. If FALSE, the results will be published in individual *Plan messages without a summary MissionPlan message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates the state to use for the corresponding element in the *PlanCommand when invoking the planning process.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_AvailabilityInfoType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Availability" type="uci:CapabilityAvailabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the availability for data, e.g., Capability, SubCapability, SupportCapability, Component, or other.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailabilityReason" type="uci:MA_CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the sibling Availability element. This element is only expected when there is a potentially undesirable state such as faulted, temporarily unavailable or otherwise expects less than optimum results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextAvailableWindow" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a prediction of when the next time window is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_AvailableNetworkEndPointsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Published available network endpoints as discovered on network in accordance with the published comm plan.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Individual network endpoint's unique system ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndpointLabel" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human readable text label with content meaningful to human operators.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_BanzaiType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TerminationType" type="uci:MA_InterceptTacticTerminationTypeEnum">
				<xs:annotation>
					<xs:documentation>This field is the Termination type for the Banzai maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_BodyReferenceAccelerationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Body-referenced acceleration components along the x, y, and z axis.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X_Accel" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Body-referenced acceleration component along the longitudinal (x or roll) axis, measured in meters/sec^2</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y_Accel" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Body-referenced acceleration component along the lateral (y or pitch) axis, measured in meters/sec^2</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z_Accel" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Body-referenced acceleration component along the vertical (z or yaw) axis, measured in meters/sec^2.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the acceleration data was measured or last known to be correct. The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_BodyReferenceOrientationRateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Body-referenced attitude rate components along the x, y, and z axis.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RollRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Body-referenced attitude rate component along the longitudinal (x or roll) axis, measured in radians/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PitchRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Body-referenced attitude rate component along the lateral (y or pitch) axis, measured in radians/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="YawRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Body-referenced attitude rate component along the vertical (z or yaw) axis, measured in radians/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct. The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CannotComplyDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type shall be used to specify details for why FA cannot comply with a flight command.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ValidationResult" type="uci:MA_ValidationResultEnum" minOccurs="0" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>In case of flight command rejection, provides the reason for Flight Autonomy rejection. Further details can be provided by Flight Autonomy through the ValidationResultReason. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidationResultReason" type="uci:MA_ValidationResultReasonType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>In case of flight command rejection, provides additional context for Flight Autonomy rejection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CannotComplyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Reason" type="uci:MA_CannotComplyEnum" minOccurs="1" maxOccurs="47">
				<xs:annotation>
					<xs:documentation>Indicates the reason why an action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed and/or generally can't be completed satisfactorily. See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a human-readable text description of the reason for the "can't comply".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedID" type="uci:ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an ID corresponding to another object that is associated with or the cause of the "can't comply".</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CAP_EstimatedDownrangeSensorCoverage_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Percent" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Percent of time that at least one vehicle is on the downrange/hot leg.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableTimespan" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Indicates timespan the estimated downrange/hot leg coverage applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CAP_EstimatedDownrangeTimeGap_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TimeGap" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Time gap when no vehicles are on the downrange/hot leg.</xs:documentation>
