	<xs:complexType name="EntityOrbitalVCM_RequestMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="EntityID" type="uci:EntityID_Type">
						<xs:annotation>
							<xs:documentation>This element represents the unique identifier of the entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResultsInNativeMessage" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>If TRUE this element specifies that the response to this message should be an EntityOrbitalVCM message. If FALSE the orbital VCM data that is generated should be bundled inside the response.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Parameters" type="uci:OrbitalVCM_RequestParametersType">
