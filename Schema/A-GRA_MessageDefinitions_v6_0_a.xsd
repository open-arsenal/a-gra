	<xs:complexType name="CommTerminalActivityCommandType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="ActivateProfileID" type="uci:CommProfileID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The ID of the Profile to which this activity should be modified to.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeDependentActivity" type="uci:DependentActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Changes Activities that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.  This is used to tie Activities within or across subsystems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResourceSelection" type="uci:ResourceSelectionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the resulting Activity. This allows Mission Processing to direct an specific antenna, antenna resource type, or antenna resource instance to be used by the resulting Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConnectionRequest" type="uci:CommConnectionCommandEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the connection status of the waveform.  Note that this field applies to the waveform's status with respect to joining or disconnecting from the network.  It does not directly apply to the connection status of individual links maintained by the waveform.  (The waveform's connection status may indirectly impact the connection status of individual data links.  For example, a connection request to DISCONNECT would likely cause the individual data links to disconnect and would nominally cause the waveform to disconnect from the network.).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonSettingsChange" type="uci:CommControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change waveform settings that are not waveform specific settings.  These are the generic settings that apply to most waveforms.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkPortAssignments" type="uci:CommLinkPortMapType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Identifies the ports to assign to the connection to form the link. The program related documentation will identify behavior for allowing port assignment changes to an Activity once connection is initiated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkConnectionRequest" type="uci:LinkConnectionRequestType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the connection status of the individual data links managed by the waveform. Generally, a link's connection status must be CONNECTED for the waveform to transmit payload data over the communication medium or for the waveform to receive transmissions from the communication medium.  Note that this parameter is not available until after a CommActivity is created and may not be available until the waveform has joined the network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a unique identifier for the configuration of an individual network connection.  Provides for the correlation of network link to a new activity or to an existing activity that will be updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WaveformSpecificSettingsChange" type="uci:CommWaveformActivityCommandPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change waveform settings that are either unique to the type of waveform specified by the associated capability or not available in the CommonSettingsChange.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VerboseStatus" type="uci:VerboseStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides means to control the generation of verbose Activity messages that provide full field reporting.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the communication capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:CommTerminalActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a communication capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommTerminalActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:CommTerminalActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalActivityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityBaseType">
				<xs:sequence>
					<xs:element name="ConnectionStatus" type="uci:CommConnectionStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether the waveform has joined the network.  The connection status reflects information about the waveform capability with respect to its network connectivity (typically at the physical and medium access control--MAC--layers).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonSettingsStatus" type="uci:CommControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates general waveform configuration settings that apply to all waveforms.  Note that these settings do not apply to individual data-link connections provided by the waveform or to the logical link control layer (LLC) and above, but do apply to the physical and medium access control layers that are just to maintain the waveforms connection to the network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentProfileID" type="uci:CommProfileID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The ID of the Profile to which this activity is currently executing with.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UserLinkStatus" type="uci:UserLinkStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Encapsulates the user link information that indicates the state and configuration of the individual user links, which the waveform uses to transport the payload data over the communication medium.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkPortMap" type="uci:CommLinkPortMapType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a reflection of what port assignments (IO and RF) are associated with this link. It is possible to have more than one to reflect multiple simultaneous paths.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkStatistics" type="uci:CommLinkStatisticsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>For the periodicity of this message this is a report of the statistics provided by this capability and its links.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WaveformSpecificSettingsStatus" type="uci:CommWaveformActivityPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates waveform state information regarding the waveform's network access.  (Typically below Medium Access Control--MAC---and physical layers.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TerminalUniqueKey" type="uci:ForeignKeyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Serving a similar as a MAC address in TCP/IP, the TerminalUnique ID provides the waveform's unique identifier on the network (where needed).  This value would typically be loaded from an MDF, where necessary.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VerboseStatus" type="uci:VerboseStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides current settings for the control of the generation of verbose Activity messages that provide full field reporting.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityCommandType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
						<xs:annotation>
							<xs:documentation>Identifies the Communications Subsystem.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResourceSelection" type="uci:ResourceSelectionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the resulting Activity. This allows Mission Processing to direct an specific antenna, antenna resource type, or antenna resource instance to be used by the resulting Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DependentActivity" type="uci:DependentActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Changes Activities that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.  This is used to tie Activities within or across subsystems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConnectionRequest" type="uci:CommConnectionCommandEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the connection status of the waveform.  Note that this field applies to the waveform's status with respect to joining or disconnecting from the network.  It does not directly apply to the connection status of individual links maintained by the waveform.  (The waveform's connection status may indirectly impact the connection status of individual data links.  For example, a connection request to DISCONNECT would likely cause the individual data links to disconnect and would nominally cause the waveform to disconnect from the network.).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonSettingsChange" type="uci:CommControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change waveform settings that are not waveform specific settings.  These are the generic settings that apply to most waveforms.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivateProfileID" type="uci:CommProfileID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The Profile to which this activity should be instantiated to.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkPortAssignments" type="uci:CommLinkPortMapType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Identifies the ports to assign to the connection to form the link.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a unique identifier for the configuration of an individual network connection.  Provides for the correlation of network link to a new activity or to an existing activity that will be updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VerboseStatus" type="uci:VerboseStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides means to control the generation of verbose Activity messages that provide full field reporting.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WaveformSpecificSettings" type="uci:CommWaveformCapabilityCommandPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change waveform settings that are either unique to the type of waveform specified by the associated capability or not available in the CommonSettingsChange.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
						<xs:annotation>
							<xs:documentation>Identifies the Communications Subsystem.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Capability" type="uci:CommTerminalCapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed Waveform Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:CommTerminalCapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CommTerminalCapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CommTerminalCapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityStatusType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusType">
				<xs:sequence>
					<xs:element name="MDF_Status" type="uci:MDF_StatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The MDF status for the Capability.  Includes the Current, Commanded and Failed MDF status.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AvailableConnections" type="uci:AvailableConnectionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current status of the number of connections that are supported, given subsystem resource availability and active Activities.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCapabilityType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:CommCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Waveform taxonomy.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:ForeignKeyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a variant of the Capability (such as Link 16's CMN, DNM, etc.); the second tier in the taxonomy of Communications.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:CommCapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AvailableProfileID" type="uci:CommProfileID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a Profile (preset) that is applicable to this Capability.  Only the profiles currently available and applicable to this Capability should be listed.  A Profile (or preset) is a logical collection of data, whose implementation is not specified, that is used to tailor, configure or otherwise affect the behavior of a Capability.  Profiles can vary from mission to mission or even by phases of a single mission.  They are generally developed in pre-mission planning and are unique for each Subsystem model.  Their content is not standardized by UCI, but the mechanism for advertising their availability and activating them is.  Their content is abstracted by the UCI concept of Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DataFormat" type="uci:CommDataFormatEnum" minOccurs="0" maxOccurs="17">
						<xs:annotation>
							<xs:documentation>Indicates the data formats this capability is capable of exchanging via the data link. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TerminalUniqueKey" type="uci:ForeignKeyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Serving a similar as a MAC address in TCP/IP, the TerminalUnique ID provides the waveform's unique identifier on the network (where needed).  This value would typically be loaded from an MDF, where necessary.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TxPowerRange" type="uci:MilliwattPowerRatioRangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the minimum and maximum power levels used by the waveform for transmissions over the network medium.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TransmitFrequencyRange" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the frequency bands used by the waveform for transmissions over the network medium.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReceiveFrequencyRange" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the frequency bands used by the waveform to receive.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CryptoType" type="uci:CryptoTypeEnum" minOccurs="0" maxOccurs="14">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Crypto taxonomy.  Reflects crypto modes supported by the capability given the current configuration of MDF, Keys, code version, etc. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedUserIO_ID" type="uci:CommUserIO_ID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifies User I/O components that the waveform may be dynamically configured to use a data source (in the case of data to be transmitted) or a data sink (in the case of data received and decrypted).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedUserLink" type="uci:CommUserLinkType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifies network components, or logical RF ports, that the waveform may be dynamically configured to use as a data sink (in the case of data to be transmitted) or a data source (in the case of received data).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedAntennaID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command and control relevant Antenna Component associated with the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCommandMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:CommTerminalCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Waveform Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommTerminalCommandMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CommTerminalCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CommTerminalCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommTerminalCommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:CommTerminalCapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of a Waveform Capability.  Generally, if accepted, the command will result in one or more new Waveform Activities being created and reported via the Waveform Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:CommTerminalActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing Waveform Activity (which was previously reported via the Waveform Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent CommActivity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CommTerminalPlanActivationCommandMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandBaseType">
				<xs:sequence>
					<xs:element name="CommTerminalPlanID" type="uci:CommTerminalPlanID_Type">
						<xs:annotation>
							<xs:documentation>The CommTerminalPlan that this command pertains to.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommandType" type="uci:PlanActivationCommandEnum">
						<xs:annotation>
							<xs:documentation>The command for the associated CommTerminalPlan
CONVERT:Convert the CommTerminalPlan so that it is in the proper format for upload to a vehicle
UPLOAD: Upload a CommTerminalPlan to the vehicle
ACTIVATE: Activate the CommTerminalPlan onboard the vehicle DEACTIVATE: Deactivate the CommTerminalPlan onboard the vehicle.  Deactivated plan returns to the Approved or Uploaded state.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EffectivityActivation" type="uci:CommTerminalPlanEffectivityActivationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Commands a CommTerminalPlan effectivity to a state.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
