	<xs:complexType name="OrbitCollisionType" uci:version="003.001.001.000">
		<xs:annotation>
			<xs:documentation>Specifies the details of an orbital collision between two objects.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CollisionObject" type="uci:OrbitConflictObjectType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the characteristics of each of the objects involved in an orbital collision.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentageOfPartialCollision" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the fraction of the total mass that is directly involved in a partial collision. A partial collision occurs when a piece of an object collides with a piece of another object (e.g. collision of solar panels from two different objects). If omitted, the default value is 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AbsoluteRisk" type="uci:UnitIntervalDoubleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the total probability of risk that a collision is likely to occur. This value ranges from 0.0 to 1.0, where 0.0 is that a collision event will not happen and 1.0 is that a collision event will happen.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeRisk" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative probability of risk that a collision is likely to occur. This value represents the risk that is over the "normal" amount of acceptable risk that is common in orbital collision (e.g. 2, 3, 4, etc times over the "normal" risk).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitConflictObjectType" uci:version="003.000.001.000">
