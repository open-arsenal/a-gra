	<xs:complexType name="OrbitalSurveillanceActivityType" uci:version="003.001.002.001">
		<xs:annotation>
			<xs:documentation>Indicates the dynamic operational characteristics of an Activity of an OrbitalSurveillanceCapability.</xs:documentation>
