			<xs:documentation>Indicates guidance regarding which aspect or aspects of deployment to favor.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports interrupting other activities that may have a higher precedence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentOperationSupported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the Capability has the ability to run concurrently with at least one other Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemDeploymentTaskBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines a common base task type that supports system deployment.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:SystemDeploymentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the details or characteristics of the target or system that is the subject of this task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemDeploymentTaskType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Defines a task type that supports system deployment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SystemDeploymentTaskBaseType">
				<xs:sequence>
					<xs:element name="SystemToDeploy" type="uci:DeployableSystemIdentityType">
						<xs:annotation>
							<xs:documentation>Indicates the type of system that is deployed.  The deployable object could be a platform or defined by another 6016 taxonomy.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DeploymentKinematics" type="uci:KinematicsMultiStandardType">
						<xs:annotation>
							<xs:documentation>Indicates the required kinematics of the deployed System at the moment of deployment.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEphemerisBasisChoiceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the choice of how the ephemeris of the orbiting System will be obtained. These include from the element set results, the element set's ID, or the  kinematics vectors from a standard reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ElementSet" type="uci:TLE_BaseType">
				<xs:annotation>
					<xs:documentation>Indicates the default or "catalog" orbital element set (also known as two line element or TLE) for the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemElementSetID" type="uci:SystemOrbitalElementSetID_Type">
				<xs:annotation>
					<xs:documentation>The unique system identifier that correspond to the orbital element set (TLE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KinematicVector" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Specifies the kinematics in terms of a standard coordinate reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemVCM_ID" type="uci:SystemOrbitalVCM_ID_Type">
				<xs:annotation>
					<xs:documentation>Propagate using a complete VCM (vector covariance message) which includes a kinematic vector, along with other special perturbation parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SystemEphemerisRequestParametersType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>Indicates the parameters for requesting an ephemeris for an orbiting System. This information includes the time window of the ephemeris results, the type of orbital model used, the interval between ephemeris results, the ballistic and solar radiation pressure coefficients, and how the ephemeris will be obtained.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OrbitalEphemerisRequestParametersType">
				<xs:sequence>
					<xs:element name="EphemerisBasis" type="uci:SystemEphemerisBasisChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the choice type that will be used to determine the ephemeris data for this System.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEstimationRequestMDT" uci:version="002.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>The ID of the System whose state should be estimated as part of this request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestType" type="uci:EstimationMessageEnum" maxOccurs="16">
						<xs:annotation>
							<xs:documentation>The type of estimation requested and resulting messages to produce as part of this request. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestFrequencyType" type="uci:RepeatEnum">
						<xs:annotation>
							<xs:documentation>A System Estimation Request can be used in 2 ways:

1.)  SINGLE - A request for a single estimation of system state.  The invoked service function is called once and returns one set of responses (one per requested message type).  The request should not persist beyond the single call, and can be deleted immediately upon successful completion.

2.)  PERIODIC / STOP - A request to periodically estimate system state and periodically publish the requested messages.  A request for periodic estimates should continue to execute until the request is updated with this value set to STOP.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResultsInNativeMessage" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether the results should be published via their native message or contained within the status message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TimeStep" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>For a PERIODIC estimation, the time step determines the rate at which the estimation should be published.

For a SINGLE estimation, the time step determines the number of estimations that will occur between the start and the end.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EstimationStart" type="uci:SystemEstimationStartType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>In absence of this element, the estimator service should always use the state last reported by the system.  It should also use the time associated with the last report as the basis of estimation.

If this element is populated with a segment ID and SegmentCaptureTime is omitted, then the use of current system time is appropriate.

Notes on PERIODIC vs SINGLE estimations:

SINGLE - If this element is populated and segment capture time is omitted, the single estimation requested will reflect a system state at segment capture (and may not be extremely useful).

PERIODIC - During periodic estimations, this value may be used to provide operator adjustments to the estimated system state.  When a request is updated with new EstimationStartingSegmentID and capture time, the estimator should utilize the specified values during the next periodic estimation.  All estimations following the update should then continue from the segment ID specified in the update.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EstimationEnd" type="uci:SystemEstimationStopType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element can be used to specify the time or the waypoint to stop estimation.

In absence of this element, the estimator service should continue estimating the state until requested to stop or until the end of the route.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEstimationRequestMT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>This message is used as an event to generate a position estimate assessment. This message should always have the ResultsInAssessmentMessage set to FALSE because position estimates are reported using PositionReport instead of Assessment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SystemEstimationRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEstimationRequestStatusMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="EstimationResult" type="uci:EstimationResultType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The result of the system estimation.  If a SINGLE response was requested there will be multiple results for each timestep.  This field will be populated if ResultsInNativeMessage=true and the RequestStatus is COMPLETED.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEstimationRequestStatusMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SystemEstimationRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemEstimationStartType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates the initial conditions for a system estimation.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StartTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>This element contains the time to use for the start of the estimation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteEstimationStart" type="uci:EstimationStartType">
				<xs:annotation>
					<xs:documentation>This element contains the estimation initial conditions for a route based system.  If this element is populated with a segment ID and SegmentCaptureTime is omitted, then the use of current system time is appropriate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitEstimationStart" type="uci:OrbitEstimationStartType">
				<xs:annotation>
					<xs:documentation>This element contains the estimation initial conditions for a space based system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SystemEstimationStopType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Time" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>This element is used to specify the time at which to stop estimation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>This element is used to specify the route segment at which to stop estimation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitManeuverSegmentID" type="uci:OrbitManeuverSegmentID_Type">
				<xs:annotation>
					<xs:documentation>This element is used to specify the orbit maneuver segment at which to stop estimation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SystemFilterType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Characteristics" type="uci:SystemComparativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element indicates a System filter requiring a variable logical comparator test between a value in a System-associated message and the value given here.  Multiple instances are logically ANDed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific SystemID that is required to match the filter.  If omitted, any SystemID satisfies the filter.  Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeoFilter" type="uci:GeoFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the System must fall within to satisfy the clause.  Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalFilter" type="uci:OrbitalFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the System must fall within to satisfy the clause.  Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type that refers to an aggregation of Subsystems.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemIdentityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>SystemIdentityType is an extension of IdentityType to include additional information specifically relevant to the identity of a system.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:IdentityType">
				<xs:sequence>
					<xs:element name="QualifyingTags" type="uci:QualifyingTagsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides identity qualifications to augment identification and associated processing of the System.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedTime" type="uci:TimeFunctionType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates time related events that are associated to the system such as when operational or arriving at a destination. The multiplicity is limited to N-1 options where NONE is an event that has no value, thus removed from list of available options.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemManagementRequestMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>This message is used to request changes to a system's status or configurable settings.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="AuthorityType" type="uci:EntityManagementRequestAuthorityEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether this SystemManagementRequest is a request to change data or an order that must be followed. Defaults to REQUEST if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestSource" type="uci:RequestSourceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates the type of service requesting the change.  Defaults to AUTOMATIC_INTERNAL if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReferenceSystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the system to be acted upon by this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestType" type="uci:SystemManagementRequestType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the type of request to perform on a system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UpdateFromControllingUnit" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if this SystemManagementRequest came from the system controlling the referenced system. This indicates a higher confidence in the new data.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Source" type="uci:SystemMessageIdentifierType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the system initiating this request and allows the requesting Service, Activity, or Network to be specified.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemManagementRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SystemManagementRequestMDT">
						<xs:annotation>
							<xs:documentation>This contains the message data.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemManagementRequestStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This message is used to request the status of SystemManagementRequest message or messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the system responding to the SystemManagementRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ServiceID" type="uci:ServiceID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the service responding to the SystemManagementRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemManagementRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SystemManagementRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemManagementRequestType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SetMode" type="uci:MessageModeEnum">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the mode of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetIdentity" type="uci:SystemIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a request to set the identity of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetLink16Metadata" type="uci:Link16MetadataType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Link16Metadata of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetVoiceControl" type="uci:VoiceControlType">
				<xs:annotation>
					<xs:documentation>Set the voice control frequency of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetSensorEntityReporting" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When TRUE, indicates an order to report all locally derived sensor, signal, track or Entity data.  When FALSE, indicates an order to stop reporting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleSettings" type="uci:VehicleCommandDataType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify vehicle settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SystemMessageIdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a system and service as an object in a message.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>The system that should process a message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The specific service in the System that should process a message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The activity that should handle this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The network link that should handle this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemMetadataMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MetadataID" type="uci:MetadataID_Type">
				<xs:annotation>
					<xs:documentation>Unique identifier for this Metadata instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Reference to the System this data extends.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metadata" type="uci:SystemMetadataPET" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Metadata content. There can be separate metadata for each contributing source.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemMetadataMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
