						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_ConsentRequestType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="ActivityID" type="uci:ActivityID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ActivityID of the IFF_Activity which describes the proposed IFF.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Override" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Set to True if asking for permision to perform activity even if it violates a RF restriiction.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_InterrogatorModesEnableType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActivePassive" type="uci:IFF_ActivePassiveEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether command authorizes active IFF, passive IFF or active with passive background.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CivilMilitary" type="uci:IFF_CivilMilitaryEnum" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates civilian and / or military Interrogator modes.  Either or both are selectable. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LethalNonLethal" type="uci:IFF_LethalNonLethalEnum" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>High-level indication of which IFF Interrogator modes to use or not use. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectedModeEnableAndSequencing" type="uci:IFF_ModeControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This structure allows for directed control of what IFF modes to use and when. These settings override all other direction. This structure also allows for enabling specific modes with direction of sequence (ie on Sequence Element and multiple Mode selections lets the capablity determine how to order the modes.)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_InterrogatorTransponderModesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TransponderModesControl" type="uci:IFF_TransponderModeControlType">
				<xs:annotation>
					<xs:documentation>This sets up the transponder modes to be enabled by this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterrogatorModesEnable" type="uci:IFF_InterrogatorModesEnableType">
				<xs:annotation>
					<xs:documentation>Indicates that the command is selcting the Interrogator mode of operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IFF_Mode1Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Code" type="uci:Mode1CodeType">
				<xs:annotation>
					<xs:documentation>This element represents an IFF code. See MIL-STD-6016 for detailed definition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Enabled" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the corresponding IFF mode is enabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_Mode4Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Mode4Indicator" type="uci:InterrogationStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents Mode 4 beacon reply information. See MIL-STD-6016 for detailed definition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mode4Code" type="uci:Mode4CodeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents Mode 4 beacon reply information.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_Mode5DetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NationalOrigin" type="xs:int">
				<xs:annotation>
					<xs:documentation>This element represents Mode 5 National Origin information. See MIL-STD-6016 for detailed definition.</xs:documentation>
