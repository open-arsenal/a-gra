						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:RadarAltimeterReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportResolutionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Resolution of the angular area and altimetry measurement items.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ZX_Resolution" type="uci:AngleHalfType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The absolute angular resolution, or effective one-way beamwidth, of the altimetry measurement along the z-x body plane as centered about the altimetry measurement vector (indicated by the ZX angular offset field) measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="YZ_Resolution" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The absolute angular resolution, or effective one-way beamwidth, of the altimetry measurement along the y-z body plane as centered about the altimetry measurement vector (indicated by the YZ angular offset field) measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HeightResolution" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum incremental resolution of the reported height in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerticalClosingVelocityResolution" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum incremental resolution of the vertical closing velocity in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportUncertaintyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Uncertainty of the altimetry measurement items.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="HeightUncertainty" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The uncertainty associated with the height measurement in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerticalClosingVelocityUncertainty" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The uncertainty associated with the vertical closing velocity measurement in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyTimeWindow" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time period over which uncertainty values are calculated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyCalculation" type="uci:UncertaintyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The type of statistical calculation applied to the raw uncertainty scalar values.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterSettingsCommandMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:RadarAltimeterMessageOutputsEnum" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates messages that are an output by the Capability as the result of capability commands. See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UnassignAll" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to break all current assignments of Activities to resources. As a result, the resources could be assigned to other Activities, re-assigned to the original Activity or a combination of the two. Equivalent to simultaneously commanding each current Activity to be Unassigned via the RadarAltimeterCommand message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultEmcon" type="uci:EmconSettingType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defines the default emission control level to be applied to targets detected by this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultElectronicProtectionOptions" type="uci:ElectronicProtectionOptionsDefaultType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Defines a list of per capability default electronic protection options. These default options will be used if no electronic protection options are provided in the capability command.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterSettingsCommandMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:RadarAltimeterSettingsCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterSettingsCommandStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterSettingsCommandStatusMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:RadarAltimeterSettingsCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarCollectionOptionsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CollectionPolicy" type="uci:CollectionPolicyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates guidance regarding which aspect or aspects of collection to favor if the command cannot be optimally scheduled as requested. See enumerated type annotations for further details. Omitting this element is equivalent to FLEXIBLE, that is deferring to the Command recipient.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceRxSpoilTaper" type="uci:RadarSpoilTaperType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a desire to force an array taper on receive. Omission of this field allows the capability to automatically choose its Spoil/Taper.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceTxSpoilTaper" type="uci:RadarSpoilTaperType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a desire to force an array taper for transmit of the command. Omission of this field allows the capability to automatically choose its Spoil/Taper.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentOperationAccepted" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the requestor is willing to accept any degradations associated with running other capabilities concurrently for this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicProtectionOptionsOverride" type="uci:ElectronicProtectionOptionsEnableType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of externally controllable EP options that should be applied to this command instead of the EP options currently enabled for this Capability. If this list is a subset of the EP options that are available for this capability, then no other EP options should be employed for this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarEmitterIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ELNOT_Identifier" type="uci:NotationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents Electronic Intelligence (ELINT) Notation for non-communications electronic emissions.  Used to preserve original signal identification in case of modification by subsequent processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DIEQP_Key" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element (Defense Intelligence Equipment Index) further refines the ELNOT type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarMode" type="uci:RadarModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the general purpose of the detected RADAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackMode" type="uci:TrackModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For a Signal/Emitter that can track, indicates the tracking mode inferred from the Signal.  See enumerate annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterIndex" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter index associated with the emitter.  Emitter index is an index into a table/database of emitters.  The table/database is generally created in pre-mission planning and included in one or more MDFs.  This element is only useful/meaningful to subscribers who are aware of the table/database/MDF used by the publisher.  For inter-System interoperability, the sibling ELNOT_ID and DIEQP_ID elements are preferred and likely required.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarPointingTargetType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a switch that allows TargetType to be a sibling of SensorReferencedCoverageArea.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="GeospatialTarget" type="uci:TargetType">
				<xs:annotation>
					<xs:documentation>Indicates details of the target of the Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorReferencedCoverageArea" type="uci:SensorReferencedCoverageAreaType">
				<xs:annotation>
					<xs:documentation>Indicates a coverage area specified by azimuth extent and elevation extent or azimuth extent and range extent.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RadarSpoilTaperType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Beam spoiling or taper to be applied to transmit or receive beam.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Taper" type="uci:RadarTaperType">
				<xs:annotation>
					<xs:documentation>Specific taper to be applied to this command. Note that capability does not necessarily implement every combination of taper that can be commanded.  If this value is chosen, collection performance may degrade.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Spoil" type="uci:RadarSpoilType">
				<xs:annotation>
					<xs:documentation>Beam spoiling to be applied.  This value is the ratio of the spoiled beam width to the unspoiled beam width.  If this value is chosen, collection performance may degrade.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RadarSpoilType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpoilType" type="uci:RadarSpoilTypeEnum">
				<xs:annotation>
					<xs:documentation>Beam spoil type to be used during collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpoilFactor" type="uci:SpoilFactorType">
				<xs:annotation>
					<xs:documentation>Beam spoil factor to be used during collection.  If this value is chosen, collection performance may degrade.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarTaperType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WeightingFunction" type="uci:RadarTaperWeightingFunctionType">
				<xs:annotation>
					<xs:documentation>Weighting function of the taper to be applied.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SidelobeLevel" type="uci:DecibelNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Sidelobe level distance from main lobe (in dB).  Note that the capability does not necessarily implement all values of this field. It is likely that only discrete sidelobe levels can be achieved. This field is omitted if the WeightingFunction type selected is UNIFORM or if the sidelobe level of the tape is to be determined by the capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarTaperWeightingFunctionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StandardWeightingFunction" type="uci:RadarWeightingFunctionsEnum">
				<xs:annotation>
					<xs:documentation>Beam taper to be used during collection.  If this value is chosen, collection performance may degrade.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherTaper" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Additional taper weighting functions may be commanded through the use of a foreign key type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RangeDopplerResolutionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeResolution" type="uci:RangeResolutionType">
				<xs:annotation>
					<xs:documentation>This is the commanded range resolution for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DopplerResolution" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the commanded Doppler resolution for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RangeElevationExtentChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Elevation" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>Elevation extent of the look area.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:RangeExtentType">
				<xs:annotation>
					<xs:documentation>Range extent of the look area.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RangeExtentType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Range extent of the look area.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Minimum range of the look area from the sensor in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Maximum range of the look area from the sensor in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RangeResolutionType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the down range and / or cross range resolution of a collection.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Range" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the down range resolution of a collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CrossRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the cross range resolution of a collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RankCompareType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RankValue" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>Indicates the precedence and priority levels to compare with the comparison target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Comparator" type="uci:EqualityExpressionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the logical comparator to use when comparing the sibling RankValue element with the comparison target.  The logical expression is: (comparison target Rank) (Comparator) (sibling RankValue).  When the logical expression is TRUE then the comparison is TRUE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RatesSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AzimuthRateSettings" type="uci:DoubleMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed rates for the LOS in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationRateSettings" type="uci:DoubleMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed rates for the LOS in elevation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RollRateSettings" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed rates for the LOS in roll.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RCS_MedianType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RCS_Value" type="uci:DoubleNonNegativeType">
				<xs:annotation>
					<xs:documentation>The measured value of RCS in dBsm (decibels per square meters).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RCS_Variance" type="uci:DoubleNonNegativeType">
				<xs:annotation>
					<xs:documentation>The variance of the reported measurement value (decibels per meters to the fourth).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpectralWidth" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The spectral width of an object, measured in Hertz, produced a result of performing coherent integration. This information can help determine if an object is stable or tumbling which is often useful to distinguish a rocket body from an active stabilized payload or to deduce the rotational period of slowly tumbling objects at GEO. A null value implies this information is not available as it was not produced by the sensor source. This measurement can only be expected for radars that use long coherent processing intervals.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiverPolarization" type="uci:PolarizationEnum">
				<xs:annotation>
					<xs:documentation>The polarization of the received electromagnetic waves.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitterPolarization" type="uci:PolarizationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The polarization of the transmitted electromagnetic waves.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RCS_ParamsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The radar cross section (RCS) parameters include: the desired amplitude resolution measure in decibels per square meter, the optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AmplitudeResolution" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Radar Cross Section (RCS) of targets which are of interest for the command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolutionTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RDMA_InitializeID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to RDMA Initialize messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RDMA_InitializeMDT" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RDMA_InitializeID" type="uci:RDMA_InitializeID_Type">
				<xs:annotation>
					<xs:documentation>Unique ID for this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RDMA_InitializeSetupID" type="uci:RDMA_InitializeSetupID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the RDMA Initialize Setup ID that this message is in response to. If empty, then the server is broadcasting that a connection is ready, otherwise this is in response to a specific setup message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the System that this message is intended for using static configuration where RDMA_InitializeSetupID is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Subsystem that this message is intended for using static configuration where RDMA_InitializeSetupID is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Service that this message is intended for using static configuration where RDMA_InitializeSetupID is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MemoryRegionSize" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the size of the RDMA memory region in Megabytes (MB).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumMessageSize" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum size of the RDMA messages in Megabytes (MB).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endpoint" type="uci:NetworkEndpointType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the network endpoints (IP addresses) available for data transfers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RDMA_Provider" type="uci:RDMA_ProviderEnum">
				<xs:annotation>
					<xs:documentation>Indicates which libfabrics provider will be used for RDMA transfers.</xs:documentation>
				</xs:annotation>
			</xs:element>
