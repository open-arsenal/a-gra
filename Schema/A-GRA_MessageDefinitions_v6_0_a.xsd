			<xs:element name="InertialStateRelative" type="uci:InertialStateRelativeType">
				<xs:annotation>
					<xs:documentation>Position is required to indicate the vehicle's position along the route at which assessments are being specified. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThreatAssessment" type="uci:ThreatAssessmentSystemType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Optional array of detection probabilities for each track (if any) with a detection probability greater than 0 for the vehicle at the sibling Position.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
