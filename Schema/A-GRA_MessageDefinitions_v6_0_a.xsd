				<xs:annotation>
					<xs:documentation>Indicates the System the Tracking Domain applies to.  If empty applies to all sources.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OpZoneType" uci:version="002.000.002.001">
