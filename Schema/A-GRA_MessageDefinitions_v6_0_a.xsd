					<xs:documentation>Indicates a geolocation type/technique being used. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeolocationControlState" type="uci:SignalGeolocationControlEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the current control state of the geolocation activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the cumulative time spent performing the geolocation Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_IdentificationType" uci:version="003.000.003.000">
