						</xs:annotation>
					</xs:element>
					<xs:element name="MissionPlanningAutonomy" type="uci:MissionPlanningAutonomySettingType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates commanded settings for autonomous mission planning capabilities of the System.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlanActivationAutonomy" type="uci:PlanActivationAutonomyType" minOccurs="0">
