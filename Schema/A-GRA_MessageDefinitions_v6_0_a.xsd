				</xs:annotation>
			</xs:element>
			<xs:element name="TechniqueParameters" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Application-specific parameters for the technique in use.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AudioEnable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Enables audio streaming.  True = enable streaming.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IQ_Enable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Enables IQ streaming True = enable streaming.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
