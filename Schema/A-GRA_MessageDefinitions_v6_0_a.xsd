			<xs:enumeration value="PULSED">
				<xs:annotation>
					<xs:documentation>Indicates RF energy is turned on and off to produce a series of RF energy pulses.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CW">
				<xs:annotation>
					<xs:documentation>Indicates a continuous wave modulation.  A sine wave RF energy that varies over a narrow range of amplitude or frequencies.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PULSE_MODULATION">
