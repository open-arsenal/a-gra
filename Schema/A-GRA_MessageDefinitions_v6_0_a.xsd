				<xs:sequence>
					<xs:element name="MessageData" type="uci:SharedApertureSupportCapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SharedRF_ApertureActivityBaseType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="DependentActivity" type="uci:DependentActivityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This indicates activities that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SharedApertureResourceStatus" type="uci:ResourceStatusSelectedType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides feedback on the percent access of the aperture resources being used by this activity.  Required for subsystems once resources are allocated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivityPerformanceFeedback" type="uci:PerformanceMetricSetType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates performance metrics that provide the system insight regarding the progress of an activity, description of the results of an activity and related stats. This is a list to provide reporting for all revisits between activity messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SharedRF_ApertureActivityCommandBaseType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="PerformanceConstraint" type="uci:PerformanceMetricSetType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates set of updated performance constraints a capability must adhere to and their order of importance.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SharedRF_ApertureCapabilityCommandBaseType" abstract="true" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="PerformanceConstraint" type="uci:PerformanceMetricSetType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Set of Performance Constraints a capability must adhere to. Each set should be treated as an option. Meaning at least provide the minimum performance, but try to execute the best performance within the constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SharedSourceEmitterPriorityBinDetailType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessPeriodIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Reference to the associated access periods used to assess the Emitter Priority Bin. Generated at run time by the payload to define access patterns (period 1, period 2, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterPriorityBin" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Individual Priority Bin Index.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalAmplitudeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AmplitudeAverage" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average measured power level of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmplitudeMin" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum measured power level of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmplitudeMax" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum measured power level of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmplitudeLast" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the last measured power level of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeAmplitude" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Signal's amplitude measured relative to receiver's zero point.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalEmitterKinematicsFixedGeolocationStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GeolocationMethod" type="uci:SignalGeolocationMethodEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a geolocation method used to determine the emitter position.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeolocationControlState" type="uci:SignalGeolocationControlEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the control state of the sibling GeolocationMethod.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalEmitterKinematicsFixedType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:EmitterFixedPositionType">
				<xs:sequence>
					<xs:element name="GeolocationStatus" type="uci:SignalEmitterKinematicsFixedGeolocationStatusType" minOccurs="0" maxOccurs="8">
						<xs:annotation>
							<xs:documentation>Indicates the status of a method of geolocation used to determine the emitter position.  Multiple instances allows the last state of multiple methods to be reported.  If multiple instances are given, each should be of a different geolocation method as indicated by the child element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EW_FixType" type="uci:EW_FixEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if the emitter position is a fixed position or the center point of an area of probability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalEmitterKinematicsPositionType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FixedPosition" type="uci:SignalEmitterKinematicsFixedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial position of the emitter associated with the SignalReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Relative" type="uci:SignalRelativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a "AOA", "LOS", "DF", "LOB", etc. measurement of the geospatial location of the emitter associated with the SignalReport, relative to the ESM collector's position.  Relative position is reported with respect to a point of reference.  The relative point is fully defined when a Azimuth, Elevation and SlantRange are given.  It can be partially defined as an angle-only position when Azimuth and/or Elevation are given.  It can be partially defined as a range-only position when only SlantRange is given.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalEmitterKinematicsType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="KinematicsStatus" type="uci:MeasurementStatusEnum">
				<xs:annotation>
					<xs:documentation>Indicates the status of measurements and processing related to the sibling emitter kinematics elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Position" type="uci:SignalEmitterKinematicsPositionType">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial position of the emitter associated with the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A vector indicating the current or last known velocity of the Emitter.  Since Velocity3D_Type is an extension of Velocity2D_Type, it can optionally be used here.  Generally, services are encouraged to send 3D velocity whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionAndVelocityCovariance" type="uci:PositionAndVelocityCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of position and optionally velocity.  Position and velocity covariance are symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocityDeviation" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Standard deviation of velocity/speed in m/s.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HeadingDeviation" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Standard deviation of the heading represented by the velocity vector, in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalIdentityType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:IdentityConfidenceType">
				<xs:sequence>
					<xs:element name="QualifyingTags" type="uci:QualifyingTagsType">
						<xs:annotation>
							<xs:documentation>Provides identity qualifications to augment identification and associated processing of the signal.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalNavDataType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Date/Time stamp of the sibling navigation data elements.  Date/Time stamps on individual elements of the sibling navigation data take precedence over this element when they are given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformKinematics" type="uci:KinematicsFixedType">
				<xs:annotation>
					<xs:documentation>Data describing the position, velocity and orientation of the platform and the associated covariance matrices.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorKinematics" type="uci:SensorKinematicsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Data describing the orientation of the sensor/antenna and the velocity vector of the sensor/antenna face.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalParametricsType" uci:version="001.001.001.001">
		<xs:annotation>
			<xs:documentation>The parametrics data for the Signal, including frequencies, PRIs, pulse width data, etc.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Frequency" type="uci:FrequencyDataType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the measured frequency data for the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_PW" type="uci:PRI_PW_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates Pulse Repetition Interval (PRI) and Pulse Width (PW) data for the Signal.  When both are given, they are a "paired" set of PRI and PW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amplitude" type="uci:SignalAmplitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measured amplitude data for the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Polarization" type="uci:PolarizationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the polarization of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModulationOnPulse" type="uci:ModulationOnPulseDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the measured frequency and phase modulation characteristics of pulses of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Scan" type="uci:ScanDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a characterization of the scanning inter-pulse amplitude behavior of the emitter of the Signal, over time; the measured scan data that characterizes the scanning emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalNoiseRatio" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the signal to noise ratio of the Pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseRepetitionFrequency" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Pulse Repetition Frequency (PRF) in pulses/second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseRepetitionFrequencyCalculated" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flag indicating whether the PRF was calculated from the PRI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseDeviation" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of the pulse, typically with microsecond precision. Note that this is not the standard deviation of the pulse width/duration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BurstDeviation" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of a burst of data transmission.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IlluminationRate" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the rate of transmission of the signal's radio waves in hertz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IlluminationRateDeviation" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Standard Deviation of the Illumination Rate in Hertz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseCount" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the number of pulses in the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulsesPerGroup" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the number of pulses per group.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamWidth" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the beam's width in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyModulationVariation" type="uci:FrequencyModulationVariationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the variation of the modulation of the Signal's frequency.  Optional when identification of the modulation is not attempted and/or the Signal is not frequency modulated.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyExcursion" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the various frequency excursions in hertz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyExcursionAverage" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average of the frequency excursion values.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyExcursionAverageReportCount" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Number of reports used to calculate the average frequency excursion.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PilotFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "pilot frequency" (or "tone") used by the associated emitter for supervisory, control, equalization, continuity, synchronization, or reference purposes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PilotFrequencyAverage" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Average "pilot frequency" (or "tone") used by the emitter for supervisory, control, equalization, continuity, synchronization, or reference purposes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PilotFrequencyAverageReportCount" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Number of reports used to calculate the average pilot frequency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AverageBasebandedPulseRepetitionInterval" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Average Basebanded Pulse Repetition Interval for the contributing Reports. This is calculated from the PRI based on reference emitter data for the associated Notation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AverageBasebandedPulseRepetitionIntervalReportCount" type="xs:unsignedShort" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Number of Reports used to calculate the Average BPRI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BasebandedPulseRepetitionIntervalDeviation" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of the Basebanded Pulse Repetition Interval for the contributing Reports.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LongBaselineInterferometerInfo" type="uci:LongBaselineInterferometerInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the individually measured electrical phases and phase rates to support Long Baseline Interferometer (LBI) measurement technique across Subsystems.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalPulseWidthBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PulseWidthAverage" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthMin" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthMax" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthLast" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the last measured value of Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthDeviation" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of the value of the measured duration for the associated data type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalPulseWidthType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SignalPulseWidthBaseType">
				<xs:sequence>
					<xs:element name="PulseWidthQuality" type="uci:MeasurementQualityEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the quality of the sibling pulse width measurement values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PulseWidthChopped" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the sibling pulse width values are chopped and therefore could be erroneous.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PulseOnPulse" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the sibling pulse width values were measured during a pulse on pulse condition and therefore could be erroneous.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalRelativeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:LOS_MeasurementWithUncertaintyType">
				<xs:sequence>
					<xs:element name="ReferenceIdentifier" type="uci:ReferenceObjectType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of an external object, such as a Link 16 TN, that is associated with the Relative LOS measurement.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Measurement_Method" type="uci:SignalMeasurementMethodEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the method/technique used to determine the Relative LOS.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Measurement_Status" type="uci:MeasurementStatusEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the status of the Relative LOS measurement.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Measurement_Flag" type="uci:SignalMeasurementFlagEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a "flag" or characteristic of the Relative LOS measurement and/or the conditions under which it was made.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Suspect" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates, when TRUE, that the sibling Relative LOS Measurement values are suspected to be erroneous, possibly even more so than indicated in the sibling Relative LOS Measurement Uncertainty element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ExcessiveAttitude" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the platform was experiencing excessive attitude during the line of sight measurement, contributing to the measurement being Suspect.  This element should only be used when the sibling Suspect element is TRUE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FringeDetection" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates, when TRUE, that the signal/emitter LOS was measured near the edge of the field of view of the antenna component, in its fringe region, and therefore might be detected by another antenna component.   When FALSE, the signal was not measured in the fringe region.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EW_MeasurementType" type="uci:EW_MeasurementEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether the azimuth (relative position) is derived from EA, RDF, or a non-RDF electronic surveillance source.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalRemoveInfoType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RemoveReason" type="uci:EntityRemoveReasonEnum">
				<xs:annotation>
					<xs:documentation>See enumeration annotations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MergedToID" type="uci:SignalReportID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the SignalReport which this Signal was merged/migrated to.  Required when the sibling RemoveReason element indicates MERGED.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalReportID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalReportMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SignalReportID" type="uci:SignalReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID assigned to the SignalReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the System that created the SignalReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Subsystem that created the SignalReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Signal" type="uci:SignalType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a collection of pulses with similar characteristics (frequency, pulse width, PRI, etc.) that are grouped together, analyzed, and summarized.  Signal characteristics can build up over time; additional characteristics may be added to the initial report of the Signal, such as identity, activity, collection time, collection method, scan data. and location.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalReportMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SignalReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SignalSourceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability that detected the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Activity that detected the Signal.  Activities are reported via the Capability's Activity message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellID" type="uci:DwellID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a dwell that detected the Signal.  Dwells are reported via the Capability's Activity message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ParameterSource" type="uci:EW_ParameterSourceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of source for the data being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalSummaryType" uci:version="001.000.001.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Modulation" type="uci:ModulationEnum" minOccurs="0" maxOccurs="62">
				<xs:annotation>
					<xs:documentation>Indicates detected modulation in the Signal.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VendorSpecificModulation" type="uci:VisibleString64Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the signal is being modulated with a vendor's unique modulation technique.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyModulationVariation" type="uci:FrequencyModulationVariationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the variation of the modulation of the Signal's frequency.  Optional when identification of the modulation is not attempted and/or the Signal is not frequency modulated.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyAverage" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average measured frequency of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyMin" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the lowest measured frequency of the received Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyMax" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum measured frequency of the received Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyRangeControlOptions" type="uci:CoverageEffortEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates to the RF Payload whether the entire sibling frequency range (FrequencyMin to FrequencyMax) should be covered with their RF_ResourceAllocationRequest or a best effort to cover as much of the frequency range as possible.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Type" type="uci:PRI_TypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the PRI type of the signal.  See enumerated type annotations for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Average" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average pulse repetition interval (PRI) of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Min" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the lowest value of the measured pulse repetition interval for the associated emitter beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Max" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the highest value of the measured pulse repetition interval for the associated emitter beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthAverage" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthMin" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthMax" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum measured value of the Signal's pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalBandwidth" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Parameter indicates modulation bandwidth of targeted signal (3dB or 90%) for detection within transmission format bandwidth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmplitudeAverage" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average measured power level of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackMode" type="uci:TrackModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For a Signal/Emitter that can track, indicates the tracking mode inferred from the Signal.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Urgency" type="uci:EmitterUrgencyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the urgency of the Entity.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WartimeReserve" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter is function in its wartime reserve mode. An intentional change in observable electro-magnetic emitter parameter or operational procedure intended to reduce the effectiveness of EW equipment of opposing forces.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LocationCategory" type="uci:SignalLocationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if this signal is located by bearing, area of probability, or a fixed position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypeOfBeam" type="uci:RadarBeamTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the beam is persistently looking in the sensor direction.  This would be set if the sibling TypeOfBeam was set over a period of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamPersistence" type="uci:RadarBeamPersistenceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the beam if persistently looking in the sensor direction.  This would be set if the sibling TypeOfBeam was set over a period of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyCoverage" type="uci:FrequencyControlType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific frequency to be used for the signal description.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SignalType" uci:version="003.001.003.003">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID assigned to the Signal.  A given signal's ID shall be constant over time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalState" type="uci:SignalReportStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the "reporting" state of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:SignalSourceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates cross-referencing IDs for the Capability that is the source of the SignalReport; the Capability that detected the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LocalTrackIdentifier" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a local track identifier assigned by the detecting sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedPulseDataID" type="uci:PulseDataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a PulseData collection associated with the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialDetectionTimestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the Signal was first detected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LatestDetectionTimestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the Signal was last detected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimestampQuality" type="uci:MeasurementQualityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the quality of the LatestDetectionTimestamp.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parametrics" type="uci:SignalParametricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The parametric data for the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterFunction" type="uci:EmitterFunctionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter function inferred from the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterIdentity" type="uci:SignalIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Identity of the Emitter associated with the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterKinematics" type="uci:SignalEmitterKinematicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial position of the emitter of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectorKinematics" type="uci:SignalNavDataType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the kinematic state of the collecting system and antenna at the time of collection of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WartimeReserveMode" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter is functioning in its wartime reserve mode. An intentional change in observable electro-magnetic emitter parameter or operational procedure intended to reduce the effectiveness of EW equipment of opposing forces.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LockIndicator" type="uci:LockIndicatorEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if an emitter is locked on or in surveillance mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityBy" type="uci:ActivityByType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element indicates an activity being performed by an emitter that is not otherwise represented by UCI Tasks, Capability commands, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoveInfo" type="uci:SignalRemoveInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates supplementary information regarding a SignalReport whose sibling SignalState indicates REMOVE.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modulation" type="uci:ModulationEnum" minOccurs="0" maxOccurs="62">
				<xs:annotation>
					<xs:documentation>Indicates the modulation of the signal. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModulationParameter" type="uci:ModulationParameterType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a custom modulation parameter that is not covered by other elements in the Signal data structure. This will typically be used to fully cover the fields defined in other interoperability standards such as the JICD.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Urgency" type="uci:EmitterUrgencyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the urgency of the emitter of the signal.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mobility" type="uci:MobilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the mobility of the Signal.  Omission is equivalent to the enumerate UNDETERMINED.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SizeEstimationCharacterizationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates collection requirements to perform size estimation characterization in support a structure change detection sensor task.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="MinCollection" type="uci:OrbitalSurveillanceSensorMinimumCollectionRequirementsType">
				<xs:annotation>
					<xs:documentation>Specifies span of time for individual collection based on duration or rotational periods of target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SizeData" type="uci:OrbitalSurveillanceSizeDataEnum">
				<xs:annotation>
					<xs:documentation>Indicates the reporting requirements for RCS and Visual Magnitude sensor collections used for size estimation characterization.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SizeEstimationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This identifies the desired type of data to be used for estimating target size.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SizeData" type="uci:OrbitalSurveillanceSizeDataEnum">
				<xs:annotation>
					<xs:documentation>Indicates the reporting requirements for size related data (e.g., RCS variations, Visual Magnitude variations, Assessed Size variations).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SizeType" type="uci:OrbitalSurveillanceSizeTypeEnum">
				<xs:annotation>
					<xs:documentation>Desired size or apparent size type to address the information need.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SizeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the physical size of an object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Height" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The height of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Width" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The width of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Depth" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Depth of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SizeUncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides the uncertainty of the physical size of the object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="HeightUncertainty" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The uncertainty of the height of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WidthUncertainty" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The uncertainty of the width of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepthUncertainty" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The uncertainty of the Depth of the item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeAreaType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>An area defined by two ranges and two angles relative to a geospatial point. The geospatial point can be stationary or it can be relative to a moving object/location so its definition is an offset to a location defined in ReferenceFrame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Radius" type="uci:SlantRangeConstraintsType">
				<xs:annotation>
					<xs:documentation>The Radius about a point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthExtent" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>The angle measured clockwise with True North at 0. This is used to calculate the azimuth extent for a tracking area around a designated point, entity, ownship, or system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>This element represents the orientation as the angle between the area and the orientation of the reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointChoice" type="uci:PointChoiceType">
				<xs:annotation>
					<xs:documentation>The location of the slant range area.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeConstraintsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum distance for this slant range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum distance for this slant range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Absolute" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the defined ranges are absolute distances.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlantRangeSlantRangeRate" type="xs:double">
				<xs:annotation>
					<xs:documentation>Covariance of slant range and slant range rate measurement with units of meters * meters per sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeRatesAndAccelerationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlantRangeRate" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Slant range rate of measurement with units of meters per sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaSlantRangeRate" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Slant range-rate difference of arrival for two received measurements, with units of meters per sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlantRangeAcceleration" type="uci:AccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An observed slant range acceleration value with units of meters per sec squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlantRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the line-of-sight distance between the observation point and point of interest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaSlantRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Slant range difference for two received measurements, with units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatesAndAcceleration" type="uci:SlantRangeRatesAndAccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the rates and/or acceleration of the collected Slant Range Measurements</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeUncertaintyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Variance" type="uci:SlantRangeVarianceType">
				<xs:annotation>
					<xs:documentation>Indicates the variance associated with the collected Slant Range measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Covariance" type="uci:SlantRangeCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the covariance associated with the collected Slant Range measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeVarianceRatesAndAccelerationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlantRangeRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variance of slant range rate measurement with units of meters squared per sec squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlantRangeAcceleration" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variance of slant range acceleration rate measurement with units of meters squared per sec to the fourth power.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaSlantRange" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variance of slant range difference measurement with units of meters squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaSlantRangeRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variance of slant range rate difference measurement with units of meters squared per sec squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlantRangeVarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlantRange" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variance of slant range measurement with units of meters squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatesAndAcceleration" type="uci:SlantRangeVarianceRatesAndAccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the variance of the rates and/or acceleration associated with the collected Slant Range measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SlavedNavigationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SlavedToSystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the System which navigation is slaved to.  Required if navigation is slaved to a service and/or payload/Capability other than the System which originated the NavigationReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlavedToServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Service which navigation is slaved to.  Required if navigation is slaved to a service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlavedToCapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Capability which navigation is slaved to.  Required if navigation is slaved to a Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_ActivityCommandType" uci:version="003.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="Attempt" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If specified, indicates the specific attempt of an activity to which this command applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TemporalConstraints" type="uci:CapabilityCommandTemporalConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates temporal constraints for the command. If omitted, the command should be scheduled immediately while satisfying other applicable constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OverrideRejection" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the Command shall be performed even though it was previously rejected.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RadarPointingTarget" type="uci:RadarPointingTargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates details of the target of the Command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command. If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:SMTI_CollectionOptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates required optional aspects of SMTI to be included in the Command. Only those options supported by the SMTI Capability should be Commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:SMTI_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CoefficientOfTroposphericRefraction" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This coefficient is used to compensate for quadratic phase errors and geolocation errors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AtmosphericPropagation" type="uci:AtmosphericPropagationLossType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Atmospheric propagation information to be used when determining CNR or range/power levels.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SeaState" type="uci:WeatherSeaStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the sea state that should be assumed when performing the SMTI collection and processing. See enumerated type for further details; the enumeration corresponds to World Meteorological Organization definitions of sea state codes. These codes correspond to specific wave height values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SurfaceType" type="uci:SurfaceTypeEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the surface or terrain type that should be assumed when performing the SMTI collection and processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command. If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandSMTI_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command. Only Products consistent with SMTI and supported by the commanded SMTI Capability should be requested. If omitted, no output Product should be produced. See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the SMTI Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:SMTI_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a SMTI Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SMTI_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_ActivityType" uci:version="003.001.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:SMTI_SubCapabilityEnum" minOccurs="0" maxOccurs="5">
						<xs:annotation>
							<xs:documentation>Indicates a specific SubCapability associated with the Activity.  If omitted, all SubCapabilities of the associated Capability are applicable for the Activity.  This element is required whenever a subset of SubCapabilities of a Capability are used by the Activity. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RadarPointingTarget" type="uci:RadarPointingTargetType">
						<xs:annotation>
							<xs:documentation>Indicates details of the target that this Activity is directed against. The target can either be a discrete location defined by geospatial characteristics or a geographically referenced location specified by azimuth and elevation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Metrics" type="uci:MTI_ActivityStatusDetailType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Specific performance metrics that provide the system insight regarding the progress of an activity, description of the results of an activity and related stats.  This is a list to provide reporting for all revisits between activity messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the commanded repetition of the Activity.  If omitted, the Activity is not repetitive.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PolicyApplied" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>When TRUE, indicates the Activity could not be scheduled as requested but the radar was able to apply the command's CollectionPolicy and then successfully schedule or complete the activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AllProductsAndMessagesProduced" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Flag indicating whether or not all products (e.g. ProductLocation) and messages (e.g. Entity) expected to be produced by this activity have been output.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PredictedCollections" type="uci:SMTI_PredictedCollectionsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Supports interaction with a capability assessment function. This allows a subsystem or a model of a subsystem to estimate future performance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEmployed" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which electronic protection IDs are in use for this activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MultistaticModeOptionsEmployed" type="uci:MultistaticModeOptionsEmployedType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which emitter IDs are in use for this activity and whether Multistatic Mode is enabled or disabled.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityCommandType" uci:version="003.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="RadarPointingTarget" type="uci:RadarPointingTargetType">
						<xs:annotation>
							<xs:documentation>Indicates the target of the SMTI Command via explicit values for geospatial characteristics or sensor referenced coverage area.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MultistaticMode" type="uci:MultistaticModeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Multistatic Mode settings and associated data to be used for the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:SMTI_CollectionOptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates required optional aspects of SMTI to be included in the Command.  Only those options supported by the SMTI Capability should be Commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:SMTI_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlaneNormalUnitVector" type="uci:ECEF_UnitVectorType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unit normal vector for the plane in which imaging is to occur.  If not included, the Capability determines the unit vector.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackingRange" type="uci:DistanceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the range within which a track should be initiated and a corresponding Entity message reported for detected moving targets.  Beyond this range tracks should not be initiated and Entity should not be reported for detected moving targets.  This element can be used to control track loading for large and/or dense search volumes.  If omitted tracking range selection is left to discretion of the command recipient.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CoefficientOfTroposphericRefraction" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This coefficient is used to compensate for quadratic phase errors and geolocation errors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AtmosphericPropagation" type="uci:AtmosphericPropagationLossType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Atmospheric propagation information to be used when determining CNR or range/power levels.  If multiple instances are given, each should be of a different band as indicated by the child element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SeaState" type="uci:WeatherSeaStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the sea state that should be assumed when performing the SMTI collection and processing.  See enumerated type for further details; the enumeration corresponds to World Meteorological Organization definitions of sea state codes.  These codes correspond to specific wave height values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SurfaceType" type="uci:SurfaceTypeEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the surface or terrain type that should be assumed when performing the SMTI collection and processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command.  If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandSMTI_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with SMTI and supported by the commanded SMTI Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:SMTI_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed SMTI Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SMTI_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityOptionsType" uci:version="000.001.000.003">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the SMTI_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPolicy" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the CollectionPolicy element in the SMTI_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HRR_Supported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports HRR beams and processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FTI_Supported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability can provide fixed target indication processing to detect fixed rotators and generate the associated products. This processing can be initiated through the inclusion of the FTI flag in the SMTI command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackingSupported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability can provide tracks in addition to raw hit data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackingPlan" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the packing plan element in the SMTI_Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentOperationSupported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the capability has the ability to run concurrently with at least one other capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MultistaticOptionsSupported" type="uci:MultistaticOptionsSupportedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the multistatic options supported by the Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COARPS_SMTI_CollectionOption" type="uci:COARPS_SMTI_CollectionOptionsEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a collection option for a COARPs SMTI Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FalseAlarmLevelUpperLimit" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the FalseAlarmLevel capability is supported and also defines the upper limit allowed by the capability. Used to set the quantity of sensitivity levels. If omitted tracking range selection is the full range of the reference type. A common range is [0,15].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicProtectionOptionsSupported" type="uci:ElectronicProtectionOptionsSupportedType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of EP capabilities that the current HW / SW allows an external actor to control for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Profile" type="uci:RF_ProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a RF Emission Profile currently applied to the Capability.  If omitted, there are no current profiles and the Capability is operating per its defaults and other constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:SMTI_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates a message that is currently an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultPackingPlan" type="uci:STANAG_4607_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current default STANAG 4607 packing plan for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEnabled" type="uci:ElectronicProtectionOptionsEnabledType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which electronic protection options are currently enabled and will be used by this Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SMTI_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CapabilityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:SMTI_CapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the SMTI taxonomy.  For SMTI, the first tier is an indication of the physical area covered.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:SMTI_SubCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability that is available with the Capability.  For SMTI, SubCapabilities indicate specific SMTI waveforms and/or processing techniques.  If a single SMTI Capability supports both land and sea operation, a "MIXED" SubCapability will be indicated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:SMTI_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Band" type="uci:FrequencyRangeType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a frequency band/range used by the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MT_IIRS_Level" type="uci:NIIRS_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a Moving Target Indication Interpretability Rating Scale level supported by the Capability.  See annotations of the underlying type for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:SMTI_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentFieldOfRegard" type="uci:ComponentFieldOfRegardType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Fields of Regard for each component in the capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CollectionConstraintsQualityType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="MTIIRS" type="uci:NIIRS_Type">
				<xs:annotation>
					<xs:documentation>Moving Target Indication Interpretability Rating Scale.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CircularErrorProbable90" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The radius of a circle, centered on the MTI observation, in which there is a 90 percent probability that the target lies within.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SMTI_CollectionConstraintsType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>Indicates a set of bounding requirements for the particular collection associated with this command. The subsystem should attempt to satisfy all specified constraints.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CollectionConstraintsType">
				<xs:sequence>
					<xs:element name="Quality" type="uci:SMTI_CollectionConstraintsQualityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the quality specification details for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetSpeed" type="uci:SpeedRangeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the minimum detectable velocity (MDV) and maximum detectable velocity of targets which are of interest for the Task/Command.  This element can be used to guide dwell and scan times, inform trackers, etc.  If omitted target speed selection is left to discretion of the Task/Command recipient.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetRCS" type="uci:DecibelType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the radar cross section (RCS) of targets which are of interest for the Command.  This element can be used to guide dwell times, inform trackers, etc.  If omitted RCS selection is left to discretion of the command recipient.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FalseAlarm" type="uci:FalseAlarmType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the false alarm details for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProbabilityOfDetection" type="uci:PercentType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the minimum probability of detection which should be used for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Emcon" type="uci:EmconConstraintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to control the RF emissions associated with this command.  If this field is not populated, the service determines all parameters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OwnshipLocationConstraint" type="uci:PositionLocationUncertaintyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that a location constraint should be used for this collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CollectionOptionsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RadarCollectionOptionsType">
				<xs:sequence>
					<xs:element name="Tracking" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a desire to perform tracking on moving targets detected as a result of the Task/Command (TRUE) or not (FALSE). Omission of the element is equivalent to FALSE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FTI" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a desire to perform Fixed Target Indicator (FTI) processing to detect fixed rotators for the target of the Task/Command (TRUE) or not (FALSE). Omission of the element is equivalent to FALSE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Resolution" type="uci:RangeDopplerResolutionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Required resolution for this command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SignalToNoiseRatio" type="uci:DecibelType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Required SNR for the collection. The radar can use this information to calculate dwell times, number of pulses, number of CPIs, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="HRR_Options" type="uci:HRR_OptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Parameters specifically associated with an HRR collection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="COARPS_SMTI_CollectionOption" type="uci:COARPS_SMTI_CollectionOptionsEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a collection option for a COARPs SMTI Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:SMTI_CommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of an SMTI Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SMTI_CommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandResponseType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Capability" type="uci:SMTI_CapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates what type of target and / or processing is associated with this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapability" type="uci:SMTI_SubCapabilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides additional processing information for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionConstraints" type="uci:SMTI_CollectionConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductOutput" type="uci:ProductOutputCommandSMTI_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with SMTI and supported by the commanded SMTI Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SMTI_CommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_CommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:SMTI_CapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of an SMTI Capability.  Generally, if accepted, the command will result in one or more new SMTI Activities being created and reported via the SMTI_Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:SMTI_ActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing SMTI Activity (which was previously reported via the SMTI_Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent SMTI_Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SMTI_PredictedCollectionsType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OwnshipLocation" type="uci:Point3D_Type">
				<xs:annotation>
					<xs:documentation>This defines the ownship location at the start of the predicted collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedCollectionMetrics" type="uci:MTI_PredictedActivityDetailType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines a set of fields which provide detailed information about the predicted activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SMTI_SettingsCommandMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:SMTI_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates messages that are an output by the Capability as the result of capability commands.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultPackingPlan" type="uci:STANAG_4607_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the default STANAG 4607 packing plan for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UnassignAll" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to break all current assignments of Activities to resources.  As a result, the resources could be assigned to other Activities, re-assigned to the original Activity or a combination of the two.  Equivalent to simultaneously commanding each current Activity to be Unassigned via the SMTI_Command message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultEmcon" type="uci:EmconSettingType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defines the default emission control level to be applied to targets detected by this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultElectronicProtectionOptions" type="uci:ElectronicProtectionOptionsDefaultType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Defines a list of per capability default electronic protection options.  These default options will be used if no electronic protection options are provided in the capability command.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SMTI_SettingsCommandMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
