				</xs:annotation>
			</xs:element>
			<xs:element name="AssessedCapability" type="uci:AccessCapabilityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates one or more assessed capabilities and their associated access events.  When more than one instance of this element is given, each should be a distinct assessed capability or collection of related capabilities.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ACFTB_RevA_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AC_MSN_Identifier" type="uci:VisibleString20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF TRE ACFTB AC_MSN_ID, from ACTDF Mission Identifier. Use "NOT AVAILABLE" (two words separated by a single space, but without quotes) if not extant in ACTDF.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ACFTB_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AC_MSN_Identifier" type="uci:AlphanumericSpaceString11OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Aircraft Mission Identification. Use "NOT AVAIL" if the mission id is unavailable. NOTE: This is the definition of AC_MSN_ID for ACFTA TRE, not ACFTB. Actual length should be 20 chars with a default of "NOT AVAILABLE", but that won't fit in the incorrect field length of 11 characters defined herein. Use of this default might fail JITC certification testing if the ground station SW does not overwrite with the correct default value. Use ACFTB_RevA_Type for proper ACFTB field definition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AC_TAIL_NO" type="uci:AlphanumericSpaceString11OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Aircraft tail number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AC_TO" type="uci:NumericSpaceString13OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Aircraft take off date and time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SENSOR_Identifier" type="uci:AlphanumericSpaceString7OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies which specific sensor produced the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SCENE_SOURCE" type="uci:NumericSpaceString2OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the origin of the request for the current scene. A scene is a single image or a collection of images providing contiguous coverage of an area of interest.
0 = Preplanned
1 to 9 = Sensor Specific:
For ASARS-2:
1 = Scene Update (uplink)
2 = Scene Update (manual - via pilot's
cockpit display unit)
3 = Immediate Scene (immediate spot or
search range adjust)
5 = Preplanned Tape Modification
6 = SSS.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SCNUM" type="uci:NumericSpaceString7OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the current scene, and is determined from the mission plan; except for immediate scenes, where it may have the value 0, the scenes are numbered from
1 to 999999. The scene number is only useful to replay/regenerate a specific scene.  There is no relationship between the scene number and an
exploitation requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IMHOSTNO" type="uci:NumericSpaceString7OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Together with the Immediate Scene Request ID, denotes the scene that the immediate scene was initiated from and can be used to renumber the scene.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IMREQ_Identifier" type="uci:NumericSpaceString6OnlyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Immediate Scene Request ID. Only nonzero
for immediate scenes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
