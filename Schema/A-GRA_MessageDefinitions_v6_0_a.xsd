			<xs:extension base="uci:VersionedID_Type">
				<xs:sequence>
					<xs:element name="ForeignDataPlanKey" type="uci:ForeignKeyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element is used to trace a UCI Data plan to a foreign, non-UCI ID.  This supports many use cases where there is requirement to adapt UCI Data plans to/from other formats.  This includes conversion of a UCI Data plan to a System specific format, or conversion of a non-UCI Data plan to UCI.  The inclusion of this data in the Data plan allows the ID mappings/associations to be managed/persisted natively in UCI and negates the need to persist the mappings in an out-of-band format.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
