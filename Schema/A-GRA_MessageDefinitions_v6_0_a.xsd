				</xs:annotation>
			</xs:element>
			<xs:element name="NominalValue" type="uci:NameValuePairType">
				<xs:annotation>
					<xs:documentation>Indicates the setting value type associated with the sibling SettingIdentifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinValue" type="uci:NameValuePairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates expected minimum value, when known.  The MinValue type should match the selected Value type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxValue" type="uci:NameValuePairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates expected maximum value, when known.  The MaxValue type should match the selected Value type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
