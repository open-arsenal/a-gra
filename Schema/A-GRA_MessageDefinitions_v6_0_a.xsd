				</xs:annotation>
			</xs:element>
			<xs:element name="NPAR_ProcessSpectralShaping" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Flag indicating whether to perform NPAR spectral shaping.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NPAR_ProcessRemap" type="xs:boolean" minOccurs="0">
