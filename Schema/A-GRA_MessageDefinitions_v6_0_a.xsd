					<xs:documentation>Indicates the unique ID of the first Path of the Route.  The first Path of the Route would generally be of PRIMARY PathType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteProjection" type="uci:LineProjectionEnum">
