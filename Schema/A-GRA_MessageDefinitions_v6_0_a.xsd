		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_RequirementTaxonomyType">
				<xs:sequence>
					<xs:element name="CapabilityTaxonomy" type="uci:MA_CapabilityTaxonomyType" minOccurs="0">
