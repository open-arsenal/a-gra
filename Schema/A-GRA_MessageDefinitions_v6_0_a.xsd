	<xs:complexType name="SAR_TaskBaseType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:SAR_CapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the capability's first tier type in the SAR taxonomy.  For SAR the first tier is an indication of the geospatial extent of the resulting products.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityType" type="uci:SAR_SubCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates a SubCapability of the SAR Capability; the second tier in the taxonomy of SAR.  For SAR, the second tier is an indication of the specific waveform and/or collection technique.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookAtCoords" type="uci:LocatedEllipseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an adjusted and/or more specific geospatial location for the collection.  This element is used in cases where the target given in the sibling SubCapability element isn't sufficiently specific and/or cannot be adjusted to suit the needs of the Task creator, but the relation to the original Target must be preserved.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionOptions" type="uci:SAR_CollectionOptionsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates required SAR options for the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionConstraints" type="uci:SAR_CollectionConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates constraints on the collection and/or processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DesiredWaveform" type="uci:SAR_WaveformType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the desired waveform to use for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PairIdentifier" type="uci:PairIdentifierEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Task's role in a pair collection.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Output" type="uci:ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a desired output Product of the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
