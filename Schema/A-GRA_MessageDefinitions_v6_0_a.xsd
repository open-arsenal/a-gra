	<xs:complexType name="WeatherRadarOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the WeatherRadarCommand message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPolicy" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the CollectionPolicy element in the WeatherRadarCommand message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicProtectionOptionsSupported" type="uci:ElectronicProtectionOptionsSupportedType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of EP capabilities that the current HW / SW allows an external actor to control for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherRadarSettingsCommandMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="ElectronicProtectionState" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command for Electronic Protection (EP) to be enabled (TRUE) or disabled (FALSE) for the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EmissionBalanceState" type="uci:EmissionBalanceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See enumeration annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:WeatherRadarMessageOutputsEnum" minOccurs="0" maxOccurs="3">
						<xs:annotation>
							<xs:documentation>Indicates messages that are an output by the Capability as the result of capability commands.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UnassignAll" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to break all current assignments of Activities to resources.  As a result, the resources could be assigned to other Activities, re-assigned to the original Activity or a combination of the two.  Equivalent to simultaneously commanding each current Activity to be Unassigned via the WeatherRadar message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultEmcon" type="uci:EmconSettingType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defines the default emission control level to be applied to targets detected by this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ElectronicProtectionOptionsEnabled" type="uci:ElectronicProtectionOptionsDefaultType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates which advertised EP options should be applied to all Activities associated with this Capability. This list will completely replace any previously commanded list of EP options.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
