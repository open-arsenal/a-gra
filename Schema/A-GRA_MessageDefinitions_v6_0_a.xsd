			</xs:element>
			<xs:element name="X_Path" type="uci:VisibleString1024Type">
				<xs:annotation>
					<xs:documentation>This field specifies a filter criteria for a specified XPath.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductType" type="uci:ProductTypeEnum">
				<xs:annotation>
					<xs:documentation>The product type that the subplan applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ProductGeospatialLocationType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point2D" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates a point associated with the Product.  Generally, services are encouraged to send altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Zone" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>This element represents the bounding area for the product associated with this ProductMetadata.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePosition" type="uci:RelativePositionType">
				<xs:annotation>
					<xs:documentation>This element represents a line of sight reference for the product associated with this ProductMetadata.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ProductLocationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to product location.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductLocationMDT" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="ProductLocationID" type="uci:ProductLocationID_Type">
						<xs:annotation>
							<xs:documentation>Identifier for the ProductLocation message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type">
						<xs:annotation>
							<xs:documentation>This element represents the unique identifier of the ProductMetadata associated with this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LocationAndStatus" type="uci:LocationAndStatusExpireType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides a rough indication of how long the product specified by the sibling ProductMetadatID will be available and the NetworkLocation. All specified locations are accesses for the same product</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ThumbnailNetworkLocation" type="uci:EndpointReferenceType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the network location at which the product thumbnail, whose data format is not defined within the UCI schema, associated with this ProductMetadata can be found.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ArchiveConfiguration" type="uci:ArchiveRequestType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Time reference for the life of this product.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductLocationMT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductLocationMDT">
						<xs:annotation>
							<xs:documentation>This element represents the details regarding the network location for a particular product.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductLocationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Network" type="uci:EndpointReferenceType">
				<xs:annotation>
					<xs:documentation>Indicates the network location at which the file or product, whose data format is not defined in the UCI schema, can be found.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="System" type="uci:ProductSystemLocationType">
				<xs:annotation>
					<xs:documentation>Indicates that the File or Product is located in/on a System and is not reachable via a network URI; however, it can possibly be made reachable via a network URI if requested by a download request.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ProductManagementTaskDataType" uci:version="002.001.000.001">
		<xs:annotation>
			<xs:documentation>This is the base type for all ProductManagement Tasks.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TaskID" type="uci:TaskID_Type">
				<xs:annotation>
					<xs:documentation>Unique identifier for a task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Traceability" type="uci:TraceabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tasking sources work at different levels of detail and abstraction, progressing from what to do to how specifically to do it.  Inputs from abstract tasking sources and Tasks can be decomposed into discrete, actionable Tasks.  This element provides traceability to the external tasking or Task from which this Task was derived.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DependentTask" type="uci:DependentTaskType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides a way to link tasks.  This can be used to represent a strategy such as look-shoot-look.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentTask" type="uci:ConcurrentTaskReferenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides a way to link tasks with a concurrent temporal relationship. This can be used to represent coordinated attacks.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Rank" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>Indicates the rank of the resulting action.  Rank determines order when resources are limited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PreemptLowerRank" type="uci:DownloadPriorityEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether a) in-work activities of a lower rank should be interrupted in order to immediately commence new activity (IMMEDIATE) or b) the activity should be simply queued according to rank and await the next available slot.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:RemarksType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates information from an operator that is intended for display.  Both short and longer detailed information can be provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductManagementTaskStatusDataType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>This is the base type for all ProductManagement Task status.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TaskID" type="uci:TaskID_Type">
				<xs:annotation>
					<xs:documentation>Unique object identifier for message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaskState" type="uci:ProductManagementTaskStateEnum">
				<xs:annotation>
					<xs:documentation>Identifies the current state of a task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The system to which the task is assigned.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the capabilities the TaskStatus is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductMetadataID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to product metadata.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductMetadataMDT" uci:version="003.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type">
						<xs:annotation>
							<xs:documentation>This element represents the unique identifier of the ProductMetadata associated with this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductDescription" type="uci:ProductOutputType">
						<xs:annotation>
							<xs:documentation>Indicates the content and format of the Product associated with this ProductMetadata.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FileName" type="uci:FileNameType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines the file name of the stored product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BE_Number" type="uci:BasicEncyclopediaNumberType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates an external (non-UCI) Basic Encyclopedia Number associated with the point target.  It is optional because not all point targets originate from or are associated with BE numbers.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SceneKey" type="uci:ForeignKeyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>ID which uniquely identifies an externally defined, possibly sensor defined, ID that associates multiple Products together, independent of the Tasks that created them.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GeospatialLocation" type="uci:ProductGeospatialLocationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Describes the geospatial location or locations which the product associated with this ProductMetadata is relevant.  If more than one is provided, they may be disjoint.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionLocation" type="uci:ProductCollectionLocationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Describes the actual geospatial location or locations of the host platform during the collection of the product. This can be used to recreate the collection geometry as it was actually executed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Identifies the unique ID of the System that generated the product associated with this ProductMetadata.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductSource" type="uci:SourceFiltersType">
						<xs:annotation>
							<xs:documentation>Indicates the UCI fluent source or sources of the Product associated with this ProductMetadata; the source that bridged/converted/adapted and/or generated the File and then introduced it onto a UCI network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CreationSource" type="uci:CreationSourceEnum">
						<xs:annotation>
							<xs:documentation>Indicates the type of source that originally created the associated Product's content, regardless of how/by-whom/when it was introduced to a UCI network.  For example, for Products created by a Capability, the creation source is CAPABILITY.  For Products generated by a non-UCI mission planning system, ground station or other external entity and then introduced to a UCI network by a UCI bridge/adapter Service, a creation source of EXTERNAL should be used.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UntrustedModification" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether this product has been altered from its original form by a user, external (i.e. non-system) component or other untrusted service.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Timestamp" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>This element represents the time and date in Zulu format at which the product was created.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SecurityInformation" type="uci:SecurityInformationType">
						<xs:annotation>
							<xs:documentation>This element describes the security level of the product corresponding to this message.  The security level of this message itself is indicated in the message header.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Thumbnail" type="uci:ThumbnailType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates characteristics of a thumbnail, a reduced-size version of the product associated with this ProductMetadata.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DerivedFromID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a ProductMetadata message corresponding to the original product that this product was derived from.  It is possible for the original products to "expire" despite this reference.  This differs from "DerivedFrom" in SecurityInformation in that it refers to a specific ProductMetadataID for a product that might not persist vs. a less specific name, description or identification that remains meaningful over time.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Traceability" type="uci:TraceabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Tasking sources work at different levels of detail and abstraction, progressing from what to do to how specifically to do it.  Inputs from abstract tasking sources and Tasks can be decomposed into discrete, actionable Tasks.  This element provides traceability to the external tasking or Task associated with the Product described by this ProductMetadata.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequirementMetadata" type="uci:RequirementProductMetadataType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates Requirement-related metadata for the Product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityMetadata" type="uci:EntityMetadataType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates Entity-related metadata for Products which are associated with or contain Entities.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SHA_2_Hash" type="uci:SHA_2_256_HashType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the cryptographic hash for the associated file.  See annotations of this element's type for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DemodulationParameters" type="uci:DemodulationParameterType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates demodulation parameters associated with the product.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique product metadata ID of a product that is being associated with this product. The associated products may have been created together or are used together.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductMetadataMT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductMetadataMDT">
						<xs:annotation>
							<xs:documentation>This element represents the details regarding the metadata for a particular product.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductNeededByType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates when the product is needed by.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AsSoonAsPossible" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates that the product or products is needed as soon as possible.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AbsoluteTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates that the product is needed by a particular Date/Time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeToEventTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Indicates that the product is needed no later by a particular time duration after an observed event (e.g. Maneuver or Detection).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ProductOutputCapabilityImageryType" uci:version="000.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductOutputType">
				<xs:sequence>
					<xs:element name="GeneratorOutputID" type="uci:PO_ProductGeneratorOutputID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID for this ProductOutput that associated with a Capability and corresponding Capability ID. This ID is used to invoke the Capability via Command messages, report its activity via Activity messages, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CompressionRatioSettings" type="uci:CompressionRatioSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defined as the number of bytes in the input image divided by the number of bytes in the output image.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductRateSettings" type="uci:ProductRateSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the imagery product rate in frames/second on the service.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Interlaceability" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that an imagery product scan pattern is interlaced when true and non-interlaced or progressive when false.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductSizeSettings" type="uci:ProductSizeSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the imagery product size in bytes.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductResolutionSettings" type="uci:ProductResolutionSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates an imagery product resolution in terms of horizontal/vertical and pixel color depth resolution.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the controllability of the product generator. Omission of this element indicates the product generator is not dynamically controllable. Enabling/disabling a product generator controls whether or not it will generate Products per product type specific settings in the sibling Output element. Resetting a product generator restores it to default/factory configuration. A configurable product generator's settings can be changed, e.g. selecting which band to use when generating the product.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductOutputCapabilityStatusImageryType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductOutputGeneratorID" type="uci:PO_ProductGeneratorOutputID_Type">
				<xs:annotation>
					<xs:documentation>This ID associates to output generator id in the Capability message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompressionRatio" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defined as the number of bytes in the input image divided by the number of bytes in the output image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductRate" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the imagery product rate in frames/second on the service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Interlaced" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that an imagery product scan pattern is interlaced when true and non-interlaced or progressive when false.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductSize" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the imagery product size in bytes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolution" type="uci:ProductResolutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an imagery product resolution in bytes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoOutput" type="uci:VideoOutputSettingsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Settings for the video encoder for generating video streams.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductOutputCommandBasicType" uci:version="000.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductOutputType">
				<xs:sequence>
					<xs:element name="ProductClassification" type="uci:SecurityInformationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element provides the classification label that should place on the Product at the time it is created if possible.  Any post-collect processing of product classification should be handled via the ProductClassification messages (Plan, Task, and Request).  This choice is intended for Task/Command creators who have direct knowledge/control of classification requirements.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductOutputCommandImageryType" uci:version="000.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductOutputCommandBasicType">
				<xs:sequence>
					<xs:element name="JPEG_Settings" type="uci:JPEG_SettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies settings for JPEG files generated by the Command.  This element should be omitted when the sibling ProductFormat doesn't indicate JPEG, settings are left to the discretion of the Command recipient and/or default settings are acceptable.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NITF_PackingPlan" type="uci:NITF_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines data to be placed into the header of the resulting NITF product, commonly referred to at the NITF header "packing plan".  This element should be omitted when the sibling ProductFormat doesn't indicate NITF, settings are left to the discretion of the Command recipient and/or default settings are acceptable.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductOutputCommandSMTI_Type" uci:version="001.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductOutputCommandBasicType">
				<xs:sequence>
					<xs:element name="STANAG_4607_PackingPlan" type="uci:STANAG_4607_PackingPlanPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines elements that will be placed into the header of the resulting STANAG 4607 product.  This element should be omitted when the sibling ProductFormat doesn't indicate STANAG 4607, settings are left to the discretion of the Command recipient and/or default settings are acceptable.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductOutputStatusType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductOutputCapabilityStatusImageryType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductOutputType" uci:version="000.000.002.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductType" type="uci:ProductTypeEnum" maxOccurs="81">
				<xs:annotation>
					<xs:documentation>Indicates the content (data, imagery or other information) of the Product.  Multiple instances are allowed to support fused Products with multiple types of content.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingType" type="uci:ProcessingTypeEnum" minOccurs="0" maxOccurs="32">
				<xs:annotation>
					<xs:documentation>Describes the type of processing that has been done on the product associated with this ProductMetadata. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductFormat" type="uci:FileFormatType">
				<xs:annotation>
					<xs:documentation>Indicates the format of the Product.  A given Product can have multiple types of content as indicated by the sibling ProductType but only one format.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductParentType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>The ID of the Requirement that created (or is yet to create) the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductProcessingRequestID" type="uci:RequestID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The ID of the ProductProcessingRequest that created (or is yet to create) the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ProductProcessingClassificationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductProcessingType">
				<xs:sequence>
					<xs:element name="ProductClassification" type="uci:SecurityInformationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>It is expected that a product generated as the result of processing would be labeled at the highest classification of its parent product or products.  This element optionally provides the ability to override the classification of the product generated as a result of processing at the time the product is created.  Any post-processing and product reclassification should be handled via the productClassification messages (Task, and Request).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProcessingIndex" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the product parameter in the product processing request.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Function" type="uci:ProductProcessingFunctionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Collects the information about a single Function. See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductProcessingFunctionMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Function" type="uci:ProductProcessingFunctionStatusType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides the status information for a particular function. See annotations in child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionStatusMT" uci:version="002.002.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ProductProcessingFunctionStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionStatusType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FunctionID" type="uci:FunctionID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of this processing Function.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the System that provides the Function.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailabilityInfo" type="uci:AvailabilityInfoType">
				<xs:annotation>
					<xs:documentation>Indicates the availability of the Function.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingFunctionType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FunctionID" type="uci:FunctionID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of this processing Function. This ID can used to invoke the Function via the ProductProcessingRequest message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of this processing System.  This ID can be used to invoke the System via ProductProcessingRequest message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AcceptedProductInformation" type="uci:AcceptedProductInformationType" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Provides the accepted input products applicable to one or more sensor types. List size for this element allows for the selection of all applicable values available in child element AcceptedSensorType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedProcessing" type="uci:SupportedProcessingType">
				<xs:annotation>
					<xs:documentation>Identifies limitations on the type of processing that this Function supports.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedOutput" type="uci:SupportedOutputType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides the different output products that the Function can produce.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingPlanID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to ProductProcessingPlan.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingPlanMDT" uci:version="003.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductProcessingPlanID" type="uci:ProductProcessingPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the ProductProcessingPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This field represents the system this plan applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductProcessingPlan" type="uci:ProductProcessingPlanType" maxOccurs="81">
				<xs:annotation>
					<xs:documentation>This field represents a list of plans for each product type that the system will process.  If multiple instances are given, each should be of a different product type as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingPlanMT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductProcessingPlanMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingPlanType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>This type represents the processing plan for a type of product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductType" type="uci:ProductTypeEnum">
				<xs:annotation>
					<xs:documentation>The product type that the ProductProcessingPlan applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DefaultSubPlan" type="uci:ProductProcessingType">
				<xs:annotation>
					<xs:documentation>The default plan to be applied if no constrained subplans return true.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstrainedSubPlan" type="uci:ProcessingConstrainedSubPlanType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This field overrides the default subplan based on a list of filters which include things like time, classification, system ID, and zones.  If the filters are satisfied in a way that determines multiple processing types and parameters could be applied then the constrainedSubplanRank can be used to determine which to apply.  If subplans have the same rank, the product may be processed in accordance with each applicable subplan for creation of multiple processed products.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingReportID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to ProductProcessingReport.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingReportMDT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductProcessingReportID" type="uci:ProductProcessingReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the ProductProcessingReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This field specifies the System that performed the processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability that generated the product.  This element applies when the processing was performed by the Capability which originated the Product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingReport" type="uci:ProcessingReportType">
				<xs:annotation>
					<xs:documentation>The processing report specifies the product and its current processing type and parameters.  For discrete products, this conveys that a product has been processed utilizing the specified processing type and parameters.  Typically this results in creation of a new product which can be included in the OutputProductMetadata element.  For streaming products, this indicates that the processing type and parameters of the stream has changed and is reflective of the current state of how the stream is being processed.  In this case, the message is expected to be populated with InputProduct...ProductTypeReference, element use 1 and no OutputProductMetadata would be specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductProcessingReportMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductProcessingReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingRequestMDT" uci:version="003.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="FunctionID" type="uci:ID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of this processing Function. At least one of FunctionID, SystemID, or ServiceID needs to be specified in order to uniquely identify what is performing the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of this processing System. At least one of FunctionID, SystemID, or ServiceID needs to be specified in order to uniquely identify what is performing the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Capability that generated the product - NOT the processing Capability.  This element can be a useful for addressing a processing request to a specific instance of a Capability controller interface for reprocessing of a product by the Capability's host Subsystem.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Traceability" type="uci:TraceabilityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The traceability element is included in this message as a pass through for population of the resulting product metadata. Tasking sources work at different levels of detail and abstraction, progressing from what to do to how specifically to do it.  Inputs from abstract tasking sources and Tasks can be decomposed into discrete, actionable Tasks.  This element provides traceability to the external tasking or Task from which this Task was derived.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Rank" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>Indicates the rank of the resulting action.  Rank determines order when resources are limited.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PreemptLowerRank" type="uci:DownloadPriorityEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether a) in-work activities of a lower rank should be interrupted in order to immediately commence new activity (IMMEDIATE) or b) the activity should be simply queued according to rank and await the next available slot.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProcessingRequirements" type="uci:ProcessingRequirementsType">
						<xs:annotation>
							<xs:documentation>A processing requirement specifies the product to process and what processing type and processing parameters to utilize. If the ProductProcessing element is omitted, the request would imply utilization of the Product Processing Plan in making the determination of processing type and parameters.  Each processing requirement specifies one and only one processing "job" or call to a processing algorithm.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ProductProcessingRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductProcessingRequestStatusMDT" uci:version="002.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="FunctionID" type="uci:ID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of this processing Function. At least one of FunctionID, SystemID, or ServiceID needs to be specified in order to uniquely identify what is performing the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of this processing System. At least one of FunctionID, SystemID, or ServiceID needs to be specified in order to uniquely identify what is performing the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductProcessingStatus" type="uci:ProductProcessingStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
