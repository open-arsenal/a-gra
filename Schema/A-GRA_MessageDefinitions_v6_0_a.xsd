			</xs:element>
			<xs:element name="Key" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the record in the source system.  Optional when the record source provides records in UCI format with a UCI record ID, required otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordBaseType" uci:version="003.002.003.002">
		<xs:annotation>
			<xs:documentation>Contains satellite or launch vehicle information similar to a space catalog record.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SOB_SatelliteRecordID" type="uci:SOB_SatelliteRecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the SOB Satellite record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB_RecordID" type="uci:EOB_RecordID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a record in the EOB corresponding to this SOB record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:SatelliteIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the identity of the Satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Equipment" type="uci:SOB_EquipmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Describes the pieces of equipment on the satellite, or the eqiupment that make up the launch vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orbit" type="uci:OrbitRegimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orbit of the satellite or launch vehicle. For a pre-launched vehicle, this field would indicate nominal orbit destination.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamps" type="uci:OrderOfBattleTimestampsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates relevant temporal information of the satellite record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DecayDate" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time an object has or is planned to enter the Earth's atmosphere.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelatedLaunchObservationID" type="uci:LaunchObservationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies launch observation data associated with this satellite or launch vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HistoricalLaunchData" type="uci:LaunchStaticDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes previous/historical launch data when launch observation data (see sibling element) isn't available for this satellite or launch vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationalStatus" type="uci:OB_OperationalStatusEnum" minOccurs="0" maxOccurs="24">
				<xs:annotation>
					<xs:documentation>Degree to which the item is ready to perform the overall mission. Default value is 'OPR'. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kinematics" type="uci:OrbitKinematicsParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The mass of the satellite or launch vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endurance" type="uci:SatelliteEnduranceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the assumed or planned endurance available at the PlanningOrigin.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelatedSatelliteRecordID" type="uci:SOB_SatelliteRecordID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies satellite records associated with this SOB Satellite Record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PatternOfLife" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Pattern of Life (PoL) data from an emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A reference to metadata for a product associated with the record. For example, an image of the satellite collected by a tactical sensor.  Products meant to convey generally static physical or performance characteristics should be given in the sibling Characteristics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FileID" type="uci:FileMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A reference to metadata for a file  associated with the record.  Files meant to convey generally static physical or performance characteristics should be given in the sibling Characteristics element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Characteristics" type="uci:SatelliteCharacteristicsOverrideType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the generally static characteristics of the corresponding satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoveInfo" type="uci:SOB_SatelliteRecordRemoveInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates supplementary information regarding a SOB Satellite Record that was Deleted in a xSOB Management Request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:OrderOfBattleEmitterType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates modes and parametrics of an emitter associated with the record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemarksText" type="uci:VisibleString512Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Remarks as entered by the analyst regarding this record.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to SOBs Satellite Record.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>Contains the message data for SOB_SatelliteRecord message.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="SatelliteRecord" type="uci:SOB_SatelliteRecordType">
						<xs:annotation>
							<xs:documentation>Contains satellite information similar to a space catalog record.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Indicates the attributes associated with a specific satellite.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SOB_SatelliteRecordMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordRemoveInfoType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Contains removal information for an SOB_SatelliteRecord.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RemoveReason" type="uci:EntityRemoveReasonEnum">
				<xs:annotation>
					<xs:documentation>See enumeration annotations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MergedToID" type="uci:SOB_SatelliteRecordID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the SOB_SatelliteRecord which this SOB_SatelliteRecord was fused to.  Required when the sibling RemoveReason element indicates FUSED.  For example, suppose it is determined that SOB_SatelliteRecord A and SOB_SatelliteRecord B are the same RSO and in future updates, only SOB_SatelliteRecord B will be reported. SOB_SatelliteRecord A is then REMOVED with RemoveReason of FUSED and MergedToID (this element) indicating SOB_SatellitedRecord B.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SOB_SatelliteRecordType" uci:version="003.003.003.003">
		<xs:annotation>
			<xs:documentation>Contains satellite information similar to a space catalog record.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SOB_SatelliteRecordBaseType">
				<xs:sequence>
					<xs:element name="SecurityInformation" type="uci:SecurityInformationType">
						<xs:annotation>
							<xs:documentation>Contains security attribute information.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Source" type="uci:SOB_RecordSourceType">
						<xs:annotation>
							<xs:documentation>Indicates the original source of the SOB record.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SolarFluxType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates solar flux space weather data type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SolarFluxRecordType" type="uci:SolarFluxRecordEnum">
				<xs:annotation>
					<xs:documentation>This enumerated element indicates the message type containing f10.7 solar flux space weather data from 557WW.(e.g. f10ObservedRadioFlux).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarWeatherRecord" type="uci:SolarWeatherRecordType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element indicates a record of solar flux space weather data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SolarRadiationPressureCoefficientChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A choice of solar radiation pressure (SRP) coefficient to use.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="VCM_SolarRadiationPressureCoefficient" type="xs:double">
				<xs:annotation>
					<xs:documentation>Used for VCM propagation. The SRP coefficient is defined as reflectivity coefficient times area over mass. It is a quantity with units of meters squared per kilogram. It accounts for the effects imposed by the reflectivity of the RSO with regard to the pressure exerted by solar radiation and includes mass and area.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReflectivityCoefficient" type="xs:double">
				<xs:annotation>
					<xs:documentation>A dimensionless value based on how well the RSO reflects light that is used to help quantify the solar radiation pressure on the RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SolarRadiationPressureModelType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Force model properties for modeling Solar Radiation Pressure</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SolarRadiationPressureModel" type="uci:SolarRadiationPressureModelEnum">
				<xs:annotation>
					<xs:documentation>The name of the Solar Radiation Pressure force model used for the propagation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarRadiationPressureCoefficientChoice" type="uci:SolarRadiationPressureCoefficientChoiceType">
				<xs:annotation>
					<xs:documentation>Accounts for the effects imposed by the reflectivity of the RSO with regard to the pressure exerted by solar radiation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SolarWeatherRecordType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates solar flux space weather record.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="F10_7Index" type="uci:SolarFluxF10_7IndexType">
				<xs:annotation>
					<xs:documentation>F10.7 index, the current solar flux value, is a measure of  noise level generated by the sun at a wavelength of 10.7cm at the earth's orbit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeComputed" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time the sibling space weather value was computed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeValid" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the forecast goes into effect. The forecast remains in effect until superseded.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SolarWindRecordType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates solar wind record.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ObservationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time the solar wind was measured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProtonDensity" type="uci:ParticleDensityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the proton density. If absent, indicates no or invalid data received.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProtonTemperature" type="uci:TemperatureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the proton temperature. If absent, indicates no or invalid data received.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarWindSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed of the solar wind. If absent, indicates no or invalid data received.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Status" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the status of the measurement: 0 = nominal data, 1-8 = bad data record, 9 = no data. If absent, assume all reported data is valid.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SourceCharacteristicsType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates characteristic values that describe the source at which a measurement comes from.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TargetRCS" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Target radar cross section to achieve specified/measured detection range in dBsm, Specific to Radar sensors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetIrradiance" type="uci:IrradianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Target irradiance to achieve specified /measured detection range in Watts/meter/meter. Specific to IR sensors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterSensitivity" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum specified/measured detectable signal of reporting source/measurement in dBm/MHz. Specific to Passive RF sensors (e.g. ESM).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DetectionRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specified/Measured detection range of reporting source/measurement in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfDetection" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Probability of detection of reporting source/measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfFalseAlarm" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Probability of false alarm of reporting source/measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SourceCommandEXT" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a type that represents a point of abstract extension to create SourceCommands that can't be documented in the open, unclassified UCI schema.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="SourceCoverageType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>Characterizes the size of the sensor measurement extent.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FOV_ReferenceFrame" type="uci:LOS_MeasurementEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the reference frame source limits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeLimits" type="uci:SlantRangeConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum instrumented range of sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeRateLimits" type="uci:SpeedRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum instrumented range rate of sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthLimits" type="uci:AnglePairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum Azimuth limits of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationLimits" type="uci:AngleHalfPairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum Elevation limits of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthAngleRateLimits" type="uci:AngleRateRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum Azimuth Angle Rate limits of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationAngleRateLimits" type="uci:AngleRateRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum/Maximum Elevation Angle Rate limits of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeY_RangeLimits" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Minimum/Maximum limits of the sensor for the measurement of the inner product of the target pointing vector with the sensor Y-axis. In the case of linear arrays, the Y-axis is the same as the orientation of the linear array. In the case of two-dimensional arrays, the Y-axis is the "Horizontal" axis, coarsely equivalent to Azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeZ_RangeLimits" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Minimum/Maximum limits of the sensor for the measurement of the inner product of the target pointing with the sensor Z-axis. This term is only used for two-dimensional arrays. The Z-axis is the "Down" axis of the array, perpendicular to both the X-axis (boresight) and the Y-axis (horizontal), coarsely equivalent to Elevation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeY_RateRangeLimits" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Minimum/Maximum limits of the sensor for the measurement of the rate of change of the inner product of the target pointing vector with the sensor Y-axis. In the case of linear arrays, the Y-axis is the same as the orientation of the linear array. In the case of two-dimensional arrays, the Y-axis is the "Horizontal" axis, making it coarsely equivalent to the Azimuth rate with units of per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeZ_RateRangeLimits" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Minimum/Maximum limits of the sensor for the measurement of the rate of change of the inner product of the target pointing vector with the sensor Z axis. This term is only used for two-dimensional arrays. The Z-axis is the "Down" axis of the array, perpendicular to both the X-axis (boresight) and the Y-axis (horizontal), making it coarsely equivalent to the Elevation rate with units of per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityCoverageAreaID" type="uci:CapabilityCoverageAreaID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of a Capability Coverage Area that is the source of an item.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SourceFiltersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of a System that is the source of an item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of a Subsystem that is the source of an item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of a Service that is the source of an item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the unique ID of a Capability that is the source of an item.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SourceFilterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
