	<xs:complexType name="SubsystemFaultAmbiguityGroupType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a group of components that a Subsystem has identified as being potentially related to a fault.  Also identifies diagnostic tests (when known) that may be run to further isolate the fault.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DiagnosticTestID" type="uci:BIT_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies tests that may be used to further isolate the fault among the identified Components.  There is no direct relationship implied between a test in this list and a ComponentID in the sibling list.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique IDs of Components that may be related to the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubsystemFaultType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Contains fault data for reporting by subsystems and services.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FaultID" type="uci:FaultID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID for this fault.  Every fault from a Subsystem, Capability, SupportCapability, Component, or Service should have a unique ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Severity" type="uci:FaultSeverityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The severity of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultState" type="uci:FaultStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The state of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultData" type="uci:FaultDataType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Additional fault data which contains key/value pairs with format and unit indicated for the data value. This data supports fault isolation and helps to minimize false alarms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DetectionTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time the fault was detected; it does not indicate the time the fault was transmitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultCode" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>Indicates the "code" or name of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultCodeCount" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the number of occurrences of the associated FaultCode and a set FaultState.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultDescription" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a human readable description of the fault and/or its cause. This could be different than DescriptiveLabel in the sibling FaultID field.  For example, DescriptiveLabel could be "Engine 1 overheat" and the FaultDescription could be "Lubrication oil" or "Exhaust nozzle" indicating the underlying cause of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Subsystem that the fault occurred within.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Service that this fault occurred within.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Capability related to the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a SupportCapability related to the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Component related to the fault.  When multiple components are identified, it should be inferred that each Component has been individually determined to be related to the fault.  In situations where the Subsystem has not yet been able to isolate the fault to individual components, the sibling AmbiguityGroup element should be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmbiguityGroup" type="uci:SubsystemFaultAmbiguityGroupType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates that a fault has been narrowed down to a set of components, but not yet fully isolated.  Separate AmbiguityGroups can be provided when it is desirable to associate specific tests with a subset of the set of components.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubsystemID_Type" uci:version="000.000.000.000">
