	<xs:complexType name="DamageEstimateTargetType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TaskID" type="uci:TaskID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the weaponeering to use for the estimate should come from an existing Task and existing DMPI associated with the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Target" type="uci:TargetType">
