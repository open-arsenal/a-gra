			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProcessingStageID" type="uci:PO_ProcessingStageID_Type">
				<xs:annotation>
					<xs:documentation>Each stage is identified by a unique ID. This is this stage's ID.</xs:documentation>
