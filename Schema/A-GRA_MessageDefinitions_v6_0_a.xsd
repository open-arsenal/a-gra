					<xs:documentation>Indicates the unique ID of the OrbitPlan which this status applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Status" type="uci:OrbitPlanStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the planning and validation states of the orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanStatusMT" uci:version="002.000.002.000">
