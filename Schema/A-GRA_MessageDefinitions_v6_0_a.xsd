	<xs:complexType name="MA_AcceptableLevelOfRiskCommandStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandStatusBaseType">
				<xs:sequence>
