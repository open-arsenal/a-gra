					<xs:documentation>ID of the System that this message is intended for using static configuration where RDMA_InitializeSetupID is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
