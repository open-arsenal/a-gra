			<xs:element name="RequestFrequencyPeriod" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field is used to override the global value specified in the AssessmentRequest message.  If requesting periodic assessments, this field specifies the amount of time that should elapse between the periodic assessments, i.e. the repetition time interval of the assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
