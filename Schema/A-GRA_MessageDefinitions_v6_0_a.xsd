		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessAssessmentID" type="uci:AccessAssessmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssessmentName" type="uci:VisibleString32Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the name of the access assessment..</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccessAssessmentRequestID" type="uci:RequestID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the request that resulted in this AccessAssessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssessementSource" type="uci:NotificationSourceType">
				<xs:annotation>
					<xs:documentation>Indicates the System and other details regarding the Source of the Access Assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedAccessAssessmentInfo" type="uci:AssociatedAccessAssessmentInfoType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a message that is associated with or the cause of the Access Assessment; this would include launch observations, operator notifications, other associated access assessments, and other relevant messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Assessment" type="uci:AccessAssessmentType" maxOccurs="unbounded">
				<xs:annotation>
