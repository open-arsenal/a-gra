			</xs:element>
			<xs:element name="Plan" type="uci:EffectPlanType">
				<xs:annotation>
					<xs:documentation>Indicates the details of the EffectPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean">
