				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AutonomousPlanningConstrainingPlansType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ConstrainingPlanType" type="uci:PlanTypeEnum" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates a type of Plan that can be used as a constraint for autonomous  planning. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstrainingPlanParts" type="uci:ConstrainingPlanPartsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a parts of a *Plan that can be used as a constraint for autonomous planning.  Only parts for *Plan types given in the sibling ConstrainingPlanType element should be specified.  If no parts are specified for a *Plan type given in the sibling ConstrainingPlanType element then all Parts supported by the associated planning process can be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AutonomousPlanningOtherSystemConstrainingPlansType" uci:version="002.000.003.000">
