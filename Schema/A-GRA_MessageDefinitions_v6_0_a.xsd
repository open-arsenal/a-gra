			<xs:element name="DefaultPlanningProcessID" type="uci:PlanningProcessID_Type">
				<xs:annotation>
					<xs:documentation>Indicates which one of the sibling Process elements is the default.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Process" type="uci:OrbitPlanProcessDescriptionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates details of a planning process invocable through the OrbitPlanCommand message/interface.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanStatusMDT" uci:version="002.000.001.000">
		<xs:annotation>
