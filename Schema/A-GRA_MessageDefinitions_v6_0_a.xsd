		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="DesignationDataStatus" type="uci:DesignationDataStatusType" minOccurs="0" maxOccurs="unbounded">
