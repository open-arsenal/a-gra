				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WAVEFORM_A_OR_B">
				<xs:annotation>
					<xs:documentation>Correlates to COARPs Waveform A or B.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WAVEFORM_B">
				<xs:annotation>
					<xs:documentation>Correlates to COARPs Waveform B.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SatelliteOperationsChangesCharacterizationEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the types of operations changes that can be detected using characterization data collected by sensors.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ATTITUDE_PROFILE_CHANGE">
				<xs:annotation>
					<xs:documentation>Characterization data that can be compared with data for the expected operations mode to indicate change in mode.  Could be series of images, narrowband SOI/Photometry, or even just apparent size, depending on target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STABILITY_CHANGE">
				<xs:annotation>
					<xs:documentation>Characterization data that can be compared with data for the expected rotational pattern for the operations mode to indicate change or lack of change in mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STRUCTURAL_CHANGE">
				<xs:annotation>
					<xs:documentation>Characterization data that can be compared with data on the target operating in the expected mode to indicate change or lack of change in mode.  Could be imagery, narrowband SOI/Photometry, or even just apparent size, depending on target and changes such as extending a boom or changing orientation of a large antenna.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGNALS_CHANGE">
				<xs:annotation>
					<xs:documentation>Includes absence of expected signal, appearance of a certain type of signal, frequency changes or other observable characteristics of signals from a spacecraft that might be indicative of mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScanDirectionalityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the directionality of a scan.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNI_DIRECTIONAL">
				<xs:annotation>
					<xs:documentation>Indicates the emitter antenna scan is active in a single direction within the scan; there are no active reversals.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BI_DIRECTIONAL">
				<xs:annotation>
					<xs:documentation>Indicates the emitter antenna scan is active in two directions within the scan, such as back and forth in a scanning plane.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScanMechanicsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the physical means by which the emitter is scanning.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ELECTRONIC">
				<xs:annotation>
					<xs:documentation>Indicates the emitter antenna scan is accomplished via waveform modulation to move the antenna phase center.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MECHANICAL">
				<xs:annotation>
					<xs:documentation>Indicates the emitter antenna scan is accomplished via mechanical actuation of the antenna.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScanPlaneEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the scan plane of a scanning emitter.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AZIMUTH">
				<xs:annotation>
					<xs:documentation>Indicates the primary emitter antenna scan plane of the Signal is horizontal, scanning in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELEVATION">
				<xs:annotation>
					<xs:documentation>Indicates the primary emitter antenna scan plane of the Signal is vertical, scanning in elevation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScanTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of scan which the Signal is associated with.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates determination of scan type has been attempted but the type is unknown or determination hasn't been completed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CIRCULAR">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is scanning by rotating 360 degrees in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SECTOR">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is scanning a sector of space in azimuth and/or elevation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RASTER">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is scanning a sector of space in azimuth and/or elevation using a raster pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STEADY">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is steadily pointing along a fixed line of bearing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONICAL">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is scanning through circular rotation in two dimensions around a point, forming a cone.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRAMED">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an electronically-steered antenna array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK_WHILE_SCAN">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna that is tracking targets while simultaneously scanning for new targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RANDOM">
				<xs:annotation>
					<xs:documentation>Indicates the signal has an amplitude pattern that is characteristic of an antenna whose scan has no discernible pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIXED">
				<xs:annotation>
					<xs:documentation>Indicates the a fixed scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOBE_SWITCHING">
				<xs:annotation>
					<xs:documentation>Indicates the scan is lobe-switching.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPLEX">
				<xs:annotation>
					<xs:documentation>Indicates the scan signal is complex.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPIRAL">
				<xs:annotation>
					<xs:documentation>Indicates a spiral scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANUAL">
				<xs:annotation>
					<xs:documentation>Indicates a manual scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNIDIRECTION">
				<xs:annotation>
					<xs:documentation>Indicates a unidirectional scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HORIZONTAL_BIDI">
				<xs:annotation>
					<xs:documentation>Indicates a horizontal, bidirectional scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HORIZONTAL_UNI">
				<xs:annotation>
					<xs:documentation>Indicates a horizontal, unidirectional scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VERTICAL_BIDI">
				<xs:annotation>
					<xs:documentation>Indicates a vertical, bidirectional scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VERTICAL_UNI">
				<xs:annotation>
					<xs:documentation>Indicates a vertical, unidirectional scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BIDIRECTIONAL">
				<xs:annotation>
					<xs:documentation>Indicates the scan is bidirectional.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HELICAL">
				<xs:annotation>
					<xs:documentation>Indicates the scan is helical.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AGILE">
				<xs:annotation>
					<xs:documentation>Indicates an agile scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNIDIRECTION_SECTOR">
				<xs:annotation>
					<xs:documentation>Indicates a unidirectional sector scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BIDIRECTIONAL_SECTOR">
				<xs:annotation>
					<xs:documentation>Indicates a bidirectional sector scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MONOPULSE">
				<xs:annotation>
					<xs:documentation>Indicates a monopulse scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE">
				<xs:annotation>
					<xs:documentation>Indicates a passive scan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates another form of scanning signal.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNDETERMINED">
				<xs:annotation>
					<xs:documentation>Indicates determination of scan type cannot be determined by the sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
