	<xs:simpleType name="SignalMeasurementFlagEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates characteristics of the LOS measurement that give insight into its quality and/or the conditions under which it was measured.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AZ_EL_RESOLVED">
				<xs:annotation>
					<xs:documentation>Indicates azimuth and elevation angles of arrival intersected to resolve into the LOS measurement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONIC">
				<xs:annotation>
					<xs:documentation>Indicates the LOS measurement is based on angle of arrival only; the LOS Measurement is not corrected for coning error.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESOLVED">
				<xs:annotation>
					<xs:documentation>Indicates the LOS measurement is based on angle of arrival with cone correction.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORCED">
				<xs:annotation>
					<xs:documentation>Indicates the LOS measurement was resolved via means other than pure measurement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINGLE_CHANNEL">
				<xs:annotation>
					<xs:documentation>Indicates the LOS measurement is based on a single channel (amplitude) measurement only.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_QUADRANT">
				<xs:annotation>
					<xs:documentation>Indicates the LOS measurement is based on antenna (360 degree) coverage sectors that are not 4 quadrants.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SignalMeasurementMethodEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates different techniques/methods to measure the Line of Sight (LOS) of an RF signal.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AMPLITUDE">
				<xs:annotation>
					<xs:documentation>A method where the LOS Measurement is estimated based on amplitude comparison between two intersecting antenna patterns.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AMPLITUDE_RESOLVED_PHASE">
				<xs:annotation>
					<xs:documentation>A method where ambiguous interferometer angle of arrival measurement, is resolved into the LOS Measurement using amplitude comparison.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SBI">
				<xs:annotation>
					<xs:documentation>A method where unambiguous (in angle) interferometer angle of arrival measurements are resolved across multiple, simultaneous short baseline interferometer (SBI) baselines.   SBI provides the LOS measurement after cone-correction of elevation angle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LBI">
				<xs:annotation>
					<xs:documentation>A method where highly ambiguous (in angle) interferometer angle of arrival measurements are resolved over time into the LOS measurement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEO_CALCULATED">
				<xs:annotation>
					<xs:documentation>A method where the LOS measurement is derived from Geolocation estimate of location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MONOPULSE">
				<xs:annotation>
					<xs:documentation>A method where LOS is measured using radar (active) sum and difference Direction of Arrival measurement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>A method where LOS is measured via another unspecified means which has not yet been incorporated into UCI.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DUAL_SBI">
				<xs:annotation>
					<xs:documentation>A method where LOS is measured using dual simultaneous short baseline interferometer (SBI) baselines.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACDF">
				<xs:annotation>
					<xs:documentation>A method where LOS is measured using amplitude comparison direction finding (ACDF).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACDF_SBI">
				<xs:annotation>
					<xs:documentation>A method where LOS is measured using both simultaneous short baseline interferometer (SBI) and amplitude comparison direction finding (ACDF).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
