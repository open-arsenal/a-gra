					<xs:element name="StoreInformation" type="uci:MA_StoreInformationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Contains detailed mission store information such as name (mnemonic), if the store is simulated, where the store is located, and any applicable fuze information.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Verification" type="uci:StoreVerificationStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This is the verification state for this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SubPlansModificationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies details pertaining to the Sub Plans Modification.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubPlansAdditions" type="uci:MA_PlansReferenceBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an additional set of *Plans which are included as part of the MissionPlan. The included SubPlans share the same Applicability as the MissionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubPlansRetractions" type="uci:MA_PlansReferenceBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the removal of set of *Plans which are included as part of the MissionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_SubscriptionFilterType" uci:version="000.001.001.001">
		<xs:annotation>
			<xs:documentation>Represents the type of subscription and optional filters for the subscription.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="UCI_Message" type="uci:QueryMessageType">
				<xs:annotation>
					<xs:documentation>Indicates a subscription aligned with specific UCI messages with optional filtering of the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_SubscriptionID_Type" uci:version="000.001.001.001">
		<xs:annotation>
			<xs:documentation>Represents the ID type for UCI IDs that correspond to messaging subscriptions.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SubsystemFaultType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Contains fault data for reporting by subsystems and services.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FaultID" type="uci:FaultID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID for this fault. Every fault from a Subsystem, Capability, SupportCapability, Component, or Service should have a unique ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Severity" type="uci:MA_FaultSeverityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The severity of the fault. This enumeration is modified for Mission Autonomy adaptation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultState" type="uci:FaultStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The state of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultData" type="uci:FaultDataType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Additional fault data which contains key/value pairs with format and unit indicated for the data value. This data supports fault isolation and helps to minimize false alarms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DetectionTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time the fault was detected; it does not indicate the time the fault was transmitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultCode" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>Indicates the "code" or name of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultCodeCount" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the number of occurrences of the associated FaultCode and a set FaultState.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FaultDescription" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a human readable description of the fault and/or its cause. This could be different than DescriptiveLabel in the sibling FaultID field. For example, DescriptiveLabel could be "Engine 1 overheat" and the FaultDescription could be "Lubrication oil" or "Exhaust nozzle" indicating the underlying cause of the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Subsystem that the fault occurred within.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Service that this fault occurred within.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Capability related to the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a SupportCapability related to the fault.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Component related to the fault. When multiple components are identified, it should be inferred that each Component has been individually determined to be related to the fault. In situations where the Subsystem has not yet been able to isolate the fault to individual components, the sibling AmbiguityGroup element should be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmbiguityGroup" type="uci:SubsystemFaultAmbiguityGroupType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates that a fault has been narrowed down to a set of components, but not yet fully isolated. Separate AmbiguityGroups can be provided when it is desirable to associate specific tests with a subset of the set of components.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_SynchronizationChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines the CAP synchronization method to be utilized.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Strategy" type="uci:MA_CAPSynchronizationTypeEnum">
				<xs:annotation>
					<xs:documentation>Desired orbit synchronization across the package as a specified high level tactic.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePositioning" type="uci:MA_CAPRelativePositionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Relative offset assignments at point(s) on the CAP path that can be used by assets performing a decentralized synchronization method.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_SystemCandidateChoiceType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Provides choice to provide a known System ID or a description of a set of capabilities.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SystemCandidate" type="uci:SystemCandidateType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Possible systems that could be used to solve the RequiredTasks.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemCapabilityDescription" type="uci:MA_CapabilityTaxonomyType">
				<xs:annotation>
					<xs:documentation>A collection of Capability Types required to be on a system needed to solve the RequiredTasks. Used for when a specific SystemID is not known yet.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_SystemCharacteristicType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Identity" type="uci:EntityIdentityChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates an identity to be compared to the identity of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionUncertainty" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates the position uncertainty to be compared to the position uncertainty of the System's kinematics. This element represents the positional accuracy of the target. It is the area, in square data miles, within which it is assessed that there is a 95% probability that the target lies. The value given in this element can be compared to either the Quality element of the target or a calculated uncertainty area for the target based on its uncertainty ellipse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionStaleness" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Indicates the position staleness to be compared to the kinematic staleness of the System's kinematics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrioritizationList" type="uci:MA_PrioritizationListValueType">
				<xs:annotation>
					<xs:documentation>Indicates a value priority/rank to be compared to the priority/rank in PrioritizationList referencing the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Behavior" type="uci:BehaviorType">
				<xs:annotation>
					<xs:documentation>Indicates behaviors, activities, use of capabilities, etc. to be compared to those of the battlespace object associated with the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_SystemComparativeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Characteristic" type="uci:MA_SystemCharacteristicType">
				<xs:annotation>
					<xs:documentation>Indicates a characteristic/element value to be used to compare to the corresponding value in a System related message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Comparator" type="uci:EqualityExpressionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the logical comparator to use when comparing the target (Entity or related message) Characteristic to the Response Characteristic. The logical expression is: (target Characteristic) (Comparator) (Response Characteristic). When the logical expression is TRUE then the parent TargetClause instance is TRUE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_SystemFilterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Characteristics" type="uci:MA_SystemComparativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element indicates a System filter requiring a variable logical comparator test between a value in a System-associated message and the value given here. Multiple instances are logically ANDed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific SystemID that is required to match the filter. If omitted, any SystemID satisfies the filter. Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeoFilter" type="uci:GeoFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the System must fall within to satisfy the clause. Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalFilter" type="uci:OrbitalFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the System must fall within to satisfy the clause. Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_SystemID_MapType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the mapping of system ID to an index.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>List of remote platforms participating in this network.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Index" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Represents the sibling SystemID's index value within a map.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_SystemManagementRequestMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>This message is used to request changes to a system's status or configurable settings.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="AuthorityType" type="uci:EntityManagementRequestAuthorityEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether this SystemManagementRequest is a request to change data or an order that must be followed. Defaults to REQUEST if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestSource" type="uci:RequestSourceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates the type of service requesting the change. Defaults to AUTOMATIC_INTERNAL if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReferenceSystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the system to be acted upon by this message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestType" type="uci:MA_SystemManagementRequestType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the type of request to perform on a system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UpdateFromControllingUnit" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if this SystemManagementRequest came from the system controlling the referenced system. This indicates a higher confidence in the new data.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Source" type="uci:SystemMessageIdentifierType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the system initiating this request and allows the requesting Service, Activity, or Network to be specified.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemManagementRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_SystemManagementRequestMDT">
						<xs:annotation>
							<xs:documentation>This contains the message data.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemManagementRequestStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This message is used to request the status of SystemManagementRequest message or messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the system responding to the SystemManagementRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ServiceID" type="uci:ServiceID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the service responding to the SystemManagementRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemManagementRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_SystemManagementRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemManagementRequestType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SetMode" type="uci:MessageModeEnum">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the mode of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetIdentity" type="uci:SystemIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a request to set the identity of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetLink16Metadata" type="uci:Link16MetadataType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Link16Metadata of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetVoiceControl" type="uci:VoiceControlType">
				<xs:annotation>
					<xs:documentation>Set the voice control frequency of a system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetSensorEntityReporting" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When TRUE, indicates an order to report all locally derived sensor, signal, track or Entity data. When FALSE, indicates an order to stop reporting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleSettings" type="uci:MA_VehicleCommandDataType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify vehicle settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_SystemNotificationMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:NotificationBaseType">
				<xs:sequence>
					<xs:element name="SystemSubjectIDs" type="uci:MA_PackageSystemType">
						<xs:annotation>
							<xs:documentation>Indicates the subject of the Notification, the thing which the Notification is about.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemPerspective" type="uci:NotificationPerspectiveEnum" maxOccurs="38">
						<xs:annotation>
							<xs:documentation>Indicates a perspective (characteristic, behavior and/or change) of the Subject that is the basis of the Notification. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedMessage" type="uci:AssociatedMessageType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a message that is associated with the Notification.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NotificationDetail" type="uci:CannotComplyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the unsuccessful processing of the sibling AssociatedMessage element. This element is only expected when the Associated Message processing is not successful</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemNotificationMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_SystemNotificationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemsNeededRequestMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="Candidate" type="uci:MA_SystemCandidateChoiceType">
						<xs:annotation>
							<xs:documentation>Indicates a list of possible systems that could be used to solve the RequiredTasks.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProposedRequirements" type="uci:RequirementAllocationCommandType">
						<xs:annotation>
							<xs:documentation>Indicates a proposed Requirement for the System's needed analysis request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociationConstraint" type="uci:RequirementAssociationConstraintType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an association between Requirements that is a constraint on how they are allocated and planned.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_SystemsNeededRequestMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_SystemsNeededRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
