				</xs:annotation>
			</xs:element>
			<xs:element name="Search" type="uci:SpeedRangeType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a search sensor task, to include the minimum and maximum speed of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitDetermination" type="uci:OrbitAccuracyType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform an orbit determination sensor task.</xs:documentation>
