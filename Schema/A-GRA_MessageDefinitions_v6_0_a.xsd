	<xs:simpleType name="MissionCommunicationsStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element specifies the state of communications between a system and its controlling system.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates that there is sufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle, regardless of data rate and whether the communication is direct or via relay.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOST">
				<xs:annotation>
					<xs:documentation>Indicates that there is no communications or insufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLANNED_LOST">
				<xs:annotation>
					<xs:documentation>Indicates that the vehicle is in a preplanned state where there is no communications or insufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMCON">
				<xs:annotation>
					<xs:documentation>Indicates that the vehicle is not transmitting over any of its links.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MissionPlanningByCaseTriggerEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Enumeration of the initial "by case" triggers for autonomous mission planning functions.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CAPABILITY_ADDED">
				<xs:annotation>
					<xs:documentation>This trigger refers to a new Capability which becomes available or a previously failed Capability which has been restored.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_FAILURE">
				<xs:annotation>
					<xs:documentation>This trigger refers to a failure of a Capability or supporting Capability needed to perform some task planned for the future.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMMS_LOST">
				<xs:annotation>
					<xs:documentation>This trigger refers to lost comms.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DMPI_OVER_DESIGNATION">
				<xs:annotation>
					<xs:documentation>This trigger refers to a situation where the designated DMPIs exceed those initially reserved for the Task, if this creates a shortage for other assigned Tasks.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DMPI_UNDER_DESIGNATION">
				<xs:annotation>
					<xs:documentation>This trigger refers to a situation where the designated DMPIs are less than those initially reserved for the task, and if weapons not designated can be used to perform previous unallocated tasks.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENDURANCE_LOW">
				<xs:annotation>
					<xs:documentation>This trigger refers to a low remaining endurance condition such as low fuel or battery power.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFF_ROUTE">
				<xs:annotation>
					<xs:documentation>This trigger refers to a vehicle that has deviated from the planned route to such a degree that a replan is required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY_CONFLICT">
				<xs:annotation>
					<xs:documentation>This trigger refers to the proximity of two items (Systems, Entities or other items) that exceeded a minimum geospatial separation limit as specified in OpRouting messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RELEASE_POINT_OUTSIDE_LAR">
				<xs:annotation>
					<xs:documentation>This trigger refers to the location of a DMPI, updated LAR calculations or other changes that have resulted in the planned release point for a weapon falling outside the weapon LAR.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ROUTE_CONFLICT">
				<xs:annotation>
					<xs:documentation>This trigger refers to a route that exceeded a minimum geospatial separation limit with another item or items.  The separation is between a planned/navigated route and other routes or conflicting items as specified in OpRouting messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ROUTE_VULNERABILITY">
				<xs:annotation>
					<xs:documentation>This trigger refers to a pop-up threat which is in conflict with an existing plan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SYSTEM_STATE_CHANGE">
				<xs:annotation>
					<xs:documentation>This trigger refers to a system state change as indicated by the SystemStatus message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_ADDED">
				<xs:annotation>
					<xs:documentation>This trigger indicates whether or not allocation/replanning due to a new Requirement is allowed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_DEPENDENCY_FAILED">
				<xs:annotation>
					<xs:documentation>This trigger refers to a vehicle that cannot perform a Requirement because it is dependent on a Requirement that failed or otherwise cannot be planned/executed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_DROPPED">
				<xs:annotation>
					<xs:documentation>This trigger refers to a Requirement execution state transition to DROPPED, as indicated by execution status message for the Requirement (EffectStatus, TaskStatus, etc.).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_FAILED">
				<xs:annotation>
					<xs:documentation>This trigger refers to a Requirement execution state transition to FAILED, as indicated by execution status message for the Requirement (EffectStatus, TaskStatus, etc.).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_CHANGE">
				<xs:annotation>
					<xs:documentation>This trigger refers to a change to a Requirement that impacts an existing plan.  For example, a change of the position of the target of the Requirement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIREMENT_TIMING">
				<xs:annotation>
					<xs:documentation>This trigger a Requirement that is not expected to meet its timing constraints.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZONE_VIOLATION">
				<xs:annotation>
					<xs:documentation>This trigger refers to an OpZone conflicts with the current plan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACECRAFT_PROXIMITY_CONFLICT">
				<xs:annotation>
					<xs:documentation>This trigger refers to the proximity of two spacecraft (Systems, Entities or other space items) that exceeded a minimum geospatial separation limit.  Monitoring for this trigger should be based on current position of live items, not planned/predicted/propagated positions of Systems; see sibling OrbitConflict element.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_CONFLICT">
				<xs:annotation>
					<xs:documentation>This trigger refers to the position along a future planned/predicted/propagated orbit for a spacecraft exceeding a minimum geospatial separation limit with another item or items.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFF_PLANNED_ORBIT">
				<xs:annotation>
					<xs:documentation>This trigger refers to a spacecraft that has deviated from its planned orbit to such a degree that a replan is required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACECRAFT_ENDURANCE_LOW">
				<xs:annotation>
					<xs:documentation>This trigger refers to a low remaining endurance condition such as low fuel or battery power.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESPONSE_PLAN">
				<xs:annotation>
					<xs:documentation>This trigger refers to planning as a result of a Response or ResponsePlan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
