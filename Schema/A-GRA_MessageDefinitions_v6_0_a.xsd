				</xs:annotation>
			</xs:element>
			<xs:element name="ShotParameterDetails" type="uci:MA_ShotParameterDetailsType">
				<xs:annotation>
					<xs:documentation>Set the shot parameter details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_ShotParameterDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UseRangeTurnAndRunOrDMC" type="uci:MA_UseRangeTurnAndRunOrDMCChoiceType">
				<xs:annotation>
					<xs:documentation>Choice between using Range Turn and Run or using Digital Maneuvering Cue Angle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShootNLT" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum distance between a platform and a track that a shot will be released at. Works together with ShootNET to form a shot window.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ShootNET" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The maximum distance between a platform and a track that a shot will be released at. Works together with ShootNLT to form a shot window.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ShotParametersType" uci:version="000.000.000.000">
