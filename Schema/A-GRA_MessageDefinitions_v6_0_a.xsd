	<xs:complexType name="PlanningProcessTreeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningProcessID" type="uci:PlanningProcessID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique identifier of the Mission Planning process designed to work with the following subordinate processes. The outputs from this process will  be used as constraints for the linked subordinate processes below.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubordinatePlanningProcess" type="uci:SubordinatePlanningProcessType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the subordinate planning process that will be invoked upon completion of the sibling PlanningProcessID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanningTriggerType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Source" type="uci:PlanningTriggerSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the initiator of the replan; whether the planning was autonomously triggered by the sibling Trigger elements or Operator invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByCaseTrigger" type="uci:PlanningByCaseTriggerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an initial "by case" trigger for autonomous mission planning functions.  This element is only optional if the sibling Source element has a value of OPERATOR_INVOKED_TRIGGER.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByResultTrigger" type="uci:PlanningByResultTriggerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a "by result" trigger that must occur, as a result of the initial trigger described in the sibling ByCase element, in order for the parent autonomous trigger to occur.  If omitted, the parent autonomous trigger occurs purely based on the sibling ByCase element, regardless of the results of the mission planning functions it triggers.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
