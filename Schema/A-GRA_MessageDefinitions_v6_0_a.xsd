		</xs:annotation>
		<xs:sequence>
			<xs:element name="GatewayServiceID" type="uci:ServiceID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the ServiceID of the Gateway Service that sent this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:MA_GatewayActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a GatewayCapability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_GatewayActivityMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_GatewayActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayActivityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="ConnectionStatus" type="uci:CommConnectionStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether the Gateway has joined the network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonSettingsStatus" type="uci:GatewayControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a mechanism to status settings which a gateway may apply in order to control its operational environment.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GatewayConfiguration" type="uci:MA_GatewayIER_ConfigurationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a current configuration of the Gateway.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssuredTransmission" type="uci:DataDeliveryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides a mechanism for a gateway to provide assurance that it has transmitted tactical and or message data within the time-span this activity message covers.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssuredDelivery" type="uci:DataDeliveryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides a mechanism for a gateway to provide assurance that it has delivered tactical and or message data within the time-span this activity message covers.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentProfileID" type="uci:CommProfileID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The ID of the Profile based on which this activity is currently executing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LinkStatistics" type="uci:GatewayLinkStatisticsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>For the periodicity of this message this is a report of the statistics provided by this capability and its links. If a NetworkLinkID is specified then the granularity is that specific link. If not, It is assumed to be for the gateway as a whole.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VerboseStatus" type="uci:VerboseStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides current settings for the control of the generation of verbose Activity messages that provide full field reporting.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IER_Statistics" type="uci:MA_CommIER_StatisticsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates statistics measured on a per IER level from the perspective of the gateway.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCapabilityCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="ConnectionRequest" type="uci:CommConnectionCommandEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to change the connection status of the waveform.  Note that this field applies to the waveform's status with respect to joining or disconnecting from the network.  It does not directly apply to the connection status of individual links maintained by the waveform.  (The waveform's connection status may indirectly impact the connection status of individual data links.  For example, a connection request to DISCONNECT would likely cause the individual data links to disconnect and would nominally cause the waveform to disconnect from the network.).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonSettingsChange" type="uci:GatewayControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a mechanism to command change to settings which a gateway may apply in order to control the operational environment.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GatewayConfiguration" type="uci:MA_GatewayIER_ConfigurationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the commanded configuration of the Gateway for a given NetworkLink. Gateways and therefore Gateway configurations are inherently associated with NetworkLinks. A single Gateway could simultaneously have different active IER configurations for each of many different NetworkLinks.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivateProfileID" type="uci:CommProfileID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The Profile to which this activity should be instantiated to.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="VerboseStatus" type="uci:VerboseStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides means to control the generation of verbose Activity messages that provide full field reporting.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCommandMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GatewayServiceID" type="uci:ServiceID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the ServiceID of the Gateway Service that sent this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Command" type="uci:MA_GatewayCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Waveform Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCommandMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_GatewayCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_GatewayCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_GatewayCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:MA_GatewayCapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of a Gateway Capability.  Generally, if accepted, the command will result in one or more new Gateway Activities being created and reported via the Gateway Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:MA_GatewayActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing Gateway Activity (which was previously reported via the Gateway Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent GatewayActivity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_GatewayIER_ConfigurationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GatewayConfigurationID" type="uci:CommConfigurationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Gateway configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfigurationState" type="uci:ObjectStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the GatewayConfiguration is added, updated or removed from the Gateway configuration as a result of the command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IER" type="uci:MA_CommIER_GatewayType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Information Exchange Requirement (IER) configuration for the Gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Vector" type="uci:MA_CommVectorCommandType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Vector configuration for the Gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID_Map" type="uci:MA_SystemID_MapType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the mapping of system ID to an index.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewaySpecificSettings" type="uci:GatewayConfigurationPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates Data Gateway Command information specific to a type of Data Gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistributionGroup" type="uci:MA_DistributionGroupType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a grouping of nodes and associated ip address. A mission group describes a squadron of one or more nodes that perform the same mission.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistributionGroupMembership" type="uci:MA_DistributionGroupMembershipType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a system's membership to a multicast group. </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_GatewayReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a reference to an instance of Gateway with a summary of its Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GatewayServiceID" type="uci:ServiceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ServiceID of a the Gateway. The Gateway is uniquely identified together with the sibling GatewayCapabilityID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewayCapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique CapabilityID of a Gateway. The Gateway is uniquely identified together with the sibling GatewayServiceID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewayType" type="uci:MA_CommGatewayTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the high-level gateway family. The gateway type correlates to the content type specified in IERs and the sibling allowed content type which can further restrict content allowed on a gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityType" type="uci:CommDataFormatEnum" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a data format supported by the Gateway. Together with sibling gateway type idenifies the specific instantiation of the gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityType" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a Variant of the Capability; the second tier in the taxonomy of Data Formats.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataFormat" type="uci:CommDataFormatEnum" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a data format supported by the Gateway. Together with sibling gateway type idenifies the specific instantiation of the gateway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllowedContent" type="uci:MA_CommAllowedContentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the content supported by or allowed by the Gateway. Allows software to further ensure IER to gateway assignements are allowed. If empty assume all content applicable to the specific gateway referenced is allowed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_GatewaySpecificConfigurationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GatewayServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ServiceID of a Gateway that this specific configuration is assigned to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewayCapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the CapabilityID of a Gateway that this specific configuration is assigned to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewaySpecificSettings" type="uci:GatewayConfigurationPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Data Gateway Command information specific to a type of Data Gateway, applied to the gateway identified by the sibling ServiceID and CapabilityID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_GeoLocatedObjectFilterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityFilter" type="uci:EntityFilterType" minOccurs="0">
				<xs:annotation>
