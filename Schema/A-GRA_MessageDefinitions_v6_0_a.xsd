	<xs:complexType name="Link16DataLinkNativeInfoType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base DataLinkNativeInfoPET for a Link-16 mapping between a System ID and the specific platform data to exist within a link-16 network.</xs:documentation>
