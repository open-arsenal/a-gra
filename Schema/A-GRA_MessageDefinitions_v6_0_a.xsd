				</xs:annotation>
			</xs:element>
			<xs:element name="TimeoutPolicy" type="uci:DefaultResponseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "timeout" approval policy, used when approval authorities don't respond in a timely fashion.  This element is required when the sibling Policy element indicates APPROVAL_REQUIRED and is ignored otherwise.</xs:documentation>
				</xs:annotation>
