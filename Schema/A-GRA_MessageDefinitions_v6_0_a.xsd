	<xs:complexType name="WeatherRadarTaskType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:WeatherRadarCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of capability to be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AirVolumeLocation" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>Indicates a 3D area that the WeatherRadar capability is directed against.  This should define the latitude/longitude extents of the volume along with any guidance regarding the height of the volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPolicy" type="uci:CollectionPolicyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates guidance regarding which aspect or aspects of collection to favor if the command cannot be optimally scheduled as requested.  See enumerated type annotations for further details.  Omitting this element is equivalent to FLEXIBLE, that is deferring to the Command recipient.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates required repetition of the Task, within the overall temporal constraints of the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Output" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a desired output Product of the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherReportDataType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WeatherReportType" type="uci:WeatherReportTypeEnum">
				<xs:annotation>
					<xs:documentation>This enumerated element indicates the type of the WeatherReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Created" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>This element represents the time at which the WeatherReport was generated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:DateTimeRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the time interval over which the report applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherArea" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>This element represents an area over which the Weather applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QNH" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This elements represents the barometric altimeter setting for correct MSL reading, commonly known as QNH,  in WeatherArea.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherData" type="uci:WeatherReportType">
				<xs:annotation>
					<xs:documentation>Weather data collected for this weather report.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherReportGridDataType" uci:version="002.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:Point3D_Type">
				<xs:sequence>
					<xs:element name="WeatherData" type="uci:WeatherAreaDataType">
						<xs:annotation>
							<xs:documentation>Weather data gathered at or near the associated location.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeatherReportType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AreaData" type="uci:WeatherAreaDataType">
				<xs:annotation>
					<xs:documentation>This element represents a summary of the weather conditions across the entire weather area.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GridData" type="uci:WeatherReportGridDataType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents a point at which Weather applies.  This allows weather to be expressed as a grid of points across the weather area.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="WeatherWarningDataType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WeatherWarningType" type="uci:WeatherWarningEnum">
				<xs:annotation>
					<xs:documentation>This enumerated element indicates the type of WeatherWarning.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherArea" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>This element represents an area over which the Weather applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:DateTimeRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the time interval over which the warning applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents additional, human readable, comments on the warning.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeekdayIntervalType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TimeSpan" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Indicates the period of time during which the weekday interval is valid.  In other words, this sets the number of weeks/months during which the WeekdayInterval is active.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weekday" type="uci:WeekdayEnum" maxOccurs="7">
				<xs:annotation>
					<xs:documentation>Indicates the days of the week in which the interval is valid. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeeklyIntervalPeriod" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the number of weeks between occurrences. 1 = weekly, 2 = every other week, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartTime" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time of day, on a day given by the Weekday element, at which the interval starts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the duration of each occurrence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Wideband_SOI_ParamsType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>The Wideband Space Object of Interest (WB SOI) parameters consist of the Range resolution of both the range and cross range.
                The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeResolution" type="uci:RangeResolutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the down range and/or cross range resolution of a collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolutionTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
