	<xs:complexType name="RadarAltimeterCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:RadarAltimeterCapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of an RadarAltimeter Capability.  Generally, if accepted, the command will result in one or more new RadarAltimeter Activities being created and reported via the RadarAltimeter_Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:RadarAltimeterActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing Activity (which was previously reported via the Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportAngularOffsetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Angular offset of the altimetry measurement vector from the locally-level vertical.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ZX_AngularOffset" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>The angle between the intended direction of peak directivity of the transmission beam and local level vertical along the z-x body plane (the x-axis is positive out the nose of the aircraft in the plane of symmetry of the aircraft, and the z-axis is perpendicular to the x-axis in the plane of symmetry of the aircraft and positive below the aircraft) measured in radians. Positive ZX Angular Offset is rotation from the positive z-axis towards the positive x-axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="YZ_AngularOffset" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>The angle between the intended direction of peak directivity of the transmission beam and local level vertical along the y-z body plane (the y-axis is perpendicular to the x-z body plane and positive out the right, or starboard, wing) measured in radians. Positive YZ Angular Offset is rotation from the positive z-axis towards the negative y-axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportCharacteristicsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Represents the altimetry measurement characteristics of the radar altimeter report.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AngularOffset" type="uci:RadarAltimeterReportAngularOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Angular offset of the altimetry measurement vector from the local level vertical. Straight down would be 0, 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Resolution" type="uci:RadarAltimeterReportResolutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Resolution of altimetry measurement items.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uncertainty" type="uci:RadarAltimeterReportUncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Uncertainty of the altimetry measurement items.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportID_Type" uci:version="000.000.000.000">
