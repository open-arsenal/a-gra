		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="ActivityPlanID" type="uci:ActivityPlanID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the OrbitPlan to be analyzed; the OrbitPlan whose metrics are being requested.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivityPlanParts" type="uci:ActivityPlanPartsEnum" minOccurs="0" maxOccurs="9">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts of the ActivityPlan indicated by the sibling ActivityPlanID to include in the metrics analysis.  If omitted, all parts should be analyzed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
