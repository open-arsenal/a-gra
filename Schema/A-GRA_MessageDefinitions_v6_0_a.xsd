	<xs:simpleType name="ThreatEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the type of threat. Enum members have been sourced largely from MIL-STD-6016 Threat Type. Some members have been added specifically for UCI.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR_TO_SURFACE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from military aircraft at targets on land or sea.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIR_TO_AIR_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile fired from an aircraft for the purpose of destroying another aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURFACE_TO_SURFACE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from the ground or the sea and strike targets on land or at sea.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURFACE_TO_AIR_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from the ground to destroy aircraft or other missiles.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTISHIP_CRUISE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed for use against ships and large boats.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE">
				<xs:annotation>
					<xs:documentation>Missile of undetermined type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTIAIRCRAFT_ARTILLERY">
				<xs:annotation>
					<xs:documentation>Weapons designed to attack aircraft that commonly have a high rate of fire and are able to fire shells designed to damage aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TORPEDO">
				<xs:annotation>
					<xs:documentation>Self-propelled weapon with an explosive warhead, launched above or below the water surface, propelled underwater towards a target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JAMMER">
				<xs:annotation>
					<xs:documentation>Weapon that interferes with the operation of a radar by saturating its receiver with noise or false information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMPROVISED_EXPLOSIVE_DEVICE">
				<xs:annotation>
					<xs:documentation>Bomb constructed and deployed in ways other than in conventional military action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHEMICAL_BIOLOGICAL_RADIOLOGICAL_OR_NUCLEAR">
				<xs:annotation>
					<xs:documentation>Munition that uses chemical, biological, radioactive, or nuclear means to inflict harm to its target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_AIRCRAFT">
				<xs:annotation>
					<xs:documentation>Aircraft with one or more human pilots aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_SHIP">
				<xs:annotation>
					<xs:documentation>Ship or boat with one or more human operators aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_GROUND_VEHICLE">
				<xs:annotation>
					<xs:documentation>Ground vehicle with one or more human operators aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_AIRCRAFT">
				<xs:annotation>
					<xs:documentation>Aircraft without a human pilot aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_SHIP">
				<xs:annotation>
					<xs:documentation>Ship or boat without a human operator aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_GROUND_VEHICLE">
				<xs:annotation>
					<xs:documentation>Ground vehicle without a human operator aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SATELLITE">
				<xs:annotation>
					<xs:documentation>Artificial object which has been intentionally placed into orbit for the purposes of observation, communication, or navigation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBMARINE">
				<xs:annotation>
					<xs:documentation>Watercraft capable of independent operation underwater.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TROOPS_INSURGENTS_OR_PEOPLE">
				<xs:annotation>
					<xs:documentation>A group of people.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_STATEMENT">
				<xs:annotation>
					<xs:documentation>Indicates that no information is being transmitted. (This does not necessarily indicate that the originator does not have the information.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates that the threat type has not been determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ThreatPostureEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the current posture of a known threat.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>The threat is attempting to locate/identify the other object in the relationship.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="READY_TO_LAUNCH">
				<xs:annotation>
					<xs:documentation>The threat is preparing to launch/fire a weapon at the targeted object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAUNCHED">
				<xs:annotation>
					<xs:documentation>The threat has launched/fired a weapon at the targeted object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DIRECTED_TO_ENGAGE">
				<xs:annotation>
					<xs:documentation>The threat likely has been ordered to engage the targeted object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Current threat posture is unknown</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ThreatWeaponEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of weapon the threat intends to used against the targeted entity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NO_STATEMENT">
				<xs:annotation>
					<xs:documentation>TODO; take out?.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HEAT_A2A">
				<xs:annotation>
					<xs:documentation>Heat-seeking air-to-air missile.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_A2A">
				<xs:annotation>
					<xs:documentation>Radar-guided air-to-air missile.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVE_A2A">
				<xs:annotation>
					<xs:documentation>An air-to-air missile not requiring continual missile data link with its launching platform.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HARM">
				<xs:annotation>
					<xs:documentation>High-speed anti-radiation missile.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TimeFunctionEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Describes the function of the associated time. For example, see MIL-STD-6016 DFI 1681 DUI 001.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVATION">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEACTIVATION">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARRIVAL">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPARTURE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_POINT_ESTABLISHED">
				<xs:annotation>
					<xs:documentation>The time that the reported position was established. May be prior to time of data entry.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_OPERATIONAL_TIME">
				<xs:annotation>
					<xs:documentation>The time that the site is expected to become less than fully operational.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONAL_TIME">
				<xs:annotation>
					<xs:documentation>The time that the site is expected to return fully operational.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_OF_REPORT">
				<xs:annotation>
					<xs:documentation>The time that the report was released for transmission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARRIVE_ON_STATION">
				<xs:annotation>
					<xs:documentation>Time the unit will arrive on station.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_REMAINING_ON_STATION">
				<xs:annotation>
					<xs:documentation>Time the unit will be required to leave its current task, taking into account such operational factions as fuel state, weather, distance from base, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPART_STATION">
				<xs:annotation>
					<xs:documentation>The time that a unit is scheduled to leave its station in accordance with its mission plan, or the time of day that the unit left its station.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_ON_TARGET">
				<xs:annotation>
					<xs:documentation>The time that a unit is scheduled to arrive on target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_FIRST_ACQ_TIME_DATUM_EST">
				<xs:annotation>
					<xs:documentation>The time of first acquisition for the contact or, for datum type, the time the datum was established.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_OF_CURRENT_POS_DATA">
				<xs:annotation>
					<xs:documentation>The time of current position data report while contact is maintained on the track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_CONTACT_LOST">
				<xs:annotation>
					<xs:documentation>The time of last position data report received after contact has been lost on the track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TimeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>UCI uses the W3C (www.w3.org) definition of time exactly as given in the specification for xs:time with a further restriction that only the "Zulu" time zone be used.  xs:time is based on Coordinated Universal Time (UTC) and allows seconds to be specified with decimal digits to arbitrary precision.  See the W3C specification of xs:time for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:time">
			<xs:pattern value=".+Z" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TrackModeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Weapon system mode of operation in nominal order of progression. Newer weapon systems may exhibit multiple modes of operation simultaneously.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:annotation>
				<xs:documentation>This enumerated type indicates the basic tracking modes of radar systems.</xs:documentation>
			</xs:annotation>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the radar's tracking mode hasn't been determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>Indicates a radar spatially scanning a volume for initial contact with an entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Indicates a radar frequently revisiting a small spatial volume to monitor to an entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUIDANCE">
				<xs:annotation>
					<xs:documentation>Indicates a radar providing real-time data to another system (e.g. a missile) with the goal of steering it towards a tracked entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ILLUM">
				<xs:annotation>
					<xs:documentation>Indicates a radar pointing a persistent beam of energy at a target which can be exploited by another system (e.g. a missile).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACQUISITION">
				<xs:annotation>
					<xs:documentation>Indicates a radar mode, similar to search, that is generally a transitory, leading to the TRACK mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TurnPointTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the desired behavior at the associated turn point.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TURN_SHORT">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to begin the turn prior to reaching the turn point and continue turning until its projected course intercepts the next turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FLY_OVER">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to fly directly over the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPTURE_OUTBOUND_COURSE">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to capture the specified outbound course upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="START_TURN">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to start the next turn upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="END_TURN">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to end the current turn upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TypeOfDependencyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of dependency between Activities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EXISTENTIAL">
				<xs:annotation>
					<xs:documentation>In the case where if the dependent Activity's Resource Allocation is removed or never allocated, this Activity Resource Request will not be fulfilled.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HAND_OVER">
				<xs:annotation>
					<xs:documentation>If the second activity is going to be use for quadrant handover purpose.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UCI_SchemaVersionStringType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String representing the UCI version.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="5" />
			<xs:maxLength value="53" />
			<xs:pattern value="[0-9]{3}\.[0-9]{1,2}([a-z]{1})?(\.[0-9A-Za-z_\-]{1,45})?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UncertaintyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the basis of the reported uncertainty.  See enumerated type annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="1_SIGMA">
				<xs:annotation>
					<xs:documentation>Indicates the reported uncertainty is based on 1-sigma.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AVERAGE">
				<xs:annotation>
					<xs:documentation>Indicates the reported uncertainty is based on average.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MEAN_PLUS_1_SIGMA">
				<xs:annotation>
					<xs:documentation>Indicates the reported uncertainty is based on mean plus 1-sigma.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RMS">
				<xs:annotation>
					<xs:documentation>Indicates the reported uncertainty is based on Root Mean Square .</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RSS">
				<xs:annotation>
					<xs:documentation>Indicates the reported uncertainty is based on Root Sum of Squares.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UnitBallDoubleType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates 64-bit floating point values with a range of [-1,1].</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:double">
			<xs:minInclusive value="-1" />
			<xs:maxInclusive value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UnitBallFloatType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates 32-bit floating point values with a range of [-1,1].</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:float">
			<xs:minInclusive value="-1.0" />
			<xs:maxInclusive value="1.0" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UnitIdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique identifier for each unit. ([A-Z][A-Z] Position 1-2, SYSTEM ASSIGNED RECORD ORIGINATOR.  Two character code associated with the organization originating the unique UNIT ID.  Assigned by system at element creation time.     [ABCDEGJMNSX] Position 3, OB_TYPE     A Air Force     B Joint Forces     C Civilian     D Defensive Missile Forces     E Net     G Army     J Space Order of Battle (SOB)     M Ministry, Other Than Ministry of Defense (MOD)     N Navy     S Strategic Missile Forces     X Air Defense Order of Battle (ADOB)     [A-Z][A-Z] Position 4-5, ALLEGIANCE.  This item is selected from the 2 character list of valid State Department Allegiance codes.     [00001-99999] Position 6-10, ACCESSION_NUMBER.).</xs:documentation>
