						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitPlanStatusType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the planning and validation states of the orbit plan.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlanStatusType">
				<xs:sequence>
					<xs:element name="PlanPart" type="uci:OrbitPlanPartsEnum" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts are being statused. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitPlanType" uci:version="003.001.001.001">
		<xs:annotation>
			<xs:documentation>Contains the details of the orbit plan.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Applicability" type="uci:PlanApplicabilityType">
				<xs:annotation>
					<xs:documentation>Indicates the System or Systems which have a direct relationship with the RoutePlan.  See annotations for the underlying type and its child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time window within which all the sibling kinematics elements apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parts" type="uci:OrbitPlanPartsType">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts are included in the OrbitPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orbit" type="uci:OrbitRegimeType" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates an orbital regime in which the spacecraft will reside during the OrbitPlan.  This element is included for convenience in querying for OrbitPlans in the same regime. List size is based on the number of enum values ("Select All That Apply") in OrbitRegimeEnum type. If multiple instances are given, each should be of a different OrbitRegimeEnum type as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parameters" type="uci:OrbitKinematicsSetParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates kinematics related settings and constraints which can vary by plan by discretion of the plan creator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FirstSequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the first sequence (first instance of the sibling Sequence element) in the orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Sequence" type="uci:OrbitKinematicsSequenceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the planned orbital kinematics for a sequence of the orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationCommandMDT" uci:version="003.001.003.001">
