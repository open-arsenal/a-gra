	<xs:complexType name="SubsystemMaintenanceStatusMDT" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>The SubsystemMaintenanceStatusMDT is the Message Data Type (MDT) of the SubsystemMaintenanceStatus Message.  This message typically reports all maintenance status unless the MaintenanceCommandInformation is provided for a specific CommandID and its associated tests.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
