	<xs:complexType name="SystemDeploymentCapabilityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>Indicates the physical means of deployment of a Capability instance.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:SystemDeploymentEnum" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates the physical means by which a System can deploy another System.  This physical means is the primary tier of decomposition of the System Deployment capability.  See enumerate annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DeployableSystem" type="uci:DeployableSystemIdentityType">
						<xs:annotation>
							<xs:documentation>Indicates the type of system that is deployed.  The deployable object could be a platform or defined by another 6016 taxonomy.  Even though there are four optional fields, a program is required to fill in at least one of the elements. When advertising a system deployment capability, you are required to indicate the System or Systems you can deploy.  That indication is flexible.  It can be given by System category (Platform), System type (Specific), System instance (SpecificVehicle) or weapon type (Weapon).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DeployFrom" type="uci:EnvironmentEnum">
						<xs:annotation>
							<xs:documentation>Indicates the environment (physical operating domain) which the Capability can deploy a System from.  Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DeployTo" type="uci:EnvironmentEnum">
						<xs:annotation>
							<xs:documentation>Indicates the environment (physical operating domain) which the Capability can deploy a System to.  Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:SystemDeploymentOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages. Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemDeploymentOptionsType" uci:version="000.000.000.000">
