	<xs:complexType name="CommandableCapabilityDeclarationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A capability type that extends from the CapabilityDeclarationBaseType and includes additional elements for capabilities that support commandable operations.</xs:documentation>
