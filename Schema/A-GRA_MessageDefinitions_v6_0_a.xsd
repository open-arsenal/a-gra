					<xs:documentation>Indicates the current state of the ESM_Command for Geolocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeolocationType" type="uci:SignalGeolocationMethodEnum" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a commanded geolocation type/technique to use. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_SubcapabilityTargetLocationDataType" uci:version="002.001.002.000">
