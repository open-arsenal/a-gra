		<xs:sequence>
			<xs:element name="CollectionFrequency" type="uci:CollectionFrequencyType">
				<xs:annotation>
					<xs:documentation>Defines the single frequency for the Pulse Data collection to be used for all dwells defined in the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>The requested start time for the subsystem to begin the commanded pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellDuration" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Defines the length of each dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dwells" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Total number of collect dwells, to include the initial dwell and any repetitions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RepetitionInterval" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time (start-to-start) between dwells.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalBandwidth" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the estimated bandwidth of the signal being processed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modulation" type="uci:ModulationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the modulation  type to be used for the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataCollectType" type="uci:SignalTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of geolocation to be processed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SampleRate" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Set the sample rate for the collection, in Hz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FFT_PointsPerSample" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Set the number of points per sample that will be used in the Fast Fourier Transform processing on the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COMINT_Interactive" type="uci:COMINT_InteractiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element identifies additional parameters of a COMINT subsystem which may be adjusted interactively during operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
