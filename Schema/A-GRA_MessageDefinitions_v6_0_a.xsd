	<xs:complexType name="MDF_ReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type is used to reference an MDF and optionally an MDF subcategory file and/or specific items within the file or MDF.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MDF_ID" type="uci:MDF_ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the MDF being referenced.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MDF_SubCategoryFileID" type="uci:MDF_SubCategoryFileID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the MDF subcategory file being referenced.  Required when the referenced MDF referenced by the sibling MDF_ID is decomposed into individually selectable subcategory files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MDF_ItemIndex" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the index of a specific item within the referenced MDF or MDF subcategory file.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MDF_StatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CurrentMDF" type="uci:MDF_CommandType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the currently active Mission Data File for this Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandedMDF" type="uci:MDF_CommandType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the MDF that has been commanded for activation for this Capability.  Upon completion of activation, this MDF becomes the CurrentMDF.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FailedMDF" type="uci:MDF_CommandType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the MDF that most recently failed activation for this Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MDF_SubCategoryFileID_Type" uci:version="000.000.000.000">
