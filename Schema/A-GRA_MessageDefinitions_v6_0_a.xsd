					<xs:element name="ResultsPerPage" type="uci:ShortPositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the maximum number of results per page when pagination is used. This requests that pagination be used when the response is returned. If this is not set then the response may or may not use pagination.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MostRecentMessagesOnly" type="uci:EmptyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the response should return the most recent messages only that meet the filters.  This is used in restart to quickly determine state. Multiple query requests may still be required for messages that are activated for example.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="QueryIdentifiersOnly" type="uci:EmptyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the response should ONLY return the matching identifiers, and not the data objects.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="QueryMessage" type="uci:QueryMessageType">
						<xs:annotation>
							<xs:documentation>The filter used to select the messages or IDs that are returned by the corresponding status.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>ID of the system making the request.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
