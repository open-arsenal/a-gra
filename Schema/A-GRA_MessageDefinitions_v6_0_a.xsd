					<xs:documentation>Allows the Communication Planner to apply the key at a specified slot. Such as selecting the appropriate VINSON Key.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CryptoZeroize" type="uci:CryptoLocationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Allows the Communication Planner to Zeroize crypto slots.</xs:documentation>
				</xs:annotation>
