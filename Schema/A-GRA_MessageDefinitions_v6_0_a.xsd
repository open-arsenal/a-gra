	<xs:simpleType name="SAM_ModeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the operational state of a SAM launch site such as transitions to various states, standby, etc.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NO_REPORT">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STANDBY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRANSITION_TO_OFF_LINE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
