		</xs:annotation>
		<xs:restriction base="uci:DoubleNonNegativeType" />
	</xs:simpleType>
	<xs:simpleType name="EntityBasingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The geographic/orbital domain of operations used for tasking.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FIXED_TERRESTRIAL">
				<xs:annotation>
					<xs:documentation>Anything between Earth's center and 100 km above Earth surface. For a sensor, identifies a sensor that is hard-locked to a geographic location (or requiring a REALLY big moving effort).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MOBILE_TERRESTRIAL">
				<xs:annotation>
					<xs:documentation>Anything between Earth's center and 100 km above Earth surface. For a sensor, identifies a sensor that is dynamically changing location, perhaps during actual measurements (ex: from an airplane).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRANSPORTABLE_TERRESTRIAL">
				<xs:annotation>
					<xs:documentation>Anything between Earth's center and 100 km above Earth surface. For a sensor, identifies a sensor that has a fixed location for measurements (ex: SBX on an oil rig or the heritage MOSS optical system that stayed in one place for an extended period of time but could be reasonably relocatable to meet mission needs).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE">
				<xs:annotation>
					<xs:documentation>Anything above 100 km above Earth surface.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAND">
				<xs:annotation>
					<xs:documentation>Anything in or on Earth's landmass.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIR">
				<xs:annotation>
					<xs:documentation>Anything between Earth's surface and 100 km above Earth's surface.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MARITIME">
				<xs:annotation>
					<xs:documentation>Anything on or in Earth's oceans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LEO">
				<xs:annotation>
					<xs:documentation>Anything in Earth orbit with period less than 225 minutes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_LEO">
				<xs:annotation>
					<xs:documentation>Anything in Earth orbit with period greater than 225 minutes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEO">
				<xs:annotation>
					<xs:documentation>A near-circular orbit with period +/- x minutes of one sidereal day.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUPER_GEO">
				<xs:annotation>
					<xs:documentation>Indicates the super GEO orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityDropPolicyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the policy to be used to drop multiple Entities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="REMOVE_ALL">
				<xs:annotation>
					<xs:documentation>Indicates a command to remove all Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REMOVE_ALL_BUT_PROTECTED">
				<xs:annotation>
					<xs:documentation>Indicates a command to remove all Entities that are not in the Drop Protect State.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESTORE_ALL">
				<xs:annotation>
					<xs:documentation>Indicates a command to undo a Remove all but protected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityFusionEligibilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the level of eligibility for automated fusion.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FULL">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed with any other Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SELECTIVE_EXCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed in general but with specific Entity or Entities excluded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SELECTIVE_INCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed but only with specific Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is not allowed for an Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityFusionSimpleEligibilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the entity is eligible for automated fusion.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FULL">
				<xs:annotation>
					<xs:documentation>Indicates that the merged Entity is fully eligible for future automated fusion operations including splits from the Entity it was merged with.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>Indicates that the merged Entity is not eligible for future automated fusion with any Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityManagementRequestAuthorityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates if EntityManagementRequest is a request or an order.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="REQUEST">
				<xs:annotation>
					<xs:documentation>REQUEST EntityManagementRequests can be overruled by operators or better source data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORDER">
				<xs:annotation>
					<xs:documentation>ORDER EntityManagementRequests are issued by systems that have been defined by the mission having Change Data Authority. ORDER EntityManagementRequests must be accepted and update the associated Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityRemoveReasonEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the reason for removing an entity from the system.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MERGED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity or SignalReport was removed because a fusion algorithm/service or operator merged it into another Entity or Signal.  For example, say Entity 1 is a fusion input from System A, Entity 2 is a fusion input from System B and initially fusion outputs Entity 3 (corresponding to Entity 1) and Entity 4 (corresponding to Entity 2).  Later, fusion determines that Entity 1 and Entity 2 refer to the same physical system and merges them into an updated Entity 3.  Entity 4 is then REMOVED with RemoveReason of MERGED and MergedTo indicating Entity 3.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATOR_REMOVE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity or SignalReport was removed in response to an operator's explicit command to remove it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STALE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity or SignalReport was removed because staleness and/or timeout criteria was met.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVERLOAD">
				<xs:annotation>
					<xs:documentation>Indicates the Entity or SignalReport was removed because the maximum number of Entities or SignalReports for the source was exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntitySourceEnum" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>Provides a list of possible entity sources.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EOB">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an EOB record (Electronic Order of Battle) message or other EOB-oriented data source that has been promoted to an Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOB">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is a SOB Record (Space Order of Battle) or other SOB-oriented data source that has been promoted to an Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IFF">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an IFF (Identify Friend or Foe) data source such a radio.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIS">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an AIS (maritime Automatic Identification System) data source such as a radio.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BFT">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a BFT (Blue Force Tracker) data source.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTERNAL_IBS">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is a MIL-STD-6018 IBS "track" message that has been republished as an Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTERNAL_LINK16">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is a MIL-STD-6016 "track" message that has been republished as an Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTERNAL_LINK16_EW">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is a MIL-STD-6016 electronic warfare product message that has been republished as an Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTERNAL_OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is a republication or a "track" from another non-UCI data source.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUSION_C2">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an output of a fusion Service at the C2 node of a potentially tiered fusion system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUSION_SPACE_SURVEILLANCE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an output of a fusion Service at the space surveillance node of a potentially tiered fusion system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUSION_SYSTEM">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an output of a fusion Service at a vehicle control station or vehicle node of a potentially tiered fusion system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUSION_OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an output of a fusion Service at an unspecified type of node.  This value is meant for temporary use while a more formal definition/name of the node, from a fusion perspective, is developed and incorporated into the standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERNALLY_DERIVED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is derived from data from another UCI message.  This is an indication that the data in the source message has been promoted to an Entity in order to enable Entity-oriented use-cases and interactions with the data.  For example, an OpPoint or OperatorLocationOfInterest could be promoted to an Entity to allow Tasks and fusion against it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATOR">
				<xs:annotation>
					<xs:documentation>Indicates the Entity was manually created by a human operator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_ACTIVE_OPTICAL">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an active optical sensor track Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_PASSIVE_OPTICAL">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a passive optical sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_SAR">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a radar SAR sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_SMTI">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a radar SMTI (Surface Moving Target Indicator, ground or maritime) sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_AMTI">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a radar AMTI (Air Moving Target Indicator) sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_ESM">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a signals intelligence, specifically ESM (Electronic Support Measures), sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_ELINT">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a signals intelligence, specifically ELINT (Electronic Signals Intelligence), sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_COMINT">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a signals intelligence, specifically COMINT (Communications Intelligence), sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_EA">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an EA Capability.  Detection and tracking of Entities that are electronically attacked (EA) is often done by an independent ESM (sibling enumerate CAPABILITY_ESM) or other "sensor" Capability.  However, EA Capabilities are often implemented with a built-in ESM-like Capability to track a signal and optimize the EA response in real time; this enumerate is only intended for this case.  This enumerate is not intended to represent an ESM Capability that operates independent of EA.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_ORBITAL_SURVEILLANCE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an Orbital Surveillance capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a non-specified sensor Capability.  This value is meant for temporary use while a more formal definition/name of the Capability is developed and incorporated into the UCI standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_DERIVED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from a Product such as a sensor image file.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the Entity originated from an unknown, unspecified type of source.  This value is meant for temporary use while a more formal definition/name of the source is developed and incorporated into the UCI standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EntityStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the status of an Entity. This includes early status (POTENTIAL, TENTATIVE), active status (CONFIRMED), inactive status (DROP_PENDING), end status (DROPPED, DESTROYED), or unknown status (MISSING, UNKNOWN, GHOST).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="POTENTIAL">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of POTENTIAL.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TENTATIVE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of TENTATIVE.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONFIRMED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of CONFIRMED.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DROP_PENDING">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of DROP_PENDING.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DROPPED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of DROPPED.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GHOST">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of GHOST.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DESTROYED">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of DESTROYED.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSING">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of MISSING. Systems may characterize an entity as 'Missing' if it cannot be located for a period of time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the Entity has been assigned a condition of UNKNOWN.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EnvironmentEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the environment or "domain" of operation. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the airborne environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the space (upper atmosphere) environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the ground/terrestrial environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SURFACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the sea surface environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SUBSURFACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the sea subsurface environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the environment or "domain" in which the Entity is operating is not known.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
