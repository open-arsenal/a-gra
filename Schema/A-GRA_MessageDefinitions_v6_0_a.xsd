				</xs:annotation>
			</xs:element>
			<xs:element name="ExecutionStatus" type="uci:MA_RequirementExecutionStatusDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates execution status for the associated Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementsTemplateType" uci:version="003.000.003.000">
