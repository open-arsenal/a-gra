				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASSAULT">
				<xs:annotation>
					<xs:documentation>Climax of an attack; closing with the enemy in hand-to-hand fighting.  Short, violent attack, against local objective.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASSESS">
				<xs:annotation>
					<xs:documentation>Pose a judgment after comparing measured performances against a standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK">
				<xs:annotation>
					<xs:documentation>Destruction order; orders the destruction of an object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_ARMED_RECONNAISSANCE">
				<xs:annotation>
					<xs:documentation>Order the conduct of Aerial Reconnaissance in the vicinity of a specified objective, with the delivery of ordnance when targets of opportunity are located.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_ASSIGN">
				<xs:annotation>
					<xs:documentation>Order to prepare to engage or attack an objective. Firing is not authorized until ordered or objective becomes eligible for destruction under existing doctrine and/or Rules of Engagement (ROE).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_COUNTER">
				<xs:annotation>
					<xs:documentation>Destruction order; better known as "counter attack".  Attack by a part or all of a defending force for such specific purposes as regaining ground lost or cutting off or destroying adversaries' advance units, with the general objective of denying to the adversary the attainment of their purpose in attacking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_CYBER">
				<xs:annotation>
					<xs:documentation>Orders attack of an object using cyber means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_DEAD">
				<xs:annotation>
					<xs:documentation>Destruction of Enemy Air Defenses (SEAD).  Order the neutralization of enemy air defenses, including radars and launchers, in the vicinity of a specific objective through physical attack or electronic warfare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_DIRECTED_ENERGY">
				<xs:annotation>
					<xs:documentation>Destruction order; orders the destruction of an object using directed energy means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_ELECTRONIC">
				<xs:annotation>
					<xs:documentation>Also known as EA or Electronic Attack.  Orders attack of an object using electronic warfare means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_KINETIC">
				<xs:annotation>
					<xs:documentation>Destruction order; orders the destruction of an object using kinetic means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_SEAD">
				<xs:annotation>
					<xs:documentation>Suppression of Enemy Air Defenses (SEAD).  Order the neutralization of enemy air defenses, particularly radars, in the vicinity of a specific objective using anti-radiation weapons or electronic warfare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTACK_SWEEP">
				<xs:annotation>
					<xs:documentation>Order to seek out and destroy enemy entities or other targets of opportunity in an allocated area of operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BREACH">
				<xs:annotation>
					<xs:documentation>Deliberate or hasty: cross or create a lane through a minefield or IED belt or a clear route through a barrier or fortification.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BREAK_OUT">
				<xs:annotation>
					<xs:documentation>Continuation of a crossing operation once the force has consolidated in the bridgehead; or offensive action by an encircled force to link-up with a main force.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BUILD_UP">
				<xs:annotation>
					<xs:documentation>Attain prescribed strength of units and prescribed levels of vehicles, equipment, stores and supplies.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BYPASS">
				<xs:annotation>
					<xs:documentation>Move around an obstacle, position or enemy force to maintain the momentum of advance.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C2">
				<xs:annotation>
					<xs:documentation>Perform Command and Control (C2) over systems, entities, people, etc.  Sibling enumerations include more specific forms of C2; use them when applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C2_CYBER">
				<xs:annotation>
					<xs:documentation>Perform Command and Control (C2) over cyber functions of systems, entities, people, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C2_OPERATIONAL">
				<xs:annotation>
					<xs:documentation>Perform operational level Command and Control (C2) over systems, entities, people, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C2_STRATEGIC">
				<xs:annotation>
					<xs:documentation>Perform strategic level Command and Control (C2) over systems, entities, people, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="C2_TACTICAL">
				<xs:annotation>
					<xs:documentation>Perform tactical level Command and Control (C2) over systems, entities, people, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLLECT">
				<xs:annotation>
					<xs:documentation>Assemble, accumulate or acquire data or information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLLECT_INTEL">
				<xs:annotation>
					<xs:documentation>Assemble, accumulate or acquire intelligence data or information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONFIRM">
				<xs:annotation>
					<xs:documentation>Provide current information of previous reporting within a specified degree of certainty and/or accuracy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COORDINATE">
				<xs:annotation>
					<xs:documentation>Bring functions, systems or entities operating in the same environment in proper relation in order to avoid counter-productive results such as duplication of effort or mutually negating actions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CROSS">
				<xs:annotation>
					<xs:documentation>Deliberate or hasty: pass over or through an obstacle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CROSS_CUE">
				<xs:annotation>
					<xs:documentation>Preplanned collaborative detection, recognition, identification, location or tracking; the deliberate handover of a collection/find task to a nominated unit, system or person.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIND_SEARCH">
				<xs:annotation>
					<xs:documentation>Search for and find a unit, object, activity, situation, event or person or persons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IDENTIFY">
				<xs:annotation>
					<xs:documentation>Determine the status (including friendly or hostile nature) of the detected unit, object, activity, situation, event or person or persons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IDENTIFY_VISUAL">
				<xs:annotation>
					<xs:documentation>Order the identification of a specified objective by visual means.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFORM">
				<xs:annotation>
					<xs:documentation>Impart information or knowledge.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INSERT_INFILTRATE">
				<xs:annotation>
					<xs:documentation>Deploy reconnaissance, stay-behind or raiding forces out of contact with the enemy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERDICT">
				<xs:annotation>
					<xs:documentation>Divert, disrupt, delay or destroy an enemy's military potential before it can be used effectively against friendly forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERCEPT">
				<xs:annotation>
					<xs:documentation>Search for and listen to and/or record communications and/or electronic data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERVENE">
				<xs:annotation>
					<xs:documentation>Order to turn away a specified target from its intended direction of travel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INVESTIGATE_INTERROGATE">
				<xs:annotation>
					<xs:documentation>Order the collection of additional information about a specified objective by sensor or visual means.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LIAISE">
				<xs:annotation>
					<xs:documentation>Maintain contact or intercommunication between elements of military forces to ensure mutual understanding and unity of purpose and action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LINK_UP">
				<xs:annotation>
					<xs:documentation>Establishment of contact, in enemy controlled territory, between one or more friendly units or formations which have the same or differing missions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOCATE_FIX">
				<xs:annotation>
					<xs:documentation>Establish a position of the detected unit, object, activity, situation, event or person or persons to a specified accuracy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS">
				<xs:annotation>
					<xs:documentation>Detailed coordination of a complex operation involving many people, facilities, or supplies.  Sibling enumerations include more specific forms of logistics; use them when applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_LOADING">
				<xs:annotation>
					<xs:documentation>Logistics focused on loading and unloading of items including people and supplies.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_REPLENISH">
				<xs:annotation>
					<xs:documentation>Logistics focused on replenishing items including people and systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_RESUPPLY">
				<xs:annotation>
					<xs:documentation>Logistics focused on resupplying consumable items.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_REFUEL">
				<xs:annotation>
					<xs:documentation>Logistics focused on resupplying of consumable energy resources such as fuel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_TOWING">
				<xs:annotation>
					<xs:documentation>Logistics focused on movement of items via towing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_TRANSPORT">
				<xs:annotation>
					<xs:documentation>Logistics focused on movement of items via transport.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_TRANSITING">
				<xs:annotation>
					<xs:documentation>Logistics focused on movement of items.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOGISTICS_SUPPORT">
				<xs:annotation>
					<xs:documentation>Logistics focused on supporting the needs of people, facilities or systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANIPULATE">
				<xs:annotation>
					<xs:documentation>Manage to advantage (person or situation).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER">
				<xs:annotation>
					<xs:documentation>Employ forces on the battlefield (using movement) in combination with fire or fire potential to achieve a position of advantage in respect to the enemy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MARK">
				<xs:annotation>
					<xs:documentation>Call for fire on a specific location to orient the observer or spotter or to indicate targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MEDEVAC">
				<xs:annotation>
					<xs:documentation>Medical evacuation (MEDEVAC).  Movement of people to facilitate medical assistance.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MENTOR">
				<xs:annotation>
					<xs:documentation>Develop capacity through example and/or advice through planning and preparation, execution and lessons capture/After Action Review (AAR) phases.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MONITOR_OBSERVE">
				<xs:annotation>
					<xs:documentation>Develop or maintain situational awareness, pattern of life or atmospherics of a geographical area, activity or situation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONCOMBATANT_OPERATIONS">
				<xs:annotation>
					<xs:documentation>Operations by people not associated with combat or military forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OCCUPY">
				<xs:annotation>
					<xs:documentation>Move into and enable proper organization of an area to be used as a battle position.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORGANIZE">
				<xs:annotation>
					<xs:documentation>Give orderly structure to.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates an other type of Action.  Use of this enumerate should avoided or at least minimized.  If used, it should only be used temporarily while proposing the addition of new well named enumerate(s) to the standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVERTHROW">
				<xs:annotation>
					<xs:documentation>Remove forcibly from power.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PATROL">
				<xs:annotation>
					<xs:documentation>Move tactically within an area of responsibility to deliver a clearly defined Effect.  A patrol is conducted in an area where an enemy threat precludes normal administrative movement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROCESS_INTEL">
				<xs:annotation>
					<xs:documentation>Process intelligence in support of operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT">
				<xs:annotation>
					<xs:documentation>1) To cover or shield from exposure, damage or destruction.
					2) To keep from harm, attack, injury or exploitation.
					3) To maintain the status or integrity of.
					4) Safeguard.
					5) Protect by offense, defense or threat of either or both.
					6) Order to maintain a good posture relative to a specified target from which a successful engagement/attack can be accomplished if needed.  The standoff distance with respect to the target is established by standard operating procedures.

					Also known as COVER.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_CAP">
				<xs:annotation>
					<xs:documentation>Combat Air Patrol (CAP).  Order to patrol in the vicinity of the objective for the purpose of defending against hostile aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_CAS">
				<xs:annotation>
					<xs:documentation>Close Air Support (CAS).  Order the delivery of ordnance against hostile forces that are in close proximity to friendly ground forces. Close coordination with an airborne or ground Forward Air Controller (FAC) is required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_CCD">
				<xs:annotation>
					<xs:documentation>Camouflage, concealment and decoys (CCD).  Order to protect through the use of CCD.  To mask or conceal from detection or viewing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_ESCORT">
				<xs:annotation>
					<xs:documentation>Order to accompany and protect a specified objective.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_KINETIC">
				<xs:annotation>
					<xs:documentation>Protect using kinetic means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_DIRECTED_ENERGY">
				<xs:annotation>
					<xs:documentation>Protect using directed energy means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_CYBER">
				<xs:annotation>
					<xs:documentation>Protect using cyber means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_EW">
				<xs:annotation>
					<xs:documentation>Protect using electronic warfare means/weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_PICKET">
				<xs:annotation>
					<xs:documentation>Act as a warning or rescue unit at a point outside a formation or geographic area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECT_TOMCAT">
				<xs:annotation>
					<xs:documentation>Screen returning aircraft to prevent enemy aircraft from locating the force.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RECONNAISSANCE">
				<xs:annotation>
					<xs:documentation>Order to obtain intelligence information about the objective through the use of sensors or visual means.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RETURN_TO_BASE">
				<xs:annotation>
					<xs:documentation>Order to return to the assigned base or perform related operations to depart the airspace.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_AND_RESCUE">
				<xs:annotation>
					<xs:documentation>Order to search for and rescue personnel in distress in the vicinity of the objective.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_AND_RESCUE_COMBAT">
				<xs:annotation>
					<xs:documentation>Order to search for and rescue personnel in distress in the vicinity of active combat.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHADOW">
				<xs:annotation>
					<xs:documentation>Order to keep a specified target under observation.  The standoff distance with respect to the target is established by standard operating procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TARGET">
				<xs:annotation>
					<xs:documentation>Determines the desired effect and targeting solution then obtain required approval to engage/attack.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Maintain identification and location of a unit, activity, situation or person or persons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRAINING">
				<xs:annotation>
					<xs:documentation>Train for military missions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARN">
				<xs:annotation>
					<xs:documentation>Preplanned provision of information to provide warning of a specified situation, event or activity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WITHDRAW">
				<xs:annotation>
					<xs:documentation>Move away from the enemy (in or out of contact).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_ActiveWeaponStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This enumerated type provides further detail to the ENABLED, ACTIVE_* or COMPLETED enumerations provided by the ActivityStateEnum enumeration. If the activity is ENABLED, ACTIVE_* or COMPLETED this message enumeration defines the specific state of the weapon store during the activity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TARGETED">
				<xs:annotation>
					<xs:documentation>Indicates that a target has been selected and the munition has not been released yet. Report with the ENABLED state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUESTED">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been requested for release. Report with the ENABLED state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEEKER_INACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released but its local seeker has not been activated. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEEKER_ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released and its local seeker has been activated. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUZE_INACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released but its fuze has not been activated. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUZE_ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released and its fuze has been activated. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_FULLY_AUTONOMOUS">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released not fully autonomous and thus not able to guide without datalink or target destination. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FULLY_AUTONOMOUS">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released and is fully autonomous and able guide without datalink or target destination. Report with the ACTIVE_* state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEFEATED">
				<xs:annotation>
					<xs:documentation>Indicates the munition has been released and but it has been out maneuvered by the assigned target. Report with the COMPLETED state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIMED_OUT">
				<xs:annotation>
					<xs:documentation>Indicates the munition flight has ended, and it did not intercept the assigned target. Report with the COMPLETED state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUCCESS">
				<xs:annotation>
					<xs:documentation>Indicates the munition flight has ended, and it intercepted the assigned target. Report with the COMPLETED state generated by ActivityStateEnum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_AutonomousDataManipulationPolicyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Sets what Mission Autonomy can do when in the package leader role with respect to data management for its team members. In all cases, platforms can't modify data instances and Commands coming from above(Mission Planning, C2, or package leader MA). See individual enumerations for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FORWARD_ONLY">
				<xs:annotation>
					<xs:documentation>Package leaders can forward data coming from Mission Planning, C2, or package leaders to package members. Package leaders shall not generate new data for their team members.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GENERATE">
				<xs:annotation>
					<xs:documentation>Package leaders can forward data coming from Mission Planning, C2, or package leaders to package members. Additionally, package leaders can generate new data instances for their package members and can, where applicable: update, delete, assign, activate and command those data instances for the package members.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_CannotComplyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The reason why an action (Task, Command, Activity, etc.) was rejected, interrupted, unallocated or failed.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CONSTRAINT_ATTEMPTS">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the number of attempts specified in the command was reached before the action achieved the desired result.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_ENDURANCE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of insufficient endurance. For example, fuel or battery limitations. This is a generalization of the former INSUFFICIENT_FUEL_QUANTITY indication.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_CLASSIFICATION">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the classification of the action, actor, capability or associated elements is inconsistent.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_FOR_FOV_LIMIT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it exceeds field of regard (FOR) or field of view (FOV) limitations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_GATING">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of a gating constraint on the command. For example, the target of the action didn't meet velocity, range, power, etc. gates/filters in the command.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_MANEUVER_LIMIT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because maneuvering exceeds maneuver limits of the action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_OP">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of a constraint imposed by an "Op" message (OpZone, OpLine, OpRouting, etc.). For example, a Strike Task in a NO_FIRE OpZone. This is a generalization of the previous NO_FIRE or NO_IMAGE indications.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_OCCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of line of sight limitations due to terrain occlusion.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_RANGE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of a range related limitation of the associated Capability. This is a generalization of the former INSUFFICIENT_SENSOR_RANGE indication.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_PERFORMANCE">
				<xs:annotation>
					<xs:documentation>Indicates that Resource Manager cannot allocate resources to the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) such that the PerformanceConstraints in PerformanceMetricSetType are met.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_RF">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of a conflict between the needed/commanded RF parameters and the RF spectrum available. For example, the commanded RF band isn't supported by the loaded MDF of a Capability or there is an active RF_Profile that doesn't allow transmission in the commanded band. This is a generalization of the former INVALID_RF_BAND, RF_SPECTRUM_LIMITED, RF_UNAVAILABLE and RF_PROFILE_RESTRICTION.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_ROUTE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it isn't achievable given the currently planned route. Alternatively, a route to achieve the action couldn't be generated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_SAFETY">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of a safety related constraint.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_TARGET_ANGLE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of command constraints on the angle between the actor and the target of the action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_TIME">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it has temporal requirements that can't be achieved or were reached before the action achieved the desired result.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_SYSTEM">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it was constrained for allocation to a specific System that cannot complete it. This is a generalization of the previous INELIGIBLE_VEHICLE indication.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFEASIBLE_ROUTE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because a route to achieve the action couldn't be generated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_EVENT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily due to a general mission event (flight contingency, mission contingency, allocation change, etc.). This is generalization of the previous MISSION_EVENT indication.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STATE_OR_SETTINGS">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of current/future state or settings of the corresponding Capability or Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STATE_OR_SETTINGS_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because a change in the state or settings of the corresponding Capability or Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SYSTEM_UNAVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated System wasn't available at the needed time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SYSTEM_FAULT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated System is faulted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SYSTEM_CONFLICT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the action results in conflict with another System's route, sensor, weapon or other plans/actions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBSYSTEM_UNAVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated Subsystem wasn't available at the needed time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBSYSTEM_FAULT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated Subsystem is faulted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_FAULT">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated Capability is faulted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_PRECEDENCE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the precedence of its associated Capability within the associated Subsystem wasn't high enough for the action to proceed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_UNAVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the associated Capability wasn't available at the needed time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INSUFFICIENT_RESOURCES">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of insufficient resources (e.g. signal processors, memory or other items generally subordinate to Subsystems and Capabilities). In this condition, the associated Capability, Subsystem and System should be otherwise able to perform the action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RANKING">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because its ranking wasn't high enough to gain or maintain access to the required capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEATHER">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of weather effects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INELIGIBLE_CONTROL_SOURCE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the source of the action isn't eligible and/or hasn't been granted permission to control (mission control, primary capability control, secondary capability control, automated capability management) the associated System or Capability. This is a generalization of the former SYSTEM_NOT_IN_CONTROL and SERVICE_NOT_IN_CONTROL.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPENDENCY_PREDECESSOR">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because a required predecessor action wasn't allocated, unallocated, failed, etc. This is a generalization of the former UNASSIGNABLE_DEPENDENT_TASK.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPENDENCY_ALL_OR_NOTHING">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it has an "all or nothing" association with another action that wasn't allocated, unallocated, failed, etc. This is a generalization of the former ALL_OR_NOTHING_TASK_CONSTRAINT.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPENDENCY_EITHER_OR">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because it has an "either or" association with another action that wasn't allocated, unallocated, failed, etc. This is a generalization of the former EITHER_OR_TASK_CONSTRAINT.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INIT_CRITERIA_NOT_MET">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the initialization conditions were not met.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN_ID">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the object corresponding to an ID in the command could not be found.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INVALID_INPUT_PARAMETER">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because a parameter in the action or other associated input was invalid.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INPUT_OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of another unspecified input problem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDF_ACTIVATION_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the action to activate an MDF ([Capability]SettingsCommand was rejected because the commanded MDF_ID and/or SubCategory FileID is invalid or represents a file set that is not compliant with the Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTIPLE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of multiple sibling enumeration reasons but a specific single reason isn't known.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CANCELED">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was canceled, generally by the originating source. This is a generalization of the previous USER_CANCELED indication.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of another reason which hasn't yet been incorporated into the enumeration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because of an unknown reason.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ABORTED">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was aborted due to constraints and/or priorities of the mission or system. This is different from an action that was canceled, rejected, or failed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALIGNMENT_MANEUVER">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the store reports conditions which indicate that their inertial navigation system platform quality is poor and the platform should perform a maneuver to allow system to align itself.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_COLLISION_AVOIDANCE">
				<xs:annotation>
					<xs:documentation>Indicates the action (Task, [Capability]Command, [SupportingCapability]Command, [Capability]Activity, etc.) was rejected, interrupted, unallocated, failed or generally can't be completed satisfactorily because the store reports conditions which indicate that their inertial navigation system platform quality is poor and the platform should perform a maneuver to allow system to align itself.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_CAP_CapabilityEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the first tier in the taxonomy for the CAP Capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="COMBAT_AIR_PATROL">
				<xs:annotation>
					<xs:documentation>Indicates a CAP capability</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_CAP_LegIndexEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates defined points in the CAP route.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="HOT_LEG_START">
				<xs:annotation>
					<xs:documentation>Indicates the point at the start of the CAP hot leg. The CAP hot leg defines the CAP leg where the vehicle is pointed downrange, flying towards the threat zone (in the opposite direction of the threat axis vector).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOT_LEG_END">
				<xs:annotation>
					<xs:documentation>Indicates the point at the end of the CAP hot leg. In the nominal case, this point will be the same point as defined by the CAP fix point. The CAP hot leg defines the CAP leg where the vehicle is potentially downrange, flying towards the threat zone (in the opposite direction of the threat axis vector).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLD_LEG_START">
				<xs:annotation>
					<xs:documentation>Indicates the point at the start of the CAP cold leg. The CAP cold leg defines the CAP leg where the vehicle is pointed uprange, flying away from the threat zone (in the same direction as the threat axis vector).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLD_LEG_END">
				<xs:annotation>
					<xs:documentation>Indicates the point at the end of the CAP cold leg. The CAP cold leg defines the CAP leg where the vehicle is pointed uprange, would be flying away from the threat zone (in the same direction as the threat axis vector).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_CAP_StateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the system state of a vehicle executing a CAP Task.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CAP_ENTRY">
				<xs:annotation>
					<xs:documentation>Indicates the system is in ingress to the initial or updated CAP pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAP_IN_PROGRESS">
				<xs:annotation>
					<xs:documentation>Indicates the system is flying its nominal CAP pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAP_DRIFT_IN_PROGRESS">
				<xs:annotation>
					<xs:documentation>Indicates the system is flying an adjusted CAP pattern that is active drifting from the nominal specified CAP pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAP_DRIFT_IDLE">
				<xs:annotation>
					<xs:documentation>Indicates the system is no longer actively drifting but is flying a CAP pattern that is drifted from the original/nominal CAP pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAP_RESET">
				<xs:annotation>
					<xs:documentation>Indicates the system has reset to fly back to the original/nominal CAP pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_CapabilityTypeEnum" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a type of Capability. See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTION">
				<xs:annotation>
					<xs:documentation>Indicates an action capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIR_SAMPLE">
				<xs:annotation>
					<xs:documentation>Indicates an air sampling capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AMTI">
				<xs:annotation>
					<xs:documentation>Indicates an airborne moving target indication (AMTI) capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AO">
				<xs:annotation>
					<xs:documentation>Indicates an active optical capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAP">
				<xs:annotation>
					<xs:documentation>Indicates a cargo delivery capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CARGO_DELIVERY">
				<xs:annotation>
					<xs:documentation>Indicates a cargo delivery capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMINT">
				<xs:annotation>
					<xs:documentation>Indicates a Communications Intelligence (COMINT) capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMM_RELAY">
				<xs:annotation>
					<xs:documentation>Indicates a communications relay capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMM_TERMINAL">
				<xs:annotation>
					<xs:documentation>Indicates a communications terminal capability</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COUNTER_SPACE">
				<xs:annotation>
					<xs:documentation>Indicates a Counter Space Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EA">
				<xs:annotation>
					<xs:documentation>Indicates an electronic attack (EA) capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
