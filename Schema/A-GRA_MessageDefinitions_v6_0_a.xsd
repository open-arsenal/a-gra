	<xs:complexType name="MA_PathSegmentType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this PathSegment. Other Paths or PathSegments may branch to this path segment by referring to this ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:PathSegmentSourceEnum">
				<xs:annotation>
					<xs:documentation>Defines whether the path segment was manually defined or if it was defined by an operator. This element can be used for many reasons including, but not limited to, operator display.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndPoint" type="uci:MA_EndPointType">
				<xs:annotation>
					<xs:documentation>Indicates the end point of the PathSegment. The start point is the end point of the previous PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Locked" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This flag is used to determine whether the segment can be modified/removed or was driven by an operator and therefore cannot be modified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modified" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If this element is present and set to TRUE, this PathSegment has been modified as part of a MODIFIED_ROUTE MissionPlan. This data is valuable to some planning algorithms to support validation of a user modified route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Speed" type="uci:PathSegmentSpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed or speed optimization of the System along the PathSegment at the EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CivilPathTerminator" type="uci:CivilPathTerminatorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the Civil Path Terminator information associated with the End Point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Climb" type="uci:ClimbType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the vehicle shall climb/descend and at what rate while traversing the path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumRoll" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum roll allowed along the PathSegment. Angle in radians representing vehicle's rotation about the longitudinal axis (the axis through the body of the vehicle from tail to nose) in a locally level, North-East-Down coordinate system centered on the vehicle. Roll is zero when the aircraft is wing-tip to wing-tip level in the North-East plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:AccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the acceleration of the System along the PathSegment at the EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextPathSegment" type="uci:NextPathSegmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is used to specify the next non-conditional PathSegment. This path segment can be the next segment in the current path or can be a transitional segment to another Path defined by the PathID. If the PathID is specified and differs from the current PathID, then this signals the end of the current Path and a transition to another Path. If no NextPathSegment is given then this is the end of the Route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConditionalPathSegment" type="uci:ConditionalPathSegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element is used to specify one or more conditional PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InertialState" type="uci:InertialStateRelativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element is intended to provide detailed inertial state information at user defined increments within a path segment. This element provides data which may be required for pre-mission analysis of a Route. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequiredTimeOfArrival" type="uci:TimeWindowType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes the mission planned required time of arrival. This message allows the operator to see a delta between the required and estimated arrival times that would allow for speed up/slow down determinations. This field is used as a constraint on the timing of the waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:RemarksType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates information about the path segment from an operator that is intended for display. Both short and longer detailed information can be provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequiredNavigationPerformanceInMeters" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the navigation performance accuracy required in an airspace. This value is in meters rather than the RNP standard of nautical miles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fix_Identifier" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies a geographical position determined by visual reference to the surface, by reference to one or more radio NAVAIDs, by celestial plotting or another navigational device.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
