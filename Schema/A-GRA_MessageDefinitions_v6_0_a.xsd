						<xs:annotation>
							<xs:documentation>Indicates the specific kinematic portion of the OrbitPlan that the Activity and sibling transition, trigger and time elements are associated with.  If omitted, the Activity must be temporally triggered.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
