	<xs:complexType name="TaskType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>Identifies the type of this Task instance. Note: When modifying this complexType (whether adding or removing choices), there are equivalent complexTypes that require the same modifications. Changes to this type may necessitate a modification to CapabilityTaxonomyType.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AirSample" type="uci:AirSampleTaskType">
				<xs:annotation>
					<xs:documentation>Air sample includes direct sampling of the air (SAMPLE) and remote sensing with spectral analysis (SPECTROMETER) with the intent of detecting NBC events.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AMTI" type="uci:AMTI_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to collect Air Moving Target Indicator (AMTI) data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AO" type="uci:AO_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to perform an optical emission such as laser designation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CargoDelivery" type="uci:CargoDeliveryTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to transfer cargo between locations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COMINT" type="uci:COMINT_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to provide COMINT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommRelay" type="uci:CommRelayTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to provide communications relay support.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CounterSpace" type="uci:CounterSpaceTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to employ a CounterSpace capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EA" type="uci:EA_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to provide electronic attack support to another System.  It guides/constrains the EA System by specifying where it should fly, what it should protect and what the threat is.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ESM" type="uci:ESM_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to collect ESM data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Flight" type="uci:FlightTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to effect the flight path/plan of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitChange" type="uci:OrbitChangeTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to perform an orbit change via a spacecraft maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalSurveillance" type="uci:OrbitalSurveillanceTaskType">
				<xs:annotation>
					<xs:documentation>Indicates an Orbital Surveillance Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalSurveillanceSensor" type="uci:OrbitalSurveillanceSensorTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to perform orbital surveillance sensor tasking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PO" type="uci:PO_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to collect Passive Optical data, imagery and video as well as perform PO search and track capabilities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Refuel" type="uci:RefuelTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task for one System to refuel another.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SAR" type="uci:SAR_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to collect a Synthetic Aperture Radar (SAR) image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SMTI" type="uci:SMTI_TaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to collect Moving Target Indicator (MTI) data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Strike" type="uci:StrikeTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a Task to kinetically attack/strike, with a weapon that can be released from the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemDeployment" type="uci:SystemDeploymentTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to perform a deployment or release of a system at a specified location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TacticalOrder" type="uci:TacticalOrderTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to perform a tactical order.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherRadar" type="uci:WeatherRadarTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to collect weather radar data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
