					<xs:documentation>Sets the default target tracker setting to attempt to acquire a target, lock onto the target, or release the target and stop tracking.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackArea" type="uci:IncreaseDecreaseEnum" minOccurs="0">
