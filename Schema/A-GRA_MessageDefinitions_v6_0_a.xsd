	<xs:complexType name="IPON_IID2_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProgramCode" type="uci:IPON_IID2_ProgramCodeType">
				<xs:annotation>
					<xs:documentation>See simple type documentation. NITF Image Subheader IID2 (aka Tactical Image ID) Program Code from first two chars of ATO. Either a numeric char followed by an alphabetic char, or vice-versa. Default is 9Z (unavailable) if not extant in ATO. Ref STDI-0005 (IPON).</xs:documentation>
				</xs:annotation>
			</xs:element>
