			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:RadarAltimeterCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the RadarAltimeter taxonomy. For RadarAltimeter, the first tier is an indication of whether a measurement is being performed or a check for RF interference.  If RFI Check is selected as Capability Type then many other options may not apply.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:RadarAltimeterSubCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability that is available with the Capability.  For RadarAltimeter, SubCapabilities indicate specific RadarAltimeter waveforms and/or processing techniques.  If a single RadarAltimeter Capability supports both land and sea operation, a "MIXED" SubCapability will be indicated.  If RFI_CHECK is selected for Capability Type, this setting does not matter.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:RadarAltimeterCapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages. Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FrequencyRange" type="uci:FrequencyRangeType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a frequency band/range used by the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:RadarAltimeterMessageOutputsEnum" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability. See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterCollectionConstraintsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a set of bounding requirements for the particular collection associated with this command. The subsystem should attempt to satisfy all specified constraints.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AngleConstraints" type="uci:RadarAltimeterAngleConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Bounding allowable angular deviations from true vertical for the altimetry measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeConstraints" type="uci:SlantRangeConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Distance from the sensor reference point (e.g. aperture reference point) to the ground reference point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FalseAlarm" type="uci:FalseAlarmType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the false alarm details for this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfDetection" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum probability of detection which should be used for this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emcon" type="uci:EmconConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to control the RF emissions associated with this command. If this field is not populated, the service determines all parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeConstraint" type="uci:AltitudeConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that an altitude constraint should be used for this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeReference" type="uci:AltitudeReferenceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If specified, altitudes in MinAltitude and MaxAltitude will be dictated by the measurement source enumeration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterCollectionOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RadarCollectionOptionsType">
				<xs:sequence>
					<xs:element name="Resolution" type="uci:RangeDopplerResolutionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Required resolution for this command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SignalToNoiseRatio" type="uci:DecibelType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Required SNR for the collection. The radar can use this information to calculate dwell times, number of pulses, number of CPIs, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FilteredUnfiltered" type="uci:FilteredUnfilteredEnum">
						<xs:annotation>
							<xs:documentation>The type of measurement commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
