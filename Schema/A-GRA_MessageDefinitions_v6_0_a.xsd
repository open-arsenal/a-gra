					<xs:documentation>The angle from true north to the line-of-sight vector from the platform to the target tangent plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementPlanConstraintType" uci:version="000.000.000.000">
