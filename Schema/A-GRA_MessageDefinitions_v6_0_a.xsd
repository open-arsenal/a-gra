	<xs:complexType name="MA_PackageManagementCommandMDT" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandBaseType">
				<xs:sequence>
					<xs:element name="PackageID" type="uci:PackageID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique identifier of the Package to form, join or leave.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ParentPackageID" type="uci:PackageID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If the sibling PackageID element is a sub-package, indicates the unique identifier of the parent package.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeType" type="uci:MA_PackageChangeEnum">
						<xs:annotation>
							<xs:documentation>Indicates the type of package change to perform.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the System(s) commanded to perform a package change.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConstraintID" type="uci:MA_ConstraintID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates any Constraints that may apply to this package.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PackageLeaderID" type="uci:SystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the System commanded to assume package leader role. Allows for the explicit specification of a leader without needing MA to conduct leader election.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PackagePartnerMetrics" type="uci:MA_PartnerMetricsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the leadership fitness metrics for the partners in the package.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PackageLeaderElectionMethod" type="xs:int" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies which election method/algorithm the package will utilize for electing a Package Leader. Implementors are expected to set a default election method. If blank, the default election method will be used.

Integer values and corresponding elections methods are as follows: 

0 - Bully Election Method. Supports Dynamic Fitness Scores and cases where Leadership Fitness Scores need to be shared as part of an election process.
1 - Static Fitness Score Election Method. Supports nomination of a leader assuming leadership fitness scores remain static once they have been defined by MP/C2.
2 - Maximum Consensus Election Method. Supports utilizing consensus algorithms to reach team consensus on the leader while preserving communication bandwidth.
3 - Raft Leader Election Method. Supports leader election using the Raft consensus algorithm, which ensures a distributed and fault-tolerant approach to electing a leader.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PackageLeadershipFitnessScoreDeterminationMethod" type="uci:MA_LeadershipFitnessScoreDeterminationMethodChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This field specifies the chosen fitness score determination method to be used for fitness scoring for the package.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
