			<xs:documentation>For an A2A search volume; this enum defines how to interpret the elevation volume center.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BODY">
				<xs:annotation>
					<xs:documentation>Indicates the scan center angle for the volume will be held constant relative to the body of the aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CENTER_ALTITUDE">
				<xs:annotation>
					<xs:documentation>Indicates the scan center angle for the volume will be held constant relative to the specified altitude at the specified range.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
