			</xs:element>
			<xs:element name="GeoFilter" type="uci:GeoFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the OpPoint must fall within to satisfy the filter. Multiple instances are logically ORed.</xs:documentation>
