	<xs:complexType name="StoreLoadoutConfigurationMDT" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>This type describes the different loadout combinations possible on an aircraft.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreLoadoutConfigurationID" type="uci:StoreLoadoutConfigurationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the StoreLoadoutConfiguration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Loadout" type="uci:StoreLoadoutConfigurationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A loadout is a combination of objects that could be installed on the aircraft at the same time.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutConfigurationMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This represents the different possible loadouts for the aircraft. Each loadout is a valid combination of items that could be installed on the aircraft at the same time.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:StoreLoadoutConfigurationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutConfigurationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A possible combination of installed items.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Mnemonic" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>A short name for the loadout. This allows for human comprehension of which loadout is being used and to what physical situation that corresponds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Hardpoint" type="uci:StoreLoadoutItemPET" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The loadout possible for each hardpoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutItemPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Abstract extension type for store loadout item.  Available extension types include: StoreLoadoutItemType.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutItemType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An item in a loadout. Each item can have siblings in the tree, as well as hold other items. This type contains recursion.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreLoadoutItemPET">
				<xs:sequence>
					<xs:element name="Location" type="xs:int">
						<xs:annotation>
							<xs:documentation>The location on the parent to which this item may be attached.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PossibleStore" type="uci:StoreItemType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The Mission or Carriage representations of the items that may be held at this location. An empty PossibleStore list means the location is empty.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreLoadoutMissionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An item in a loadout. Each item can have siblings in the tree, as well as hold other items.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreType" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>The Mission Store of this item (i.e. weapon).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mnemonic" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>The mnemonic representations of this MissionStore (i.e. name).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
