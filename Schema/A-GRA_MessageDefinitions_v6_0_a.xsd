	<xs:complexType name="OrbitalSurveillanceCapabilityType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>This type describes the Orbital Surveillance capability.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:OrbitalSurveillanceCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Orbital Surveillance taxonomy. The first tier is an indication of the focus of the collection, either based on one or more objects or for a defined volume. See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:OrbitalSurveillanceSubCapabilityEnum" maxOccurs="20">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability of the OrbitalSurveillance Capability; the second tier in the taxonomy of the OrbitalSurveillance capability type.  For OrbitalSurveillance, the second tier is an indication of the desired outcome of the collection.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CharacterizationOptions" type="uci:CharacterizationTypeEnum" minOccurs="0" maxOccurs="10">
						<xs:annotation>
							<xs:documentation>Indicates a type of characterization phenomenology that is supported by this capability. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SensorConstraints" type="uci:SensorConstraintsBaseType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This field specifies which type of sensor constraints are supported by this capability. If multiple instances are given, each should be of a different constraint type as indicated by the child element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:OrbitalSurveillanceMessageOutputsEnum" minOccurs="0" maxOccurs="11">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability. See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalSurveillanceCollectionRequirementsType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates orbital surveillance instructions and information to the sensor to enable appropriate sensor set-up and data collection to meet the orbital surveillance collection need.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="MetricCollection" type="uci:MetricCollectionType">
