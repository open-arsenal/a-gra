				</xs:annotation>
			</xs:element>
			<xs:element name="LineProjection" type="uci:LineProjectionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of mapping projection used for the Line.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LeftWidth" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the left width of the OpLine.  "Left" is in the locally level plane along the left of the Line as traversed from one sibling Point to the next.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RightWidth" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the right width of the OpLine.  "Right" is in the locally level plane along the right of the Line as traversed from one sibling Point to the next.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the lower altitude boundary of the OpLine. Altitude ranges in Point will override this value. If AltitudeReference is not specified, then the reference is the WGS-84 ellipsoid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The upper altitude boundary of the OpLine. Altitude ranges in Point will override this value. If AltitudeReference is not specified, then the reference is the WGS-84 ellipsoid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeReference" type="uci:AltitudeReferenceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to altitude measurement source.</xs:documentation>
				</xs:annotation>
			</xs:element>
