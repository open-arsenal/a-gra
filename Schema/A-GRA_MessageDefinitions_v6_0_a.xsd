			<xs:documentation>Contains component configuration data.   See individual field annotations for more details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentConfigurationID" type="uci:ComponentConfigurationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID, assigned to this ComponentConfiguration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the component corresponding to this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="About" type="uci:AboutType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates version numbers associated with the component and its software and hardware.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the mass associated with the component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityCrossReference" type="uci:CapabilityCrossReferenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Capability that is dependent upon this component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstallationLocationKey" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The ID of the logical location where the component is mounted.  The component could be mounted on another component or a subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstallationDetails" type="uci:InstallationDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates details of the component's physical installation on the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentType" type="uci:ComponentTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This enumerated element indicates whether the component is physical or logical.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentCode" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A code that uniquely identifies a component or function for a maintainer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>List of service IDs of services that are related to or tied to the component.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentConfigurationTreeType" uci:version="002.001.000.000">
		<xs:annotation>
			<xs:documentation>Contains component configuration data plus an option to specify a recursive tree structure of subcomponents.   See individual field annotations for more details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ComponentConfigurationPET">
