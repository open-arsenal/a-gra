					<xs:documentation>ID of the Service that this message is intended for using static configuration where RDMA_InitializeSetupID is empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endpoint" type="uci:NetworkEndpointType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the network endpoints (IP addresses) available for data transfers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RDMA_Provider" type="uci:RDMA_ProviderEnum">
				<xs:annotation>
					<xs:documentation>Indicates which libfabrics provider will be used for RDMA transfers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Host" type="uci:NetworkEndpointType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the host network information (IP addresses) needed for a transfer. This would generally be provided in another UCI message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndpointName" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the endpoint name for this RDMA connection. This can be software defined and is used to reference specific files/products in memory without the need to reference all memory parameters and configurations. This is normally reference in RDMA URI's in other UCI messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
