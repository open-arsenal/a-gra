			<xs:extension base="uci:SupportCapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CarriageStatus" type="uci:StoreCarriageStatusType">
						<xs:annotation>
							<xs:documentation>Indicates the possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreCarriageCapabilityStatusMDT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>This reports the Carriage Capability status.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityStatus" type="uci:StoreCarriageCapabilityStatusType" maxOccurs="unbounded">
