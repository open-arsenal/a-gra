			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AzimuthAzimuthRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Covariance of azimuth angle and azimuth angle rate measurement with units of radians * radians per sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationElevationRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Covariance of elevation angle and elevation angle rate measurement with units of radians * radians per sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthElevationRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Covariance of the Azimuth and ElevationRate measurements with units of radian squared per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationAzimuthRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Covariance of the Elevation and AzimuthRate measurements with units of radian squared per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthRateElevationRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Covariance of azimuth angle rate and elevation angle rate measurement with units of radians squared per sec squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LOS_CovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AzimuthElevation" type="xs:double" minOccurs="0">
