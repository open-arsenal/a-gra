	<xs:complexType name="PRI_DataBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PRI_Type" type="uci:PRI_TypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the PRI type of the signal.  See enumerated type annotations for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Average" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the average pulse repetition interval (PRI) of the Signal. Not applicable when PRI_Type is CW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Min" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the lowest value of the measured pulse repetition interval for the associated emitter beam.  Not applicable when PRI_Type is CW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Max" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the highest value of the measured pulse repetition interval for the associated emitter beam. Not applicable when PRI_Type is CW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Last" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the last measured pulse repetition interval for this emitter. Not applicable when PRI_Type is CW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_Third" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Arbitrary third measured pulse repetition interval for the associated emitter beam.  PRI is computed from exactly four pulses.  This is the PRI that was not the smallest or the largest.  Not applicable when PRI_Type is CW.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PRI_DataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PRI_DataBaseType">
				<xs:sequence>
					<xs:element name="PRI_SwitchingPattern" type="uci:PRI_SwitchingPatternEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element amplifies the PRI_Type.  See enumerated type annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_AgilePattern" type="uci:PRI_AgilePatternEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element amplifies the PRI_Type.  See enumerated type annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_Measurement" type="uci:PRI_MeasurementEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the source and quality of the PRI data elements.  See enumerated type annotations for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_JitterDeviation" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the total measured variation of PRI values (full span).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_PulseGroupsPresent" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the PRI pattern contains special pulse groups indicating missile guidance.  Omitted when unknown.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_Quantized" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the sibling PRI values were quantized by a secondary clock.  If omitted, quantization is unknown.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_QuantizationPeriod" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>EW Subgroup: Need to work on this annotation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_Squirrelly" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the measured PRI is strange in that the ratio of PRI_Max to PRI_Min is unexpectedly large (TRUE) or not (FALSE).  Omitted when "squirreliness" isn't measured.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_MissingPulse" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a pulse appeared to be missing when the data was measured and therefore one of the reported PRIs was artificially created by dividing an observed PRI in half.  A missing pulse can result in the sibling PRI_Measurement element indicating ESTIMATED.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_PatternPeriod" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the measured PRI pattern period; the time duration from the beginning of a pattern to the end of the pattern.  This element is expected only for sibling PRI_DataTypes that are patterned including STAGGER and AGILE.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_PatternLevels" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the total number of measured PRI levels within the PRI pattern.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_PatternInterval" type="uci:DurationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a measured PRI pattern interval.  The intervals are generally reported in the order they are measured, in order to preserve the pattern sequence.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PRI_JitterDetected" type="uci:EmptyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether jitter is present on the reported signal.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
