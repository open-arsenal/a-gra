	<xs:complexType name="RequirementOptionsInputsType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OptionsCandidate" type="uci:RequirementPlanningCandidateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates specific Systems to develop Requirement allocation options for along with System-specific planning constraints.  A System is a Requirement options "candidate" because it may or may not be suitable for allocation of a Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningDataSource" type="uci:PlanningDataSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the category of messages to use as the source for System position, Capability, status, etc. data to use as the basis for the plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionsWindow" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the overall time window within which Requirement allocation options should be assessed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EnvironmentOverride" type="uci:MissionEnvironmentConstraintType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a selective override of an item in the mission environment world state to use when developing the Requirement options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpConstraint" type="uci:OpConstraintWeightingType" minOccurs="0" maxOccurs="15">
				<xs:annotation>
					<xs:documentation>Indicates an operational constraint on Requirement options development. The multiplicity is based on the list of available OpConstraintEnums.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposedRequirementPlans" type="uci:RequirementPlanConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an existing [Requirement]Plan of the System superior to the sibling PlanningCandidates that provides a proposed "requirement deck" to develop Requirement allocation options for.  This element can be supplemented with additional Requirements from the sibling ProposedRequirements element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposedRequirements" type="uci:RequirementAllocationCommandType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a proposed Requirement to develop allocation options for.  A Requirement given here is added to any Requirements provided in the sibling ProposedRequirementPlans and constraining *Plans of the sibling PlanningCandidates to create the full set of Requirements to be considered.  A Requirement given here overrides the same Requirement in the sibling ProposedRequirementPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociationConstraint" type="uci:RequirementAssociationConstraintType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an association between Requirements that is a constraint on allocation options.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementOptionsMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OptionsID" type="uci:RequirementOptionsID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the RequirementOptions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inputs" type="uci:RequirementOptionsInputsType">
				<xs:annotation>
					<xs:documentation>Contains candidate system for task allocation, as well as the proposed allocated tasks and constraint information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemOption" type="uci:RequirementOptionsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Contains a paring of temporal windows for which specific tasks can be completed by an associated applicable system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionlessRequirement" type="uci:RequirementInstanceID_ChoiceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Requirement with no allocation options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DuplicatedRequirement" type="uci:DuplicateRequirementType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies a Requirement from the RequirementOptionsCommand that is equivalent to an existing Requirement or Requirements that the subject System is planning to perform.  In other words, if the new Requirement given by this element is allocated to the System, then it will duplicate an existing Requirement or Requirements.  The Requirement indicated by this element can still be detailed in the sibling SystemOption element despite the potential duplication.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementOptionsMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:RequirementOptionsMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RequirementOptionsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Applicability" type="uci:PlanApplicabilityType">
				<xs:annotation>
					<xs:documentation>Indicates a system for which the corresponding sibling TaskOption element or elements are applicable to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementOption" type="uci:RequirementOptionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a collection of temporal windows when a Requirement could be executed by the System given by the sibling Applicability element.  Any/each single window is sufficient to satisfy the Requirement if subsequently allocated, planned, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementOptionType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Requirement which the allocation option applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the Subsystem which the allocation option applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Capability which the allocation option applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:RequirementAllocationWindowType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a temporal window when the Requirement could be executed by the System if subsequently allocated, planned, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementPlanConstraintType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProposedEffectPlan" type="uci:EffectPlanConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a proposed EffectPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposedActionPlan" type="uci:ActionPlanConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a proposed ActionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposedTaskPlan" type="uci:TaskPlanConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a proposed TaskPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposedResponsePlan" type="uci:ResponsePlanConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a proposed ResponsePlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementPlanningCandidateType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlanningCandidateBaseType">
				<xs:sequence>
					<xs:element name="RouteGuideline" type="uci:PlanningGuidelineType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies high-level route guidelines that were or should be used for the plan that are not specified or implied by Requirements.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitGuideline" type="uci:OrbitGuidelineType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies high-level orbit guidelines that were or should be used for the plan that are not specified or implied Requirements.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RequirementPlanningResultBaseType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningResult" type="uci:PlanningResultEnum">
				<xs:annotation>
					<xs:documentation>Indicates the outcome of attempting to allocate or plan activities for the Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the SystemID of the System whose *Plan are associated with the sibling PlanningResult element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedPlans" type="uci:PlanReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates *Plan associated with the sibling PlanningResult element.  If the sibling PlanningResult indicates  the Requirement was/remained allocated then this element indicates the specific *Plan it is/remains allocated in.  If the PlanningResult indicates the Requirement was DEALLOCATED then this element indicates the constraining *Plan it was DEALLOCATED from.  This element isn't expected when the PlanningResult indicates UNALLOCATED.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NotAllocatedReason" type="uci:UnallocatedReasonType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reason why the Requirement wasn't allocated or reallocated.  If the sibling PlanningResult element indicates the Requirement was left not allocated then this element indicates why.  Multiple instances of this element can provide the reason for each System that was attempted and even many reasons for each.

If the PlanningResult indicates the Requirement was allocated then this element can still be used to indicate reasons for failed attempts to allocate to other Systems or plan, prior to the successful allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RequirementPlanningResultType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequirementPlanningResultBaseType">
				<xs:sequence>
					<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
						<xs:annotation>
							<xs:documentation>Unique object identifier for the Requirement whose planning results are given by sibling elements.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RequirementPlanningStatusDetailsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningState" type="uci:RequirementPlanningStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the furthest planning state of the Requirement for any planning attempt/cycle.  See enumerate annotations for additional details.  A Requirement can be included/planned in multiple "what-if" *Plans only one of which will eventually be activated.  This element indicates the furthest the Requirement has progressed in planning across all *Plans summarized by the parent message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LastPlanningState" type="uci:RequirementPlanningStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the planning state of the Requirement for the most recent planning attempt/cycle.  See enumerate annotations for additional details.  A Requirement can be included/planned in multiple "what-if" *Plans only one of which will eventually be activated.  Therefore, the state might be different relative to a different *Plan as indicated by sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableMissionID" type="uci:MissionID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the set of Missions/MissionIDs the Requirement planning status applies to.  When statusing planning for a single Mission, the MissionID in the header should be used in lieu of this element.  This element and the MissionID in the message header should be omitted when reporting planning status for all Missions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningResult" type="uci:RequirementPlanningResultBaseType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
