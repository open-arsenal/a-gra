				</xs:annotation>
			</xs:element>
			<xs:element name="Mass" type="uci:MassType">
				<xs:annotation>
					<xs:documentation>The mass of the object, in kilograms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentileCloudBoundary" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired percentage of debris objects that are contained inside the debris cloud boundary.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
