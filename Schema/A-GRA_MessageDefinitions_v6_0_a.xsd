					<xs:element name="RoutePlanningContingencyPath" type="uci:ContingencyPathAutonomyType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates commanded route planning settings for the autonomous generation of contingency paths along the primary path.  If multiple instances are given, each must be of a different path type as indicated by the child element.</xs:documentation>
						</xs:annotation>
