			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommAssetOrbitID" type="uci:CommAssetOrbitID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of this particular orbiting communication asset.</xs:documentation>
				</xs:annotation>
