	<xs:complexType name="MetricValueType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Value of the performance metric for this ID. ID and valid value ranges can be found in the service contract.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MetricIdentifier" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>ID of the performance metric. Valid IDs can be found in the service contract.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescriptionOfMetric" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the name of the performance metric for this ID (e.g: Probability of Intercept, Probability of Detect, or Angle Accuracy). This element provides supplementary information to the MetricIdentifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NegotiableOptions" type="uci:NegotiableOptionsEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the extent for the specified Performance Metric is either Upper Range (upper negotiated range), Lower Range (lower negotiated range), Nominal (nominal desired value), or Discrete (get as close as possible).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weight" type="uci:UnitIntervalFloatType">
				<xs:annotation>
					<xs:documentation>Value should be between zero and one. Indicates the weight multiplier for this performance metric. Higher weight indicates more important. The sum of all weighs within a performance metric set should not exceed 1.0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Value" type="xs:float">
				<xs:annotation>
					<xs:documentation>Value of the performance metric for this ID. Valid value ranges can be found in the service contract.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
