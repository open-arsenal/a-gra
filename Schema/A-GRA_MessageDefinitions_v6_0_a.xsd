					<xs:documentation>This reports the Carriage Capability status for each capability instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreCarriageCapabilityStatusMT" uci:version="003.002.003.000">
