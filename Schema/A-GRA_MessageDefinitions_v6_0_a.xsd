		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ElevationRequestStatusMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>This data contains the response to a ElevationRequest with list of points in same order with elevation field filled in when possible.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="ElevationReturned" type="uci:ElevationRequestPointsType">
						<xs:annotation>
							<xs:documentation>Data to contain the RequestID and a list of points for elevation in ElevationRequest message or for visibility information in the ElevationVisibilityRequest message. This data is reused for the return message ElevationRequestStatus and should have the optional Altitude element filled unless there is no elevation data available in which case the field would remain empty.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ElevationRequestStatusMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>This message contains the response to a ElevationRequest with list of points in same order with elevation field filled in when possible.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ElevationRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>Contains data for the ElevationRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityPointInfoFromSetType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>Contains a list indicating the visibility of look points with respect to a from point.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FromPointIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the index of a FromPoint location in the request point set. This data is from the list in ElevationVisibilityRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestPointResults" type="uci:ElevationVisibilityPointInfoType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a partial or complete visibility of the request point with respect to the from point.  This information is from the ElevationRequestPointsType within the ElevationVisibilityRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisibleArea" type="uci:PolygonType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the area around the FromPoint, at the altitude of the FromPoint, for which the RequestPoint(s) is visible.  FromPoint and RequestPoint(s) are defined in the ElevationVisibilityRequest message.  This element is not required for services which only perform point to point visibility calculations; the program related documentation will specify if this is supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityPointInfoSetType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>Contains a list of visibility for one from point to multiple requested points.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VisibilityRequestIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the index of the VisibilityRequest. This data is from the list in ElevationVisibilityRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FromPointResults" type="uci:ElevationVisibilityPointInfoFromSetType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Contains a partial or complete list of all from points to all request points.  This information is from the ElevationRequestPointsType within the ElevationVisibilityRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityPointInfoType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>Contains the visibility of one requested point with respect to a location.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestPointIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the index of the RequestPoint in the message requesting the point's visibility with respect to a FromPoint location. This data is from the list in ElevationVisibilityRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisibilityState" type="uci:ElevationVisibilityEnum">
				<xs:annotation>
					<xs:documentation>In the same order as the requested point list where VISIBLE indicates the point can be seen from the FromPoint, NOT_VISIBLE indicates the point is not visible, and UNKNOWN indicates there was no data or insufficient data to determine visibility.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObstructionPoint" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the point is not visible (VisibilityState=FALSE), this is the location at which the visibility ends due to this location obstructing the view.  In the case of VisibilityState=UNKNOWN, this indicates the location of last valid visible location.  This element is not required; the program related documentation will specify if this option is supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityRequestMDT" uci:version="001.001.002.001">
		<xs:annotation>
			<xs:documentation>This data contains the request for visibility from a given point (FromPoint) to a list of points (VisibilityPoint); i.e. which points in the list are visible to the FromPoint.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="VisibilityRequest" type="uci:ElevationVisibilityRequestPointsType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Is a list of requests where each request consists of a list of fromPoints for which a list of Request points is assessed to check for visibility from each FromPoint.  The Altitude element could be filled in to check visibility at that height above ground level.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityRequestMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>This message is to request the visibility from a given point (FromPoint) to a list of points (VisibilityPoint); i.e. which points in the list are visible to the FromPoint.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ElevationVisibilityRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityRequestPointsType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Data to contain a list of points for visibility information in the ElevationVisibilityRequest message.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FromPoint" type="uci:Point3D_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The view points to use as reference for the visibility request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestPoint" type="uci:Point2D_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>List of points for which visibility data is needed. The Altitude element could be filled in to check visibility at that height above ground level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityRequestStatusMDT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>This data contains the response to a ElevationVisibilityRequest.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="VisibilityRequestResults" type="uci:ElevationVisibilityPointInfoSetType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Contains a partial or complete list of the visibility of the requested points. The order of the list may not be in the order of the ElevationVisibilityRequest.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ElevationVisibilityRequestStatusMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>This data is used in the response to a ElevationVisibilityRequest message.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ElevationVisibilityRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>Contains data for the ElevationVisibilityRequestStatus.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EllipseType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SemiMajorAxisLength" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>This element represents the length of the semi-major axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SemiMinorAxisLength" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>This element represents the length of the semi-minor axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>This element represents the orientation as the angle between the semi-major axis and true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EllipsoidType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type describes the geometric parameters of an ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SemiMajorAxisLength_A" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>One of the principal semi-axis. This element represents the length of the semi-major axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SemiMinorAxisLength_B" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>2nd principal semi-axis. This element represents the length of the semi-minor axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SemiMinorAxisLength_C" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>3rd principal semi-axis. This element represents the length of the semi-minor axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Attitude" type="uci:QuaternionType">
				<xs:annotation>
					<xs:documentation>Indicates the quaternion attitude in the reference system of the sibling kinematics element which defines the location of its center.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmconConstraintType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DefaultEmconOverride" type="uci:EmconOverrideType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Overrides the default emission control level in Capability settings to be applied to this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ERP_Selection" type="uci:EmconERP_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field, if populated, is used to specify effective radiated power (ERP) limitations applicable to this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmconERP_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="MaximumRadiatedERP" type="uci:MilliwattPowerRatioType">
				<xs:annotation>
					<xs:documentation>This value determines the maximum absolute radiated effective radiated power (ERP) at the face of the array to be used for this command. This field can be used to limit output during testing to comply with RF Licensing requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadiateFullPower" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Specifies that the command should radiate at full power. Use of this flag may cause degraded performance due to saturation of the receiver.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmconOverrideType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EmconLevel" type="uci:EmconLevelEnum">
				<xs:annotation>
					<xs:documentation>Specifies the emission control level to be used for this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForeignLevel" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>If a service does not use a normative EmconLevel, foreign keys may be used to specify the level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmconSettingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EmconLevel" type="uci:EmconLevelEnum">
				<xs:annotation>
					<xs:documentation>Specifies the emission control level to be used for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForeignLevel" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>If a service does not use a normative EmconLevel, foreign keys may be used to specify the level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmergencyReferenceOpPointCategoriesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Container object for the different types of OpPoint*Enums, excluding Emergency.  A separate enum applies to each of the choice types.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="General" type="uci:OpPointGeneralEnum">
				<xs:annotation>
					<xs:documentation>A set of commonly used point types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Hazard" type="uci:OpPointHazardEnum">
				<xs:annotation>
					<xs:documentation>A set of navigation or weapon hazard point types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reference" type="uci:OpPointReferenceEnum">
				<xs:annotation>
					<xs:documentation>A set of navigation destination point types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Station" type="uci:OpPointStationEnum">
				<xs:annotation>
					<xs:documentation>A set of navigation station point types.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmergencyReferenceOpPointType" uci:version="002.000.003.001">
		<xs:annotation>
			<xs:documentation>Extends the OpPointBaseType and includes a Category that may not be an Emergency.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OpPointBaseType">
				<xs:sequence>
					<xs:element name="EmergencyReferenceCategory" type="uci:EmergencyReferenceOpPointCategoriesType">
						<xs:annotation>
							<xs:documentation>This element indicates the type of operational point.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EmergencyReferencePointType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Reference" type="uci:OpPointReferenceType">
				<xs:annotation>
					<xs:documentation>A reference to the original object that caused this OpPoint to be created. Used to refer back to the original vehicle involved in an emergency. This is used keep the values of the last known location of the object available for the complete life cycle of the OpPoint instead of the life cycle of the original object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PersonnelCount" type="uci:StrengthRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range of personnel involved as represented by MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LastKnownPosition" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present, position accuracy equals last known position.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterEntryType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Specify an emitter by ID or by MDF_Entry number.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Emitter" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>One or more emitters, defined by emitter IDs, may be the subject of the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MDF_Entry" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>One or more emitters, defined by an MDF_Entry key, may be the subject of the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmitterFixedPositionType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates an emitter fixed position.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FixedPoint" type="uci:Point2D_ReportedType">
				<xs:annotation>
					<xs:documentation>For moving entities, it is highly recommended that the time data be populated.  Generally, services are encouraged to include altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uncertainty" type="uci:EmitterUncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides an estimate of position uncertainty.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterFunctionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterFunction" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "emitter function" of the Emitter. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 1843/001 for additional details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CustomEmitterFunction" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a custom emitter function that is supplemental to the sibling EmitterFunction element. This element is expected only if a custom emitter function, which isn't included or fully described by MIL-STD-6016 DFI/DUI 1843/001, can be identified. In that case, the sibling EmitterFunction indicates "no statement" or the closest match and this element completes the emitter function characterization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CustomEmitterFunctionDescription" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a human-readable description of the sibling CustomEmitterFunction.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterIdentityCategoryType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the emitter identification based on its category.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Radar" type="uci:RadarEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as a Radar subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Communications" type="uci:CommunicationsEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as a communications subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Jammer" type="uci:JammerEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as an Electronic Attack subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Missile" type="uci:MissileEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as a Missile subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmitterIdentityConfidenceType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterCategory" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the emitter identification based on its category choice of radar or communications subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the confidence of the declaration of the Entity's ELNOT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MatchingParameterCount" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Number of emitter parameters detected, measured, and successfully compared with intelligence files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorEvaluated" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the signal parameters have been evaluated by an operator.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterIdentityType" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterCategory" type="uci:EmitterIdentityCategoryType">
				<xs:annotation>
					<xs:documentation>Indicates the emitter identification based on its category.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NATO_SpotNumber" type="uci:OctalValueType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The octal digits representing the NATO spot number.  The NATO spot number is used in specific emitter identification.  It is used in Link 16 and other standards which may have differing range limits between versions.  The user is responsible for adhering to the allowed range on their implementation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterMultipleType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterType" type="uci:EmitterIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible emitter type that has been identified/observed for the parent Emitter.   The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterSourceID_ChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Entity ID or Local Track ID of the emitter used to detect targets passively.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Entity ID of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OMR_IndividualMeasurementID" type="uci:MeasurementID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Measurement ID within the OMR of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB_EmitterID" type="uci:EOB_EmitterID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the corresponding EOB emitter instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the corresponding Signal for the emitter instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmitterTargetLocationDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Source emitter location. Used if Waveform does not contain location.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EmitterSourceID" type="uci:EmitterSourceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the Source ID of the emitter used to detect targets passively. Location can be referenced through these.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FOV" type="uci:FOV_VolumeType">
				<xs:annotation>
					<xs:documentation>Indicates the Field of View details associated with the source emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointTarget" type="uci:PointTargetType">
				<xs:annotation>
					<xs:documentation>Indicates the Point Target details associated with the source emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmitterUncertaintyChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>An ellipse or rectangle shape describing 1-sigma position uncertainty.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="UncertaintyEllipse" type="uci:EllipseType">
				<xs:annotation>
					<xs:documentation>This element represents an ellipse describing the 1-sigma position uncertainty.  The ellipse is defined by the length of its semi-major and semi-minor axes.  The orientation of the ellipse defines the angle between the semi-major axis and true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyRectangle" type="uci:RectangleType">
				<xs:annotation>
					<xs:documentation>This element represents a rectangle describing the 1-sigma position uncertainty.  The rectangle is defined by the height parallel to the orientation axis and width of the rectangle perpendicular to the orientation angle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EmitterUncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Geometry describing 1-sigma position uncertainty in two or three dimensions.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Uncertainty" type="uci:EmitterUncertaintyChoiceType">
				<xs:annotation>
					<xs:documentation>This element represents an ellipse describing the 1-sigma position uncertainty.  The uncertainty can be defined as either an ellipse or rectangle centered on a point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyVertical" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents 1-sigma position uncertainty perpendicular to the sibling UncertaintyEllipse surface (in the up-down direction).  Combined with the sibling UncertaintyEllipse this results in an uncertainty ellipsoid with "height".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyTilt" type="uci:AngleHalfType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measured as the angle between the projection of the slant range position uncertainty axis onto the level plane and the slant range position uncertainty axis. Positive angle is measured counter-clockwise from local level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EmitterWaveformDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the source of or explicit values for emitter characteristics of the emitter used as a source for passive detection.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>EntityID of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterType" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>EmitterType of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>SpecificEmitter of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalDescription" type="uci:SignalParametricsType">
				<xs:annotation>
					<xs:documentation>SignalDescription of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>SignalID of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB_EmitterModeID" type="uci:EOB_EmitterModeID_Type">
				<xs:annotation>
					<xs:documentation>EOB_EmitterModeID of the emitter used to detect targets passively.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EndpointReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Address" type="uci:AttributedURI_Type">
				<xs:annotation>
					<xs:documentation>Specifies the Uniform Resource Identifier (URI) of the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EndPointType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="WayPoint" type="uci:WayPointType">
				<xs:annotation>
					<xs:documentation>This element is used to specify a point in the route where no turning occurs.  It is generally used for points associated with Actions such as task "transitions", changes in acceleration, changes in speed, changes in altitude, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnPoint" type="uci:TurnPointType">
				<xs:annotation>
					<xs:documentation>This element is used to specify all cases of turns in a segment including fly-through and turn-short.  It can additionally be associated with tasks/actions that require or are coincident with turns.  TurnPoints will generally come in groups of at least two in linked PathSegments.  All but the last in a group will include a TurnRadius.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoiterPoint" type="uci:LoiterPointType">
				<xs:annotation>
					<xs:documentation>This element specifies a Loiter.  Currently specifying a task/action associated with a LoiterPoint when the task/action occurs only during a portion of the Loiter is not supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EnduranceBaseType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates endurance in terms of maximum distance that can be reached given the current system state.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Fuel" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measure of current or planned fuel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated time of operation with current or planned fuel/charge/power.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DurationEnd" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated time at which operation with current or planned fuel/charge/power will end.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Percent" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percent of fuel/charge/power remaining or planned, expressed as a percentage of total capacity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnduranceFootprintType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Boundary" type="uci:BoundaryType">
				<xs:annotation>
					<xs:documentation>Indicates the boundary of the endurance footprint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Height Above Ellipsoid (HAE) reference for the footprint.  This element is required when the footprint is based on a smooth earth model and the sibling Boundary element doesn't specify Altitude.  It should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates estimated remaining time of operation with current fuel/charge/power plus the estimated time remaining until the endurance footprint shrinks to its smallest size.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnduranceMultiStandardType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates endurance in terms of the domain specific choice.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EnduranceFootprint" type="uci:EnduranceType">
				<xs:annotation>
					<xs:documentation>Indicates endurance in terms of maximum ground/surface distance that can be reached given the current system state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SatelliteEndurance" type="uci:SatelliteEnduranceType">
				<xs:annotation>
					<xs:documentation>Logical comparator to use when comparing the current endurance remaining to the sibling EnduranceRemaining element.  The logical expression is (current endurance remaining) (LogicalOperator) (sibling EnduranceRemaining).  When the logical expression is TRUE then the parent Endurance Condition is TRUE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EnduranceRemainingType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnduranceRemaining" type="uci:EnduranceType">
				<xs:annotation>
					<xs:documentation>Endurance remaining to be used to compare to the current endurance remaining.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LogicalOperator" type="uci:EqualityExpressionEnum">
				<xs:annotation>
					<xs:documentation>Logical comparator to use when comparing the current endurance remaining to the sibling EnduranceRemaining element.  The logical expression is (current endurance remaining) (LogicalOperator) (sibling EnduranceRemaining).  When the logical expression is TRUE then the parent Endurance Condition is TRUE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnduranceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates endurance in terms of maximum ground/surface distance that can be reached given the current system state.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:EnduranceBaseType">
				<xs:sequence>
					<xs:element name="Footprint" type="uci:EnduranceFootprintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates endurance in terms of maximum ground/surface distance that can be reached given the current System state.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityAssignmentMemberType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>This is the collection of members that belong to the assignment group.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>This is the unique identifier for a specific entity member. The format of this field is a UUID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackIndex" type="uci:Link16_TrackIndexType">
				<xs:annotation>
					<xs:documentation>This is the track index for a specific entity member in accordance to Link-16 DFI/DUI 768/002.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityAssignmentType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>The assignment group is a collection of one or more entities assigned to their respective index number.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Link16NPG" type="uci:Link16_NPG_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Link-16 Network Participation Group (NPG) for which these entity assignments should be produced on.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityIDMapping" type="uci:EntityAssignmentMemberType" minOccurs="0" maxOccurs="64">
				<xs:annotation>
					<xs:documentation>This is the collection of members that belong to the assignment group. Size is based on allowed number of unique zero based index values for TrackIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityCapabilitySourceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Capability instance which detected/created this Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Activity that detected the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackNumberIdentifier" type="uci:EntityExternalType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Capability's internal "track" corresponding to this Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelationID" type="uci:EntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an Entity, that was an input to the Capability/Subsystem Service, which the Capability/Subsystem has found to correlate closely to this Entity.  Declaration of correlation is not an indication of fusion; kinematic, identity and other data in this Capability Entity shall not be fused/blended with data from the correlated input Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityCharacteristicType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Identity" type="uci:IdentityComparisonType">
				<xs:annotation>
					<xs:documentation>Indicates the identity to be compared to the identity in the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IdentityStaleness" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Indicates the identity staleness to be compared to the identity staleness in the Entity message.  This choice requires a corresponding Identity TargetClause.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionUncertainty" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates the position uncertainty to be compared to the position uncertainty in the Entity message.  This element represents the positional accuracy of the target.  It is the area, in square data miles, within which it is assessed that there is a 95% probability that the target lies.  The value given in this element can be compared to either the Quality element of the target or a calculated uncertainty area for the target based on its uncertainty ellipse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionStaleness" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Indicates the position staleness to be compared to the kinematic staleness in the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrioritizationList" type="uci:PrioritizationListValueType">
				<xs:annotation>
					<xs:documentation>Indicates a value priority/rank  to be compared to the priority/rank in PrioritizationList referencing the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Behavior" type="uci:BehaviorType">
				<xs:annotation>
					<xs:documentation>Indicates behaviors, activities, use of capabilities, etc. to be compared to those of the battlespace object associated with the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EntityComparativeType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Characteristic" type="uci:EntityCharacteristicType">
				<xs:annotation>
					<xs:documentation>Indicates a characteristic/element value to be used to compare to the corresponding value of the Entity or related message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Comparator" type="uci:EqualityExpressionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the logical comparator to use when comparing the target (Entity or related message) Characteristic to the Response Characteristic.  The logical expression is: (target Characteristic) (Comparator) (Response Characteristic).  When the logical expression is TRUE then the parent TargetClause instance is TRUE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationMDT" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Contains the ID of the Entity that is associated with this confirmation. The Entity is the object of the confirmation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityConfirmationRequestID" type="uci:RequestID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID assigned to the EntityConfirmationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfirmationProbability" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the likelihood that the Tasking/Executing System is looking at the correct Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfirmationLevel" type="uci:ConfidenceLevelEnum">
				<xs:annotation>
					<xs:documentation>Provides confidence category that the Tasking/Executing System is looking at the correct Entity.  This could be used in conjunction with sibling ConfirmationProbability when the Tasking System utilizes an algorithm that ingests the Entity characteristic information and produces a confirmation probability as a percent.  However, if the Tasking System is certain the Entity is correct (i.e., there is nothing else in the vicinity) the Tasking System needs the ability to provide a confirmation separate from a percent value. See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:EntityConfirmationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationRequestMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>Identifier that refers to any level of control station or a vehicle.  This is the system ID of the observing system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
						<xs:annotation>
							<xs:documentation>Contains the ID of the Requirement the Executing/Tactical System is currently performing that resulted in the need for an Entity Confirmation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityID" type="uci:EntityID_Type">
						<xs:annotation>
							<xs:documentation>Contains the ID of the Entity that is associated with this confirmation. The Entity is the object of the confirmation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TimeStamp" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>Time of Entity observation.  Date/Time stamps provided within kinematic representations in sibling data take precedence over this element when they are given.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityDimension_EstimateUncertainty" type="uci:EntityDimensionEstimateUncertaintyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Contains the uncertainty for each EntityDimension_Estimate.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityDimension_Estimate" type="uci:EntityDimensionEstimateType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Contains estimates of the physical size of an Entity as derived by the observing system. The dimensions of the vehicle, as well as the length of the Entity's solar array may be specified.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AttitudeEstimates" type="uci:QuaternionAttitudeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Specifies the estimate of the Entity's Attitude as derived by the observing system. The estimate is relative to the Local Vertical Local Horizontal (LVLH) reference system of the Entity Kinematics provided with the Tasking Input.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FileMetadataID" type="uci:FileMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides references to files related to the Entity that supports this confirmation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides references to products related to the Entity that supports this confirmation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MeasurementKinematics" type="uci:MeasurementKinematicsChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the measurement data collected by the Tactical/Executing system with a choice of how its represented.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReferenceKinematics" type="uci:SensorKinematicsChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the kinematics to be used as a reference location for the sibling values. This information is provided by the Task message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemEphemerisID" type="uci:SystemOrbitalEphemerisID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a reference to the SystemOrbitalEphemeris message related to this confirmation request. This information is provided by the SystemOrbitalEphemeris message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityEphemerisID" type="uci:EntityOrbitalEphemerisID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides a reference to the EntityOrbitalEphemeris message related to this confirmation request. This information is provided by the EntityOrbitalEphemeris message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:EntityConfirmationRequestMDT">
						<xs:annotation>
							<xs:documentation>Contains the message data for an EntityConfirmationRequest message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationRequestStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityConfirmationRequestStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:EntityConfirmationRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>Contains the message data for an EntityConfirmationRequestStatus message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityContributorID_ChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the contributors to the fused entity.  This type allows specifying non-Entity contributors if a fusion service supports this functionality.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input Entity that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB_EmitterID" type="uci:EOB_EmitterID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input EOB emitter that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input System that is a contributor to this fusion output Entity.  The use case would be when PPLI data is received as a J2.0, the translation of that to UCI results in a set of messages that can be referenced by a SystemID_Type.  This System can be a contributor to a Fused Entity.  The entity originator could be System (especially since PPLI is usually self-reported), in which case the Fusion.SystemID would be the same as this element, or they could be different if another platform was reporting on the System's behalf.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input Signal that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SOB_C2_RecordID" type="uci:SOB_C2_RecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input SOB C2 record that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SOB_SatelliteRecordID" type="uci:SOB_SatelliteRecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input SOB Satellite record that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MeasurementID" type="uci:MeasurementID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input Measurement that is a contributor to this fusion output Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EntityDataType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Provides the capability to pass an Entity and any associated metadata message in the same structure. This is typically used when there is a need to pass the entirety of the information about an Entity at a given time as a part of another message. For example, an OpPoint representing an emergency may include the associated Entity and EntityMetadata from the time the emergency was declared.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Entity" type="uci:EntityMDT">
				<xs:annotation>
					<xs:documentation>Referenced Entity message data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metadata" type="uci:EntityMetadataMDT" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Metadata associated with the referenced Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityDimensionEstimateType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Contains estimates of the physical size of an Entity as derived by the observing system. The dimensions of the vehicle, as well as the length of the Entity's solar array may be specified.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityDimension_SA_Spread" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the length of the Entity's Solar Array (SA) measured tip to tip by the observing system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityDimension" type="uci:SizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The overall physical size of the vehicle expressed in terms of Height, Width, and Length. Height corresponds to extent of the object along the Yaw axis in a Body (Roll-Pitch-Yaw) frame, the Radial axis in an RTN (Radial-Transverse-Normal) frame, or Up-Down axis in a local NED (North-East-Down) frame. Width corresponds to extent of the object along the Pitch axis in a Body frame, the Normal axis in an RTN frame, or East-West axis in a local NED frame. Depth corresponds to extent of the object along the Roll axis in a Body frame, the Transverse axis in an RTN frame, or North-South axis in a local NED frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityDimensionEstimateUncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides the level of uncertainty in the Entity dimension estimate as derived by the observing system.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityDimension_SA_SpreadUncertainty" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the uncertainty of the length of the Entity's Solar Array (SA) measured tip to tip by the observing system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityDimensionUncertainty" type="uci:SizeUncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the uncertainty of the overall physical size of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityEphemerisBasisChoiceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>A choice type that determines whether the ElementSet, EntityElementSetID, or KinematicVector will be used to determine the ephemeris for the Entity or Entities.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ElementSet" type="uci:TLE_BaseType">
				<xs:annotation>
					<xs:documentation>Indicates the default or "catalog" orbital element set (also known as two line element or TLE) for the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityElementSetID" type="uci:EntityOrbitalElementSetID_Type">
				<xs:annotation>
					<xs:documentation>The ID type for UCI IDs that correspond to an orbital element set (TLE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KinematicVector" type="uci:OrbitalKinematicsStandardFrameChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in terms of a standard frame centered on a celestial object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityVCM_ID" type="uci:EntityOrbitalVCM_ID_Type">
				<xs:annotation>
					<xs:documentation>Propagate using a complete VCM (vector covariance message) which includes a kinematic vector, along with other special perturbation parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EntityEphemerisRequestParametersType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>The parameters for requesting orbital ephemeris for one or more Entities.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OrbitalEphemerisRequestParametersType">
				<xs:sequence>
					<xs:element name="EphemerisBasis" type="uci:EntityEphemerisBasisChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>A choice type that determines what will be used to determine the ephemeris data for this Entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityExternalType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ForeignSpecificTrackType" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Foreign key is an identifier that references a type convention from another system. i.e., a non-UCI unique identifier representing a track type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForeignTrackNumber" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Foreign key is an identifier that references an ID from another system. i.e., a non-UCI unique identifier representing a track number.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityFilterType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Designation" type="uci:DesignationFilterType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a type of Entity designation, established by the Designation message, required to satisfy the filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Characteristics" type="uci:EntityComparativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element indicates an Entity filter requiring a variable logical comparator test between a value in an Entity-associated message and the value given here.  Multiple instances are logically ANDed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific EntityID that is required to match the filter.  If omitted, any EntityID satisfies the filter.  Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:EntitySourceEnum" minOccurs="0" maxOccurs="28">
				<xs:annotation>
					<xs:documentation>Indicates an Entity source that is required to match the filter.  If omitted, any Entity source satisfies the filter.  Multiple instances are logically ORed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeoFilter" type="uci:GeoFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the Entity must fall within to satisfy the filter.  Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalFilter" type="uci:OrbitalFiltersQueryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a zone the Entity must fall within to satisfy the filter.    Multiple instances are logically ORed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityFusionSourceType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>Contains the fusion source information for an entity.  Indicates the Entity is an output of a fusion service and provides references to a fusion input that fused/contributed to it.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Contributor" type="uci:EntityContributorID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a fusion input that is a contributor to this fusion output Entity.   The ID could be of a non-Entity object if a fusion service supports this functionality.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FusionContributor" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether the Entity referred to by the sibling ContributorID element is contributing to this Entity as a result of a fusion algorithm calculation (TRUE) or as a result of an explicit command to the fusion algorithm to merge them (FALSE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfCorrectAssociation" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the probability of the correct association of this contributor entity to the higher level correlated entity (in this post-fusion correlated entity).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContributorCapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability that generated the Entity that is a contributor to this fused Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:IdentityConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Identity contribution from this contributor Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceType" type="uci:EntitySourceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type, from an Entity reporting perspective, of System and/or Service which created the contributing Entity.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the system which created the contributing  Entity.   This is not the same as a system ID reported in sibling EntityContributorID.  For example, if the contributor is a Signal, and that Signal was received from an offboard System, then their SystemID would go here in this element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the latest time and date of the Source that contributed to the ancestry of the Entity.  This timestamp could be from the Kinematics, Position, Identity, or other elements in the original Source message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to entities.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityIdentityChoiceType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Standard" type="uci:StandardIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the "environment identity" of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Platform" type="uci:PlatformIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the "platform identity" of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Specific" type="uci:SpecificIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the "specific identity" of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the emitter type of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the specific emitter type instance of the target.  Specific Emitter Identification (SEI) technology passively measures emitters, and characterizes unique emitter signatures that can be used for friendly or enemy emitter identification and fingerprinting.  A SEI and this SpecificEmitter element refer to a specific physical instance of a type of emitter as given in the sibling Emitter element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificVehicle" type="uci:VehicleIdentificationType">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, vehicle instance of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificFacility" type="uci:FacilityIdentificationType">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, vehicle instance of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB" type="uci:EOB_IdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the EOB identity of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>Indicates a type of weapon available. This element represents the MIL-STD-6016 specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EntityIdentityType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:IdentityConfidenceType">
				<xs:sequence>
					<xs:element name="SelfReportedIdentity" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that this identity data was reported by the asset and not gathered by sensors.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DifferenceIndicator" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the reported identity is currently being resolved with conflicting ID data.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IdentityTimestamp" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>Indicates the time at which the Identity was most recently updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="QualifyingTags" type="uci:QualifyingTagsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides identity qualifications to augment identification and associated processing of the Entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedTime" type="uci:TimeFunctionType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates time related events that are associated to the entity such as when activated or when operational. The multiplicity is limited to N-1 options where NONE is an event that has no value, thus removed from list of available options.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityLostMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An Entity that was not observed in the time frame and location expected.  In Space operations, a Resident Space Object (RSO) entity is considered "lost" if it does not have any associated metric observations within the last 30 days.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the unique identifier of the entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LastObservationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Time of the most recent correlated observation to the object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DaysLost" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the number of days the object has been lost.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissingCount" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Number of missing events since the most recent correlated observation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Probability" type="xs:double">
				<xs:annotation>
					<xs:documentation>A number from 0 to 1 with 1 representing complete confidence that the object is not in its expected orbit.  Note that the value should not reach absolute 0 or absolute 1.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PreviousProbability" type="xs:double">
				<xs:annotation>
