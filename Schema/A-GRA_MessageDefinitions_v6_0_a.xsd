					<xs:documentation>Initial Fix Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PI_ProcedureTurnToIntercept" type="uci:EmptyType">
