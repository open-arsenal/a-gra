	</xs:complexType>
	<xs:complexType name="MA_CommIER_BaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A planned Information Exchange Requirement describing the who, what and where of a piece of data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_CommIER_ReferenceType">
				<xs:sequence>
					<xs:element name="ContentType" type="uci:MA_CommIER_ContentType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the type of content for the IER.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Priority" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>Indicates the priority of the IER amongst other IERs. Priority does not dictate temporal ordering; it gives guidance on which IERs to favor when resources are limited.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IER_DetailsPET" type="uci:MA_CommIER_DetailsPET" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates an extension point to define custom IER Details. Concrete types for this extension point include: </xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_ContentType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Type" type="uci:MA_CommIER_FilterType">
				<xs:annotation>
					<xs:documentation>Indicates the type and filtering for the IER.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Direction" type="uci:CommDataDirectionFiltrationEnum">
				<xs:annotation>
					<xs:documentation>Indicates the direction(s) of data flow for the IER for the local System. Systems supporting the same IER can have different planned Direction configurations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConnectionKey" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies an implementation specific Connection ID. This allows this message configuration to be applied to a specific Connection therefore only applying to message traffic on that connection.ConnectionKey can be used for conveying internal topics, or conveying topic preservation from system to system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllowWrappedEgressMessages" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If set to TRUE, wrapped messages meant for non-specific destinations are checked with the type filter. Not set and FALSE are equivalent.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_DatalinkType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MessageFormat" type="uci:CommDataFormatEnum">
				<xs:annotation>
					<xs:documentation>Indicates the message type associated with the tactical datalink.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UCI_Filter" type="uci:QueryMessageType">
				<xs:annotation>
					<xs:documentation>Indicates the type of UCI messages and filter parameters applicable to the tactical datalink IER definition. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkNativeFilter" type="uci:DataLinkNativeFilterPET" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Extension point to allow for the unique data-link specific methods of addressing the native methods to control data ingress - egress. Concrete types for this extension point include: DataLinkNativeFilter_NetworkLinkType, Link16EntityDataLinkNativeFilterType, OperationsAreaDataLinkNativeFilterType</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_DesiredServicesID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the ID type corresponding to desired services for an Information Exchange Requirement.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_DesiredServicesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines the desired quality-of-service (QoS) constraints for an IER (Information Exchange Requirement) solution.  All child elements are optional; when omitted software should apply no explicit bound for that metric.  Values can be interpreted by the as hard constraints (must be satisfied) or as soft goals, depending on the profiling logic of the specific IER.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IER_DesiriedServiceID" type="uci:MA_CommIER_DesiredServicesID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this set of IER desired services.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRequiredLinkCapacity" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The smallest data-rate (bandwidth) that a selected link must provide in order to satisfy IERs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRequiredSuccessRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation> Minimum availability / success probability expressed as a percentage (0-100 %). Aggregated link availability should meet or exceed this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RetransmissionCount" type="uci:MA_NonNegativeByte8Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of times the message should be transmitted, including the initial transmission.  Each additional transmission is a re-send of the same payload to improve the likelihood of successful delivery.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompressionType" type="uci:MA_CommCompressionTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of compression required to satisfy this IER.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeliveryProtocol" type="uci:MA_CommIER_DeliveryProtocolEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>When present, the solution must guarantee reliable delivery of the payload in accordance with the selected type. This should result in the selection of links with such mechanisms. When omitted, best-effort delivery is acceptable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_DetailsPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Extension point to allow for unique IER details.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_DistributionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a grouping type with a unique identifer to an associated ip address.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="RemoteSystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a System that is a source/publisher of data/messages for the IER. Used in concert with IER.ContentType.Direction to identify sources/destinations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistributionGroupMembershipID" type="uci:MA_DistributionGroupMembershipID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a multicast group membership that is a source/publisher of data/messages for the IER. Used in concert with IER.ContentType.Direction to identify sources/destinations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistributionGroupID" type="uci:MA_DistributionGroupID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a multicast group that is a source/publisher of data/messages for the IER. Used in concert with IER.ContentType.Direction to identify sources/destinations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_FilterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="UCI_Message" type="uci:QueryMessageType">
				<xs:annotation>
					<xs:documentation>Indicates an inter-System IER for UCI messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TacticalDatalink" type="uci:MA_CommIER_DatalinkType">
				<xs:annotation>
					<xs:documentation>Indicates an inter-System IER for messages associated with Tactical Data links.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_GatewayType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_CommIER_BaseType">
				<xs:sequence>
					<xs:element name="IER_ConfigurationState" type="uci:ObjectStateEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether the IER is added, updated or removed from the Capability configuration as a result of the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TransmitFrequency" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the transmit frequency for the IER.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EndpointAssignment" type="uci:MA_CommIER_AssignmentType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a Vector or Comm Group that the IER is assigned to. The Vector or Comm Group referenced by this element should be declared in the same Command or be an already configured Vector in the associated Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_ID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the ID type corresponding to Information Exchange Requirements.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_Planned_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A planned Information Exchange Requirement describing the who, what and where of a piece of data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_CommIER_BaseType">
				<xs:sequence>
					<xs:element name="IER_Distribution" type="uci:MA_CommIER_DistributionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a distribution list for data/messages for the IER. If not present it should be interpreted as *.* (all)</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_ReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A reference to an Information Exchange Requirement.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IER_ID" type="uci:MA_CommIER_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the IER.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IER_CommonName" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the commonly known name for the IER. For example, this element can indicate the named OTA Topic on the overlay network that this IER corresponds to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StackVersion" type="uci:MA_NonNegativeByte255Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the overall software stack versioning. The value ties together the version of the core software, the schema version, and any bundled third-party software packages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_StatisticsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates IER statistics collected by a Gateway from the resulting sibling ActivityID.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IER_ID" type="uci:MA_CommIER_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique identifier for the IER id in which these statistics were identified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique identifier for the network link id in which these statistics were identified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AverageSize" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This value represents the average size of a unique message flowing through a gateway.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StandardDeviation" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This value represents the stadard deviation of the average size of a unique message flowing through a gateway.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfUniqueMessages" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This value represents the number of unique messages for a message configuration that is flowing through a gateway.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommIER_VectorRateGroupAssignmentType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IER_ID" type="uci:MA_CommIER_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the IER to be assigned.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endpoint_Assignment" type="uci:MA_CommIER_AssignmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Vector that the sibling IER is assigned to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RateGroupID" type="uci:MA_CommRateGroupID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the RateGroup for the assignment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DesiredIER_ServiceID" type="uci:MA_CommIER_DesiredServicesID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the desired service constraints for this IER.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommRateGroupID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a unique identifer for a rate group.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommRateGroupType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A RateGroup is a data structure that describes "How Fast."</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RateGroupID" type="uci:MA_CommRateGroupID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the RateGroup.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RateGroup_CommonName" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the commonly known name for this RateGroup.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RateType" type="uci:MA_CommRateTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of rate associated with this RateGroup.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitFrequency" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the transmit frequency for the RateGroup. The value (in seconds) indicates the desired minimum delta time between messages being sent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dynamic" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the transmit frequency can be changed dynamically by software. If true, indicates the rate can be dynamically changed by software. If false, indicates the software should use the value as a statically planned value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommTeamReportMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Message Data Type for the MA_CommTeamReport Message Type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AvailableEndpoint" type="uci:MA_AvailableNetworkEndPointsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Lists the asset(s) or endpoint(s) part of the specific Group.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommTeamReportMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This message contains the overarching structure for the CommTeamReport message.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_CommTeamReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommTriggerID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a unique identifier for triggers.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_CommTriggerInformationPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This is the abstract base for all Information Exchange Requirement Filter complexTypes.  It is a Polymorphic Extension Type (PET).  In UCI, PETs are used in select instances to allow a controlled set of complexTypes, defined elsewhere in the schema, to be used to define an element without creating a large choice statement or other unwieldy XSD definition.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="MA_CommTriggerType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes the events that would "trigger" an effectivity activation or deactivation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TriggerID" type="uci:MA_CommTriggerID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the trigger defined by the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TriggerType" type="uci:MA_DataDisseminationPlanTriggerType">
				<xs:annotation>
					<xs:documentation>Signifies available triggers which would automatically invoke Effectivities within this DataDisseminationPlan</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommVectorBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VectorID" type="uci:MA_CommVectorID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the CommVector.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VectorType" type="uci:MA_CommVectorEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of CommVector. See enumerate annotations for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Direction" type="uci:MA_CommVectorDirectionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the direction of data flow for the vector with respect to the local System. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the NetworkLink of a CommTerminal that the Vector is associated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceEndpoint" type="uci:MA_CommEndpointType">
				<xs:annotation>
					<xs:documentation>Indicates the network endpoint that the Vector initiates from specifying local connection infromation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DestinationEndpoint" type="uci:MA_CommEndpointType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicatest a network endpoint(s) for the Vector. The meaning of this element varies based on the sibling VectorType and Direction; see its enumerate annotations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VectorInformationPET" type="uci:MA_CommVectorInformationPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an extension point to define a custom optimization. Concrete types for this extension point include:  </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeliveryProtocol" type="uci:MA_CommIER_DeliveryProtocolEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>When present, the solution must guarantee reliable delivery of the payload in accordance with the selected type. This should result in the selection of links with such mechanisms. When omitted, best-effort delivery is acceptable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_CommVectorCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_CommVectorBaseType">
				<xs:sequence>
					<xs:element name="VectorConfigurationState" type="uci:ObjectStateEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether the Vector is added, updated or removed from the Gateway configuration as a result of the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DestinationSystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
