						<xs:annotation>
							<xs:documentation>The list of all (sub)components comprising this component.  This field is used to represent a tree structure of components/units/parts within a component.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ComponentConfigurationType" uci:version="002.001.000.000">
