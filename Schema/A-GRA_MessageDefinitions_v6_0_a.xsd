	</xs:complexType>
	<xs:complexType name="QueryCountType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Counts the length of the sequence formed by the specified Step and compares it to the specified Value.  The Step field must be present due to the fact that the Count of the current context is always 1.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Value" type="uci:QueryCountValueType">
				<xs:annotation>
					<xs:documentation>Value used in the comparison.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryCountValueType" uci:version="000.000.000.000">
		<xs:annotation>
