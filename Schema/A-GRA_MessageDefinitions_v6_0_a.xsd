	<xs:complexType name="MA_UseRangeTurnAndRunOrDMCChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="UseRangeTurnAndRun" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Use Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.Target turn-and-run maneuver

RangeTurnAndRun is not applicable to ballistic trajectory targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DigitalManeuveringCueAngle" type="uci:AngleHalfPositiveType">
				<xs:annotation>
					<xs:documentation>The magnitude of the maximum angle the target can turn away from the platform which results in weapon intercept of the target with nominal energy, assuming an immediate employment command. This field is valid only if RangeMaxGuidance &gt;= TargetRange &gt;= RangeTurnAndRun. This field is never greater than the magnitude of the target aspect angle.

For air platforms, this turn is in the horizontal plane defined by the north and east axes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_UserType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OperatorRoleID" type="uci:OperatorRoleID_Type">
				<xs:annotation>
					<xs:documentation>This choice type is used in the context of RBAC to specify an operator role to tie a set of authorized permissions to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This choice type is used to specify a system ID to tie a set of authorized permissions to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UserIdentifier" type="uci:UserIdentifierType">
				<xs:annotation>
					<xs:documentation>This choice type is used to specify a User Identifier to tie a set of authorized permissions to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_ValidationResultReasonType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides additional context to validation rejections by Flight Autonomy.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InsufficientEndurance" type="uci:MA_InsufficientEnduranceType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Define insufficient endurance details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PerformanceConstraint" type="uci:MA_PerformanceConstraintEnum" minOccurs="0" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Specify non-conforming performance constraint. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteValidationInvalidPath" type="uci:RouteValidationInvalidPathType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Define invalid segments of a route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurveValidationInvalidSection" type="uci:MA_CurveSectionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Define invalid section(s) of a curve.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeofenceConstraintID" type="uci:OpZoneID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Define the geofence ID(s) flight autonomy expected the flight command to violate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityConstraintID" type="uci:EntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Define the entity ID(s) flight autonomy expected the flight command to intersect.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TerrainConstraint" type="uci:Point4D_Type" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Define the position Flight Autonomy expected the flight command to intersect.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Define the position Flight Autonomy expected the flight command to intersect.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the uniqueID of the commanded Capability that is not supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_VehicleCommandDataType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VehicleAction" type="uci:VehicleActionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines vehicle actions that can be done along a path segment of a route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IFF_Settings" type="uci:IFF_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present the IFF settings for this vehicle will be changed along this path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurvivabilityMode" type="uci:VehicleSurvivabilityModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies that the vehicle should put itself into a more survivable mode. Different vehicles will have specific behaviors that reduce the signature of the vehicle (doors closed, minimal use of flaps, etc.) If this element is not present then it is assumed that the aircraft being configured has no survivability mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LostCommTimeout" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the lost communication contingency timeout. When this timeout value is exceeded, the AV considers that lost communication has occurred and begins to perform contingency measures.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LOS" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Use Line Of Sight (LOS) communication as backup contingency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LossOfLinkProcessing" type="uci:VehicleLossOfLinkProcessingEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies whether the vehicle should invoke special Loss of Link processing. This could be turned off if the vehicle is going to be in a known and accepted lost communication situation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommAllocationAction" type="uci:CommAllocationActionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change of communication allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QNH_Setting" type="uci:PressureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the barometric altimeter setting for correct MSL reading, commonly known as QNH, requested. Expressed in kilopascals (kPa).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_VehicleCommandStateType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Current commanded Flight details. </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Altitude" type="uci:AltitudeReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Commanded Altitude Type</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Heading" type="uci:MA_DirectionReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Intended heading of the aircraft. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Roll, pitch, yaw of aircraft. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Change in orientation of the aircraft</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PowerLevel" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates average throttle setting of all engines as a percentage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Speed" type="uci:PathSegmentSpeedValueType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines speed type (reference frame) for all speed related fields in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines speed type (reference frame) for all speed related fields in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_VisualIdentificationChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PlatformIdentity" type="uci:PlatformIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a possible "platform identity" of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarCrossSection" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>The specific Radar Cross Section identification for a system. This will typically be a system-specific and service-specific identifier for pre-configured Radar Cross Sectional data. Services should have coordinated this data ahead of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_WaypointFollowingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This message shall be used to provide the ability to send a new waypoint path or segment for the Platform to follow.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Route" type="uci:MA_RouteType">
				<xs:annotation>
					<xs:documentation>Indicates the Paths and Segments that make up the Route to be flown.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WeaponRangeType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies the capability range as a function of the azimuth off the ownship.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Range" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the slant range of the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Azimuth" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Indicates the azimuth the slant range pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WeaponStateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EngagementState" type="uci:MA_EngagementStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the engagement state of the entity. Omission is equivalent to IN_FLIGHT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeToActive" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time until the weapon seeker becomes active, informs the duration of flyout support.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeToIntercept" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time until expected impact, informs tactics timing.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_ChoiceType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies how dynamic the returned Weapon Engagement Zone (WEZ) will be. </xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="StaticWEZ" type="uci:MA_WEZ_StaticType">
				<xs:annotation>
					<xs:documentation>Indicates a target has a heading pointed at the ownship, and the same altitude and velocity as the ownship in its current state, as reported by the vehicle interface. The service will subscribe to position data as reported by the vehicle interface for ownship state data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedStaticWEZ" type="uci:MA_WEZ_PlannedStaticType">
				<xs:annotation>
					<xs:documentation>Indicates a target has a heading pointed at the ownship and an altitude and velocity as described in the "PlannedReleaseConditions" field. The service will use the "PlannedReleaseConditions" field for the ownship state data. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedWEZ" type="uci:MA_WEZ_PredictedType">
				<xs:annotation>
					<xs:documentation>Indicates a target has the heading, altitude and velocity as described by the "PredictedTargetStateData" field. The service will subscribe to position data as reported by the vehicle interface for ownship state data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedPredictedWEZ" type="uci:MA_WEZ_PlannedPredictedType">
				<xs:annotation>
					<xs:documentation>Indicates a target has the heading, altitude and velocity as described by the "PredictedTargetStateData" field. The service will use the "PlannedReleaseConditions" field for the ownship state data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_DataType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>This type contains the data necessary for a WEZ.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeTurnAndClose" type="uci:MA_WeaponRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch slant range at which the weapon will intercept the target and arm its fuze, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.Target turn-and-close maneuver

RangeTurnAndClose is not applicable to ballistic trajectory targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMinimum" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch slant range at which the weapon will intercept the target and arm its fuze, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeTurnAndRun" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.Target turn-and-run maneuver

RangeTurnAndRun is not applicable to ballistic trajectory targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeProbabilityOfIntercept" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMaxGuidance" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with nominal energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeOptimal" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Optimal steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMaxAero" type="uci:MA_WeaponRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with nominal energy, assuming no platform guidance or weapon guidance errors for:
1.Optimal steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeToRelease" type="uci:TimeType">
				<xs:annotation>
					<xs:documentation>The seconds time to activate for the proposed launch store type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOfActivation" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time of weapon seeker activation, assuming no platform guidance or weapon errors, for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No post-launch target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_ID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to a WEZ.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_MDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WEZ_ID" type="uci:MA_WEZ_ID_Type">
				<xs:annotation>
					<xs:documentation>This is an ID to uniquely identify the Weapon Engagement Zone (WEZ).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WEZ_RequestID" type="uci:RequestID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the request message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the weapon Capability instance that this WEZ is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeneratedByWeapon" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element indicates if the WEZ was generated using payload algorithms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WEZ_Data" type="uci:MA_WEZ_DataType">
				<xs:annotation>
					<xs:documentation>Indicates WEZ range calculations for air-to-air engagement assessments.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_MT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_WEZ_MDT">
						<xs:annotation>
							<xs:documentation>This represents the characteristics that identify and describe a single Weapon Engagement Zone (WEZ).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_PlannedPredictedType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WEZ_FieldOfView" type="uci:MA_WEZ_FieldOfViewEnum">
				<xs:annotation>
					<xs:documentation>Identifies the region in radians for the WEZ by indicating the desired azimuth range around the ownship for which the capability ranges are being requested for. The ranges for these regions may be pre-calculated by the service prior to flight or calculated upon the request in flight. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedReleaseConditions" type="uci:MA_WEZ_StateDataType">
				<xs:annotation>
					<xs:documentation>Specifies the planned ownship position and state data for the WEZ.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedTargetStateData" type="uci:MA_WEZ_StateDataType">
				<xs:annotation>
					<xs:documentation>Indicates predicted target state data for the WEZ.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_WEZ_PlannedStaticType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WEZ_FieldOfView" type="uci:MA_WEZ_FieldOfViewEnum">
				<xs:annotation>
					<xs:documentation>Identifies the region in radians for the WEZ by indicating the desired azimuth range around the ownship for which the capability ranges are being requested for. The ranges for these regions may be pre-calculated by the service prior to flight or calculated upon the request in flight. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedReleaseConditions" type="uci:MA_WEZ_StateDataType">
				<xs:annotation>
