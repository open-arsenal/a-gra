			<xs:enumeration value="GROUND_TO_ANY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SURFACE_TO_ANY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SUBSURFACE_TO_ANY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE_TO_ANY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CYBER_TO_ANY">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_ActivityCodeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the entity's function or mission that it may or may not be engaged in at the moment. Based on the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3) Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
			<xs:maxLength value="3" />
			<xs:pattern value="[A-Z0-9]{1,3}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_CED_NameType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the emitter's name in the Combined Emitter Database (CED). See the Combined Emitter Database (CED) for more information.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="12" />
			<xs:pattern value="[A-Za-z0-9_\-]{0,12}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_CodeWordType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The description of an EOB Code Word may be found in the classified appendix of the MIDB. Based on the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3) Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="5" />
			<xs:minLength value="0" />
			<xs:pattern value="[A-Za-z0-9_\-]{0,5}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_CorrelationTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The status/result of a previous attempt to correlate an input (SignalReport or Entity) to the EOB.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LOCATION_ELNOT">
				<xs:annotation>
					<xs:documentation>Location and ELNOT match. confidence ellipse encompasses at least one site credited with an emitter whose ELNOT is the same as the intercept.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOCATION">
				<xs:annotation>
					<xs:documentation>Confidence ellipse encompasses at least one EOB site but no site ELNOT is the same as the intercept ELNOT.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_MATCH">
				<xs:annotation>
					<xs:documentation>No EOB or soft site fall within confidence ellipse.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOFT_SITE">
				<xs:annotation>
					<xs:documentation>Confidence ellipse encompasses a soft site.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_ATTEMPTED">
				<xs:annotation>
					<xs:documentation>Correlation was not attempted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Unknown correlation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_EmitterSurrogateKeyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the surrogate key, which uniquely identifies the emitter in the source MIDB. Based on the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3) Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="14" />
			<xs:pattern value="[0-9A-Za-z]{5}[0-9]{9}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_O_SuffixType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies the EOB site facility or demographic area.  Typically used in conjunction with other data, such as a Basic Encyclopedia Number, to uniquely identify an EOB site.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="5" />
			<xs:pattern value="[A-Z]{2}[0-9]{3}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_SiteNameType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the name of the EOB as a facility or populated area.  Typically used in conjunction with other data to uniquely identify an EOB.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="54" />
			<xs:pattern value="[A-Za-z0-9_\-]{0,54}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EOB_WeaponSystemType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the EOB's associated weapon system based on a correlation with the Combined Emitter Database. Reference the Combined Emitter Database (CED) for more information.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="20" />
			<xs:minLength value="0" />
			<xs:pattern value="[A-Za-z0-9_\-]{0,20}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EP_CommandedStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the specific Electronic Protection option advertised by the capability has been commanded to be enabled or disabled. See enumerated values for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ENABLE">
				<xs:annotation>
					<xs:documentation>Indicates the desire for the EP option to be enabled for the associated capability. The actual EP status is reported with the capability status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLE">
				<xs:annotation>
					<xs:documentation>Indicates the desire for the EP option to be disabled for the associated capability. The actual EP status is reported with the capability status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EP_StateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the specific Electronic Protection option is available or unavailable based on current hardware state or software load.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates that the EP capability is available based on hardware and software configuration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNAVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates that the EP capability is unavailable based on hardware and software configuration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EP_StatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the specific Electronic Protection option is currently enabled or disabled for this capability. See enumerated values for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ENABLED">
				<xs:annotation>
					<xs:documentation>Indicates the EP option has been enabled for the associated capability. The EP status is reported with the capability status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED">
				<xs:annotation>
					<xs:documentation>Indicates the EP option has been disabled for the associated capability. The EP status is reported with the capability status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EphemerisTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the ephemeris data is measured or predicted.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MEASURED">
				<xs:annotation>
					<xs:documentation>Indicates the ephemeris data is directly measured, based on observation by a sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PREDICTED">
				<xs:annotation>
					<xs:documentation>Indicates the ephemeris data is a prediction from an ephemeris algorithm.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EqualityExpressionEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the logical comparator to use.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GREATER_THAN">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the value under test is greater than the reference value.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GREATER_THAN_EQUAL_TO">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the value under test is greater than or equal to the reference value.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LESS_THAN">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the value under test is less than the reference value.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LESS_THAN_EQUAL_TO">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the value under test is less than or equal to the reference value.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EQUAL_TO">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the values are equal.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_EQUAL_TO">
				<xs:annotation>
					<xs:documentation>Indicates the condition is true if the values are not equal.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EquipmentConditionEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the developmental and operational condition of a piece of equipment.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ABANDONED">
				<xs:annotation>
					<xs:documentation>Concept for system was defined, development never started.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CANCELED">
				<xs:annotation>
					<xs:documentation>Development started but was canceled.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUTURE">
				<xs:annotation>
					<xs:documentation>Development is in progress, but not operational.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSOLETE">
				<xs:annotation>
					<xs:documentation>No longer in operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONAL">
				<xs:annotation>
					<xs:documentation>In operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROPOSED">
				<xs:annotation>
					<xs:documentation>Concept for system is defined, but has not started development.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUSPENDED">
				<xs:annotation>
					<xs:documentation>Development began, but has been suspended. Development or deployment may resume in the future.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Status not known.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ESM_ActivationEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type indicates how an ESM MDF Entry is activated.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVATE">
				<xs:annotation>
					<xs:documentation>Indicates an ESM Library entry is flagged for use by the applicable SubCapability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEACTIVATE">
				<xs:annotation>
					<xs:documentation>Indicates an ESM Library entry is not flagged for use by the applicable SubCapability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ESM_DwellStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the state of this specific ESM dwell.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ENABLED">
				<xs:annotation>
					<xs:documentation>Indicates the dwell is enabled.  An enabled dwell may transition between periods of "active" and "inactive" subject to scheduling, resource availability, priority and other constraints.  An enabled dwell won't necessarily detect a signal and/or produce data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED_CALIBRATION_FAILURE">
				<xs:annotation>
					<xs:documentation>Indicates the dwell is disabled because it could not be properly calibrated.  Disabling due to calibration failure isn't necessarily an end state; a subsequent successful calibration can result in the dwell becoming enabled.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED_ADAPTATION">
				<xs:annotation>
					<xs:documentation>Indicates the dwell is disabled because interference was detected and the dwell has been temporarily replaced by a similar dwell that adapts to the interference.  Disabling due to adaptation isn't necessarily an end state; the original dwell can be re-enabled after the interference is no longer detected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED_BY_COMMAND">
				<xs:annotation>
					<xs:documentation>Indicates the dwell was disabled by an ESM_Command.  Disabling due to command isn't necessarily an end state; the dwell can be re-enabled by a subsequent ESM_Command.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED_OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the dwell was disabled for a reason not described by the sibling enumerates.  Disabling due to for an "other" reason isn't necessarily an end state; the dwell can be re-enabled.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPLETED">
				<xs:annotation>
					<xs:documentation>Indicates the dwell has completed as expected; all collection functions associated with the dwell have stopped.  A dwell can complete independent of whether a signal was detected and/or data was produced.  This is an end state for a dwell.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED">
				<xs:annotation>
					<xs:documentation>Indicates the dwell has failed unexpectedly.  A fault code may be reported separately.  This is an end state for a dwell.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DELETED">
				<xs:annotation>
					<xs:documentation>Indicates the dwell was deleted, for example by an ESM_Command.  This is an end state for a dwell.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ESM_DwellTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type/purpose of an ESM dwell.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MDF_ACQUISITION">
				<xs:annotation>
					<xs:documentation>Original dwell provided in the MDF for acquisition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDF_ADAPTATION">
				<xs:annotation>
					<xs:documentation>An original MDF acquisition dwell was modified/adapted due to detected interference.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDF_SUBCATEGORY_FILE_ACQUISITION">
				<xs:annotation>
					<xs:documentation>Original dwell provided in an MDF Subcategory File for acquisition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDF_SUBCATEGORY_FILE_ADAPTATION">
				<xs:annotation>
					<xs:documentation>An original MDF Subcategory File acquisition dwell was modified/adapted due to detected interference.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODULATION_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish a specific frequency or phase Modulation analysis to potentially resolve an emitter identification ambiguity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SCAN_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish a specific scan measurement to potentially resolve an emitter identification ambiguity or as requested by an operator/resource manager.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEOLOCATION_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish a specific geolocation measurement per the mission or as requested by an operator/resource manager.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPECIFIC_EMITTER_IDENTIFICATION">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish a specific emitter identification measurement to potentially resolve an emitter identification ambiguity or as requested by an operator/resource manager.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish another measurement to potentially resolve an emitter identification ambiguity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PULSE_DATA_COLLECTION">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish a specific pulse data collection as requested by an operator/resource manager.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Added dwell to accomplish another ESM task that does not fit into one of the above categories.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ESM_MessageOutputsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Allowable mechanisms for ESM message outputs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ESM_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message.  For example, the ESM_Activity message for an ESM Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGNAL_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the SignalReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PULSE_DATA">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the PulseData message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the ObservationMeasurementReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ESM_SubCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type establishes the second tier in the taxonomy of the ESM category of Capabilities.  For ESM, the second tier is a list of general ESM collection types and/or processing.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACQUISITION">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that searches for, acquires and then monitor signals from emitters.  Acquisition can be done based on basic characteristics of a signal such as frequency and PRI or the known signal characteristics of specific emitter types such as an SA-7 whose signal characteristics are described in a MDF.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DIRECTION_FINDING">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that determines the direction (line of bearing) from which a signal arrives at the ESM receiver.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMITTER_TYPE_IDENTIFICATION">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that identifies the type of system emitting a signal by comparing the signal's characteristics to the signal characteristics of known emitter types described in a MDF.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPECIFIC_EMITTER_IDENTIFICATION">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that identifies a specific instance of a type of system emitting a signal by comparing the signal's characteristics to the signal characteristics of known emitter type instances described in a MDF.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINGLE_SUBSYSTEM_GEOLOCATION">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that determines the location of the emitter of a signal using a single ESM Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_SUBSYSTEM_GEOLOCATION">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that determines the location of the emitter of a signal using multiple ESM Subsystems working cooperatively.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FINE_FREQUENCY_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that measures the frequency characteristics of a signal in fine detail.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRI_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Indicates an ESM SubCapability that measures the PRI characteristics of a signal in fine detail.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODULATION_MEASUREMENT">
				<xs:annotation>
