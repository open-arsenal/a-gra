					<xs:documentation>Defines the targets to be scanned for.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IgnoreTarget" type="uci:COMINT_AcquisitionTargetType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Defines targets to be ignored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TechniqueInUse" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
