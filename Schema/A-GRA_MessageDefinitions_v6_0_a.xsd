		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="ResultsInNative" type="uci:QueryTopicPairType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates whether the query results should be published via their "native" format or contained within the QueryDataRequestStatus message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="QueryResultLimit" type="uci:IntPositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the maximum number of results to return.  The number returned can be less than or equal to the limit. If this field is not specified all results that match the query should be returned.</xs:documentation>
						</xs:annotation>
