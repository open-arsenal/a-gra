				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeaponTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates types/categories of weapons.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BIOLOGICAL">
				<xs:annotation>
					<xs:documentation>Indicates a bacterium, virus, protozoan, parasite, or fungus that can be used purposefully as a weapon.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOMB">
				<xs:annotation>
					<xs:documentation>Indicates an explosive weapon, generally unpowered and aerially dropped, that uses an exothermic reaction to provide an extremely sudden and violent release of energy.  Sibling enumerations include more specific types of bomb; use them where applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOMB_GUIDED">
				<xs:annotation>
					<xs:documentation>Indicates a bomb whose kinematics can be actively directed after aerial release using a laser seeker, GPS or other means of navigation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHEMICAL">
				<xs:annotation>
					<xs:documentation>Indicates a weapon that uses chemicals to inflict harm on humans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CYBER">
				<xs:annotation>
					<xs:documentation>Indicates a weapon that uses cyber techniques.  See separate enumerated type that decomposes cyber.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPTH_CHARGE">
				<xs:annotation>
					<xs:documentation>Indicates a weapon intended to destroy a submarine by being dropped into the water nearby and detonating, subjecting the target to a powerful and destructive hydraulic shock.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DIRECTED_ENERGY">
				<xs:annotation>
					<xs:documentation>Indicates a weapon that damages its target with highly focused energy, including laser, microwaves and particle beams.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMP">
				<xs:annotation>
					<xs:documentation>Indicates a weapon that damages its target with a short burst of electromagnetic energy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EW_ELECTRONIC_ATTACK">
				<xs:annotation>
					<xs:documentation>Indicates a weapon involving the use of electromagnetic energy to attack equipment with the intent of degrading or neutralizing enemy combat capability.  Also known as jamming.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUN">
				<xs:annotation>
					<xs:documentation>Indicates a kinetic weapon used to launch projectiles. Sibling enumerations include more specific types of gun; use them where applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUN_ARTILLERY">
				<xs:annotation>
					<xs:documentation>Indicates a kinetic weapon used to launch large caliber projectiles.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IED">
				<xs:annotation>
					<xs:documentation>Indicates an improvised explosive device (IED); a "homemade" bomb and/or destructive device to destroy, incapacitate, harass, or distract.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MINE">
				<xs:annotation>
					<xs:documentation>Indicates a stationary explosive device that is designed to destroy personnel, ships, or vehicles when the latter come in contact with it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE">
				<xs:annotation>
					<xs:documentation>Indicates a guided airborne ranged weapon capable of self-propelled flight usually by a jet engine or rocket motor.  Sibling enumerations include more specific types of missile; use them where applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_BALLISTIC">
				<xs:annotation>
					<xs:documentation>Indicates a missile that follows a ballistic trajectory to deliver one or more warheads on a predetermined target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_CRUISE">
				<xs:annotation>
					<xs:documentation>Indicates a guided missile used against terrestrial targets, that remains in the atmosphere and flies the major portion of its flight path at approximately constant speed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NUCLEAR">
				<xs:annotation>
					<xs:documentation>Indicates an explosive device that derives its destructive force from nuclear reactions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates another type of Weapon.  Use of this enumerate should be avoided or at least minimized.  If used, it should only be used temporarily while proposing the addition of new well named enumerate(s) to the standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECTION_CHAFF">
				<xs:annotation>
					<xs:documentation>Indicates a radio frequency countermeasure released by military aircraft, ships, and vehicles to confuse enemy radar.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECTION_DECOY">
				<xs:annotation>
					<xs:documentation>Indicates a deceptive device used to draw an enemy away from a more important target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECTION_EO">
				<xs:annotation>
					<xs:documentation>Indicates an electro-optical countermeasure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECTION_EW">
				<xs:annotation>
					<xs:documentation>Indicates a protective electronic warfare countermeasure such as EP or ECCM.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROTECTION_FLARE">
				<xs:annotation>
