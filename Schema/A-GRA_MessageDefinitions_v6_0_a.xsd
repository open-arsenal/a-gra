					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:CargoDeliveryCapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoDeliveryCapabilityStatusMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LoadedCargoID" type="uci:CargoID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a cargo item currently loaded or carried by the cargo delivery Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AvailableCargoType" type="uci:CargoType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a cargo type which could be loaded or carried by the cargo delivery Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoDeliveryCapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CargoDeliveryCapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoDeliveryCapabilityType" uci:version="001.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:CargoDeliveryCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the specific cargo delivery Capability.  See enumeration annotations for additional details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:CargoDeliverySubCapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the specific cargo delivery SubCapability.  See enumeration annotations for additional details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CargoItem" type="uci:CargoType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a cargo type which can be carried and delivered by the cargo delivery capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoDeliverySpecificDataType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:CargoDeliveryCapabilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability's first tier type in the CargoDelivery taxonomy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityType" type="uci:CargoDeliverySubCapabilityEnum" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates a SubCapability of the CargoDelivery Capability; the second tier in the CargoDelivery taxonomy. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CargoDeliveryTaskType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Pickup" type="uci:CargoTransitionType">
				<xs:annotation>
					<xs:documentation>Indicates the details for cargo pickup.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dropoff" type="uci:CargoTransitionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the details for cargo dropoff/delivery.  If multiple Dropoff elements are specified, the first element is the primary dropoff point and secondary points follow in priority order, highest to lowest.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CargoID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to a cargo item.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoLocationType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>When a cargo item is co-located with or being transported by a System, this element, which indicates the unique ID of the System, can be used to infer the cargo location via PositionReport, MissionPlan or other messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Point" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial position of the cargo item.   Generally, services are encouraged to provide altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CargoSizeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Height" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The height of the cargo item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Width" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The width of the cargo item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Depth" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The Depth of the cargo item in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CargoStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CargoID" type="uci:CargoID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID, assigned to a cargo item as long as it exists.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CargoType" type="uci:CargoType">
				<xs:annotation>
					<xs:documentation>Indicates the packaging and physical size of the cargo.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CargoLocation" type="uci:CargoLocationType">
				<xs:annotation>
					<xs:documentation>Indicates the current location of the cargo.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CargoStatusMT" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CargoStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CargoTransitionType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CargoID" type="uci:CargoID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of the unique IDs assigned to the cargo items involved in this cargo relocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleControlStrategy" type="uci:VehicleControlStrategyEnum">
				<xs:annotation>
					<xs:documentation>This element indicates the vehicle control strategy desired/required for the cargo transition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoadUnloadStrategy" type="uci:CargoDeliverySubCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the loading and/or unloading strategy for the cargo transition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransitionLocation" type="uci:Point3D_Type" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Point of control and/or cargo transition (release, drop, pick-up, launch, handover, etc.).  For the case of independent hand-off and hand back points, two are given with the hand-off point being first.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EgressConstraint" type="uci:SectorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines a wedge or pie shaped region for egress to the point specified by the TransitionLocation element.  The angles are referenced to true north at the point specified by the TransitionLocation element.  The first (minimum) and second (maximum) angles are as encountered in a clockwise rotation beginning at true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IngressConstraint" type="uci:SectorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines a wedge or pie shaped region for ingress to the point specified by the TransitionLocation element.  The angles are referenced to true north at the point specified by the TransitionLocation element.  The first (minimum) and second (maximum) angles are as encountered in a clockwise rotation beginning at true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CargoType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CargoPackaging" type="uci:CargoPackagingEnum">
				<xs:annotation>
					<xs:documentation>Indicates the packaging of the cargo item.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CargoSize" type="uci:CargoSizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the overall physical size of the cargo package.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CargoWeight" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the weight of the cargo package.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CarrierReferenceID_ChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message carrier status data.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the carrier System for a self-report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique Entity ID of the carrier when reported by a third party.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CelestialBodyType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Describes a celestial body to be used as a third-body perturbation during propagation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EphemerisSource" type="uci:CelestialBodyEphemerisSourceEnum">
				<xs:annotation>
					<xs:documentation>The ephemeris source of the celestial body.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GravitationalParameter" type="uci:DoubleNonNegativeType">
				<xs:annotation>
					<xs:documentation>The gravitational parameter, mu, of the celestial body in m^3/s^2.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Name" type="uci:CelestialBodyNameEnum">
				<xs:annotation>
					<xs:documentation>The name of the celestial body.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CenterOfGravityAeroType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the center of gravity of an aeronautical vehicle.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LateralCenterOfGravity" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the lateral distance from centerline of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LongitudinalCenterOfGravity" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the longitudinal center of gravity in percent Mean Aerodynamic Chord (MAC). The value is a percent of how far the center of gravity (CoG) is from the Leading Edge Mean Aerodynamic Chord(LEMAC). If the CoG is at the LEMAC the value is 0% MAC. If the CoG is at the Trailing Edge Mean Aerodynamic Chord (TEMAC) then the value is 100% MAC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerticalCenterOfGravity" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the vertical distance from centerline of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CenterPointImageRegionOfInterestType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base ImageRegionOfInterestPET. It represents an area of an image specified by a center point (latitude/longitude) and a height and width in pixels, creating a rectangle.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ImageRegionOfInterestPET">
				<xs:sequence>
					<xs:element name="CenterPoint" type="uci:Point2D_Type">
						<xs:annotation>
							<xs:documentation>The center of the region of interest.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Height" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>The requested height of the resulting image, in pixels, such that the CenterPoint is in the center of the image.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Width" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>The requested width of the resulting image, in pixels, such that the CenterPoint is in the center of the image.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CF_CourseToFixType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to define Course to Fix Civil Path Terminator Leg Type. This path terminates at a fix with a specified course at that fix.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Course" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the Civil Path Terminator associated with the specified waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ChannelDescriptionType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies the parameters of the RF channel.  This information is typically used to decide if the channel has sufficient resources to support an application.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>This element provides an index for the channel using a unique ID.  This ID can be cross referenced in the component reporting section of SubsystemStatus.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChannelFreq" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>Defines the upper and lower frequency of the RF channel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Gain" type="uci:GainRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the maximum gain that can be applied to this channel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GainStepSize" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the step size that is supported for gain adjustments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BandsSupported" type="xs:int" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element identifies the RF bands that are supported by this RF channel, using integer indices.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CharacterizationChoiceType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>The CharacterizationChoiceType is a choice type that allows the user to select a specific type of characterization of the object.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Frequency" type="uci:FrequencyParamsType">
				<xs:annotation>
					<xs:documentation>The Frequency parameters are in regards to the RF Frequencies to measure. The min signal strength indicates the lowest threshold of collection. The RF Frequency resolution indicates the granularity of the collection. The frequency range indicates the specific RF band to collect. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IR_Image" type="uci:IR_ImageParamsType">
				<xs:annotation>
					<xs:documentation>The Infra-Red Image parameters describe the desired images to collect. The spectral frequency resolution parameter indicates the size of the wavelength to collect. The temperature resolution parameter indicates the amount of temperature variance to measure. The optional IR image setting parameter indicates the range of the IR frequency to measure.  The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricObservations" type="uci:MetricParamsType">
				<xs:annotation>
					<xs:documentation>The metric observation parameters consist of the desired distance resolution. The optional product resolution time parameter indicates the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Narrowband_SOI" type="uci:Narrowband_SOI_ParamsType">
				<xs:annotation>
					<xs:documentation>The Narrowband Space Object of Interest (NB_SOI) parameters consists of the amplitude in decibels of the desired Resolution. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpticalImage" type="uci:OpticalImageParamsType">
				<xs:annotation>
					<xs:documentation>The optical Image parameters consist of the overall desired image resolution. The optional product resolution parameter provides guidance on the color depth and horizontal and vertical pixel counts. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RCS" type="uci:RCS_ParamsType">
				<xs:annotation>
					<xs:documentation>The radar cross section (RCS) parameters include: the desired amplitude resolution measure in decibels per square meter, the optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisMag" type="uci:VisMagParamsType">
				<xs:annotation>
					<xs:documentation>The Visual Magnitude (VisMag) parameters consists of the amplitude resolution (measured in meters per pixel) and the optional product resolution time parameter (the minimum amount of time needed to get the desired level of resolution for the product).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Wideband_SOI" type="uci:Wideband_SOI_ParamsType">
				<xs:annotation>
					<xs:documentation>The Wideband Space Object of Interest (WB SOI) parameters consist of the range resolution of both the range and cross range. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Photometry" type="uci:PhotometryParamsType">
				<xs:annotation>
					<xs:documentation>The Photometry parameters consist of the amplitude in decibels of the desired resolution. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ColorPhotometry" type="uci:ColorPhotometryParamsType">
				<xs:annotation>
					<xs:documentation>The Color Photometry parameters consist of the desired sensor spectrum to use for the collection. The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CharacterizationObjectiveType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PhenomenologyCollection" type="uci:CharacterizationOptionsType">
				<xs:annotation>
					<xs:documentation>Indicates a task to characterize an object using one or more specified phenomenologies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StabilityAndOrientationAssessment" type="uci:StabilityCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates a task to assess the stability and orientation of an object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StructureAssessment" type="uci:StructureAssessmentType">
				<xs:annotation>
					<xs:documentation>Indicates a task to characterize or assess changes to the structure of a spacecraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IdentificationVerification" type="uci:IdentificationVerificationType">
				<xs:annotation>
					<xs:documentation>Indicates a task to verify that the target on the designated orbit is the expected spacecraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationsChanges" type="uci:SatelliteOperationsChangesCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates a task to perform collections to detect operations changes of the target object.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CharacterizationOptionsType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CharacterizationType" type="uci:CharacterizationChoiceType" maxOccurs="10">
				<xs:annotation>
					<xs:documentation>Indicates the type of characterization to be performed as part of this task. Multiple options (one per available choice) may be selected to address the Information Objective. Refer to the sibling Logical Operator element to understand the relationships.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LogicalOperator" type="uci:LogicalOperatorEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether all (AND), any (OR), or only one (XOR) of the sibling CharacterizationTypes must be performed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CharacterizationProduct" type="uci:CharacterizationProductTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired characterization product to be returned/reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CircleType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PointChoice" type="uci:PointChoiceType">
				<xs:annotation>
					<xs:documentation>The center point or relative focus for a circle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Radius" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The radius of a circle in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CivilPathTerminatorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Used to specify the choice Civil Path Terminator Type associated with the End Point, to include its specific parameters needed.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AF_ArcToFix" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Arc to Fix Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CA_CourseToAltitude" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Course to Altitude Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CD_CourseToDMEDistance" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Course to DME Distance Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CF_CourseToFix" type="uci:CF_CourseToFixType">
				<xs:annotation>
					<xs:documentation>Course to Fix Civil Path Terminator Type. This path terminates at a fixed point with a specified course at that fix.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CI_CourseToIntercept" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Course to Intercept Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CR_CourseToRadial" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Course to Radial Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DF_DirectToFix" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Direct to Fix Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FA_TrackToAltitude" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Track to Altitude Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FC_TrackFromFixToDistanceAlongTrack" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Track From a Fix to a Distance Along Track Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FD_TrackFromFixToDMEDistance" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Track From a Fix to a DME Distance Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FM_FixToManualTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Fix to Manual Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HA_HoldingWithAltitudeTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Holding With an Altitude Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HF_HoldingWithFixTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Holding With a Fix Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HM_HoldingWithManualTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Holding With a Manual Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IF_InitialFix" type="uci:EmptyType">
