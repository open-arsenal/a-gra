	<xs:complexType name="ActivationOrbitSequenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the orbit sequence to activate or go to.  This element is optional when the sibling ActivationCommand indicates ACTIVATE; when omitted the OrbitPlan is activated at the beginning.  This element is required when the sibling element indicates GO_TO_SEQUENCE.  This element should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orbit maneuver segment to activate on.  This element is optional when the sibling ActivationCommand indicates ACTIVATE; when omitted the OrbitPlan is activated at the beginning or on the sequence indicated by the sibling SequenceID.  This element is required when the sibling element indicates GO_TO_SEGMENT.  This element should be omitted otherwise.</xs:documentation>
