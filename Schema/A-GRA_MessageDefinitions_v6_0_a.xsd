			<xs:enumeration value="EXTERNAL_SLING_LOAD">
				<xs:annotation>
					<xs:documentation>Indicates a capability to carry and deliver cargo using a sling attached externally to a System.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERNAL_BAY">
				<xs:annotation>
					<xs:documentation>Indicates a capability to carry and deliver cargo using an internal cargo bay of a System.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CargoDeliverySubCapabilityEnum" uci:version="000.000.000.000">
