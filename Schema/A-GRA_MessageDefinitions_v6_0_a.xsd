			<xs:element name="Mobility" type="uci:MobilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If included, the type of mobility that this staleness pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="STANAG_4607_MissionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element represents a filter criteria using STANAG 4607 Mission characteristics.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Nationality" type="uci:STANAG_4607_NationalityType">
				<xs:annotation>
					<xs:documentation>Field P3 from the STANAG 4607 Packet Header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformIdentifier" type="uci:STANAG_4607_PlatformIdentifierType">
				<xs:annotation>
					<xs:documentation>Field P8 from the STANAG 4607 Packet Header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionIdentifier" type="xs:int">
				<xs:annotation>
					<xs:documentation>Field P9 from the STANAG 4607 Packet Header.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
