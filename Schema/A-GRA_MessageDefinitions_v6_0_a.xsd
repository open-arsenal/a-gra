				<xs:annotation>
					<xs:documentation>Indicates commanded settings for "Direct C2" mission control interfaces. List size allows for each PlanType (InterfacePlanTypeEnum) available to be represented.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectControl" type="uci:DirectControlInterfacesType" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates commanded settings for "Direct C2" mission control interfaces. If more than one instance of this element is given, each should be of a different child ActivationState.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
