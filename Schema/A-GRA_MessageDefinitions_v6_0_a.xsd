			</xs:element>
			<xs:element name="DefaultBlueSeparation" type="uci:SeparationParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates default minimum geospatial separation to be maintained when planning or analyzing routes or manually navigating. The separation is between the planned/navigated route and other routes or conflicting items. This is the default separation. It can be overridden in specific cases by the sibling element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DefaultRedSeparation" type="uci:SeparationParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates default minimum geospatial separation to be maintained when planning or analyzing routes or manually navigating. The separation is between the planned/navigated route and other routes or conflicting items. This is the default separation. It can be overridden in specific cases by the sibling element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificBlueSeparation" type="uci:SpecificBlueSeparationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Defines parameters to use when deconflicting blue player routes or generating routes to ensure proper separation from other blue players. These parameters apply at the vehicle type level.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificRedSeparation" type="uci:SpecificRedSeparationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Defines parameters to use when deconflicting blue player routes or generating routes to ensure proper separation from other red players. These parameters apply at the vehicle type level.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpDescription" type="uci:OpDescriptionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the name and description of the set of associated routing constraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableToIDs" type="uci:MA_PackageSystemType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One or more Systems to which the routing constraints apply. If omitted, the constraints apply to all Systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableZone" type="uci:ZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial zone in which the routing constraints apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time schedule during which the routing constraints apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionTraceability" type="uci:MissionTraceabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Allows the creator of this zone to specify what the source or motivation for this zone originated from. This could be ATO, ACO, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
