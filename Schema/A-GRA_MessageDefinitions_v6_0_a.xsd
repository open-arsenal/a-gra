		<xs:sequence>
			<xs:element name="OpPlanID" type="uci:MA_OpPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the OpPlan. Minor updates to the Plan can be indicated by an update of the value in the child Version element. More significant updates, replacements, etc. might warrant a new Plan with a different child UUID value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanCommandID" type="uci:MA_OpPlanCommandID_ChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the *PlanCommand which the OpPlan originated from.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Plan" type="uci:MA_OpPlanType">
				<xs:annotation>
					<xs:documentation>Contains the details of the Op* allocation plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When TRUE, indicates the *Plan is to be used only for intermediate planning purposes. It will eventually be replaced/superseded by another *Plan or be discarded/abandoned. *Plans with this flag should only be used when explicitly referenced by other messages. These *Plans should never: trigger functionality, be subject to approvals, be activated, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_OpPlanMT" uci:version="003.000.003.000">
