			<xs:element name="OuterConeAngle" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the outer cone angle.  Only valid if SensorType=Conical.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinClockAngle" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the minimum clock angle.  Only valid if SensorType=Conical.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxClockAngle" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the maximum clock angle.  Only valid if SensorType=Conical.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorTargeting" type="uci:CS_SensorTargetingEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Name of item being tracked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BoreSightAzimuth" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The fixed pointing location in azimuth if this is not a tracking sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BoreSightElevation" type="uci:AngleQuarterType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The fixed pointing location in elevation if this is not a tracking sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum altitude range of the sensor.  Only valid if SensorPointing=Relative.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum altitude range of the sensor.  Only valid if SensorPointing=Relative.</xs:documentation>
				</xs:annotation>
