		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="AuthorityType" type="uci:EntityManagementRequestAuthorityEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if this EntityManagementRequest is a request to change data or an order that must be followed. Defaults to REQUEST if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestSource" type="uci:RequestSourceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element indicates the type of service requesting the change. Defaults to AUTOMATIC_INTERNAL if not filled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestType" type="uci:EntityManagementRequestType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the type of request to perform on an Entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="UpdateFromControllingUnit" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if this EntityManagementRequest came from the system controlling the referenced entity. This indicates a higher confidence in the new data.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Source" type="uci:SystemMessageIdentifierType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the System initiating this request and allows the requesting Service, Activity, or Network to be specified.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>One or more Systems to which the request applies. If omitted, the request applies to all Systems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>One or more Services to which the request applies. If omitted, the request applies to all Services (or all services within the system specified by the sibling SystemID element).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
