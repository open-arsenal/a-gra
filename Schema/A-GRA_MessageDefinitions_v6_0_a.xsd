					<xs:documentation>See MT type for annotation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MA_ASSESSMENT_REQUEST">
				<xs:annotation>
					<xs:documentation>See MT type for annotation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MA_CONTROL_REQUEST">
				<xs:annotation>
					<xs:documentation>See MT type for annotation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="QUERY_DATA_REQUEST">
				<xs:annotation>
					<xs:documentation>See MT type for annotation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_OpLineCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of an operational line. Based on MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_LINE">
				<xs:annotation>
					<xs:documentation>A general line where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORWARD_EDGE_OF_BATTLE_AREA">
				<xs:annotation>
					<xs:documentation>The foremost limits of a series of areas in which ground combat units are deployed, excluding the areas in which the covering or screening forces are operating.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUN_TARGET_LINE">
				<xs:annotation>
					<xs:documentation>Straight line from the gun or guns to the target. Altitude, if included, is the apex of the projectile.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CORRIDOR">
				<xs:annotation>
					<xs:documentation>Line with width describing the passageway designated for travel by friendly aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_BOUNDARY">
				<xs:annotation>
					<xs:documentation>Line that indicates a limit beyond which exists a hostile environment.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BUFFER_ZONE_BOUNDARY">
				<xs:annotation>
					<xs:documentation>Line beyond which friendly aircraft usually do not fly in peacetime.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOW_LEVEL_TRANSIT_ROUTE">
				<xs:annotation>
					<xs:documentation>Line describing the center line of a route through the forward missile engagement zone that must be flown by friendly aircraft to ensure they are not designated hostile by defense systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TACTICAL_ACTION_LINE">
				<xs:annotation>
					<xs:documentation>Line positioned in hostile airspace which may be used in conjunction with other criteria for hostile determination.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIRE_SUPPORT_COORDINATION_LINE">
				<xs:annotation>
					<xs:documentation>Line established by the appropriate ground commander to ensure coordination of fire not under his command but which may affect current tactical operations. Attacks against ground targets behind this line must be coordinated with the appropriate ground commander.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORWARD_LINE_OF_OWN_TROOPS">
				<xs:annotation>
					<xs:documentation>Line defining the forward position of own troops within a ground area of responsibility, that does not usually coincide with the forward edge of battle area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LINE_OF_COMMUNICATIONS">
				<xs:annotation>
					<xs:documentation>Line the route that connects an operating military unit with its supply base.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JETWAY">
				<xs:annotation>
					<xs:documentation>Line with width that defines areas where commercial aircraft are flying through.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPARTURE_RADIAL">
				<xs:annotation>
					<xs:documentation>Line the defines the departure radial when performing Carrier admin departures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RECOVERY_RADIAL">
				<xs:annotation>
					<xs:documentation>Line the defines the recovery radial that is used to define the recovery marshal. May be used when performing Carrier admin recoveries.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FINAL_BEARING">
				<xs:annotation>
					<xs:documentation>Line the defines the final bearing when an aircraft is approaching a carrier. May be used when performing Carrier admin recoveries.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BRC">
				<xs:annotation>
					<xs:documentation>Base Recovery Course defines the aircraft carrier heading when an aircraft is approaching a carrier. May be used when performing Carrier admin recoveries.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_OpZoneCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of an operational zone. Many, but not all, of the enumerations are from MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002). Some of the enumerations in this type can also have unique parameters that are specified in OpZoneCategoryType. See individual enumerations for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIRBORNE_EARLY_WARNING">
				<xs:annotation>
					<xs:documentation>A point at which AEW aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMBAT_AIR_PATROL">
				<xs:annotation>
					<xs:documentation>A point at which CAP aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINED_ENTRY_EXIT">
				<xs:annotation>
					<xs:documentation>Indicates an area with constrained entries and exits. The additional parameters used with this zone category are defined in the ConstrainedEntryExitType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONTAMINATED">
				<xs:annotation>
					<xs:documentation>Indicates the zone is contaminated, an area caused by the deposit and/or absorption of radioactive material, or of biological or chemical agents on and by structures, areas, personnel, or objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DANGER">
				<xs:annotation>
					<xs:documentation>A specified area above, below, or within which there may be a potential danger.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEFENDED_AREA">
				<xs:annotation>
					<xs:documentation>An area the source tn is capable of defending against ballistic missiles, etc.,(i.e. the source tn is operational with ready weapons and has designated the area for defense).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DIRECTED_SEARCH_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a directed search area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOB">
				<xs:annotation>
					<xs:documentation>Indicates the zone is the boundary for an electronic order of battle request.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXERCISE">
				<xs:annotation>
					<xs:documentation>An area for military maneuver or simulated wartime operation involving planning, preparation and execution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIGHTER_ENGAGE_AOR">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a fighter area of responsibility (AOR), an airspace of defined dimensions within which the responsibility for engagement normally rests with fighter aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FILTER_AREA">
				<xs:annotation>
					<xs:documentation>Indicates a geographic area of interest for the purpose of limiting data. The additional parameters used with this zone category are defined in the OpZoneFilterAreaPET choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GENERAL_HAZARD">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hazard area that doesn't have a specified operational purpose.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GENERAL_STATION">
				<xs:annotation>
					<xs:documentation>A general zone describing an air station that must be amplified by voice or predetermined procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND_AOR">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a ground area of responsibility (AOR), an area of ground within which the responsibility for engagement normally rests with the appropriate ground force commander.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_TACTICAL_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hostile tactical area, an area in which hostile tactical forces (to include ground, air, or maritime) are known to be or will be operating.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_WEAPON">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hostile weapon zone, an area in which hostile air defense systems are capable of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMPACT_POINT">
				<xs:annotation>
					<xs:documentation>The real or expected point that a device has or will penetrate or contact a surface.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JAMMING">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a jamming control zone. The additional parameters used with this zone category are defined in the OpZoneJammingType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KEEP_IN">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a boundary within which applicable systems must stay. The additional parameters used with this zone category are defined in the IngressEgressType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KILL">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a kill zone, an air defense system (SOC) area in which friendly fighters may use less restrictive rules of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_ENGAGEMENT">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a missile engagement zone, a primary engagement area designated for friendly surface to air missiles.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_LAUNCH_POINT">
				<xs:annotation>
					<xs:documentation>A point indicating the position from which a missile has been or will be launched. The additional parameters used with this zone category are defined in the OpZoneMissileLaunchDataType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area in which a mission will take place.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NAMED_AREA_OF_INTEREST">
				<xs:annotation>
					<xs:documentation>An area usually along an enemy mobility corridor where enemy activity (or inactivity) confirms a particular course of action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_COMM">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where communications use is restricted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_FIRE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where strike impact is restricted; the zone does not restrict the launch of weapons. The additional parameters used with this zone category are defined in the OpZoneNoFireType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_FLY">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where flight is restricted. The additional parameters used with this zone category are defined in the OpZoneNoFlyType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_IMAGE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where image collection is restricted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>A figure eight pattern within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RACE_TRACK">
				<xs:annotation>
					<xs:documentation>An oval within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RANDOM_CLOSED">
				<xs:annotation>
					<xs:documentation>A rectangle in which the aircraft will track randomly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area that doesn't have a specified operational purpose.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>An area where a search is being or will be conducted. normally associated with a SAR mission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEPARATION">
				<xs:annotation>
					<xs:documentation>Indicates an update in reservation volume for an individual vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHORAD">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a short range area defense (SHORAD), an area defended by friendly army short range air defense systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPEED_LIMITS">
				<xs:annotation>
					<xs:documentation>An area where platform speeds are limited. The additional parameters used with this zone category are defined in the OpZoneSpeedLimitType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBMARINE_PATROL_AREA">
				<xs:annotation>
					<xs:documentation>A restricted area established to allow submarine operations to be unimpeded by the operation, or possible attack from friendly forces in wartime, or to be conducted without submerged mutual interference in peacetime.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TARGET_AREA_OF_INTEREST">
				<xs:annotation>
					<xs:documentation>An engagement area usually along an enemy mobility corridor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VEHICLE_CONFIGURATION">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a region where specific vehicle configuration parameters should be changed. The additional parameters used with this zone category are defined in the VehicleCommandDataType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEAPON_RESTRICTION">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area within which a set of restricted weapons cannot be used against a target type and/or within in the zone. The additional parameters used with this zone category are defined in the OpZoneWeaponRestrictionType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEATHER_CONDITIONS">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area within which weather conditions have a potential for mission impact. The additional parameters used with this zone category are defined in the OpZoneWeatherType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_OverrideSpeedEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Override the nominal flight speed.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>Remove the speed override. Resume nominal flight speed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MINIMUM_APPROACH">
				<xs:annotation>
					<xs:documentation>Slow to the minimum approach airspeed for the current configuration and conditions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_PackageChangeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enum indicating this type of package change.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FORM_NEW_PACKAGE">
				<xs:annotation>
					<xs:documentation>Create a new package.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JOIN_PACKAGE">
				<xs:annotation>
					<xs:documentation>Join an existing package.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LEAVE_PACKAGE">
				<xs:annotation>
					<xs:documentation>Leave the current affiliated package.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UPDATE_PACKAGE_LEADER">
				<xs:annotation>
					<xs:documentation>Update package leader to a specific system. Use of this field bypasses the need for a leader election.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUEST_PACKAGE_ELECTION">
				<xs:annotation>
					<xs:documentation>Request the package perform a leader election.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_PathTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the action to be performed while on the associated path.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PRIMARY">
				<xs:annotation>
					<xs:documentation>Indicates the path is the primary (default) path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALTERNATE">
				<xs:annotation>
					<xs:documentation>Indicates the path is an alternative to the primary path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOSS_OF_COMM">
				<xs:annotation>
					<xs:documentation>Indicates the path is used during a loss of communication contingency.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RETURN_TO_BASE">
				<xs:annotation>
					<xs:documentation>Indicates the path is used to return the vehicle to base.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOFT_DITCH">
				<xs:annotation>
					<xs:documentation>Indicates the path ends in a soft ditch of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HARD_DITCH">
				<xs:annotation>
					<xs:documentation>Indicates the path ends in a hard ditch of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INGRESS">
				<xs:annotation>
					<xs:documentation>Indicates the path ingresses the mission area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EGRESS">
				<xs:annotation>
					<xs:documentation>Indicates the path egresses the mission area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF">
				<xs:annotation>
					<xs:documentation>Indicates the path begins with a takeoff.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LANDING">
				<xs:annotation>
					<xs:documentation>Indicates the path ends in a landing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMERGENCY_LANDING">
				<xs:annotation>
					<xs:documentation>Indicates the path ends in an emergency landing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAXI">
				<xs:annotation>
					<xs:documentation>Indicates the path consists entirely of taxi waypoints.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIRBORNE">
				<xs:annotation>
					<xs:documentation>Indicates the path is the initial segment after takeoff/launch. Part of the CV Admin departure procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARCING">
				<xs:annotation>
					<xs:documentation>Indicates the path is arcing along a radial. Part of the CV Admin departure procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BREAKING">
				<xs:annotation>
					<xs:documentation>Indicates the path segment is for the intersection with the approach path segment. Part of the CV Admin departure procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ON_DEP_RADIAL">
				<xs:annotation>
					<xs:documentation>Indicates the path segment has intercepted the departure radial and is following it. Part of the CV Admin departure procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIAL_APPROACH">
				<xs:annotation>
					<xs:documentation>Indicates the path segment is on the initial approach to the airfield/carrier. Part of the CV Admin recovery procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERMEDIATE_APPROACH">
				<xs:annotation>
					<xs:documentation>Indicates the path segment is on the intermediate approach to the airfield/carrier. Part of the CV Admin recovery procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FINAL_APPROACH">
				<xs:annotation>
					<xs:documentation>Indicates the path segment is on the final approach to the airfield/carrier. Part of the CV Admin recovery procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOLTER_WAVEOFF">
				<xs:annotation>
					<xs:documentation>Indicates the path segment is the contingency path for a bolter or wave-off condition. Part of the CV Admin recovery procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_PerformanceConstraintEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Elements of performance profile that exceed capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MIN_AIRSPEED_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Minimum allowable airspeed exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAX_AIRSPEED_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Maximum allowable airspeed exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIN_ALTITUDE_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Minimum allowable altitude exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAX_ALTITUDE_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Maximum allowable altitude exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIN_ACCELERATION_LIMIT_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Minimum allowable acceleration exceeded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAX_ACCELERATION_LIMIT_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Maximum allowable acceleration exceeded</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAX_ORIENTATION_LIMIT_EXCEEDED">
