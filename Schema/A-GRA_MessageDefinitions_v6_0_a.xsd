			</xs:element>
			<xs:element name="OrbitKinematics" type="uci:OrbitKinematicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orbital kinematics for this sequence of the orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ManeuverKinematics" type="uci:OrbitManeuverType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The kinematics for this sequence of the orbit plan associated with a maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextSequenceID" type="uci:OrbitKinematicsSequenceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the next sequence in the orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitKinematicsSetParametersType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ElementSetParameters" type="uci:OrbitalElementSetParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the parameters for an orbital element set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EphemerisParameters" type="uci:OrbitalEphemerisParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the parameters for an orbital ephemeris.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VCM_Parameters" type="uci:OrbitalVCM_ParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the parameters for an orbital VCM. This information includes the creation time of the VCM results, the propagation model used, and the parameters for controlling the propagation process.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitKinematicsSourceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Defines the source from which to get Orbit Kinematics.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByPlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>Via the OrbitPlanID of a particular OrbitPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByElementSet" type="uci:OrbitalElementSetSourceType">
				<xs:annotation>
					<xs:documentation>Via a specific Element Set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByEphemeris" type="uci:OrbitalEphemerisSourceType">
				<xs:annotation>
					<xs:documentation>Via a specific Ephemeris Source.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitKinematicsType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>The measured orbit determined by spacecraft ranging.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ElementSet" type="uci:TLE_BaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the default or "catalog" orbital element set (also known as two line element or TLE) for the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ephemeris" type="uci:OrbitalEphemerisChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes satellite orbit at date and time intervals.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VCM" type="uci:OrbitalVCM_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes the orbit in terms of a state vector along with covariance data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SingleVector" type="uci:OrbitalKinematicsChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides single vector information of the spacecraft's new orbit in standard coordinate reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitManeuverSegmentID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that corresponds to an Orbit Plan Maneuver Segment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitManeuverSegmentMetricsType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the metrics for an individual orbit segment, contained within an orbit sequence.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type">
				<xs:annotation>
					<xs:documentation>The unique sequence identifier of this orbital segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metrics" type="uci:SatelliteEnduranceType">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for the Orbit Segment referenced by the sibling SegmentID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitManeuverSegmentType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the orbit maneuver segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:PathSegmentSourceEnum">
				<xs:annotation>
					<xs:documentation>Defines whether the orbit segment was defined by an automated orbit/route planning service or if it was manually defined by an operator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartEpoch" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time when the maneuver starts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndPoint" type="uci:OrbitalKinematicsChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the end point of the PathSegment.  The start point is the end point of the previous PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Locked" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This flag is used to determine whether this segment can be modified/removed in subsequent planning steps and/or replans.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ManeuverType" type="uci:OrbitPlanManeuverTypeEnum" minOccurs="0" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates a reason for the maneuver. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaVelocity" type="uci:OrbitalManeuverDetailsBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the change in velocity that initiates the transit from the segment start point to the sibling EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modified" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If this element is present and set to TRUE, this segment has been modified.  This data is valuable to some planning algorithms to support validation of a user modified route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextSegmentID" type="uci:OrbitManeuverSegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the next segment in the maneuver sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitManeuverSequenceMetricsType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the metrics for an individual orbit sequence, contained within an orbit plan.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>The unique sequence identifier of this orbital sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metrics" type="uci:SatelliteEnduranceType">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for all the Segments of the Sequence referenced by the sibling SequenceID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitManeuverType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Detailed" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether the maneuver is the result of detailed planning (TRUE), or is a simple "stick" (FALSE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FirstSegmentID" type="uci:OrbitManeuverSegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the instance of the sibling Segment series which is the first segment in the orbit maneuver.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Segment" type="uci:OrbitManeuverSegmentType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Includes a series of orbit maneuver segments.  Each segment is defined from the segment EndPoint (or current spacecraft state if no previous segment) to the current segment EndPoint. Elements given here are not necessarily in mission order; it is necessary to follow the linkages provided in NextSegmentID to traverse the segments in mission order.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsID_Type" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to Orbit Metrics.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:VersionedID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MetricsID" type="uci:OrbitMetricsID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the OrbitMetrics.  Minor updates to the metrics can be indicated by an update of the value in the child Version element.  More significant updates, replacements, etc. might warrant a new instance with a different child UUID value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitPlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the OrbitPlan whose metrics are given by the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitParts" type="uci:OrbitPlanPartsEnum" minOccurs="0" maxOccurs="6">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts of the OrbitPlan indicated by the sibling OrbitPlanID were included in the metrics analysis summarized in this message.  If omitted, all parts were analyzed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitActivityPlanID" type="uci:OrbitActivityPlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an OrbitActivityPlan whose metrics are given by the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityParts" type="uci:ActivityPlanPartsEnum" minOccurs="0" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts of the OrbitActivityPlan indicated by the sibling OrbitActivityPlanID were included in the metrics analysis summarized in this message.  If omitted, all parts were analyzed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitMetrics" type="uci:SatelliteEnduranceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates overall, summary metrics for all Orbit Sequences and Orbit Segments of the OrbitPlan indicated by the sibling OrbitPlanID. These metrics represent the endurance used by the sibling OrbitPlanID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SequenceMetrics" type="uci:OrbitManeuverSequenceMetricsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for all the Segments of a single Orbit Sequence of the OrbitPlan referenced by the sibling OrbitPlanID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentMetrics" type="uci:OrbitManeuverSegmentMetricsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for a single Orbit Segment of the OrbitPlan referenced by the sibling OrbitPlanID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitActivityMetrics" type="uci:OrbitActivityMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for a single Activity of the OrbitActivityPlan referenced by the sibling OrbitActivityPlanID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsMT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:OrbitMetricsMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsRequestMDT" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="OrbitPlanID" type="uci:OrbitPlanID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the OrbitPlan to be analyzed; the OrbitPlan whose metrics are being requested.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitParts" type="uci:OrbitPlanPartsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts of the OrbitPlan indicated by the sibling OrbitPlanID to include in the metrics analysis summarized.  If omitted, all parts should be analyzed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitActivityPlanID" type="uci:OrbitActivityPlanID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an OrbitActivityPlan to be analyzed; the OrbitActivityPlan whose metrics are being requested.  The Plan given here should be based on the OrbitPlan given by the sibling OrbitPlanID.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivityPlanParts" type="uci:ActivityPlanPartsEnum" minOccurs="0" maxOccurs="9">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts of the OrbitActivityPlan indicated by the sibling OrbitActivityPlanID to include in the metrics analysis.  If omitted, all parts should be analyzed. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsRequestMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:OrbitMetricsRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsRequestStatusMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="CompletionStatus" type="uci:CompletionStatusType">
						<xs:annotation>
							<xs:documentation>Progress information for the orbit plan metrics.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InvalidMetricsItem" type="uci:IncompleteProcessingType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an input, portion of the plan, etc. that resulted in unsuccessful metrics determination.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitMetricsRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:OrbitMetricsRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitModificationDetailsType" uci:version="003.001.001.001">
		<xs:annotation>
			<xs:documentation>Specifies details pertaining to modifying an orbit.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Orbit" type="uci:OrbitRegimeType" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates an orbital regime in which the spacecraft will reside during the OrbitPlan.  This element is included for convenience in querying for OrbitPlans in the same regime. List size is based on the number of enum values ("Select All That Apply") in OrbitRegimeEnum type. If multiple instances are given, each should be of a different OrbitRegimeEnum type as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parameters" type="uci:OrbitKinematicsSetParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates kinematics related settings and constraints which can vary by plan by discretion of the plan creator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitKinematicsSequenceModification" type="uci:OrbitKinematicsSequenceReplaceOrModifyChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change in an orbit kinematic sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitModificationRequestMDT" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Orbit modification message data. This allows for atomic changes to a Orbit in path or segment outside of normal Mission/Orbit planning, where transmission of whole Orbit could be an issue. The result of the message is a new Orbit message that incorporates the changes here into the Orbit, incrementing the OrbitVersionID.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="Source" type="uci:PlanInitiationSourceEnum">
						<xs:annotation>
							<xs:documentation>Source of the Orbit modification request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitPlanID" type="uci:OrbitPlanID_Type">
						<xs:annotation>
							<xs:documentation>Orbit Id for this request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OrbitModificationDetails" type="uci:OrbitModificationDetailsType">
						<xs:annotation>
							<xs:documentation>Specifies details of the orbit modification.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitModificationRequestMT" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:OrbitModificationRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitModificationRequestStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Provides status for orbit modification request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitModificationRequestStatusMT" uci:version="002.001.003.000">
