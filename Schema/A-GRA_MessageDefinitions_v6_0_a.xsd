		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CovarianceMatrixCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies what terms in the covariance matrix are being represented. The terms are provided in order of appearance in the lower triangular half of the matrix from element 1,1 (item 1) through the last element used in the correction. The diagonal terms are the variances of the solution parameter, and the off-diagonal terms are the covariances.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EQUINOCTIAL">
				<xs:annotation>
					<xs:documentation>A 6x6 symmetric matrix consisting of 21 values, where terms 1-6 represent the following equinoctial elements of the solution parameter:
						Af -- Equinoctial (f) Component of Apsidal Vector
						Ag -- Solstitial (g) Component of Apsidal Vector
						Chi -- CHI Orbit Plane Descriptor
						Psi -- PSI Orbit Plane Descriptor
						L -- Mean Longitude
						N -- Mean motion</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EQUINOCTIAL_PARAMETERS">
				<xs:annotation>
					<xs:documentation>A 7x7 or larger symmetric matrix consisting of 28-120 values, where the equinoctial elements (terms 1-6) are followed by one or more additional terms (terms 7-15) representing the model parameters of the solution:
						Equinoctial Elements:
						Af -- Equinoctial (f) Component of Apsidal Vector
						Ag -- Solstitial (g) Component of Apsidal Vector
						Chi -- CHI Orbit Plane Descriptor
						Psi -- PSI Orbit Plane Descriptor
						L -- Mean Longitude
						N -- Mean motion
						Model Parameters:
						B -– Ballistic Coefficient
						BDot -– First derivative of Ballistic Coefficient
						Agom –- Radiation Pressure Coefficient
						T –- Constant duration in-track thrust
						C1, C2...CN –- Optional consider parameters
						Reference developer documentation for the specific model parameter terms used and ordering of terms as they vary from system to system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_PARAMETERS">
				<xs:annotation>
					<xs:documentation>A 4x4 symmetric matrix consisting of 10 values, where terms 1-3 represent the delta velocity and the 4th term represents the maneuver start time of the solution parameter.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POSITION">
				<xs:annotation>
					<xs:documentation>A 3x3 symmetric matrix consisting of 6 values, where the terms represent the position of the solution parameter (ex: lat/lon/height, x/y/z)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POSITION_VELOCITY">
				<xs:annotation>
					<xs:documentation>A 6x6 symmetric matrix consisting of 21 values, where terms 1-3 represent the position and terms 4-6 represent the velocity of the solution parameter.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POSITION_VELOCITY_PARAMETERS">
				<xs:annotation>
					<xs:documentation>A 7x7 or larger symmetric matrix consisting of 28-120 values, where the position and velocity (terms 1-6) are followed by one or more additional terms (terms 7-15) representing the model parameters of the solution. Reference developer documentation for the specific model parameter terms used and ordering of terms as they vary from system to system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CoverageEffortEnum" uci:version="000.000.000.000">
