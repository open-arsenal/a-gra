					<xs:documentation>Indicates the associated Activity is pending execution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXECUTING">
				<xs:annotation>
					<xs:documentation>Indicates the associated Activity is executing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PAUSED">
				<xs:annotation>
					<xs:documentation>Indicates the Activity is paused.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPLETED">
				<xs:annotation>
					<xs:documentation>Indicates the Activity has completed and is no longer executing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED">
				<xs:annotation>
					<xs:documentation>Indicates the Activity failed and is no longer executing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUPERCEDED">
				<xs:annotation>
					<xs:documentation>Indicates the Activity was superseded by another Action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CANCELED">
				<xs:annotation>
					<xs:documentation>Indicates the Activity was canceled.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
