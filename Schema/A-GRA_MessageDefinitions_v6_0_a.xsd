			<xs:documentation>Tests if the specified Value is a substring of any node in the sequence formed by the specified Step.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" minOccurs="0" maxOccurs="unbounded">
