		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Indicates the x value of position in the J2K Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Indicates the y value of the position in the J2K Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Indicates the z value of the position in the J2K Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JammerEmitterIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ELNOT_Identifier" type="uci:NotationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents Electronic Intelligence (ELINT) Notation for non-communications electronic emissions.  Used to preserve original signal identification in case of modification by subsequent processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceivedPower" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the received power of an EA Jammer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="JamMode" type="uci:EA_ModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the general purpose of the detected jammer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterIndex" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter index associated with the emitter.  Emitter index is an index into a table/database of emitters.  The table/database is generally created in pre-mission planning and included in one or more MDFs.  This element is only useful/meaningful to subscribers who are aware of the table/database/MDF used by the publisher.  For inter-System interoperability, the sibling ELNOT_ID and DIEQP_ID elements are preferred and likely required.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JammerStationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Container for the JammerStation enumeration to enable a multiplicity other than that allowed by the UCI Schema Style and Design Specification. (e.g. MIL-STD-6016 required multiplicity of 10).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="JammerStation" type="uci:JammerStationEnum">
				<xs:annotation>
					<xs:documentation>Identifies the ALQ-99 specific information for a jammer station from MIL-STD-6016 DFI 1934 DUI 004.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JPEG_SettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CompressionRatio" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defined as the number of bytes in the input image divided by the number of bytes in the output image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeakSNR" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Set the output image quality, measured by peak signal to noise ratio (pSNR).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RateDistortionSlope" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The target slope on the rate-distortion curve.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WaveletTransform" type="uci:JPEG_WaveletTransformType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the settings to use for wavelet transform.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JPEG_WaveletTransformType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Type" type="uci:JPEG_WaveletTypeEnum">
				<xs:annotation>
					<xs:documentation>This element defines the type of wavelet transform to use, which may be the irreversible wavelet transform for lossy compression, or the reversible wavelet transform for lossless or lossy compression.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Level" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This element defines the number of decomposition levels to perform in the wavelet transforms.  The number of decomposition levels in the wavelet transform determines the number of resolution levels that will be available in the resulting image.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JREAP_CommonTimeReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Data pertaining to a JREAP Common Time Reference (CTR).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="State" type="uci:CTR_StateEnum">
				<xs:annotation>
					<xs:documentation>The current status of attempts to establish the common time reference.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstablishedTimeSource" type="uci:JREAP_TimeReferenceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The type of shared common time reference.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="JREAP_GatewayNativeStatisticsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Polymorphic extension of the base type GatewayNativeStatisticsPET for representing statistics pertaining to a JREAP Link 16 network.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:GatewayNativeStatisticsPET">
				<xs:sequence>
					<xs:element name="AvailableTN_Count" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>The number of Track Numbers the interface has been allocated but have not been assigned to tracks.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TotalTN_Count" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>The total number of Track Numbers assigned to the interface.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RetryTime" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>JREAP T_RETRY. The delay before retransmitting a message. Applies only to networks that use guaranteed delivery.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SessionStatus" type="uci:TCP_SessionStatusEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Status of a TCP connection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommonTimeReference" type="uci:JREAP_CommonTimeReferenceType">
						<xs:annotation>
							<xs:documentation>State and value of the JREAP Common Time Reference (CTR).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AverageReceivedLatency" type="uci:DurationType">
						<xs:annotation>
							<xs:documentation>Average latency in messages received on JREAP.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LastReceivedActivityTime" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>The last time JREAP data was received.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="KilobytesReceived" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Total count of kilobytes received over the link.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="KilobytesSent" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Total count of kilobytes sent over the link.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DataMessagesReceived" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Total count of data messages (e.g. J-series messages) received over the link.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DataMessagesSent" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Total count of data messages (e.g. J-series messages) sent over the link.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="KinematicsChoiceType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>Indicates the kinematics expressed in one of several different kinematics standards.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="VolumeKinematics" type="uci:OpVolumeKinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in one of several kinematics frames/standards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalKinematics" type="uci:OrbitalKinematicsChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in one of several orbital kinematics frames/standards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LocalBodyPosition" type="uci:RTN_LocalPositionType">
				<xs:annotation>
					<xs:documentation>Describes the kinematics position and orientation in the Radial-Transverse-Normal reference frame with respect to an asset. For example the position and attitude of a sensor relative to a host satellite's body frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="KinematicsFixedPositionType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FixedPoint" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>For moving entities, it is highly recommended that the time data be populated.  Generally, services are encouraged to send altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides an estimate of position uncertainty.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="KinematicsFixedType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:KinematicsFixedPositionType">
				<xs:annotation>
					<xs:documentation>Indicates a geospatial kinematic position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A vector indicating the current or last known velocity of the Entity.  Since Velocity3D_Type is an extension of Velocity2D_Type, it can optionally be used here.  Generally, services are encouraged to send 3D velocity whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionAndVelocityCovariance" type="uci:PositionAndVelocityCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of position and optionally velocity.  Position and velocity covariance are symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationCovariance" type="uci:OrientationCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of orientation angle.  Radian covariance is symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="KinematicsMultiStandardType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Provides a choice of ways to express kinematics in one of several orbital kinematics frames/standards.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Orbital" type="uci:OrbitalKinematicsChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed in one of several orbital kinematics frames/standards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WGS" type="uci:KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates kinematics expressed according to the World Geodetic System (WGS) frame/standard.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeltaOrbitalPlaneTolerance" type="uci:AngleHalfPairType">
				<xs:annotation>
					<xs:documentation>Indicates the orbital solution to achieve the task must be within the defined relative plane angles min and max.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="KinematicsOptionsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Option to implicitly or explicitly provide the kinematics of an Entity or System.

This allows the option to override kinematics information for a known system/entity when there is no known kinematics information or the information is not appropriate (e.g. outdated) by the time of use.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ReferenceAsset" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the object for which the reference frame of the sibling elements are referenced.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KinematicsOverride" type="uci:KinematicsMultiStandardType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the object for which the reference frame of the sibling elements are referenced.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="KinematicsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="KinematicsTimeStamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the kinematic data is valid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Position" type="uci:EntityPositionType">
				<xs:annotation>
					<xs:documentation>This element indicates the current or last known location of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity2D_UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A vector indicating the current or last known velocity of the Entity.  Generally, services are encouraged to send down velocity whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the current or last known velocity of the Entity. Services are encouraged to provide acceleration whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StateCovariance" type="uci:StateCovarianceNED_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of position and optionally velocity.  Position and velocity covariance are symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationCovariance" type="uci:OrientationCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of orientation angle.  Radian covariance is symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_AnalysisType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LAR_EntranceTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time the System will be inside the LAR. If the System is inside the LAR then this time will be in the past.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistanceToEnterLAR" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the distance the System must fly until it's within the LAR. This could be distance along a route or straight line distance depending on the weapon Capabilities.  Zero if inside LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_ExitTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time the System will exit the LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DistanceToExitLAR" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the distance the System must fly until it's outside of the LAR. This could be distance along a route or straight line distance depending on the weapon Capabilities.  Zero if outside LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_CalculationWindType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="WindSource" type="uci:LAR_WindSourceEnum">
				<xs:annotation>
					<xs:documentation>DYNAMIC = accepting the latest wind data reported by the host platform.

HELD = one wind data report from the host platform has been held and no new updates are being accepted.

OVERRIDE = the wind data specified by a StoreManagementCommand is being used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WindVelocity" type="uci:Velocity2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates wind velocity being used in the current dynamic LAR calculation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_DetailsType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Composite" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates a composite LAR when TRUE.  A composite LAR is a single LAR that satisfies all of the weapon-target pairs in the sibling WeaponTargetPairing.  When FALSE, indicates a separate LAR for each weapon-target pair; equivalent to a separate LAR_Request/LAR for each of them.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponTargetPairing" type="uci:WeaponTargetPairingChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the weapon-target pair or pairs of the LAR.  Weapon-target pairs can be expressed indirectly through references to DMPI* messages or directly as a "weaponeering" solution.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedReleaseConditions" type="uci:PlannedReleaseConditionsType">
				<xs:annotation>
					<xs:documentation>Specifies the release conditions for the LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponRoute" type="uci:RoutePlanReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a preplanned RoutePlan for the weapon given in the sibling WeaponTargetPairing element.  When given, the sibling WeaponTargetPairing element should only indicate a single weapon.  This element is required when the LAR_Type indicates IN_PLAN and vice-versa.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_ID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to LARs.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_MDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LAR_ID" type="uci:LAR_ID_Type">
				<xs:annotation>
					<xs:documentation>This is an ID to uniquely identify the Launch Acceptability Region (LAR).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestID" type="uci:RequestID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is required when the message is generated in response to a LAR_Request with ResultsInNativeMessage=TRUE; otherwise it is omitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the weapon Capability instance that this LAR is associated with.  Multiple instances of this element should only be given when each weapon Capability is of the same homogeneous weapon type and multiple weapon instances are being employed on a single DMPI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_Type" type="uci:LAR_RelationEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of region that is being specified.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Basis" type="uci:LAR_BasisEnum">
				<xs:annotation>
					<xs:documentation>This element describes the basis of the dataset used and/or being used for the LAR.  A LAR based on a static dataset (mission planned route, DMPIs, winds, etc.) or a snapshot in time (data at the time of a LAR_Request) is calculated once and results in a static LAR.  A LAR calculated periodically or upon changing conditions in a dynamic dataset (current vehicle position, measured wind, etc.) results in a dynamic LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeneratedByWeapon" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This element indicates if the LAR was generated using payload algorithms. An example where this would be used is when using PGMs on an aircraft that generates in the LAR during flight and uses different algorithms than the actual Capability uses to generate its LAR. There are cases where the difference between the algorithms can prevent release of the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Region" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>Indicates the actual geo-spatial launch acceptability region (LAR); a region in space where the weapon can be launched and satisfy the given constraints.  LARs are generally calculated for a specific altitude (or narrow altitude band) and release conditions; they are generally not a three dimensional volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_Details" type="uci:LAR_DetailsType">
				<xs:annotation>
					<xs:documentation>Indicates additional details describing the LAR.  If the LAR is the result of a LAR_Request, these details are an echo of it.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_MT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:LAR_MDT">
						<xs:annotation>
							<xs:documentation>This represents the characteristics that identify and describe a single Launch Acceptability Region (LAR).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_ReleaseConditionsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ValidAltitude" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether current System altitude meets LAR constraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidVelocity" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates if current System velocity meets LAR constraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidHeading" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates if current System heading meets LAR constraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeDelta" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the difference between the System's current altitude and the altitude that is acceptable for release.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocityDelta" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the difference between the System's current velocity and the velocity that is acceptable for release.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HeadingDelta" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the difference between the System's current heading and the heading that is acceptable for release.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_ReportMDT" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LAR_ID" type="uci:LAR_ID_Type">
				<xs:annotation>
					<xs:documentation>This is an ID to uniquely identify the Launch Acceptability Region (LAR) that is being reported on.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InsideLAR" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether the System is within the LAR identified by the LAR_ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_Analysis" type="uci:LAR_AnalysisType">
				<xs:annotation>
					<xs:documentation>Indicates the current System conditions associated with the In-Range LAR. If the System is within the LAR the weapon can be released against the Designated/Desired Mean Point of Impact (DMPI) without being restricted by impact parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReleaseConditions" type="uci:LAR_ReleaseConditionsType">
				<xs:annotation>
					<xs:documentation>Specifies the current System conditions related to those of the planned LAR.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LAR_ReportMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:LAR_ReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_RequestMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>The ID of the system to perform the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResultsInNativeMessage" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>If TRUE this element specifies that the response to this message should be a LAR message. If FALSE the LAR data that is generated should be bundled inside the response.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LAR_Type" type="uci:LAR_RelationEnum" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates a requested type of LAR.  If multiple instances are given, a separate LAR for each is expected.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LAR_Details" type="uci:LAR_DetailsType">
						<xs:annotation>
							<xs:documentation>Indicates the complete kinematic details of the requested Launch Acceptability Region (LAR).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_RequestMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:LAR_RequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_RequestStatusMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="LaunchAcceptabilityRegion" type="uci:LAR_MDT" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element defines the response to a LAR assessment request.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LAR_RequestStatusMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:LAR_RequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LaunchObjectID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to a launch object.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LaunchObjectType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes the observable, identifying characteristics for a launch object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LaunchObjectID" type="uci:LaunchObjectID_Type">
				<xs:annotation>
					<xs:documentation>The unique identifier of the launch object detected, based on the source reporting this object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedLaunchStage" type="uci:LaunchStageConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The stage of launch to which the object is associated and the associated confidence percentage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The unique identifier of the Entity that relates to this launch object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObservationMeasurementReportID" type="uci:ObservationMeasurementReportID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The unique identifier of the Observation Measurement Report that relates to this launch object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FlightStage" type="uci:FlightStageEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates what stage of flight the object is in at the time of observation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LaunchObservationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to LaunchObservation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LaunchObservationMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="LaunchObservationID" type="uci:LaunchObservationID_Type">
						<xs:annotation>
							<xs:documentation>The unique identifier for this launch observation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InitialCreateTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time and date at which the observation was initially created.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LastUpdateTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time and date at which this observation was last updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="StaticLaunchCharacteristics" type="uci:LaunchStaticDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Describes details about the launch that remain static during the launch event.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LaunchObject" type="uci:LaunchObjectType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Provides the details of the launch object and applicable dynamic launch characteristics. For every launch stage throughout the launch event, there should only be one corresponding launch stage field.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Source" type="uci:SourceFiltersType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the source that produced the sibling launch details. Note that this source might be different than the source that produced the Entity/Entities. There could be multiple sources that provided the sibling information, including from sensor data and/or from a fusion service.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RelatedLaunchObservationID" type="uci:LaunchObservationID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The unique identifier for a related launch observation.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LaunchObservationMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:LaunchObservationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LaunchStageConfidenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes the launch stage of the launch object along with the confidence percentage.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LaunchStage" type="uci:BytePositiveType">
				<xs:annotation>
					<xs:documentation>The stage of launch to which the object is associated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the confidence in the Launch Stage to which the object is associated. Higher percentages indicate greater confidence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LaunchStaticDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes static characteristics of a launch instance that remain constant over the duration of the launch.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LaunchTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time/date of launch. This may be the result of backwards propagation from the position of the first observable object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchSite" type="uci:EOB_SiteIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the physical launch site that the vehicle was launched from.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchLocation" type="uci:Point2D_ReportedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the observed location of the launch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchAzimuth" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The observed azimuth of the launch, in radians. Launch azimuth is defined as the launch direction, measured clockwise from zero degrees north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchOpPointID" type="uci:OpPointID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element indicates the unique identifier of the operational point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceLaunchedFrom" type="uci:AssetType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the source that launched the tracked object. This could be the facility where the launch occurred or the equipment that launched the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainLaunchedFrom" type="uci:EnvironmentEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the domain that the tracked Entity was launched in. This represents the domain at t=0 of launch.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Level2Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResponseEnabled" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Enable Level 2 Response to an Interrogation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SquitterEnabled" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether Squitter is  enabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LineDataStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the state of the line data within the pump by providing pressure, temperature, flow rate, and/or flow direction.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ComponentDetailedStatusType">
				<xs:sequence>
					<xs:element name="PressureData" type="uci:ComponentPressureType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates current hydraulic pressure in kiloPascal.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TemperatureData" type="uci:ComponentTemperatureType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the hydraulic temperature.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FlowRate" type="xs:double" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the hydraulic flow rate in liters per minute (lpm).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Direction" type="uci:VisibleString64Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the hydraulic flow direction.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IsGravityFeed" type="uci:EmptyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that this fuel line is a gravity feed line.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LineOfSightChoiceType" uci:version="001.001.001.001">
		<xs:annotation>
			<xs:documentation>Provides a choice of line of sight vector definitions.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="LOS_AzEl" type="uci:LOS_MeasurementAndUncertaintyType">
				<xs:annotation>
					<xs:documentation>LOS data provided in alternate spaces to preserve relevant data in order to propagate the track. All data should be provided in the NED reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LOS3D_Kinematics" type="uci:LOS3D_KinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates the line of sight vector and associated uncertainty relative to a reference point in terms of slant range and a unit vector.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="LinePoint2D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Choice of either relative or geospatial point representing the vertex of a line.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:Point2D_Type">
				<xs:sequence>
					<xs:element name="LeftWidth" type="uci:DistanceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the left width of the OpLine.  "Left" is in the locally level plane along the left of the Line as traversed from one sibling Point to the next.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RightWidth" type="uci:DistanceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the right width of the OpLine.  "Right" is in the locally level plane along the right of the Line as traversed from one sibling Point to the next.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LinePointChoiceType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>Choice of either relative or geospatial point representing the vertex of a line.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point" type="uci:LinePoint2D_Type" minOccurs="2" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a vertex of the line target.  Generally, services are encouraged to provide altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:LineRelativeType">
				<xs:annotation>
					<xs:documentation>Indicates a relative vertex of the line target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="LineRelativeType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Contains the relative vertices of the line with respect to a separately defined reference frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ReferenceFrameID" type="uci:ReferenceFrameID_Type">
				<xs:annotation>
					<xs:documentation>The reference frame ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionOffset" type="uci:RelativeOffset2D_Type" minOccurs="2" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A line relative to the reference frame origin of sibling ReferenceFrameID.  All points in the list are relative to the reference frame origin, i.e. none of the points is assumed to be the reference point or origin of the reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LineTargetType" uci:version="002.000.002.001">
