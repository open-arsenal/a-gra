	<xs:complexType name="OrbitObjectBreakupType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies the characteristics of an orbital object that is physically damaged, resulting in the object breaking into multiple pieces.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BreakupObject" type="uci:OrbitConflictObjectType">
				<xs:annotation>
					<xs:documentation>Indicates the characteristics of the asset that is involved in a single-object breakup.</xs:documentation>
				</xs:annotation>
			</xs:element>
