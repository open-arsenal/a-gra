				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLOR_PHOTOMETRY">
				<xs:annotation>
					<xs:documentation>Indicates a collection of synchronized measurements of amplitude vs time of target in three or more sub-bands of the visible spectrum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
