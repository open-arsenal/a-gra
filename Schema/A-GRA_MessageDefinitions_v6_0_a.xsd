					<xs:documentation>Indicates current enabled autonomous plan activation capabilities of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RoutePlanningContingencyPath" type="uci:ContingencyPathAutonomyType" minOccurs="0" maxOccurs="12">
