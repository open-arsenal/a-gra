				</xs:annotation>
			</xs:element>
			<xs:element name="MissionPlanningAutonomy" type="uci:MissionPlanningAutonomySettingType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates currently enabled autonomous mission planning capabilities of the System.</xs:documentation>
