							<xs:documentation>Defines the specific blue player vehicle by Model or EntityIdentity that the separation parameters apply to.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpecificEmitterIdentityConfidenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SpecificEmitterIdentityType">
				<xs:sequence>
					<xs:element name="Confidence" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Indicates the confidence of the declaration of the Entity's specific emitter ID.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpecificEmitterIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpecificEmitterKey" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Indicates the specific emitter instance ID of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpecificEmitterMultipleType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpecificEmitterInstance" type="uci:SpecificEmitterIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible specific emitter type instance that has been identified in association with the Emitter.  The value of the child Confidence element of all instances of this element should sum to 100%.  Specific Emitter Identification (SEI) technology passively measures emitters, and characterizes unique emitter signatures that can be used for friendly or enemy emitter identification and fingerprinting.  A SEI and this SpecificEmitter element refer to a specific physical instance of a type of emitter as given.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpecificFacilityIdentityConfidenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the confidence of the declaration of the specific facility instance's Identity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FacilityIdentification" type="uci:FacilityIdentificationType">
				<xs:annotation>
					<xs:documentation>Indicates the specific facility instance described by the particular child elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the confidence of the declaration of the Entity's specific facility ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpecificIdentityConfidenceType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the confidence of the declaration of the Entity's Identity.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SpecificIdentityType">
				<xs:sequence>
					<xs:element name="Confidence" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Indicates the confidence of the declaration of the Entity's SpecificType.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpecificIdentityType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpecificType" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "specific type" of the Entity. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUIs 804/001, 808/001, 809/001, 810/001 and 749/002 for additional details. In MIL-STD-6016, specific type indexes/values vary by environment and therefore this element is only meaningful when paired with the sibling SpecificTypeCategory element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificTypeCategory" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the MIL-STD-6016 list/category of the sibling SpecificType. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SiteType" type="uci:SiteTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the site type of a Ground Entity.  For example see MIL-STD-6016 DFI/DUI 1555/001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificTypeModel" type="uci:SpecificTypeModelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the alpha character suffix used to designate a certain version of an alpha/numeric aircraft designator.  Use of a single character indicates the MIL-STD-6016 aircraft version of sibling SpecificType; see MIL-STD-6016 DFI/DUI 1661/001 for additional details.  Use of a longer string is program dependent.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
