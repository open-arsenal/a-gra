	<xs:complexType name="StabilityCharacterizationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MinDetectableAngularRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum detectable rate of rotation desired to meet the tasking objective.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxPossibleRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>The maximum rotational rate of the object to be characterized (i.e., don't use sensors that can't assess objects that rotate beyond this rate).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AngularResolution" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angular resolution threshold needed to achieve the characterization objective.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StructuralResolution" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the required resolution threshold for the sensor to have on the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StalenessDomainMobilityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Domain" type="uci:EnvironmentEnum" minOccurs="0">
