			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DetailedKinematicsErrorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PositionPositionCovariance" type="uci:PositionPositionCovarianceType">
				<xs:annotation>
					<xs:documentation>Indicates position-position covariance in the NED coordinate system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionVelocityCovariance" type="uci:PositionVelocityCovarianceType">
				<xs:annotation>
					<xs:documentation>Indicates position-velocity covariance in the NED coordinate system.  Required when the sibling Velocity-Velocity covariance is given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocityVelocityCovariance" type="uci:VelocityVelocityCovarianceType">
				<xs:annotation>
					<xs:documentation>Indicates velocity-velocity covariance in the NED coordinate system.  Required when the sibling Position-Velocity covariance is given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationOrientationCovariance" type="uci:OrientationCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of orientation angle.  Radian covariance is symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionOrientationCovariance" type="uci:PositionOrientationCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of position orientation angle in units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocityOrientationCovariance" type="uci:VelocityOrientationCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the 1-sigma covariance of velocity orientation angle in units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DetailedKinematicsType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:PointChoice4D_Type">
				<xs:annotation>
					<xs:documentation>The geolocation as determined by the vehicle. When AirData is included, AirData.Kollsman should be used as the Kollsman value for any ALTITUDE_BAROMETRIC referenced altitudes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity3D_Type">
				<xs:annotation>
					<xs:documentation>The velocity vectors as measured by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AirData" type="uci:AirDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The air data elements as measure by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The acceleration vectors as measured by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation as determined by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WanderAngle" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle by which the Inertial Navigation System (INS) rotates the geodetic frame about the vertical axis of the North-East-Down (NED) coordinate frame to avoid the introduction of a singularity at the North pole when it is calculating vehicle location. A rotation from true North towards East is reported as a positive angle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MagneticHeading" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the heading in relationship to magnetic north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation change as measure by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationAcceleration" type="uci:OrientationAccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation change acceleration as measured by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DetailedReferenceKinematicsType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>The kinematics data for a reference frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:Point4D_Type">
				<xs:annotation>
					<xs:documentation>The geolocation as determined by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The velocity vectors as measured by the vehicle.  For ground velocity uses, set down speed component to zero.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The acceleration vectors as measured by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation as determined by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation change as measure by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationAcceleration" type="uci:OrientationAccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation change acceleration as measured by the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DetectionEnvelopeParametersType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EffectiveProbability" type="uci:PercentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The requested effective probability of detect for the generated DetectionEnvelope. Multiple elements indicates a request to generate multiple envelopes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleCentric" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Whether to generate the detection as vehicle-centric (true) or threat-centric (false). Note that these will be the same unless accounting for phenomena such as terrain occlusion.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DetectionEnvelopeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EffectiveProbability" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The effective probability of detect for this DetectionEnvelope.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DetectionRangeRing" type="uci:DetectionRangeRingType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Defines an azimuth cut in the global horizontal plane through the 3D detection envelope. Can be layered to construct the 3D detection envelope.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DetectionRangeRingType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines an azimuth cut in the global horizontal plane through the 3D detection envelope.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AltitudeOffset" type="uci:AltitudeType">
				<xs:annotation>
					<xs:documentation>Indicates altitude offset between the vehicle and the sensor for which this azimuth cut applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartAzimuth" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Inclusive value of start of the azimuth sweep for the sibling DetectionRange element. Assumed to be 0 if absent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndAzimuth" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Inclusive value of the end of the azimuth sweep for the sibling DetectionRange element. Assumed to be 2PI (360 degrees) if absent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DetectionRange" type="uci:DistanceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of detection ranges in meters which define a detection envelope. Azimuth 0 is considered to be off the nose of the aircraft. Range values are assumed to be evenly spaced between the start and end azimuth, going clockwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DigitalFunctionType" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>Identifier of a Digital Payload or a MutiFunctionArray (MFA).</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="DigitalPayloadCapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>The CapabilityID of a Digital Payload function operating within a Multi-Function Payload.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MFA_SupportCapabilityID" type="uci:SupportCapabilityID_Type">
				<xs:annotation>
					<xs:documentation>The SupportCapabilityID of a MultiFunctionArray (MFA); effectively, the "AntennaID" of the MFA.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="DigitalPayloadProcessingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DigitalPayloadProcessorID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>The UUID of one or more processing cards which are treated as a single logical processing element in an MFP (under control of a DPP Agent).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DigitalPayloadProcessorPortAndData" type="uci:DigitalPayloadProcessorPortAndDataType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The processing instance(s) and Data IO and NIC ports used on the sibling DPP by a Digital Payload.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DigitalPayloadProcessorPortAndDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataIO_InstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The index of a DataIO construct described in the DPP portion of the Shared Aperture InformationFile. The set of DataIO constructs, which may be multi-layered, describes the connection of the NetworkPort to the ProcessingInstance. If no DataIO_Instance is present, it may be because there is only one possible path from the NetworkPort to the ProcessingInstance, or because the ProcessingInstanceIndex and/or DataIOInstanceIndex are "don't care" at the time of the message, such as in the RF_ResourceAllocationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkPortIndex" type="xs:unsignedInt" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The number of the Network Interface Card/Port on the DPP, defined in the Shared Aperture Information Files. That is, if the DPP has two fiber ports for IQ data transfer, they are numbered in the MFP Information File, and the "Network Port" identifies which of the numbered fibers/ports is part of the Digital Payload Processing usage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingInstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The index of a Processing Instance described in the DPP portion of the Shared Aperture Information Files, describing an allocatable processing segment and memory combination.  If no ProcessingInstanceIndex is present, it may be because there is only one possible processor and memory combination available on the DPP card, (which may be because the DPP only supports one MFC at a time), or because the ProcessingInstanceIndex is "don't care" at the time of the message, such as in the RF_ResourceAllocationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DirectControlInterfacesType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActivationState" type="uci:InterfaceStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current/commanded availability/activation state of the sibling PlanInterface.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementType" type="uci:RequirementTaxonomyType">
				<xs:annotation>
					<xs:documentation>Indicates "Direct C2" mission control interfaces supported by the System along with their activation state.  A supported interface isn't necessarily enabled currently.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DiscreteDataLinkIdentifierType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base DataLinkIdentifierPET. This represents locally defined amplifying data used to identify discrete meanings established by an operational commander.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataLinkIdentifierPET">
				<xs:sequence>
					<xs:element name="LocalDiscreteIdentifier" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Locally defined amplifying data concerning a reported object or track with discrete meanings established by the operational commander.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The external network to which this data applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DiscreteStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This contains the current detailed status of the reporting Subsystem.  This message is for reporting subsystem unique data that cannot be reported with other messages.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DiscreteStatus" type="uci:NameValuePairType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This field contains the status of a  discrete within the system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DiscreteStatusMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This Message contains the current status of a discrete within the system that is not reported as part of another Subsystems  This message is not intended to replace the function of a Special Signal or other required hardware discrete interface, but rather should be used for reporting of the status to other Services and Subsystems.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:DiscreteStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DisposalOrbitType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Passivate" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Identifies whether the space vehicle is to be passivated upon disposal.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DisseminationByType" uci:version="000.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductType" type="uci:ProductTypeEnum">
				<xs:annotation>
					<xs:documentation>This field specifies which product type is being disseminated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element further refines the sibling ProductType by including its source.  This can be useful if a system has more than one Capability that outputs the same product type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DisseminationConstrainedSubplanType" uci:version="002.002.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DisseminationSubplanType">
				<xs:sequence>
					<xs:element name="ConstrainedSubPlanRank" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>This element provides precedence and priority ranking for each constrained subplan.  In the case that multiple subplans return true (all filters in more than one subplan are true) for a single product, this is used to determine which subplan to apply.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Filter" type="uci:ProductTypeFilterType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Filters are used to determine if the constrained subplan applies.  All of the filter criteria within a constrained subplan must be satisfied to apply the subplan.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DisseminationProductType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByReference" type="uci:ProductReferenceType">
				<xs:annotation>
					<xs:documentation>Identifies a specific product instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByType" type="uci:DisseminationByType">
				<xs:annotation>
					<xs:documentation>Specifies a product type.  This applies more to streaming products which stream continuously and are therefore classified continuously.  For example, EOIR streaming video.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="DisseminationReportType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this report applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DisseminationPlan" type="uci:DisseminationSubplanType">
				<xs:annotation>
					<xs:documentation>Indicates dissemination destination or destinations for the product or products.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DisseminationRequirementsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this requirement applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DisseminationPlan" type="uci:DisseminationSubplanType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates dissemination destination or destinations for the product or products.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DisseminationSubplanType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>This type represents the information necessary to disseminate a product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PushContents" type="uci:PushContentsEnum">
				<xs:annotation>
					<xs:documentation>This enumerated element determines what is pushed as a result of the dissemination plan: actual products or simply the information to access them.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DestinationID" type="uci:ProductDisseminationDestinationID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents a destination to which product or products of this plan should be disseminated.  When none of these elements are sent it indicates that, by default, products should not be disseminated by the source system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArchiveCommand" type="uci:ArchiveRequestType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents archive requirements/commands for the Service associated with the sibling Destination element; products disseminated to the Destination as a result of this Dissemination Subplan shall be archived as described by this element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExtensionCommand" type="uci:SourceCommandEXT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents a point of abstract extension to create SourceCommands that can't be documented in the open, unclassified UCI schema.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DistanceConstraintsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum distance to the reference point in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The maximum distance to the reference point in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DistanceResolutionSpecificationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This is used to specify the desired spatial resolution for characterization.  A volume has three axes that can be resolved, but different phenomenologies resolve along different axes and different numbers of axes (e.g., Optical imaging typically resolves in the two-dimensional plane perpendicular to the line of site, while range-Doppler imaging resolves along the range direction and the projection of the target rotational axis on the perpendicular to the range vector.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Dimension1" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>First dimension of spatial resolution. For RF range-Doppler imaging, this will be the range dimension. When the target cannot be resolved in Doppler, this may be the only dimension of resolution. For optical imaging with equal resolution in the two axes of the focal plane, the desired spatial resolution. If resolution is equal in both dimensions and the target is only resolved in two dimensions, then this will be the only resolution dimension for optical imaging. If the optical imaging resolution is not equivalent, then the desired resolution along the projection of the target velocity vector to the plane normal to the line of sight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dimension2" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Second dimension of spatial resolution. For RF range-Doppler imaging this is the projection of the target rotational axis on the perpendicular to the range vector. For optical imaging with resolution equal in both, this dimension is only used if the imaging also resolves in a third dimension (e.g., for LADAR). For optical imaging with unequal resolution, this is the desired resolution in the direction of the perpendicular to the target velocity vector onto the plane normal to the line of sight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dimension3" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Third dimension of spatial resolution. This is range for a three-dimensional optical imager.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DLZ_DataType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>This type contains the data necessary for a DLZ.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeTurnAndClose" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Launch slant range at which the weapon will intercept the target and arm its fuze, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.Target turn-and-close maneuver

RangeTurnandClose is not applicable to ballistic trajectory targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMinimum" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch slant range at which the weapon will intercept the target and arm its fuze, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeTurnAndRun" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.Target turn-and-run maneuver

RangeTurnAndRun is not applicable to ballistic trajectory targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeProbabilityOfIntercept" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMaxGuidance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with nominal energy, assuming no platform guidance or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeOptimal" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with high energy, assuming no platform guidance or weapon guidance errors for:
1.Optimal steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMaxAero" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Launch range at which the weapon will intercept the target with nominal energy, assuming no platform guidance or weapon guidance errors for:
1.Optimal steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers,

Note: ballistic trajectory velocity changes are not considered maneuvers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetClosureRate" type="uci:Velocity2D_Type">
				<xs:annotation>
					<xs:documentation>The target closure rate as a velocity in ft-per-second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetRange" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The slant range to the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponToTargetSeekerActivationRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the weapon to the target at weapon seeker activation, assuming no platform guidance errors or weapon guidance errors.
This data is only applicable to weapons with an end-game seeker.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponToTargetAutonomousRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the weapon to the target when the weapon is autonomous (does not require data link support).
This data is only applicable to weapons with a data link.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponToTargetMPRFRange" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the weapon to the target when the weapon activates its Medium Pulse Repetition Frequency mode, assuming no platform guidance errors or weapon guidance errors.
This data is only applicable to weapons with active seekers which implement a MPRF mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="A_Pole" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the shooter to the target when the weapon activates its seeker, assuming no platform or weapon guidance errors for:        1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

This data is only applicable to weapons with an end-game seeker.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="F_Pole" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the shooter to the target when the weapon intercepts/impacts the target, assuming no platform or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed), and
3.No target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="M_Pole" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The range from the shooter to the target when the weapon activates its Medium Pulse Repetition Frequency mode, assuming no platform or weapon guidance errors for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No target maneuvers

This data is only applicable to weapons with active seekers which implement a MPRF mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllowableSteeringError" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The maximum amount of steering error which will still result in a successful weapon intercept/impact with nominal energy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SteeringUnitVector" type="uci:SteeringUnitVectorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Steering unit vector and its defined coordinate frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoftAngle" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Required pitch angle to get to the maximum aero range for the missile.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DigitalManeuveringCueAngle" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The magnitude of the maximum angle the target can turn away from the platform which results in weapon intercept of the target with nominal energy, assuming an immediate employment command.  This field is valid only if RangeMaxGuidance &gt;= TargetRange &gt;= RangeTurnandRun.  This field is never greater than the magnitude of the target aspect angle.

For air platforms, this turn is in the horizontal plane defined by the north and east axes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOfIntercept" type="uci:TimeType">
				<xs:annotation>
					<xs:documentation>The time of weapon intercept/impact of the target, assuming no platform guidance or weapon errors, for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No post-launch target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeToRelease" type="uci:TimeType">
				<xs:annotation>
					<xs:documentation>The seconds time to activate for the proposed launch store type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOfActivation" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time of weapon seeker activation, assuming no platform guidance or weapon errors, for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No post-launch target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOfMPRF" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time of weapon seeker MPRF (for weapons with MPRF mode), assuming no platform guidance or weapon errors, for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No post-launch target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOfAutonomous" type="uci:TimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time of weapon being autonomous (not using data link), assuming no platform guidance or weapon errors, for:
1.Current steering
2.Current shooter kinematic conditions (e.g., altitude/airspeed)
3.No post-launch target maneuvers</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DLZ_ID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to DLZs.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DLZ_MDT" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DLZ_ID" type="uci:DLZ_ID_Type">
				<xs:annotation>
					<xs:documentation>This is an ID to uniquely identify the Dynamic Launch Zone (DLZ).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DLZ_RequestID" type="uci:RequestID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the request message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the weapon Capability instance that this DLZ is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DLZ_Type" type="uci:DLZ_RelationEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of region that is being specified.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeneratedByWeapon" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This element indicates if the DLZ was generated using payload algorithms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DLZ_Data" type="uci:DLZ_DataType">
				<xs:annotation>
					<xs:documentation>Indicates DLZ range calculations for air-to-air engagement assessments.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DLZ_MT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:DLZ_MDT">
						<xs:annotation>
							<xs:documentation>This represents the characteristics that identify and describe a single Dynamic Launch Zone (DLZ).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DLZ_RequestMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>The ID of the system to perform the processing.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResultsInNativeMessage" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>If TRUE this element specifies that the response to this message should be a DLZ message. If FALSE the DLZ data that is generated should be bundled inside the response.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DLZ_Type" type="uci:DLZ_RelationEnum" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates a requested type of DLZ.  If multiple instances are given, a separate DLZ for each is expected.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WeaponTargetPairing" type="uci:WeaponeeringTargetType">
						<xs:annotation>
							<xs:documentation>Indicates the weapon-target pair of the Dynamic Launch Zone (DLZ) expressed as a "weaponeering" solution.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DLZ_RequestMT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:DLZ_RequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DLZ_RequestStatusMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="DynamicLaunchZone" type="uci:DLZ_MDT" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element defines the response to a DLZ assessment request.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DLZ_RequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:DLZ_RequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DMPI_AchievabilityAssessmentRequestType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>The DMPI request information for an achievability assessment.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:AchievabilityAssessmentRequestPET">
				<xs:sequence>
					<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>DMPI identifier for achievability. If missing then all DMPIs are assessed.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DMPI_AchievabilityAssessmentType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>The achievability assessment information for a DMPI.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:AchievabilityAssessmentPET">
				<xs:sequence>
					<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type">
						<xs:annotation>
							<xs:documentation>The unique identifier of a DMPI.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DMPI_AllocationType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a DMPI associated with the Requirement.  This element is only applicable for kinetic weapon Requirements.  This element allows preliminary/estimated DMPIs to be associated with a Requirement and planned prior to formal/final DMPIs and DMPI_Designations being created.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_Ranking" type="uci:ComparableRankingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative ranking of DMPIs being associated to a Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a kinetic weapon Capability instance associated with the sibling DMPI.  Optional when any instance of Capability (of the Capability type inferred by the Requirement) on the allocated System will suffice.  Multiple instances of this element can be used  for Requirements with multiple kinetic weapons assigned to a single DMPI.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DMPI_BlastPairingType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the DMPI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedBlastRadius" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Distance from DMPI to be used as a Minimum Safe Distance for fratricide and collateral damage determination.  Useful if weapon doesn't match any existing entries in MIL-STD-6016, or in cases where a specific safe distance is desired, overriding any lookup MSD value associated with the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DMPI_CancelCommandMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandBaseType">
				<xs:sequence>
					<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a DMPI to be canceled.  A DMPI_CancelCommand can't complete while planning is in progress.  When planning completes, the System/Service responsible for striking the DMPI shall respond to the DMPI_CancelCommand.  Canceling a DMPI does not cancel the associated Task or sibling DMPIs.  Status of the cancellation is given in DMPI_Status.  A DMPI_CancelCommand for a DMPI that was previously planned and is currently being replanned to a new System might result in multiple DMPI_Status canceled responses, one from each of the Systems it was allocated to.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DMPI_CancelCommandMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
