	<xs:complexType name="ComponentFieldOfRegardType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FieldOfRegard" type="uci:FieldOfRegardType">
				<xs:annotation>
					<xs:documentation>Indicates the azimuth and/or elevation extent of the field of regard for the Component and optional associated near and far range of the radar capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to resource capabilities.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ComponentOrientationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Euler Angle Sequence describing the orientation or boresight of a Component in the order yaw, pitch, roll.  The angles are relative to the host System's frame of reference, centered on the System's navigational center.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Yaw" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the Component's (or its boresight) rotation about the vertical axis (the axis from top to bottom through the System) at its installation location.  By this definition, Yaw is zero when the Component is oriented in the System's forward direction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Pitch" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the Component's (or its boresight) rotation about the lateral axis (the axis from left to right through the System) at its installation location.  Pitch is zero when the Component front to back level in the System's navigational frame of reference.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Roll" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the Component's (or its boresight) rotation about the longitudinal axis (the axis from front to back through the System) at its installation location.  Roll is zero when the Component aircraft is left to right level in the System's navigational frame of reference.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentPressureType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Pressure" type="uci:PressureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the current pressure of the fuel pump.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PressureState" type="uci:PressureStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the pressure state in the fuel pump.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentResourceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SelectRF_Components" type="uci:SelectRF_ComponentResourceType">
				<xs:annotation>
					<xs:documentation>Allows the requester to identify RF aperture and payload resources, connected through an RF Distribution matrix and controlled by an RF Distribution and Control Subsystem. If AntennaResourceAndBeamConfigurations or SelectPayloadResource are not present, they are controlled by the DependentActivity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectDigitalComponents" type="uci:SelectDigitalComponentResourceType">
				<xs:annotation>
					<xs:documentation>Allows the requester to identify digital MFA and digital MFP resources, along with sample rates and network rates, connected on a digital backbone. If MFA_Address or MFP_Address are not populated, they are controlled by the DependentActivity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ComponentSettingsCommandMDT" uci:version="001.001.001.000">
