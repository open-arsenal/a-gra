							<xs:documentation>This element defines the altitude step value that was used to generate the WeatherData elements contained in this dataset. For example, if the DatasetArea defines a MinAltitude of 0 and a MaxAltitude of 20,000m, an AltitudeStep value might be 5,000m such that WeatherData would exist for every 500 meters from 0 to 20,000 meters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WeatherData" type="uci:WeatherDataType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element contains weather data for the dataset that should be used for planning purposes.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>One or more Systems to which the weather dataset apply. If omitted, the dataset applies to all Systems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
						<xs:annotation>
