					<xs:documentation>Indicates planning that was triggered manually by an operator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PlanPolicyProcessingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the extent of *Plan related approval processing to perform for the on-demand request.  See enumerate annotations for details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="APPLICABLE_PLANNING_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates on-demand approval processing should only consider the "applicable planning activity" to determine/find policies applicable to the subject *Plans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BY_RESULT">
				<xs:annotation>
					<xs:documentation>Indicates on-demand approval processing should consider the "applicable planning activity" and "by result" condition to determine/find policies applicable to the subject *Plans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BY_TRIGGER">
				<xs:annotation>
					<xs:documentation>Indicates on-demand approval processing should consider the "applicable planning activity" and "by trigger" condition to determine/find policies applicable to the subject *Plans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALL">
				<xs:annotation>
					<xs:documentation>Indicates on-demand approval processing should consider the "applicable planning activity", "by result" and "by trigger" conditions to determine/find policies applicable to the subject *Plans.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PlanSimultaneityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a System's support for *Plan simultaneity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SINGLE">
				<xs:annotation>
					<xs:documentation>Indicates support for a single *Plan that last for the duration of the associated Mission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTIPLE_SERIAL">
