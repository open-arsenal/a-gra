		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TaskPlanValidationInputsType" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlanValidationInputsBaseType">
				<xs:sequence>
					<xs:element name="PlanID" type="uci:TaskPlanID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the TaskPlan to validate.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlanPart" type="uci:TaskTypeEnum" minOccurs="0" maxOccurs="21">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts (task types) to include in TaskPlan validation.  If omitted, all Parts should be validated. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
