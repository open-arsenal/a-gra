	<xs:complexType name="RF_TransmissionType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_ThreadInstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This grouping of RF_ThreadInstanceIndexs must be of equivalent ResourceAccessPriority. This set of RF_ThreadInstances cannot represent multiple resource allocations. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. RF_ThreadInstanceIndices may be re-used after an allocation has been de-allocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResource" type="uci:AntennaAndResourceInstanceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A set of antenna resource that will be used for RF transmit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAccessPriority" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Resource Access Priority associated with this CIR. This is a positive ordinal integer value used to define arbitration priority for accesses to Shared Antenna Resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Frequency" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates finer granularity of frequency chunks that this CIR Index is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Polarization" type="uci:PolarizationControlType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Polarization of the transmission.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumTransmitERP" type="uci:DecibelType">
				<xs:annotation>
					<xs:documentation>Required if RF_Mode is Transmit. Maximum ERP of all RFTI in this CIR in dBW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BlankingLimit" type="uci:BlankingLimitType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Transmit function report of acceptable amount of blanking. Subsystems that blank are expected not to exceed the TxPercentBlankLimit allocated to their subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumReceiveSensitivity" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>It is the minimum receive sensitivity in the RFTI set. Receive sensitivity is the maximum tolerable receive input at the antenna in dBW.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentInterruptable" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percentage of the allocated percent access in which the corresponding RF Thread Instance Index can be interrupted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
