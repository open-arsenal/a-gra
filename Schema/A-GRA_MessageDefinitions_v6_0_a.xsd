					<xs:documentation>Damage that makes the path impassable. Used when describing roads or railways.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BLOCK">
				<xs:annotation>
					<xs:documentation>Damage that makes the path impassable. Used when describing tunnels or waterways.</xs:documentation>
