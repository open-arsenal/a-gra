	<xs:complexType name="SourceResolutionType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>Characterizes the resolution of the sensor.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeResolution" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range resolution of source in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeRateResolution" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range rate resolution of source meters/second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthResolution" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Azimuth angle resolution of reporting source in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationResolution" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Elevation angle resolution of reporting source in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthRateResolution" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Azimuth angle rate resolution of the reporting source in radians per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationRateResolution" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Elevation angle rate resolution of the reporting source in radians per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeY_Resolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The resolution of the sensor of the inner product of the target pointing vector with the sensor Y-axis. In the case of linear arrays, the Y-axis is the same as the orientation of the linear array. In the case of two-dimensional arrays, the Y-axis is the "Horizontal" axis, coarsely equivalent to Azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeZ_Resolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The resolution of the sensor of the inner product of the target pointing vector with the sensor Z axis. This term is only used for two-dimensional arrays. The Z-axis is the "Down" axis of the array, perpendicular to both the X-axis (boresight) and the Y-axis (horizontal), coarsely equivalent to Elevation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeY_RateResolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The resolution of the measurement of the rate of change of the inner product of the target pointing vector with the sensor Y-axis of the reporting source. In the case of linear arrays, the Y-axis is the same as the orientation of the linear array. In the case of two-dimensional arrays, the Y-axis is the "Horizontal" axis, making this coarsely equivalent to the resolution of the Azimuth rate with units of per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CosconeZ_RateResolution" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The resolution of the measurement of the rate of change of the inner product of the target pointing vector with the sensor Z axis of the reporting source. This term is only used for two-dimensional arrays. The Z-axis is the "Down" axis of the array, perpendicular to both the X-axis (boresight) and the Y-axis (horizontal), making this coarsely equivalent to the resolution of the Elevation rate with units of per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpaceObjectVisualDataType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>The polarization of the received electromagnetic waves.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AbsoluteVisualMagnitude" type="uci:VisualMagnitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Also known as the "normalized visual magnitude".  The calibrated visual magnitude scaled to the object being at some reference distance known as the assumed range-to-target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObservedVisualMagnitude" type="uci:VisualMagnitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Also known as the "apparent" or "instrument" visual magnitude.  The measured brightness of an object in visual magnitudes (Mv) at the time it was tracked.  The observed visual magnitude is the actual measured value adjusted for atmospheric extinction, sky background, and instrument sensitivity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssumedRangeToTarget" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The estimated distance to the object which was used to compute the absolute visual magnitude value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignedSolarPhaseAngle" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angular distance between the sun and the earth from the observed object (i.e., the sun-object-earth angle).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StarsFound" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Stars Found is the Number of Stars detected in the Field of View (FOV) with the detected object. This helps identify frames with clouds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StarsUsed" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Stars Used is the Number of correlated stars in the Field of View (FOV) with the detected object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SkyBackground" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Sky Background refers to the incoming light from an apparently empty part of the night sky.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrimaryExtinction" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Primary Extinction is the coefficient applied to the airmass to determine how much the observed visual magnitude has been attenuated by the atmosphere. Extinction in general is the term used in astronomy to describe the absorption and scattering of electromagnetic radiation by dust and gas between an emitting astronomical object and the observer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstrumentZero" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Instrument Zero is the difference between the instrument measured magnitudes and standard values.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherDataChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines the type that allows a choice of space weather data type: SpaceWeather message or static values.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SpaceWeatherValuesID" type="uci:SpaceWeatherID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the set of Space Weather data to be used by the atmospheric density model.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StaticValues" type="uci:SpaceWeatherParameterType">
				<xs:annotation>
					<xs:documentation>The static (non-changing) space weather values to be used by the atmospheric density model.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element defines the ID for Space Weather.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherKpApChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines the type of geomagnetic index to use: Kp or Ap.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Kp" type="uci:GeomagneticKpIndexType">
				<xs:annotation>
					<xs:documentation>Kp value of geomagnetic activity. Kp is an index of a 3-hourly range of geomagnetic measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ap" type="uci:GeomagneticApIndexType">
				<xs:annotation>
					<xs:documentation>Ap value of geomagnetic activity. Ap is derived from Kp values.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherMDT" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpaceWeatherID" type="uci:SpaceWeatherID_Type">
				<xs:annotation>
					<xs:documentation>This element defines the ID for the Space Weather record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CreationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the weather was measured, modeled or forecast.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Epoch" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Indicates the time range within which all of the sibling Weather data is applicable.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weather" type="uci:SpaceWeatherRecordType">
				<xs:annotation>
					<xs:documentation>Space Weather data collected.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherMT" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SpaceWeatherMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherParameterType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>The static (non-changing) space weather values to be used by an atmospheric density model during propagation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SolarFlux" type="uci:SolarFluxF10_7IndexType">
				<xs:annotation>
					<xs:documentation>Indicates the F10.7 solar flux value used or to be used for the purpose of propagation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AverageSolarFlux" type="uci:SolarFluxF10_7IndexType">
				<xs:annotation>
					<xs:documentation>Indicates the average F10.7 solar flux value used or to be used for the purpose of propagation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeomagneticIndex" type="uci:SpaceWeatherKpApChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the geomagnetic index to use.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpaceWeatherRecordType" uci:version="002.000.000.001">
		<xs:annotation>
			<xs:documentation>The type contains a set of Space Weather including Solar Flux, Geomagnetic Ap and Kp indices, and Solar Wind.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SolarFlux" type="uci:SolarFluxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>F10.7 solar flux is a measure of solar radiation at a wavelength of 10.7 cm used as a proxy for Extreme Ultraviolet radiation that impacts atmospheric density but cannot be directly measured at the earth's surface.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeomagneticStormAp" type="uci:GeomagneticStormApType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The Ap index is derived from the Kp index. Ap index provides a daily average level for geomagnetic activity within the Earth's magnetic field.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeomagneticStormKp" type="uci:GeomagneticStormKpType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The Kp Index is the indicator of disturbances in the Earth's magnetic field and characterize the magnitude of geomagnetic storms.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarWind" type="uci:SolarWindRecordType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Measurement of Solar Wind at an observed time. At least one optional field is expected to be populated.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpecialCodeDataLinkIdentifierType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base DataLinkIdentifierPET. This represents data used to identify a Special Code participant.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataLinkIdentifierPET">
				<xs:sequence>
					<xs:element name="SpecialCode2" type="uci:SpecialCode2Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>See simple type documentation.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SpecificBDS_RegistersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AA_Code" type="uci:AA_CodeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies which AA Codes will be interrogated for the BDS Registers in the next field. If omitted, implies all targets.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BDS_Address" type="uci:BDS_AddressType" maxOccurs="6">
				<xs:annotation>
					<xs:documentation>Used to acquire non-typical BDS Registers, such as 51, 52 or 53. Interrogator will determine if requested information is available in transponder and may reject the request or exclude the information.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SpecificBlueSeparationType" uci:version="003.000.003.000">
