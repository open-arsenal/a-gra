	<xs:complexType name="OpBaseType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>The base type containing information common to messages OpLine, OpPoint, and OpZone.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OpDescription" type="uci:OpDescriptionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A human-readable descriptive name with free text remarks.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionTraceability" type="uci:MissionTraceabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Allows the creator of this operational item to specify what the source or motivation for it originated from.  This could be ATO, ACO, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:CreationSourceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the source of the information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents a date/time interval associated with the operational item during which the item is in effect.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedTime" type="uci:TimeFunctionType" minOccurs="0" maxOccurs="12">
				<xs:annotation>
					<xs:documentation>Indicates time related events that are associated to the Op data type such as when activated or when operational. The multiplicity is limited to N-1 options where NONE is an event that has no value, thus removed from list of available options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkIdentifier" type="uci:DataLinkIdentifierPET" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>List of data link ID. Multiple data link IDs can be reported for the same network type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Priority" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field represents the priority to be considered when choosing between multiple available points.  Could be used with an Extirpation point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QualifyingTags" type="uci:QualifyingTagsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides identity qualifications to augment identification and associated processing of the OpPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One or more systems to which this item applies. If omitted, item applies to all systems (i.e., Link-16 J3.0 receipt is globally assigned).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemScheduleOverride" type="uci:SystemScheduleStateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>System-specific schedule that will override any part of the main schedule.  This allows for system-specific schedule different than main schedule.

When adding a SystemScheduleOverride, the child SystemID also must be added to the sibling SystemID list if the sibling list is not empty.

The SystemScheduleOverride is independent of time planning.  For the system, this override can be done at execution.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OpConstraintScoreType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Allows for assessment of how well a plan is predicted to accomplish the mission based on the specified operational constraint (scores).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Constraint" type="uci:OpConstraintEnum">
				<xs:annotation>
					<xs:documentation>Specifies the type of operational constraint to use as a weighting/scoring factor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Score" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the score, from 0% to 100%, for the operational constraint, where 0% represents being completely opposite of the constraint and 100% represents completely conforming to the constraint. Score in this sense means how successful the plan will be given the inputs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fidelity" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the fidelity of the model used to produce the plan score.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the assurance level of the score.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FileLocationID" type="uci:FileLocationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the file location of an associated file used for producing the plan score.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OpConstraintWeightingType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates an operational constraint that is applied during the planning process.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Constraint" type="uci:OpConstraintEnum">
				<xs:annotation>
					<xs:documentation>Specifies the type of operational constraint to use as a weighting/scoring factor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstraintType" type="uci:OpConstraintTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the extent to which the sibling Constraint influences the Plan.  See enumeration annotations for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weighting" type="uci:OpConstraintWeightingValueType">
				<xs:annotation>
					<xs:documentation>Indicates the range threshold or a discrete value that should be applied to the constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmplificationID" type="uci:FileLocationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Justification for the constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OpConstraintWeightingValueType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Allows for a sibling operational constraint to be weighted by a discrete value or range threshold.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Discrete" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Defines a specific percentage to which the operational constraint should be taken into account.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:PercentRangeType">
				<xs:annotation>
					<xs:documentation>Defines a threshold range to which the operational constraint should be taken into account.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Likelihood" type="uci:LikelihoodEnum">
				<xs:annotation>
					<xs:documentation>Defines high, medium, low values to which the operational constraint should be taken into account.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OpDescriptionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Markup for OpPoint and OpZone.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Name" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The name of this object in human-readable format.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>General remarks.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OperationalScheduleType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An operational schedule for an EOB record. The OperationalScheduleTimeSpan indicates the data range that was used to generate the Operational Schedule. The HitCountByHour indicates the number of observed collects during the indicated hour.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ObservationPeriod" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>The date range that was used to determine the operational schedule for the EOB record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpsClock" type="uci:OpsClockDayType" minOccurs="0" maxOccurs="7">
				<xs:annotation>
					<xs:documentation>The consolidated operation schedule or Ops Clock. This is a sequence per 7 days of the week with the 0-23 observed counts of an entity and what hour that count was observed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OperationsAreaDataLinkNativeFilterType" uci:version="001.000.002.000">
