				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a sensor characterization task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MultiObject" type="uci:MultiObjectType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a multi-object sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ManeuverDetection" type="uci:ManeuverDetectionType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a maneuver detection sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeploymentDetection" type="uci:DeploymentDetectionType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a deployment detection sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
