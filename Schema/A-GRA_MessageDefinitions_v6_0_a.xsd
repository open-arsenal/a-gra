	<xs:complexType name="StoreManagementReportMDT" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>This element specifies the dynamic status of the store management supporting Capability of a System.  A stores management supporting Capability is associated with other primary Capabilities that it controls such as Strike Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreManagementReportID" type="uci:StoreManagementReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the StoreManagementReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the Support Capability to be reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MasterArm" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The carriage is reporting that it has received the master arm signal from the host system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReleaseConsent" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The carriage is reporting that it has received the release consent signal from the host system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_ConstraintsEnforced" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The carriage will enforce LAR constraints on the release of a store.  If reporting false, the LAR constraints will be ignored or they do not exist.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AttitudeConstraintsEnforced" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The carriage will enforce the host system attitude constraints on releases.  If reporting false, the carriage system will ignore any safety attitude constraints on store release.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurrentStoreStation" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the store station that is currently in the "ready" state.  This can be used by ejection systems that must pre-position stores for release, or release stores in a fixed sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectedStoreType" type="uci:StoreType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the type of store that the carriage will release when the next time a valid release condition is met.  This element is not produced if a specific store has been selected for release.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LAR_CalculationWind" type="uci:LAR_CalculationWindType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the wind data being used by the store carriage to calculate the breathable LAR for the next release.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreManagementReportMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
