			<xs:documentation>Container object for the different types of OpPoint*Enums.  A separate enum applies to each of the choice types.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Emergency" type="uci:EmergencyReferencePointType">
				<xs:annotation>
					<xs:documentation>Emergency Point and associated reference types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Hazard" type="uci:Link16HazardType">
				<xs:annotation>
					<xs:documentation>Hazard Point and associated reference types.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OpPointChoiceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Choice of either relative or geospatial position of the OpPoint.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point" type="uci:OpPointPositionType">
				<xs:annotation>
					<xs:documentation>This element indicates the geospatial position of the OpPoint.  Time data is understood to be time of last position observation/measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point2D_RelativeType">
				<xs:annotation>
					<xs:documentation>The Relative position of the OpPoint.  The reference frame this is relative to is specified in a ReferenceFrames message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
