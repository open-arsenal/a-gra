					</xs:element>
					<xs:element name="OrbitGuideline" type="uci:OrbitGuidelineType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element specifies high-level orbit guidelines that were or should be used for the plan that are not specified or implied Requirements.</xs:documentation>
