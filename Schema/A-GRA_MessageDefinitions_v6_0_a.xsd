						<xs:annotation>
							<xs:documentation>Indicates a search volume around the reference object's position.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitalSurveillanceSearchType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Input parameters for an orbital surveillance search task type.</xs:documentation>
		</xs:annotation>
