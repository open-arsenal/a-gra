	<xs:simpleType name="AmbiguityOrderingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the desired ordering of possible identifications of an entity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BY_THREAT_PRIORITY">
				<xs:annotation>
