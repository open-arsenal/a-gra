			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="RequirementsTemplate" type="uci:ResponseTemplateType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of processing a Requirements template.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivatePlan" type="uci:MA_MissionPlanActivationCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of activating a specific, previously created MissionPlan or other sub-*Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenerateAlert" type="uci:MA_ResponseAlertType">
				<xs:annotation>
					<xs:documentation>Indicates a Response of generating a MissionContingencyAlert.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DoNothing" type="uci:EmptyType">
				<xs:annotation>
