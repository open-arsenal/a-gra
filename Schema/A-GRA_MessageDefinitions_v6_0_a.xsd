	<xs:complexType name="PlanningInterfacesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlanningInterfaceType">
				<xs:sequence>
					<xs:element name="PlanSimultaneity" type="uci:PlanSimultaneityEnum">
						<xs:annotation>
							<xs:documentation>Indicates how many of the *Plan indicated by the sibling PlanType can be planned simultaneously by the System.  For example, a System that supports development of multiple "what-if" RouteActivityPlans for the same Mission would indicate MULTIPLE_PARALLEL.  A System supporting development of current and future sequential RoutePlans for the same Mission would indicate MULTIPLE_SERIAL.  A System supporting development of only one RoutePlan for a Mission would indicate SINGLE.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PlanningInterfaceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
