	<xs:simpleType name="CryptoTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the first tier in the taxonomy of the Crypto Capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
