					<xs:documentation>Originating Agency's Determination Required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="X">
				<xs:annotation>
					<xs:documentation>Exempt from automatic declassification.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileHeaderClassificationAuthorityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String representing the authority used to classify the file.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
			<xs:maxLength value="2" />
			<xs:pattern value="[ODM ]{1,2}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileHeaderDowngradeStringType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String representing what classification a file may be downgraded to.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
			<xs:maxLength value="2" />
			<xs:pattern value="[SCR ]{1,2}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileNameType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element defines the file name of the stored product.  The minimum naming convention of file names is {at least one alphanumeric, underscore or dash} {dot} { at least one alphanumeric/underscore/dash or a dot}. The format supports multiple dot extensions, such as "filename.tar.bz2".  The max length value of 255 is set to be consistent with  NTFS, ext4, btrfs, and zfs restrictions.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255" />
			<xs:pattern value="[a-zA-Z0-9_-]+\.[a-zA-Z0-9_.-]+" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileTypeEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the content of the file.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACO">
				<xs:annotation>
					<xs:documentation>Indicates the product is Airspace Control Order – MIL-STD-6040 – US Message Text Format (MTF).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTDF">
				<xs:annotation>
					<xs:documentation>Indicates the product is Airspace Collection Tasking Data Format.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATO">
				<xs:annotation>
					<xs:documentation>Indicates a product containing Airspace Tasking Order – MIL-STD-6040 – US Message Text Format (MTF).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RSTA">
				<xs:annotation>
					<xs:documentation>Air Tasking Order - Reconnaissance, Surveillance, and Target Acquisition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BIT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates a file that is an output of a built-in-test (BIT).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CALIBRATION_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates a file that is an output of a calibration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAULT_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains fault records.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TEST_INSTRUMENTATION_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains a log of test instrumentation resulting from the TEST_INSTRUMENTATION Subsystem setting.  See SubsystemSettingsCommand message for further details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DATA_RECORDING_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains a log of data recording resulting from the DATA_RECORDING Subsystem setting.  See SubsystemSettingsCommand message for further details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEBUG_REPORTING_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains a log of debug data resulting from the DEBUG_REPORTING Subsystem setting.  See SubsystemSettingsCommand message for further details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBSYSTEM_STREAM_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains a log of SubsystemStream message data resulting from a Subsystem setting.  See SubsystemSettingsCommand and SubsystemStream messages for further details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UCI_NODE_CONFIGURATION_FILE">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains data required for a Service, Subsystem, Capability, Component, etc. to learn its identity as a UCI network node.  UCI node configuration data is one of several categories of data that may be needed for a given Service, Subsystem, Capability, Component, etc. to reach an operational/available state.  Other categories are INITIALIZATION_DATA, MDF and SUBSYSTEM_OFP.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIALIZATION_DATA">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains initialization data for a Service, Subsystem, Capability, Component, etc.  Initialization data is one of several categories of data that may be needed for a given Service, Subsystem, Capability, Component, etc. to reach an operational/available state.  Other categories are UCI_NODE_CONFIGURATION_FILE, MDF and SUBSYSTEM_OFP.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDF">
				<xs:annotation>
					<xs:documentation>Indicates a Mission Data File (MDF) for a Service, Subsystem, Capability and/or Component.  MDF data is one of several categories of data that may be needed for a given Service, Subsystem, Capability, Component, etc. to reach an operational/available state.  Other categories are UCI_NODE_CONFIGURATION_FILE, INITIALIZATION_DATA and SUBSYSTEM_OFP.
This can include items such as Common Route Definition (CRD) and Electronic Order of Battle (EOB) files.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBSYSTEM_OFP">
				<xs:annotation>
					<xs:documentation>Indicates a file containing a Subsystem Operational Flight Program (OFP).  SUBSYSTEM_OFP data is one of several categories of data that may be needed for a given Service, Subsystem, Capability, Component, etc. to reach an operational/available state.  Other categories are UCI_NODE_CONFIGURATION_FILE, INITIALIZATION_DATA and MDF.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHECKPOINT_FILE">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains checkpoint data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAINTENANCE_LOG">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains maintenance log data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOD">
				<xs:annotation>
					<xs:documentation>Space Operations Directive captures Joint Force Space Component Commander's (JFSCC) guidance and intent. Conveys prioritization and apportionment guidance focused on the applicable execution period.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MSP">
				<xs:annotation>
					<xs:documentation>Master Space Plan. Allocates resources to each desired effect and serves as the source to generate unit tasking and coordination within the Joint Space Tasking Order (JSTO) and Special Instructions (SPINS).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JIPTL">
				<xs:annotation>
					<xs:documentation>Joint Integrated Prioritized Target List. Highest prioritized targets of each component.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JSTO">
				<xs:annotation>
					<xs:documentation>Joint Space Tasking Order. Transmits JFSCC's guidance and priorities for a short-duration time frame, assigns tasks to meet operational objectives, and, when required, synchronizes and integrates JFSCC activities with other Combatant Command (CCMD) operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLAN_ORD">
				<xs:annotation>
					<xs:documentation>Planning Order. Planning directive providing essential planning guidance and directs the initiation of plan development before the directing authority approves a military Course of Action (COA).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OP_ORD">
				<xs:annotation>
					<xs:documentation>Operation Order. Directive issued by a commander to subordinate commanders for the purpose of effecting the coordinated execution of an operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARN_ORD">
				<xs:annotation>
					<xs:documentation>Warning Order.  Issued by the Chairman of the Joint Chiefs of Staff (CJCS), is a planning directive that initiates the development and evaluation of military COAs by a supported commander.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPLOYMENT_ORD">
				<xs:annotation>
					<xs:documentation>Deployment Order. Planning directive from SecDef, issued by the CJCS, that authorizes and directs the transfer of forces between CCMDs by reassignment or attachment. A deployment / redeployment order normally specifies the authority that the gaining Combatant Commander (CCDR) will exercise over the transferred forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALERT_ORD">
				<xs:annotation>
					<xs:documentation>Alert Order. Planning directive providing essential planning guidance and directs the initiation of plan development after the directing authority approves a military COA.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRAG_ORD">
				<xs:annotation>
					<xs:documentation>Fragmentary Order. Address specific changes to the Operation Order (OPORD) without restating complete OP_ORD.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EX_ORD">
				<xs:annotation>
					<xs:documentation>Execute Order. Directive to implement an approved military CONOPS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPINS">
				<xs:annotation>
					<xs:documentation>Special Instructions. Provide operational and tactical direction and approved operational procedures.
This can include items such as Crew Member Mission Planning Products (CMMPP).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMMANDERS_INTENT">
				<xs:annotation>
					<xs:documentation>Commanders Intent.  Succinctly describes what constitutes success for the operation. Includes the operation's purpose, key tasks, and the conditions that define the end state. Links the mission, concept of operations, and tasks to subordinate units.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBITAL_DEBRIS">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains orbital debris estimation data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAD">
				<xs:annotation>
					<xs:documentation>Computer Aided Design.  CAD file is a digital file format of an object generated and used by a CAD software. Each CAD system has its own method of describing geometry, both mathematically and structurally. CAD files hold information for these processes, as well as drafting information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINT_SCORE_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains constraint scoring data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SAIF">
				<xs:annotation>
					<xs:documentation>Indicates a file that contains Shared Aperture Information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the content of the file does not fall into any of the other categories.  Recommended for restricted use for pending change package proposals or debug purposes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FilteredUnfilteredEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates Filtered or Unfiltered.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FILTERED">
				<xs:annotation>
					<xs:documentation>Indicates a filtered condition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNFILTERED">
				<xs:annotation>
					<xs:documentation>Indicates an unfiltered condition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FIPS_ClassificationSystemType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String representing a FIPS classification.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="2" />
			<xs:maxLength value="3" />
			<xs:whiteSpace value="preserve" />
			<xs:pattern value="[A-Z ]{2}[A-Z ]?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FixedPointingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Enumeration defining the Gimbal Modes that must be explicitly commanded.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="STOW">
				<xs:annotation>
					<xs:documentation>Indicates the gimbal is to stow itself.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORWARD">
				<xs:annotation>
					<xs:documentation>Indicates the gimbal is to look directly ahead.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENVIRONMENT_SAFE">
				<xs:annotation>
					<xs:documentation>Indicates the gimbal is to look in a direction that is safe for an operation around the sensor on the ground.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FlightCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the types of Flight capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MUST_FLY">
				<xs:annotation>
					<xs:documentation>Indicates support for following a specific, "must fly" waypoint sequence.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOITER">
				<xs:annotation>
					<xs:documentation>Indicates support for loitering in a pattern at a specified location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FlightDeckStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Enumeration defining the different flight deck status values.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="READY_DECK">
				<xs:annotation>
					<xs:documentation>Deck is available for use.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FOUL_DECK">
				<xs:annotation>
					<xs:documentation>Deck has some form of clutter or fouling agent; not usable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CLOSED_DECK">
				<xs:annotation>
					<xs:documentation>Deck is not available / closed for use.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FlightStageEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the phase of flight.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates that the flight stage is unknown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOOST">
				<xs:annotation>
					<xs:documentation>Indicates the boost phase of flight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POST_BURNOUT">
				<xs:annotation>
					<xs:documentation>Indicates the post-burnout phase of flight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIDCOURSE">
				<xs:annotation>
					<xs:documentation>Indicates the midcourse phase of flight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TERMINAL">
				<xs:annotation>
					<xs:documentation>Indicates the terminal phase of flight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FMOP_Enum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the frequency modulation on pulse (FMOP) condition for a signal.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LINEAR">
				<xs:annotation>
					<xs:documentation>Indicates an attempt to measure FMOP has been made and linear FMOP was detected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONLINEAR">
				<xs:annotation>
					<xs:documentation>Indicates an attempt to measure FMOP has been made and non-linear FMOP was detected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates an attempt to measure FMOP has been made and FMOP was detected but the specific type of FMOP is unknown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FocalPlaneArrayNonUniformityCorrectionOffsetEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the offset of a non-uniformity correction of a focal plane array.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ONE_POINT">
				<xs:annotation>
					<xs:documentation>Indicates an offset of one point for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TWO_POINT">
				<xs:annotation>
					<xs:documentation>Indicates an offset of two points for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="THREE_POINT">
				<xs:annotation>
					<xs:documentation>Indicates an offset of three points for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_POINT">
				<xs:annotation>
					<xs:documentation>Indicates an offset of multiple points for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FocalPlaneArrayNonUniformityCorrectionReferenceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the non-uniformity correction of a focal plane array should use an internal reference or an external reference.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INTERNAL">
				<xs:annotation>
					<xs:documentation>Indicates the use of an internal reference for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTERNAL">
				<xs:annotation>
					<xs:documentation>Indicates the use of an external reference for non-uniformity correction of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FOR_Enum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the current status of the FOR.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNCONSTRAINED">
				<xs:annotation>
					<xs:documentation>A defined region where the LOS is UNCONSTRAINED for tracking targets and cueing the LOS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARNING">
				<xs:annotation>
					<xs:documentation>WARNING is a region defined between UNCONSTRAINED and CONSTRAINED when tracking targets and cueing the LOS. This enumeration provides the ability to warn anyone using the sensor that it is close to being constrained or unusable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINED">
				<xs:annotation>
					<xs:documentation>A defined region where the LOS is partially or fully CONSTRAINED for tracking targets and cueing the LOS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrameOriginEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the origin (0, 0) of the frame.  Default is TOP_LEFT.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BOTTOM_LEFT">
				<xs:annotation>
					<xs:documentation>Bottom-left corner is the origin (0, 0) of the frame. Right and up are positive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOTTOM_RIGHT">
				<xs:annotation>
					<xs:documentation>Bottom-right corner is the origin (0, 0) of the frame. Left and up are positive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TOP_LEFT">
				<xs:annotation>
					<xs:documentation>Top-left corner is the origin (0, 0) of the frame. Right and down are positive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TOP_RIGHT">
				<xs:annotation>
					<xs:documentation>Top-right corner is the origin (0, 0) of the frame. Left and down are positive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencyAgilityPatternEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type characterizes the agility pattern driving a Signal with agile frequency modulation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SAWTOOTH">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal driven by a sawtooth pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRIANGLE">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal driven by a triangle pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINUSOID">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal driven by a sine pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RANDOM">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal driven by a seemingly random pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SLIDE">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal driven by a non-repeating, piecewise monotonically changing modulation pattern.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates an agile Signal whose agility pattern is unknown despite an attempt to characterize it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencyModulationVariationEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type characterizes the variation in frequency of a Signal, pulse-to-pulse for a pulsed signal or over time for a CW signal. The enumerated literals are not mutually exclusive to allow for the use of NDI systems with varying measurement capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="STABLE">
				<xs:annotation>
					<xs:documentation>Indicates a fixed frequency Signal with no detectable intentional modulation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_STABLE">
				<xs:annotation>
					<xs:documentation>Indicates a Signal with frequency modulation that has been identified as non-stable but can't be characterized as jitter, switched, stagger, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JITTER">
				<xs:annotation>
					<xs:documentation>Indicates a fixed frequency Signal with detectable but seemingly random frequency variation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SWITCHED">
				<xs:annotation>
					<xs:documentation>Indicates a Signal with frequency modulation that changes over time through switches between a limited set of discrete modulations.  Characteristics of the switching are given by other data elements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STAGGER">
				<xs:annotation>
					<xs:documentation>Indicates a Signal with frequency modulation that changes over time by progressing through a fixed sequence of discrete modulations, referred to as a "pattern", that repeats. Individual frequencies in the pattern are referred to as "levels".  Characteristics of the pattern and levels are given by other data elements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AGILE">
				<xs:annotation>
					<xs:documentation>Indicates a Signal with frequency modulation that changes over time through a continuous pattern.   Characteristics of the agility pattern are given by other data elements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates a Signal whose frequency modulation is unknown despite an attempt to characterize it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencyOffsetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a frequency offset in Hertz (Hz).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:double" />
	</xs:simpleType>
	<xs:simpleType name="FrequencyPatternPeriodicityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type characterizes the periodicity of a Signal's frequency modulation pattern.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PERIODIC">
				<xs:annotation>
					<xs:documentation>Indicates a Signal whose frequency pattern repeats periodically.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APERIODIC">
				<xs:annotation>
					<xs:documentation>Indicates a Signal whose frequency pattern does not repeat periodically.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencySwitchingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type characterizes the nature of the frequency values that make up the switched frequency Signal.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CONTINUOUS">
				<xs:annotation>
					<xs:documentation>Indicates the switched frequencies of a Signal are selected from a continuous set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISCRETE">
				<xs:annotation>
					<xs:documentation>Indicates the switched frequencies of a Signal are selected from a discrete, non-continuous set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencySwitchingPatternEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type characterizes the switching pattern of a Signal with switched frequency modulation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="DWELL_SCAN">
				<xs:annotation>
					<xs:documentation>Indicates a switched Signal using a limited set of discrete frequency values where switches are often synchronized with changes in other Signal parameters such as PRI and PW.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALTERNATING">
				<xs:annotation>
					<xs:documentation>Indicates a switched Signal alternating between two discrete frequency values.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RANDOM">
				<xs:annotation>
					<xs:documentation>Indicates a switched Signal using a limited set of discrete frequency where switches occur in a seemingly random order.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FrequencyType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a (positive) frequency in Hertz (Hz).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="uci:DoublePositiveType" />
	</xs:simpleType>
	<xs:simpleType name="FuelFlowModeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the setting of the fuel flow mode.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AUTO">
				<xs:annotation>
					<xs:documentation>Specifies that the fuel flow will be automatically set.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVERRIDE">
				<xs:annotation>
					<xs:documentation>Specifies that the fuel flow can be overridden.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFF">
				<xs:annotation>
					<xs:documentation>Specifies that the fuel flow mode is turned off.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FusionUpdatesEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates different ways a fusion source is allowed to contribute to fused Entities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UPDATE_ALL">
				<xs:annotation>
					<xs:documentation>Indicates that all Entity characteristics can be fused from a source.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UPDATE_KINEMATICS_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates that only kinematic information can be fused from a source.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UPDATE_NON_KINEMATICS_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates that only non-kinematic Entity data can be fused from a source.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GainControlMethodEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the Automatic Gain Control has been enabled or disabled by an external controller.  See enumerated values for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AGC_ENABLED">
				<xs:annotation>
					<xs:documentation>Indicates an automatic gain control.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AGC_DISABLED">
				<xs:annotation>
					<xs:documentation>Indicates a manual gain control.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GatewayLink16ConfigurationClassEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the data class of a Link 16 filter.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Indicates that a filter applies to Link 16 track data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE_POINT">
				<xs:annotation>
					<xs:documentation>Indicates that a filter applies to Link 16 reference point data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EW_PRODUCT">
				<xs:annotation>
					<xs:documentation>Indicates that a filter applies to Link 16 EW product data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GatewayLink16ConfigurationCompassQuadrantEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates which compass quadrant should apply to a Link 16 filter.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NORTHEAST">
				<xs:annotation>
					<xs:documentation>Indicates that the northeast side of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOUTHEAST">
				<xs:annotation>
					<xs:documentation>Indicates that the southeast side of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOUTHWEST">
				<xs:annotation>
					<xs:documentation>Indicates that the southwest side of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NORTHWEST">
				<xs:annotation>
					<xs:documentation>Indicates that the northwest side of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GatewayLink16ConfigurationSideEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the inside or outside of a geographic area should apply to a Link 16 filter.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INSIDE">
				<xs:annotation>
					<xs:documentation>Indicates that the inside of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OUTSIDE">
				<xs:annotation>
					<xs:documentation>Indicates that the outside of the designated geographic area should be filtered.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GENC_CountryNameEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies the Geopolitical Entity name to be used per GENC.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AFGHANISTAN">
				<xs:annotation>
					<xs:documentation>Afghanistan, officially the Islamic Emirate of Afghanistan, is a landlocked country at the crossroads of Central and South Asia. It is bordered by Pakistan to the east and south, Iran to the west, Turkmenistan and Uzbekistan to the north, and Tajikistan and China to the northeast.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AKROTIRI">
				<xs:annotation>
					<xs:documentation>The Sovereign Base Areas of Akrotiri and Dhekelia (SBA) is a British Overseas Territory on the island of Cyprus.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALBANIA">
				<xs:annotation>
					<xs:documentation>Albania, on Southeastern Europe's Balkan Peninsula, is a small country with Adriatic and Ionian coastlines and an interior crossed by the Albanian Alps. The country has many castles and archaeological sites. Capital Tirana centers on sprawling Skanderbeg Square, site of the National History Museum, with exhibits spanning antiquity to post-communism, and frescoed Et'hem Bey Mosque.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALGERIA">
				<xs:annotation>
					<xs:documentation>Algeria is a North African country with a Mediterranean coastline and a Saharan desert interior. Many empires have left legacies here, such as the ancient Roman ruins in seaside Tipaza. In the capital, Algiers, Ottoman landmarks like circa-1612 Ketchaoua Mosque line the hillside Casbah quarter, with its narrow alleys and stairways.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AMERICAN_SAMOA">
				<xs:annotation>
					<xs:documentation>American Samoa is a U.S. territory covering 7 South Pacific islands and atolls.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANDORRA">
				<xs:annotation>
					<xs:documentation>Andorra is a tiny, independent principality situated between France and Spain in the Pyrenees mountains. It's known for its ski resorts and a tax-haven status that encourages duty-free shopping.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANGOLA">
				<xs:annotation>
					<xs:documentation>Angola is a Southern African nation whose varied terrain encompasses tropical Atlantic beaches, a labyrinthine system of rivers and Sub-Saharan desert that extends across the border into Namibia.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANGUILLA">
				<xs:annotation>
					<xs:documentation>Anguilla, a British Overseas Territory in the Eastern Caribbean, comprises a small main island and several offshore islets. Its beaches range from long sandy stretches like Rendezvous Bay, overlooking neighboring Saint Martin island, to secluded coves reached by boat, such as at Little Bay.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTARCTICA">
				<xs:annotation>
					<xs:documentation>The Antarctic is a polar region around Earth's South Pole, opposite the Arctic region around the North Pole. The Antarctic comprises the continent of Antarctica, the Kerguelen Plateau and other island territories located on the Antarctic Plate or south of the Antarctic Convergence.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTIGUA_AND_BARBUDA">
				<xs:annotation>
					<xs:documentation>Antigua and Barbuda is an independent Commonwealth country comprising its 2 namesake islands and several smaller ones. Positioned where the Atlantic and Caribbean meet, it's known for reef-lined beaches, rainforests and resorts.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARGENTINA">
				<xs:annotation>
					<xs:documentation>Argentina, officially the Argentine Republic, is a country in the southern half of South America.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARMENIA">
				<xs:annotation>
					<xs:documentation>Armenia is a nation, and former Soviet republic, in the mountainous Caucasus region between Asia and Europe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARUBA">
				<xs:annotation>
					<xs:documentation>Aruba is an island country in the mid-south of the Caribbean Sea, about 29 kilometres north of the Venezuelan peninsula of Paraguaná and 80 kilometres northwest of Curaçao.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASHMORE_AND_CARTIER_ISLANDS">
				<xs:annotation>
					<xs:documentation>Ashmore and Cartier Islands, officially Territory of Ashmore and Cartier Islands, external territory of Australia, in the Indian Ocean.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AUSTRALIA">
				<xs:annotation>
					<xs:documentation>Australia, officially the Commonwealth of Australia, is a sovereign country comprising the mainland of the Australian continent, the island of Tasmania, and numerous smaller islands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AUSTRIA">
				<xs:annotation>
					<xs:documentation>Austria, officially the Republic of Austria, is a landlocked East Alpine country in the southern part of Central Europe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AZERBAIJAN">
				<xs:annotation>
					<xs:documentation>Azerbaijan, the nation and former Soviet republic, is bounded by the Caspian Sea and Caucasus Mountains, which span Asia and Europe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BAHAMAS">
				<xs:annotation>
					<xs:documentation>The Bahamas, known officially as the Commonwealth of The Bahamas, is a country within the Lucayan Archipelago of the West Indies in the Atlantic.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BAHRAIN">
				<xs:annotation>
					<xs:documentation>Bahrain, officially the Kingdom of Bahrain, is a country in the Persian Gulf.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BAKER_ISLAND">
				<xs:annotation>
					<xs:documentation>Baker Island is an uninhabited atoll just north of the equator in the central Pacific Ocean about 3,090 km southwest of Honolulu.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BANGLADESH">
				<xs:annotation>
					<xs:documentation>Bangladesh, to the east of India on the Bay of Bengal, is a South Asian country marked by lush greenery and many waterways.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BARBADOS">
				<xs:annotation>
					<xs:documentation>Barbados is an eastern Caribbean island and an independent British Commonwealth nation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BASSAS_DA_INDIA">
				<xs:annotation>
					<xs:documentation>An uninhabited, roughly circular French atoll that is part of the French Southern and Antarctic Lands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BELARUS">
				<xs:annotation>
					<xs:documentation>Belarus, officially the Republic of Belarus, and historically Byelorussia, is a landlocked country in Eastern Europe. It is bordered by Russia to the east and northeast, Ukraine to the south, Poland to the west, and Lithuania and Latvia to the northwest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BELGIUM">
				<xs:annotation>
					<xs:documentation>Belgium, a country in Western Europe, is known for medieval towns, Renaissance architecture and as headquarters of the European Union and NATO.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BELIZE">
				<xs:annotation>
					<xs:documentation>Belize is a nation on the eastern coast of Central America, with Caribbean Sea shorelines to the east and dense jungle to the west.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BENIN">
				<xs:annotation>
					<xs:documentation>Benin, a French-speaking West African nation, is a birthplace of the vodun (or "voodoo") religion and home to the former Dahomey Kingdom from circa 1600–1900.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BERMUDA">
				<xs:annotation>
					<xs:documentation>Bermuda is a British island territory in the North Atlantic Ocean known for its pink-sand beaches such as Elbow Beach and Horseshoe Bay.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BHUTAN">
				<xs:annotation>
					<xs:documentation>Bhutan, a Buddhist kingdom on the Himalayas' eastern edge, is known for its monasteries, fortresses (or dzongs) and dramatic landscapes that range from subtropical plains to steep mountains and valleys.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOLIVIA">
				<xs:annotation>
					<xs:documentation>Bolivia is a country in central South America, with a varied terrain spanning Andes Mountains, the Atacama Desert and Amazon Basin rainforest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BONAIRE_SINT_EUSTATIUS_AND_SABA">
				<xs:annotation>
					<xs:documentation>Three special municipalities of the Netherlands that are located in the Caribbean Sea. They consist of the islands of Bonaire, Sint Eustatius and Saba,</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOSNIA_AND_HERZEGOVINA">
				<xs:annotation>
					<xs:documentation>Bosnia and Herzegovina is a country on the Balkan Peninsula in southeastern Europe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOTSWANA">
				<xs:annotation>
					<xs:documentation>Botswana, a landlocked country in Southern Africa, has a landscape defined by the Kalahari Desert and the Okavango Delta, which becomes a lush animal habitat during the seasonal floods.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOUVET_ISLAND">
				<xs:annotation>
					<xs:documentation>A Norwegian uninhabited protected nature reserve. As a subantarctic volcanic island, it is situated in the South Atlantic Ocean (54°25′S 3°22′ECoordinates: 54°25′S 3°22′E), at the southern end of the Mid-Atlantic Ridge making it the world's most remote island.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BRAZIL">
				<xs:annotation>
					<xs:documentation>Brazil, officially the Federative Republic of Brazil, is the largest country in both South America and Latin America.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BRITISH_INDIAN_OCEAN_TERRITORY">
				<xs:annotation>
					<xs:documentation>The British Indian Ocean Territory is a British Overseas Territory of the United Kingdom situated in the Indian Ocean halfway between Tanzania and Indonesia.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BRUNEI">
				<xs:annotation>
					<xs:documentation>Brunei is a tiny nation on the island of Borneo, in 2 distinct sections surrounded by Malaysia and the South China Sea.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BULGARIA">
				<xs:annotation>
					<xs:documentation>Bulgaria is a Balkan nation with diverse terrain encompassing Black Sea coastline, a mountainous interior and rivers, including the Danube.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BURKINA_FASO">
				<xs:annotation>
					<xs:documentation>Burkina Faso is a landlocked country in West Africa that covers an area of around 274,200 square kilometres and is bordered by Mali to the northwest, Niger to the northeast, Benin to the southeast, Togo and Ghana to the south, and the Ivory Coast to the southwest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BURMA">
				<xs:annotation>
					<xs:documentation>A Southeast Asian nation of more than 100 ethnic groups, bordering India, Bangladesh, China, Laos and Thailand.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BURUNDI">
				<xs:annotation>
					<xs:documentation>Burundi, officially the Republic of Burundi, is a landlocked country in the Great Rift Valley where the African Great Lakes region and East Africa converge</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CABO_VERDE">
				<xs:annotation>
					<xs:documentation>Cape Verde or Cabo Verde, officially the Republic of Cabo Verde, is an archipelago and island country in the central Atlantic Ocean, consisting of ten volcanic islands with a combined land area of about 4,033 square kilometres.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAMBODIA">
				<xs:annotation>
					<xs:documentation>Cambodia is a Southeast Asian nation whose landscape spans low-lying plains, the Mekong Delta, mountains and Gulf of Thailand coastline.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAMEROON">
				<xs:annotation>
					<xs:documentation>Cameroon, on the Gulf of Guinea, is a Central African country of varied terrain and wildlife. Its inland capital, Yaoundé, and its biggest city, the seaport Douala, are transit points to ecotourism sites as well as beach resorts like Kribi – near the Chutes de la Lobé waterfalls, which plunge directly into the sea – and Limbe, where the Limbe Wildlife Centre houses rescued primates.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CANADA">
				<xs:annotation>
					<xs:documentation>Canada is a country in North America. Its ten provinces and three territories extend from the Atlantic to the Pacific and northward into the Arctic Ocean, covering 9.98 million square kilometres, making it the world's second-largest country by total area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAYMAN_ISLANDS">
				<xs:annotation>
					<xs:documentation>The Cayman Islands, a British Overseas Territory, encompasses 3 islands in the western Caribbean Sea. Grand Cayman, the largest island, is known for its beach resorts and varied scuba diving and snorkelling sites.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
