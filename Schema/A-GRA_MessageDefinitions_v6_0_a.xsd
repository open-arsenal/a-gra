				</xs:annotation>
			</xs:element>
			<xs:element name="PathID" type="uci:PathID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Path within the RoutePlan to intercept.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteInterceptType" type="uci:MA_RouteInterceptEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specification of the method of Route intercept. If not set, will default to intercept at the beginning of the RoutePlan</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EarliestInterceptPoint" type="uci:ActivationPathSegmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Earliest PathSegment within the RoutePlan where the Route can be intercepted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LatestInterceptPoint" type="uci:ActivationPathSegmentType" minOccurs="0">
