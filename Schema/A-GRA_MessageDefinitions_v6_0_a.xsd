			<xs:element name="DwellState" type="uci:COMINT_DwellStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the state of the dwell as it whether or not it is enabled, and the reason if it is disabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellType" type="uci:COMINT_DwellTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellFOV" type="uci:NED_ConeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's field of view (FOV) details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time of the first collection for the Dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CumulativeDwellTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the cumulative collection time for the dwell, including all revisits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a component with the dwell is assigned to use.  Required if the dwell is assigned/active.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Frequency" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the frequency coverage of the dwell, including all RF_ControlCommand, ESM_Command, MDF and other restrictions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellRevisitInterval" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's revisit interval, which is how often the dwell should be repeated within the dwell strategy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthLow" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's minimum pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthHigh" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's maximum pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_High" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's maximum pulse repetition interval (PRI).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NativeSensitivity" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dwell sensitivity prior to any desensitization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Desensitization" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Desensitization if any applied to the dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoBandwidth" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the video bandwidth used for the measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COMINT_Interactive" type="uci:COMINT_InteractiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element identifies additional parameters of COMINT subsystem which may be adjusted interactively during operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StopTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies when the activity stopped making connections.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SampleRate" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Sample Rate in Hz being applied to this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FFT_PointsPerSample" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of points used for the Fast Fourier Transform processing of the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SettingsCommandMDT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="SetAmbiguityOrdering" type="uci:AmbiguityOrderingEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the commanded order in which identity ambiguity should be reported in the Capability's subsequent output messages.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to enable (TRUE) or disable (FALSE) the SpectralDensityReport.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Specifies which messages are to be output by the Capability as the result of capability commands. Note: Only values advertised in the Capability message are allowed. Any non-supported values should result in rejection of the settings command. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_SettingsCommandMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:COMINT_SettingsCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_SettingsCommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_SettingsCommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:COMINT_SettingsCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_SpecificDataType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:CapabilityInitiationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability's first tier type in the COMINT taxonomy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityType" type="uci:COMINT_SubCapabilityEnum" minOccurs="0" maxOccurs="16">
				<xs:annotation>
					<xs:documentation>Indicates a SubCapability of the COMINT Capability; the second tier in the COMINT taxonomy. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityAcquisitionType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TargetEmitterData" type="uci:COMINT_AcquisitionTargetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the source of or explicit values for emitter characteristics of the target of the Acquisition command.  If omitted, the command defers to the active MDF.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetLocationData" type="uci:COMINT_SubcapabilityTargetLocationDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the source of or explicit values for geospatial characteristics of the target of the Command.  When specified, the location data overrides any given in the sibling TargetEmitterData element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyRestriction" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific frequency to be used for the Acquisition command.  If omitted, the command defers to the active MDF.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityChoiceType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Acquisition" type="uci:COMINT_SubcapabilityAcquisitionType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Command or Task that invokes an acquisition related Subcapability of the associated Capability.  This element is required when an acquisition related Subcapability is being invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identification" type="uci:COMINT_SubcapabilityIdentificationType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Command or Task that invokes an identification related Subcapability of the associated Capability.  This element is required when an identification related Subcapability is being invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Geolocation" type="uci:COMINT_SubcapabilityGeolocationType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Command or Task that invokes a geolocation related Subcapability of the associated Capability.  This element is required when a geolocation related Subcapability is being invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Measurement" type="uci:COMINT_SubcapabilityMeasurementType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Command or Task that invokes a measurement related Subcapability of the associated Capability.  This element is required when a measurement related Subcapability is being invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Data_Collect" type="uci:COMINT_SubcapabilityDataCollectType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Command or Task that invokes a pulse data collection related Subcapability of the associated Capability.  This element is required when a pulse data collection related Subcapability is being invoked.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityDataCollectType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Collection" type="uci:COMINT_DataCollectCommandType">
				<xs:annotation>
					<xs:documentation>This required structure contains the collection information details for the commanded data collection.  These parameters apply to all related dwells for the Activity launched by this Command, and can be edited by using subsequent commands against the activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Target" type="uci:COMINT_SubcapabilityTargetLocationDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This required structure contains the target information details for the commanded pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubCapabilityDetailsType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Acquisition" type="uci:COMINT_AcquisitionTargetType">
				<xs:annotation>
					<xs:documentation>Indicates a target the Activity is attempting to acquire.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectionFinding" type="uci:COMINT_DirectionFindingType">
				<xs:annotation>
					<xs:documentation>Indicates a target the Activity is attempting to determine its bearing or angle of arrival.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identification" type="uci:COMINT_IdentificationType">
				<xs:annotation>
					<xs:documentation>Indicates a target the Activity is attempting to determine its identification.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Geolocation" type="uci:COMINT_GeolocationType">
				<xs:annotation>
					<xs:documentation>Indicates a target the Activity is attempting to determine its location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Measurement" type="uci:COMINT_MeasurementType">
				<xs:annotation>
					<xs:documentation>Indicates a target the Activity is attempting to determine a finer measurement of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityGeolocationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Entity which the Geolocation ECommand is targeted on.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeolocationState" type="uci:SignalGeolocationControlEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current state of the ECommand for Geolocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeolocationType" type="uci:SignalGeolocationMethodEnum" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a commanded geolocation type/technique to use. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityIdentificationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Entity which the Identification Command was initiated against.  If commanded against an Entity from the Subsystem, this Entity will also give the identity results and match the ID in the Results element.  If commanded against an Entity not from the Subsystem there will be two Entities with different IDs.  Additionally, upon successful completion, the Identification results are given in the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityMeasurementType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Entity which the Measurement Activity is targeted on.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_SubcapabilityTargetLocationDataType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the EntityID associated with the pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellFOV" type="uci:NED_ConeType">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's Field of View details associated with the pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointTarget" type="uci:PointTargetType">
				<xs:annotation>
					<xs:documentation>Indicates the Point Target details associated with the pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="COMINT_TargetType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific Entity that is a target of the acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterType" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a type of emitter that is a target of the acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter type ***instance*** that is a target of the acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalDescription" type="uci:SignalSummaryType">
				<xs:annotation>
					<xs:documentation>Indicates summary signal characteristics that are a target of the acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific Signal that is a target of the acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetClass" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Supplements the DwellTarget identification with more general classes of signals to be looked for, such as "CW".</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="COMINT_TaskBaseType" uci:version="000.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubCapabilityType" type="uci:COMINT_SubCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates a specific SubCapability being requested by the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Output" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Task.  See ProductTypeEnum for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_TaskType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:COMINT_TaskBaseType">
				<xs:sequence>
					<xs:element name="SubCapabilityDetails" type="uci:COMINT_SubcapabilityChoiceType">
						<xs:annotation>
							<xs:documentation>Indicates Command details for a Subcapability of the Capability indicated by the sibling CapabilityID.  One instance of this element for each Subcapability category (acquisition, ID, geolocation, measurement or pulse data collection) of that Capability is required.  If multiple instances are given, each must be of a different category in the descendant choice statement.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommActionExtendedType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommActionType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommActionType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ConfigurationID" type="uci:CommConfigurationID_Type">
				<xs:annotation>
					<xs:documentation>Represents the ID for a specific configuration for a communication or gateway configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfigurationState" type="uci:CommConfigurationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether an instance of a Configuration is new or an update to an existing configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemCommand" type="uci:SubsystemCommandType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Perform a command on the subsystem as a whole.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommCapability" type="uci:CommCapabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to deactivate the current Mission Data File and activate the MDF given by this element.  If the referenced MDF is already active, then this element indicates a command to activate a new file within one or more subcategories of the current MDF. An MDF is the primary source of configurations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommAllocationActionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommAllocationID" type="uci:CommScheduleAllocationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the CommAllocation which the sibling CommAllocationTransition is applicable to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommAllocationTransition" type="uci:CommAllocationTransitionEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the CommAllocation should be activated or deactivated for the Action.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommAllocationConstraintType" uci:version="001.000.001.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocationID" type="uci:CommScheduleAllocationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the CommScheduleAllocation being referenced.  When omitted, the current/active CommScheduleAllocation for the System is implied.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeableAllocation" type="uci:PlanChangeableConstraintsEnum">
				<xs:annotation>
					<xs:documentation>Indicates which kinds/categories of kinematic segments in the CommScheduleAllocation indicated by the sibling AllocationID are considered changeable.  The exact definition of "changeable" is left to particular Services and/or Systems to develop according to their requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parts" type="uci:CommCapabilityEnum" minOccurs="0" maxOccurs="53">
				<xs:annotation>
					<xs:documentation>Indicates a kind of communications network/data link/system in the CommScheduleAllocation plan referenced by the sibling AllocationID element to be used as a constraint when creating the commanded *Plan.    If any are given, only those parts are constraints.  If omitted, all parts should be used. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommAllocationPartsType" uci:version="001.000.001.002">
