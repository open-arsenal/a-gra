		</xs:annotation>
		<xs:choice>
			<xs:element name="Equals" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Tests if the length of the sequence formed by the specified Step is equal to this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LessThan" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Tests if the length of the sequence formed by the specified Step is less than this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LessThanOrEqualTo" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Tests if the length of the sequence formed by the specified Step is less than or equal to this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GreaterThan" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Tests if the length of the sequence formed by the specified Step is greater than this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GreaterThanOrEqualTo" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Tests if the length of the sequence formed by the specified Step is greater than or equal to this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="QueryDataRequestMDT" uci:version="003.002.003.000">
		<xs:annotation>
