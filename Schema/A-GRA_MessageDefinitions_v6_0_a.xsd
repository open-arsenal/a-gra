		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.  If not present, then the current context is evaluated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Value" type="uci:AtomicValueType">
				<xs:annotation>
					<xs:documentation>Value tested for equality.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryExistsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Tests if the sequence formed by the Step has at least one node.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.  The Step field must be present due to the fact that the current context always exists.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryInstanceOfType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Tests if any node in the sequence formed by the specified Step is or derives from the specified Type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Step" type="uci:QueryStepType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sequential list of Steps that forms the sequence that is the context of this operation.  If not present, then the current context is evaluated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Type" type="uci:NamedElementType">
				<xs:annotation>
					<xs:documentation>The name of the type as it appears in the schema.</xs:documentation>
