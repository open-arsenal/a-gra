	<xs:complexType name="ESM_SpecificDataType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityType" type="uci:CapabilityInitiationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Capability's first tier type in the ESM taxonomy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityType" type="uci:ESM_SubCapabilityEnum" minOccurs="0" maxOccurs="12">
				<xs:annotation>
					<xs:documentation>Indicates a SubCapability of the ESM Capability; the second tier in the ESM taxonomy. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_SubcapabilityGeolocationType" uci:version="000.000.000.000">
