				</xs:annotation>
			</xs:element>
			<xs:element name="Query" type="uci:QueryPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The query used to select the messages or IDs that are returned by the corresponding status.  If not present, then the operation should return the Message types specified by the MessageType field, or all messages if no MessageType is specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryPaginationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CurrentPage" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the page number (one of multiple instances of QueryDataRequestStatus for the same RequestID) of the query results given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TotalPages" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the total number of pages (QueryDataRequestStatus messages with the same RequestID) which the query results have been broken into.  The value given in this element should be constant for a given paginated query result.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QueryPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The polymorphic extension point of all queries.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="QueryResultType" uci:version="001.000.001.000">
