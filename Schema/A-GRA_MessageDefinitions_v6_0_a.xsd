	<xs:complexType name="CommCoverageDataType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommDataType">
				<xs:annotation>
					<xs:documentation>Indicates the actual type of external communication resource being requested.</xs:documentation>
				</xs:annotation>
				<xs:sequence>
					<xs:element name="TimeCoverage" type="uci:TimeCoverageType">
						<xs:annotation>
							<xs:documentation>A list of times that are being requested for the given communication resource.  A coverage area may or may not need to be specified based on the specific communication system or resource being scheduled.  In many cases, if a specific antenna is being scheduled, the coverage area is implicitly defined already.  For mobile communication assets or communication systems scheduled by system, the coverage area may need to be provided to ensure communications availability in that area during the time period in which it is required.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommCoverageUserDataType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommCoverageDataType">
				<xs:sequence>
					<xs:element name="CommUserIdentifier" type="uci:VisibleString256Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the specific User ID for the communication system that is being used if applicable.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommDataType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Resource" type="uci:CommResourceType">
				<xs:annotation>
					<xs:documentation>Indicates the specific communication resource that this data is in reference to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommType" type="uci:CommCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of communication signal/system of the communication resource.  Reference the enumeration values for a list of the various communication signals/systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UplinkDataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the data rate of the communication resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UplinkFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the uplink frequency in Hz of the allocated communication resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownlinkDataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the data rate of the allocated communication resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownlinkFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the downlink frequency in Hz of the allocated communication resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommSpecificData" type="uci:CommSpecificRequestDataEXT" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Since different systems will require different information to support communication resources and at different security levels, this serves as an extension point to be used by an accompanied schema to provide actual details if necessary.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommEffectivityID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type that refers to an aggregation of effective communications configurations.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommEffectivityType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>For a communication plan, this is the collection of Triggers and the communication plan settings to be applied upon these triggers.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EffectivityID" type="uci:CommEffectivityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this effectivity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedCommAction" type="uci:PlannedCommActionExtendedType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a list of communication actions/settings to be applied upon the supplied triggers to support a communication plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Trigger" type="uci:CommTerminalPlanTriggerType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Signifies available triggers which would automatically invoke this CommTerminalPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommFrequencyType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommType" type="uci:CommType">
				<xs:annotation>
					<xs:documentation>Indicates the type of communication signal/system of the communication resource.  Reference the enumeration values for a list of the various communication signals/systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UplinkFrequencyRange" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range of uplink frequencies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownlinkFrequencyRange" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range of downlink frequencies.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16AdvancedSlotNotificationType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Contains the Advanced Slot Notification for both modes. Indicates Advanced Slot Notification (ASN) Mode Selection (MS) of Mode A (1) or Mode B (0), ASN Enabled (1) or Disabled (0) and the ASN Slot Selection (0..31, the default is 7).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ASN_SlotMode" type="uci:CommLink16_AdvanceSlotNotificationModeEnum">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 Advanced Slot Notification Mode. Used to switch between Mode B and Mode A. It is used with ASN slot selection which indicates the number of time slots for the selected Mode. Mode A – signal with one time slot that identifies all transmit slots (exception- voice transmit slots when push-to-Talk not active.  Mode B-same as Mode A but the signal remains high until the end of the transmit slot.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ASN_SlotModeEnabled" type="xs:boolean" default="false">
				<xs:annotation>
					<xs:documentation>Denotes whether ASN is enabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ASN_SlotSelection" type="uci:Link16_SlotSelectionType" default="7">
				<xs:annotation>
					<xs:documentation>Denotes the ASN slot which is selected. Must be between 0 and 31, default is 7.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16CommWaveformActivityCommandType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base CommWaveformActivityCommandPET for communication Link16 parameters.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommWaveformActivityCommandPET">
				<xs:sequence>
					<xs:element name="SettingsChange" type="uci:CommLink16ControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Link-16-specific tuning settings of the communications capability, such as the net selection status, platform strength, and transmit/receive antennas.  See the element annotations of CommLink16ControlType for a complete list of settings and details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommLink16CommWaveformActivityType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base CommWaveformActivityPET for communication Link16 parameters.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommWaveformActivityPET">
				<xs:sequence>
					<xs:element name="SettingsStatus" type="uci:CommLink16ControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Link-16-specific tuning settings of the communications capability, such as the net selection status, platform strength, and transmit/receive antennas.  See the element annotations of CommLink16ControlType for a complete list of settings and details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PPLI_MsgGenPPLI_PG" type="uci:Link16_ParticipationGroupIndexType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>A 3 bit field where each bit indicates the validity check status of the corresponding PPLI transmit time slot assignments of the Current Initialization Data File received in the last initialization data load.  Logic 1 = Validity check fail,  Logic 0 = Validity check OK.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PPLI_MsgGenTxRate" type="uci:Link16_MessageGenerationRateType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>A 3 bit field where each bit indicates the validity check status of the corresponding TRANSMISSION RATE of the Current Initialization Data File received in the last initialization data load. Logic 1 = Validity check fail for PPLI transmission,  Logic 0 = Validity check OK.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommLink16CommWaveformCapabilityCommandType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base CommWaveformCapabilityCommandPET for communication Link16 parameters.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommWaveformCapabilityCommandPET">
				<xs:sequence>
					<xs:element name="Settings" type="uci:CommLink16ControlType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Link-16-specific tuning settings of the communications capability, such as the net selection status, platform strength, and transmit/receive antennas.  See the element annotations of CommLink16ControlType for a complete list of settings and details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommLink16ControlType" uci:version="001.001.000.002">
		<xs:annotation>
			<xs:documentation>Utilized to perform Link 16 Specific tuning of a communications capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AdvancedSlotNotificationMode" type="uci:CommLink16AdvancedSlotNotificationType" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Contains the Advanced Slot Notification for both modes. Indicates Advanced Slot Notification (ASN) Mode Selection (MS) of Mode A (1) or Mode B (0), ASN Enabled (1) or Disabled (0) and the ASN Slot Selection (0..31, the default is 7).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataReductionPG_Index" type="uci:Link16_ParticipationGroupIndexType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Data Reduction Participation Group (PG) Index Number as part of the Link-16-specific tuning settings of the communications capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DelayReduction" type="uci:CommLink16DelayReductionType" minOccurs="0" maxOccurs="3">
				<xs:annotation>
					<xs:documentation>The Delay Reduction Participation Group (PG) Index Number specifies which message or messages are subject to Delay Reduction. List sizing based on MIDS Network Terminal Standardization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EnhancedThroughputCodeRate" type="uci:CommLink16EnhancedThroughputCodeRateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 Enhanced Throughput Code Rate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialEntryGroup" type="uci:CommLink16InitialEntryGroupEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 Initial Entry Group Messages. This is used to indicate that the transmit function is enabled for Link 16 Initial Entry message only or Link 16 and Interim JTIDS initial entry messages on alternating transmit frames.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialEntryMessageAssignment" type="uci:CommLink16InitialEntryMessageType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates which Time Slot Assignments, defined in the received initial entry messages, are to be used upon passing all current validity checks.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialEntryWords" type="xs:int" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The Initial Entry Message send 10 words in Bit Words 580-589.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitializationActivityIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the initialization data set is the active set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitializationIndexNumber" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the initialization data set (0..255, default 0 indicates no statement).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterferenceProtectionMode" type="uci:CommLink16InterferenceProtModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 Interference Protection Mode. Used to set the interference protection adaptation feature.  The options for Interference protection are Full EMC Protection 100/50, Exercise EMC Protection, Combat EMC Protection, Full EMC Protection 100/20.  Transiting between the states may invoke a system restart.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionInformationWords" type="uci:CommLink16MissionInfoWordsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Missions track numbers including for correlation, wingman, and Mission CDR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetSelectionStatus" type="uci:CommLink16NetSelectionType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Used to set / identify the net selection per PG Index. List sizing based on MIDS Network Terminal Standardization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetEntryTxEnable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Enables/disables transmission of the initial entry message. 0 = Do not transmit, 1 = transmit. The selection is N/A if the terminal is the NTR or an active Main Net Relay.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformStrength" type="uci:Link16_PlatformStrengthType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of units represented by a single track. Range = 0 to 15 where 0 = NoStatement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PPLI_Pool" type="uci:CommLink16_PPLI_PoolEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 PPLI Pool. This defines whether the PPLI and Status pool selection is set to Pool (A+B) or Pool B.  This is used to filter which terminals see other terminals location information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeMode" type="uci:CommLink16RangeModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>TDMA range mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RouteEstPG_Index" type="uci:Link16_ParticipationGroupIndexType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The PG index number on which the route establishment message will be transmitted.  Range 0-511, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SecondarySourceTrackNumber" type="uci:Link16_TrackNumberType" minOccurs="0" maxOccurs="16">
				<xs:annotation>
					<xs:documentation>Up to 15 Secondary TNs used for forwarding. One location is reserved for the Net Manager Indicator. List sizing based on MIDS Network Terminal Standardization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitPG_Slots" type="uci:CommLink16TxPG_Type" minOccurs="0" maxOccurs="10">
				<xs:annotation>
					<xs:documentation>Allows the host to set a specific power level, packing limit, antenna configuration, staleness, and storage limit for a specific PG. List sizing based on MIDS Network Terminal Standardization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitAntenna" type="uci:CommLink16TransmitAntennaEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to indicate the Link 16 Transmit Antenna Mode. When a platform is using more than one antenna port the Global Transmit Antenna parameter must be set to Mixed which enables the use of this field.   This field when used to indicate if the system is transmitting for both antenna ports, just Antenna port A, just Antenna port B or is not used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiptComplianceProcessingWords" type="uci:CommLink16ReceiptComplianceWordsType" minOccurs="0" maxOccurs="3">
				<xs:annotation>
					<xs:documentation>Used to indicate whether the terminal will perform receipt compliance (R/C) processing on an original message provided by the Host. List sizing based on MIDS Network Terminal Standardization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiveAntenna" type="uci:CommLink16TransmitAntennaEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>When a platform is using more than one antenna port the Global Receive Antenna parameter must be set to Mixed, then this parameter defines the receive antenna configuration.   This field when used to indicate if the system is receiving for both antenna ports, just Antenna port A, just Antenna port B or is not used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitPowerSelection" type="uci:CommLink16TxPowerSelectionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is an adaptable parameter that is used to set output power for each participant group that has a transmit time slot.  The options for this parameter are normal power, low power, medium power, high power (HPA), and low power (HPA).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransmitMode" type="uci:CommLink16TransmitModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is an adaptable parameter that will not be used when the terminal is in a long term transmission inhibit or a Terminal State of TACAN only.  Allowable modes include Normal, Polling, TDMA Silent, Conditional Radio Silence, Not Used and Reserved.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceGroupRate" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the Voice Group Rate Frequency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceGroupCoding" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents whether the voice group is encoded.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceTellIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Allows Comm Manager to command a force tell indicator to a Link-16 terminal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResetNavKalmanFilter" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Allows Comm Manager to command a Kalman filter reset to a Link-16 terminal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IPF_Reset" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Clears an Interference Protection Fault (IPF) in the radio; clears the Capability to Transmit (CTT) waveform setting so the radio will attempt to transmit again. When set to TRUE, a reset command is issued.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceCallSign" type="uci:VisibleString20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This type contains the connection data needed to communicate with a vehicle using Link16 voice radios.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16DelayReductionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The Delay Reduction Participation Group (PG) Index Number specifies which message or messages are subject to Delay Reduction.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UseMIDS_DelayReduction" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>All VAL bits shall be set to Label/Sublabel Not Valid when a Host doesn't use MIDS Delay Reduction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageLabel" type="uci:Link16_MessageLabelType">
				<xs:annotation>
					<xs:documentation>J-Message Label.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Link16_MessageSubLabelType" type="uci:Link16_MessageSubLabelType">
				<xs:annotation>
					<xs:documentation>J-Message Sub-Label.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16InitialEntryMessageType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates which Time Slot Assignments, defined in the received initial entry messages, are to be used upon passing all current validity checks.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ControlTimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether Control Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PPLIA_TimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether PPLI-A Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PPLIB_TimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether PPLI-B Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RTTB_TimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether Round Trip Timing Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceA_TimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether Voice A Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceBTimeSlotInhibit" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether Voice B Time Slots should be used or not used/inhibited.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16MissionInfoWordsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to control the Link 16 Mission Information Words.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NonC2_PGA_NetNumber" type="uci:Link16_NetNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provided by a non-C2 platform to inform other JUs of the net numbers on which the source TN is assigned to operate.  Used by air platforms only.  It is inserted in the J2.2I word, bits 53-59.  Range 0-127, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonC2_PGB_NetNumber" type="uci:Link16_NetNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provided by a non-C2 platform to inform other JUs of the net numbers on which the source TN is assigned to operate.  Used by air platforms only.  It is inserted in the J2.2C5 word, bits 7-13.  Range 0-127, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonC2_PGA_Status" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provided by a non-C2 platform to inform other JUs of the PG status when the source TN is operating in the non-C2 JU to non-C2 JU PG, active(0) or inactive(1).  Used by air platforms only.  It is inserted in the J2.2I word, bit 60.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonC2_PGB_Status" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provided by a non-C2 platform to inform other JUs of the PG status when the source TN is operating in the non-C2 JU to non-C2 JU PG, active(0) or inactive(1).  Used by air platforms only.  It is inserted in the J2.2C5 word, bit 14.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionCorrelatorIdentifier" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the identifying number assigned to an overall mission, which enables participants with different objectives on specific missions to be associated with the same overall mission.  Range 0-255, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WingmanKey" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A letter or number assigned to a specific non-C2 JU.  For air platforms only. Range 0-63, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionCDR_TrackNumber" type="uci:Link16_TrackNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The TN of the commander of a mission of which the message originator is a member (could be own TN).  For air platforms only.  Range 0-77777(octal), default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FlightLeadTrackNumber" type="uci:Link16_TrackNumberType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The TN of the leader of the flight of which the message originator is a member (could be own TN).  For air platforms only.  Range 0-77777(octal), default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16NetSelectionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NetSelectionStatusNet" type="uci:Link16_NetNumberType">
				<xs:annotation>
					<xs:documentation>Net number request for net selection.  Used with the NetSelectionStatusPG_Index.  Range 0-127, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetSelectionStatusPG_Index" type="uci:Link16_ParticipationGroupIndexType">
				<xs:annotation>
					<xs:documentation>PG index number for net selection.  Range 0, 4 to 511 except 9, 12, 13, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16ReceiptComplianceWordsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Used to indicate whether the terminal will perform receipt compliance (R/C) processing on an original message provided by the Host.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MessageLabel" type="uci:Link16_MessageLabelType">
				<xs:annotation>
					<xs:documentation>J-Message Label. When set, Link 16 will enable R/C protocol for this message type and is used to indicate whether a message is indicated to be bypassed or not.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageSubLabel" type="uci:Link16_MessageSubLabelType">
				<xs:annotation>
					<xs:documentation>J-Message Sub-Label. When set, Link 16 will enable R/C protocol for this message type and is used to indicate whether the message is routed per Common carrier channel 1 or common carrier channel 2.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLink16TxPG_Type" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AutoRepromulgation" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether this PG Slot is to auto promulgate messages. If the waveform is enabled to originate repromulgation relay messages (AP054) and this AP is enabled, the waveform will generate a J0.5 repromulgation message for any FF message received from the host with the matching PG.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessagePriority" type="uci:Link16_MessagePriorityType">
				<xs:annotation>
					<xs:documentation>Indicates the priority of messages for this PG Slot. Used by the waveform to determine priority in transmit queue processing.  1 is highest, 15 lowest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageTransferStorageLimit" type="uci:Link16_MessageStorageLimitType">
				<xs:annotation>
					<xs:documentation>Number of messages for the PG index below that will be stored in the transmit queue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackingLimit" type="uci:CommLink16TxPackingLimitEnum">
				<xs:annotation>
					<xs:documentation>This is an adaptable parameter that is used for messages transmitted on the designated Participant Group (PG) when unspecified by the Host.  The options for this parameter are No statement (defaults to the Terminal packing limit), Standard Message Only, Packed-2 Double Pulse, Packed-2 Single Pulse, or Packed -4.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PG_Index" type="uci:Link16_ParticipationGroupIndexType">
				<xs:annotation>
					<xs:documentation>Indicates the PG index number for net selection.  Range 0, 4 to 511 except 9, 12, 13, default 0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlotNumber" type="uci:Link16_SlotNumberType">
				<xs:annotation>
					<xs:documentation>Indicates the Slot Number for this PG Slot.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StalenessLimit" type="uci:Link16_StalenessLimitType">
				<xs:annotation>
					<xs:documentation>Number of time slots the waveform will hold the message waiting for a transmit opportunity.  If time is exceeded, message will be deleted from the transmit queue.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLinkDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FullDuplex" type="uci:LinkRatesType">
				<xs:annotation>
					<xs:documentation>Indicates the uplink and downlink data rate in bits per second when the network is configured to use a Full Duplex communication system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxSimplex" type="uci:DataRateType">
				<xs:annotation>
					<xs:documentation>Indicates the data rate in bits per second when the network is configured to use a communication system that can only transmit data, and is not able to receive.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HalfDuplex" type="uci:LinkRatesType">
				<xs:annotation>
					<xs:documentation>Indicates the uplink and downlink data rate in bits per second when the network is configured to use a Half Duplex communication system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxSimplex" type="uci:DataRateType">
				<xs:annotation>
					<xs:documentation>Indicates the data rate in bits per second when the network is configured to use a communication system that can only receive data, and is not able to transmit.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CommLinkPortMapType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies assigned ports.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UserIO_ID" type="uci:CommUserIO_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies an input/output port used to inject or withdraw data to/from an I/O component.  Where the subsystem provides RED/BLACK separation, UserIO components exist on the RED side of the communication subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_UserLinkID" type="uci:CommUserLinkID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies an input/output RF link used to send or receive payload data.  Where the subsystem provides RED/BLACK separation, user link components exist on the BLACK side of the communication subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommLinkStatisticsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to report current statistics of a link on a communications capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a unique identifier for the configuration of an individual network connection.  Provides for the correlation of network link to a new activity or to an existing activity that will be updated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CarrierToNoiseRatio" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Carrier to Noise Ratio for this waveform capabilities links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalToNoiseRatio" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Signal to Noise ratio for this waveform capabilities links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurrentDataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Data Rate for this waveform capabilities links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MessageErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average Error Rate for Messages for this waveform capabilities links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BitErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average Bit Error Rate for this waveform capabilities links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxLatency" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average latency for point-to-point traffic to the remote network node.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxLatency" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average latency for point-to-point traffic received from a remote network node.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FixedDataRate" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the link uses a fixed or dynamic data rate.  A value of TRUE indicates that the link uses a fixed rate.  If the field is not set or a value of false indicates that the link dynamically adjusts the data rate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChannelKey" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the channel number that the link operates on.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommModeUsageType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModeIdentifier" type="uci:CommAntennaModeType">
				<xs:annotation>
					<xs:documentation>This element defines a specific mode for use in a communications system.  The meaning of the specific value is unique to the individual communication system.  See the specific communication provider documentation to identify the valid modes for that system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DropoutThreshold" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the dropout threshold (in dB) at which the communication system mode becomes unusable.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentUserLimit" type="xs:int">
				<xs:annotation>
					<xs:documentation>Indicates the number of users of the same type may share the same communication system resource and mode.  A negative or zero value indicates there is no maximum limit.  A value of 1 indicates that only a single system may utilize this communication mode on a given resource.  Any other number specifies the maximum number of systems that can simultaneously utilize the same communication resource in the given mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CommOutageType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommCoverageDataType">
				<xs:sequence>
					<xs:element name="OutageCode" type="xs:int" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a code for the reason of the communication outage if available.  The meaning of the code is specific to the particular communication system and/or communication asset.  Details about the code would be coordinated and documented by the providing communication system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OutageDetails" type="uci:VisibleString1024Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides details/reasons for the communication outage if available.  The details are specific to the given communication system and/or asset.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
