			<xs:element name="Time" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies a desired temporal bound for the plan.  For plans that don't change the satellite's orbit, this element can imply kinematics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kinematics" type="uci:OrbitalKinematicsChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a desired kinematics state for the plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElementSet" type="uci:TLE_BaseType" minOccurs="0">
