						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DamageObjectClassType" uci:version="000.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PlatformType" type="uci:PlatformIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the object is a general platform or category.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificType" type="uci:SpecificIdentityType">
				<xs:annotation>
