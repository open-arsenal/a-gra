	<xs:complexType name="SatelliteCharacteristicsMT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:SatelliteCharacteristicsMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SatelliteCharacteristicsOverrideType" uci:version="003.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SatelliteCharacteristicsID" type="uci:SatelliteCharacteristicsID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a "standard" SatelliteCharacteristics message/record.  If the subject satellite matches the "standard" characteristics then the sibling Override element(s) isn't needed.  If sibling Override elements are given, they override the standard characteristics for the subject satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OverrideCharacteristics" type="uci:SatelliteCharacteristicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates selective overrides of characteristics referenced by the sibling CharacteristicsID or simply a declaration of characteristics if the sibling CharacteristicsID is omitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatelliteCharacteristicsType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BusType" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Satellite bus type. This could be machine readable and/or an index into a non-UCI config file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionType" type="uci:SOB_MissionTypeEnum" minOccurs="0" maxOccurs="24">
				<xs:annotation>
					<xs:documentation>The intended mission or missions of the satellite. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the satellite total (wet) mass at time of launch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PhysicalConfiguration" type="uci:SatellitePhysicalConfigurationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the physical configuration and appearance of the satellite.  When more than one is given, the satellite has multiple configurations with different sizes and appearances.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CharacteristicsProductID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A reference to metadata for a product which conveys characteristics of the satellite. For example, a reference image of the satellite type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CharacteristicsFileID" type="uci:FileMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A reference to metadata for a file which conveys characteristics of the satellite.  For example, a non-Product image or a CAD model of the satellite's physical characteristics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommLink" type="uci:CommFrequencyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a comms link of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatelliteEnduranceType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the satellite's endurance specified by the indicated elements.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Propulsion" type="uci:EnduranceBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the satellite's propulsion endurance.  It is expected that at least one of the optional children is populated, corresponding to the propulsion energy source of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Maneuver" type="uci:OrbitalManeuverDetailsBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maneuverability endurance, expressed as the largest single velocity change that could be achieved with the satellite's remaining or planned propulsion endurance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Operational" type="uci:EnduranceBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the satellite's remaining or planned operational endurance.  It is expected that at least one of the optional children is populated, corresponding to the operational energy source of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatelliteIdentifierType" uci:version="001.002.000.001">
		<xs:annotation>
			<xs:documentation>The fields used for Satellite identification, e.g. NORAD Catalog Number, Name, and International Designator. Mission information is also included for additional characterization because not all satellites are guaranteed to be assigned all of these identifiers.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SatelliteNumber" type="uci:IntPositiveType">
				<xs:annotation>
					<xs:documentation>The satellite number or, more specifically, the NORAD Catalog Number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SatelliteName" type="uci:VisibleString128Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the known name associated with the satellite.  Optional field as each TLE line has a unique satellite number included.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InternationalDesignator" type="uci:InternationalDesignatorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique designation assigned by the World Data Center-A for Rockets and Satellites.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionInformation" type="uci:MissionInformationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the mission information associated with a satellite.  May be different from the common name, and a satellite may have multiple missions.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatelliteIdentityChoiceType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the identity of an asset either by type or instance.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByInstance" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Identifies the object as being a 1st-person self-reporting asset or a 3rd-person tracked asset. This option differs from the sibling "ByType" element in that "ByInstance" references UCI defined IDs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByType" type="uci:SatelliteIdentityType">
				<xs:annotation>
					<xs:documentation>Identifies an orbiting object via non-UCI ID designators, such as satellite numbers.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SatelliteIdentityType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the identity of the asset.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Standard" type="uci:StandardIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Satellite" type="uci:SatelliteIdentifierType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Satellite Identifier used to identify a Satellite.  See type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatelliteOperationsChangesCharacterizationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies a request to collect data to support assessment of a change to operational mode (or lack of change).  Includes case of becoming completely non-operational.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="All" type="uci:SatelliteOperationsChangesCharacterizationEnum">
				<xs:annotation>
					<xs:documentation>When "All" is chosen, all of the operations changes must be accomplished to satisfy the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Any" type="uci:SatelliteOperationsChangesCharacterizationEnum">
				<xs:annotation>
					<xs:documentation>When "Any" is chosen, the Task can be satisfied by performing only one of the operations changes provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SatellitePhysicalConfigurationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to SatelliteCharacteristics messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SatellitePhysicalConfigurationType" uci:version="001.002.000.001">
		<xs:annotation>
			<xs:documentation>Defines the structure for a satellite's physical configuration.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SatellitePhysicalConfigurationID" type="uci:SatellitePhysicalConfigurationID_Type">
				<xs:annotation>
					<xs:documentation>The ID type for the UCI ID that corresponds to this SatelliteCharacteristics message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OverallDimensions" type="uci:SizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the overall physical size of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BusDimensions" type="uci:SizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the satellite bus size.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BusCenterOffset" type="uci:OffsetLocationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the bus center offset relative to the overall satellite dimensions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NominalRCS" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the radar cross section (RCS) of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisualMagnitudeWithDeviation" type="uci:VisualMagnitudeWithDeviationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates visual magnitude with optional standard deviation (sigma) of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThermalEmissivity" type="uci:UnitIntervalFloatType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the thermal emissivity of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThermalAbsorptivity" type="uci:UnitIntervalFloatType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the thermal absorptivity of the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ScanDataBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ScanType" type="uci:ScanTypeEnum" maxOccurs="28">
				<xs:annotation>
					<xs:documentation>Indicates a type/class/category of scan being performed by the emitter of the Signal.  See enumerated type annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanPeriodMin" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum time duration of a scan amongst all the measured scan periods of the scanning Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanPeriodMax" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum time duration of a scan amongst all the measured scan periods of the scanning Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IlluminationTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates cumulative illumination time of the receiver and/or host System by the scanning Signal.  It is typically measured beginning and ending at a specific power level threshold down from the peak of the main beam of the Signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ScanDataType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ScanDataBaseType">
				<xs:sequence>
					<xs:element name="ScanTimestamp" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>Indicates the time at which the sibling elements were last updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanMeasurementStatus" type="uci:MeasurementStatusEnum">
						<xs:annotation>
							<xs:documentation>Indicates the status of scan measurement for the Signal and/or associated Emitter.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanPlane" type="uci:ScanPlaneEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the primary scan plane of the Signal based on scan angle extent, not including beamwidth.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SectorWidth" type="uci:AnglePositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the angular width of the scan beam.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanDirectionality" type="uci:ScanDirectionalityEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the primary directionality of the Scan.  See enumerated type annotations for further details.  There is a relationship between this element and the sibling ScanType; not all directionalities are possible for a given scan type.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanMechanics" type="uci:ScanMechanicsEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates how the Signal's scan is performed.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanPeriod" type="uci:DurationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the measured time duration of a single scan of a scanning Signal.  This element is unbounded to allow reporting of a series of scan periods.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OOK_Present" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) on-off keying was detected in the Signal.  Optional when the detecting Capability doesn't support OOK detection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Lobe" type="uci:LobeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a characterization of an amplitude Lobe associated with the Scan.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TypeOfBeam" type="uci:RadarBeamTypeEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if the beam is main, sidelobe or unknown.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BeamPersistence" type="uci:RadarBeamPersistenceEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates if the beam is persistently looking in the sensor direction.  This would be set if the sibling TypeOfBeam was set over a period of time.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ScheduleStateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type defines a state and associated timelines for which the state is in effect.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="State" type="uci:OpStateEnum">
				<xs:annotation>
					<xs:documentation>The state of the schedule (active or inactive) for which the defined schedule timeline applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:ScheduleType">
				<xs:annotation>
					<xs:documentation>Schedule timeline for which the indicated state is in effect.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ScheduleType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TimeSpan" type="uci:DateTimeRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Supports specifying multiple spans of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeekdayInterval" type="uci:WeekdayIntervalType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Supports specifying daily periodicity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ScoringProcessID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to Scoring Processes.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SDA_SpecialInstructionsConstraintType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="All" type="uci:SDA_SpecialInstructionsSetType">
				<xs:annotation>
					<xs:documentation>When "All" is chosen, all of the special instructions must be accomplished to satisfy the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Any" type="uci:SDA_SpecialInstructionsSetType">
				<xs:annotation>
					<xs:documentation>When "Any" is chosen, the Task can be satisfied by performing only one of the special instructions provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SDA_SpecialInstructionsSetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Special instructions associated with tasking for sensor collections.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpecialInstructions" type="uci:SDA_SpecialInstructionsEnum" minOccurs="0" maxOccurs="36">
				<xs:annotation>
					<xs:documentation>A set of additional instructions associated with tasking for sensor collections. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SearchTrackActivityDetailsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NumberOfTimesSearched" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Integer value of the number of times a volume has been completely searched for this activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeLastSearched" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the actual completion time for the last complete search of the volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Attempts" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For the duration of this activity, this is the number of times a volume has attempted to be searched completely, sanitized or the number of times the radar has attempted to acquire the cue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualRevisitPeriod" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For a volume search, this is the average calculated amount of time between revisits of any part of the volume, for a track update activity this is the average revisit rate achieved against the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentageInFOR" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the PO sensor is field of regard limited, this is the percentage of the volume that is currently in the EO FOR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualStartTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the first time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActualStopTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the last time at which this activity utilized front end resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentSearched" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This represents the current percentage of the volume that has been successfully searched during the current attempt (as represented in the Attempts field).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntitiesReported" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is an indication of the number of current entities have are being reported as a result of this activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CueAcquired" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indication that the PO sensor has successfully acquired the target that was identified as the cue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductsProduced" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Count of how many products have been produced as a result of this activity. This does not include messages (e.g. Entity) produced.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HitsReported" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is an indication of the number of hits that are currently being reported in a 4607 or raw MTI data product format.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
