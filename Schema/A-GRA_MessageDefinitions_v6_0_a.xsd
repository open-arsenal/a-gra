	</xs:simpleType>
	<xs:simpleType name="PlanningTriggerSourceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the category/type of trigger for planning or replanning.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AUTONOMOUS_TRIGGER">
				<xs:annotation>
					<xs:documentation>Indicates planning that was autonomously trigger by a service monitoring the battlespace, mission progress, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATOR_INVOKED_TRIGGER">
