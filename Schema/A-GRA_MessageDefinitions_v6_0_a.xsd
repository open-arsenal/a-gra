					<xs:element name="PackagePartner" type="uci:PackagePartnerBaseType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates package-related details for a partner System in the package, which can also include a lead System being considered a partner in the package.  The package concept informs Mission and Capability control established by the ControlStatus message.  For example, a package of Systems with partnered ESM_Capabilities performing multi-ship geo-location could be thought of as a single resource during planning and execution of Mission and Capability control.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PackageMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:PackageMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PackagePartnerBaseType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a partner System in a package.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Capability (of the System indicated by the sibling SystemID) whose operation is partnered with Capability(ies) of other Systems in the package.  For example, two Systems could be paired in a "bi-static surveillance package" with one System's active bi-static SAR Tx/illumination Capability partnered with another System's passive bi-static SAR Rx/collection Capability.  As another example, a "swarm package" of UAV Systems could coordinate their FlightCapability using kinematic/navigation sensors and/or a datalink associated with a CommsTerminalCapability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PackagePartnerStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a partner System in a package.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartnerState" type="uci:SystemStateEnum">
				<xs:annotation>
					<xs:documentation>This element represents the operational state of the Partner in the Package.  The state given here could be different than the SystemState reported by the System in its SystemStatus message.  For example, a System could be fully operational for stand-alone missions but degraded for package missions due to failure of a sensor mode, datalink, etc. that is required for package missions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartnerSource" type="uci:SystemSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the data in sibling elements.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartnerCapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates package-related status and details for a partnered Capability in the package.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PackageStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PackageID" type="uci:PackageID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Package whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackageState" type="uci:SystemStateEnum">
				<xs:annotation>
					<xs:documentation>This element represents the "rolled up" operational state or "OPSCAP" of the Package.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackageSource" type="uci:SystemSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the data of the Package whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackagePartnerStatus" type="uci:PackagePartnerStatusType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates package-related details for a partner System in the package, which can also include a lead System being considered a partner in the package.  The package concept informs Mission and Capability control established by the ControlStatus message.  For example, a package of Systems with partnered ESM_Capabilities performing multi-ship geo-location could be thought of as a single resource during planning and execution of Mission and Capability control.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PackageStatusMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:PackageStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ParameterAssertType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ParameterID" type="uci:ParameterID_Type">
				<xs:annotation>
					<xs:documentation>Identifier that uniquely refers to configuration parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NewValue" type="uci:ParameterValueType">
				<xs:annotation>
					<xs:documentation>Indicates whether the service configuration parameter will change to a specified value or return to the default value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectID" type="uci:ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Required if ServiceConfigurationParams defines a relevant Object. Defines which instance of the object this parameter refers to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ParameterID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to configuration parameters.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ParameterValueType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Value" type="uci:VisibleString256Type">
				<xs:annotation>
					<xs:documentation>Current value of the configuration parameter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReturnToDefault" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>If this is selected, the parameter called out should be returned to its default value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PATCHB_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GRAVITY" type="uci:PATCHB_GravityStringType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Local value of the acceleration due to gravity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathConstraintsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Specify a section of a path, by time or by segments.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SegmentWindow" type="uci:SegmentRangeType">
				<xs:annotation>
					<xs:documentation>Specify a segment window within a path. The absence of a begin segment indicates the window begins at the first segment within the path. The absence of an end segment indicates the window extends to the end of the path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeWindow" type="uci:TimeWindowType">
				<xs:annotation>
					<xs:documentation>Specify a time window within a path. The absence of a begin time indicates the window begins at the beginning of the path. The absence of an end time indicates the window extends to the end of the path.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PathID_Type" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to paths in a mission plan's routes.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:VersionedID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PathMetricsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathID" type="uci:PathID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metrics" type="uci:MetricsType">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for all the Segments of the Path referenced by the sibling PathID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentConditionType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AltitudeRange" type="uci:AltitudeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Choose this segment if current altitude (at end of current segment) is in the specified altitude range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeWindow" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Choose this segment if current time (at end of current segment) is in the specified time window.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentCapture" type="uci:SegmentCaptureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Choose this segment if the current segment has been captured the specified number of times.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorInput" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If true, only choose this segment if commanded by the operator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endurance" type="uci:EnduranceRemainingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Endurance remaining.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContingencyLevel" type="uci:SystemContingencyLevelEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Choose this segment if operating in the contingency state specified by this element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentModificationType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Specifies route path segment modification data. The order should not matter within a single request (like an atomic transaction). If you want to control order, you should send subsequent requests and wait for status after each.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathID" type="uci:PathID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the PathID segment changes apply to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Add" type="uci:PathSegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>PathSegment data to add.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoveID" type="uci:SegmentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>PathSegment to remove.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Update" type="uci:PathSegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>PathSegment modification data for existing segments. The data specified in each present field of this type is intended to replace the data in the same field of the original PathSegmentType element identified by PathSegmentID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentSpeedChoiceType" uci:version="000.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SpeedValue" type="uci:PathSegmentSpeedValueType">
				<xs:annotation>
					<xs:documentation>Indicates the speed that the vehicle shall traverse the path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MachValue" type="uci:MachType">
				<xs:annotation>
					<xs:documentation>Indicates the unitless Mach number realized at a particular speed during flight.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PathSegmentSpeedType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SpeedChoice" type="uci:PathSegmentSpeedChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed that the vehicle shall traverse the path segment. Speed can be represented as referenced speed (e.g., ground speed in m/s) or as a unitless Mach number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpeedOptimization" type="uci:SpeedOptimizationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the System will vary its speed autonomously according to the specified optimization algorithm.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentSpeedValueType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Value" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Indicates the speed along the PathSegment at the EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reference" type="uci:SpeedReferenceEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the given vehicle speed is reference to ground speed or true air speed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentThreatAssessmentType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the specified path segment in the route associated with the threat assessments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedThreatAssessment" type="uci:PredictedThreatAssessmentRelativeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>An array of route threat assessments specifying location along route with all corresponding threat detection probabilities for the included vehicle location.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathSegmentType" uci:version="003.001.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this PathSegment.  Other Paths or PathSegments may branch to this path segment by referring to this ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:PathSegmentSourceEnum">
				<xs:annotation>
					<xs:documentation>Defines whether the path segment was manually defined or if it was defined by an operator. This element can be used for many reasons including, but not limited to, operator display.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndPoint" type="uci:EndPointType">
				<xs:annotation>
					<xs:documentation>Indicates the end point of the PathSegment.  The start point is the end point of the previous PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Locked" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This flag is used to determine whether the segment can be modified/removed or was driven by an operator and therefore cannot be modified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Modified" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If this element is present and set to TRUE, this PathSegment has been modified as part of a MODIFIED_ROUTE MissionPlan.  This data is valuable to some planning algorithms to support validation of a user modified route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Speed" type="uci:PathSegmentSpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed or speed optimization of the System along the PathSegment at the EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CivilPathTerminator" type="uci:CivilPathTerminatorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the Civil Path Terminator information associated with the End Point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Climb" type="uci:ClimbType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the vehicle shall climb/descend and at what rate while traversing the path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumRoll" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum roll allowed along the PathSegment.  Angle in radians representing vehicle's rotation about the longitudinal axis (the axis through the body of the vehicle from tail to nose) in a locally level, North-East-Down coordinate system centered on the vehicle.  Roll is zero when the aircraft is wing-tip to wing-tip level in the North-East plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:AccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the acceleration of the System along the PathSegment at the EndPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NextPathSegment" type="uci:NextPathSegmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is used to specify the next non-conditional PathSegment.  This path segment can be the next segment in the current path or can be a transitional segment to another Path defined by the PathID. If the PathID is specified and differs from the current PathID, then this signals the end of the current Path and a transition to another Path. If no NextPathSegment is given then this is the end of the Route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConditionalPathSegment" type="uci:ConditionalPathSegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element is used to specify one or more conditional PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InertialState" type="uci:InertialStateRelativeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element is intended to provide detailed inertial state information at user defined increments within a path segment.  This element provides data which may be required for pre-mission analysis of a Route. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequiredTimeOfArrival" type="uci:TimeWindowType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes the mission planned required time of arrival. This message allows the operator to see a delta between the required and estimated arrival times that would allow for speed up/slow down determinations. This field is used as a constraint on the timing of the waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:RemarksType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates information about the path segment from an operator that is intended for display.  Both short and longer detailed information can be provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequiredNavigationPerformanceInMeters" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the navigation performance accuracy required in an airspace. This value is in meters rather than the RNP standard of nautical miles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fix_Identifier" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies a geographical position determined by visual reference to the surface, by reference to one or more radio NAVAIDs, by celestial plotting or another navigational device.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathThreatAssessmentType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathID" type="uci:PathID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the specified path in the route associated with the threat assessments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PathSegment" type="uci:PathSegmentThreatAssessmentType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element provides the assessment of a path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SegmentVertex" type="uci:Point2D_Type" minOccurs="2" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a vertex or waypoint along the desired path.  Generally, services are encouraged to provide altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LineProjection" type="uci:LineProjectionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of lines that form the Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathVulnerabilitySegmentType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the unique identifier of a path segment associated with this path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricsWithoutSuppression" type="uci:VulnerabilityMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vulnerability metrics of this path segment, determined by the potential threats that are located near the path segment, without the effects of suppression.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricsWithSuppression" type="uci:VulnerabilityMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vulnerability metrics of this path segment, determined by the potential threats that are located near the path segment, including the effects of suppression.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PathVulnerabilityType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathID" type="uci:PathID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the unique identifier of the path associated with this assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PathSegment" type="uci:PathVulnerabilitySegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of path segment vulnerability metrics. Each path segment contains its own vulnerability metrics, determined by the potential threats that are located near that path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricsWithoutSuppression" type="uci:VulnerabilityMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vulnerability metrics of this path, determined by the potential threats that are located near the path, without the effects of suppression.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricsWithSuppression" type="uci:VulnerabilityMetricsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vulnerability metrics of this path, determined by the potential threats that are located near the path, including the effects of suppression.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PercentileRCSType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>Percentile Radar Cross Section Type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RCS" type="uci:DoubleNonNegativeType">
				<xs:annotation>
					<xs:documentation>A generic representation of RCS in decibel square meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Percentile" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the percentile value of a ranked RCS measurement. A percentile is the value below which the specified percent of observations fall.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PercentRangeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines a range of percentage values.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Minimum" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Exclusive minimum value of the range (min, max]. Except for 0 which is always inclusive [0, max].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Maximum" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Inclusive maximum value of the range (min, max].</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PerformanceMetricSetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PerformanceConstraintIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Index to the metric that is the target of the PerformanceConstraint, assigned at command or task time in an incrementing number, for cross-referencing assigned constraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Merit" type="xs:int">
				<xs:annotation>
					<xs:documentation>Set to inform the order of importance. Highest number should be the minimum acceptable performance metric set.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NegotiableOptions" type="uci:NegotiableOptionsEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the extent for the specified Performance Metric is either Upper Range (upper negotiated range), Lower Range (lower negotiated range), Nominal (nominal desired value), or Discrete (get as close as possible).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PerformanceMetricSet" type="uci:MetricValueType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a set of performance metrics for valid IDs. ID and valid value ranges can be found in the service contract.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PeriodPerformanceFeedbackType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>Performance feedback characteristics for each access period.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessPeriodIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>ID of the Access Period being reported for performance feedback.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessAllocated" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the resource percent access as allocated from Resource Manager.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessRequested" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the percentage of the timeline being requested in the resource request message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessAchieved" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the resource percent access achieved in this Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnusableGrantedTime" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percent of interruption that the activity has experienced since obtaining access to resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentInterruption" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Percent of interruption that the activity has experienced since obtaining access to resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LongestUninterruptedTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Longest period of time where the activity has access to resources and has not been interrupted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PhotometryParamsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The photometry parameters consists of the amplitude in decibels of the desired Resolution.

The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AmplitudeResolution" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the desired resolution of the radar amplitude measured in decibels.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolutionTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PhysicalModelType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>Describes physical characteristics of a spacecraft, such as mass and area.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Mass" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The mass of the spacecraft, in kg.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DragArea" type="uci:AreaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The area of the spacecraft that is exposed to the atmosphere, in m^2. Used for drag force calculations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarRadiationPressureArea" type="uci:AreaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The area of the spacecraft that is exposed to the Sun, in m^2. Used for solar radiation pressure calculations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PixelCountSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:UnsignedIntegerMinMaxType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PixelDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Contains a pixel's location in an image specified by row and column number.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PixelColumn" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The column of the pixel within the image.
[0, #image columns - 1].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelRow" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The row of the pixel within the image.
[0, #image rows - 1].</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PixelOutputDataType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PixelDataType">
				<xs:sequence>
					<xs:element name="GeoLocationStatus" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether the pixel has been geolocated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The DMPI object that was created as a result of geo-locating this pixel.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OpPointID" type="uci:OpPointID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The OpPoint object that was created as a result of geo-locating this pixel.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PixelGeoLocation" type="uci:Point2D_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The geo-location calculated for this pixel.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LocationUncertainty" type="uci:UncertaintyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the 1-sigma position uncertainty for the pixel geolocation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LocationCovariance" type="uci:PositionPositionCovarianceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates position-position covariance of the referenced point in the NED coordinate system.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PixelReferenceCoordinateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Define a pixel coordinate and a reference image given as a File, a ProductMetadataID and/or a reference ForeignKey.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PixelCoordinate" type="uci:PixelDataType">
				<xs:annotation>
					<xs:documentation>Contains the pixel's location in an image specified by row and column number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="File" type="uci:FileNameType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The file name of the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductID" type="uci:ProductMetadataID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The ProductMetadataID of the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reference" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The ForeignKey reference data of the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PixelScalingSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Pixel scaling setting minimum and maximum allowable values for the subsystem.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GainSettings" type="uci:DoubleMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum and maximum allowable gain settings for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OffsetSettings" type="uci:IntegerMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum and maximum allowable offset settings for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanActivationAutonomyType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByMissionPlan" type="uci:MissionPlanActivationSettingType">
				<xs:annotation>
					<xs:documentation>Indicates autonomous, simultaneous activation of all sub-*Plans (TaskPlan, OrbitPlan and OrbitActivityPlan for example) of a MissionPlan into the same activation state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BySubPlan" type="uci:SubPlanActivationSettingType" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>Indicates autonomous activation by sub-*Plan (RoutePlan and ActivityPlan for example) of the MissionPlan, with potentially different states for each.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PlanActivationPolicyType" uci:version="002.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ByMissionPlan" type="uci:MissionPlanActivationSettingType" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Indicates the set of ByMissionPlan activation commands that are applicable to the sibling Policy element. List size allows for identifying those MissionPlans whose subordinate MissionPlans are either included in the activation (TRUE) or not (FALSE) via the CommandSubordinatePlans setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BySubPlan" type="uci:SubPlanActivationSettingType" minOccurs="0" maxOccurs="9">
				<xs:annotation>
					<xs:documentation>Indicates the set of BySubPlan activation commands that are applicable to the sibling Policy element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByPlanParts" type="uci:PlanPartsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates *Plan parts which the Plan to be activated must  contain in order for the Policy to be applicable.  If omitted, the Policy is applicable regardless of *Plan parts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Policy" type="uci:ApprovalPolicyBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the approval policy for the sibling applicable activation activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanActivationStateType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActivationState" type="uci:PlanActivationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates an activation state that one or more *Plans is in.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Plans" type="uci:PlansReferenceBaseType">
				<xs:annotation>
					<xs:documentation>Indicates the Plan or Plans in the sibling ActivationState.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanActivationStatusType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanActivationCommandState" type="uci:PlanActivationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates an activation command state that one or more *Plans is in.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Plans" type="uci:PlansReferenceType">
				<xs:annotation>
					<xs:documentation>Indicates the Plan or Plans in the sibling CommandState.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanApplicabilityModificationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies details pertaining to the Plan Applicability Modification.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApplicabilityAdditions" type="uci:PlanApplicabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates additional System or Systems which have a direct relationship with the Mission Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicabilityRetractions" type="uci:PlanApplicabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates System or Systems which no longer have a direct relationship with the Mission Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanApplicabilityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the System or Systems which have a direct relationship with the developed plan. Complex, dispersed, and/or hierarchical C2 systems require planning and plans at multiple levels with varying purpose and detail. Therefore, plan messages must give an indication of their level, purpose and detail.  For instance, planning services at the operational level of warfare may have different details and control authorities compared to planning services at the tactical level of warfare. The PlanApplicabilityType helps clarify which systems have which roles and responsibilities with respect to the plan. See child elements for further details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlannedForID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the System which is the intended user of the plan.  This type can have multiple meanings, but primarily enables multiple systems, possibly at different levels of warfare or C2 hierarchy levels, to maintain independent plans for the same System identified in the sibling ApplicableToID element.

For instance, during planning at the operational level of warfare, a non-tactical planning service may create and simulate execution of plans internally.  Such plans would identify the operational level System as the PlannedFor System; they would never be activated or executed by a real world tactical System.

Alternatively, the operational level System could have a tactical planning service that is functionally capable and responsible for creating fully detailed plans that can be activated and executed by real world tactical Systems.  Such a tactical planning service could be used even if the operational level System does not have control authority over the tactical System at the time the plan is created.  Such plans would identify the tactical level System as the PlannedFor System.

As a final example, a plan which is intended to be used by the same System which produces its intended effects would have a common SystemID between the sibling PlannedForID and ApplicableToID elements.

This element does not replace existing approval policies, authorization or control status and therefore does not automatically imply that the PlannedFor System has any kind of authority over the receiving system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableToID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the System (e.g. aircraft, ground-based sensor, ship, satellite, site, etc.) whose Capabilities, performance, position, etc. the plan is based on.  If the plan is a fully detailed one that can be activated and executed,  this element indicates the System intended/responsible for executing the plan and producing the intended effects.  See annotations in sibling element PlannedForID which provide additional context.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanCommandStatusType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates the common status information for all *PlanCommands.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommandProcessingState" type="uci:CommandProcessingStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the status of the command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandProcessingStateReason" type="uci:CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the sibling CommandProcessingState element.  This element is only expected when the Command is in a potentially undesirable state such as rejected, canceled or accepted with less than optimum results expected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandStatus" type="uci:ProcessingStatusEnum">
				<xs:annotation>
					<xs:documentation>Indicates the status of the command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompletionStatus" type="uci:CompletionStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates actual and predicted metrics for completion of the command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IncompleteItem" type="uci:IncompleteProcessingType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates items associated with command processing that failed to complete.  For example if a particular required Capability wasn't available, it could be referenced here.  This element/type is highly flexible.  It can reference almost any message/concept in UCI as a planning issue.  The wide range of messages/concepts it can reference makes it 1) difficult to use as a basis for software/services to resolve the issue but 2) an excellent general method for processing algorithms to convey issues to operators.  This element shouldn't be used to report processing issues/results that are more directly indicated by other processing status elements.  For example, for planning processing, other elements focus specifically on per-Requirement allocation results therefore this element shouldn't be used for per-Requirement allocation results.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanInputsCoreType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Indicates input data used to create different types of *Plans.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningProcessID" type="uci:PlanningProcessID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the planning process invoked by the *PlanCommand.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanInitiation" type="uci:PlanInitiationSourceEnum">
				<xs:annotation>
					<xs:documentation>This element indicates whether the Plan was initiated autonomously from a planning service, was operator initiated or edited, or was created externally.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningDataSource" type="uci:PlanningDataSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the category of messages to use as the source for System position, Capability, status, etc. data to use as the basis for the plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReplanReason" type="uci:ReplanReasonType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the reason for the replan.  This element is used during live operations and/or operation with autonomous planning, contingency management, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EnvironmentOverride" type="uci:MissionEnvironmentConstraintType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a selective override of an item in the mission environment world state to use/used in the Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpConstraint" type="uci:OpConstraintWeightingType" minOccurs="0" maxOccurs="15">
				<xs:annotation>
					<xs:documentation>Further constrain a Mission Plan to an operational constraint that indicates how much the constraint should play a role in the planning process. The multiplicity is based on the list of available OpConstraintEnums.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecialInstructionsID" type="uci:FileLocationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Free-text explanation of any extraordinary instructions at the plan level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanInterfaceCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the supported interface or interfaces for a given *Plan type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanType" type="uci:InterfacePlanTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the specific *Plan type that the interface is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanInterface" type="uci:PlanInterfaceStateType" maxOccurs="7">
				<xs:annotation>
					<xs:documentation>Indicates the specific messages/interface for the *Plan type indicated by the sibling element.  If multiple instances of this element are given, each should be of a different message/interface type as enumerated by the child PlanInterface element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanInterfaceStateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanInterface" type="uci:PlanningInterfaceEnum">
				<xs:annotation>
					<xs:documentation>Indicates specific interfaces related to the PlanType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivationState" type="uci:InterfaceStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current/commanded availability/activation state of the sibling PlanInterface.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanModificationDetailsType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>Specifies details pertaining to the Plan Modification Request.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>When TRUE, indicates the *Plan is a used only for intermediate planning purposes.  It will eventually be replaced/superseded by another *Plan or be discarded/abandoned.  *Plans with this flag should only be used when explicitly referenced by other messages.  These *Plans should never: trigger functionality, be subject to approvals, be activated, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WindowModification" type="uci:PlanWindowModificationTypeChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies an absolute time Window or alternatively a TimeOffset by which the Plan's, or set of Plans', Windows should be shifted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicabilityModification" type="uci:PlanApplicabilityModificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change in the System or Systems which have a direct relationship with the Mission Plan. See annotations for the underlying type and its child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubPlansModification" type="uci:SubPlansModificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change in the set of *Plans which are included as part of the MissionPlan. See annotations for the underlying type and its child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HierarchyModification" type="uci:HierarchyModificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change in the hierarchy of the set of MissionPlans.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExecutionSequenceModification" type="uci:ExecutionSequenceReplaceOrModifyChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change in the execution sequence of the set of *Plans.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementAllocationLock" type="uci:RequirementAllocationLockDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a requested change in Allocated Requirements to Lock or Unlock.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanModificationRequestMDT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>A request to modify a given Plan, or set of Plans.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="Source" type="uci:PlanInitiationSourceEnum">
						<xs:annotation>
							<xs:documentation>Source of the plan modification request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Plans" type="uci:PlansReferenceType">
						<xs:annotation>
							<xs:documentation>Indicates the Plan, or set of Plans, for which this Plan Modification Request is applicable.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlanModificationDetails" type="uci:PlanModificationDetailsType">
						<xs:annotation>
							<xs:documentation>Specifies details of the plan modification.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PlanModificationRequestMT" uci:version="002.000.002.000">
