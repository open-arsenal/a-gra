					<xs:documentation>Procedure Turn to Intercept Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_RadiusToFix" type="uci:RF_RadiusToFixType">
				<xs:annotation>
					<xs:documentation>Radius to Fix Civil Path Terminator Type. This path is a constant radius circular path around a defined turn center that terminates at a fixed point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TF_TrackToFix" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Track to Fix Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VA_HeadingToAltitude" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Heading to Altitude Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VD_HeadingToDMEDistanceTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Heading to DME Distance Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VI_HeadingToIntercept" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Heading to Intercept Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VM_HeadingToManual" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Heading to Manual Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VR_HeadingToRadialTermination" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Heading to Radial Termination Civil Path Terminator Type. This element's children elements are subject to change over the course of development.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ClassificationConstrainedSubPlanType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SecurityInformation" type="uci:SecurityInformationType">
				<xs:annotation>
					<xs:documentation>Indicates the security classification constraining the sub-plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstrainedSubPlanRank" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>This element provides precedence and priority ranking for each constrained subplan.  In the case that multiple subplans return true (all filters in more than one subplan are true) for a single product, this is used to determine which subplan to apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Filter" type="uci:ProductFilterType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Filters are used to determine if the constrained subplan applies.  All of the filter criteria within a constrained subplan must be satisfied to apply the subplan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ClassificationReportType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this report applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Classification" type="uci:SecurityInformationType">
				<xs:annotation>
					<xs:documentation>The classification placed on the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ClassificationRequirementsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this requirement applies.  If there is more than one Input Product defined, treat this as a logical OR condition, where the classification is applied to all products that fit the specified type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Classification" type="uci:SecurityInformationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The classification placed (or to place) on the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ClimbType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ClimbRate" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the climb rate during this PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClimbType" type="uci:ClimbOptimizationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the system will climb or descend at an autonomously chosen rate according to the specified optimization algorithm.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CloudsType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CloudCover" type="uci:WeatherCloudCoverEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the extent of cloud cover in the sky: CLEAR 0/8, FEW 1/8-2/8, SCATTERED 3/8-4/8, BROKEN 5/8-7/8, OVERCAST 8/8.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CloudCoverAmplification" type="uci:OktaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human observation has been the traditional method of measuring cloud cover, and there is a specific measurement, the okta, that is used to describe the presence of clouds in the sky. To use oktas, the observer should look straight up at the sky and imagine it is split into eight equal wedges, or oktas, radiating out from a central point directly overhead. If one okta is fully covered and the rest are clear, the sky can be described as having one okta of cloud cover.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CloudFloor" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the altitude of the cloud floor/base.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CloudCeiling" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the altitude of the cloud ceiling/tops.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COE_EquatorialOrientationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LongitudeOfPerigee" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the angle measured from the principal direction to perigee in the direction of the spacecraft's motion. Used for equatorial orbits with no Ascending Node. Required when Eccentricity is non-zero. Units in radians. Valid values range from zero to 2*PI().</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COE_NonEquatorialOrientationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Elements to describe orbits that go from south to north.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RightAscensionOfAscendingNode" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Right ascension of the ascending node (RAAN). Units in radians. Valid values range from zero to 2*PI().  This element describes the orbital plane's orientation with respect to the principal direction (vernal equinox direction); how the orbital plane is rotated in space.  RAAN is measured from the principal direction eastward along the equator to the ascending node.  Thus, the right ascension of the ascending node is the angle from the principal direction to the
ascending node.  The ascending node is the point of intersection of the orbit with the equatorial plane, crossing from the southern hemisphere to the northern hemisphere.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArgumentOfPerigee" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Argument of perigee is the angle from the body's ascending node to its periapsis, measured in the direction of motion. Perigee indicates this is an Earth-centered orbit.  Generically, this is the Argument of Periapsis.  Units in radians. Valid values range from zero to 2*PI().</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COE_OrbitBaseType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the set of classic orbital elements (COE) describing an orbit.  Elements describing the position of a satellite on the orbit are often considered part of COE but are omitted from this type which is only intended to describe the orbit.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Eccentricity" type="uci:DoubleNonNegativeType">
				<xs:annotation>
					<xs:documentation>Indicates the orbit's shape expressed as eccentricity. Eccentricity is a quantity describing the shape of the satellite's orbit. In mathematics the eccentricity of a conic section is a measure of how much the shape deviates from being circular. A value of zero represents a perfect circle. As the eccentricity varies from zero to 1 the ellipse becomes more "stretched". An eccentricity of 1 is a parabolic rather than elliptical, and values greater than 1 are hyperbolas.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inclination" type="uci:AngleHalfPositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the tilt of the orbit with respect to the equatorial plane.  Units in radians. Valid values range from zero to PI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:COE_OrientationType">
				<xs:annotation>
					<xs:documentation>Indicates the orientation of the orbital plane in space and of the orbit within its plane.  Equatorial orbits are a special case that result in some classical orbital elements (COE) for orientation being undefined; equatorial orbits use alternate elements to define orientation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COE_OrbitType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the set of classic orbital elements (COE) describing an orbit.  Elements describing the position of a satellite on the orbit are often considered part of COE but are omitted from this type which is only intended to describe the orbit.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:COE_OrbitBaseType">
				<xs:sequence>
					<xs:element name="SemimajorAxis" type="uci:DistanceType">
						<xs:annotation>
							<xs:documentation>Indicates the orbit's size expressed as the semi-major axis; one half the distance across the long axis of the orbit ellipse.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COE_OrientationType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the orientation of the orbital plane in space and of the orbit within its plane.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NonEquatorialOrbit" type="uci:COE_NonEquatorialOrientationType">
				<xs:annotation>
					<xs:documentation>Indicates that the orbit is non-equatorial. A non-equatorial orbit is an orbit with a non-zero inclination.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EquatorialOrbit" type="uci:COE_EquatorialOrientationType">
				<xs:annotation>
					<xs:documentation>Indicates the angle measured from the principal direction to perigee in the direction of the spacecraft's motion.  Used for equatorial orbit where RAAN and argument of perigee are undefined.  Units in radians.  Valid values range from zero to 2*PI.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="COE_PositionType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the set of classic orbital elements (COE) describing a spacecraft's position in an orbit.  Elements describing the size, shape and other characteristics of the orbit are in other types.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="MeanAnomaly" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates position of the spacecraft expressed as the angular distance from the pericenter which a fictitious body would have if it moved in a circular orbit, with constant speed, in the same orbital period as the actual body in its elliptical orbit. This means of expressing position is used for non-circular orbits.  Units in radians. Valid values range from zero to 2*PI().</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArgumentOfLatitude" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the position of the spacecraft expressed as the angle along the orbital path from the ascending node to the spacecraft's position in the direction of the spacecraft's motion.  This means of expressing position is used for circular orbits where mean anomaly is undefined.  Units in radians. Valid values range from zero to 2*PI().</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrueLongitude" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the position expressed as the angle from the principal direction (vernal equinox direction) to the spacecraft's position vector in the direction of the spacecraft's motion.  This means of expressing position is used for circular equatorial orbits where mean anomaly and argument of perigee are undefined.  Units in radians. Valid values range from zero to 2*PI().</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CollectionConstraintsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Modeled after SensorSpecificData in the ACTDF standard.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MapAngleConstraints" type="uci:AngleHalfPairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>True Map Angle.  The true map angle is defined in the Northeast Down (NED) coordinate system with the origin at the aircraft (aircraft local NED) as the angle between the scene entry line of sight and the instantaneous aircraft track heading vector. The aircraft track heading vector is obtained by rotating the north unit vector of the aircraft local NED coordinate system in the aircraft local NE plane through the aircraft track heading angle.  This angle is always positive.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GrazingAngleConstraints" type="uci:AngleQuarterPairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the plane of the terrain and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling ElevationAngleConstraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookAngleConstraints" type="uci:AnglePairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from true north to the line-of-sight vector from the sensor to the target tangent plane.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationAngleConstraints" type="uci:AngleHalfPairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the flat surface (ellipsoid surface ignoring terrain) and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling GrazingAngleConstraints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlantRangeConstraints" type="uci:SlantRangeConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Distance from the sensor reference point (e.g. aperture reference point) to the ground reference point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPattern" type="uci:CollectionPatternEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the type of pattern that a vehicle should use to collect over a large area.  This can be specified when creating Tasks to collect over OpZones, ZoneTargets, Entities (which have been specified as zones), etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CollectionDeckTraceabilityType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CollectionDeckMissionIdentifier" type="uci:AlphanumericString7OnlyType">
				<xs:annotation>
					<xs:documentation>This element is the collection deck mission ID which uniquely identifies the collection deck.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionDeckTaskIdentifier" type="uci:AlphanumericDashSpaceUnderscoreString12OnlyType">
				<xs:annotation>
					<xs:documentation>This element is the unique ID of the collection deck task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CollectionFrequencyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TuneFrequency" type="uci:FrequencyType">
				<xs:annotation>
					<xs:documentation>Indicates the tune frequency for this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An optional range is given to provide sensor sensitivity parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CollectionTaskMetricsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="QualityAchieved" type="uci:NIIRS_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>NIIRS quality achieved. This can be compared against the Quality specified in the Task to report performance.  See annotations of the underlying type for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ColorDepthSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:UnsignedIntegerMinMaxType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ColorPhotometryParamsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SensorSpectrum" type="uci:SensorSpectrumEnum" minOccurs="0" maxOccurs="14">
				<xs:annotation>
					<xs:documentation>Indicates the desired sensor spectrum to use for the characterization. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolutionTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_AcquisitionTargetType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Target" type="uci:COMINT_TargetType">
				<xs:annotation>
					<xs:documentation>Indicates the target for the dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Priority" type="uci:ComparableRankingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the priority setting for a particular target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_ActivityCommandType" uci:version="002.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="COMINT_ChangeDwell" type="uci:COMINT_ChangeDwellType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifies the specific dwell that the Subsystem should enable, disable, deallocate, or delete.  The dwell's identity is originally defined in the optional ReceiveDwell structure of the Activity message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="COMINT_ChangeGeolocation" type="uci:COMINT_ChangeGeolocationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to change the  control state of an active geolocation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to turn Spectral Density Reporting on and off for this Activity.  TRUE indicates a command for the Activity to produce Spectral Density Reports.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityListCleared" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the last time at which the Subsystem's Entity list/file/database was cleared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityOverload" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem has reached its limit in detecting and reporting emitter Entities; additional detectable emitters may exist but they won't be reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExcessiveAttitude" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an excessive attitude condition exists which can result in degraded performance of Activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseDensityOverload" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that a pulse destiny overload condition was detected by the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookThroughLimited" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the Subsystem has less look through time than is needed to perform its currently active Capabilities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiverUtilization" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated receiver utilization provided as a fractional percent.  When receiver utilization is greater than 100%, the subsystem is not meeting the design goal of the scan regimen provided in the mission data.  This means probability of detection and response time may be degraded for some emitters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:COMINT_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:COMINT_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_ActivityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:COMINT_SubCapabilityEnum" minOccurs="0" maxOccurs="16">
						<xs:annotation>
							<xs:documentation>Indicates a specific SubCapability that is  included in the Activity.  If omitted, all SubCapabilities of the associated Capability or Capabilities (as indicated in the Capability message) will be included in the Activity.  This element is required whenever a subset of SubCapabilities of the associated Capability or Capabilities are included in the Activity. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReceiveDwell" type="uci:COMINT_ReceiveDwellType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a receiver dwell that is applicable to the Activity.  This element is optional in support of Capabilities whose detailed dwell configuration and scheduling is internally isolated.  Though optional here, dwell information is required for successful, higher level Capability management across heterogeneous families Systems, Services and Subsystems.  dwell information is potentially useful even if the associated Activity and/or Capability aren't manual and/or interactive.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityDetails" type="uci:COMINT_SubCapabilityDetailsType" minOccurs="0" maxOccurs="5">
						<xs:annotation>
							<xs:documentation>Indicates select SubCapability-specific details regarding the originating command/source of the Activity (as indicated by the sibling Source element).  In other words, this element is an echo of select elements from the Command, MDF, etc. that originated the Activity.  Additionally, in the case of Commands whose results are independent of typical output messages such as Entity or SignalReport, discrete command results are given here instead of in those messages.  If multiple instances are given, each must be of a different choice in the child choice type.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentRequired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Activity requires consent to transition from the ENABLED state to an ACTIVE state.  This element is required and shall be TRUE for Activities which require consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentState" type="uci:ConsentEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of consent for the Activity.  This element is required for Activities which require Consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActualStartTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time when the Activity started.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActualEndTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time when the Activity stopped.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the status of Spectral Density Reporting for this Activity.  TRUE indicates that the Activity is producing Spectral Density Reports.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityCommandType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:COMINT_SubCapabilityEnum" minOccurs="0" maxOccurs="16">
						<xs:annotation>
							<xs:documentation>Indicates a specific SubCapability being invoked by the command.  If omitted, all SubCapabilities of the sibling CapabilityID are to be invoked.  If specified, only the specified SubCapabilities specified are required in order to satisfy the command.  Only SubCapabilities of the Capability indicated by the sibling CapabilityID should be specified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubcapabilityDetails" type="uci:COMINT_SubcapabilityChoiceType" maxOccurs="5">
						<xs:annotation>
							<xs:documentation>Indicates Command details for a Subcapability of the Capability indicated by the sibling CapabilityID.  One instance of this element for each Subcapability category (acquisition, ID, geolocation, measurement or pulse data collection) of that Capability is required.  If multiple instances are given, each must be of a different category in the descendant choice statement.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with the Subsystem and supported by the commanded Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:COMINT_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:COMINT_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfChannels" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies how many hardware channels (components) are needed to run this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AGC_Supported" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies whether the capability supports the subsystem managing its gain via automated gain control.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArchiveAvailable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies whether the capability supports an internal data archiving function.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityDependencyID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies another capability that this capability is dependent upon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanSupport" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies whether the capability supports a scanning function.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedModes" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Lists the modes of the target signals that the capability will support.  The string data format  of the key supports either numerical or text based designations, as defined by the subsystem performance specification.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AudioFormats" type="uci:MIME_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This indicates what formats are used by the subsystem when outputting audio data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompressionType" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This indicates what data compression types are used by the subsystem when outputting audio data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Profile" type="uci:CapabilityRF_ProfileStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a RF Emission Profile currently applied to the Capability.  If omitted, there are no current profiles and the Capability is operating per its defaults and other constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AmbiguityOrdering" type="uci:AmbiguityOrderingEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the order in which identity ambiguity is being reported in the Capability's output messages.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the SpectralDensityReport message is currently enabled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Specifies which messages are currently being output by the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:COMINT_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="COMINT_CapabilityType" uci:version="002.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:CapabilityInitiationEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the taxonomy.  The first tier is an indication of the means of initiation of the Capability.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:COMINT_SubCapabilityEnum" maxOccurs="16">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability of the Capability, the second tier in the taxonomy. The second tier is an indication of the specific collection technique.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GeolocationType" type="uci:SignalGeolocationMethodEnum" minOccurs="0" maxOccurs="8">
						<xs:annotation>
							<xs:documentation>Indicates a geolocation type/technique supported by the Capability.  This element is only expected when the sibling SubCapabilityType indicates geolocation. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:COMINT_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DwellCoverage" type="uci:ESM_DwellCoverageType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a summary of the expected coverage of a dwell or dwells associated with the Capability.  This element does not indicate an actual instantiated, scheduled dwell of the Capability.  This element is an abstraction of the MDF representation and/or design implementation of a Dwell.  Actual, instantiated, scheduled Dwells are reported via the Activity message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
