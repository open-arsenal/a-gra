	<xs:complexType name="DamageEstimateDetailsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ByObjectInstance" type="uci:ObjectInstanceDamageEstimateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates damage details summarized by object instance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByObjectType" type="uci:ObjectTypeDamageEstimateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates damage details summarized by object type or types.  Allows damage to be summarized for similar objects with probability organized into zones/ranges.  Allows an estimated damage template to be created that can be used to re-evaluate the sibling ByObject estimate at a later time when the battlespace changes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamageEstimateID_Type" uci:version="000.000.000.000">
