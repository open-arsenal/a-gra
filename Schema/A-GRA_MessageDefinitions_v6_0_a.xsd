	<xs:complexType name="PlansRequirementsReferenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MissionPlanID" type="uci:MissionPlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reference to a MissionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaskPlanID" type="uci:TaskPlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reference to a TaskPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EffectPlanID" type="uci:EffectPlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reference to an EffectPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActionPlanID" type="uci:ActionPlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reference to an ActionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResponsePlanID" type="uci:ResponsePlanID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a reference to an ResponsePlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanStatusType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningState" type="uci:PlanningStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current planning state of the Plan; the current state of the Plan in the planning state machine.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidationState" type="uci:PlanValidationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current validation state of the plan.  The variables a given planning service, operator or system considers when validating a plan varies.  Different variables might be considered for a single given System depending on the level of detail of the plan.  The scope and meaning of "valid" comes from context of the services, operator and systems creating the plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanValidationInputsBaseType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanningProcessID" type="uci:PlanningProcessID_Type">
				<xs:annotation>
					<xs:documentation>ID of the Planning Process to be used for validation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModifyToValidate" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) portions of the associated plan, that are found to be invalid, should be modified to make the plan valid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidationWIndow" type="uci:TimeWindowType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time window, within the time period of the Plan, to validate.  If omitted, the entire duration of the Plan should be validated.  The child Duration element, when the child Range element is omitted, indicates a time window beginning at the start time of the Plan and ending at the relative Duration.  Otherwise, the child Duration element is relative to the Range element if left open ended.  If the child Range element is fully specified, the child Duration element should be omitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherAreaData" type="uci:WeatherAreaDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents an override of the existing weather data available through UCI weather messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanVulnerabilityType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VulnerabilityByCapability" type="uci:ThreatVulnerabilityByCapabilityType" maxOccurs="15">
				<xs:annotation>
					<xs:documentation>Indicates the threshold of vulnerability for a given capability of threat which triggers a planning response.  The specified threshold is compared to the assessed/monitored battlespace condition using the sibling Comparator element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Comparator" type="uci:EqualityExpressionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the logical comparator to use when comparing the assessed/monitored battlespace condition to the threshold given by the sibling element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlanWindowModificationTypeChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Window" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>The new time window within which this Plan, or set of Plans, should apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeOffset" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Indicates the time offset that the existing Window for a Plan, or set of Plans, should be shifted by.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PlatformFunctionStatusCategoryType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Air" type="uci:PlatformFunctionAirEnum">
				<xs:annotation>
					<xs:documentation>Enumeration listing systems that can be reported for aircraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SeaSurface" type="uci:PlatformFunctionSeaSurfaceEnum">
				<xs:annotation>
					<xs:documentation>Enumeration listing systems that can be reported for sea surface vehicles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ground" type="uci:PlatformFunctionGroundEnum">
				<xs:annotation>
					<xs:documentation>Enumeration listing systems that can be reported for ground vehicles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EW" type="uci:PlatformFunctionEW_Enum">
				<xs:annotation>
					<xs:documentation>Enumeration listing systems that can be reported for electronic warfare systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PlatformFunctionStatusType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>The current status of a generic system on a platform.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Category" type="uci:PlatformFunctionStatusCategoryType">
				<xs:annotation>
					<xs:documentation>The type of system whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Status" type="uci:CapabilityAvailabilityEnum">
				<xs:annotation>
					<xs:documentation>The current status of the reported system type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlatformIdentityConfidenceType" uci:version="001.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlatformIdentityType">
				<xs:sequence>
					<xs:element name="Confidence" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Indicates the confidence of the declaration of the Entity's PlatformType.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PlatformIdentityType" uci:version="000.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlatformType" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "platform type" of the Entity. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUIs 1797/001, 1797/002, 1797/003, 1797/004 and 1797/005 for additional details. In MIL-STD-6016, platform type indexes/values vary by environment and therefore this element is only meaningful when paired with the sibling PlatformTypeCategory element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformTypeCategory" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the MIL-STD-6016 list/category of the sibling PlatformType. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThreatType" type="uci:ThreatEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the threat type of the entity. Threat type is simply a high-level categorization of threats to be used when ELNOT is unknown or not applicable. Derived from MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnitType" type="uci:UnitTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The basic type of unit based on MIL-STD-6016 DFI/DUI 288/001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchCapability" type="uci:LaunchCapabilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates how a submarine launches its missiles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubmarineConfidenceLevel" type="uci:SubmarineConfidenceLevelEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Expresses an assessment as to whether contacts are of submarine origin with added assessment of the confidence level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlatformStatusSAM_Type" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Platform status details for SAM launch sites.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="HotInventory" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated number of hot missiles remaining.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ColdInventory" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated number of cold missiles remaining.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SAM_Mode" type="uci:SAM_ModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specific state of a SAM unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationalImpairment" type="uci:OperationalImpairmentEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Primary system component that has degraded the operational capability of the platform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommunicationsImpairment" type="uci:CommunicationsImpairmentEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Communications component that is causing the platform to be less than fully operational.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ControlPositions" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of operator/control positions available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadiationMode" type="uci:RadiationModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Radar surveillance mode to indicate RADAR sensor mode of operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PlatformStatusType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BailoutIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates crew egress from an aircraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandAndControlIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates vehicle is a command and control unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmergencyIndicator" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates vehicle has an emergency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FunctionStatus" type="uci:PlatformFunctionStatusType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Not a substitute for Capability and CapabilityStatus, this field allows for high level platform SA rollup. The data in this filed will always be superseded by Capability and CapabilityStatus.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SAM_Status" type="uci:PlatformStatusSAM_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specific status data to support Surface to Air Missile systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurfaceRecovery" type="uci:SurfaceRecoveryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides status on platform's ability to support surface recovery.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurfaceStatus" type="uci:SurfaceRecoveryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specific status data to support surface systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DatalinkControlStatus" type="uci:DatalinkControlType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the state of Data link control of this unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PMOP_SequenceType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PMOP_SequencePhase" type="uci:PMOP_SequenceEnum" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of measured phase in a phase shift keyed Signal.  A series of measured phases constitute a PMOP sequence.  This field is only expected when the sibling PMOP element indicates PMOP was detected. List size for this element is based on "Order List of Values".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PMOP_SequenceLength" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the actual, full length of the PMOP sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ActivityCommandType" uci:version="003.002.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="Pointing" type="uci:PO_TargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This field contains the set of settings that will override the current pointing settings in the activity being adjusted.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeSubCapability" type="uci:PO_SubCapabilitySettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This field contains the settings that will override the current subcapability settings in the activity being adjusted. These changes, however, do not impact the default settings for the associated subcapability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeComponentSettings" type="uci:PO_ComponentSettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This field contains the set of settings that will override the current component settings in the activity being adjusted. These changes, however, do not impact the default settings for the associated component.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeCollectionConstraints" type="uci:PO_CollectionConstraintsSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This field contains the set of settings that will override the current collection constraints settings in the activity being adjusted.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeTrack" type="uci:PO_TrackDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This field contains the settings that will override the current track details in the activity being adjusted. These changes, however, do not impact the default settings for the associated track details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the PO Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:PO_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of a PO Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:PO_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_ActivityType" uci:version="003.003.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="ActualStartTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the actual time when the Activity started.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActualCompletionTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the actual time when the Activity stopped.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AllProductsAndMessagesProduced" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Flag indicating whether or not all products (e.g. ProductLocation) and messages (e.g. Entity) expected to be produced by this activity have been output.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FOV" type="uci:FOV_ActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the field of view (FOV), the pointing and angular extents, of the Activity. The FOV is referenced to the North-East-Down coordinate frame. For optical systems that use a Turret SupportCapability for pointing, body referenced azimuth and elevation can be found in the Turret messages. For optical Capabilities with multiple lens and zoom possibilities, this is the overall effective FOV of the Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PointingActivityReport" type="uci:PO_TargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides the dynamic pointing report on the line-of-sight for the PO Subsystem. If the PO Subsystem does not possess its own pointing capability, then the TurretSlaved Type is used.  FixedPointing is used to point to a predetermined location defined by its Enum values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityStatus" type="uci:PO_SubCapabilitySettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates detailed PO sensor Subcapabilities settings that will be used for this Activity. If the Activity is interactive and the Component controls and settings support manual interaction, these settings can be changed via PO_Command. Activity to optimize the captured imagery and tracks. If omitted, the Activity is subject to the default/current settings when the Activity starts.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentStatus" type="uci:PO_ComponentStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates detailed PO sensor control states and settings that will be used for this Activity. If the Activity is interactive and the Component controls and settings support manual interaction, these settings can be changed via PO_Command. Activity to optimize the captured imagery. If omitted, the Activity is subject to the default/current Component state when the Activity starts.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraintsStatus" type="uci:PO_CollectionConstraintsStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates detailed PO sensor collection constraints that will be used for this Activity. If the Activity is interactive and the Component collection constraints support manual interaction, these settings can be changed via PO_Command. Activity to optimize the captured imagery. If omitted, the Activity is subject to the default/current constraints when the Activity starts.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackOptionsStatus" type="uci:PO_TrackDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the track status associated with the current activity for a passive optical track option capability. If the Activity is interactive and the track controls and settings support manual interaction, these settings can be changed via PO_Command. Activity to optimize the captured tracks. If omitted, the Activity is subject to the default/current track settings when the Activity starts.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutputStatus" type="uci:ProductOutputCapabilityStatusImageryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the current status of the product output associated with this Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SearchActivity" type="uci:SearchTrackActivityDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current status of a PO search activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackActivity" type="uci:PO_TrackActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current status of a PO track activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="FOR_State" type="uci:FOR_Enum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current constraint condition for field of regard limits.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ThermalBlankingFOR_State" type="uci:FOR_Enum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current thermal field of regard constraint condition to protect the sensor from being blinded by the sun or weapon effects(i.e. missile leaving jet).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the repetition of the Activity.  If omitted, the Activity is not repetitive.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_AirTargetVolumeCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AirVolume" type="uci:PO_AirTargetVolumeType">
				<xs:annotation>
					<xs:documentation>Indicates the commanded air volume extents.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an Entity that is the target of a cued search. This element can be used as the full specification of the target volume for the cued search. It can also be used in combination with the sibling AirVolume element to define extents of the cue volume around the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_AirTargetVolumeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AirVolumeSensorReferenced" type="uci:PO_AirVolumeSensorReferencedType">
				<xs:annotation>
					<xs:documentation>Indicates a 3D sensor referenced volume that an air volume capability is directed against. This will define the volume in terms of azimuth and elevation angles.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AirVolumeLocation" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>Indicates a 3D area that an air volume capability is directed against. This should define the latitude/longitude extents of the volume along with any guidance regarding the height of the volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_AirVolumeSensorReferencedType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AzimuthScanWidth" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the commanded azimuth width. It represents the angular width between the two 3 dB extents of the scan volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthScanCenter" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Indicates the commanded azimuth center. For BODY stabilized volumes it is referenced to the centerline of the platform. For INERTIAL stabilized volumes it is referenced to true north; clockwise rotation is positive in both cases.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationScanWidth" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Indicates the commanded elevation scan width. It represents the angular width between the two 3 dB extents of the scan volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationScanCenter" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Indicates the commanded elevation center. For BODY stabilized volumes it is referenced to the centerline of the platform. For CENTER_ALTITUDE stabilized volumes it is referenced to the center altitude range pair.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxRangeOfInterest" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum range of interest. This will potentially affect dwell times, scan rates, reported Entities, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinRangeOfInterest" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum range of interest. This will potentially affect dwell times, scan rates, reported Entities, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthScanStabilization" type="uci:LOS_ReferenceEnum">
				<xs:annotation>
					<xs:documentation>Center of volume can be stabilized either relative to the centerline of the aircraft (BODY) or relative to true north (INERTIAL). In either case the radar will position volume either aligned with the aircraft's current direction or a particular line of bearing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationScanStabilization" type="uci:ElevationScanStabilizationEnum">
				<xs:annotation>
					<xs:documentation>Center of volume can be stabilized either relative to the boresight of the antenna installation on the aircraft (BODY) or relative to a location defined by the Elevation Scan Center Altitude Range Pair (CENTER_ALTITUDE). In either case the radar will position volume either aligned with the aircraft's current pitch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationScanCenterAltitudeRangePair" type="uci:AltitudeRangePairType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For a center altitude stabilized elevation volumes, this is the center point around which the volume is stabilized.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RollStabilized" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the volume should be stabilized parallel to the horizon.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_AngleConstraintControlsStatusType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Status" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates status of the commanded controls for the collection constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Settings" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>The current settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_AngleConstraintControlsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Controls" type="uci:PO_ConstraintControlsType">
				<xs:annotation>
					<xs:documentation>Specifies commanded controls for the collection constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Setting" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>The constraints on the angle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ApertureID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityCommandType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="Pointing" type="uci:PO_TargetType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the position or location to point the PO Subsystem to do a PO collection, search, or track. If the PO Subsystem cannot point itself, then the TurretSlaved Type is used. If the system wants to allow the subsystem to control its own LOS then the ActivitySlavedID is used. FixedPointing is used to point to a predetermined location defined by its Enum values.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapability" type="uci:PO_SubCapabilitySettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Passive Optical taxonomy. For PO, the first tier is an indication of the collection technique PO spectrum. See enumerated type annotations for further details. Changes to a Subsystem subcapability settings which associate to a specific capability will only apply to the activity associated with this commanded condition. The default settings for the associated subcapability will remain unchanged.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentSettings" type="uci:PO_ComponentSettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates override settings for Optical components to use for this command instead of the current/default settings. Changes to a Subsystem component settings which associate to a specific capability will only apply to the activity associated with this commanded condition. The default settings for the associated component will remain unchanged.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:PO_CollectionConstraintsSettingsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates override collection constraints to use for this command instead of the current/default settings. Values can range from min to max as an input. To send a specific value, set min and max the same.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackDetails" type="uci:PO_TrackDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the settings that can be applied for track. Changes to a Subsystem track settings which associate to a specific capability will only apply to the activity associated with this commanded condition. The default settings for the associated track settings will remain unchanged.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionPolicy" type="uci:CollectionPolicyEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates guidance regarding which aspect or aspects of collection to favor if the command cannot be optimally scheduled as requested. See enumerated type annotations for further details. Omitting this element is equivalent to FLEXIBLE, that is deferring to the Command recipient.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PairIdentifier" type="uci:PairIdentifierEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Command's role in a pair collection.  See enumeration annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command via capability path in the command message. If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:PO_ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command. Only Products consistent with Passive Optical and supported by the commanded Passive Optical Capability should be requested. If omitted, no output Product should be produced. See ProductTypeEnum for further details. If the associated Capability supports product generators, this element should be omitted and product output should be controlled via the sibling ComponentSettings element.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityMDT" uci:version="002.000.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:PO_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed PO Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PointingCapability" type="uci:PointingTypeEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>This indicates the type of pointing options that the  PO Subsystem can support. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapability" type="uci:PO_SubCapabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates all of the subcapabilities that a PO subsystem has available for command and control. Unique configurations can appear multiple times as individual IDs which allows for both:
1. One ID associated with multiple capabilities
2. A unique ID associated with one capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PO_Component" type="uci:PO_ComponentType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a Subsystem Component that is relevant to command and control of the associated Capability. A Component's characteristics and performance directly influence those of the associated Capability. One or more defined components may have settings/configuration independent with the associated Capability. Independent control of subsystem components as related to capabilities also adds flexibility in the command and control of independent components hosted within a single subsystem. Unique configurations can appear multiple times as individual IDs which allows for both:
1. One ID associated with multiple capabilities
2. A unique ID associated with one capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackOption" type="uci:PO_TrackCapabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Allowable range of values for Passive Optical track parameters that can be used to customize target detections. Indicates all of the track options that a PO subsystem has available for command and control.  Unique configurations can appear multiple times as individual IDs which allows for both:
1. One ID associated with multiple capabilities
2. A unique ID associated with one capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:PO_CollectionConstraintsType" minOccurs="0" maxOccurs="10">
						<xs:annotation>
							<xs:documentation>This field specifies which type of collection constraints are supported by this sensor. If multiple instances are given, each should be of a different constraint type as indicated by the child element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityFOR" type="uci:FOR_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the field of regard or FOR limits to limit the view of the sensor to what it can view from its mounting position on the aircraft. These values represent an available default option that a subsystem is defaulted to perform; settings command can also provide an optional override setting.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityThermalBlankingFOR" type="uci:FOR_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the field of regard or FOR limits to protect the sensor from being blinded by the sun or weapon effects(i.e. missile leaving jet). These values represent an available default option that the subsystem is defaulted to perform; settings command can also provide an optional override setting.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:PO_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityOptionsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the PO_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CalibrateOnActivity" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the PO Activity based on the observed collection target/scene to be a calibration for the PO subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityStatusMDT" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:PO_CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityStatus" type="uci:PO_SubCapabilitySettingsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the status settings associated with a subcapability as commanded in the settings command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TrackStatus" type="uci:PO_TrackStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the status of the track settings associated with a track option settings as commanded in the settings command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentStatus" type="uci:PO_ComponentStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The field specified the current status (and settings) of this component.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraintsStatus" type="uci:PO_CollectionConstraintsStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates collection constraints for a passive optical sensor.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:PO_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Specifies which messages are currently being output by the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentFOR" type="uci:FOR_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current FOR status settings as a hand-shake of the values that were commanded in the settings message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentThermalBlankingFOR" type="uci:FOR_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current Thermal Blanking FOR status.  This reflects either the FOR ID that was selected, or is a hand-shake of the values that were commanded in the settings message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityStatusMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:PO_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusType">
				<xs:sequence>
					<xs:element name="ProductOutputStatus" type="uci:ProductOutputStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the current product output status associated with this Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CapabilityType" uci:version="001.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:PO_CapabilityEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the Passive Optical taxonomy. For PO, the first tier is an indication of the collection technique. See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedSubCapabilityID" type="uci:SubCapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command and control relevant Subsystem SubCapability associated with the Capability. A subcapability unique ID can:
1.Associate with Multiple Capabilities. In this case, a change to a subcapability with this unique ID will impact all associated capabilities.
2.Associated with a single capability. In this case, a change to a subcapability with this unique ID will impact only the associated capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:PO_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages. Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command and control relevant Subsystem Component associated with the Capability. A component unique ID can:
1.Associate with Multiple Capabilities. In this case, a change to a component with this unique ID will impact all associated capabilities.
2.Associated with a single capability. In this case, a change to a component with this unique ID will impact only the associated capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedTrackOptionID" type="uci:TrackOptionsID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a command and control relevant Subsystem Track Options associated with the Capability. A track option unique ID can:
1.Associate with Multiple Capabilities. In this case, a change to a track option with this unique ID will impact all associated capabilities.
2.Associated with a single capability. In this case, a change to a track option with this unique ID will impact only the associated capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:PO_MessageOutputsEnum" minOccurs="0" maxOccurs="4">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability. See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CoastSettingOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Represents the allowed range of coast times for a designated PO environment.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CoastTimeSettings" type="uci:DurationRangeType">
				<xs:annotation>
					<xs:documentation>Range of allowed coast time settings for a designated environment that defines the time frame for coast tracks prior to dropping.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the PO environment associated with the allowed coast time settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CoastSettingValueType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Represents the specified coast time for a designated PO environment.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CoastTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Specified time for coasting tracks before dropping.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the PO environment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CollectionConstraintsSettingsType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>This type is used to specify a set of constraints that constrain when a PO or AO sensor can start collecting the requested image data.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MapAngle" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>True Map Angle.  The true map angle is defined in the Northeast Down (NED) coordinate system with the origin at the aircraft (aircraft local NED) as the angle between the scene entry line of sight and the instantaneous aircraft track heading vector. The aircraft track heading vector is obtained by rotating the north unit vector of the aircraft local NED coordinate system in the aircraft local NE plane through the aircraft track heading angle.  This angle is always positive.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GrazingAngle" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the plane of the terrain and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling ElevationAngleConstraints.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookAngle" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from true north to the line-of-sight vector from the sensor to the target tangent plane.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationAngle" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the flat surface (ellipsoid surface ignoring terrain) and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling GrazingAngleConstraints.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlantRange" type="uci:PO_SlantRangeConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Distance from the sensor reference point (e.g. aperture reference point) to the ground reference point.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPattern" type="uci:PO_CollectionPatternConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the type of pattern that a vehicle should use to collect over a large area.  This can be specified when creating Tasks to collect over OpZones, ZoneTargets, Entities (which have been specified as zones), etc.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SunElevAngles" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from the target plane at intersection of the optical line of sight with the earth's surface at the time of the first image line.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SunAzimuthAngles" type="uci:PO_AngleConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from True North clockwise (as viewed from space) at the time of the first image line.
This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SweepSpeed" type="uci:PO_SweepSpeedConstraintControlsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The rate at which the sensor look-point moves across the terrain.  This is only applicable to area or line targets.

This field is the new settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GimbalOrientation" type="uci:PO_GimbalOrientationConstraintType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The orientation of the gimbal with respect to the reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CollectionConstraintsStatusType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>This type is used to return the current settings of the set of constraints that constrain when a PO sensor can start collecting the requested image data.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MapAngleConstraints" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>True Map Angle.  The true map angle is defined in the Northeast Down (NED) coordinate system with the origin at the aircraft (aircraft local NED) as the angle between the scene entry line of sight and the instantaneous aircraft track heading vector. The aircraft track heading vector is obtained by rotating the north unit vector of the aircraft local NED coordinate system in the aircraft local NE plane through the aircraft track heading angle.  This angle is always positive.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GrazingAngleConstraints" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the plane of the terrain and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling ElevationAngleConstraints.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookAngleConstraints" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from true north to the line-of-sight vector from the sensor to the target tangent plane.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationAngleConstraints" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle at the target between the flat surface (ellipsoid surface ignoring terrain) and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling GrazingAngleConstraints.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlantRangeConstraints" type="uci:PO_SlantRangeConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Distance from the sensor reference point (e.g. aperture reference point) to the ground reference point.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPattern" type="uci:PO_ColorPatternConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the type of pattern that a vehicle should use to collect over a large area.  This can be specified when creating Tasks to collect over OpZones, ZoneTargets, Entities (which have been specified as zones), etc.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SunElevAngles" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from the target plane at intersection of the optical line of sight with the earth's surface at the time of the first image line.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SunAzimuthAngles" type="uci:PO_AngleConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle from True North clockwise (as viewed from space) at the time of the first image line.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SweepSpeed" type="uci:PO_SweepSpeedConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The rate at which the sensor look-point moves across the terrain.  This is only applicable to area or line targets.

This field is the current settings for this constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GimbalOrientation" type="uci:PO_GimbalOrientationConstraintControlsStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The current settings for the orientation of the gimbal with respect to its reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CollectionConstraintsType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>This type is used to specify a set of constraints that constrain when a PO or AO sensor can start collecting the requested image data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OpticalCollectionConstraintsType">
				<xs:sequence>
					<xs:element name="ConstraintType" type="uci:PO_CollectionConstraintsEnum">
						<xs:annotation>
							<xs:documentation>This field specified the type of collection constraint that is supported by this sensor. See the enumeration for the various constraints that can be supported.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the controllability of the collection constraint.  Omission of this element indicates the collection constraint is not dynamically controllable.

Enabling/disabling a product output controls whether or not the sibling Product type and format will be generated.  Resetting a product output restores its product specific settings to default/factory configuration.  A configurable product output's settings can be changed.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CollectionPatternConstraintControlsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Controls" type="uci:PO_ConstraintControlsType">
				<xs:annotation>
					<xs:documentation>Specifies commanded controls for the collection constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Setting" type="uci:CollectionPatternEnum">
				<xs:annotation>
					<xs:documentation>The pattern to use when performing this collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ColorPatternConstraintControlsStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Status" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the collection constraint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Setting" type="uci:CollectionPatternEnum">
				<xs:annotation>
					<xs:documentation>The collection pattern.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CommandMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:PO_CommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a PO Capability command. A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message. Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CommandMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:PO_CommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CommandResponseType" uci:version="001.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Capability" type="uci:PO_CapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the desired PO_Command type.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorSpectrum" type="uci:SensorSpectrumEnum" minOccurs="0" maxOccurs="14">
				<xs:annotation>
					<xs:documentation>Indicates the frequency band or spectrum that is used to search, track, or generate products with the PO subsystem. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionConstraints" type="uci:PO_CollectionConstraintsSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates override collection constraints to use for this command instead of the current/default settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductOutput" type="uci:PO_ProductOutputCommandImageryType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Command. Only Products consistent with Passive Optical and supported by the commanded Passive Optical Capability should be requested. If omitted, no output Product should be produced. See ProductTypeEnum for further details. If the associated Capability supports product generators, this element should be omitted and product output should be controlled via the sibling ComponentSettings element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_CommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:PO_CommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PO_CommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:PO_CapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of a PO Capability. Generally, if accepted, the command will result in one or more new PO Activities being created and reported via the PO_Activity message. The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command. Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:PO_ActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing PO Activity (which was previously reported via the PO_Activity message and was marked as "interactive"). The request/response interaction terminates as soon as the modification is accepted or rejected. The modifications are reflected in subsequent PO_Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentApertureSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApertureID" type="uci:PO_ApertureID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the id associated with the aperture controlled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="F_Stop" type="uci:PO_ComponentF_StopSettingsType">
				<xs:annotation>
					<xs:documentation>Indicates the optical aperture setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApertureControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the filter. Enabling inserts the filter into the optical pathway. Disabling removes the filter from the optical pathway. Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentApertureType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApertureID" type="uci:PO_ApertureID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the id associated with the aperture controlled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Lens exist within the optical pathway that leads to one or more Focal Plane Arrays (FPAs). This field specifies those FPAs that are associated with this lens, i.e. those FPAs that record light that passes through this lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="F_Stop" type="uci:PO_ComponentF_StopType">
				<xs:annotation>
					<xs:documentation>Indicates the aperture setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentF_StopSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="F_StopSetting" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates an optical aperture setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoF_Stop" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates the automatic subsystem control of the aperture setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentF_StopType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FixedAperture" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates that the aperture size is fixed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VariableAperture" type="uci:PO_ComponentF_StopVariableType">
				<xs:annotation>
					<xs:documentation>Indicates that the aperture size can be adjusted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentF_StopVariableType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates the minimum aperture value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="xs:float">
				<xs:annotation>
					<xs:documentation>Indicates the maximum aperture value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the filter. Omission of this element indicates the filter is not dynamically controllable. Enabling/disabling a filter inserts/removes it from the optical pathway. Resetting a filter restores it to default/factory configuration. Configurability of filters includes the bandpass frequency.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentFilterType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FilterID" type="uci:PO_FilterID_Type">
				<xs:annotation>
					<xs:documentation>Each filter is identified by a unique ID This field is this filter's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Filters exist within the optical pathway that leads to one or more Focal Plane Arrays (FPAs). This field specifies those FPAs that are associated with this filter, i.e. those FPAs that record light that passes through this filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterType" type="uci:PO_FilterEnum">
				<xs:annotation>
					<xs:documentation>This field specifies the filter's type, e.g. what light is filtered by this filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BandpassFrequency" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This field is used to specify a frequency band the filter allows to pass through. If not specified, then it is assumed that the filter does not pass through light of any frequency (this is true of filters of type "shutter"). The frequency band is greater than 0.0.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the filter. Omission of this element indicates the filter is not dynamically controllable. Enabling/disabling a filter inserts/removes it from the optical pathway. Resetting a filter restores it to default/factory configuration. Configurability of filters includes the bandpass frequency.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentFocalPlaneArrayChannelType" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ChannelID" type="uci:PO_FPA_ChannelID_Type">
				<xs:annotation>
					<xs:documentation>Each channel is identified by a unique ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityB_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the channel. Omission of this element indicates the channel is not dynamically controllable.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpticalBand" type="uci:PO_ComponentFocalPlaneArrayOpticalBandType">
				<xs:annotation>
					<xs:documentation>The OpticalBand is used to specify the band of frequencies in the optical domain that the channel is used to measure. The number of photons whose frequencies fall within this band will be measured by this channel. This field identifies the band this focal plane is currently measuring.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Operation" type="uci:PO_ComponentFocalPlaneArrayOperationType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Channels generally support a set of operations (actions) that the channel can perform on the measured photons. This is the list of the operations supported by this channel.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentFocalPlaneArrayOperationType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OperationType" type="uci:PO_FPA_ChannelOperationEnum">
				<xs:annotation>
					<xs:documentation>This field specified the type of operation that is supported by this channel. See the enumeration for the various operations that can be supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelAggregationSettings" type="uci:UnsignedIntegerMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the channel's aggregation for this subsystem capability. This element associates to and is set when FPA Channel Operation PIXEL_AGGREGATION is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeDelayIntegrationSettings" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the channel's TDI for this subsystem capability. This element associates to and is set when FPA Channel Operation TIME_DELAY_INTEGRATION is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelScalingSettings" type="uci:PixelScalingSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the pixel scaling values of gain and offset for this subsystem. This element associates to and is set when FPA Channel Operation PIXEL_SCALING is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionTimeSettings" type="uci:DurationRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the channel's collection time for this subsystem capability. This element associates to and is set when FPA Channel Operation TIME_COLLECTION is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonUniformityCorrectionSettings" type="uci:FocalPlaneArrayOperationNonUniformityCorrectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the channel's correction values for NUC for this subsystem capability. This element associates to and is set when FPA Channel Operation NON_UNIFORMITY_CORRECTION is available.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the channel operation. Omission of this element indicates the operation is not dynamically controllable. Reset of a channel operation can include resetting its configurable settings to default/factory values. For example, the number of stages in a time delay integration operation can be reset to its default number.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentFocalPlaneArrayOpticalBandType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Band" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>Indicates the optical frequency band that the channel can measure.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Configurable" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Optical band of the channel can be dynamically configured. Omission of this element indicates the Optical band is not dynamically configurable. See annotation enumerations for further details. Size is equivalent to maximum number of enumeration values available. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Optical band can be dynamically reset to it default/factory configuration. Omission of this element indicates the Optical band cannot be dynamically reset. See annotation enumerations for further details. Size is equivalent to maximum number of enumeration values available. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentFocalPlaneArrayType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FocalPlaneArrayID" type="uci:PO_FPA_ID_Type">
				<xs:annotation>
					<xs:documentation>Each focal plane array (FPA) is identified by a unique ID. This field is this FPA's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Channel" type="uci:PO_ComponentFocalPlaneArrayChannelType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Focal plane arrays (FPAs) divide up the optical spectrum into one or more channels, each channel being used to measure the number of photons that fall within a fixed range of the optical spectrum. This fixed range is known as the channel's optical band. The channel's optical band may or may not overlapped with another channel's optical band and the combination of the FPA's channel may or may not completely cover the optical spectrum, i.e. there may be gaps. This field is used to specify what channels are available. Included in this information is the channel's attributes, e.g. the channel's optical band, and the channel's control settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:PO_ComponentWindowType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A FPA can be a logical FPA that represents a "window" of a larger physical FPA. This defines a sub-window in the FPA.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityB_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the FPA. Omission of this element indicates the FPA is not dynamically controllable. Enabling/disabling a FPA enables/disables collection and measurement of arriving photons in the context of the associated Capability or Capabilities. Enabling or disabling a FPA affects all of its channels.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyFieldOfViewType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FixedFOV" type="uci:AngleQuarterType">
				<xs:annotation>
					<xs:documentation>This field specifies the FOV for those lens that have a fixed FOV (do not support zooming).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Zoom" type="uci:PO_ComponentLensAssemblyZoomType">
				<xs:annotation>
					<xs:documentation>This field specifies the FOV for those lens whose FOV can be changed, i.e. support zooming. This field is for optical zoom only and not electronic zoom.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyFocusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the focus characteristics of the lens.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PercentageFocusControl" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>The existence of this field specifies that this lens supports the capability of changing its focus setting. If allowed, one or more of the Component Control Interfaces values should be identified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFocusZoomControl" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Some lens assemblies support the ability to automatically adjust their focus settings as the assembly is zoomed into or out of the target. The existence of this field specifies that this lens supports this ability of automatically adjusting its focus setting while zooming. If allowed, one or more of the Component Control Interfaces values should be identified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IncrementalFocusControl" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>The existence of this field specifies that this lens supports the capability of changing its focus setting via incremental control. If allowed, one or more of the Component Control Interfaces values should be identified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyType" uci:version="002.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LensID" type="uci:PO_LensID_Type">
				<xs:annotation>
					<xs:documentation>Each lens is identified by a unique ID. This field is this lens's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Lens exist within the optical pathway that leads to one or more Focal Plane Arrays (FPAs). This field specifies those FPAs that are associated with this lens, i.e. those FPAs that record light that passes through this lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FOV" type="uci:PO_ComponentLensAssemblyFieldOfViewType">
				<xs:annotation>
					<xs:documentation>A Lens' Field Of View (FOV) specifies a cone or pyramid (depending on the structure of the collection element) emanating the FPA's collection elements out to the surface being imaged. The dimensions of this cone/pyramid determine how much surface area is imaged by a single collection element. This field provides information regarding the lens's FOV.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Focus" type="uci:PO_ComponentLensAssemblyFocusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the focus characteristics of the lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FocusSweepSettings" type="uci:PO_ComponentSettingsFocusSweepSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The new settings for the focus sweep generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityB_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the lens.  Omission of this element indicates the lens is not dynamically controllable.

Enabling/disabling a lens inserts/removes it from the optical pathway.  Resetting a lens restores it to default/factory configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyZoomAbsoluteType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ZoomControl" type="uci:ComponentControlInterfacesEnum" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the zoom where one or more of the Component Control Interfaces values should be identified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Min" type="uci:AngleQuarterType">
				<xs:annotation>
					<xs:documentation>The minimum value the lens's field of view (FOV) can be set to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="uci:AngleQuarterType">
				<xs:annotation>
					<xs:documentation>The maximum value the lens's field of view (FOV) can be set to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyZoomIncrementalType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the incremental zoom characteristics of the lens.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ZoomControl" type="uci:ComponentControlInterfacesEnum" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the zoom where one or more of the Component Control Interfaces values should be identified. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentLensAssemblyZoomType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the zoom characteristics of the lens.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IncrementalZoom" type="uci:PO_ComponentLensAssemblyZoomIncrementalType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specifies the methods by which the incremental zoom function can be controlled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AbsoluteZoom" type="uci:PO_ComponentLensAssemblyZoomAbsoluteType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specifies the methods by which the absolute zoom function can be controlled.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentProcessingStageType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StageID" type="uci:PO_ProcessingStageID_Type">
				<xs:annotation>
					<xs:documentation>Each processing stage is identified by a unique ID. This field is this processing stage's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Processing stages process the optical data produced by one or more Focal Plane Arrays (FPAs). This field specifies those FPAs whose generated data is processed by this stage. This information is useful in identifying which processing stage to configure if required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StageType" type="uci:PO_ProcessingStageTypeEnum">
				<xs:annotation>
					<xs:documentation>This field identifies this stage's processing type, i.e. what sort of processing is performed by the stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelScalingSettings" type="uci:PixelScalingSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The allowable settings for the pixel scaling values of gain and offset for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GammaValueSettings" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This allowable settings for the gamma compensation value for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the processing stage. Omission of this element indicates the processing stage is not dynamically controllable. Enabling a processing stage results in processing of optical data using the stage. Disabling results in no processing using the stage. Resetting a processing stage restores it to default/factory configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentProductGeneratorType" uci:version="001.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GeneratorID" type="uci:PO_ProductGeneratorID_Type">
				<xs:annotation>
					<xs:documentation>Each generator has an ID that is used to identify/specify the generator. This field is this generator's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Product generator produce products by consume the optical data produced by one or more Focal Plane Arrays (FPAs). This field specifies those FPAs whose generated data is processed by this stage. This information is useful in identifying which processing stage to configure if required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Controllability" type="uci:ComponentControllabilityA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the controllability of the product generator. Omission of this element indicates the product generator is not dynamically controllable. Enabling/disabling a product generator controls whether or not it will generate Products per product type specific settings in the sibling Output element. Resetting a product generator restores it to default/factory configuration. A configurable product generator's settings can be changed, e.g. selecting which band to use when generating the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductGeneratorSettings" type="uci:PO_ComponentSettingsProductGeneratorSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field is used to identify the allowable configurations of this product generator associated with Passive Optical sensors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentProductOutput" type="uci:ProductOutputCapabilityImageryType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an output of the generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutputProductSettings" type="uci:PO_ComponentSettingsOutputProductSettingsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the settings values used for the product output for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsBandpassFrequencyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FilterBandSetting" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>The new settings of the filter's band width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFilterBand" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the automatic enabling/disabling of the filter bandpass frequency. Setting this field to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFilterType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FilterID" type="uci:PO_FilterID_Type">
				<xs:annotation>
					<xs:documentation>Each filter is identified by its ID which is unique among all filters within a Passive Optical sensor. This field is the filter's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Filters exist within the optical pathway that leads to one or more Focal Plane Arrays (FPAs). This field specifies those FPAs that are associated with this filter, i.e. those FPAs that record light that passes through this filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the filter. Enabling inserts the filter into the optical pathway. Disabling removes the filter from the optical pathway. Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BandpassFrequency" type="uci:PO_ComponentSettingsBandpassFrequencyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>For those filters that operate over a range of frequencies (as opposed to those that operate on all frequencies), this field is used to specify what those frequencies are. If not specified, then it is assumed that the filter does not pass through light of any frequency. If a single frequency is desired, then set min and max to the same value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayChannelType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ChannelID" type="uci:PO_FPA_ChannelID_Type">
				<xs:annotation>
					<xs:documentation>Each channel within an FPA has a unique ID that is used to identify the channel. This field is a particular channel's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChannelControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the Channel.  Enabling allows the Channel to collect and measure photons. Disabling prohibits photon collection and measurement.  Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpticalBand" type="uci:PO_ComponentSettingsFocalPlaneArrayOpticalBandType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The OpticalBand is used to specify the band of frequencies in the optical domain that the channel is used to measure. The number of photons whose frequencies fall within this band will be measured by this channel. This field can be used to set this channels optical band.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelAggregation" type="uci:PO_ComponentSettingsFocalPlaneArrayPixelAggregationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Channels measure the number of arriving photons by collecting the photon's energy in buckets. Depending on the channel, a pixel in the resulting image may correspond to the number of photons collected in a single bucket or in an aggregation of buckets. This field contains the current setting of the channel's aggregation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeDelayIntegration" type="uci:PO_ComponentSettingsFocalPlaneArrayTimeDelayIntegrationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The sensitivity of a channel to arriving photons can be enhanced using the Time Delay Integration (TDI) technique. This technique basically involves adding a "time" dimension to the FPA and then moving the collection buckets along that time dimension as the collection is performed. This field indicates the current setting of this channel's TDI capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelScaling" type="uci:PO_ComponentSettingsFocalPlaneArrayPixelScalingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The image pixel that is returned by the channel is primarily a measurement of the number of photons that were collected. Some channels provide the capability to enhance this measurement by specifying a "offset" that is applied to the measurement and a "gain" that is used to increase the channels sensitivity. for such channels, the resulting pixel value is computed as "offset + (gain * measuredValue)".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelPolarity" type="uci:PO_ComponentSettingsFocalPlaneArrayPixelPolarityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Focal Plane Arrays (FPA) that measure photons in the Infrared Frequencies may have a polarity setting that allows one to specify whether a zero value represents "hot" or "cold" For such focal planes, this field indicates whether 0 represents hot (false) or cold (true).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionTime" type="uci:PO_ComponentSettingsFocalPlaneArrayCollectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The channel will collect photons for a fixed amount of time. Once this time has expired, the channel will report the number of photons collected. For line array FPAs, this time is the inverse of the "line rate", i.e. the rate at which lines of data are collected. This field is the channel's current collection time (in nanoseconds).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonUniformityCorrection" type="uci:PO_ComponentSettingsFocalPlaneArrayNonUniformityCorrectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Each collection element within a FPA should theoretically have the same sensitivity as all other collection elements within the FPA. However due to limits in the manufacturing process, this is never the case. To correct this defect in the manufacturing process, FPAs may contain logic to adjust this "non-uniformity" such that resulting measurements appear as if they were made from a totally uniform FPA.

This field is the channel's current NUC setting. The interpretation of this setting is dependent on the channel type but is generally used to specify a table of correction values that are to be used when performing NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanDirection" type="uci:PO_ComponentSettingsFocalPlaneArrayScanDirectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Data from an FPA is generally read out as a line of data. For some FPAs, the way this line is generated can be adjusted. Basically this means which collection element in the line array is the first element to be read out, i.e. the left or right most element. The ability to set which element is reported first is especially useful in generating images having the correct orientation. Specifying the scan direction, scanning to the right of left side of the aircraft, allows the FPA to select the proper direction to read the data out of the FPA.

This field is the channel's current scan direction. This interpretation of this value is dependent on the channel's type but is generally used to specify scanning on the right side of the aircraft (0) or the left side of the aircraft (1).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayCollectionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="CollectionTimeSetting" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>The new setting for this channel's collection time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionTimeControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto collection time defers control of the channel's collection time settings to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayNonUniformityCorrectionDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NUC_TableNumber" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The new setting for this channel's NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUC_ReferenceOffset" type="uci:FocalPlaneArrayNonUniformityCorrectionReferenceType">
				<xs:annotation>
					<xs:documentation>The new reference and offset setting for this channel's NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayNonUniformityCorrectionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NUC_Setting" type="uci:PO_ComponentSettingsFocalPlaneArrayNonUniformityCorrectionDataType">
				<xs:annotation>
					<xs:documentation>The new setting for this channel's NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUC_Controls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto NUC defers control of the channel's NUC settings to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayOpticalBandType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="BandSetting" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>The new settings for this channel's frequency band. If a single frequency is desired, then set min and max to the same value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BandControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto band control defers control of the channel's optical band to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayPixelAggregationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AggregationSetting" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The new settings for this channel's aggregation. For most channels, 0 and 1 indicates a 1-by-1 aggregation, 2 indicates a 2-by-2 aggregation, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AggregationControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto pixel aggregation defers control of the channel's pixel aggregation to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayPixelPolarityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PolaritySetting" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The new setting for this channel's polarity.  Indicates whether 0 represents hot (false) or cold (true).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PolarityControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto polarity defers control of the channel's polarity settings to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayPixelScalingSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Gain" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The gain value used in scaling the raw data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Offset" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The offset value used in scaling the raw data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayPixelScalingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ScalingSettings" type="uci:PO_ComponentSettingsFocalPlaneArrayPixelScalingSettingsType">
				<xs:annotation>
					<xs:documentation>The new settings for this channel's pixel scaling.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScalingControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto scaling defers control of the channel's gain and offset setting to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayScanDirectionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="DirectionSetting" type="uci:RelativeDirectionEnum">
				<xs:annotation>
					<xs:documentation>The setting for this channel's scan direction, specifying the right or left side of the aircraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DirectionControls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling auto scan direction defers control of the channel's scan direction to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayTimeDelayIntegrationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TDI_Setting" type="xs:double">
				<xs:annotation>
					<xs:documentation>The new setting for this channel's TDI. For most types of FPAs, this will be used to indicate the number of stages in the time dimension.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TDI_Controls" type="uci:ComponentControlsB_Type">
				<xs:annotation>
					<xs:documentation>Enabling autoTDI defers control of the channel's TDI to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocalPlaneArrayType" uci:version="002.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FocalPlaneArrayID" type="uci:PO_FPA_ID_Type">
				<xs:annotation>
					<xs:documentation>A passive optical sensor will contain one or more focal plane arrays (linear or grid) that are used to collect the photons that will form the basis of the collected image. Each focal plane array (FPA) has an associated ID that is used in various messages to identify that FPA. This field contains the ID of the focal plane whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WindowSelectionID" type="uci:PO_WindowID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the id of a given subset or window of an FPA.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_Controls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If the focal plane is disabled, then all channels are disabled as well.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Channel" type="uci:PO_ComponentSettingsFocalPlaneArrayChannelType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A focal plane array (FPA) is composed of one or more channels that measure the number of photons of a particular range of frequencies that hit the FPA. Depending on the type of FPA, the operational characteristics of its channels may be configurable. This field contains the current state of the channel.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocusSweepSettingsStartingPositionType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>The position to start the focus lens at when starting the focus sweep.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Percentage" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>This field specifies the starting position as a percentage of the total length that the focus lens can be moved, offset from the zero position of the focus lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfSteps" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This field specifies the starting position as number of steps, e.g. when used with a stepper motor, or a number of positions that the lens can be positioned at, offset from the zero position of the focus lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocusSweepSettingsStepIncrementType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>The increment used to move the focus lens between steps.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Percentage" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>This field specifies the increment as a percentage of the total length that the focus lens can be moved.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfSteps" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This field specifies the increment as number of steps, e.g. when used with a stepper motor, or a number of positions that the lens can be positioned at.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocusSweepSettingsStepTimeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The time required of each step in the focus sweep.  Generally only specified for line array sensors as this step time is fixed for grid array sensors.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NumberOfLines" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The size specified as the number of lines collected per step.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionTime" type="xs:duration">
				<xs:annotation>
					<xs:documentation>The time for each step in the focus sweep.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsFocusSweepSettingsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>The settings for a focus sweep operation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NumberOfStages" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The number of stages in the focus sweep. The image data collected during each stage will use a different focus setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepTime" type="uci:PO_ComponentSettingsFocusSweepSettingsStepTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time for each step in the focus sweep.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartingPosition" type="uci:PO_ComponentSettingsFocusSweepSettingsStartingPositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The length from the focus lens' zero position where to set the focus lens when starting the focus sweep. A sensor specific default value is used if this field is not specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepIncrement" type="uci:PO_ComponentSettingsFocusSweepSettingsStepIncrementType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The distance the focus lens should be moved between stages. A sensor specific default value is used if this field is not specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsGeneratorSettingsType" uci:version="000.002.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VisibleImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InfraredImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HyperspectralImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipVisibleSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipInfraredSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipHyperspectralSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamVisibleSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamInfraredSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamHyperspectralSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsLensAssemblyFieldOfViewType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FOV_Setting" type="uci:AngleQuarterType">
				<xs:annotation>
					<xs:documentation>The new setting for this lens' FOV.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoZoom" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable auto FOV control (auto zoom). Setting this field to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IncrementalChange" type="uci:IncrementalChangeType">
				<xs:annotation>
					<xs:documentation>This field supports incremental changes to the FOV where INCREASE increases the FOV, DECREASE decreases the FOV, and STOP cancels any current incremental change. The implementation can either step change by the change weight or some other value or use the STOP mechanic. The amount of change is affected by the ChangeWeight sub-element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsLensAssemblyFocusType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FocusSetting" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>The new setting for this lens's focus. This value is interpreted as the current position of the lens as expressed as a percentage of the total distance the lens can travel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFocus" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable auto focus.  Setting this field to false will disable it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFocusZoom" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Some focus assemblies support adjusting the lens's focus setting while zooming.  Setting this field to true will enable this capability while setting it to false will disable it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IncrementalChange" type="uci:IncrementalChangeType">
				<xs:annotation>
					<xs:documentation>This field supports incremental changes to the focus where INCREASE increases the focus, DECREASE decreases the focus, and STOP cancels any current incremental change. The implementation can either step change by the change weight or some other value or use the STOP mechanic. The amount of change is affected by the ChangeWeight sub-element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsLensAssemblyType" uci:version="002.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LensID" type="uci:PO_LensID_Type">
				<xs:annotation>
					<xs:documentation>Each lens is identified by its ID which is unique among all lens within a Passive Optical sensor. This field is the lens's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LensControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the Lens.  Enabling inserts the lens into the optical pathway.  Disabling removes the lens from the optical pathway.  Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FOV" type="uci:PO_ComponentSettingsLensAssemblyFieldOfViewType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A Lens Field Of View (FOV) specifies a cone or pyramid (depending on the structure of the collection element) emanating the FPA's collection element out to the surface being imaged. The dimensions of this cone/pyramid determine how much surface area is imaged by a single collection element. This field provides information regarding the lens's FOV.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Focus" type="uci:PO_ComponentSettingsLensAssemblyFocusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Generally the focus of a lens can be adjusted by moving the lens with respect to the optical pathway. This field provides information regarding the lens's current focus settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FocusSweepSettings" type="uci:PO_ComponentSettingsFocusSweepSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The new settings for the focus sweep generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsOutputProductSettingsType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ProductSettings" type="uci:PO_ComponentSettingsProductSettingsType">
				<xs:annotation>
					<xs:documentation>Specifies the settings that apply to this product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoOutputProductSettings" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the automatic setting of this product generator's format specific configuration. Setting this field to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProcessingStagePixelScalingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Offset" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new offset setting to be used by this stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Gain" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new gain setting to be used by this stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProcessingStageProcessingSettingsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PixelScaling" type="uci:PO_ComponentSettingsProcessingStagePixelScalingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The pixels that make up the final images which are generated from the raw optical data can be further processed to enhance images brightness and contrast. This is accomplished by computing a new pixel value from the original pixel value using the following formula "newPixelvalue = offset + (gain * origPixelValue)" where the gain and offset are either set automatically or manually. This field is used to set these values.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HSB_ColorControl" type="uci:HSB_ColorControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A common cylindrical-coordinate representations of points in an RGB color model. The representations rearrange the geometry of RGB in an attempt to be more intuitive and perceptually relevant than the Cartesian (cube) representation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RGB_ColorControl" type="uci:RGB_ColorControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The RGB color model is an additive color model in which red, green, and blue light are added together in various ways to reproduce a broad array of colors. The name of the model comes from the initials of the three additive primary colors, red, green, and blue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GammaValue" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the gamma compensation stage. This element is intentionally unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SharpnessValue" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the sharpening stage for sharpening the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EdgeEnhancement" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the edge enhancement stage when enhancing edges in the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicZoom" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the electronic zoom processing stage when zooming into or out of the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProcessingStageSettingsType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ProcessingSettings" type="uci:PO_ComponentSettingsProcessingStageProcessingSettingsType">
				<xs:annotation>
					<xs:documentation>This field contains the new settings of this processing stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoProcessingSettings" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the automatic setting of this processing stage's sibling ProcessingSettings. Setting this field to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProcessingStageType" uci:version="001.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProcessingStageID" type="uci:PO_ProcessingStageID_Type">
				<xs:annotation>
					<xs:documentation>Each stage is identified by a unique ID. This is this stage's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Processing stages process the optical data produced by one or more Focal Plane Arrays (FPAs). This field specifies those FPAs whose generated data is processed by this stage. This information is useful in identifying which processing stage to configure if required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingStageControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the processing stage. Enabling activates the processing. Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Settings" type="uci:PO_ComponentSettingsProcessingStageSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the settings for this processing stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProductGeneratorSettingsType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="GeneratorSettings" type="uci:PO_ComponentSettingsGeneratorSettingsType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum and maximum possible product generator settings for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoGeneratorSettings" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the automatic setting of this product generator's sibling GeneratorSettings. Setting this field to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProductGeneratorType" uci:version="002.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GeneratorID" type="uci:PO_ProductGeneratorID_Type">
				<xs:annotation>
					<xs:documentation>Each generator is identified by a unique ID. This is this generator's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Processing stages process the optical data produced by one or more Focal Plane Arrays (FPAs). This field specifies those FPAs whose generated data is processed by this stage. This information is useful in identifying which processing stage to configure if required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductGeneratorControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the processing stage. Enabling activates the product generator. Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductGeneratorSettings" type="uci:PO_ComponentSettingsProductGeneratorSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field is used to set the configuration of this product generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutputProductSettings" type="uci:PO_ComponentSettingsOutputProductSettingsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the settings values used for the product output for this subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsProductSettingsType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GeneratorOutputID" type="uci:PO_ProductGeneratorOutputID_Type">
				<xs:annotation>
					<xs:documentation>Each generator has an ID that is used to identify/specify the generator. This field is this generator's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductClassification" type="uci:SecurityInformationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element provides the classification label that should place on the Product at the time it is created if possible. Any post-collect processing of product classification should be handled via the ProductClassification messages (Plan, Task, and Request). This choice is intended for Task/Command creators who have direct knowledge/control of classification requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="JPEG_Settings" type="uci:JPEG_SettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element specifies settings for JPEG files generated by the Command. This element should be omitted for non-JPEG Products.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NITF_PackingPlan" type="uci:NITF_PackingPlanPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines data to be placed into the header of the resulting NITF product, commonly referred to at the NITF header "packing plan". This element should be omitted for non-NITF products.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MISP_Settings" type="uci:MISP_PackingPlanType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the data to be placed into the KLV data of the resulting MISP product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductRate" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the imagery product rate in frames/second on the service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolution" type="uci:ProductResolutionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the imagery product resolution in horizontal and vertical pixels and color depth on the service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompressionRatio" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defined as the number of bytes in the input image divided by the number of bytes in the output image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductSize" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the imagery product size in bytes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Interlaced" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that an imagery product scan pattern is interlaced when true and non-interlaced or progressive when false.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductOutputControls" type="uci:ComponentControlsA_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates commanded controls for the processing stage. Enabling activates the product generator. Enabling auto enable/disable grants enable/disable decisions to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoOutput" type="uci:VideoOutputSettingsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Settings for the video encoder for generating video streams.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentSettingsType" uci:version="002.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>A passive optical sensor will contain one or more subsystem components, e.g. focal planes and lens. Each subsystem component is identified by a unique component ID. This ID is used in messages and capabilities to identify a particular component. This field is the ID of the component whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FocalPlaneArray" type="uci:PO_ComponentSettingsFocalPlaneArrayType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One type of Passive Optical Subsystem Component is the Focal Plane Array (FPA). An FPA is an array (either linear or grid) of collection elements that are used to collect photons emitted by some surface, e.g. the surface of the earth. A Passive Optical sensor can have any number of FPAs. This field contains the current status of a focal plane array.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Lens" type="uci:PO_ComponentSettingsLensAssemblyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One type of Passive Optical Subsystem Component is the optical lens assembly. This assembly is used to concentrate the photons entering the Passive Optical sensor's optical pathway onto the sensor's various Focal Plane Arrays (FPAs).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Aperture" type="uci:PO_ComponentApertureSettingsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a space through which light passes in an optical or photographic instrument, especially the variable opening by which light enters a camera.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Filter" type="uci:PO_ComponentSettingsFilterType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One type of Passive Optical Subsystem Component is the optical filter. A filter is placed within the Passive Optical sensor's optical pathway and stops photons of a certain frequency (possibly of all frequencies) from passing through the filter on their way to the sensor's various Focal Plane Arrays (FPAs).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingStage" type="uci:PO_ComponentSettingsProcessingStageType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Passive Optical sensors generally support a processing engine that takes the raw data collected from the Focal Plane Arrays (FPAs) and processes that data in various way in order to produce an image product or products. Such engines can be viewed as pipelines in which each stage in the pipeline takes the imagery data produced by one or more stages earlier in the pipeline, processes that data in some fashion, and then sends the updated imagery data to the one of more stages further down the pipeline. This field specifies the stages that are available in this sensor's processing pipeline and whether the stage can be manually configured. This field is used to set the configuration of this processing stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductGenerator" type="uci:PO_ComponentSettingsProductGeneratorType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Passive Optical sensors have the capability of producing one or more products using the raw optical data collected by their focal plane arrays. This field is used to set the current configuration and setting used by this product generator to produce products.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusApertureSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ApertureID" type="uci:PO_ApertureID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the id associated with the aperture controlled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApertureControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the aperture's controls.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="F_StopSetting" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an optical aperture setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reset all aperture values to default.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusBandpassFrequencyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Band" type="uci:FrequencyRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The filter's current bandwidth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFrequency" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the filter's frequency is being enabled/disabled automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFilterType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FilterID" type="uci:PO_FilterID_Type">
				<xs:annotation>
					<xs:documentation>Each filter is identified by its ID which is unique among all filters within a Passive Optical sensor. This field is the filter's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Filters exist within the optical pathway that leads to one or more Focal Plane Arrays (FPAs). This field specifies those FPAs that are associated with this filter, i.e. those FPAs that record light that passes through this filter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FilterControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the filter's controls. An enabled filter is in the sensor's optical pathway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BandpassFrequency" type="uci:PO_ComponentStatusBandpassFrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For those filters that operate over a range of frequencies (as opposed to those that operate on all frequencies), this field specifies the frequencies the filter is currently passes though. If not specified, then it is assumed that the filter does not pass through light of any frequency.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayChannelType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ChannelID" type="uci:PO_FPA_ChannelID_Type">
				<xs:annotation>
					<xs:documentation>Each channel within an FPA has a unique ID that is used to identify the channel. This field is a particular channel's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChannelControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the channel's controls. An enabled channel can collect and process photons.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OpticalBand" type="uci:PO_ComponentStatusFocalPlaneArrayOpticalBandType">
				<xs:annotation>
					<xs:documentation>The OpticalBand is used to specify the band of frequencies in the optical domain that the channel is used to measure. The number of photons whose frequencies fall within this band will be measured by this channel. This field identifies the band this focal plane is currently measuring.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelAggregation" type="uci:PO_ComponentStatusFocalPlaneArrayPixelAggregationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Channels measure the number of arriving photons by collecting the photon's energy in buckets. Depending on the channel, a pixel in the resulting image may correspond to the number of photons collected in a single bucket or in an aggregation of buckets. This field contains the current setting of the channel's aggregation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeDelayIntegration" type="uci:PO_ComponentStatusFocalPlaneArrayTimeDelayIntegrationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The sensitivity of a channel to arriving photons can be enhanced using the Time Delay Integration (TDI) technique. This technique basically involves adding a "time" dimension to the FPA and then moving the collection buckets along that time dimension as the collection is performed. This field indicates the current setting of this channel's TDI capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelScaling" type="uci:PO_ComponentStatusFocalPlaneArrayPixelScalingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The image pixel that is returned by the channel is primarily a measurement of the number of photons that were collected. Some channels provide the capability to enhance this measurement by specifying a "offset" that is applied to the measurement and a "gain" that is used to increase the channels sensitivity. for such channels, the resulting pixel value is computed as "offset + (gain * measuredValue)".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PixelPolarity" type="uci:PO_ComponentStatusFocalPlaneArrayPixelPolarityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Focal Plane Arrays (FPA) that measure photons in the Infrared Frequencies may have a polarity setting that allows one to specify whether a zero value represents "hot" or "cold" For such focal planes, this field indicates whether 0 represents hot (false) or cold (true).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionTime" type="uci:PO_ComponentStatusFocalPlaneArrayCollectionTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The channel will collect photons for a fixed amount of time. Once this time has expired, the channel will report the number of photons collected. For line array FPAs, this time is the inverse of the "line rate", i.e. the rate at which lines of data are collected. This field is the channel's current collection time (in nanoseconds).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonUniformityCorrection" type="uci:PO_ComponentStatusFocalPlaneArrayNonUniformityCorrectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Each collection element within a FPA should theoretically have the same sensitivity as all other collection elements within the FPA. However due to limits in the manufacturing process, this is never the case. To correct this defect in the manufacturing process, FPAs may contain logic to adjust this "non-uniformity" such that resulting measurements appear as if they were made from a totally uniform FPA. This field is the channel's current NUC setting. The interpretation of this setting is dependent on the channel type but is generally used to specify a table of correction values that are to be used when performing NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanDirection" type="uci:PO_ComponentStatusFocalPlaneArrayScanDirectionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Data from an FPA is generally read out as a line of data. For some FPAs, the way this line is generated can be adjusted. Basically this means which collection element in the line array is the first element to be read out, i.e. the left or right most element. The ability to set which element is reported first is especially useful in generating images having the correct orientation. Specifying the scan direction, scanning to the right of left side of the aircraft, allows the FPA to select the proper direction to read the data out of the FPA. This field is the channel's current scan direction. This interpretation of this value is dependent on the channel's type but is generally used to specify scanning on the right side of the aircraft (0) or the left side of the aircraft (1).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayCollectionTimeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CollectionTimeSetting" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>The channel's current collection time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoCollectionTime" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the collection time is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayNonUniformityCorrectionDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="NUC_TableNumber" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>This field indicates the table number for NUC settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NUC_ReferenceOffset" type="uci:FocalPlaneArrayNonUniformityCorrectionReferenceType">
				<xs:annotation>
					<xs:documentation>This field indicates the reference and offset for the channel's NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayNonUniformityCorrectionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NUC_Setting" type="uci:PO_ComponentStatusFocalPlaneArrayNonUniformityCorrectionDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The settings for this channel's NUC.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoNUC" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the NUC setting is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayOpticalBandType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BandSetting" type="uci:FrequencyRangeType">
				<xs:annotation>
					<xs:documentation>The band this focal plane is currently measuring.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoBand" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the optical band is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayPixelAggregationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AggregationSetting" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The channel's current aggregation setting. This interpretation of the setting is dependent on the channel's type. For most channels, 0 and  1 indicates a 1-by-1 aggregation, 2 indicates a 2-by-2 aggregation, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoAggregation" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the aggregation value is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayPixelPolarityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PolaritySetting" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>The FPAs current polarity setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoPolarity" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the pixel polarity is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayPixelScalingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Gain" type="xs:double">
				<xs:annotation>
					<xs:documentation>The gain value used in scaling the raw data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Offset" type="xs:double">
				<xs:annotation>
					<xs:documentation>The offset value used in scaling the raw data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoScaling" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the gain and offset are being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayScanDirectionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DirectionSetting" type="uci:RelativeDirectionEnum">
				<xs:annotation>
					<xs:documentation>The setting for this channel's scan direction, specifying the right or left side of the aircraft.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoDirection" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the scan direction is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayTimeDelayIntegrationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TDI_Setting" type="xs:double">
				<xs:annotation>
					<xs:documentation>The channel's current TDI setting. This interpretation of the setting is dependent on the channel's type. For many channels, this value indicates the number of stages within the channel's TDI system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoTDI" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the aggregation value is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocalPlaneArrayType" uci:version="002.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FocalPlaneArrayID" type="uci:PO_FPA_ID_Type">
				<xs:annotation>
					<xs:documentation>A passive optical sensor will contain one or more focal plane arrays (linear or grid) that are used to collect the photons that will form the basis of the collected image. Each focal plane array (FPA) has an associated ID that is used in various messages to identify that FPA. This field contains the ID of the focal plane whose status is being reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FPA_ControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the FPA's controls. If the FPA is disabled, all channels are disabled as well.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Channel" type="uci:PO_ComponentStatusFocalPlaneArrayChannelType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A focal plane array (FPA) is composed of one or more channels that measure the number of photons of a particular range of frequencies that hit the FPA. Depending on the type of FPA, the operational characteristics of its channels may be configurable. This field contains the current state of the channel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:PO_ComponentWindowType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A FPA can be a logical FPA that represents a "window" of a larger physical FPA. This defines a sub-window in the FPA.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusFocusSweepSettingsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NumberOfStages" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The number of stages in the focus sweep. The image data collected during each stage will use a different focus setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepTime" type="uci:PO_ComponentSettingsFocusSweepSettingsStepTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time for each step in the focus sweep.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartingPosition" type="uci:PO_ComponentSettingsFocusSweepSettingsStartingPositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The length from the focus lens' zero position where to set the focus lens when starting the focus sweep. A sensor specific default value is used if this field is not specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepIncrement" type="uci:PO_ComponentSettingsFocusSweepSettingsStepIncrementType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The distance the focus lens should be moved between stages. A sensor specific default value is used if this field is not specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusGeneratorSettingsType" uci:version="000.002.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VisibleImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InfraredImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HyperspectralImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImageSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the image generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipVisibleSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipInfraredSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipHyperspectralSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoClipSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the video clip generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamVisibleSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the visible video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamInfraredSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the infrared video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamHyperspectralSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the hyperspectral video stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoStreamSetting" type="uci:DoubleMinMaxType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The new settings of the stream generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusLensAssemblyFieldOfViewType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FOV_Setting" type="uci:AngleQuarterType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field is the current position of the lens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoZoom" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the FOV is being set automatically (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeType" type="uci:IncrementalChangeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The current incremental change enumeration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusLensAssemblyFocusType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FocusSetting" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>This field contains the current focus setting of the lens. This value is interpreted as the current position of the lens as expressed as a percentage of the total distance the lens can travel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFocus" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Some lens assemblies support and auto-focus capability in which the lens's focus setting in automatically set. This field is the current setting of this auto-focus capability.  This field indicates whether the lens's auto-focus capability is enabled (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoFocusZoom" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Some focus assemblies support the capability of adjusting the lens's focus setting while the zooming into and away from the target. For such assemblies, this field indicates whether this capability is enabled (true) or not (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeType" type="uci:IncrementalChangeEnum">
				<xs:annotation>
					<xs:documentation>The current incremental change enumeration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusLensAssemblyType" uci:version="002.000.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LensID" type="uci:PO_LensID_Type">
				<xs:annotation>
					<xs:documentation>Each lens is identified by its ID which is unique among all lens within a Passive Optical sensor. This field is the lens's ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LensControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the lens controls.  An enabled lens is in the optical pathway.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FOV" type="uci:PO_ComponentStatusLensAssemblyFieldOfViewType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A Lens Field Of View (FOV) specifies a cone or pyramid (depending on the structure of the collection element) emanating the FPA's collection element out to the surface being imaged. The dimensions of this cone/pyramid determine how much surface area is imaged by a single collection element. This field provides information regarding the lens's FOV. This field specifies the current position of the lens and is only applicable to those lens that support zooming.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Focus" type="uci:PO_ComponentStatusLensAssemblyFocusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Generally the focus of a lens can be adjusted by moving the lens with respect to the optical pathway. This field provides information regarding the lens's current focus settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FocusSweepSettings" type="uci:PO_ComponentStatusFocusSweepSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The current settings for the focus sweep generator.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusOutputProductSettingsType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductSettings" type="uci:PO_ComponentStatusProductSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the settings that apply to this product.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoOutputProductSettings" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether auto control of the product generator's output Product settings is enabled (TRUE) or not (FALSE).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusProcessingStagePixelScalingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Offset" type="xs:int">
				<xs:annotation>
					<xs:documentation>This is the offset currently being used by this stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Gain" type="xs:double">
				<xs:annotation>
					<xs:documentation>This is the gain current being used by this stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusProcessingStageProcessingSettingsType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PixelScaling" type="uci:PO_ComponentStatusProcessingStagePixelScalingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The pixels that make up the final images which are generated from the raw optical data can be further processed to enhance images brightness and contrast. This is accomplished by computing a new pixel value from the original pixel value using the following formula "newPixelvalue = offset + (gain * origPixelValue)" where the gain and offset are either set automatically or manually. This field specifies the current offset and gain values being used by this stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HSB_ColorControlStatus" type="uci:HSB_ColorControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A common cylindrical-coordinate representations of points in an RGB color model. The representations rearrange the geometry of RGB in an attempt to be more intuitive and perceptually relevant than the Cartesian (cube) representation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RGB_ColorControlStatus" type="uci:RGB_ColorControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The RGB color model is an additive color model in which red, green, and blue light are added together in various ways to reproduce a broad array of colors. The name of the model comes from the initials of the three additive primary colors, red, green, and blue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GammaValue" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specifies the current value used for gamma compensation. This element is intentionally unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SharpnessValue" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specifies the current value used for sharpening the image.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EdgeEnhancement" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specified the current edge enhancement setting.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Zoom" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field specifies setting used by the Electronic Zooming processing stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusProcessingStageSettingsType" uci:version="001.000.001.000">
