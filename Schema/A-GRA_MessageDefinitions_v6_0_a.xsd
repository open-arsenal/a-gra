			<xs:element name="TimedZone" type="uci:TimedZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial zone and optionally time/date span or spans when the profile is active.  The profile is applicable to RF operations that 1) are scheduled to complete within the time/date span and 2) have a target which falls within the zone.  This element supersedes the sibling Expires element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Expires" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time and date when the profile expires.  The profile is applicable to RF operations initiated prior to this time.  When the sibling TimedZone element is used, the time spans specified there supersede this element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_RadiusToFixType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to define Radius to Fix Civil Path Terminator Leg Type. This path is a constant radius circular path around a defined turn center that terminates at a fix.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadiusCenterPoint" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the center point of the radius-to-fix turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnRadius" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the radius distance for the radius-to-fix turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CourseIn" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the course associated with the RF leg type start point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CourseOut" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the course associated with the RF leg type end point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArcInitialPoint" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the initial point at which the arc turn starts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArcEndPoint" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the end point at which the arc turn terminates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArcDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the distance along the arc turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ArcDirectDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the direct distance between the start of the arc turn and the end of the arc turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnDirection" type="uci:RelativeDirectionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the starting direction of turn commencement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ReportID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ReportMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_ReportID" type="uci:RF_ReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the RF_Report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_ReportState" type="uci:RF_ReportStateEnum">
				<xs:annotation>
					<xs:documentation>Identifies whether the report is new, updated, or removed. If removed, the receiving subsystems shall delete the associated ConfigureInteroperabilityReportIndices from their data (such as data used to determine which CIRs to blank), as the RF emission is ended.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Operation" type="uci:RF_OperationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>For each waveform used, an RF_Operation block.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActiveProfile" type="uci:RF_ProfileType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an RF_Profile that is currently active due to RF_ControlCommand message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ReportMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:RF_ReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to RF_ResourceAllocation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationMDT" uci:version="003.002.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_ResourceAllocationID" type="uci:RF_ResourceAllocationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the RF_ResourceAllocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Allocations" type="uci:RF_ResourceAllocationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Allows multiple allocations to be sent in a single RF_ResourceAllocationMDT.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Message type used in response to a successful RF_ResourceAllocationRequest.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:RF_ResourceAllocationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestDigitalRemovalType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Defines content necessary when an allocation or part of an allocation is being ended by the requesting Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StreamIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to a specific usage of a DigitalThreadInstanceIndex, assigned by ResourceAllocator at allocation time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MFA_Address" type="uci:MFA_AddressType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Antenna and associated resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestMDT" uci:version="003.002.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="ResourceAllocator_SupportCapabilityID" type="uci:SupportCapabilityID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The SupportCapabilityID of a Resource Allocator, which may be at the system level or in the MFA, who is the subject of the request and expected to make a ApertureResourceAllocation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TerminatedResources" type="uci:RF_ResourceAllocationRequestRemovalType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Included when the sibling RequestState is CANCEL and the requesting function is not in a terminal state (i.e. function still requires other resources).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestingFunction" type="uci:RequestingFunctionID_ChoiceType">
						<xs:annotation>
							<xs:documentation>Resource Requests are associated with an Activity or a BIT/Cal State. This provides the correlation between an activity, a BIT, or a Calibration.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Ranking" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>The requesting subsystem reports the current Ranking information to the Resource Allocator, allowing for the ResourceAllocation management function to be independent of system command handling (the other source of Ranking information). Optional if RequestState is CANCEL.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PointingVectorParameters" type="uci:AperturePointingOptionsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The list of different coverage parameters based on bandwidth/service type.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResourceRequestOptions" type="uci:ResourceRequestOptionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Each entry in this array represents an option that can be used to fill the resource request. Only one option will be allocated. They are assumed to be in order of preference. Optional only in the case of REMOVE. If omitted for REMOVE, all allocations to the Activity will be deallocated.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>Message type used with Shared RF antenna subsystems to request a resource allocation from a Resource Manager.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:RF_ResourceAllocationRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestRemovalType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Defines content necessary when an allocation or part of an allocation is being ended by the requesting Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RemoveRF_Resources" type="uci:RF_ResourceAllocationRequestRF_RemovalType">
				<xs:annotation>
					<xs:documentation>ID (Index) of a RF path through the RFD component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoveDigitalResources" type="uci:RF_ResourceAllocationRequestDigitalRemovalType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Support Capability UUID(s) of the antenna associated with the RFTI.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestRF_RemovalType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines content necessary when an allocation or part of an allocation is being ended by the requesting Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_ThreadInstanceIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifier of the RF_ThreadInstance associated with the resource allocation. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. RF_ThreadInstanceIndices may be re-used after an allocation has been de-allocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaAndResourceInstance" type="uci:AntennaAndResourceInstanceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Antenna and associated resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestStatusMDT" uci:version="001.001.002.001">
		<xs:annotation>
			<xs:documentation>Message Data Type for requesting the status of a Resource Request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="RF_ThreadInstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifier of the RF_ThreadInstance associated with the resource allocation. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. RF_ThreadInstanceIndices may be re-used after an allocation has been de-allocated. Optional if the Reference Resource Request allocation is rejected in the set up process.  Status refers to the complete allocation so the number of RFTII must match the number in the allocation (as defined by mode T, R or T/R).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AllocationState" type="uci:ResourceAllocationStatusEnum">
						<xs:annotation>
							<xs:documentation>Indicates the state of the Allocation, as described in the Enum.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AllocationStateReason" type="uci:CannotComplyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the sibling State element.  This element is only expected when the Command is in a potentially undesirable state such as rejected, removed or accepted with less than optimum results expected.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationRequestStatusMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:RF_ResourceAllocationRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RF_ResourceAllocationType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceRequestID" type="uci:RequestID_Type">
				<xs:annotation>
					<xs:documentation>ID assigned by the requesting Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestingFunction" type="uci:RequestingFunctionID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Resource Requests are associated with an Activity or a BIT/Cal State. This provides the correlation between an activity, a BIT, or a Calibration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAllocationState" type="uci:ResourceAllocationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates a new resource allocation or a modification to a previous one.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DurationRange" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time for which the resource allocation is valid. No Duration implies now to Infinity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConfigureInteroperabilityReportIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element contains the value of ConfigureInteroperabilityReport_Index (CIR_Index) that a transmitting subsystem will use to describe the transmission associated with the Activity. The RF_Report message describes the transmission and refers to the CIR_Index. Blanking functions send blanking commands by CIR_Index. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. CIR_Indices may be re-used after an allocation has been de-allocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceDefinitions" type="uci:ResourceDefinitionChoiceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Allocation may choose either digital or RF resources, bases on the RF_ResourceAllocationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_TaskNormalizedMetricsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to provide the metric ID and elements to normalize, along with interpolation method, for the tasked capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the CapabilityID of the Capability that is the target of the allocation constraint.  If multiple required Capabilities are given: 1) allocation to any one of the Capabilities is the minimum expectation, 2) decomposition of the Task into multiple child Tasks allocated across the multiple required Capabilities is acceptable, 3) there is no expectation that each Capability must perform the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MetricIdentifier" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>ID of the performance metric. Valid IDs can be found in the service contract.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterpolationEnum" type="uci:NormalizationInterpolationEnum">
				<xs:annotation>
					<xs:documentation>How the received performance feedback should be interpolated using the sibling NormalizationElements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalizationElements" type="uci:NormalizationTableType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Actual performance values with their corresponding normalized value using the sibling interpolation type. Provides a mapping of actual performance metric values to their normalized versions.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_TaskPerformanceConstraintType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Type to provide values for performance metrics for a capability defined in a service contract.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PerformanceConstraint" type="uci:PerformanceMetricSetType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Set of performance constraints metrics, negotiable options, order of importance, and  ID assigned to that performance constraint for a defined capability in its service contract documentation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the CapabilityID of the Capability that is the target of the TaskPerformanceConstraint. The CapabilityID is filled in when there are multiple metrics for a given Capability (e.g: POI and Range for ESM).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_TaskPerformanceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized for tasking Capabilities that utilize RF_Shared apertures, providing the PerformanceConstraints and associated NormalizationMetrics for the Resource Allocator to use in selecting resources to satisfy the objectives of the task.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PerformanceConstraints" type="uci:RF_TaskPerformanceConstraintType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Set of performance constraints and their order of importance for a capability defined in the Service Contract.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalizedMetrics" type="uci:RF_TaskNormalizedMetricsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Set of normalization tables to be used to normalize performance feedback received while executing this task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ThreadFeedbackType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>Utilization feedback for each of an RFD component's RF paths.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_ThreadIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>ID (Index) of a RF path through the RFD component. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Availability" type="uci:ThreadAvailabiltyEnum">
				<xs:annotation>
					<xs:documentation>Availability of the RF Thread ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccess" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percentage of time where access requests that used the thread are being granted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RF_ThreadInstanceCommandType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SetupRF_ThreadInstance" type="uci:SetupRF_ThreadInstanceType" maxOccurs="unbounded">
				<xs:annotation>
