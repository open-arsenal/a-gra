			</xs:element>
			<xs:element name="DwellFOV" type="uci:NED_ConeType">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's Field of View details associated with the pulse data collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointTarget" type="uci:PointTargetType">
				<xs:annotation>
