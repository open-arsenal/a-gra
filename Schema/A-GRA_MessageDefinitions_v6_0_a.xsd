			<xs:element name="ColorDepth" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the number of discrete color values in each band, e.g. 8-bit color representation will require a value of 256.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
