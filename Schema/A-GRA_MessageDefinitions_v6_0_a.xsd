			</xs:element>
			<xs:element name="RelativeOffset" type="uci:RelativeOffset3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Positional data relative to the reference frame origin.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Point4D_Type" uci:version="001.000.002.002">
		<xs:annotation>
			<xs:documentation>This type represents positional data. The latitude and longitude, relative to the WGS-84 ellipsoid, are mandatory entries along with altitude and time. If AltitudeReference is not specified, altitude is the WGS-84 height above the ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Latitude" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Geospatial latitude measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Longitude" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Geospatial longitude measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Altitude" type="uci:AltitudeType">
				<xs:annotation>
					<xs:documentation>Height measured in meters using the reference specified by the AltitudeReference field. If AltitudeReference is not specified, then the reference is to be taken as WGS-84 ellipsoid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeReference" type="uci:AltitudeReferenceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to altitude measurement source.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time when the positional data was measured or last known to be correct.  The element can also indicate the time at which a future position of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepthCategory" type="uci:Link16DepthEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Expresses source PPLI depth by description of horizontal planes at or below Mean Sea Level (MSL)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HAE_Adjustment" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Difference in meters between the MSL and HAE altitudes of an object. MSL + HAE_Adjustment = HAE, per MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PointChoice3D_Type" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies a location either as a geospatial location or a location relative to a separately defined reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AbsolutePoint" type="uci:Point3D_Type">
				<xs:annotation>
					<xs:documentation>Contains a geospatial location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point3D_RelativeType">
				<xs:annotation>
					<xs:documentation>The offset of the location from the origin of the separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PointChoice4D_Type" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Specifies a location either as a geospatial location or a location relative to a separately defined reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AbsolutePoint" type="uci:Point4D_Type">
				<xs:annotation>
					<xs:documentation>Contains a geospatial location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point4D_RelativeType">
				<xs:annotation>
					<xs:documentation>The offset of the area from the origin of the reference frame at the time provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PointChoiceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies a location either as a geospatial location or a location relative to a separately defined reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AbsolutePoint" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Contains a geospatial location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point2D_RelativeType">
				<xs:annotation>
					<xs:documentation>The offset of the area from the origin of the reference frame specified by the sibling field.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PointingPlanWindowType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>A Time bounded list of Pointing Vector commands that are to be used to support an external communication allocation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AllocationID" type="uci:CommScheduleAllocationID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is a reference to possible communication allocation the Vector is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommSystemID" type="uci:CommSystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the communication system that is providing support for this communication allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RoutePlan" type="uci:RoutePlanReferencesType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates RoutePlan or Plans or portion of a RoutePlan supported by this Pointing Plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommPointing" type="uci:CommPointingType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Represents the list of time bounded Pointing Vectors that will need to be commanded to the communication system to support a set of mission plans.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PointingType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>Indicates the position or location to point the XX Subsystem to do a XX collection, track, or search as part of an XX Activity. If the XX Subsystem cannot point itself, then the TurretSlaved Type is used. If the system wants to allow the subsystem to control its own LOS then the ActivitySlavedID is used. FixedPointing is used to point to a predetermined location defined by its Enum values.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Geospatial" type="uci:TargetType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the source of or explicit values for geospatial characteristics of the target of the Command. When multiple points/targets are given, a best-fit, multi-track or similar behavior is expected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LOS_Option" type="uci:LOS_D_Type">
				<xs:annotation>
					<xs:documentation>Indicates body or inertially referenced line of sight pointing angles and/or rates as the "target" of the Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Volume" type="uci:PO_AirTargetVolumeCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the volume or specific Entity that defines the extents of the spatial region covered by the command. For non-cued Capabilities, one air volume instance of this element is expected. For cued Capabilities, two instances of this element are allowed: one with an Entity specified and a second with an air volume that define the extents of the cue volume around the Entity. For cued Capabilities, a single instance is allowed if it is an Entity in which case the Entity location uncertainty defines the extents of the cue volume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurretSlaved" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates a Pointing Command that has an accompanying TurretCommand that determines the "target" of the Command. The XX Capability is then pointed/targeted by the TurretCommand with other command details coming from the XX_Command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivitySlavedID" type="uci:ActivityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a Pointing Command that has a secondary/coupled Activity, possibly of another Capability type such as AO or PO, that determines pointing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FixedPointing" type="uci:FixedPointingEnum">
				<xs:annotation>
					<xs:documentation>Indicates that a subsystem with point to a predetermined location defined by its Enum values.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PointingVectorParameterType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The name of this bandwidth or service type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LossParameter" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The expected loss parameter at which communications cannot be maintained for this service/bandwidth type. A common range is [0,1000].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ellipse" type="uci:EllipseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The expected footprint of transmissions from the communication equipment being pointed, for this service/bandwidth type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PointTargetType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Point" type="uci:PointChoiceType">
				<xs:annotation>
					<xs:documentation>For moving targets, it is highly recommended that the time data be populated.  Generally, services are encouraged to provide altitude and/or time data whenever it is known. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For moving targets, this element indicates the target's velocity.  Generally, services are encouraged to send down velocity whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Positional uncertainty of the sibling Point element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PolarizationControlType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>If two polarizations are commanded, duration is a required field. During operation the antenna will automatically switch between polarizations with each polarization being transmitted for the time defined by duration filed before switching to the other polarization. Required for NEW commands.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PortPolarization" type="uci:PolarizationPortEnum">
				<xs:annotation>
					<xs:documentation>Indicates the polarization of the port in use by the command. PolarizationDescription must be present if the PolarizationType is ARBITRARY_POL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Duration polarization is present prior to switching polarization sense.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PolarizationDescription" type="uci:PolarizationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Required when sibling polarization type is arbitrary.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PolarizationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines the geometrical orientation of RF wave oscillations.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PolarizationTiltAngle" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tilt angle of the polarization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PolarizationAxialRatio" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Axial ratio of the polarization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PolarizationSense" type="uci:PolarizationSenseEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Left handed or right handed polarization sense.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PolarizationCharacter" type="uci:PolarizationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Character of the polarization.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PolarMotionType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Contains the x and y coordinates of polar motion.  Reference http://www.iers.org/IERS/EN/Science/EarthRotation/PolarMotion.html.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:ArcSecondsType">
				<xs:annotation>
					<xs:documentation>The X position of the pole in the direction of Greenwich, units of arcsec. A common range is [-10,10].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:ArcSecondsType">
				<xs:annotation>
					<xs:documentation>The Y position of the pole facing toward the East, units of arcsec. A common range is [-10,10].</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PolygonPointChoiceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies a polygon by geospatial locations or as locations relative to a separately defined reference frame.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point2D" type="uci:Point2D_Type" minOccurs="3" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Geospatial points defining the vertices of a polygon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePolygon" type="uci:PolygonRelativeType">
				<xs:annotation>
					<xs:documentation>Indicates a polygon that is relative to a separately defined reference frame defined in ReferenceFrames message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PolygonRelativeType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates a polygon that is relative to a separately defined reference frame defined in ReferenceFrame message.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ReferenceFrameID" type="uci:ReferenceFrameID_Type">
				<xs:annotation>
					<xs:documentation>UUID of the reference frame object that this offset applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Vertex" type="uci:RelativeOffset2D_Type" minOccurs="3" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A relative polygon has a minimum of 3 vertices relative to the reference frame origin.  All points in the list are relative to the reference frame origin, i.e. none of the points is assumed to be the reference point or origin of the reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PolygonType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>Specifies a polygon.  The vertices of the polygon can be specified by geospatial locations or as locations relative to a separately defined reference frame.
Simple polygons (including those in which interior polygons are defined within a bounding polygon) are supported.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LineProjection" type="uci:LineProjectionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of lines that form the BoundingPolygon and any InteriorPolygon definitions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BoundingPolygon" type="uci:PolygonPointChoiceType">
				<xs:annotation>
					<xs:documentation>Geospatial points defining the vertices of a simple polygon (i.e closed and non-intersecting).  These points are ordered and assumed to be unique.  Closure is assumed between the final point and the first point. Smaller polygon areas within the BoundingPolygon can be excluded from its functional/operational purpose using the sibling InteriorPolygon element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InteriorPolygon" type="uci:PolygonPointChoiceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Geospatial points defining the vertices of a simple polygon (i.e closed and non-intersecting) whose vertices lie wholly inside the BoundingPolygon and whose edges do not intersect with other InteriorPolygon definitions.  These points are ordered and assumed to be unique.  Closure is assumed between the final point and the first point.  The area within an InteriorPolygon is functionally/operationally equivalent to the area outside the sibling Bounding Polygon.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PortConfigurationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PortID" type="uci:CommUserIO_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique identifier of the I/O component being configured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Configuration" type="uci:IO_PortConfigurationStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the I/O component specific configuration changes that are being commanded.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PositionAccelerationCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PnAn" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-North position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PnAe" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-East position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PnAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Down position-acceleration covariance with units of meters squared per second squared. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeAn" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-North position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeAe" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-East position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Down position-acceleration covariance with units of meters squared per second squared. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PdAn" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-North position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PdAe" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-East position-acceleration covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PdAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-Down position-acceleration covariance with units of meters squared per second. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PositionAndVelocityCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PositionPosition" type="uci:PositionPositionCovarianceType">
				<xs:annotation>
					<xs:documentation>Indicates position-position covariance in the NED coordinate system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionVelocity" type="uci:PositionVelocityCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates position-velocity covariance in the NED coordinate system.  Required when the sibling Velocity-Velocity covariance is given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocityVelocity" type="uci:VelocityVelocityCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates velocity-velocity covariance in the NED coordinate system.  Required when the sibling Position-Velocity covariance is given.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PositionLocationUncertaintyType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Location" type="uci:Point3D_Type">
				<xs:annotation>
					<xs:documentation>This defines the ownship location at the start of the predicted collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Uncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Uncertainty of the physical location of the referenced item.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PositionOrientationCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PnRr" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Roll position-angle covariance with units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PnRp" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Pitch position-angle covariance with units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PnRy" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Yaw position-angle covariance with units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeRr" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Roll position-angle covariance with units of meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeRp" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Pitch position-angle covariance with units of meters.</xs:documentation>
				</xs:annotation>
