					<xs:documentation>Indicates a landing event.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INGRESS">
				<xs:annotation>
					<xs:documentation>Indicates an ingress event into the mission area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EGRESS">
