			</xs:element>
			<xs:element name="KinematicsSource" type="uci:OrbitalKinematicsSourceEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics source to use for the surveillance of the object indicated by the sibling SatelliteIdentity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitKinematicsOverride" type="uci:OrbitKinematicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Use this type when the cataloged orbit is different than the orbit you have.  Use this for lost items, items that have maneuvered, and items that have changed orbital states between the last cataloging and the current orbital state. If searching in the expected or last reported orbit, omit this value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalSurveillanceObjectsType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Indicates the primary object or search space of the orbital surveillance task with the option to specific one or more secondary objects or search spaces.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PrimaryObject" type="uci:OrbitalSurveillanceObjectType">
				<xs:annotation>
					<xs:documentation>The object, coordinates, or search space to be collected on.  If there are multiple objects that are part of the task, additional objects will be specified as secondary objects.  If information is required to be specified relative to an object or coordinate, this is the reference point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SecondaryObjects" type="uci:OrbitalSurveillanceObjectType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Additional objects for related collections.  This is used in cases where it is important that collections on multiple objects be conducted in a coordinated fashion, particularly when the information of interest is on one object relative to another.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitalSurveillanceObjectType" uci:version="003.000.001.000">
