	</xs:complexType>
	<xs:complexType name="SAR_SubCapabilityType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadarPointingTarget" type="uci:RadarPointingTargetType">
				<xs:annotation>
					<xs:documentation>Indicates the target of the SAR Command via explicit values for geospatial characteristics or sensor referenced coverage area.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MultiLook" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to perform multi-look SAR based on the Command's Repetition element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EllipticityPolicy" type="uci:SAR_EllipticityPolicyEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the policy to use for ellipticity. Policy is specified to indicate minimum dwell, maximum dwell, or minimum ellipticity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllowableEllipticityMagnitude" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the allowable ellipticity for activities created from this command.  This value is a magnitude less than or equal to -1.0 or greater than or equal to 1.0.  Positive values indicate range resolution is favored, negative values indicate azimuth resolution is favored.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumBeamRolloffDB" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum beam roll-off.  Used to limit effects of a non-uniform antenna beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NPAR_Details" type="uci:SAR_SubCapabilityNparDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether to perform a number of processing techniques.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClutterParameters" type="uci:SAR_SubCapabilityClutterParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If populated, this field controls clutter parameters used in executing this command and can be used to specify the minimum quality for feasibility of a collection.  Achieved performance may be reported in the SAR_Activity message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_TargetType" uci:version="002.000.002.000">
