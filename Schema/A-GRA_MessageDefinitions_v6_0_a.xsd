		</xs:annotation>
		<xs:sequence>
			<xs:element name="MinimumCNR" type="uci:DecibelType">
				<xs:annotation>
					<xs:documentation>Desired minimum (absolute) Clutter-to-Noise Ratio (CNR) to be achieved from this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Gamma" type="xs:double">
				<xs:annotation>
					<xs:documentation>Gamma value that describes the clutter to be used in calculating the Clutter-to-Noise Ratio (CNR).  This element is intentionally unitless.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SAR_SubCapabilityNparDetailsType" uci:version="000.000.000.000">
