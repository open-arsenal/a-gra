			<xs:documentation>Allowable track offset setting parameters (Azimuth/Elevation/Roll and Azimuth/Elevation/Roll Rates) from the center of the LOS of the PO sensor.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AzimuthSettings" type="uci:DoubleMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed values for the LOS in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationSettings" type="uci:DoubleMinMaxType">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed values for the LOS in elevation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RollSettings" type="uci:DoubleMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed values for the LOS in roll.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatesSettings" type="uci:RatesSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maximum and minimum allowed rates for the LOS in azimuth, elevation and roll.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
