			<xs:element name="ActivityPlanningResult" type="uci:RequirementPlanningResultType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates planning results per Requirement.  This element is only expected when the RouteActivityPlan was found to be invalid and the associated RouteActivityPlanValidationCommand indicated "modify to validate" was allowed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModifiedPlanID" type="uci:RouteActivityPlanID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a modified, valid version of the evaluated plan.  This element should only be given when the evaluated plan was found to be invalid, the evaluation command indicated modification was allowed, and the modifications resulted in a valid plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
