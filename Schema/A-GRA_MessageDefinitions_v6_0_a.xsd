					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:CounterSpaceDeconflictionMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CounterSpaceReportID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An ID type for a CounterSpaceReport.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CounterSpaceReportMDT" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>A data type summarizing the CounterSpace environment and activity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CounterSpaceReportID" type="uci:CounterSpaceReportID_Type">
				<xs:annotation>
					<xs:documentation>Unique number for the report given a cycle number, version, and reporting location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportPeriod" type="uci:DateTimeRangeType">
				<xs:annotation>
					<xs:documentation>Period over which the report is reporting activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CS_Header" type="uci:CS_HeaderType">
				<xs:annotation>
					<xs:documentation>Data that appears once in the document/report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CS_Assessment" type="uci:CS_AssessmentType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Report of the CounterSpace environment and engagements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CounterSpaceReportMT" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>Message type for a CounterSpaceReport.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:CounterSpaceReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CounterSpaceTaskType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents a task for a CounterSpace capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ForceName" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The name of the tasked force for reference with the external (non-UCI) tasking system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EngagementData" type="uci:CS_EngagementDataType">
				<xs:annotation>
					<xs:documentation>Engagement data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CountryCodeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="CountryName" type="uci:GENC_CountryNameEnum">
				<xs:annotation>
					<xs:documentation>Indicates the actual Country name from the GENC Standard.  It is important to note that FIPS PUB 10-4 and GEC are not explicitly supported; there will be no Country names that conform to either FIPS PUB 10-4 or GEC legacy standards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorUniqueAssetName" type="uci:OperatorUniqueNameEnum">
				<xs:annotation>
					<xs:documentation>Indicates a name for an affiliated asset reported by the Operator(s) that is outside the scope of the GENC Standard.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CovarianceMatrixType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The container for the covariance matrix and its associated category. The category enum value annotation specifies the shape and number of terms in the covariance matrix that are being represented.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Category" type="uci:CovarianceMatrixCategoryEnum">
				<xs:annotation>
					<xs:documentation>Specifies what terms in the covariance matrix are being represented.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Covariance" type="xs:double" minOccurs="6" maxOccurs="120">
				<xs:annotation>
					<xs:documentation>The terms of the covariance matrix. The terms are provided in order of appearance in the lower triangular half of the matrix from element 1,1 (item 1) through the last element used in the correction. The diagonal terms are the variances of the solution parameter, and the off-diagonal terms are the covariances.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CropSettingsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates cropping of a frame and specifies the origin, position, width, and height of the crop.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Origin" type="uci:FrameOriginEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Origin (0, 0) of the frame. Default is TOP_LEFT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="X_Position" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Horizontal position from where to begin cropping, starting from the Origin.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y_Position" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Vertical position from where to begin cropping, starting from the Origin.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Width" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Width in pixels along the x-axis of the cropped frame, starting at the X_Position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Height" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Height in pixels along the y-axis of the cropped frame, starting at the Y_Position.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CropType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates cropping of a frame and specifies the origin, position, width, and height of the crop.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Enable" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the frame will be cropped when true.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Settings" type="uci:CropSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Configures the Origin, X Position, Y Position, Width, and Height of the cropped area.  If not specified, previously set Service defaults will be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoCommandMDT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>This type represents a command to control a crypto slot.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:CryptoCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a command instance.  Multiple command instances allow a sequence of related commands to be described in a single coherent message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoCommandMT" uci:version="002.002.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CryptoCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoCommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SupportCapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoCommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:CryptoCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoCommandType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents a command to control a crypto slot.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SupportCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="SupportActivityID" type="uci:ActivityID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The ID of the Activity (Instance) of the communication capability which this is applicable to. If empty, means all.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Zeroize" type="uci:CryptoLocationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Perform a zeroize action for the following Cryptographic Slots / Groups. Slot / Group data is advertised in the CryptoStatus Message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Rollover" type="uci:CryptoRolloverCommandType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Perform a rollover action for the following Cryptographic Groups. Group data is advertised in the CryptoStatus Message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Load" type="uci:CryptoLoadCommandType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Perform a load action for the identified Cryptographic Groups / Slots. Group / Slot data is advertised in the CryptoStatus Message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoKeySourceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type represents the source of a key.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="KeyFileID" type="uci:FileLocationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a file to read the key from.  Would support either a red or black key file (usually black) depending on system design.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DS101" type="uci:CryptoDS101_Enum">
				<xs:annotation>
					<xs:documentation>Indicates to enable or disable DS101 load actions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OTAM" type="uci:CryptoOTAM_Enum">
				<xs:annotation>
					<xs:documentation>Indicates to initiate an over the air management action associated with the identified key.  Valid for those crypto capable capabilities that have receive / transmit capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="CryptoLoadCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type represents all the information needed for a crypto load command.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="KeyDestination" type="uci:CryptoLocationType">
				<xs:annotation>
					<xs:documentation>Indicates the crypto element or elements to be loaded by this command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KeySource" type="uci:CryptoKeySourceType">
				<xs:annotation>
					<xs:documentation>Indicates the source for the key material to load.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoadScheduleTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the time at which to perform the load.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoLoadStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates detailed information about current load activities. Allows keys to be grouped based upon their load status.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LoadState" type="uci:CryptoLoadStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current load state for the contained set of key slots.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypeOfLoad" type="uci:CryptoLoadTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the method of key load associated with the reported state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlotIdentifier" type="uci:CryptoSlotIdentifierType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the key slots associated with the reported load state. If not present, the whole CryptoSlotGroup is impacted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoadTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Optional element to qualify the state (scheduled time, completed time).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoLocationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type represents the crypto location to perform a command on.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CryptoSlotGroupID" type="uci:CryptoSlotGroupID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the crypto slot group to perform an action on.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CryptoSlotIdentifier" type="uci:CryptoSlotIdentifierType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the crypto slot or slots to perform an action on.  If not present, then the action will be applied to the whole group.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoPortID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to crypto ports.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoPortStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type specifies status information about a crypto port.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CryptoPortID" type="uci:CryptoPortID_Type">
				<xs:annotation>
					<xs:documentation>Uniquely identifies each input and output port available in a crypto component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EncryptedDataSink" type="uci:DataPortType">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem component that the crypto component will send the data payload to after data encryption.  The data sink will (typically) be a BLACK side modem that will broadcast the encrypted data over the communication medium.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DecryptedDataSink" type="uci:DataPortType">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem component that the crypto component will send the data payload to after data decryption. The data sink will (typically) be an I/O component, but may be relayed to a crypto port that will encrypt the data and relay it to its corresponding data sink.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActiveCryptoType" type="uci:CryptoTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the state information about the encryption or decryption type that is applied to payload data sent to this crypto port.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailableCryptoType" type="uci:CryptoTypeEnum" minOccurs="0" maxOccurs="14">
				<xs:annotation>
					<xs:documentation>Indicates the different encryption/decryption capabilities that are available to the crypto component associated with this crypto port. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoRolloverCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type represents a crypto rollover command.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CryptoRolloverTarget" type="uci:CryptoLocationType">
				<xs:annotation>
					<xs:documentation>Indicates the crypto element or elements addressed by this rollover command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CryptoRolloverAction" type="uci:CryptoRolloverActionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the rollover action to take. Action identifies either an immediate rollover, a scheduled rollover, or to cancel a pending rollover.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RolloverScheduleTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the time at which to rollover.  Only valid for Rollover action of SCHEDULE.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ZeroizePreviousSlot" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Optional element indicating whether to zeroize (True) the previous crypto slot group.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoRolloverStatusType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents the status of a crypto rollover.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RolloverState" type="uci:CryptoRolloverStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current rollover state of the key slot.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RolloverTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Optional element to qualify the state (scheduled time, completed time or canceled time).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoSlotGroupID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to crypto slot groups.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CryptoSlotGroupType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents information about a crypto slot group. A crypto slot group can contain one or more crypto slots.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CryptoSlotGroupID" type="uci:CryptoSlotGroupID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the group of keys.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the ID of a Capability whose use requires operation of the crypto key slot.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CryptoSlotGroupState" type="uci:CryptoSlotGroupStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the current state of the group as a whole.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurrentSlotIdentifier" type="uci:CryptoSlotIdentifierType">
				<xs:annotation>
					<xs:documentation>Indicates the current slot which will is typically the slot being actively used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RolloverMethod" type="uci:CryptoRolloverMethodEnum" maxOccurs="5">
				<xs:annotation>
					<xs:documentation>Indicates which types of key rollover are available for this group of crypto keys. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoadStatus" type="uci:CryptoLoadStatusType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates detailed information about current load activities.  Allows keys to be grouped based upon their load status.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SlotInformation" type="uci:CryptoSlotType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates detailed information about each crypto slot within a group of crypto key slots.  This includes state of the key slot, the next slot in a link list of slots (with respect to rollover, if applicable), and unique ID for the key.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CryptoSlotType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This type represents information about a crypto slot.</xs:documentation>
