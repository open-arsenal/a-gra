					<xs:documentation>Set the gain.  This value is expected to comply with the allowed values defined by the subsystem program related documentation, or as published in the EW_Configuration message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CenterFrequency" type="uci:FrequencyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Define a center frequency or a list of center frequencies to be scanned.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanRange" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
