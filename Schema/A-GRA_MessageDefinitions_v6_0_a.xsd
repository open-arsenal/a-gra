				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BY_CONFIDENCE">
				<xs:annotation>
					<xs:documentation>Indicates that the possible identifications should be listed in order of the highest level of confidence to the lowest level of confidence in the identification.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AMTI_CapabilityEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the first tier in the taxonomy of the radar Airborne Moving Target Indicator (AMTI) Capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="VOLUME">
				<xs:annotation>
					<xs:documentation>Indicates a generally persistent AMTI Capability to search a large geospatial volume for airborne moving targets, generally using many beams.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CUED">
				<xs:annotation>
					<xs:documentation>Indicates a generally short, focused AMTI Capability to search for and acquire a specific airborne moving target in a small geospatial volume.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Indicates an AMTI Capability to track a specific airborne moving target in a small geospatial volume.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AMTI_MessageOutputsEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates a message that is an output of the Capability.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AMTI_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message.  For example, the ESM_Activity message for an ESM Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the ObservationMeasurementReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AMTI_SubCapabilityEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates a SubCapability that is available with the Capability.  For AMTI, SubCapabilities indicate specific AMTI waveforms and/or processing techniques.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NAS">
				<xs:annotation>
					<xs:documentation>Indicates a capability to search and detect nose aspect targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AAS">
				<xs:annotation>
					<xs:documentation>Indicates a capability to search and detect all aspect targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVE_TRACK_UPDATE">
				<xs:annotation>
					<xs:documentation>Indicates a capability to perform track updates with an active track waveform.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AUTO_SUBCAPABILITY_SELECT">
				<xs:annotation>
					<xs:documentation>Indicates a SubCapability that is selected automatically by a Subsystem, as specified in its software/OFP and/or its Mission Data Files (MDF). Unlike the AUTO CapabilityType option in other Capabilities, this option allows the Subsystem to accept Command Message and provide responses.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
