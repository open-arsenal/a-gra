	<xs:complexType name="PO_ConstraintControlsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnableDisable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the collection constraint.  Setting to false will disable it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoEnableDisable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable automatic enabling/disabling of the constraint at the discretion of the Subsystem.  Setting this field to false will disable automatic enabling/disabling.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to reset to the collection constraint to factory/default configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
