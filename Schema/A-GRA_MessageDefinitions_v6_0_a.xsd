				</xs:annotation>
			</xs:element>
			<xs:element name="DataRecorderOnboard" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Store reported value for Data recorder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntiJamCapable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Store reported value for Anti-Jam Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GPS_Capable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Store reported value for GPS Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SeekerOnboard" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Store reported value for Seeker Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreStationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StationIndex" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Indicates the system-specific logical/named carriage station index/position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompatibleStore" type="uci:StoreType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of compatible store types for the carriage station.  May be included to assist with logistics and weapon load-out management.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InstalledStore" type="uci:StoreType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the currently installed store type for the carriage station.  Optional in case none are installed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the primary Capability instance associated with the store.  This element is required when a store is installed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreStatusBaseType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreState" type="uci:StoreStateEnum">
				<xs:annotation>
					<xs:documentation>The current Store station status.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreStateDetail" type="uci:StoreStatusDetailsType">
				<xs:annotation>
					<xs:documentation>Possible store settings that could be used to give more detailed information about the state or extra data related to the attached Mission store.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreStateReason" type="uci:CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contains data indicating why an action resulted in "Cannot comply".</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreStatusDetailsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Possible store settings that could be used to give more detail information about the state or extra data related to the attached Mission store.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="INS_ENABLE" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>INS is working.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GPS_ENABLE" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>GPS is working.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TARGETED" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Is targeted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SELECTED_JETTISON" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the store has been selected to jettison only used for SELECTIVE jettisonable from StrikeCommandSettings.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreStatusType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Possible store settings that could be used to id the state or extra data related to the attached Mission or Carriage Store.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StoreType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreType" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "store type" or weapon type. Derived from MIL-STD-6016; For StoreCategory=AIR use DFI=1623 DUI=001. For SEA_SURFACE use DFI= 399 DUI=004. For SEA_SURFACE_SAMSSM use DFI=1622 DUI=001. For SEA_SUBSURFACE use DFI=399 DUI=004. For GROUND use DFI=399 DUI=004. For GUN StoreType indicates that there is a gun present. This schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreCategory" type="uci:StoreCategoryEnum">
				<xs:annotation>
					<xs:documentation>Indicates which MIL-STD-6016 enumeration should be used to interpret the StoreType field.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreTypeVariant" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variant is used to declare a specific sub-type of the weapon called out in the StoreType element. The MIL-STD-6016 weapon type list does not include all possible differences in warhead fusing, store configuration, and other small details. This field allows an option addition of information to cover this gap.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StoreVerificationStatusType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is the verification state for this Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VerificationState" type="uci:MessageDataVerificationEnum">
				<xs:annotation>
					<xs:documentation>Current reported verification state of the capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerificationStateReason" type="uci:CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the reason the verification was not successful.  This should be provided when the verification is not successful.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mnemonic" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Mnemonic representation of the self-reported store identification during the verification process.  There are smart weapons that can report identifying information to the vehicle such as a store name.  This field can be used to hold that information so it can be reported to an operator and allow for manual verification of a loadout when the actual store on the vehicle differs from the planned store.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StrengthRangeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines the strength range for a track.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Minimum" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum estimated strength. If no value is provided a minimum value of 0 is assumed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Maximum" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum estimated strength. If no value is provided the strength is defined as &gt;StrengthMin.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StrengthType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines the minimum, maximum strength values and the percentage of tracked vehicles associated with an Entity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StrengthValue" type="uci:StrengthRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the number of objects/entities represented by this Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleCount" type="uci:StrengthRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the total number of vehicles associated with the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentTracked" type="uci:PercentRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percentage of ground vehicles that are tracked type vehicles.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StrikeActivityCommandType" uci:version="002.001.002.000">
