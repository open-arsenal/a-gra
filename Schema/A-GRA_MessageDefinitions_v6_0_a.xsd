					<xs:documentation>The list of frequency ranges that form the scan list.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanLockout" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The list of frequencies that the subsystem should not scan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellTarget" type="uci:COMINT_AcquisitionTargetType" minOccurs="0">
