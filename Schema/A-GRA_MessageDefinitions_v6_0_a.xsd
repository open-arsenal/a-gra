						<xs:annotation>
							<xs:documentation>Indicates the Op* being commanded. Leaving this blank makes the command apply to all Op* IDs</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommandedState" type="uci:OpStateEnum">
						<xs:annotation>
							<xs:documentation>Indicates the desired state of the Op* instance listed in the OpID</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Rank" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>Indicates the precedence and priority levels of the particular data payloads being sent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConstraintOverride" type="uci:MA_OpConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates refined/overridden values of constraints for the Op*. Added to allow similar override options in direct commanding as is available in Op* planning.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OverrideRejection" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates that the Command shall be performed even though it was previously rejected.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Traceability" type="uci:TraceabilityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>C2 sources work at different levels of detail and abstraction, progressing from what to do to how specifically to do it. This element provides traceability to the external tasking from which this Op* command was derived.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
