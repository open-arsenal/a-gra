				</xs:annotation>
			</xs:element>
			<xs:element name="Speed" type="uci:PathSegmentSpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the speed to maintain during the hold pattern.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Orientation of the hold, defined as the course along the inbound leg.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnDirection" type="uci:RelativeDirectionEnum" minOccurs="0">
