			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DamageEstimateMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DamageEstimateID" type="uci:DamageEstimateID_Type">
				<xs:annotation>
					<xs:documentation>The identifier used to uniquely address the collection of damage estimate information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimateType" type="uci:DamageCategoryEnum">
				<xs:annotation>
					<xs:documentation>Indicates the specific data or circumstance the estimate was performed upon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaskID" type="uci:TaskID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the Task which the damage estimate is based upon.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReleasePoint" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the release point associated with any air corridor violation or violations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompletionTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the estimate was completed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimateZone" type="uci:ZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the zone where damage was assessed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportingThreshold" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the minimum damage probability threshold necessary for estimated damage to be included in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Details" type="uci:DamageEstimateDetailsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the details of the damage estimate.  If omitted there is no damage expected/estimated.  If EstimateType=Collateral, the desired result is for this element to be omitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Violation" type="uci:DMPI_ViolationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates any air corridors violated from the release point to the indicated DMPI, or any NoFire OpVolume/OpZone collateral damage by the indicated DMPI.   If EstimateType=Collateral, the desired result is for this list to be empty.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Summary" type="uci:DamageSummaryType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates summary human damage.  Human damage can possibly overlap and be double-counted in the by object and by probability estimate.  This element allows a non-overlapping summary of estimated human damage along with an indication of the overall significance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimateNarrative" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates additional estimate detail in a human readable text description.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InformationSource" type="uci:DamageInformationWeatherSourceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the source or sources of information used to make the damage estimate.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamageEstimateMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:DamageEstimateMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DamageEstimateRequestMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="EstimateType" type="uci:DamageCategoryEnum">
						<xs:annotation>
							<xs:documentation>Indicates the specific data or circumstance the estimate was performed upon.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EstimateContents" type="uci:DamageEstimateContentsEnum">
						<xs:annotation>
							<xs:documentation>Indicates by object instance, object type, or both.  For EstimateType=Collateral, this must be set to object instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReportingThreshold" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Indicates the minimum damage probability threshold necessary for battle damage to be reported/included in this message. If EstimateType=Collateral, this field is ignored.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetData" type="uci:DamageEstimateTargetType">
						<xs:annotation>
							<xs:documentation>Indicates the Target being attacked; the target whose associated damage is being estimated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetName" type="uci:VisibleString64Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The name of the target as defined by the service that will be used to generate a Damage Estimate for this target.  For example JWS.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DMPI_Data" type="uci:DMPI_DamageEstimateType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a DMPI associated with this attack.  If omitted, DMPI information should be retrieved via the sibling Target element's Task reference.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TaskID" type="uci:TaskID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the Task from which the damage originates.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReleasePoint" type="uci:Point3D_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Release Point within a Launch Acceptable Region (LAR).  If EstimateType=Collateral, this point is used to check for air corridor violations between it and the DMPI.  If not specified, ReleasePoint associated with TaskID will be used.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the ID of a data product from which this damage request should be derived.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RespondBy" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time by which the damage request is needed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EstimateZone" type="uci:ZoneType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the zone where damage should be estimated.  If EstimateType=Collateral, determines which geo-filter to use for possible entity or corridor/NoFire zone conflicts, otherwise the geo-filter is determined from DMPI.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DMPI_BlastPairing" type="uci:DMPI_BlastPairingType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Optional DMPI-to-BlastRadius pairings to be used for fratricide and collateral damage checks. If left unspecified, DMPI will be looked up via TaskID, and blast radius (a.k.a. minimum safe distance) will be a lookup value based on the weapon.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DamageEstimateRequestMT" uci:version="003.001.003.000">
		<xs:annotation>
