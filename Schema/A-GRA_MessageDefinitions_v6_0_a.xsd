					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TurretCommandType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>This type represents a command to control a door that is relevant to mission operations.</xs:documentation>
		</xs:annotation>
