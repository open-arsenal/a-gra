						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Band" type="uci:FrequencyRangeType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a frequency band/range used by the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:WeatherRadarMessageOutputsEnum" minOccurs="0" maxOccurs="3">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeatherRadarCellLocationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Latitude" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Geospatial latitude measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Longitude" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Geospatial longitude measured in radians.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UpperAltitude" type="uci:AltitudeType">
				<xs:annotation>
					<xs:documentation>Height above WGS-84 ellipsoid measured in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LowerAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Height above WGS-84 ellipsoid measured in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherRadarCellSizeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Angle" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>The angle extent relative to the ownship position for a cell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The range extent of a cell.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherRadarCellType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CellLocation" type="uci:WeatherRadarCellLocationType">
				<xs:annotation>
					<xs:documentation>Represents the center of the weather observation cell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reflectivity" type="xs:double">
				<xs:annotation>
					<xs:documentation>Indicates equivalent reflectivity of the radar signal at the cell location.  Units are dBZ where Z is the standard meteorological measure of equivalent reflectivity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherData" type="uci:WeatherAreaDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates weather characteristics of the cell which have been inferred based on the weather radar observation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherWarning" type="uci:WeatherWarningEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates weather warnings for the cell which have been inferred based on the weather radar observation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherRadarCommandMDT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:WeatherRadarCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Weather Radar Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
