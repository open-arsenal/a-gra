				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherRadar" type="uci:WeatherRadarTaskType">
				<xs:annotation>
					<xs:documentation>Indicates a task to collect weather radar data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
