					<xs:documentation>Indicates the normal component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_VelocityDeltaType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a delta velocity vector in the Radial-Transverse-Normal Reference System.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadialDelta" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the delta radial component of velocity in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransverseDelta" type="uci:SpeedType" minOccurs="0">
