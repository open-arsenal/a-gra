	<xs:complexType name="PrioritizationListItemType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Provides the container to specify how the object is prioritized.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Subject" type="uci:IdentityKindInstanceType">
				<xs:annotation>
					<xs:documentation>Indicates the subject of the prioritization list item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Priority" type="uci:PrioritizationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the priority of the item.  If priority for any child PriorityType is given, then omitted PriorityTypes for the sibling Subject have no/zero priority.  No duplicates allowed; at most one instance of each of the child PriorityTypes is allowed.  If the child PriorityType is not used, only one instance is allowed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectCorrelation" type="uci:ObjectCorrelationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Object Correlation contains a description of the correlation of this object with another object as well as whether the correlating system has C2 responsibilities or not, to indicate a rough level of confidence in the information.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PrioritizationListMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="PrioritizationListID" type="uci:PrioritizationListID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the prioritization list.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ListType" type="uci:PrioritizationListEnum">
						<xs:annotation>
							<xs:documentation>Indicates the type of prioritization list.  For example, battlespace objects can be prioritized differently for targeting vs. protection as indicated by enumerates given in this element.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ListItem" type="uci:PrioritizationListItemType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an item in a prioritization list of the sibling ListType.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OpOrderTraceability" type="uci:OrderTraceabilityType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an operational order which this PrioritizationList is traceable to.  This does not mean ranking.  This element refers to a Planning Order, Commander's Intent, or other Order that came from a higher echelon.  The higher echelon is identified by the OrderSourceID.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OpDescription" type="uci:OpDescriptionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a human readable description of the purpose of the prioritization list.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApplicableSystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>One or more Systems to which the prioritization applies. If omitted, the prioritization applies to all Systems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApplicableServiceID" type="uci:ServiceID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>One or more Services to which the mission response list applies. If omitted, the settings apply to all Services of the Systems given in the sibling ApplicableSystemID.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApplicableZone" type="uci:ZoneType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Zones to which the prioritization applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Scheduled times to which the prioritization applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PrioritizationListMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:PrioritizationListMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PrioritizationListValueType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ListType" type="uci:PrioritizationListEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type of PrioritizationList.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Prioritization" type="uci:PrioritizationType">
				<xs:annotation>
					<xs:documentation>Indicates the Prioritization value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PrioritizationType" uci:version="001.001.002.000">
		<xs:annotation>
			<xs:documentation>Indicates a container for providing a ranking of an object of interest.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PriorityValue" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>Indicates the precedence and priority levels of the particular object. This could be a threat target or some other type of object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementType" type="uci:RequirementTaxonomyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a type or types of C2 Requirement which the sibling prioritization PriorityValue applies to.  Optional for systems/services whose prioritization doesn't vary by Requirement type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProcessingConstrainedSubPlanType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductProcessingType">
				<xs:sequence>
					<xs:element name="ConstrainedSubPlanRank" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>This element provides precedence and priority ranking for each constrained subplan.  In the case that multiple subplans return true (all filters in more than one subplan are true), this is used to determine which subplan to apply.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Filter" type="uci:ProductTypeFilterType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Filters are used to determine if the constrained subplan applies.  All of the filter criteria within a constrained subplan must be satisfied to apply the subplan.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProcessingParametersPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This defines the base parameter type that must be extended to specify processing parameters for a ProcessingType for a processing algorithm. Available extension types include: AugmentationProcessingParametersType, COMINT_ProcessingParametersType, DVR_ProcessingParametersType, ImagePixelGeoLocationProcessingParametersType, SAR_ProcessingParametersType.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="ProcessingReportType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the input product or products to which this report applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductProcessing" type="uci:ProductProcessingClassificationType">
				<xs:annotation>
					<xs:documentation>This element specifies the processing type and processing parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutputProductMetadataID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This is the ID of the ProductMetadata corresponding to the product that has been created as a result of processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProcessingRequirementsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this requirement applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductProcessing" type="uci:ProductProcessingClassificationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element specifies the processing type and processing parameters.  It is a list so different types of processing can be done on the same input products in one request. The order of processing is implied by the order of the list.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProcessingResultsPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This defines the base parameter type that must be extended to specify the results of a processing algorithm initiated by a ProcessingRequest.  This is only used when the result is some set of metrics or other data to be returned in the ProductProcessingRequestStatus message, not simply a product file.  Available extension types include: ImageGeoRegistrationProcessingResultsType,   ImagePixelGeoLocationProcessingResultsType.</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:complexType name="ProductClassificationPlanID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to ProductClassificationPlan.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationPlanMDT" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductClassificationPlanID" type="uci:ProductClassificationPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID, assigned to this ProductClassificationPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This field represents the system this classification plan applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductClassificationPlan" type="uci:ProductClassificationPlanType">
				<xs:annotation>
					<xs:documentation>At a minimum, a default subplan must be specified.  Whereas other product plans (dissemination, processing) default subplans apply to specific product types, classification is not specific to product types.  Classification is more often associated with location and source, regardless of product type.  As such a classification default subplan applies to all products generated by a system.  The constrained subplan is used to classify based on zone, time, etc.  Note that product type is a filter criteria such that one could classify based on product type; however, this is not the most widely used use case.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductClassificationPlanMT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductClassificationPlanMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationPlanType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>This type represents the system classification plan for a type of product.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DefaultSubPlan" type="uci:SecurityInformationType">
				<xs:annotation>
					<xs:documentation>The default classification to be applied if no filtered classifications are provided or if no filters are satisfied for the provided filtered classifications.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConstrainedSubPlan" type="uci:ClassificationConstrainedSubPlanType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A constrained subplan specifies classifications that should be used instead of the default if the filters for those classifications are satisfied.  If the filters are satisfied in a way that determines multiple classifications could be applied then the ConstrainedSubplan Rank can be used to determine which classification to apply.  If subplans have the same rank, the applicable subplan with the highest classification should be applied.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductClassificationReportID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to a ProductClassificationReport.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationReportMDT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductClassificationReportID" type="uci:ProductClassificationReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID, assigned to a ProductClassificationReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This field specifies the System that performed the classification.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClassificationReport" type="uci:ClassificationReportType">
				<xs:annotation>
					<xs:documentation>The classification report specifies the product and its classification.  For discrete products, this conveys that a product has been reclassified.  For streaming products, this indicates that the classification of the stream has changed and is reflective of current state of how the stream is being classified.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductClassificationReportMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ProductClassificationReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationRequestMDT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>This field specifies the source of the product that is being classified.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestType" type="uci:ProductClassificationRequestEnum">
						<xs:annotation>
							<xs:documentation>This message can be used two ways:

1.)  APPLY_CLASS_LABEL - This is a request for a product to be updated with a classification label.  In this case, the product will be labeled with the classification provided in the request or can be classified per the Product Classification Plan (if omitted from the request).

2.)  RETURN_CLASS_LABEL - This is a request to determine classification label based on the Product Classification Plan and return the classification label in the ProductClassificationRequestStatus.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Rank" type="uci:ComparableRankingType">
						<xs:annotation>
							<xs:documentation>Indicates the rank of the resulting action.  Rank determines order when resources are limited.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PreemptLowerRank" type="uci:DownloadPriorityEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether a) in-work activities of a lower rank should be interrupted in order to immediately commence new activity (IMMEDIATE) or b) the activity should be simply queued according to rank and await the next available slot.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ClassificationRequirements" type="uci:ClassificationRequirementsType">
						<xs:annotation>
							<xs:documentation>A classification requirement specifies the product to classify and at what classification level.  If the classification element is omitted, the request would imply utilization of the Product Classification Plan in making the determination of classification level.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationRequestMT" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ProductClassificationRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationRequestStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type">
						<xs:annotation>
							<xs:documentation>The ID of the system that is responding to the request.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductClassificationStatus" type="uci:ProductClassificationStatusLabelType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element is used to provide more detailed status of requests that involve more than one product.  It is also used to return a classification label if the request was to return a classification label generated per the Product Classification Plan.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ProductClassificationRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProductClassificationStatusLabelType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Status" type="uci:ProductClassificationStatusType">
				<xs:annotation>
					<xs:documentation>This element is used to provide detailed status information about a specific product in response to a product classification request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClassificationLabel" type="uci:SecurityInformationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is required when the Product Classification Request is to return a classification label without modification of the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductClassificationStatusType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InputProduct" type="uci:InputProductType">
				<xs:annotation>
					<xs:documentation>This element specifies the product or products to which this status applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductClassificationState" type="uci:ProcessingStatusEnum">
				<xs:annotation>
					<xs:documentation>The state of each individual product or type included in the request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StatusDetails" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An optional string field that will allow systems to provide more detail about failures or cancellations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedCompletionTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the estimated time to complete.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedPercentComplete" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The estimated percent complete allows a user to see how much of the download has been completed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProductClassificationTaskMDT" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ProductManagementTaskDataType">
				<xs:sequence>
					<xs:element name="ClassificationRequirements" type="uci:ClassificationRequirementsType">
						<xs:annotation>
