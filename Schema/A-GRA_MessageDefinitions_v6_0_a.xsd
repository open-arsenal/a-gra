	<xs:complexType name="TurretReportDynamicPointingType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Heading" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Heading of the turret relative to the vehicle.  (0=down the nose, + values are clockwise. i.e., 1.57 = looking down the right wing.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Pitch" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Pitch of the turret relative to the vehicle. (0=straight ahead, + values are down and back. i.e., 1.57 = straight down.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HeadingRate" type="uci:AngleRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Heading rate of the turret relative to the vehicle in radians/s (clockwise = positive, counterclockwise = negative).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PitchRate" type="uci:AngleRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Pitch rate of the turret relative to the vehicle in radians/s (down = positive, up = negative).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TurretReportID_Type" uci:version="000.000.000.000">
