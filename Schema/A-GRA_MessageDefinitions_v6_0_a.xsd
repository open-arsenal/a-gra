	<xs:complexType name="DMPI_DamageEstimateType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type">
				<xs:annotation>
					<xs:documentation>Indicates an ID corresponding to DMPI data to be used for the damage estimate.  When the sibling DMPI_Location and Weaponeering elements are given, this is the preliminary ID that will be assigned to a DMPI that includes them if the resulting DamageEstimate is acceptable.  Otherwise, this element refers to an existing, separately published DMPI message/object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_Location" type="uci:DMPI_LocationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial impact location.  When omitted, the location is given in the DMPI message/object referenced by the sibling DMPI_ID element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weaponeering" type="uci:WeaponeeringType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the weaponeering data to be used for the damage estimate.  When omitted, the weaponeering is given in the DMPI message/object referenced by the sibling DMPI_ID element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedBlastRadius" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a blast radius to use for fratricide and collateral damage checks.  If omitted, blast radius should be determined via lookup using sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DMPI_DesignationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to DMPI designations.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
