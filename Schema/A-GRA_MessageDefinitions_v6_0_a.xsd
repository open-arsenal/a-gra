	<xs:complexType name="RoutePathModificationType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Specifies route path modification data. The order should not matter within a single request (like an atomic transaction). If you want to control order, you should send subsequent requests and wait for status after each.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Add" type="uci:RoutePathType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Path data to add.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RemoveID" type="uci:PathID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Path to remove.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Update" type="uci:RoutePathType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Path modification data for existing Paths. The data specified in each present field of this type is intended to replace the data in the same field of the original RoutePathType element identified by PathID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RoutePathType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathID" type="uci:PathID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this Path.  Other Paths or PathSegments may branch to this path by referring to this ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PathType" type="uci:PathTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates which path type is defined in this path object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FirstInPathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the first PathSegment of the Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PathSegment" type="uci:PathSegmentType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A PathSegment is defined from the previous path segment EndPoint (or current vehicle state if no previous path segment) to the current path segment EndPoint.  Elements given here are not necessarily in mission/flight order; it is necessary to follow the linkages provided in NextPathSegment and/or ConditionalPathSegment to traverse the segments in mission/flight order.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialConditions" type="uci:PlanningLocationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates planned or assessed initial conditions of the vehicle at the beginning of the Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AirfieldID" type="uci:AirfieldID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Airfield message containing the Runway information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RunwayID" type="uci:RunwayID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the runway at which this path is either taking off or landing.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:RemarksType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates information about the path from an operator that is intended for display.  Both short and longer detailed information can be provided.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RoutePlanActivationType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RoutePlanID" type="uci:RoutePlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the RoutePlan to perform the sibling activation command on.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandType" type="uci:PlanActivationCommandEnum">
				<xs:annotation>
					<xs:documentation>Indicates the activation to perform on the associated RoutePlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivationPathSegment" type="uci:ActivationPathSegmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the beginning Path and Segment to activate or go to.  This element is optional when the sibling CommandType indicates ACTIVATE.  It is required when it indicates GO_TO_PART.  It should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RoutePlanAnalysisInputsType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanPart" type="uci:PathTypeEnum" maxOccurs="12">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts of the RoutePlan (path type) to include in the RoutePlan analysis. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RoutePlanDetails" type="uci:RoutePlanReferencesType">
				<xs:annotation>
					<xs:documentation>Indicates specific portions/sections of the RoutePlan to validate.  If omitted, the entire RoutePlan should be analyzed subject to other sibling filter elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Origin" type="uci:PlanningPointType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Denotes the origin (starting point) on the RoutePlan to begin validation.  If not specified, the Plan should be validated with an origin determined from context.  For example, during dynamic validation of an active Plan, the origin could be from current System position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Interval" type="uci:IntervalChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the interval between simulated positions when performing analysis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherAreaData" type="uci:WeatherAreaDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents an override of the existing weather data available through UCI weather messages.  This override is a summary of the weather conditions across the entire weather area to be used for analysis of the route plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
