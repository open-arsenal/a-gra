	<xs:complexType name="RadarAltimeterReportMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadarAltimeterReportID" type="uci:RadarAltimeterReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID assigned to one measurement or a group of measurements that are associated together.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObservingSystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the System which made the radar altimeter report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Capability which made the radar altimeter report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Activity that generated the radar altimeter report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectorKinematics" type="uci:SignalNavDataType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the sensor system (or geographically disperse component of a sensor system) in LLA coordinates.   Each sibling element represents the kinematics at a different time which would be used to correlate to the timestamps of the measurements. If a sensor is stationary, only one element would need to be populated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Measurement" type="uci:RadarAltimeterReportMeasurementType">
				<xs:annotation>
					<xs:documentation>Represents the data for an altimetry measurement made by the radar altimeter.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RadarAltimeterReportMeasurementType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Represents the data for an altimetry measurement made by the radar altimeter.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time when the radar altimeter measurement was made.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Height" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The height above ground level in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerticalClosingVelocity" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vertical closing velocity in meters per second, with positive indicating closing velocity and negative indicating opening velocity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExpectedTimeToNextMeasurement" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The expected time, measured in seconds, that will elapse between the current altimetry measurement and the next expected altimetry measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Characteristics" type="uci:RadarAltimeterReportCharacteristicsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the altimetry measurement characteristics of the radar altimeter report.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
