					<xs:documentation>A set of navigation station point types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emergency" type="uci:OpPointEmergencyEnum">
				<xs:annotation>
					<xs:documentation>Emergency Point and associated reference types.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OpPointCategoriesUniqueDataType" uci:version="000.000.000.000">
