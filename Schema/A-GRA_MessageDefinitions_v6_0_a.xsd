	<xs:simpleType name="CargoDeliveryCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type establishes the first tier in the taxonomy of the cargo delivery category of Capabilities.  For cargo delivery, the first tier is an indication how the cargo is physically carried or attached to the System.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
