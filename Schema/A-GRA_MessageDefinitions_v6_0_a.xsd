	<xs:complexType name="AccessEventType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>Specifies the parameters for the AccessEvent.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Effort" type="uci:AccessEffortEnum">
				<xs:annotation>
					<xs:documentation>Indicates a modeled "level of effort" to assess.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Time" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>The time of the event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The duration of the event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfAccessAttempt" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the probability that this access event is being attempted on this subject.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfSuccessfulAccess" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the object's probability of successfully accessing the subject.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubjectObjectKinematics" type="uci:KinematicsMultiStandardType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The kinematics of the subject object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssessedObjectKinematics" type="uci:KinematicsMultiStandardType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The kinematics of the assessed object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ObjectSeparation" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The separation of the objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnambiguousTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The unambiguous time of the event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceConsumption" type="uci:EnduranceMultiStandardType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The resources required or consumed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssessedObjectManeuver" type="uci:ManeuverMultiStandardType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the maneuver the assessed object would have to perform to be an access.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AccessObjectType" uci:version="003.000.003.000">
