	<xs:simpleType name="SAR_CapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the Capability's first tier type in the SAR taxonomy.  For SAR, the first tier is an indication of the geospatial extent of the resulting products.  See enumerated type annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPOT">
				<xs:annotation>
					<xs:documentation>Indicates the SAR imaging pattern covers a single spot to maximize resolution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STRIP">
