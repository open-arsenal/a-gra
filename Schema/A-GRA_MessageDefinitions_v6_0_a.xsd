					<xs:documentation>Indicates the SAR imaging pattern covers a strip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AREA">
				<xs:annotation>
					<xs:documentation>Indicates the SAR imaging pattern covers a broad area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SAR_CollectionReasonEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the task planning type of the collection.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PRE_PLANNED">
