		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitActivityPlanValidationID" type="uci:OrbitActivityPlanValidationID_Type">
				<xs:annotation>
					<xs:documentation>The ID of the orbit activity plan validation this message pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanID" type="uci:OrbitActivityPlanID_Type">
				<xs:annotation>
					<xs:documentation>The ID of the Plan this status pertains to.</xs:documentation>
