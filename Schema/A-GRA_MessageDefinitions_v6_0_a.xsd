				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedActivityID" type="uci:PlannedActivityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific Planned Activity the Requirement is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
