	<xs:simpleType name="SensingTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying types of sensing used to characterize the environment via observation, measurement, collection or similar means.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACOUSTIC">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of sound levels.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIR_SAMPLE">
				<xs:annotation>
					<xs:documentation>Sensing of air to determine the presence or characteristics of gases, molecules or other materials in it.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BIOLOGICAL">
				<xs:annotation>
					<xs:documentation>Sensing to determine the presence or characteristics of biological materials.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHEMICAL">
				<xs:annotation>
					<xs:documentation>Sensing to determine the presence or characteristics of chemical materials.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONTRAIL">
				<xs:annotation>
					<xs:documentation>Sensing to determine the presence or characteristics of aircraft contrails.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of optical or infrared emissions or reflections.  Sibling enumerations provide more specific forms of EO/IR sensing; use them when applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR_FIRE_CONTROL">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of optical or infrared emissions or reflections for the purpose of controlling a weapon via a datalink or other communications channel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR_IMAGING">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of optical or infrared emissions or reflections for the purpose of creating imagery.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR_TARGETING">
				<xs:annotation>
					<xs:documentation>Use of a laser or other active optical or infrared device to illuminate a target for activities such as sensor pointing or weapon guidance via a seeker on the weapon or point.  Targeting can be similar to fire control depending on the weapon type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR_TRACKING">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of optical or infrared emissions or reflections for the purpose of determining the location of an object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOIR_VIDEO">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of optical or infrared emissions or reflections for the purpose of creating video.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EYESIGHT">
				<xs:annotation>
					<xs:documentation>Observation via human eyesight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEOINT">
				<xs:annotation>
					<xs:documentation>Geospatial intelligence (GEOINT) is intelligence about the human activity on earth derived from the exploitation and analysis of imagery and geospatial information that describes, assesses, and visually depicts physical features and geographically referenced activities on the Earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HUMINT">
				<xs:annotation>
					<xs:documentation>Human intelligence (HUMINT) is intelligence gathered by means of interpersonal contact, as opposed to the more technical intelligence gathering disciplines such as signals intelligence, imagery intelligence and measurement and signature intelligence.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMINT">
				<xs:annotation>
					<xs:documentation>Imagery intelligence (IMINT) is an intelligence gathering discipline wherein imagery is analyzed to identify information of intelligence value.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAGNETIC_ANOMALY">
				<xs:annotation>
					<xs:documentation>Detection or measurement of an object based on the object's effect on the local electromagnetic field.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MASINT">
				<xs:annotation>
					<xs:documentation>Measurement and signature intelligence (MASINT) is a technical branch of intelligence gathering, which serves to detect, track, identify or describe the distinctive characteristics of fixed or dynamic target sources.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NUCLEAR">
				<xs:annotation>
					<xs:documentation>Sensing to detect nuclear explosions, nuclear materials or other characteristics of nuclear weapons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates another type of sensing.  Use of this enumerate should avoided or at least minimized.  If used, it should only be used temporarily while proposing the addition of new well named enumerate(s) to the standard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of radar emissions or reflections.  Radar uses radio waves to determine the range, angle, or velocity of objects.  Sibling enumerations provide more specific forms of radar sensing; use them when applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_FIRE_CONTROL">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of radar emissions or reflections for the purpose of controlling a weapon via a datalink or other communications channel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_IMAGING">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of radar emissions or reflections for the purpose of creating imagery.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_TARGETING">
				<xs:annotation>
					<xs:documentation>Use of a radar to determine the kinematics of a target for activities such as sensor pointing or developing weapon impact coordinates.  Targeting can be similar to fire control depending on the weapon type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_TRACKING">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of radar emissions or reflections for the purpose of determining the kinematics of one or multiple targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADAR_WEATHER">
				<xs:annotation>
					<xs:documentation>Measurement, collection or other sensing of radar emissions or reflections for the purpose of characterizing weather.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RADIOLOGICAL">
				<xs:annotation>
					<xs:documentation>Sensing, such as a geiger counter, to determine the presence or characteristics of radiological materials.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEISMIC_VIBRATION">
				<xs:annotation>
					<xs:documentation>Detection or measurement of movement of the earth or objects on the earth due to natural activities or the movement of other objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT">
				<xs:annotation>
					<xs:documentation>Signals intelligence (SIGINT) is intelligence-gathering by interception of signals.  Sibling enumerations provide more specific forms of SIGINT; use them when applicable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT_COMINT">
				<xs:annotation>
					<xs:documentation>Electronic signals intelligence (ELINT) is intelligence-gathering by interception of signals used for communications including telephone conversations, text messages and various types of online interactions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT_ELINT">
				<xs:annotation>
					<xs:documentation>Electronic signals intelligence (ELINT) is intelligence-gathering by interception of signals other than those used for communications.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT_EW">
				<xs:annotation>
					<xs:documentation>Electronic warfare (EW) is any action involving the use of the electromagnetic spectrum (EM spectrum) or directed energy to control the spectrum, attack an enemy, or impede enemy assaults.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT_EW_ESM">
				<xs:annotation>
					<xs:documentation>Tactical EW supporting electronic attack.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIGINT_FISINT">
				<xs:annotation>
					<xs:documentation>Intelligence from the interception of foreign electromagnetic emissions associated with the testing and operational deployment of foreign aerospace, surface, and subsurface systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SONAR">
				<xs:annotation>
					<xs:documentation>Detection or measurement of sound propagation to detect objects on or under the surface of the water, such as other vessels.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TEMPERATURE">
				<xs:annotation>
					<xs:documentation>Device that measures the temperature of its environment and converts the input data into electronic data to record, monitor, or signal temperature changes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the category of sensor (ex: SSN, Commercial, MDA).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FOREIGN_GOV">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is controlled by a foreign government.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="US_GOV">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is controlled by the US government.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SSN">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that has a tasking agreement to operate as part of the U.S. Space Surveillance Network (SSN).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMMERCIAL">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is commercially owned.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IC">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is controlled by the Intelligence Community (IC).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MDA">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is controlled by the Missile Defense Agency (MDA).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FOREIGN">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is controlled by foreign entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FVEY">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is part of an intelligence sharing alliance comprising government agencies from the US, Great Britain, Canada, New Zealand, and Australia.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="US_GOV_RESTRICTED_CONTRACT">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is not owned by the U.S. Government but operated on behalf of the U.S. Government and under strict U.S. Government national security restrictions for activities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="US_GOV_COMMERCIAL_CONTRACT">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that is contracted for collections by the U.S. government but is under standard commercial restrictions for operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorFunctionalCollectionsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the high level functional collection capabilities of a sensor and associated unit.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="METRIC_DATA_COLLECTION">
				<xs:annotation>
					<xs:documentation>Collection of position and/or velocity data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZONE_SEARCH">
				<xs:annotation>
					<xs:documentation>Search of a region independent of a defined orbital state, usually a relatively large volume.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBJECT_BASED_SEARCH">
				<xs:annotation>
					<xs:documentation>Search around a defined orbital state.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNRESOLVED_CHARACTERIZATION">
				<xs:annotation>
					<xs:documentation>Characterization data such as average RCS, RCS vs time, average visual magnitude, or photometry where the characterization is on the target or signal as a whole (in contrast to resolved characterization).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESOLVED_CHARACTERIZATION">
				<xs:annotation>
					<xs:documentation>Characterization data that enables distinct assessments on sub-components of the target structure or signal (e.g., resolved imagery).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_COLLECTION">
				<xs:annotation>
					<xs:documentation>Collections where the sensor is expected to resolve and provide data on two or more objects with simultaneous or near-simultaneous collections.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorFunctionalProcessingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the high level processing capabilities of a sensor and associated unit.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ORBITAL_STATE_ESTIMATION">
				<xs:annotation>
					<xs:documentation>Ability to provide an orbital state estimate based on metric data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BASIC_SDA_PRODUCTS">
				<xs:annotation>
					<xs:documentation>Ability to provide products as outlined in USSTRATCOM/USSPACECOM Operating Instruction (OI) 534-9.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="QUICK_LOOK_ASSESSMENT">
				<xs:annotation>
					<xs:documentation>Ability to assess and report on the features, identity, and/or operating characteristics of the target object based on sensor data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_ASSESSMENT">
				<xs:annotation>
					<xs:documentation>Ability to identify maneuver of the target object and potentially determine the maneuver characteristics.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_ASSESSMENT">
				<xs:annotation>
					<xs:documentation>Ability to determine relative geometries of targets and/or discriminate identities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorReferencedCoverageAreaReferenceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the reference for pointing for a SensorReferencedCoverageArea Target.  The enumeration values are PLATFORM or SENSOR.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PLATFORM">
				<xs:annotation>
					<xs:documentation>Indicates pointing relative to the body of the aircraft in an east north up coordinate system.  Zero azimuth and elevation will point out the nose of the platform. Azimuth increases counterclockwise as a rotation about the up vector.  Elevation is positive up as a rotation about the rotated east vector.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SENSOR">
				<xs:annotation>
					<xs:documentation>Indicates pointing relative to the boresight of the sensor in an east north up coordinate system with north pointing in the direction of boresight.  Zero azimuth and elevation will point in the direction of boresight. Azimuth increases counterclockwise as a rotation about the up vector.  Elevation is positive up as a rotation about the rotated east vector.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorSpectrumEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the frequency band or spectrum that the sensor used.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FULL_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to specify the region of the electromagnetic spectrum that includes both the visible and the infrared spectrum (see the VISIBLE_SPECTRUM and INFRARED_SPECTRUM enumerated items).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VISIBLE_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the electromagnetic spectrum that is visible to the human eye. The visible spectrum is generally assumed to fall in the range of 390 nm (770 THz) to 700 nm (430 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFRARED_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the electromagnetic spectrum corresponding to invisible radiant energy. The infrared spectrum is generally assumed to fall in the range from 0.8 um (short wave or near IR) up to 1000 um (long wave or far infrared).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GREEN_VISIBLE_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the green region of the visible spectrum. The green region of the visible spectrum is generally assumed to fall in the range of 495 nm (606 THz) to 570 nm (526 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BLUE_VISIBLE_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the blue region of the visible spectrum. The blue region of the visible spectrum is generally assumed to fall in the range of 450 nm (668 THz) to 495 nm (606 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RED_VISIBLE_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the red region of the visible spectrum. The red region of the visible spectrum is generally assumed to fall in the range of 620 nm (484 THz) to 750 nm (400 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PANCHROMATIC_VISIBLE_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the panchromatic region of the visible spectrum. The panchromatic region of the visible spectrum is generally assumed to include the red (see RED_VISIBLE_SPECTRUM), green (see GREEN_VISIBLE_SPECTRUM), and blue (see BLUE_VISIBLE_SPECTRUM) regions of the visible spectrum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NEAR_INFRARED_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the visible spectrum, possibly starting in the red region of the visible spectrum, and extending into the infrared spectrum. The near IR region is generally assumed to fall in the range of 700 nm (428 THz) to 1400 nm (214 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHORT_WAVE_INFRARED_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the infrared spectrum whose wavelengths are relatively short. The short wave IR spectrum is generally assumed to fall in the range 1400 nm (214 THz) to 3000 nm (100 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MID_WAVE_INFRARED_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the infrared spectrum whose wavelengths lay near the middle of the infrared spectrum. The mid wave IR spectrum is generally assumed to fall in the range 3000 nm (100 THz) to 8000 nm (37 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LONG_WAVE_INFRARED_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to identify the region of the infrared spectrum whose wavelengths are relatively long. The long wave IR spectrum is generally assumed to fall in the range 8000 nm (37 THz) to 15000 nm (20 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FULL_HYPERSPECTRAL_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to specify the region of the electromagnetic spectrum that includes both the visible and the infrared spectrum that is captured as a hyperspectral image (see the VISIBLE_HYPERSPECTRAL _SPECTRUM and INFRARED_HYPERSPECTRAL _SPECTRUM enumerated items).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VISIBLE_HYPERSPECTRAL_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to specify the region of the electromagnetic spectrum that is visible to the human eye that is captured as a hyperspectral image. The visible spectrum is generally assumed to fall in the range of 390 nm (770 THz) to 700 nm (430 THz).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFRARED_HYPERSPECTRAL_SPECTRUM">
				<xs:annotation>
					<xs:documentation>This enumerated item is used to specify the region of the electromagnetic spectrum corresponding to invisible radiant energy that is captured as a hyperspectral image. The infrared spectrum is generally assumed to fall in the range from 0.8 um (short wave or near IR) up to 1000 um (long wave or far infrared).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorTrackingAltitudesEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the maximum altitude that a sensor can track in a given operational mode. This enables distinction between average orbital altitudes, such as for a highly eccentric object, and the altitude at tracking time. Other descriptions speak to orbital regime based on average orbital altitude (See OrbitAltitudeEnum).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NEAR_EARTH_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes between 100km and 5,500km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MID_EARTH_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes between 5,500km and 22,000km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HIGH_EARTH_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes between 22,000km and 40,000km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTREMELY_HIGH_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes between 40,000km and 200,000km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CIS_LUNAR_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes between 200,000km and 1,000,000km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERPLANETARY_ALTITUDES">
				<xs:annotation>
					<xs:documentation>Spacecraft altitudes greater than 1,000,000km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SensorTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the type of sensor (ex: active optical, passive RF, infrared, etc.).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVE_RF">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that includes one or more active radio frequency transmitters under the control of the sensor operator and which measures range along with other positional, velocity, and structural characteristics of targets through collection of back-scatter or forward-scatter radio frequency energy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE_RF">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that leverages radio frequency emissions from sources not under the control of the sensor unit to measure quantities such as range, angle to target, velocity, and structural characteristics of targets through collection of reflected, forward scatter, or directly received radio frequency energy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVE_OPTICAL">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that uses a laser to support collections of a target by an optical receiver.  This includes adaptive optical systems that use lasers to support atmospheric correction as well as systems that track reflections of the laser energy off of the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE_OPTICAL">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that collects light reflected off of a target where the light source is not controlled by the sensor unit or a sensor that collects light transmitted by the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFRARED">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that collects Infrared reflected off of a target or emitted by the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that collects energy reflected off of a target or forward-scattered off of the target where the transmitter is not under the control of the sensor unit or a sensor that collects energy emitted by the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPTICAL">
				<xs:annotation>
					<xs:documentation>Sensor that conducts measurements through collection of data in the optical wavelength band.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACOUSTIC">
				<xs:annotation>
					<xs:documentation>Identifies a sensor that operates by collecting sound waves.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ServiceLifecycleCommandStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the state of a command sent to a service or service manager.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SUCCESS">
				<xs:annotation>
					<xs:documentation>A status specifying the command sent to the service or service manager executed properly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAIL">
				<xs:annotation>
					<xs:documentation>A status specifying the command sent to the service or service manager failed to be executed properly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ServiceLifecycleStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration of commands that can be sent to a service or service manager.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="START">
				<xs:annotation>
					<xs:documentation>A command to start a service lifecycle in its INITIALIZING state. This command will likely be handled by a resource manager to startup a service.  Services will not normally start itself.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STOP">
				<xs:annotation>
					<xs:documentation>A command to stop a service lifecycle by transitioning it into its INOPERABLE state. This command will likely be handled by a resource manager to stop a service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESTART">
				<xs:annotation>
					<xs:documentation>A command to restart a service lifecycle by transitioning it back into its INITIALIZING state from any state except the INOPERABLE state. This command will likely be handled by a resource manager to restart a service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESET">
				<xs:annotation>
					<xs:documentation>A command to reset a service lifecycle by resetting its internal parameters in any state except the INOPERABLE state.  This may or may not cause the service to transition to another state. This command will likely be handled by a resource manager to reset a service. Note: RESTART (not RESET) is used to return a service to its INITIALIZING state.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PAUSE">
				<xs:annotation>
					<xs:documentation>A command to temporarily pause a service lifecycle by transitioning the service into its PAUSED state where its current operations are suspended until a subsequent resume command is received. This command will be rejected if it's in its PAUSED state and it will be ignored if the service is in its INOPERABLE state. This command will likely be handled by a resource manager to pause a service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESUME">
				<xs:annotation>
					<xs:documentation>A command to resume operation of a paused service lifecycle by transitioning it into the previous state in which it received the pause command. This command will be rejected if it's not in its PAUSED state and it will be ignored if the service is in its INOPERABLE state. This command will likely be handled by a resource manager to resume a paused service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ServiceRegistrationPurposeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration of the purposes a service provides and can dynamically register for.  The enums registered for must be supported by the service and documented in the program related documentation.  Use of these enumerations in messages do not replace system engineering artifacts and processes.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="COMM_PLANNING">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in Comm Planning service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CYBER">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in Cyber Security service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUSION">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in Fusion service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAP_MANAGEMENT">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in map management service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MENSURATION">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in mensuration service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_PLANNING">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in mission planning service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_PLAN_STATE">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in mission plan state service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ROUTE">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in Route specific service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SITUATIONAL_AWARENESS">
				<xs:annotation>
					<xs:documentation>Used to specify a request to participate in situational awareness service orchestration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
