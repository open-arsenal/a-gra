					<xs:documentation>Indicates the time at which this signal was last known to have been transmitted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Frequency" type="uci:FrequencyDataBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the frequency data of this signal.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PilotFrequency" type="uci:FrequencyDataBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "pilot frequency" (or "tone") used by the associated emitter for supervisory, control, equalization, continuity, synchronization, or reference purposes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI" type="uci:PRI_DataBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Pulse Repetition Interval characteristics of the associated emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidth" type="uci:SignalPulseWidthBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Pulse Width characteristics of the associated emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Scan" type="uci:ScanDataBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Scan characteristics of the associated emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModulationOnPulse" type="uci:ModulationOnPulseDataBaseType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Modulation characteristics of the associated emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amplitude" type="uci:SignalAmplitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the amplitude characteristics of the associated emitter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterFunction" type="uci:EmitterFunctionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter function of the associated emitter.  See type annotations for details of emitter function definition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EOB_SiteIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:EOB_IdentityBaseType">
				<xs:sequence>
					<xs:element name="BE_Number" type="uci:BasicEncyclopediaNumberType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Basic Encyclopedia Number, this identifies the specific location of interest to an analyst.  It consists of two parts:  World Area Code (WAC) and installation number.  The installation identifier is broken into two parts.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="O_Suffix" type="uci:EOB_O_SuffixType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Uniquely identifies a facility or demographic area in conjunction with a BE_Number.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Category" type="uci:AlphanumericString6Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The category for this type of site.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EOB_SitePIN_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ForeignKeyType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EphemerisOrbitalModelType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the USSF Astrodynamic Standards orbital model parameters.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitalModel" type="uci:OrbitalModelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orbital model used to create the ephemeris.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepSize" type="xs:duration" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the requested interval between ephemeris results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SolarRadiationPressureCoefficient" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Accounts for the effects imposed by the reflectivity of the satellite with regard to the pressure exerted by solar radiation, measured in meters squared per kilogram.  May be omitted when the perturbation is not used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BallisticCoefficient" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Accounts for the effects imposed by the specific interaction of the satellite's shape and material composition with regard to drag model for the Earth's atmosphere, measured in meters squared per kilogram.  May be omitted when the perturbation is not used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EphemerisPropagatorChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a choice between propagation parameters. Allows either the selection of USSF Astrodynamic Standards orbital model parameters or more general propagator settings.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OrbitalModelPropagator" type="uci:EphemerisOrbitalModelType">
				<xs:annotation>
					<xs:documentation>The USSF Astrodynamic Standards orbital model parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PropagatorSettings" type="uci:PropagatorSettingsChoiceType">
				<xs:annotation>
					<xs:documentation>A set of propagator settings given either explicitly or by ID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EquatorialCoordinatesCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This describes the covariance matrix of the line of sight with respect to the equatorial coordinate system.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RA_RA" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Right Ascension - Right Ascension covariance term with units of radians squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RA_Dec" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Right Ascension - Declination covariance term with units of radians squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RA_Range" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Right Ascension - Range covariance term with units of radians * meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DecDec" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Declination - Declination covariance term with units of radians squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DecRange" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Declination - Range covariance term with units of radians * meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeRange" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Range - Range covariance term with units of meters squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EquatorialCoordinatesType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This describes the line of sight with respect to the equatorial system: Right Ascension, Declination and Range. These coordinates map the line of sight to the celestial sphere.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="YearOfEquinox" type="uci:YearOfEquinoxEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date of reference for the vernal equinox direction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RightAscension" type="uci:AnglePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle measured eastward along the celestial equator, from the vernal equinox. The vernal equinox is defined as the intersection between the celestial equator and the ecliptic, associated with the sun's ascending node.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Declination" type="uci:AngleHalfType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angular distance to the object measured North or South from the celestial equator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An observed range value from the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EquatorialKinematicsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This describes the line of sight with respect to the celestial sphere. It contains both the line of sight measurements in the equatorial coordinate system and corresponding covariance matrix.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EquatorialCoordinates" type="uci:EquatorialCoordinatesType">
				<xs:annotation>
					<xs:documentation>Contains the line of sight measurements in the equatorial coordinate system: Right Ascension, Declination and Range.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EquatorialCoordinatesCovariance" type="uci:EquatorialCoordinatesCovarianceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contains the covariance matrix for the line of sight measurement in the equatorial coordinate system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_AcquisitionTargetType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EntityID" type="uci:EntityID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific Entity that is a target of ESM acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterType" type="uci:EmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a type of emitter that is a target of ESM acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter type ***instance*** that is a target of ESM acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalDescription" type="uci:SignalSummaryType">
				<xs:annotation>
					<xs:documentation>Indicates summary signal characteristics that are a target of ESM acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific Signal that is a target of ESM acquisition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ESM_ActivityCommandType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="ESM_ChangeDwell" type="uci:ESM_ChangeDwellType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Identifies the specific dwell that ESM should enable, disable, deallocate, or delete.  The dwell's identity is originally defined in the optional ReceiveDwell structure of the ESM_Activity message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ESM_ChangeGeolocation" type="uci:ESM_ChangeGeolocationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to change the control state of an active geolocation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeDependentActivity" type="uci:DependentActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Changes Activities that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.  This is used to tie Activities across subsystems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ESM_ChangeSubCapabilityDetails" type="uci:SubCapabilityDetailsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This indicates the details required for a SubCapability, at least one of the data sets need to be populated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to turn Spectral Density Reporting on and off for this Activity.  TRUE indicates a command for the Activity to produce Spectral Density Reports.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ActivityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the ESM Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityListCleared" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the last time at which the ESM Subsystem's Entity list/file/database was cleared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityOverload" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the ESM Subsystem has reached its limit in detecting and reporting emitter Entities; additional detectable emitters may exist but they won't be reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExcessiveAttitude" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an excessive attitude condition exists which can result in degraded performance of ESM Activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseDensityOverload" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that a pulse destiny overload condition was detected by the ESM.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LookThroughLimited" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the ESM Subsystem has less look through time than is needed to perform its currently active Capabilities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReceiverUtilization" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated receiver utilization provided as a fractional percent.  When receiver utilization is greater than 100%, the ESM is not meeting the design goal of the scan regimen provided in the mission data.  This means probability of detection and response time may be degraded for some emitters.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:ESM_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of an ESM Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ActivityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ESM_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ActivityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureActivityBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:ESM_SubCapabilityEnum" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates a specific SubCapability that is included in the Activity.  If omitted, all SubCapabilities of the associated Capability or Capabilities (as indicated in the ESM_Capability message) will be included in the Activity.  This element is required whenever a subset of SubCapabilities of the associated Capability or Capabilities are included in the Activity. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityDetails" type="uci:SubCapabilityDetailsType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates select SubCapability-specific details regarding the originating command/source of the Activity (as indicated by the sibling ActivitySource element).  In other words, this element is an echo of select elements from the ESM_Command, MDF, etc. that originated the Activity.  Additionally, in the case of ESM_Commands whose results are independent of typical ESM output messages such as Entity or SignalReport, discrete command results are given here instead of in those messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReceiveDwell" type="uci:ESM_ReceiveDwellType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an ESM receiver dwell that is applicable to the Activity.  This element is optional in support of ESM Capabilities whose detailed dwell configuration and scheduling is internally isolated.  Though optional here, dwell information is required for successful, higher level ESM Capability management across heterogeneous families Systems, Services and Subsystems.  dwell information is potentially useful even if the associated Activity and/or Capability aren't manual and/or interactive.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentRequired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Activity requires consent to transition from the ENABLED state to an ACTIVE state.  This element is required and shall be TRUE for Activities which require consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentState" type="uci:ConsentEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of consent for the Activity.  This element is required for Activities which require Consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActualStartTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time when the Activity started.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActualEndTime" type="uci:DateTimeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the time when the Activity stopped.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the status of Spectral Density Reporting for this Activity.  TRUE indicates that the Activity is producing Spectral Density Reports.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_BinGroupActivationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ScanScheduleProfileIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Identifies a unique data set associated with Bin and emitters as identified in an ESM_SettingsCommand.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivationState" type="uci:ESM_ActivationEnum">
				<xs:annotation>
					<xs:documentation>Enables or disables the scan schedule associated with the sibling Bin.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_BinPrecedenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubCapability" type="uci:ESM_SubCapabilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This indicates the SubCapability and the SubCapabilityDetails being commanded.  It's assumed one or more activities are created for each SubCapabilitySelection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityRanking" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with ESM and supported by the commanded ESM Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_BinProfileType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedSubsystemID" type="uci:SubsystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Required if the message is for the resource allocator function.  Used by the resource allocator to identify the applicable ESM subsystem.  BM will "hijack" the subsystem ID at the message level with the RA Support Capability ID to indicate the message is for the RA.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScanScheduleProfileIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Identifies a unique identifier for the data set associated with Bin and emitters. This is  the identifier used in the ESM command to ACTIVATE a profile.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Parent Capability associated with the Bin Data.  Required when message is for a subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProfileData" type="uci:ESM_BinType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Emitter Priority Bin data.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_BinType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterPriorityBin" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Specifies the Emitter Priority Bin for the sibling EmitterEntry. These bins are for a "binned" set of emitters without identifying them individually; used to identify elements used in a scan schedule.  The Sibling Precedence gives the relative importance of each Bin/Subcapability pair. A value of 0 indicates the  least important Bin.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubCapabilityData" type="uci:ESM_BinPrecedenceType" maxOccurs="12">
				<xs:annotation>
					<xs:documentation>Precedence data for the Emitter Priority Bin.
                    If multiplicity == 1: optional child Subcapability of ESM_SubCapabilityEnum is not used;ranking applies to all supported subcapabilities and only one access period is allowed
                    If multiplicity &gt; 1 (value equals the number of subcapabilities); child SubCapability of ESM_SubCapabilityEenum is required to set subcapability/precedence pair for all supported subcapabilities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterELNOT_Identifier" type="uci:NotationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents Electronic Intelligence (ELINT) Notation for non-communications electronic emissions.  Used to preserve original signal identification in case of modification by subsequent processing.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityCommandType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SharedRF_ApertureCapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="ResourceAllocatorCommandExtension" type="uci:ResourceAllocatorCommandExtensionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether a command is for a resource manager or a subsystem. If the element is present, the EWRM receives the command and treats it as "directed" (CapabilityID selected by mission processing) or overridable, according to the enum. The subsystem will ignore the command until the resource manager sends a modified command without the ResourceAllocatorCommandExtension. If field is not included, the command is always interpreted to be for a subsystem (capability/activity).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanScheduleActivation" type="uci:ESM_BinGroupActivationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to control an ESM scan scheduler by activating or de-activating a Bin Profile Set (defined in the ESM Settings Command).  If changing Bin Profiles, ACTIVATE is selected for the new set; the previously selected profile is implicitly deactivated.  If DEACTIVATE is selected the scan scheduler is terminated and all associated  activities should be terminated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilitySelection" type="uci:SubCapabilitySelectionType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This indicates the SubCapability and the SubCapabilityDetails being commanded.  It's assumed one or more activities are created for each SubCapabilitySelection.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with ESM and supported by the commanded ESM Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Frequency" type="uci:CapabilityCommandFrequencyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the frequency to be used for the Command.  If omitted, frequency selection is left to the command recipient within constraints of RF_Profiles imposed by RF_ControlCommand, MDF, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:ESM_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed ESM Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:ESM_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the ESM_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Profile" type="uci:RF_ProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a RF Emission Profile currently applied to the Capability.  If omitted, there are no current profiles and the Capability is operating per its defaults and other constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AmbiguityOrdering" type="uci:AmbiguityOrderingEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the order in which identity ambiguity is being reported in the Capability's output messages.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RWR_AudioEnable" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current enable (true) or disable (false) state of the audio tone produced by the ESM/RWR system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the SpectralDensityReport message is currently enabled.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Specifies which messages are currently being output by the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ESM_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CapabilityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:CapabilityInitiationEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the ESM taxonomy.  For ESM, the first tier is an indication of the means of initiation of the Capability.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:ESM_SubCapabilityEnum" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability of the ESM Capability, the second tier in the taxonomy of ESM.  For ESM, the second tier is an indication of the specific collection technique.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GeolocationType" type="uci:SignalGeolocationMethodEnum" minOccurs="0" maxOccurs="8">
						<xs:annotation>
							<xs:documentation>Indicates a geolocation type/technique supported by the Capability.  This element is only expected when the sibling SubCapabilityType indicates geolocation. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:ESM_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DwellCoverage" type="uci:ESM_DwellCoverageType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a summary of the expected coverage of a dwell or dwells associated with the Capability.  This element does not indicate an actual instantiated, scheduled dwell of the Capability.  This element is an abstraction of the MDF representation and/or design implementation of an ESM Dwell.  Actual, instantiated, scheduled Dwells are reported via the ESM_Activity message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ESM_PerformanceProfile" type="uci:ESM_PerformanceProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Definition of ESM performance for the parent Capability, based on the status of Supporting Capabilities (i.e. Antenna Status). For example, use of a low band omni antenna in combination with AESAs would result in multiple performance profiles.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ChangeDwellType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DwellID" type="uci:DwellID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the dwell commanded to change.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeState" type="uci:CapabilityCommandStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the dwell state should be enabled, disabled, or reset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Unallocate" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the specific dwell should be unallocated, which means temporarily remove it from the dwell strategy without deleting it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeleteDwell" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A deleted dwell can't be re-enabled, including by an automated Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ChangeGeolocationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="GeolocationControlState" type="uci:SignalGeolocationControlEnum">
				<xs:annotation>
					<xs:documentation>Indicates the geolocation control state which the Activity should change to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an Entity which the sibling GeolocationControlState is addressed to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_CommandMDT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:ESM_CommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of an ESM Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_CommandMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ESM_CommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CommandResponseType" uci:version="000.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubCapability" type="uci:ESM_SubCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the desired ESM_Command type.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductOutput" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with ESM and supported by the commanded ESM Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_CommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CommandStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ESM_CommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_CommandType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:ESM_CapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of an ESM Capability.  Generally, if accepted, the command will result in one or more new ESM Activities being created and reported via the ESM_Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:ESM_ActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing ESM Activity (which was previously reported via the ESM_Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent ESM_Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ESM_ConsentRequestMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem requiring Consent for the ESM Activity to proceed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConsentRequest" type="uci:ESM_ConsentRequestType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a consent request instance.  An ESM_ConsentRequest can have multiple consent request instances to allow a sequence of related consent requests to be described in a single coherent message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ConsentRequestMT" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ESM_ConsentRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ConsentRequestStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityConsentRequestStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ConsentRequestStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ESM_ConsentRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_ConsentRequestType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestBaseType">
				<xs:sequence>
					<xs:element name="ActivityID" type="uci:ActivityID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the ActivityID of the ESM_Activity which describes the proposed ESM.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ESM_DwellCoverageType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Band" type="uci:FrequencyRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the bandwidth of the Dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an EA Component the dwell can be assigned to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:EmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an emitter type which the dwell might detect.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter type ***instance*** which the dwell might detect.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_LocationType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TargetLocationData" type="uci:ESM_SubcapabilityTargetLocationDataType">
				<xs:annotation>
					<xs:documentation>Indicates the source of or explicit values for the kinematic location of the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ESM_AirVolume" type="uci:AirVolumeSensorReferencedType">
				<xs:annotation>
					<xs:documentation>Indicates the volume to search within.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ESM_PerformanceProfileType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FieldOfRegard" type="uci:FieldOfRegardType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Field of Regard of the Capability relative to Body Coordinates. This element can be multiple if multiple instances of the same antenna are installed with different Fields Of Regard.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Band" type="uci:FrequencyRangeType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the bandwidth of the Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamLimit" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum number of independent RF receive beams for the sibling Component. *Independent* means generated on a separate RF Port OR time-multiplexed within a single RF Port. More than one waveform can be summed or commutated in a single RF response (beam).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyChangeTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time between frequency changes for the Capability. Reported time considers the system time for ESM tune and antenna beam setup, after ESM command is received.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ProfileEditType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>ESM Profile for the current MDF contains Emitter Priority Bin and activation for each emitter. This structure allows controlling the entries in the ESM Profile, only for the current MDF.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CurrentMDF" type="uci:MDF_CommandType">
				<xs:annotation>
					<xs:documentation>If the specified Current MDF does not match the MDF in use, the command will return an error.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ESM_ProfileEntry" type="uci:ESM_ProfileEntryType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>In a single ESM MDF, editing of emitter priority bin and/or activation can occur for multiple element in a message at a time.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ProfileEntryType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterEntry" type="uci:EmitterEntryType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specify an emitter by ID or by MDF_Entry number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterPriorityBin" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the Emitter Priority Bin for the sibling EmitterEntry. These bins are for a "binned" set of emitters without identifying them individually.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activation" type="uci:ESM_ActivationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>States whether the subject emitter is individually activated or deactivated for use by ESM.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_ReceiveDwellType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DwellID" type="uci:DwellID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the dwell identifier for this dwell structure.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellState" type="uci:ESM_DwellStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the state of the dwell within the active ESM as it whether or not it is enabled, and the reason if it is disabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellType" type="uci:ESM_DwellTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellFOV" type="uci:NED_ConeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's field of view (FOV) details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time of the first collection for the Dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CumulativeDwellTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the cumulative collection time for the dwell, including all revisits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentID" type="uci:ComponentID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an ESM component with the dwell is assigned to use.  Required if the dwell is assigned/active.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Frequency" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the frequency coverage of the dwell, including all RF_ControlCommand, ESM_Command, MDF and other restrictions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellRevisitInterval" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's revisit interval, which is how often the dwell should be repeated within the dwell strategy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthLow" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's minimum pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PulseWidthHigh" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's maximum pulse width.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRI_High" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the dwell's maximum pulse repetition interval (PRI).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NativeSensitivity" type="uci:DecibelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dwell sensitivity prior to any desensitization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Desensitization" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Desensitization if any applied to the dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VideoBandwidth" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the video bandwidth used for the measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DwellTarget" type="uci:ESM_AcquisitionTargetType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a target of the Dwell.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ESM_SettingsCommandMDT" uci:version="003.000.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilitySettingsCommandBaseType">
				<xs:sequence>
					<xs:element name="SetAmbiguityOrdering" type="uci:AmbiguityOrderingEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the commanded order in which identity ambiguity should be reported in the Capability's subsequent output messages.  See enumerate annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RWR_AudioEnable" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to enable (true) or disable (false) the audio tone produced by the RWR system.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpectralDensityReporting" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to enable (TRUE) or disable (FALSE) the SpectralDensityReport.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EditESM_Profile" type="uci:ESM_ProfileEditType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a command to edit one emitters' settings based on the CurrentMDF (and any previous edits). The emitter edits may include the emitter activation and the current Emitter Priority Bin. If the current MDF listed is not the actual MDF in use, the command will return an error.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApplicableZone" type="uci:ApplicableZoneType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates any applicable zone this command is valid for.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApplicableVolume" type="uci:ApplicableVolumeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates any applicable volume this command is valid for.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:ESM_MessageOutputsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Specifies which messages are to be output by the Capability as the result of capability commands. Note: Only values advertised in the Capability message are allowed. Any non-supported values should result in rejection of the settings command. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ScanScheduleProfileData" type="uci:ESM_BinProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Used to set Emitter Priority Bin data explicitly.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
