					<xs:documentation>The duration to perform the hover loiter.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HRR_ChipSizeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RangeSize" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the requested range size.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DopplerSize" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the requested Doppler size.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HRR_OptionsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="HRR_PeakScatterers" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a desire to employ high resolution ranging (HRR) waveforms for the target of the Task/Command. The default assumption is that the output will provide additional information in the 4607 message. A common range is [0,99].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChipSize" type="uci:HRR_ChipSizeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the requested range Doppler map chip size. The chip is assumed to be centered around the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HSB_ColorControlType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Hue" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the hue processing stage to set the image's hue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Saturation" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is the new value to be used by the saturation processing stage to modify the images saturation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Brightness" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Brightness is an attribute of visual perception in which a source appears to be radiating or reflecting light.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The common base type for all UCI IDs. All extension types should end in "ID_Type".</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UUID" type="uci:UniversallyUniqueIdentifierType">
				<xs:annotation>
					<xs:documentation>Universally Unique Identifier (UUID).  A UUID is a 128-bit number (32 hexadecimal digits, 16 bytes) that is conformant to a version and variant of IETF RFC 4122.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescriptiveLabel" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human readable text label with content meaningful to human operators.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentificationVerificationCharacterizationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Collect data to support confirmation of object found according to kinematic specification as being the specified object of interest.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="All" type="uci:CharacterizationProductTypeEnum">
				<xs:annotation>
					<xs:documentation>When "All" is chosen, Unit must provide all forms of products on this list as part of concerted collection (maintaining high-confidence custody on object) to satisfy the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Any" type="uci:CharacterizationProductTypeEnum">
				<xs:annotation>
					<xs:documentation>When "Any" is chosen, Unit must provide at least one form of products on this list as part of concerted collection (maintaining high-confidence custody on object).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentificationVerificationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Specification of the nature of the collections desired to confirm spacecraft identity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ConfidenceDesired" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the level of confidence that the collected data will provide affirmation or denial that spacecraft is the expected target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Any" type="uci:CharacterizationProductTypeEnum">
				<xs:annotation>
					<xs:documentation>When "Any" is chosen, Unit must provide at least one form of products on this list as part of concerted collection (maintaining high-confidence custody on object).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="All" type="uci:CharacterizationProductTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>When "All" is chosen, Unit must provide all forms of products on this list as part of concerted collection (maintaining high-confidence custody on object) to satisfy the Task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentityBasicType" uci:version="001.000.002.001">
		<xs:annotation>
			<xs:documentation>This defines up to three methods ("Standard", "Platform", "Specific") for Target Identity based on MIL-STD-6016.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Standard" type="uci:StandardIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the Entity. Can establish capability or be commanded according to the availability for up to user defined allowable options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Platform" type="uci:PlatformIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the "platform identity" of the Entity. Can establish capability or be commanded according to the availability for up to user defined allowable options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Specific" type="uci:SpecificIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a "specific identity" of the Entity. Can establish capability or be commanded according to the availability for up to user defined allowable options.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentityComparisonType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Type" type="uci:EntityIdentityChoiceType">
				<xs:annotation>
					<xs:documentation>This element indicates the type of Entity Identity type whose confidence is compared to the sibling Confidence element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the identity confidence value to be compared to the identity confidence in the Entity message for the sibling Type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentityConfidenceType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Standard" type="uci:StandardIdentityConfidenceType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a possible "standard identity" of the Entity.  The value of the child Confidence element of all instances of this element should sum to 100%.  If multiple instances are given, each must be of a different standard identity as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentIdentityConfidenceType" minOccurs="0" maxOccurs="6">
				<xs:annotation>
					<xs:documentation>Indicates a possible "environment" of the Entity.  The value of the child Confidence element of all instances of this element should sum to 100%.  If multiple instances are given, each must be of a different environment type as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Platform" type="uci:PlatformIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible "platform identity" of the Entity.  The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Specific" type="uci:SpecificIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible "specific identity" of the Entity.   The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:EmitterMultipleType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an emitter that has been identified in association with the Entity.  An Entity can have multiple emitters each of which are represented by one instance of this element.  Each emitter can in turn have an ambiguity list of emitter types indicated by descendant elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterMultipleType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter instance that has been identified in association with the Entity.  An Entity can have multiple emitters and therefore multiple specific emitters.  Each specific emitter can in turn have an ambiguity list of specific emitter instance possibilities as indicated by descendant elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificVehicle" type="uci:SpecificVehicleIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible specific vehicle instance, generally a blue forces vehicle, that has been identified in association with the Entity.  The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificFacility" type="uci:SpecificFacilityIdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible specific facility instance, generally a blue forces facility, that has been identified in association with the Entity.  The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB" type="uci:EOB_IdentityConfidenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a possible identity of the Entity in the taxonomy/nomenclature of the Electronic Order of Battle (EOB).  The value of the child Confidence element of all instances of this element should sum to 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreMultipleType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific weapon instance that has been identified in association with the Entity.  An Entity can have multiple weapons.  Each weapon can in turn have an ambiguity list of specific weapon instance possibilities as indicated by descendant elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IdentityKindAssetType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>Provides the container that allows for specifying ways to identify the battlespace object.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByInstance" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Indicates a System or Entity asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByIdentity" type="uci:IdentityType">
				<xs:annotation>
					<xs:documentation>Indicates an asset based Identity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByPlan" type="uci:RequirementPlanningCandidateType">
				<xs:annotation>
					<xs:documentation>Indicates an instance of System expressed as a planning candidate.  A System given here is assessed for access based on existing *Plans in addition to the more general types of Capabilities included in the assessment.  A System is a "candidate" because it may or may not be suitable for performing a Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IdentityKindInstanceType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Provides the container that allows for specifying ways to identify the battlespace object.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByInstance" type="uci:TargetType">
				<xs:annotation>
					<xs:documentation>Indicates the specific identity of the battlespace object.  This could be the specific Entity given by its ID, an Operator-generated location or some other specific target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ByIdentity" type="uci:IdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the "platform identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IdentityType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Standard" type="uci:StandardIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "environment identity" or "domain" in which the asset operates. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Platform" type="uci:PlatformIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "platform identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Specific" type="uci:SpecificIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a "specific identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:EmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an emitter type that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter type ***instance*** that has been identified in association with the asset.  Specific Emitter Identification (SEI) technology passively measures emitters, and characterizes unique emitter signatures that can be used for friendly or enemy emitter identification and fingerprinting.  A SEI and this SpecificEmitter element refer to a specific physical instance of a type of emitter as given in the sibling EmitterType element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificFacility" type="uci:FacilityIdentificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, facility ***instance*** that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificVehicle" type="uci:VehicleIdentificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, vehicle ***instance*** that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB" type="uci:EOB_IdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the identity of the asset in the taxonomy/nomenclature of the Electronic Order of Battle (EOB).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a type of weapon available. This element represents the MIL-STD-6016 specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_ActiveModesType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="IFF_TransponderModes" type="uci:IFF_ActivityTransponderType">
				<xs:annotation>
					<xs:documentation>Indicates the IFF modes enabled for response.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IFF_InterrogationModes" type="uci:IFF_ModeSelectionType">
				<xs:annotation>
					<xs:documentation>Indicates Interrogation modes currently active.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IFF_ActivityCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityCommandBaseType">
				<xs:sequence>
					<xs:element name="Attempt" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If specified, indicates the specific attempt of an activity to which this command applies.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ChangeDependentActivity" type="uci:DependentActivityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Changes Activities that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.  This is used to tie Activities within or across subsystems.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityDetails" type="uci:IFF_InterrogatorTransponderModesType">
						<xs:annotation>
							<xs:documentation>This provides the modes of operation IFF should be using for this specific command in conjunction with the sibling elements.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResourceSelection" type="uci:ResourceSelectionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the resulting Activity. This allows Mission Processing to direct an specific antenna, antenna resource type, or antenna resource instance to be used by the resulting Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetVolume" type="uci:AirTargetVolumeCommandType" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates the volume or specific Entity that defines the extents of the spatial region covered by the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BlankingVolume" type="uci:AirTargetVolumeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an air volume that should be "blanked"; the Capability should not generate outputs associated with the volume because it is a known source of clutter or other interference for the Capability. For example, a blanking volume could be created around a wind farm that interferes with IFF.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:RadarCollectionOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates guidance regarding which aspect(s) of collection to favor if the command cannot be optimally scheduled as requested.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:IFF_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a set of bounding requirements for the particular collection associated with this command. The subsystem should attempt to satisfy all specified constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command. If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command. Only Products consistent with IFF and supported by the commanded IFF Capability should be requested. If omitted, no output Product should be produced. See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_ActivityMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem which hosts the IFF Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:IFF_ActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of an IFF Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_ActivityMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether an instance of a message is new, an update to an existing message/object or a request/command to remove the message/object from the network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:IFF_ActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_ActivityTransponderType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:IFF_TransponderModeControlType">
				<xs:sequence>
					<xs:element name="TransponderModeStatus" type="uci:IFF_TransponderActivityStatusEnum">
						<xs:annotation>
							<xs:documentation>Indicates the status of the Transponder Mode .</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_ActivityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="SubCapability" type="uci:IFF_SubmodesType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates select SubCapability-specific details regarding the originating command/source of the Activity (as indicated by the sibling ActivitySource element).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityCommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="SubCapabilityDetails" type="uci:IFF_InterrogatorTransponderModesType">
						<xs:annotation>
							<xs:documentation>This provides the modes of operation IFF should be using for this specific command in conjunction with the sibling elements.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ResourceSelection" type="uci:ResourceSelectionType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the resulting Activity. This allows direction of a specific antenna, antenna resource type, or antenna resource instance to be used by the resulting Activity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetVolume" type="uci:AirTargetVolumeCommandType" minOccurs="0" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates the volume or specific Entity that defines the extents of the spatial region covered by the command.  For non-CUED Capabilities, one air volume instance of this element is expected.  For CUED Capabilities, two instances of this element are allowed: one with an Entity specified and a second with an air volume that define the extents of the cue volume around the Entity.  For AMTI Capabilities, a single instance is allowed if it is an Entity in which case the Entity location uncertainty defines the extents of the cue volume.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BlankingVolume" type="uci:AirTargetVolumeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an air volume that should be "blanked"; the Capability should not generate outputs associated with the volume because it is a known source of clutter or other interference for the Capability.  For example, a blanking volume could be created around a wind farm that interferes with IFF</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionOptions" type="uci:RadarCollectionOptionsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates guidance regarding which aspect(s) of collection to favor if the command cannot be optimally scheduled as requested.  See enumerated type annotations for further details.  Omitting this element is equivalent to FLEXIBLE, that is deferring to the Command recipient.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CollectionConstraints" type="uci:IFF_CollectionConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a set of bounding requirements for the particular collection associated with this command.  The subsystem should attempt to satisfy all specified constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Repetition" type="uci:RepetitionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the required repetition of the command.  If omitted, the command should be performed once.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ProductOutput" type="uci:ProductOutputCommandBasicType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a required output Product of the Command.  Only Products consistent with IFF and supported by the commanded IFF Capability should be requested.  If omitted, no output Product should be produced.  See ProductTypeEnum for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityBaseType">
				<xs:sequence>
					<xs:element name="Capability" type="uci:IFF_CapabilityType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an installed IFF Capability, its configurable characteristics and its controllability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether an instance of a message is new, an update to an existing message/object or a request/command to remove the message/object from the network.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:IFF_CapabilityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityOptionsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InterruptOtherActivities" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the InterruptOtherActivities element in the IFF_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionPolicy" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Capability supports the CollectionPolicy element in the IFF_Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConcurrentOperationSupported" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates that the capability has the ability to run concurrently with at least one other capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElectronicProtectionOptionsSupported" type="uci:ElectronicProtectionOptionsSupportedType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the list of EP capabilities that the current HW / SW allows an external actor to control for this capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityStatus" type="uci:CapabilityStatusType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the high level availability/state of a Capability instance.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RF_Profile" type="uci:RF_ProfileType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates a RF Emission Profile currently applied to the Capability.  If omitted, there are no current profiles and the Capability is operating per its defaults and other constraints.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DefaultEmcon" type="uci:EmconSettingType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Defines the default emission control level to be applied to targets detected by this capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CurrentMessageOutput" type="uci:IFF_MessageOutputsEnum" minOccurs="0" maxOccurs="5">
						<xs:annotation>
							<xs:documentation>Specifies which messages are currently being output by the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityStatusMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:IFF_CapabilityStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CapabilityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandableCapabilityDeclarationType">
				<xs:sequence>
					<xs:element name="CapabilityType" type="uci:CapabilityInitiationEnum">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's first tier type in the IFF taxonomy.  For IFF, the first tier is an indication of the physical area covered.  See enumerated type annotations for further details.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SubCapabilityType" type="uci:IFF_SubCapabilityEnum" maxOccurs="2">
						<xs:annotation>
							<xs:documentation>Indicates a SubCapability of the IFF Capability; the second tier in the taxonomy of IFF. For IFF, the second tier is Transponder and/or Interorgator.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IFF_ModesAvailable" type="uci:IFF_ModesAvailableType" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates all the IFF Modes of operertion that are availble to control in the Capablity message set.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CapabilityOptions" type="uci:IFF_CapabilityOptionsType">
						<xs:annotation>
							<xs:documentation>Indicates the Capability's support for select optional elements in its accepted control interface messages.  Support for these elements is expected to vary across Capability implementations but must be known in order to adapt and configure upstream Systems and Services which use the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageOutput" type="uci:IFF_MessageOutputsEnum" minOccurs="0" maxOccurs="5">
						<xs:annotation>
							<xs:documentation>Indicates a message that is an output of the Capability.  See enumerated type annotations for details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CollectionConstraintsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CollectionConstraintsType">
				<xs:sequence>
					<xs:element name="Emcon" type="uci:EmconConstraintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Used to control the RF emissions associated with this command.  If this field is not populated, the service determines all parameters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetRadialSpeed" type="uci:SpeedRangeType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Used to indicate targtets outside these radial speeds (measured along the LOS from the sensor to the target) are not required to be detectec/tracked. Positive values are closing, and negatvie values are opening.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CommandMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:IFF_CommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of an IFF Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_CommandMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:IFF_CommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CommandStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CommandStatusMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:IFF_CommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IFF_CommandType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:IFF_CapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of an IFF Capability.  Generally, if accepted, the command will result in one or more new IFF_Activities being created and reported via the IFF_Activity message.  The request/response interaction terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interaction with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:IFF_ActivityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing IFF Activity (which was previously reported via the IFF_Activity message and was marked as "interactive").  The request/response interaction terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent IFF_Activity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="IFF_ConsentRequestMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem requiring Consent for the IFF Activity to proceed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ConsentRequest" type="uci:IFF_ConsentRequestType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a consent request instance.  An IFF_ConsentRequest can have multiple consent request instances to allow a sequence of related consent request to be described in a single coherent message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IFF_ConsentRequestMT" uci:version="000.000.000.000">
