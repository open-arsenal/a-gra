				<xs:annotation>
					<xs:documentation>Delivery should be made best effort, without guaranteed delivery, using the User Datagram Protocol (UDP).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NORM_IN_ORDER">
				<xs:annotation>
					<xs:documentation>Delivery should be made with guarenteed delivery and no duplicate or out of order data at the application level, using the NACK-Oriented Reliable Multicast (NORM).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NORM_NO_ORDER">
				<xs:annotation>
					<xs:documentation>Delivery should be made with guarenteed delivery but may include duplicated and/or out of order data at the application level, using the NACK-Oriented Reliable Multicast (NORM).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TCP">
				<xs:annotation>
					<xs:documentation>Delivery should be made with guarenteed delivery and no duplicate or out of order data at the application level, using the Transmission Control Proptocol (TCP)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DDS">
				<xs:annotation>
					<xs:documentation>The Data Distributation Service (DDS) will be used for delivery and the QoS settings will be set by the NetworkNativeEndpoint or ICD specified method.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DDS_RELIABLE">
				<xs:annotation>
					<xs:documentation>Delivery should be made with guarenteed delivery and no duplicate or out of order data at the application level, using the Data Distributation Service (DDS) with QoS set to RELIABLE</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DDS_BEST_EFFORT">
				<xs:annotation>
					<xs:documentation>Delivery should be made best effort, without guaranteed delivery, using the Data Distributation Service (DDS) with QoS set to BEST_EFFORT</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Transport protocol is via other delivery method.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
