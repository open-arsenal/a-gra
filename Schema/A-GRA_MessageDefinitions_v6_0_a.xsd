				<xs:annotation>
					<xs:documentation>Indicates the unique identifier for this particular antenna.  This can also be used to describe a towed decoy as the radiating source.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResourceInstanceID" type="uci:AntennaResourceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific resource (such a "Transmit, Quarter Sub-Array Number Three") on a Shared Antenna. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
