		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MINIMUM_DWELL">
				<xs:annotation>
					<xs:documentation>Prioritize scan area over dwell time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MINIMUM_ELLIPTICITY">
				<xs:annotation>
					<xs:documentation>Prioritize equalizing azimuth and elevation coverage.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAXIMUM_DWELL">
				<xs:annotation>
					<xs:documentation>Prioritize dwell time over scan area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SAR_ImagingPlaneEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Enumeration for the desired projection plane for the image.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SLANT_PLANE">
