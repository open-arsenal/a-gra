			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_RequirementTaxonomyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Effect" type="uci:EffectTypeEnum" minOccurs="0" maxOccurs="47">
				<xs:annotation>
					<xs:documentation>Indicates Effects applicable via the Effect* message set. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Action" type="uci:MA_ActionTypeEnum" minOccurs="0" maxOccurs="85">
				<xs:annotation>
					<xs:documentation>Indicates Actions applicable via the Action* message set. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Task" type="uci:MA_TaskTypeEnum" minOccurs="0" maxOccurs="23">
				<xs:annotation>
					<xs:documentation>Indicates Tasks applicable via the Task* message set. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityCommand" type="uci:MA_CapabilityTypeEnum" minOccurs="0" maxOccurs="30">
				<xs:annotation>
					<xs:documentation>Indicates CapabilityCommands applicable via a [Capability]Command message set. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Response" type="uci:ResponseTypeEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates Responses applicable via the Response* message set. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementTemplateInstantiationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Requirement that was instantiated as a result of the Response. Subsequent progress in planning and/or execution of the Requirement should be given in [Requirement]Plan, [Requirement]Status, etc. messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResultingPlans" type="uci:MA_PlansReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates *Plans that were updated or created to include the sibling Requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementTemplateOptionsType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Must be unique amongst all Requirements in the template.  Allows the response to be referenced in the sibling DependentRequirement to establish temporal relationships amongst Requirements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescriptiveLabel" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human readable text label with content meaningful to human operators.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementOption" type="uci:MA_RequirementTemplateOptionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a potential Requirement to update or generate.  When multiple Requirements are given, only one should be updated/generated.  It could be chosen based on  1) the child RequirementOptionIndex (indicating relative priority between options), 2) The Capabilities of the System or Systems available to execute the Requirement or other considerations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DependentRequirement" type="uci:RequirementGenerationDependencyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a temporal dependency to include when generating or updating the Requirement selected from the sibling RequirementOption.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollectionObjective" type="uci:CollectionObjectiveEnum" minOccurs="0" maxOccurs="5">
				<xs:annotation>
					<xs:documentation>The objective of the collection created as part of this response. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductStaleness" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum allowed product staleness for the product used for Collection Objective.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementTemplateOptionType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementOptionIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Must be unique across options of a Response. When multiple options are possible, the executable option with the lowest OptionIndex should be chosen.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Requirement" type="uci:MA_ResponseOptionType">
				<xs:annotation>
					<xs:documentation>Indicates details for a Requirement to generate for this option.  Note that some of the data necessary to generate a Requirement (Effect, Action, Task or [Capability]Command message) isn't given by this element or sibling element or elements; it must be inferred/derived from the associated Option, its triggering event, battlespace context, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementConstraints" type="uci:MA_RequirementConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates constraints to apply when generating the sibling Requirement.  Note that some of the data necessary to generate a Requirement's constraints isn't given by this element or sibling element or elements; it must be inferred/derived from the associated Response Option and/or its triggering event, battlespace context, etc.  If the sibling Requirement includes constraints, they override constraints given by this element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimingConstraints" type="uci:CapabilityCommandTemporalConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates additional, complex timing constraints to apply when generating the sibling Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementTriggerType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Rank" type="uci:RankCompareType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a Rank required in order for the trigger to be satisfied. If omitted, any Rank is/was a trigger.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementTypes" type="uci:MA_RequirementTaxonomyDetailedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a type of triggering Requirement. If omitted, all/any Requirement types are/were triggers.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseActivityMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the System which hosts the Response Capabilities whose Activities are given in this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:MA_ResponseActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the dynamic operational characteristics of an Activity of an Response Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseActivityMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_ResponseActivityMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseActivityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="InstantiationTime" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>Indicates the time at which the Response was instantiated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="OptionIndex" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the specific Option within the Response that was instantiated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequirementInstantiation" type="uci:MA_RequirementTemplateInstantiationType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates an independent set of Requirement or Requirements and *Plans that were instantiated for the Response. Subsequent progress in planning and/or execution is given in [Requirement]Plan, [Requirement]Status, MissionPlan*, etc. messages.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ActivatedPlans" type="uci:MA_PlansReferenceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates *Plans that were activated for the Response.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AlertID" type="uci:MissionContingencyAlertID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates a MissionContingencyAlert that was generated for the Response.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseAlertType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ByCaseTrigger" type="uci:MA_PlannedSequentialTriggerType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a trigger to include in the alert.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorRecommendation" type="uci:OperatorRecommendationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an operator recommendation to include in the alert.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseAllocationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MA_RequirementAllocationBaseType">
				<xs:sequence>
					<xs:element name="ResponseID" type="uci:ResponseID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the allocated or to-be allocated Response.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCapabilityCommandType" uci:version="003.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandBaseType">
				<xs:sequence>
					<xs:element name="ResponseID" type="uci:ResponseID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the Response being commanded.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedPlan" type="uci:MA_PlanReferenceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates referenced plan.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConstraintOverride" type="uci:MA_RequirementConstraintsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates refined/overridden values of constraints for the Response. Added to allow similar override options in direct commanding as is available in planning.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCommandMDT" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Command" type="uci:MA_ResponseCommandType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of an Response Capability command.  A Capability command message can have multiple command instances to allow a sequence of related commands in a single coherent message.  Each command instance reports status via a separate, independent Capability CommandStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCommandMT" uci:version="003.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_ResponseCommandMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCommandStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CapabilityCommandStatusBaseType" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCommandStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_ResponseCommandStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseCommandType" uci:version="003.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Capability" type="uci:MA_ResponseCapabilityCommandType">
				<xs:annotation>
					<xs:documentation>Indicates a new invocation of an Response Capability.  Generally, if accepted, the command will result in one or more new Response Activities being created and reported via the ResponseActivity message.  The request/response interresponse terminates as soon as the command is accepted or rejected; this element is not used to interact with an "active" command.  Updates and/or additional interresponse with the resulting Activity (after the command is accepted) is accomplished via the sibling Activity element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Activity" type="uci:ActivityCommandBaseType">
				<xs:annotation>
					<xs:documentation>Indicates a command to modify an existing Response Activity (which was previously reported via the ResponseActivity message and was marked as "interactive").  The request/response interresponse terminates as soon as the modification is accepted or rejected.  The modifications are reflected in subsequent ResponseActivity messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_ResponseMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResponseID" type="uci:ResponseID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Response. Minor updates to the Response can be indicated by an update of the value in the child Version element. More significant updates, replacements, etc. might warrant a new instance with a different child UUID value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResponseType" type="uci:ResponseTypeEnum" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates the types of Response options included in the message. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResponseManagementConstraints" type="uci:MA_RequirementConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates monitoring constraints on the Response. The constraint type used here is common to all Requirement types: Effect, Action, Task, [Capability]Command, Response. Requirement constraints can be 1) given in a [Requirement] message, 2) overridden as a planning input in a [Requirement]PlanCommand message, 3) further refined/overridden during plan creation and reported in a [Requirement]Plan message to inform subsequent planning or execution. See sibling Option element annotation for an overall description of Response structure.

Constraints given here aren't conveyed to instantiated Response options for a particular triggering event. The constraints given here apply to Response management ( planning, allocation and trigger monitoring prior to a triggering event).

Constraints to apply to instantiated Response options, if any, are given elsewhere in the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResponseManagementGuidance" type="uci:RequirementGuidanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates guidance on planning and C2 of the Response.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResponsePlurality" type="uci:MA_TaskPluralityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the response applies a single entity or as a joint condition. A joint condition implies condiseration of the response trigger and activation of the response by all associated entities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Option" type="uci:MA_ResponseOptionDetailsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Option of the Response. Responses are designed to be flexible. A Response is a set of prioritized Options to address an anticipated triggering event, events or event sequence in the battlespace. Responses are allocated to Systems via a ResponsePlan. When a ResponsePlan is activated, monitoring for the triggering events in the Options begins. When a triggering event happens, the applicable Option(s) are evaluated.
                    </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequirementsTemplate" type="uci:MA_RequirementsTemplateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The sibling Option element associates triggering events with a desired Response one of which is to use this element, a Requirements template, to generate or change one or more Requirements messages/objects (Effect, Action, Task, [Capability]Command). An instance of this element is a RequirementsTemplate; it indicates the types of Requirements to generate or update and their details. Each RequirementsTemplate has a unique ID and therefore can be used for multiple Options.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metadata" type="uci:RequirementMetadataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates traceability and other metadata associated with the Response.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon. The state of the software object is determined by the publisher. The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager. This element is not a commanded CRUD operation. It is not an indication of the state of an instance of a message. It is not a mechanism for partial, incremental, or fragmentary publication of a message. It is a signal from a publisher to subscribers. For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:MA_ResponseMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponseOptionDetailsType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OptionIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Must be unique across Options. Supports intra-Response ordering/prioritization of Option evaluations. Options are evaluated in order of increasing index. In other words, the Option with the lowest value in this element is evaluated first.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescriptiveLabel" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human readable text label with content meaningful to human operators.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Objective" type="uci:RequirementTaxonomyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an overall purpose/objective for the Response. This element is optional for systems/services whose prioritization and/or options don't vary by Requirement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContinueEvaluation" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether Response evaluation should continue (TRUE) or stop (FALSE) after the conditions of the Option are met. For example, a Response with escalating, concurrent Options might require evaluation to continue (TRUE) after the an Option's conditions are met. A Response where one and only one Option is desired (FALSE) stops evaluation after an Option's conditions are met.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Enabled" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether the rule is enabled or disabled. Disabling allows a rule to be communicated without the effect of an action being taken ; a superset of rules can be created and exchanged and then selectively enabled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Trigger" type="uci:MA_PlannedSequentialTriggerType">
				<xs:annotation>
					<xs:documentation>Indicates the trigger, decision point or other condition under which the Option should be initiated/processed. Filters/preconditions for the trigger are optionally given and must be satisfied before the associated Response is initiated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Response" type="uci:MA_RuleResponseType">
				<xs:annotation>
					<xs:documentation>Indicates the response to be taken when the triggering conditions of the Option are satisfied.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time period when the Option is enabled; responses for the Option should only be generated during this time period. This element does not constrain when the resulting responses are planned or actually occur. The schedule given in this element must be within the temporal constraints of the Response as a whole (when given).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponseOptionType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Effect" type="uci:EffectTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the Effect type to generate for use in Planned C2.  This option leaves nearly all details of the Effect to be determined by an operator or Response management service based on trigger and/or battlespace context.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EffectID" type="uci:EffectID_Type">
				<xs:annotation>
					<xs:documentation>Indicates an Effect to use as a template for generating a Response option for use in Planned C2.  The Effect indicated by this element should have a RESPONSE_C2 constraint and be used as template to copy to create a new PLANNED_C2 or DIRECT_C2 Effect with a new EffectID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Action" type="uci:MA_ActionTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the Action type to generate for use in Planned C2.  This option leaves nearly all details of the Action to be determined by an operator or Response management service based on trigger and/or battlespace context.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActionID" type="uci:ActionID_Type">
				<xs:annotation>
					<xs:documentation>Indicates an Action to use as a template for generating a Response option for use in Planned C2.  The Action indicated by this element should have a RESPONSE_C2 constraint and be used as template to copy to create a new PLANNED_C2 or DIRECT_C2 Action with a new ActionID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Task" type="uci:TaskResponseType">
				<xs:annotation>
					<xs:documentation>Indicates the Task type to generate for use in Planned C2.  This option leaves many details of the Task to be determined by an operator or Response management service based on trigger and/or battlespace context.

Note: When new Task types are added to TaskTypeEnum, they should also be added to this choice statement.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaskID" type="uci:TaskID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a Task to use as a template for generating a Response option for use in Planned C2.  The Task indicated by this element should have a RESPONSE_C2 constraint and be used as template to copy to create a new PLANNED_C2 or DIRECT_C2 Task with a new TaskID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityCommand" type="uci:CommandResponseType">
				<xs:annotation>
					<xs:documentation>Indicates the [Capability]Command type to generate along with type specific details for use in Direct C2.  This option leaves many details of the [Capability]Command to be determined by an operator or Response management service based on trigger and/or battlespace context.

Note: When new Capability types are added to CapabilityTypeEnum, they should also be added to this choice statement if they have a corresponding [Capability]Command message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityCommandID" type="uci:CommandID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a [Capability]Command to use as a template for generating a new [Capability]Command (with new CapabilityCommandID) for use in Direct C2.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="MA_ResponsePlanCommandMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommandID" type="uci:ResponsePlanCommandID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID of the command. Used to reference the command when providing status.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandState" type="uci:CommandStateEnum">
				<xs:annotation>
					<xs:documentation>The state of the command message data. Indicates if a command message is a NEW command, an UPDATE to an existing command, or a CANCEL of an existing command.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ParentPlanCommandID" type="uci:ResponsePlanCommandID_ChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the *PlanCommand which this ResponsePlanCommand originated from.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Inputs" type="uci:ResponsePlanInputsType">
				<xs:annotation>
					<xs:documentation>Indicates data and references to be used to create the ResponsePlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>When TRUE, indicates the *Plan is to be used only for intermediate planning purposes. It will eventually be replaced/superseded by another *Plan or be discarded/abandoned. *Plans with this flag should only be used when explicitly referenced by other messages. These *Plans should never: trigger functionality, be subject to approvals, be activated, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_ResponsePlanCommandMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:MA_ResponsePlanCommandMDT">
						<xs:annotation>
							<xs:documentation>Indicates the data being conveyed by the message.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="MA_ResponsePlanCommandStatusMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CommandID" type="uci:ResponsePlanCommandID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID of the ResponsePlanCommand this status applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningStatus" type="uci:PlanCommandStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the *PlanCommand.</xs:documentation>
				</xs:annotation>
