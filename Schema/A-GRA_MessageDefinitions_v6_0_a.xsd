	<xs:simpleType name="MDF_StatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the overall status/state of the MDF.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data loaded successfully, passed CRC check, and is currently active.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data loaded successfully, passed CRC check, and is currently inactive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WRONG_TYPE">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data loaded unsuccessfully because it didn't match the expected MDF and/or MDF SubCategory type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONTENT_PROBLEM">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data loaded unsuccessfully because it was corrupt or the settings in the file/data are outside the limits of the associated Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED_CRC">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data loaded unsuccessfully because it failed the CRC check.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED_TRANSFER">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data wasn't loaded because there was a failure in the transfer to the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_FOUND">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data could not be found.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data status is unknown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_LOADED">
				<xs:annotation>
					<xs:documentation>Indicates the MDF file/data is not loaded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeasurementQualityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type describes levels of quality of a data measurement.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SUSPECT">
				<xs:annotation>
					<xs:documentation>Indicates the measurement may have been corrupted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COARSE">
				<xs:annotation>
					<xs:documentation>Indicates a measurement whose quality is known or suspected to be less than what is possible for the measurer.  For example, a pulse width measurement which was not computed from the 3 dB down point in the pulse.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FINE">
				<xs:annotation>
					<xs:documentation>Indicates a measurement whose quality is known or suspected to be close to the best that is possible for the measurer.  For example, a pulse width measurement computed from the 3 dB down point in the pulse.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeasurementReportSourceTypeEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Enumeration indicating the type of measurement within an report.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MONOSTATIC">
				<xs:annotation>
					<xs:documentation>Indicates measurement is from a monostatic sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BISTATIC">
				<xs:annotation>
					<xs:documentation>Indicates measurement is from a bistatic sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTISTATIC">
				<xs:annotation>
					<xs:documentation>Indicates measurement is from a homogeneous sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPOSITE">
				<xs:annotation>
					<xs:documentation>Indicates measurement is from a heterogeneous sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeasurementStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type describes the state/status of a data measurement.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PENDING">
				<xs:annotation>
					<xs:documentation>Indicates the measurement is planned/scheduled but hasn't started.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IN_PROCESS">
				<xs:annotation>
					<xs:documentation>Indicates the measurement is being made.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPLETE">
				<xs:annotation>
					<xs:documentation>Indicates the measurement was performed, completed successfully and the results are available.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED">
				<xs:annotation>
					<xs:documentation>Indicates the measurement was planned/scheduled and possibly began but didn't complete successfully.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INELIGIBLE">
				<xs:annotation>
					<xs:documentation>Indicates the measurement can't be planned/scheduled and/or completed due to a FOV limitation or other condition.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MeasurementTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Enumeration indicating the type of measurement within a report.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="RANGE">
				<xs:annotation>
					<xs:documentation>A measurement of the distance from the reference location of the sensor to the object in meters.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AZIMUTH">
				<xs:annotation>
					<xs:documentation>A measurement of the Azimuth angle to the object, in the identified reference frame, in units of radians.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELEVATION">
				<xs:annotation>
					<xs:documentation>A measurement of the Elevation angle, in the identified reference frame, in units of radians.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COSCONE">
				<xs:annotation>
					<xs:documentation>A measurement of the inner product between the target pointing vector and the array face. In the case of linear arrays, only the CosconeY is used and represents the inner product of the target pointing vector and the array orientation. In the case of two-dimensional arrays, both CosconeY and CosconeZ are used representing the inner product of the target pointing vector and the "Horizontal" (Y) and "Down" (Z) axes respectively.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RANGE_RATE">
				<xs:annotation>
					<xs:documentation>A measurement of the relative velocity between the reference location of the sensor and the object in meters per second.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AZIMUTH_RATE">
				<xs:annotation>
					<xs:documentation>A measurement of the angular rate of the object, in the Azimuth direction, as defined by the identified reference frame, in units of radians per second.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELEVATION_RATE">
				<xs:annotation>
					<xs:documentation>A measurement of the angular rate of the object, in the Elevation direction, as defined by the identified reference frame, in units of radians per second.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TDOA">
				<xs:annotation>
					<xs:documentation>A measurement of the relative difference of the time that a signal is detected between two or more locations, in units of seconds.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FDOA">
				<xs:annotation>
					<xs:documentation>A measurement of the relative difference of the frequency of a signal that is detected at two or more locations, in units of Hz.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MediaLocationStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides a rough indication of how long the media will be available.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TEMPORARY">
				<xs:annotation>
					<xs:documentation>Indicates a Product, File or other media will be at the specified location only temporarily, possibly because the host has limited storage and/or network connectivity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FINAL">
				<xs:annotation>
					<xs:documentation>Indicates a Product, File or other media's specified location is its final planned/intended network location, where it will remain until removed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REMOVED">
				<xs:annotation>
					<xs:documentation>Indicates a Product, File or other media was at the specified location but has since been removed and is no longer available.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MergeEnum" uci:version="000.000.000.000">
