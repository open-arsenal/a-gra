	<xs:simpleType name="MA_ValidationResultEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines possible reasons for Flight Autonomy to reject a curve during the Pre-Check, Best Effort Simulation, and Post-Check phases.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INVALID_CURVE">
				<xs:annotation>
					<xs:documentation>Denotes that the flight command was rejected due to an invalid curve command. See the CurveValidationInvalidSegment field under ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INVALID_WAYPOINT">
				<xs:annotation>
					<xs:documentation>Denotes that the flight command was rejected due to an invalid waypoint or path commanded. See the RouteValidationInvalidPath field under the ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PERFORMANCE_LIMIT_EXCEEDED">
				<xs:annotation>
					<xs:documentation>Denotes that the flight command was rejected due to expected violation of vehicle performance limits. See the PerformanceConstraint field under the ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VIOLATION_ENDURANCE">
				<xs:annotation>
					<xs:documentation>Denotes that the flight command was rejected due to expected insufficient endurance. See the InsufficientEndurance field under the ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VIOLATION_GEOFENCE">
				<xs:annotation>
					<xs:documentation>Rejected due to expected violation of a geofence. See the GeofenceConstraint field under the ValidationResultReason for more details </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VIOLATION_AIR_TRAFFIC">
				<xs:annotation>
					<xs:documentation>Rejected due to expected violation of safe operation with air traffic. See the EntityConstraint field under the ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VIOLATION_TERRAIN">
				<xs:annotation>
					<xs:documentation>Rejected due to expected violation of terrain proximity. See the TerrainConstraint field under the ValidationResultReason for more details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPABILITY_NOT_SUPPORTED">
				<xs:annotation>
					<xs:documentation>Rejected due to the commanded capability not being supported. See the CapabilityID field under the ValidationResultReason for more details. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FLIGHT_COMMAND_VALID">
				<xs:annotation>
					<xs:documentation>The flight command has been validated and accepted by the validator. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MA_WEZ_FieldOfViewEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FULL_WEZ">
				<xs:annotation>
					<xs:documentation>Represents a WEZ requested for the azimuths from 0 to 360 degrees around the ownship. Region is built out for azimuth range in radians with a default 5 degree step. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRONT_WEZ">
				<xs:annotation>
					<xs:documentation>Represents a WEZ requested for the azimuths from 0 to 180 degrees off the nose of the ownship. Region is built out for azimuth range in radians with a default 5 degree step.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RIGHT_WEZ">
				<xs:annotation>
					<xs:documentation>Represents a WEZ requested for the azimuths from 0 to 180 degrees off the right wing of the ownship. Region is built out for azimuth range in radians with a default 5 degree step.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LEFT_WEZ">
				<xs:annotation>
					<xs:documentation>Represents a WEZ requested for the azimuths from 0 to 180s degree off the left wing of the ownship. Region is built out for azimuth range in radians with a default 5 degree step. </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
