	<xs:complexType name="OrbitPlanValidationID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to OrbitPlanValidation messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationInputsType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Indicates input parameters for performing OrbitPlan validation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:PlanValidationInputsBaseType">
				<xs:sequence>
					<xs:element name="PlanID" type="uci:OrbitPlanID_Type">
						<xs:annotation>
							<xs:documentation>ID of the OrbitPlan to be validated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PlanPart" type="uci:OrbitPlanPartsEnum" minOccurs="0" maxOccurs="6">
						<xs:annotation>
							<xs:documentation>Indicates which part or parts to include in the OrbitPlan validation.  If omitted, all Parts should be validated. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Origin" type="uci:OrbitPlanningStateType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Denotes the origin (starting point) on the OrbitPlan to begin validation.  If not specified, the Plan should be validated with an origin determined from context.  For example, during dynamic validation of an active Plan, the origin could be from current System position.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationInvalidManeuverSegmentType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the maneuver segments that were found to be invalid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID associated with the maneuver segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InvalidReason" type="uci:OrbitValidationErrorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element define the reason why the maneuver segment was flagged as invalid.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationInvalidSequenceType" uci:version="001.001.000.001">
		<xs:annotation>
			<xs:documentation>Indicates which sequences have invalid maneuver segments in it.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID associated with the kinematics sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KinematicInvalidReason" type="uci:OrbitValidationErrorType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the reason why the kinematic sequence was flagged as invalid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InvalidManeuverSegment" type="uci:OrbitPlanValidationInvalidManeuverSegmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the maneuver segments that were found to be invalid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherInvalidReason" type="uci:CannotComplyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines why a sequence is marked as invalid if it is kinematically feasible, but still marked as invalid.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationMDT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitPlanValidationID" type="uci:OrbitPlanValidationID_Type">
				<xs:annotation>
					<xs:documentation>The ID of this OrbitPlanValidation message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>The ID of the Plan this status pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Validator" type="uci:ValidatorType">
				<xs:annotation>
					<xs:documentation>The ID of the Validator responsible for this Status message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ValidationState" type="uci:PlanValidationStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the determined validation state of the plan.  The variables a given planning service, operator or system considers when validating a plan varies.  Different variables might be considered for a single given System depending on the level of detail of the plan.  The scope and meaning of "valid" comes from context of the services, operator and systems creating the plan.  The value in this element can change during validation processing.  The final validity determination is given when the sibling ValidationStatus element reaches an end state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompletionStatus" type="uci:CompletionStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates actual and predicted metrics for completion of the validation process.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IncompleteItem" type="uci:IncompleteProcessingType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates items associated with command processing that failed to complete.  For example if a particular required Capability wasn't available, it could be referenced here.  This element/type is highly flexible.  It can reference almost any message/concept in UCI as a planning issue.  The wide range of messages/concepts it can reference makes it 1) difficult to use as a basis for software/services to resolve the issue but 2) an excellent general method for processing algorithms to convey issues to operators.  This element shouldn't be used to report processing issues/results that are more directly indicated by other processing status elements.  For example, for planning processing, other elements focus specifically on per-Requirement allocation results therefore this element shouldn't be used for per-Requirement allocation results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InvalidSequence" type="uci:OrbitPlanValidationInvalidSequenceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>If OrbitPlan is invalid, indicates which sequences have invalid maneuver segments in it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ModifiedPlanID" type="uci:OrbitPlanID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a modified, valid version of the evaluated plan.  This element should only be given when the evaluated plan was found to be invalid, the evaluation command indicated modification was allowed, and the modifications resulted in a valid plan.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitPlanValidationMT" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:OrbitPlanValidationMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitRegimeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbit characteristics of a space object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitRegime" type="uci:OrbitRegimeEnum">
				<xs:annotation>
					<xs:documentation>Orbit regime of a space object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitClass" type="uci:OrbitClassEnum" minOccurs="0" maxOccurs="22">
				<xs:annotation>
					<xs:documentation>Orbit class of space object, a space object can have multiple orbit classes. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitSequenceCompletedType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbit plan kinematic sequence and maneuver segment that was completed.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OrbitSequenceEstimateType">
				<xs:sequence>
					<xs:element name="ActualCaptureTime" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>Indicates the time when the System captured/reached the end of the orbit Sequence and/or Segment.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrbitSequenceEstimateType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbit plan kinematic sequence and maneuver segment that was completed.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the OrbitPlan this sequence pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the OrbitPlan kinematics sequence.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the OrbitPlan maneuver segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EstimatedCaptureTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the estimated time when the System will capture reach the end of the orbit Sequence and/or Segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitSequenceInsertionPositionChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines choice for location to insert orbit kinematics sequence.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="InsertAtStart" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates an insertion at the start of the orbit kinematics sequences.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InsertAfterOrbitKinematicsSequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the orbit kinematics sequence after which to insert the additional orbit kinematics sequences.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="OrbitTransitionSequenceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbit plan references to transition to/from.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the OrbitPlanID of the transition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SequenceID" type="uci:OrbitKinematicsSequenceID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the orbit kinematics sequence ID of the transition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentID" type="uci:OrbitManeuverSegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the orbit maneuver segment ID of the transition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitType" type="uci:OrbitEnum">
				<xs:annotation>
					<xs:documentation>What flight pattern this orbit will take.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Circle" type="uci:CircleType" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>A single point will be provided if and only if OrbitType is Circle. See annotations of each OrbitType (OrbitEnum) value for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnDirection" type="uci:RelativeDirectionEnum">
				<xs:annotation>
					<xs:documentation>Direction of turn when rounding the first loiter point.  For a figure 8, this direction applies to the first of the two Circle elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:OrbitDurationType">
				<xs:annotation>
					<xs:documentation>Duration for the orbit as either a required time spent in the orbit pattern or the number of orbits to make around the pattern.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitValidationErrorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the reason an orbit sequence is invalid. See individual fields for more details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InvalidReason" type="uci:OrbitValidationErrorEnum">
				<xs:annotation>
					<xs:documentation>Indicates the reason why an orbit sequence or maneuver segment was rejected, interrupted, unallocated, failed and/or generally can't be completed satisfactorily.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificReasonCode" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Additional System/Subsystem/Capability/SupportCapability/Component/Service related specific code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a human-readable text description of the reason for the validation error.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrderOfBattleC2_EmitterType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>An emitter's data regarding collection information,  modes/parametrics, operational schedule and other related information. Modes/Parametrics are provided, in part, by the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3). More detail found in the Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL). Additional mode/parametric information is developed through EOB correlation.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:OrderOfBattleEmitterType">
				<xs:sequence>
					<xs:element name="Position" type="uci:FixedPositionType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the geospatial position of the emitter associated with the record.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="OrderOfBattleEmitterType" uci:version="002.001.002.000">
