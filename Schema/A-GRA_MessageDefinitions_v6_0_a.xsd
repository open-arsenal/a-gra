				</xs:annotation>
			</xs:element>
			<xs:element name="ProductDisseminationEgressDestinationID" type="uci:ProductDisseminationDestinationID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The Product Dissemination Destinations which data should be sent to. This is the method to specify Product Egress within the standard Product Dissemination Workflow.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewaySpecificSettings" type="uci:GatewayConfigurationPET" minOccurs="0">
