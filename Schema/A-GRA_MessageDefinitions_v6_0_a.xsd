	<xs:simpleType name="VulnerabilityTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the allowable level of exposure risk that is acceptable while planning a task.  See enumerated values for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>Indicates that no risk is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACQUISITION">
				<xs:annotation>
					<xs:documentation>Indicates that radar acquisition time is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Indicates that radar track is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAUNCH">
				<xs:annotation>
					<xs:documentation>Indicates that threat launch is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERCEPT">
				<xs:annotation>
					<xs:documentation>Indicates that intercept is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KILL">
				<xs:annotation>
					<xs:documentation>Indicates that a kill is acceptable for planning this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALL">
				<xs:annotation>
					<xs:documentation>Indicates that any level of risk is allowed to accomplish this task.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WaypointTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the action associated with the specified waypoint.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NAV_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint does not have an additional action associated with it beyond navigation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAXI">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of a taxi route.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_START">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the start of a runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_THRESHOLD">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the nearest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_LIMIT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the furthest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH_INITIAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the initial point of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH_FINAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the final point of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF_INITIAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the initial point of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF_FINAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the final point of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TOUCHDOWN">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the desired point of touchdown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HARD_DITCH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the point at which a hard ditch of the vehicle will be performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="END_OF_PATH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the end of the specified path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeaponFuzeModeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a weapon's fuze type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="IMPACT">
				<xs:annotation>
					<xs:documentation>Fuze type that functions upon impact or a given time after impact.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY">
				<xs:annotation>
					<xs:documentation>Fuze type that uses a miniature Doppler radar set to translate lag times between transmission and reception into selectable burst height values in altitude above the target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME">
				<xs:annotation>
					<xs:documentation>Fuze type that functions after a fixed delay after the bomb is released from the aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HYDROSTATIC">
				<xs:annotation>
					<xs:documentation>Fuze type that functions at a given hydrostatic pressure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeaponFuzePositionEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates which of the weapon's fuzes the associated data applies to.  This is used while specifying the weapon fuze modes and settings.</xs:documentation>
