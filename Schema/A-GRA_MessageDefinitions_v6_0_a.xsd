			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="ExternalRequestedDataID" type="uci:ExternalRequestedDataID_Type">
						<xs:annotation>
							<xs:documentation>Indicates the record whose correlation record/history is given in the sibling.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
