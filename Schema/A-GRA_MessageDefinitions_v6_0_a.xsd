		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="IMMEDIATE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating with an urgency of immediate.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMMINENT">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating with an urgency of imminent.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARNING">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating with an urgency of warning.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating with an urgency of not immediate, imminent, or other.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
