			<xs:element name="CapabilityManager" type="uci:CapabilityManagerType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Capability Manager (an automation service, also known as a Resource Manager) that is allowed to autonomously command the Capability.  Only the primary controller is allowed to attach Capability Managers, using the ControlInterfacesCommand.  See ControlTypeEnum annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AcceptedInterface" type="uci:CapabilityControlInterfacesEnum" minOccurs="0" maxOccurs="7">
