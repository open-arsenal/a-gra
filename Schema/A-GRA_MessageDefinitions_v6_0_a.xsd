						<xs:annotation>
							<xs:documentation>This element specifies the probability of exposure that estimated exposure calculations must exceed to be counted as an actual exposure event. The length of time of exposure events are used to calculate Composite and Cumulative exposure times.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GenerateProbabilityMetrics" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>This element specifies if the probability metrics elements should be generated and included in the resulting assessment.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GenerateSurvivabilityProbability" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>This element specifies if the probability of vehicle surviving route should be generated and included in the resulting assessment.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RouteVulnerabilityType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CompositeExposureTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Provides the time duration along the route or path segment that have any amount of exposure time for any threats. For example, if five threats are all causing one second of exposure time and all five are on the exact same second along the route, the CompositeExposureTime is one second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CumulativeExposureTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Provides the sum of all exposure time incurred due to all threats for the route path or segment that this data is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThreatExposure" type="uci:ThreatExposureType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides the exposure costs incurred due to a particular threat for the route path or segment that this data is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RSO_ApproachType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a specific resident space object (RSO) around which a maneuver will take place.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RSO" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Indicates the RSO that is the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:DistanceConstraintsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired range from the RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RSTA_FileTraceabilityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Reconnaissance, surveillance, and target acquisition (RSTA), is a type of unit.  RSTA units are small reconnaissance units based on cavalry squadrons, and act at the squadron (battalion) level as a brigade reconnaissance team for the regiment (brigade).  This element provides traceability to the RSTA information.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RSTA_TraceabilityType">
				<xs:sequence>
					<xs:element name="FileID" type="uci:FileMetadataID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the file associated with the specific RSTA information.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="RSTA_TraceabilityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Allows traceability to the source of this RSTA data.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RSTA_Key" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Indicates a reference to an external (non-UCI) source for RSTA data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RSTA_ItemKey" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a specific RSTA information piece in the case where there may be multiple items.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_AccelerationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates an acceleration vector in the Radial-Transverse-Normal (RTN) reference frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Radial" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the radial component of acceleration in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Transverse" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the transverse component of acceleration in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Normal" type="uci:AccelerationType">
				<xs:annotation>
					<xs:documentation>Indicates the normal component of acceleration in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_KinematicsType" uci:version="002.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates kinematic vectors in the Radial-Transverse-Normal (RTN) reference frame, also known as the Radial, In-Track, Cross-Track (RIC) reference frame. The Radial basis vector is aligned with the position vector. The Normal basis vector is aligned with the angular momentum direction (which is the orbit normal direction). The Transverse basis vector is in the direction of N x R to complete the right-handed triad.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Epoch" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time when the kinematic data is valid.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Position" type="uci:RTN_PositionType">
				<xs:annotation>
					<xs:documentation>Indicates a position vector in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Velocity" type="uci:RTN_VelocityType">
				<xs:annotation>
					<xs:documentation>Indicates a velocity vector in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="uci:RTN_AccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an acceleration vector in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Attitude" type="uci:QuaternionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the attitude in the RTN reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Covariance" type="uci:CovarianceMatrixType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The covariance matrix along with its associated category that defines the elements represented in the covariance matrix in the RTN reference frame.  See the individual category enumerations for detailed explanations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_LocalPositionType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Describes the kinematics position and orientation in the Radial-Transverse-Normal reference frame with respect to an asset. For example the position and attitude of a sensor relative to a host satellite's body frame.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:RTN_PositionType">
				<xs:annotation>
					<xs:documentation>Indicates a position vector in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Attitude" type="uci:QuaternionType">
				<xs:annotation>
					<xs:documentation>Indicates a position vector in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeKinematics" type="uci:KinematicsOptionsType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the object for which the reference frame of the sibling elements are referenced.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_PositionDeltaType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a delta position vector in the Radial-Transverse-Normal Reference System.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadialDelta" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the delta radial component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransverseDelta" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the delta transverse component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalDelta" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the delta normal component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_PositionSigmaType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes a position in Radial-Transverse-Normal (RTN) sigmas.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RadialSigma" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the radial sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransverseSigma" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the transverse sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NormalSigma" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the normal sigma.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RTN_PositionType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a position vector in the Radial-Transverse-Normal Reference System.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Radial" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Indicates the radial component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Transverse" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Indicates the transverse component of position in the Radial-Transverse-Normal Reference System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Normal" type="uci:DistanceOffsetType">
