				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTENNAS_EXTEND">
				<xs:annotation>
					<xs:documentation>Specifies that the vehicle should extend/deploy the antennas along this segment. The state of the antennas will be extended from this point forward unless it is changed on a future segment.</xs:documentation>
