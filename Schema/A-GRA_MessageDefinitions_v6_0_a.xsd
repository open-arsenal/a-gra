				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LEFT_CIRCULAR">
				<xs:annotation>
					<xs:documentation>Left circular polarization in which the electric field vector rotates in a left-hand sense with respect to the direction of propagation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RIGHT_CIRCULAR">
				<xs:annotation>
					<xs:documentation>Right circular polarization in which the electric field vector rotates in a right-hand sense with respect to the direction of propagation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORTHOGONAL">
