					<xs:documentation>Indicates whether the Entity indicated by the sibling EntityID should include DownLocation (TRUE) or not (FALSE).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownLocation" type="uci:Point2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the DownLocation to be reported in the Entity indicated by the sibling EntityID.  This element is required when the sibling Enabled element indicates TRUE.</xs:documentation>
				</xs:annotation>
