	<xs:complexType name="ReadinessItemStatusType" uci:version="003.000.003.002">
		<xs:annotation>
			<xs:documentation>Indicates the readiness of various "items".  Item is an intentionally vague term to include any UCI concept that is first-person or first-person surrogate reported that describes operational availability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OperationalStatus" type="uci:OperationalStatusEnum">
				<xs:annotation>
					<xs:documentation>Indicates the operational readiness state of the sibling items/elements.  The sibling items/elements each have more detailed state machines that support live mission execution; only states relevant to future readiness scheduling/planning would be expected.  For example, if this element indicated OPERATIONAL, a sibling element's detailed state should be OPERATIONAL or a sub-mode/state of OPERATIONAL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reason" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reason for the OperationalStatus of the associated sibling items (e.g. System, Subsystem, Capability, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemStatus" type="uci:SystemStatusMDT" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a System Status of the vehicle reporting its readiness.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemStatus" type="uci:SubsystemStatusMDT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Subsystem Status of the vehicle reporting its readiness.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemConfiguration" type="uci:SubsystemConfigurationMDT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Subsystem Configuration of the vehicle reporting its readiness.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Capability" type="uci:CapabilityBaseType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Capability.  The CapabilityBaseType used here is abstract and must be replaced by a concrete child of the type such as EA_CapabilityMDT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityStatus" type="uci:CapabilityStatusBaseType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates readiness of a Capability.  The CapabilityStatusBaseType used here is abstract and must be replaced by a concrete child of the type such as EA_CapabilityStatusMDT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreManagementStatus" type="uci:StoreManagementStatusMDT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Store Management Status of the vehicle reporting its readiness.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ControlStatus" type="uci:ControlStatusMDT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Control Status of the vehicle reporting its readiness. This should be the expected Control Status of the vehicle and its capabilities during the reported time frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningFunction" type="uci:PlanningFunctionMDT" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the expected readiness of the System in the form of a PlanningFunction message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningFunctionStatus" type="uci:PlanningFunctionStatusMDT" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the expected readiness of the System in the form of a PlanningFunctionStatus message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PackageStatus" type="uci:PackageStatusMDT" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an instance of a Package Status.  Readiness of a Package should be reported along with the Readiness of the lead System in the Package.  This element is unbounded because a single lead System could be the leader of multiple Packages each of which has different partner Systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReadinessRecordType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Indicates the expected status of Items optionally limited by any combination of a time period and kinematic zone. For example, a ReadinessRecord is created for each TimeSpan and/or *Zone where the OperationalStatus of one or more Items changes. If OperationalStatus doesn't change for a given System for the duration of the associated Mission being planned, there would be only one ReadinessRecord and TimeSpan / *Zones would be omitted.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Item" type="uci:ReadinessItemStatusType" maxOccurs="7">
				<xs:annotation>
					<xs:documentation>Indicates the readiness of an "item" for the associated Mission.  Item is an intentionally vague term to include any UCI concept that is first-person or first-person surrogate reported that describes availability for use in a Mission.  Readiness is intended to be grouped/indexed by the child OperationalStatus element.  In other words, all readiness items with the same operational status should be grouped into one instance of this element.  A given real world Subsystem, Capability, etc. should not be reported in multiple instances of this element as they would be in conflict per the group/index guidelines above.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeSpan" type="uci:ReadinessTimeSpanType">
				<xs:annotation>
					<xs:documentation>Indicates the time when state/status in the sibling readiness Items applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeoZone" type="uci:ZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a zone where the sibling readiness Items apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalZone" type="uci:OpVolumeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an orbital zone where the sibling readiness Items apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReadinessTimeSpanType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ByMission" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates the time period is the same as the time period for the Mission referenced by the associated MissionID.  The Mission's time period is given in the corresponding MissionDefinition message.  This choice allows a simple deferral to the time period of the Mission.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubMission" type="uci:ScheduleType">
				<xs:annotation>
					<xs:documentation>Indicates the time period is a discrete one, shorter than that of the entire associated Mission.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ReceiverIdentificationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the object in the system that should process a message.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemIdentifier" type="uci:SystemMessageIdentifierType">
				<xs:annotation>
