	<xs:complexType name="GatewayLinkStatisticsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides a view into the health of a Data Gateway providing feedback regarding Data Flow, Error Rates, and Utilization Percentages.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a unique identifier for the configuration of an individual network connection.  Provides for the correlation of network link to a new activity or to an existing activity that will be updated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewayRxUtilization" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the current utilization state of the gateway. 100% indicates a gateway which cannot handle any more incoming traffic.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GatewayTxUtilization" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the current utilization state of the gateway. 100% indicates a gateway which cannot handle any more incoming data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxDataErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average Receive Bit Error Rate per second for this reporting period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxDataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Data Rate stored in bits per second since the last Message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxMessageErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average Error Rate for Messages Received per second for this reporting period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RxMessageRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Data Rate stored in Messages per second since the last Message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxDataErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average transmission Bit Error Rate per second for this reporting period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxDataRate" type="uci:DataRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Data Rate stored in bits per second since the last Message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxMessageErrorRate" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>In percentile, the average Error Rate for MessagesTransmitted per second for this reporting period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TxMessageRate" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The average Message Rate stored in Messages per second since the last Message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkPortMap" type="uci:CommLinkPortMapType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides a reflection of what port assignments (IO and RF) are associated with this link. It is possible to have more than one to reflect multiple simultaneous paths.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkNativeStatistics" type="uci:GatewayNativeStatisticsPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Extension point to allow for the unique data-link specific statistics to be reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
