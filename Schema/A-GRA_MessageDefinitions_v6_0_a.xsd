					<xs:documentation>Indicates the RDMA Initialize ID that this message is in response to for re-establishing connections, or empty if new connection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
