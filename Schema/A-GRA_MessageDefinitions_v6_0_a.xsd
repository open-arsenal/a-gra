		<xs:sequence>
			<xs:element name="ACTDF_MissionIdentifier" type="uci:AlphanumericString54Type">
				<xs:annotation>
					<xs:documentation>Encompasses all Mission Identifiers: alpha, numeric, and alphanumeric. The preferred format conforms to the CCJSI 3250.01d.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ACTDF_CollectionPlanIdentifier" type="uci:ACTDF_CollectionPlanType">
