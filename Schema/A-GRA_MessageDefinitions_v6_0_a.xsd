				</xs:annotation>
			</xs:element>
			<xs:element name="Human" type="uci:EmptyType">
				<xs:annotation>
					<xs:documentation>Indicates the object is a human.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="DamageObservationSourceType" uci:version="001.000.002.000">
