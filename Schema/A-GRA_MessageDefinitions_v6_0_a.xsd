			<xs:element name="UseAllPasses" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Collect metric observations on all passes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NumberOfObservations" type="uci:ObservationsPerTrackLimitsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum and Maximum number of observations required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CenteredAtMaxPredictedSNR" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If possible, collect when centered at maximum predicted signal-to-noise-ratio.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpacingOfObservations" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time between observation collection (in seconds).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportPointSOI" type="xs:boolean" minOccurs="0">
