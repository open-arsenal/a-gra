				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE">
				<xs:annotation>
					<xs:documentation>Indicates passive activities will be given priority.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BALANCED">
				<xs:annotation>
					<xs:documentation>Indicates a balance between active and passive activities will be attempted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EmitterUrgencyEnum" uci:version="000.000.000.000">
