					<xs:documentation>A deleted dwell can't be re-enabled, including by an automated Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COMINT_Interactive" type="uci:COMINT_InteractiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element identifies additional parameters of a COMINT subsystem which may be adjusted interactively during operation.</xs:documentation>
				</xs:annotation>
			</xs:element>
