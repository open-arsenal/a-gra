					<xs:documentation>If the turret includes its own IMU, this element is used to report the current state.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TurretReportMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:TurretReportMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TurretReportPointingType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="FixedPointing" type="uci:FixedPointingEnum">
				<xs:annotation>
					<xs:documentation>Enumeration defining the Gimbal Modes that must be explicitly commanded. Other modes can be reached by generating an appropriate command (e.g. sending a platform referenced Position command will put the turret in a body fixed mode, while sending a PointTarget will put it into a geo-referenced mode).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Dynamic" type="uci:TurretReportDynamicPointingType">
				<xs:annotation>
					<xs:documentation>Specifies the look angle of the gimbal using heading and pitch and optional heading and pitch rate of change.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="TurretStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Component of the vehicle that provides a gimbal for other components, such as optical sensors (EOIR ball), laser designators, or directed energy weapons.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SupportCapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="CapabilityID" type="uci:CapabilityID_Type" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the ID of a Capability whose control requires use of the turret.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NumberOfAxes" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>This element indicates the number of rotational degrees of freedom the turret provides.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Stabilized" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>If the turret provides the ability to actively cancel out host platform vibrations or rigid body motion (i.e. fix the turret orientation in the inertial frame) then this element is TRUE.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TurretStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:TurretStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="TxBeamType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BeamID" type="uci:BeamID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of this beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DutyCycle" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the duty cycle of the beam.  The sum of duty cycles of all Beams indicates the duty cycle of the antenna.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EffectiveRadiatedPower" type="uci:MilliwattPowerRatioType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The Effective Radiated Power (ERP) of the Beam.  The sum of ERP of all Beams indicates the ERP of the antenna component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthWidth" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the beam's width in azimuth.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ElevationWidth" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>Indicates the beam's width in elevation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StartPosition" type="uci:Point3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the position of the host Subsystem at the sibling StartTime.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Time" type="uci:DateTimeRangeBeginType">
				<xs:annotation>
					<xs:documentation>Indicates the start and stop time of the jamming beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackingMode" type="uci:EA_PointingEnum">
				<xs:annotation>
					<xs:documentation>This element indicates the form of tracking being used to point the antenna.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emission" type="uci:EA_EmissionType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a jamming emission of the Beam.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamPointingReference" type="uci:BeamPointingReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates current beam pointing.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UMID_AudioID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique Material ID (UMID) Audio.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UMID_DataID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique Material ID (UMID) Data.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UMID_SystemID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique Material ID (UMID) System.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UMID_VideoID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Unique Material ID (UMID) Video.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UnachievableRequirementType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates an unachievable Requirement.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequirementID" type="uci:RequirementInstanceID_ChoiceType">
				<xs:annotation>
					<xs:documentation>Unique object identifier for a Requirement found to be unachievable given available/candidate Systems.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnallocatedReason" type="uci:UnallocatedReasonType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates details regarding the reason why the Requirement is unachievable or could not be allocated.  Multiple instances are allowed because a single Requirement can have many unallocated reasons, one or more per System that allocation was attempted against.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnallocatedReasonType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CannotComplyType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a System that a Task couldn't be allocated to.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UncertaintyEllipse" type="uci:EllipseType">
				<xs:annotation>
					<xs:documentation>This element represents an ellipse describing the 1-sigma position uncertainty.  The ellipse is defined by the length of its semi-major and semi-minor axes.  The orientation of the ellipse defines the angle between the semi-major axis and true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyVertical" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents 1-sigma position uncertainty perpendicular to the sibling UncertaintyEllipse surface (in the up-down direction).  Combined with the sibling UncertaintyEllipse this results in an uncertainty ellipsoid with "height".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyTilt" type="uci:AngleHalfType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measured as the angle between the projection of the slant range position uncertainty axis onto the level plane and the slant range position uncertainty axis. Positive angle is measured counter-clockwise from local level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnitID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the Unit UUID.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="UnitIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UnitUUID" type="uci:UnitID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the UUID for a Unit within an OrderOfBattle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identifier" type="uci:UnitIdentifierType">
				<xs:annotation>
					<xs:documentation>Unique identifier for each unit: based on source data conglomeration.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Name" type="uci:UnitNameType">
				<xs:annotation>
					<xs:documentation>Unit name as determined by appropriate authority or orders as used in official orders or communications within the national military or civilian establishment of the country of allegiance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurrogateKey" type="uci:String20Type">
				<xs:annotation>
					<xs:documentation>The surrogate key, established at row creation time, uniquely identifies each row of UNIT data. (Surrogate key: position 1-5 = unique site or server prefix, position 6-14 = one up number (zero filled)).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OB_Type" type="uci:OrderOfBattleEnum" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates the type of Order-of-Battle to which a unit or equipment belongs. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SymbolCode" type="uci:NameSpecialCharacterRestrictionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A standard scheme for symbol coding enabling the transfer, display and use of symbols and graphics among information systems, as per MIL-STD 2525B, and supported by the element AFFILIATION.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnitType" uci:version="003.002.003.000">
		<xs:annotation>
			<xs:documentation>Represents a Unit in an OB.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SecurityInformation" type="uci:SecurityInformationType">
				<xs:annotation>
					<xs:documentation>Contains the security marking information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:UnitIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates the Unit specific identity information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StandardIdentity" type="uci:StandardIdentityConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the association of the assessed threat that the entity imposes towards the U.S. and its allies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CountryCode" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Country in which the geographic coordinates reside.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Position" type="uci:EOB_FixedPositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial position of the Unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamps" type="uci:OrderOfBattleTimestampsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates relevant temporal information of the Unit record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Evaluation" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reliability/degree of confidence that the analyst has assigned to the data within this record. A common range is [0,9].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationalStatus" type="uci:OB_OperationalStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Degree to which an entity is ready to perform the overall operational mission or missions for which it was organized and equipped.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PoliticalSubdivision" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Political subdivision in which the geographic coordinates reside.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllegianceAlternate" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The DoD Standard Country Code designator for the country or political entity to which the entity may also owe its allegiance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeploymentStatus" type="uci:String20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A code describing the amount of unit participation in a deployment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DivisionCategory" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Combat status of a divisional or equivalent unit.  Currently, this data element applies only to units of the Former Soviet Union.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Echelon" type="uci:String20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Organizational level of the unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EchelonTier" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the major group or level to which an echelon belongs. A common range is [0,99].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FlagFlown" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The country code of the observed flag flown.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FleetAssignment" type="uci:String4Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Naval fleet to which a unit is assigned.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AirDefenseArea" type="uci:AirDefenseAreaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Air Defense District (ADD) or Air Defense Area (ADA) in which the geographic coordinates reside. ([A-Z][A-Z] - Position 1-2, Two character alphabetic field.; 0[0-9][0-9] - Position 3-5,  Air Defense Area in which the geographic coordinates resides.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceAssignment" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An aggregation of military units within a single service (i.e., ARMY, AIR FORCE, etc.) which operates under a single authority to accomplish a common mission.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForceName" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The specific name for a given force.  For example, Force = ADF (Air Defense Force) and Force Name = Army Air Defense Force.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FunctionRole" type="uci:String20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Principal combat-related role that a unit is organized, structured and equipped to perform.  Or, the specialized military or paramilitary branch in which an individual serves, their specialization.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionPrimary" type="uci:String4Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the principal type of mission that an entity is organized and equipped to perform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionPrimarySpecialty" type="uci:String4Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the principal specialty type of mission that an entity is organized and equipped to perform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionSecondary" type="uci:String4Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the secondary type of mission that an entity is organized and equipped to perform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionSecondarySpecialty" type="uci:String4Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the secondary specialty type of mission that an entity is organized and equipped to perform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NuclearCapacity" type="uci:String20Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Ability to conduct nuclear warfare.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ParentUnitID" type="uci:ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the UUID for unit to which this unit is subordinate.  If the current record is top, ParentUnitID is not specified.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Site" type="uci:BaseEOB_RecordType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies any sites contained within the unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Equipment" type="uci:EOB_EquipmentRecordType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Specifies equipment not identified with a site and contained within the unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnitVectorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The common base type for all UCI Unit Vectors. All extension types should end in "UnitVectorType".</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="X" type="uci:UnitBallFloatType">
				<xs:annotation>
					<xs:documentation>Indicates the X axis unit vector component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Y" type="uci:UnitBallFloatType">
				<xs:annotation>
					<xs:documentation>Indicates the Y axis unit vector component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Z" type="uci:UnitBallFloatType">
				<xs:annotation>
					<xs:documentation>Indicates the Z axis unit vector component.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UnsignedIntegerMinMaxType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Generic type for xs:unsignedInt minimum and maximum allowable settings values.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Minimum allowable value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Maximum allowable value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UserLinkStatusType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique identifier for the configuration of an individual network connection.  Provides for the correlation of network link to a new activity or to an existing activity that will be updated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkPortMap" type="uci:CommLinkPortMapType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides a reflection of what port assignments (IO and RF) are associated with this link. It is possible to have more than one to reflect multiple simultaneous paths.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkConnectionState" type="uci:CommConnectionStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the ability of the user link to transfer payload data over the network medium.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkStatistics" type="uci:CommLinkStatisticsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For the periodicity of this message this is a report of the link statistics provided by this capability and its links.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommonSettingsStatus" type="uci:CommControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates general waveform configuration settings that apply to all waveforms.  Note that these settings do not apply to individual data-link connections provided by the waveform or to the logical link control layer (LLC) and above, but do apply to the physical and medium access control layers that are just to maintain the waveforms connection to the network.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ValidationCommandBaseType" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The base type for all *ValidationCommand messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandBaseType">
				<xs:sequence>
					<xs:element name="ForPlanningUseOnly" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>When TRUE, indicates any *Plan modified is to be used only for intermediate planning purposes.  It will eventually be replaced/superseded by another *Plan or be discarded/abandoned.  *Plans with this flag should only be used when explicitly referenced by other messages.  These *Plans should never: trigger functionality, be subject to approvals, be activated, etc.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestFrequencyType" type="uci:RepeatEnum">
						<xs:annotation>
							<xs:documentation>Indicates whether this request for validation is a request for a single reply, or a request for periodic validation with a corresponding request to cease periodic validation.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="RequestFrequencyPeriod" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>If requesting periodic validation, this field specifies the amount of time that should elapse between the periodic validation, i.e. the repetition time interval of the validation.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ValidationCommandStatusBaseType" abstract="true" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>The base type for all *ValidationCommandStatus messages.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandStatusBaseType">
				<xs:sequence>
					<xs:element name="CommandStatus" type="uci:ProcessingStatusEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the status of the processing of the command after the command has reached a RECEIVED state in the prior state machine.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CompletionStatus" type="uci:CompletionStatusType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates actual and predicted metrics for completion of the command.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="IncompleteItem" type="uci:IncompleteProcessingType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates items associated with command processing that failed to complete.  For example if a particular required Capability wasn't available, it could be referenced here.  This element/type is highly flexible.  It can reference almost any message/concept in UCI as a planning issue.  The wide range of messages/concepts it can reference makes it 1) difficult to use as a basis for software/services to resolve the issue but 2) an excellent general method for processing algorithms to convey issues to operators.  This element shouldn't be used to report processing issues/results that are more directly indicated by other processing status elements.  For example, for planning processing, other elements focus specifically on per-Requirement allocation results therefore this element shouldn't be used for per-Requirement allocation results.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ValidatorType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to a Validator.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OperatorID" type="uci:OperatorID_Type">
				<xs:annotation>
					<xs:documentation>An Operator identifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NonOperatorIdentifier" type="uci:SystemServiceType">
				<xs:annotation>
					<xs:documentation>A non-Operator identifier that consists of a System and possibly a Service.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ValveDataStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the state of the valve data within the pump.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ComponentDetailedStatusType">
				<xs:sequence>
					<xs:element name="Open" type="uci:PercentType">
						<xs:annotation>
							<xs:documentation>Indicates the percent the valve is open (0% is fully closed, 100% fully open).</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="VariableSubsystemsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines a list of possible configurations for a system.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Configuration" type="uci:CapabilityConfigurationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A configuration option for this independently configurable set of subsystems.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VCM_DataType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>The covariance data provides a measure of the strength of the correlation between two or more elements of the orbit or tracked object state (position/velocity/other quantities), each of which have some underlying degree of statistical variation. The correlation coefficient between any two elements of the state can be derived from the variances and covariances of the two elements.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PositionSigma" type="uci:RTN_PositionSigmaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Sigma estimates for the satellite position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VelocitySigma" type="uci:RTN_VelocitySigmaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Sigma estimates for the satellite velocity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeightedRMS" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Weighted Root Mean Square of last differential correction on the satellite.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CovarianceMatrix" type="uci:CovarianceMatrixType">
				<xs:annotation>
					<xs:documentation>The covariance matrix along with its associated category that defines the elements represented in the covariance matrix.  See the individual category enumerations for detailed explanations.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VCM_DragParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines drag parameters used for VCM propagation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BallisticCoefficient" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The ballistic coefficient is defined as drag coefficient times area over mass. It has units of meters squared per kilogram and is used for VCM propagation. It accounts for the effects imposed by the specific interaction of the satellite's shape and material composition with regard to drag model for the Earth's atmosphere.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BallisticCoefficientDot" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Rate of change (first derivative) of ballistic coefficient. Each dot represents a Ballistic Coefficient measurement made by the initial velocity and time of flight method.  A generic representation of the first derivative (i.e., rate of change) of a ballistic coefficient measurement in meters squared per kilogram-second.  May be omitted when atmospheric perturbations are not used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VCM_ForceModelOptionsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Describes VCM specific force model options.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IsLunarSolarOn" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether lunar and solar gravity perturbations are to be applied.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsSolarRadiationPressureOn" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether solar radiation pressure is to be included in the perturbation model.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsInTrackThrustOn" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether in-track thrust is to be included in the perturbation model</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InTrackThrustAcceleration" type="uci:AccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used for VCM propagation. In-track thrust acceleration measured in meters per second squared. See base description for more details. May be omitted when in-track thrust is not used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CenterOfMassOffset" type="uci:DistanceOffsetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used for VCM propagation. Represents the distance that a satellite's center of mass is offset from its center of volume, measured in meters (m). See base description for more details.  May be omitted when not required by the force model for perturbations used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VCM_IntegratorSettingsType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Includes integrator settings that are exclusive to VCM propagation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="IntegratorMode" type="uci:AS_IntegratorModeEnum">
				<xs:annotation>
					<xs:documentation>Specifies which USSF Astrodynamics Standards integrator mode to use.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypeOfPartialDerivatives" type="uci:AS_PartialDerivativesEnum">
				<xs:annotation>
					<xs:documentation>Partial Derivatives Type. Represents the different ways the propagator can calculate partial derivatives.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepMode" type="uci:AS_IntegratorStepModeEnum">
				<xs:annotation>
					<xs:documentation>Represents the type of step used by the integrator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IsFixedStepSize" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Controls whether the integration step size is fixed or variable. When true, the integration step size is the same at every integration step. When false, the step size at any given integration step is determined by the integrator and may vary at each step.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialStepSizeSelectionControl" type="uci:InitialStepSizeEnum">
				<xs:annotation>
					<xs:documentation>Step Size Selection Control Enumeration Type. Controls how the initial integration step size is determined.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialStepSize" type="uci:DoublePositiveType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The specified initial step size used by the integrator. For fixed-step integrators, this is the fixed step size. Only used for VCM propgation when the InitialStepSizeSelectionControl = MANUAL. A common range is [0.001,9999.999].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ErrorControl" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The integration error used to control automatic step size changes. Not used for fixed-step integration methods.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VCM_PropagatorType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes a propagator for a space object by defining the force models and integrator settings.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ForceModel" type="uci:ForceModelType">
				<xs:annotation>
					<xs:documentation>The force model to be used to compute forces and accelerations for propagation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VCM_IntegratorSettings" type="uci:VCM_IntegratorSettingsType">
				<xs:annotation>
					<xs:documentation>The integrator settings for VCM propagation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleCommandDataType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VehicleAction" type="uci:VehicleActionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines vehicle actions that can be done along a path segment of a route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IFF_Settings" type="uci:IFF_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present the IFF settings for this vehicle will be changed along this path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurvivabilityMode" type="uci:VehicleSurvivabilityModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies that the vehicle should put itself into a more survivable mode. Different vehicles will have specific behaviors that reduce the signature of the vehicle (doors closed, minimal use of flaps, etc.) If this element is not present then it is assumed that the aircraft being configured has no survivability mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LostCommTimeout" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the lost communication contingency timeout. When this timeout value is exceeded, the AV considers that lost communication has occurred and begins to perform contingency measures.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LOS" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Use Line Of Sight (LOS) communication as backup contingency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LossOfLinkProcessing" type="uci:VehicleLossOfLinkProcessingEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies whether the vehicle should invoke special Loss of Link processing. This could be turned off if the vehicle is going to be in a known and accepted lost communication situation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommAllocationAction" type="uci:CommAllocationActionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a change of communication allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleConfigurationType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="InertialState" type="uci:InertialStateRelativeType">
				<xs:annotation>
					<xs:documentation>Planned/predicted/expected/future state (position, velocity, orientation and time) from which planning should and/or did occur. Position data may be specified as either a geospatial point or relative to a separately defined reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endurance" type="uci:EnduranceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the planned/predicted/expected/future endurance available at the position indicated by the sibling element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GrossWeight" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the planned/predicted/expected/future gross weight at the position indicated by the sibling element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleIdentificationType" uci:version="003.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the UCI SystemID of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleUniqueIdentifier" type="uci:VehicleUniqueIdentifierType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier for the vehicle. This will differ depending on the type of vehicle. Air platforms will have a Tail Number. Space assets will have a Sat ID. Maritime (ships and subs) will have Hull Numbers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IFF" type="uci:IFF_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates Identify Friend or Foe (IFF) modes and settings for the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CallSign" type="uci:CallSignType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a call sign for the asset.  Multiple call signs are allowed for different communications systems, registries or other reasons.  The use of ForeignKeyType is an indication that call signs aren't universally defined and come from multiple systems/sources but they are expected to be unique within the context of their source.  The child Key element indicates the call sign itself while the child SystemName element indicates the system that assigned it and ensures it is unique.  Call signs from ubiquitous systems/sources such as AIS are given in sibling elements and shouldn't be repeated here.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarCrossSection" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The specific Radar Cross Section identification for this system.  This will typically be a system-specific and service-specific identifier for pre-configured Radar Cross Sectional data.  Services should have coordinated this data ahead of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkIdentifier" type="uci:DataLinkIdentifierPET" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>List of data link ID. Multiple data link IDs can be reported for the same network type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleThreatAssessmentDataType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>The results of an assessment that determines vulnerability of a system at a given point.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This element identifies the System to which this assessment applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PredictedThreatAssessment" type="uci:PredictedThreatAssessmentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Optional array of detection probabilities for each track (if any) with a detection probability greater than 0 for the vehicle at the position specified within the AssessmentRequest message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleThreatAssessmentRequestType" uci:version="001.000.002.001">
		<xs:annotation>
			<xs:documentation>The inputs used in generating and/or requesting a Vehicle Threat Assessment.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AssessmentSuppression" type="uci:AssessmentSuppressionEnum">
				<xs:annotation>
					<xs:documentation>This element specifies whether the assessment should generate results which include suppression or not. The INCLUDE_BOTH option indicates that the results should include assessments with and without suppression.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThreatCapability" type="uci:ThreatCapabilityEnum">
				<xs:annotation>
					<xs:documentation>Specifies the type of assessment required (i.e. - detection method or technology).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemToAssess" type="uci:SystemPositionSpecificationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element identifies the vehicle that should be used for threat assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportingSystem" type="uci:SystemPositionSpecificationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element identifies other vehicles that are to be considered for the assessment, but not assessed (i.e. include a vehicle with a supporting capability, but there is no need to assess the supporting vehicle, just the vehicle being supported).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EntityID" type="uci:EntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element is used if the threat assessment should be generated in regards to only certain threats. If this element is not specified then all entities are considered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenerateDetectionEnvelope" type="uci:DetectionEnvelopeParametersType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates a request to generate a detection envelope. The sub-elements may specify parameters for how to generate it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenerateThreatZone" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates a request to generate a threat zone.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleThreatAssessmentType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Base data structure containing both the inputs and outputs for a Vehicle Threat Assessment.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Parameters" type="uci:VehicleThreatAssessmentRequestType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element defines the parameters used in calculating the sibling results.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Data" type="uci:VehicleThreatAssessmentDataType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element defines the results of a vehicle threat assessment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleUniqueIdentifierType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Unique identifier for a vehicle. This will differ depending on the type of vehicle. Air platforms will have a Tail Number. Space assets will have a Sat ID. Ships and Subs will have AIS Numbers.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AIS" type="uci:AIS_Type">
				<xs:annotation>
					<xs:documentation>Indicates select maritime Automatic Identification System (AIS) settings for the asset/vessel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TailNumber" type="uci:TailNumberType">
				<xs:annotation>
					<xs:documentation>Unique identifier for air platforms.  See type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Satellite" type="uci:SatelliteIdentifierType">
				<xs:annotation>
					<xs:documentation>The Satellite Identifier used to identify a Satellite.  See type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AlternateIdentifier" type="uci:AlphanumericDashSpaceUnderscoreString20Type">
				<xs:annotation>
					<xs:documentation>Unique identifier that does not fall into any of the other categories. e.g. A Land based vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="Velocity2D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Velocity relative to WGS-84 ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NorthSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true north vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EastSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true east vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Inertial vertical speed component pointing down measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct.  The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Velocity2D_UncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Velocity relative to WGS-84 ellipsoid with associated uncertainty element.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:Velocity2D_Type">
				<xs:sequence>
					<xs:element name="Uncertainty" type="uci:UncertaintyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provide a measure of uncertainty concerning the velocity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="Velocity3D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Velocity relative to WGS-84 ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NorthSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true north vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EastSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true east vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Inertial vertical speed component pointing down measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct.  The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VelocityAccelerationCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VnAn" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-North velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnAe" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-East velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Down velocity-acceleration covariance with units of meters squared per second cubed. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeAn" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-North velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeAe" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-East velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Down velocity-acceleration covariance with units of meters squared per second cubed. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdAn" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-North velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdAe" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-East velocity-acceleration covariance with units of meters squared per second cubed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdAd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-Down velocity-acceleration covariance with units of meters squared per second. Required when the acceleration includes a down component.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VelocityOrientationCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VnRr" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-Roll velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnRp" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-Pitch velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnRy" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Yaw velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeRr" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-Roll velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeRp" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-Pitch velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeRy" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Yaw velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdRr" type="xs:double">
				<xs:annotation>
					<xs:documentation>Down-Roll velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdRp" type="xs:double">
				<xs:annotation>
					<xs:documentation>Down-Pitch velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdRy" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-Yaw velocity-angle covariance with units of meters per second.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VelocityVelocityCovarianceCartesianType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the velocity-velocity covariance matrix for a Cartesian coordinate system.   Velocity covariance is symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VxVx" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 1 term of the result matrix. X-X velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VxVy" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 2 term of the result matrix. X-Y velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VxVz" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 1 Column 3 term of the result matrix.  X-Z velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VyVy" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 2 Column 2 term of the result matrix.  Y-Y velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VyVz" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 2 Column 3 term of the result matrix.  Y-Z velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VzVz" type="xs:double">
				<xs:annotation>
					<xs:documentation>Row 3 Column 3 term of the result matrix.  Z-Z velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VelocityVelocityCovarianceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VnVn" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-North velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnVe" type="xs:double">
				<xs:annotation>
					<xs:documentation>North-East velocity-velocity covariance with units of meters squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VnVd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>North-Down velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeVe" type="xs:double">
				<xs:annotation>
					<xs:documentation>East-East velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VeVd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>East-Down velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VdVd" type="xs:double" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Down-Down velocity-velocity covariance with units of meters squared per second squared.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VerboseStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Verbose" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Sets whether Activity messages should be verbose (indicating all current settings vs a smaller message).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VerboseRate" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The rate per second (Hz) at which verbose activities should be sent. This means that at the rate specified a verbose Activity will be sent. All others will be non-verbose.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VersionedID_Type" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that use versioning.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type">
				<xs:sequence>
					<xs:element name="Version" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates an incremental version of an item in which only minor changes have been made.  An example of a change that would require a new UUID and not just a new version would be for changes that affect task allocations or changes that require re-approval.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="VideoAugmentationParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type extends AugmentationProcessingParametersType to provide augmentation parameters specific to video processing.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:AugmentationProcessingParametersType">
				<xs:sequence>
					<xs:element name="KeySet" type="uci:VisibleString1024Type">
						<xs:annotation>
							<xs:documentation>Defines a KLV dictionary configuration to apply to the video product. The configuration identifies which data elements or fields (MISB standard keys) of the product should be augmented.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="VideoEncoderOutputType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Video encoder output defines the multicast or file to contain the output from an encoder.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="SocketAddress" type="uci:IP_ConnectionChoiceType">
				<xs:annotation>
					<xs:documentation>Configure a Multicast or Broadcast IP connection for the video encoder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="File" type="uci:FileNameAndOutputType">
				<xs:annotation>
					<xs:documentation>File(s) to output the encoded video data. Type of file could be deduced from the file name extension or from the Type field.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="VideoEncoderSettingsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EncodingType" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Encoding algorithm or codec. Examples h264, h265, or AV1. If not specified, then use the default encoding codec for the encoder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Profile" type="uci:VisibleString32Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Profile for the encoding. Examples: Main:L4 or High:L5.1.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EncodingBlocks" type="uci:VideoBlockSizeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Encoding Block or Coding Tree Unit size. For example, h264 has only 16x16; h265 has 64x64, 32x32 and 16x16; AV1 has 128x128, 64x64, 32x32, 16x16, and 8x8.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChromaSubsample" type="uci:VideoChromaSubsampleEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Chroma subsampling to use for encoding.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrameRate" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Output Frame Rate to use for encoding. Examples 24 Hz, 30 Hz, 60 Hz, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HDR" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Use High Dynamic Range (HDR) encoding otherwise use Standard Dynamic Range (SDR) for encoding.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BitRate" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Video encoder output bit rate from 1 Mbps up to 10 Mbps in 1 kbps increments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmbedKLV_Metadata" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Embed the KLV metadata in the video stream.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmbedPlatformMetadata" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Embed the platform/sensor metadata in the video stream.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SkipFrames" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Video encoder skip frames from 0 up to 59 in 1 frame increments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="QuantMinMax" type="uci:UnsignedIntegerMinMaxType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the minimum and maximum allowed quantization values for the video encoder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CompressionMode" type="uci:VideoEncoderCompressionModeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the priority of the video encoder compression. If CONSTANT_QUALITY is selected, Quant Min is the Quality value and Quant Max is ignored. If CONSTANT_BIT_RATE is seletected, the Quality value will vary between Quant Min and Quant Max.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="B_Frames" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Number of partial frames in the compressed video that reference data from previous and future frames. The GOP structure is often referred by two numbers, for example, M=3, N=12. The first number tells the distance between two anchor frames (I or P). The second one tells the distance between two full images (I-frames): it is the GOP size. For the example, with M=3 and N=12, the GOP structure is IBBPBBPBBPBBI. Instead of the M parameter, the maximal count of B-frames between two consecutive anchor frames can be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GOP_Size" type="xs:unsignedShort" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the Group of Picture (GOP) size, the number of frames between I-frames.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IntraRefreshMode" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates to use intra-refresh mode and the intra-refresh percentage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IntraRefreshPercentage" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percentage used for the intra-refresh mode when IntraRefreshMode is set to true.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ColorBitDepth" type="xs:unsignedByte">
				<xs:annotation>
					<xs:documentation>Number of bits used to indicate the color of a single pixel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Crop" type="uci:CropType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates cropping of a video frame and specifies the origin, width, and height of the crop.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Scaling" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the scaling of the output video for the video encoder.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VideoOutputSettingsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Video output settings for taking inputs and encoding and sending to outputs.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Enable" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Enable the video output settings.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceChannel" type="xs:unsignedShort" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Source channel(s) for the video data. If more than one source channel is specified, merge into output.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Output" type="uci:VideoEncoderOutputType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Output for the encoded data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EncoderSettings" type="uci:VideoEncoderSettingsType">
				<xs:annotation>
					<xs:documentation>Specifies encoder settings for the video output.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VisMagParamsType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>The Visual Magnitude (vis_mag) parameters consists of the amplitude Resolution (measured in meters per pixel) and the optional product resolution time parameter (the minimum amount of time needed to get the desired level of resolution for the product).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AmplitudeResolution" type="uci:ResolutionMetersPerPixelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The amplitude resolution is the desired meters per pixel resolution of the collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductResolutionTime" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The optional product resolution time parameter is the minimum amount of time needed to get the desired level of resolution for the product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VisualMagnitudeLimitsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Visual Magnitude Min and Max bounds.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="uci:VisualMagnitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum Visual Magnitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="uci:VisualMagnitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum Visual Magnitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VisualMagnitudeWithDeviationType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>Indicates measurement fields associated with visual magnitude (brightness level).</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NominalVisualMagnitude" type="uci:VisualMagnitudeType">
				<xs:annotation>
					<xs:documentation>Indicates the nominal visual magnitude measured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NominalVisualMagnitudeStdDev" type="uci:DoubleNonNegativeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the standard deviation of visual magnitude measurement.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VoiceControlType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>This type contains the connection data needed to communicate with a vehicle using voice radios.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VoiceFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Frequency between 225 to 400 MHz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceChannelA" type="uci:Link16_VoiceChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Prearranged channel number between 0-127.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceChannelB" type="uci:Link16_VoiceChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Prearranged channel number between 0-127.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VolumeChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="OpVolumeID" type="uci:OpVolumeID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a volume defined by an existing OpVolume.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VolumeTarget" type="uci:OpVolumeType">
				<xs:annotation>
					<xs:documentation>Indicates a volume defined directly here.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="VulnerabilityLevelsCombinedType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AcquisitionCostLevels" type="uci:VulnerabilityLevelsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the threshold levels of detection by acquisition radars.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackCostLevels" type="uci:VulnerabilityLevelsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the threshold levels of exposure to track radars.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterceptCostLevels" type="uci:VulnerabilityLevelsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the threshold levels of probably of intercept (impact) by a threat.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchCostLevels" type="uci:VulnerabilityLevelsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the threshold levels of probably of launch by a threat.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfSurvival" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the threshold levels for overall survivability prediction.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VulnerabilityLevelsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CompositeExposureTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Provides the time duration along the *Plan that has any amount of exposure time for any threats. For example, if five threats are all causing one second of exposure time and all five are on the exact same second along the *Plan, the CompositeExposureTime is one second.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CumulativeExposureTime" type="uci:DurationType">
				<xs:annotation>
					<xs:documentation>Provides the sum of all exposure time incurred due to all threats for the route path or segment that this data is associated with.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VulnerabilityMetricsType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AcquisitionMetrics" type="uci:RouteVulnerabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the detection by an Early Warning radar or by the acquisition radar associated with a Surface-to-Air Missile (SAM) site.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackMetrics" type="uci:RouteVulnerabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the exposure to a SAM site's tracking (missile guidance) radar system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LaunchMetrics" type="uci:RouteVulnerabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines missile launch opportunities, defined as a tracking radar exposure that occurs at a time when a valid kinematic missile firing solution exists.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterceptMetrics" type="uci:RouteVulnerabilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines missile intercept opportunities, defined as a launch opportunity followed by a sufficient time period of tracking/guidance radar detection to guide the missile all the way to intercept, with no detection dropouts longer than the missile's coast time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProbabilityOfSurvival" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated cumulative probability of survival based on the above metrics.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExposureEventProbabilityThreshold" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the probability of exposure that estimated exposure calculations must exceed to be counted as an actual exposure event. The length of time of exposure events are used to calculate Composite and Cumulative exposure times.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WayPointPointChoiceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Location associated with the specified waypoint expressed as either a geospatial or relative point.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point2D" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial point corresponding to the waypoint.  Generally, services are encouraged to send altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point2D_RelativeType">
				<xs:annotation>
					<xs:documentation>Indicates the Relative point corresponding to the waypoint.  Generally, services are encouraged to send altitude data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="WayPointType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>This element is used to specify a point in the route where no turning occurs.  It is generally used for points associated with Actions such as task "transitions", changes in acceleration, changes in speed, changes in altitude, etc.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PointChoice" type="uci:WayPointPointChoiceType">
				<xs:annotation>
					<xs:documentation>Location associated with the specified waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WaypointType" type="uci:WaypointTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the action associated with the specified waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_PointID" type="uci:DMPI_ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that this point is the final point in a weapon route with the weapon expecting to impact at the DMPI specified.  The last waypoint of a weapon route may be the terminal guidance entry point.  In this case, the waypoint specified may not be the same as the DMPIs location.  It is the point of entrance into terminal guidance of the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeaponeeringLocationType" uci:version="002.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:WeaponeeringType">
				<xs:sequence>
					<xs:element name="TargetLocation" type="uci:DMPI_LocationType">
						<xs:annotation>
							<xs:documentation>Indicates information specifying the location of the DMPI.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeaponeeringStoreType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:StoreType">
				<xs:sequence>
					<xs:element name="StoreQuantity" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>Number of stores required to achieve desired effect. Computed for a specific weapon type and target type.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeaponeeringTargetInfoType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TargetHardness" type="uci:TargetHardnessEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element specifies whether the target requires a weapon type that has a penetrating warhead.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetClass" type="xs:unsignedByte" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Target class specified by an external source or indicated in the program related documentation.  This information is typically used to support refinement of the target impact point, improve lethality for a range of target types, and to optimize fuze settings.  A common range is [0,63].</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeaponeeringTargetType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:WeaponeeringType">
				<xs:sequence>
					<xs:element name="Target" type="uci:GeoLocatedObjectType">
						<xs:annotation>
							<xs:documentation>Indicates information specifying target.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeaponeeringType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreInformation" type="uci:WeaponeeringStoreType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates Store Type and Quantity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetInformation" type="uci:WeaponeeringTargetInfoType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates weaponeering information related to the target type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApproachConditions" type="uci:ApproachConditionsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired approach conditions as the weapon approaches the target.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ImpactConditions" type="uci:ImpactConditionsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the desired impact conditions including weapon impact angle and velocity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeaponEffectIndicatorsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the effect on stored weapons caused by the impact.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PayloadDeployed" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present, indicates the state of munition payloads at impact.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Detonated" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If present, indicates whether or not munition detonation occurred.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeaponRestrictionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="WeaponsAllowed" type="uci:StoreType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Only weapons of this type may be used against a target type and or within a zone.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeaponsNotAllowed" type="uci:StoreType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Weapons of this type are restricted against a target type and or within a zone.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="WeaponStoreType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Quantity" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Number of estimated weapons of this type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>This element represents the MIL-STD-6016-specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeaponTargetPairingChoiceType" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="DMPI_DesignationID" type="uci:DMPI_DesignationID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a weapon-target pair or pairs given in a DMPI_Designation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_PatternID" type="uci:DMPI_PatternID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a weapon-target pair or pairs given in a DMPI_Pattern.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a weapon-target pair given in a DMPI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weaponeering" type="uci:WeaponeeringLocationType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a weapon-target pair expressed directly, independent of DMPIs.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="WeatherAreaDataType" uci:version="001.001.001.003">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Source" type="uci:WeatherSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the weather information.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StationCode" type="uci:VisibleString32Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the Station reporting this weather data point (i.e. ground station or air vehicle).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Temperature" type="uci:TemperatureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates air temperature.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrecipitationPotential" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the percent chance of precipitation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrecipitationAmount" type="uci:PrecipitationAmountType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the amount of precipitation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypeOfPrecipitation" type="uci:WeatherPrecipitationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of precipitation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrecipitationAmplification" type="uci:WeatherPrecipitationAmplificationEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an additional refinement of the type or rate of precipitation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Visibility" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates unaided visual sighting distance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VisibilityStatus" type="uci:WeatherVisibilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the general airfield weather description according to MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DewPoint" type="uci:TemperatureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The dew point is the temperature to which a given parcel of humid air must be cooled, at constant barometric pressure, for water vapor to condense into liquid water.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Clouds" type="uci:CloudsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates existence and characteristics of clouds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WeatherEffects" type="uci:WeatherEffectsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the effects of weather on the surrounding environment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BarometricPressure" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the barometric pressure.  Units: Pascal (Pa).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="KollsmanSetting" type="xs:float" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the Kollsman setting to be used for indicated altitude.  Units: Inches of mercury (Hg).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Icing" type="uci:WeatherSeverityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that icing conditions are occurring or are expected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Turbulence" type="uci:WeatherSeverityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that air turbulence is occurring or is expected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThunderstormPotential" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the percent chance of a thunderstorm.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Remarks" type="uci:VisibleString1024Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents additional, human readable, comments on the weather.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Kind" type="uci:WeatherKindEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes the actual weather at a base or target position.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Description" type="uci:WeatherDescriptionEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to add additional details to actual weather.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qualifier" type="uci:WeatherSeverityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Used to add intensity details to actual weather.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WindData" type="uci:WindDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Information to characterize wind at a location.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativeHumidity" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the relative humidity as a percentage. Relative humidity is the ratio of the vapor pressure of water in air to saturation vapor pressure of water in air at a given temperature.  This value can be greater than 100%.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WeatherAugmentationParametersType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type extends AugmentationProcessingParametersType to provide augmentation parameters specific to weather.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:AugmentationProcessingParametersType">
				<xs:sequence>
					<xs:element name="ApplicableSystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of a System for which the weather-specific augmentation parameters are applicable.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="PeriodicInterval" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the periodic interval associated with the weather-specific augmentation parameters.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeatherDatasetID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to weather datasets.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="WeatherDatasetMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="WeatherDatasetID" type="uci:WeatherDatasetID_Type">
						<xs:annotation>
							<xs:documentation>The unique ID of the dataset.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Created" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>The date and time the Dataset was created, separate from any dates associated with the actual data creation or validity.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Updated" type="uci:DateTimeType">
						<xs:annotation>
							<xs:documentation>The date and time the Dataset was last updated.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DatasetArea" type="uci:ZoneType">
						<xs:annotation>
							<xs:documentation>This element defines the area that is being described by this dataset of weather data.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DegreeStep" type="uci:AnglePositiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>This element defines the latitude and longitude step value that was used to generate the WeatherData elements contained in this dataset. For example, the DatasetArea may define an area that goes from 35 latitude to 45 and -120 to -110 longitude with a step value of 1.0 degrees.</xs:documentation>
						</xs:annotation>
					</xs:element>
