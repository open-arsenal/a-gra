	<xs:complexType name="MA_StrikeActivityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ActivityBaseType">
				<xs:sequence>
					<xs:element name="SelectedForKeyLoad" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Key Load indicates the store has been put into a state where it is ready to receive cryptographic keys.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="WeaponArmed" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>When true, the weapon is in the armed state.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ReadyForRelease" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>The store has been prepared for launch such that when released the store will function properly.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SelectedForRelease" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>When Master Arm, Release Consent, and any LAR or vehicle Attitude parameters enforced by the carriage are all met, this store will be released.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SelectedForJettison" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Jettison indicates an ejection from the host system without powering or preparing the delivery vehicle. The store will be in an inert state. When Master Arm, Release Consent, and any LAR or vehicle attitude parameters enforced by the carriage are all met, this store will be jettisoned.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssignedTarget" type="uci:GeoLocatedObjectType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the Entity target assigned to the StrikeCapability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AO_Code" type="uci:AO_CodeType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the current/set AO/laser PRF and/or PIM code.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="LAR_ID" type="uci:LAR_ID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the ID of the associated LAR and/or LAR_Report associated with the Strike capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentRequired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Activity requires consent to transition from the ENABLED state to an ACTIVE state. This element is required and shall be TRUE for Activities associated with "mother may I" Capabilities.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ConsentState" type="uci:ConsentEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of consent for the Activity. This element is required for Activities which require Consent.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="KineticFootprint" type="uci:EnduranceFootprintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>The estimated footprint of where the store may fall if released from the current position.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetLockAcquired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicated whether (TRUE) or not (FALSE) a lock on target has been acquired.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MunitionActive" type="uci:MA_MunitionActiveType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Data regarding the munition while it is active or in flight.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TimeToRelease" type="uci:DurationType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Time interval before strike capability is released.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
