			<xs:documentation>The message data for the DMPI_CancelCommandStatus.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:CommandStatusBaseType">
				<xs:sequence>
					<xs:element name="StateReason" type="uci:CannotComplyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates details regarding the reason for and/or a contributing factor to the sibling State element.  This element is only expected when the Command is in a potentially undesirable state such as rejected, removed or accepted with less than optimum results expected.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SourceID" type="uci:SourceID_ChoiceType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of the Service/Subsystem/System which this status is from.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
