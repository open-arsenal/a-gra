			<xs:extension base="uci:CommandBaseType">
				<xs:sequence>
					<xs:element name="ApprovalPolicyID" type="uci:ApprovalPolicyID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the unique ID of an ApprovalPolicy to process in order to develop on-demand ApprovalRequests. If omitted, all ApprovalPolicies applicable to the sibling ApprovalItem should be processed.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ApprovalItem" type="uci:MA_ApprovalRequestItemReferenceType">
						<xs:annotation>
							<xs:documentation>Indicates the specific item that is being requested for on-demand approval management processing and ApprovalRequests.</xs:documentation>
