				</xs:annotation>
			</xs:element>
			<xs:element name="Unallocate" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that the specific dwell should be unallocated, which means temporarily remove it from the dwell strategy without deleting it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Delete" type="xs:boolean" minOccurs="0">
