				</xs:annotation>
			</xs:element>
			<xs:element name="TransitionDroppedToFailed" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This element specifies whether or not dropped Tasks that cannot be reallocated within the System will be automatically transitioned to the FAILED state for higher level interaction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanningInterface" type="uci:PlanningInterfaceType" minOccurs="0" maxOccurs="10">
				<xs:annotation>
					<xs:documentation>Indicates a currently enabled planning interface of the System. If multiple instances of this element are given, each should be of a different type of *Plan as enumerated by the child PlanType element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionPlanningAutonomy" type="uci:MA_MissionPlanningAutonomySettingType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates currently enabled autonomous mission planning capabilities of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanActivationAutonomy" type="uci:PlanActivationAutonomyType" minOccurs="0">
