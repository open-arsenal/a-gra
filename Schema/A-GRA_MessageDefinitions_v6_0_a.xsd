	<xs:complexType name="OpInteractingAssetType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes details on an asset interacting with an op type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Identification" type="uci:AssetType">
				<xs:annotation>
					<xs:documentation>Indicates the asset that is the subject of the notification.  For example a notification that an aircraft entered a No Fly zone would have the aircraft's corresponding UCI EntityID or SystemID as the Asset Subject.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Interaction" type="uci:OpInteractionEnum">
				<xs:annotation>
					<xs:documentation>Indicates the interaction between the Asset and the Op Subject.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScheduleActive" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Op Subject is applicable to the Asset at the time of the Interaction.  For example, an OpZone with a temporal schedule or selective applicability to Systems might not be applicable to a given System/Asset at the time of the Interaction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Violation" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Indicates whether (TRUE) or not (FALSE) the Interaction represents is a violation or otherwise unexpected.  For example, a System capturing a No Fly zone applicable to it would be considered a violation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TimeStamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time of the sibling Interaction.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
