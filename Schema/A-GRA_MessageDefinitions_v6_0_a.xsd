	<xs:complexType name="Link16EntityDataLinkNativeFilterType" uci:version="001.001.002.001">
		<xs:annotation>
			<xs:documentation>This is a polymorphic extension which allows for the extension of the base DataLinkNativeFilterPET for Link-16 Entity Ingress / Egress.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataLinkNativeFilterPET">
				<xs:sequence>
					<xs:element name="GatewayClass" type="uci:GatewayLink16ConfigurationClassEnum">
						<xs:annotation>
							<xs:documentation>Filter applicability based on data class.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SpecialProcessingIndicator" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Designates whether filter should apply only to items designated for special processing on Link 16. If SimulationIndicator is also set to true, then the filter will apply only to items marked with one or both indicators.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="SimulationIndicator" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Designates whether filter should apply only to items designated as simulated on Link 16. If SpecialProcessingIndicator is also set to true, then the filter will apply only to items marked with one or both indicators.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TargetSorting12_6" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether the Entity should be either produced or listened to via a 12.6 Target Sorting Message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Track3X" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Indicates whether the Entity should be either produced or listened to via a 3.X Track Message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Link16NPG" type="uci:Link16_NPG_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The Link-16 Network Participation Groups for which this Entity should be produced on or listened for on.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="GeographicArea" type="uci:GatewayLink16ConfigurationAreaType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Filter applicability based on geographic area. If not specified, geographic location is not considered (effectively applying the filter globally).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Number" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Unique interface filter number for coordination with other Link 16 JUs.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Environment" type="uci:GatewayLink16ConfigurationEnvironmentType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Filter applicability based on data environment type. If not specified, or if all indicators are set to FALSE, environment is not considered (effectively applying the filter to all environments). Applies only to TRACK and EW_PRODUCT class filters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Identity" type="uci:GatewayLink16ConfigurationIdentityType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Filter applicability based on data identity type. If not specified, or if all indicators are set to FALSE, identity is not considered (effectively applying the filter to all identities). Applies only to TRACK and EW_PRODUCT class filters.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="EntityIdentification" type="uci:EntityAssignmentType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element provides a mapping between an EntityID to a Link-16 TrackIndex.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
