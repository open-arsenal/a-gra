				</xs:annotation>
			</xs:element>
			<xs:element name="Parameters" type="uci:OrbitalVCM_ParametersType">
				<xs:annotation>
					<xs:documentation>Indicates the parameters for requesting an orbital VCM.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VCM" type="uci:OrbitalVCM_Type">
				<xs:annotation>
					<xs:documentation>Indicates the vector and covariance data of the VCM.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityPositionType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FixedPositionType" type="uci:FixedPositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The actual position measurement of this entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePosition" type="uci:RelativePositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Relative position is reported with respect to a point of reference. The relative point may be defined in several different ways. If the optional LOS field is not provided, then the ReferencePoint option of the PointChoice must be chosen. The position is then reported as an X,Y,Z offset to the origin of the reference frame associated with the ReferenceFrameID referenced by the RelativePoint field. If the optional LOS field is included, then the relative position is reported as a LOS from the sibling ReferencePoint. The LOS can be defined by either a Line of Bearing or a 3D pointing vector.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Zone" type="uci:ZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This is intended to represent an entity with large boundaries, such as a power plant.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityPropagationMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ExtrapolationTime" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time to which the Entities in the sibling ExtrapolatedEntity element have been extrapolated to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExtrapolatedEntity" type="uci:ExtrapolatedEntityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Entity and its extrapolated kinematics.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityPropagationMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:EntityPropagationMDT">
						<xs:annotation>
							<xs:documentation>Defines the characteristics of this Entity.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EntityRemoveInfoType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RemoveReason" type="uci:EntityRemoveReasonEnum">
				<xs:annotation>
					<xs:documentation>See enumeration annotations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MergedToID" type="uci:EntityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Entity which this Entity was fused to.  Required when the sibling RemoveReason element indicates FUSED.  For example, say Entity 1 is a fusion input from System A, Entity 2 is a fusion input from System B and initially fusion outputs Entity 3 (corresponding to Entity 1) and Entity 4 (corresponding to Entity 2).  Later, fusion determines that Entity 1 and Entity 2 refer to the same physical system and fuses them into an updated Entity 3.  Entity 4 is then REMOVED with RemoveReason of FUSED and MergedToID (this element) indicating Entity 3.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntitySignalSummaryType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SignalDescription" type="uci:SignalSummaryType">
				<xs:annotation>
					<xs:documentation>Indicates a summary description of a Signal from the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LatestDetectionTimestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the Signal was last detected.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SignalID" type="uci:SignalID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Signal summarized by the sibling SignalDescription element.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntitySourceIdentifierType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="EOB_RecordID" type="uci:EOB_RecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates an EOB record from which this Entity originated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExternalIdentifier" type="uci:EntityExternalType">
				<xs:annotation>
					<xs:documentation>Indicates the ID of an Entity-like object in an external system (non-UCI) which this Entity was derived from. For example, this element could indicate a MIL-STD-6016 track number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fusion" type="uci:EntityFusionSourceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is an output of a fusion service and provides references to a fusion input Entity that fused/contributed to it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InternallyDerivedID" type="uci:ID_Type">
				<xs:annotation>
					<xs:documentation>This element represents a non-Entity UCI object/message ID from which this Entity was derived.  Most elements of type ID_Type infer a specific ID type.  This element is different in that any UCI ID type is allowed. This will support moving target date from Tasks (possibly specified by ground forces) to Entities in order to designate DMPIs.  It will also support linkage to a generic event or ID.  Examples include; association of an entity with an operator location of interest. Locations are maintained independently between OLI and entity, indication that this entity was created as a result of completing a task, or a command which generated the entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Capability" type="uci:EntityCapabilitySourceType">
				<xs:annotation>
					<xs:documentation>Indicates this Entity is from a Capability source and provides the unique ID of the Capability instance along with the Capability's internal reference number/ID that corresponds to this Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Product from which the Entity was derived.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorID" type="uci:OperatorID_Type">
				<xs:annotation>
					<xs:documentation>UUID of the operator associated with this entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SOB_SatelliteRecordID" type="uci:SOB_SatelliteRecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the SOB satellite record from which this Entity was derived.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SOB_C2_RecordID" type="uci:SOB_C2_RecordID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the SOB C2 record from which this Entity was derived.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EntitySourceSpecificDataType" uci:version="001.002.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FusionEligibility" type="uci:EntityFusionEligibilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the eligibility of this Entity for automated fusion operations by the Entity's source System/Service and/or fusion tier.  FULL indicates that this Entity, and therefore its contributor Entity or Entities, is fully eligible for future automated fusion operations.  SELECTIVE_EXCLUSION indicates that the Entity is eligible for future automated fusion operations excluding merging with the Entity or Entities given in the sibling CorrelatedEntity element.  SELECTIVE_INCLUSION indicates that the Entity is eligible for future automated fusion operations but only with the Entity or Entities given in the sibling CorrelatedEntity element.  NONE indicates that this Entity is not eligible for future automated fusion operations regardless of the associated Entity.  This element does not restrict operator initiated fusion operations via the EntityManagementRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelatedEntityID" type="uci:CorrelatedEntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an Entity which is eligible for or excluded from future automated fusion operations with the Entity represented by this Entity message.  This element is required when the sibling FusionEligibility element indicates SELECTIVE_EXCLUSION or SELECTIVE_INCLUSION and should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DropRestriction" type="uci:DropRestrictionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the drop restriction on an Entity.  These restrictions can be applied by operator action or by other services due to dependencies on other messages.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmbiguousEntityID" type="uci:EntityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of an Entity that for at least a singular point in time was kinematically uncertain with this Entity.  An example of this is when two vehicles come to a common intersection, stop, and then depart together.  Tracking algorithms have to make a decision on which track goes with which target and are not guaranteed to make the correct decision unless there are outside sources (FBCB2, High Range Resolution Profiles, etc.) that allow the tracker to either confirm the decision, or determine that a swap is necessary at a later time.  At the time of the intersection, the uncertainties of the tracks make them kinematically ambiguous so that information should be carried on with the fused Entity.  If the tracker makes the correct decision, than the other Entity will not be a ContributorID, since it will have never contributed to the overall fused picture.  Likewise, the Identity of the fused Entity will not be modified since the other Entity never made a contribution.  If the tracker makes an incorrect decision than the other Entity will be a ContributorID and will possibly contribute to the Identity of the Fused Entity.  Regardless of the decision, the Ambiguous ID must be updated to reflect the ambiguous state that occurred.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackQuality" type="uci:Link16_TrackQualityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is the track quality as defined by MIL-STD-6016. This element represents the positional accuracy of the Entity, when the Entity came from a Link-16 source. It is the area, in square data miles, within which it is assessed that there is a 95% probability that the track/point lies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Priority" type="uci:ComparableRankingType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the source determined priority of the Entity.  For example an Entity from a Capability might have an MDF determined priority based on the Identity and/or Signal characteristics of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PassiveActiveIndicator" type="uci:PassiveActiveEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the type of sensor as either passive or active.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntitySourceType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>ID of the System that created the Entity.  Re-published Entities should retain the ID of the creating System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ID of the Service that created the Entity.  Re-published Entities should retain the ID of the creating Service.  Required when there are multiple Services within a System that are sources of Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceSpecificData" type="uci:EntitySourceSpecificDataType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates data that is relevant to the Entity but is related to the configuration, operator commands, etc. of the System/Service that is reporting the Entity as opposed to "measured" physical characteristics of the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceType" type="uci:EntitySourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the type, from an Entity reporting perspective, of System and/or Service which created the Entity.  See enumerated type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceTypeIdentifier" type="uci:EntitySourceIdentifierType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID which corresponds to or is associated with the sibling Entity SourceType element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorType" type="uci:Link16SensorTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicate sensor type detecting target.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EntityStalenessThresholdsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ObservedEntityThreshold" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the number of seconds since the last update of an Observed Entity before the data is considered to be stale.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrackedEntityThreshold" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the number of seconds since the last update of a Tracked Entity before the data is considered to be stale.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelatedEntityThreshold" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the number of seconds since the last update of a Correlated Entity before the data is considered to be stale.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApplicableZone" type="uci:ZoneType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If included, the sibling threshold or thresholds only applies while inside the specified zone.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Schedule" type="uci:ScheduleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If included, the sibling threshold or thresholds only applies during the specified schedule.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StalenessSpecificType" type="uci:StalenessDomainMobilityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>If included, the type of domain and mobility that this staleness pertains to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnvironmentIdentityConfidenceType" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Environment" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the environment or "domain" in which the Entity is operating. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitRegime" type="uci:OrbitRegimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the predominant orbital regime of the Entity, which is not always the current orbital regime. This element is a supplemental, more detailed description of the orbit when the environment is SPACE.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointTrack" type="uci:PointTrackEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if a Ground entity is a point or a track.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Confidence" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the confidence of the declaration of the Entity's environment.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnvironmentIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Environment" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the environment or "domain" in which the Entity is operating. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitRegime" type="uci:OrbitRegimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the predominant orbital regime of the Entity, which is not always the current orbital regime. This element is a supplemental, more detailed description of the orbit when the environment is SPACE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EOB_CodesType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EvaluationCode" type="uci:MIDB_EvaluationCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reliability or degree of confidence that has been assigned to the EOB Record (Site or Equipment). Integer between 1-10: 1 being highest confidence, 10 the lowest confidence that the associated data is valid. See classified standard for more detail. Based on the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3) Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FunctionCode" type="uci:EmitterFunctionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the principal operational function being performed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityCode" type="uci:EOB_ActivityCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the function or mission of an entity, which that entity may or may not be engaged in at the moment.  Typically refers to a unit, organization, or installation/facility performing a specific function or mission such as a redistribution center or naval shipyard.See classified standard for more detail. Based on the Global Command and Control System Integrated Imagery and Intelligence (GCCS-I3) Application Program Interface Reference Manual (APIRM) for MIDB Data Access Layer (MDAL).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CountryCode" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Code for the country in which the geographic coordinates reside.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EOB_CorrelatedToType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EOB_RecordID" type="uci:EOB_RecordID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the EOB Record which the inputs correlated to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:IdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the identity of the EOB Record which the inputs correlated to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EmitterID" type="uci:EOB_EmitterID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the emitter instance within the sibling EOB Record which the inputs correlated to.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EOB_CorrelationRecordID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to EOB correlation records.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EOB_CorrelationRecordMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:DataRecordBaseType">
				<xs:sequence>
					<xs:element name="CorrelationData" type="uci:EOB_CorrelationRecordType" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This represents results of previous attempts to correlate SignalReports, Entities or other inputs to the EOB.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EOB_CorrelationRecordMT" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="ObjectState" type="uci:ObjectStateEnum" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the internal software object that the data in the message is based upon.  The state of the software object is determined by the publisher.  The publisher could be the original/master publisher or an intermediary re-publisher such as a persistence/data manager.  This element is not a commanded CRUD operation.  It is not an indication of the state of an instance of a message.  It is not a mechanism for partial, incremental, or fragmentary publication of a message.  It is a signal from a publisher to subscribers.  For REMOVED state, in particular, some subscribers will mirror the publisher and treat the message as if the object no longer exists, but others, such as mission recorders, might not (in order to support retaining historical records of activity, for example).</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MessageData" type="uci:EOB_CorrelationRecordMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="EOB_CorrelationRecordType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>This represents results of previous attempts to correlate SignalReports, Entities or other inputs to the EOB.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SecurityInformation" type="uci:SecurityInformationType">
				<xs:annotation>
					<xs:documentation>Indicates the classification of the inputs to the EOB record, containing a variety of security information such as how the data is stored, protected, and destroyed. The security level of the message itself is indicated in the message header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB_CorrelationRecordID" type="uci:EOB_CorrelationRecordID_Type">
				<xs:annotation>
					<xs:documentation>The unique ID of the EOB Correlation Records.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelationType" type="uci:EOB_CorrelationTypeEnum">
				<xs:annotation>
					<xs:documentation>The correlation status/result of a previously processed SignalReport or Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelationTimestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Indicates the time at which the correlation occurred.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelatedTo" type="uci:EOB_CorrelatedToType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates what in the EOB record/database the sibling elements correlated to.  This element is required when the sibling CorrelationType indicates a complete "ELNOT and location" correlation and should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CorrelationInput" type="uci:OB_CorrelationInputType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the input that was correlated to the EOB with the results described in the sibling elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Signal" type="uci:EOB_SignalType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the signal characteristics that were correlated to the EOB.  These characteristics aren't necessarily a copy of the signal data from the sibling CorrelationInput; they can be a processed version of the CorrelationInput that reflects what was actually correlated to the EOB.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:IdentityConfidenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the identity characteristics that were correlated to the EOB.  These characteristics aren't necessarily a copy of the identity data from the sibling CorrelationInput; they can be a processed version of the CorrelationInput that reflects what was actually correlated to the EOB.  If processing resulted with ambiguity, multiple possible identities are given, each with a confidence level.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportedNotation2" type="uci:NotationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the notation of the signal prior to being refined/determined by the correlation process. The final notation is in the notation in the Identity. If this is populated then the original notation is defined in ReportedNotation1.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReportedNotation1" type="uci:NotationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the notation of the signal prior to being refined/determined by the correlation process. The final notation is in the notation in the Identity. If this is populated then this is the notation is defined Signal Report or entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Position" type="uci:FixedPositionType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the position that was correlated to the EOB.  The position isn't necessarily a copy of the position from the sibling CorrelationInput; it can be a processed version of the CorrelationInput that reflects what was actually correlated to the EOB.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformKinematics" type="uci:KinematicsFixedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the position of the platform which detected the sibling CorrelationInput that was correlated to the EOB.  The position isn't necessarily a copy of the position from the sibling CorrelationInput; it can be a processed version of the CorrelationInput that reflects what was actually used to correlate to the EOB.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EOB_EmitterID_Type" uci:version="000.000.000.000">
