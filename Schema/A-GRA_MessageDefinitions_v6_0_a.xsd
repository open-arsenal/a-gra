				</xs:annotation>
			</xs:element>
			<xs:element name="Location" type="uci:Point2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the location at which the observation indicated by the sibling ObservationType was made.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamageProbabilityZoneType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MinimumDamageProbability" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the lowest damage probability for the grouping of objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumDamageProbability" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Indicates the highest damage probability for the grouping of objects.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DamageZone" type="uci:ZoneType">
				<xs:annotation>
					<xs:documentation>Indicates the geo-spatial zone over which the sibling probability range applies.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_ID" type="uci:DMPI_ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific DMPI associated with the probability zone.  When given, this element is a secondary key; for a collection of objects, the damage probabilities for each DMPI of the Task can be given.  In that case, a min/max probability would be repeated for each DMPI and this element would distinguish them.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamageReportDetailType" uci:version="002.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
