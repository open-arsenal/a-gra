					<xs:documentation>Earliest PathSegment within the RoutePlan where the Route can be intercepted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LatestInterceptPoint" type="uci:ActivationPathSegmentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Latest PathSegment within the RoutePlan where the Route can be intercepted.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RoutePlanInterceptStatusType" uci:version="000.000.000.000">
