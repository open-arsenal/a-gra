		</xs:annotation>
		<xs:sequence>
			<xs:element name="Applicability" type="uci:PlanApplicabilityType">
				<xs:annotation>
					<xs:documentation>Indicates the System or Systems which the Plan is applicable to.  See annotations for the underlying type and its child elements for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AssociatedOrbitPlanID" type="uci:OrbitPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the OrbitPlan the Activities in the OrbitActivityPlan reference.  An OrbitActivityPlan can only reference a single OrbitPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Window" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The time window when the Plan applies; the time window within which all the Activities of the Plan would occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Parts" type="uci:ActivityPlanPartsType">
				<xs:annotation>
					<xs:documentation>Indicates which part or parts are included in the Plan.  For a *ActivityPlan the parts are the kinds of Activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlannedActivity" type="uci:OrbitActivityType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an Activity that is planned to occur on an OrbitPlan sequence or maneuver Segment and/or a time/location specified by the child *Trigger elements.  Multiple Activities occurring at different times along a segment can be specified with 1) an EndPoint for each Activity to accurately describe where they will occur or 2) the Trigger elements to arrange the Activities along a single Sequence/ManeuverSegment with a single EndPoint.  The latter approach is required for simultaneous Activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitActivityPlanValidationCommandMDT" uci:version="003.001.003.001">
