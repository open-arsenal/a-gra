		<xs:complexContent>
			<xs:extension base="uci:CapabilityDeclarationBaseType">
				<xs:sequence>
					<xs:element name="AcceptedInterface" type="uci:CapabilityControlInterfacesEnum" maxOccurs="7">
						<xs:annotation>
							<xs:documentation>Indicates an accepted control interface for the Capability.  See enumeration annotations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CommsRequired" type="xs:boolean" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates whether (TRUE) or not (FALSE) communications are required to use the Capability.  Omitted is equivalent to FALSE.  For example, an unmanned system with no onboard storage would require communications to disseminate the outputs of the Capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CommandBaseType" abstract="true" uci:version="001.000.001.000">
