					<xs:element name="RequirementType" type="uci:RequirementTaxonomyType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates which Requirement type or types of the sibling RequirementPlans to include in the metrics analysis.  If omitted, metrics for all Requirement types are requested.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
