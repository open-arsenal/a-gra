				</xs:annotation>
			</xs:element>
			<xs:element name="AutoGeneratorSettings" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This field indicates whether auto control of the product generator's settings is enabled (TRUE) or not (FALSE).</xs:documentation>
				</xs:annotation>
			</xs:element>
