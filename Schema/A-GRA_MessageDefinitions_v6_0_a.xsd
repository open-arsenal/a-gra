		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MinAirspeed" type="uci:MA_AirspeedLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Minimum allowable airspeed given as a function of altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxAirspeed" type="uci:MA_AirspeedLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Maximum allowable airspeed given as a function of altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BestEnduranceAirspeed" type="uci:MA_AirspeedLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Airspeed of maximum endurance given as a function of altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BestRangeAirspeed" type="uci:MA_AirspeedLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Airspeed of maximum range given as a function of altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinAltitude" type="uci:AltitudeReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum allowable altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxAltitude" type="uci:AltitudeReferenceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum allowable altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinAccelerationLimits" type="uci:MA_AccelerationLimitsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The vehicle's acceleration limits in the current operating domain of the system as a function of time. Flight control modes such as HSA and Waypoint Following should only use the first time index, while Curve Following may utilize an unbounded number of time indices to form dynamically feasible trajectories.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExcessPowerOrAcceleration" type="uci:MA_ExcessPowerOrAccelerationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides either specific excess power or paired acceleration and climb rate data for the platform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxOrientationLimits" type="uci:MA_OrientationLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the maximum orientation of the vehicle in the order yaw, pitch, roll as a function of airspeed, altitude, and weight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxOrientationRateLimits" type="uci:MA_OrientationRateLimitsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the rate of orientation change of the vehicle in the order yaw, pitch, roll. The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle. Flight control modes such as HSA and Waypoint Following should only use the first time index, while Curve Following may utilize an unbounded number of time indices to form dynamically feasible trajectories.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxTurnRate" type="uci:AngleRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum allowable turn rate in radians/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxDescentRate" type="uci:MA_SpeedType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Maximum allowable descent rate as a function of airspeed, altitude, and weight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxDeceleration" type="uci:MA_AccelerationLimitsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Maximum allowable deceleration limits as a function of airspeed, altitude, and weight.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FuelBurnRate" type="uci:MA_FuelBurnRateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Fuel burn rate as a function of airspeed, altitude, and weight.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
