				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the ID of an associated actual/executing/executed Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MA_RequirementStatusType" uci:version="000.000.000.000">
		<xs:annotation>
