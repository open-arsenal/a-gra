	<xs:complexType name="ComponentControllabilityA_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnableDisable" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Component or related item can be dynamically enabled and disabled.  Omission of this element indicates the Component or related item does not have dynamic enable and disable control.  See annotation enumerations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Configurable" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Component or related item can be dynamically configured.  Omission of this element indicates the Component or related item is not dynamically configurable.  See annotation enumerations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Component or related item can be dynamically reset to it default/factory configuration.  Omission of this element indicates the Component or related item cannot be dynamically reset.  See annotation enumerations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentControllabilityB_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnableDisable" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Component or related item can be dynamically enabled and disabled.  Omission of this element indicates the Component or related item does not have dynamic enable and disable control.  See annotation enumerations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:ComponentControlInterfacesEnum" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation>Indicates whether and how the Component or related item can be dynamically reset to it default/factory configuration.  Omission of this element indicates the Component or related item cannot be dynamically reset.  See annotation enumerations for further details. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentControlsA_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnableDisable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the Component and/or associated item.  Setting to false will disable.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoEnableDisable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable the automatic enabling/disabling of the Component and/or associated item. Setting this field to false will disable it.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to reset to factory/default configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentControlsB_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Auto" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Setting this field to true will enable automatic control of the Component and/or associated item.  Setting to false will disable automatic control.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reset" type="uci:EmptyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a command to reset to factory/default configuration.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentControlsStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EnableDisable" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>This field indicates whether the Component or associated item is enabled (true) or disabled (false).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AutoEnableDisable" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This field indicates whether the Component or associated item is being enabled/disabled automatically (true) or not (false) by the Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentDetailedStatusInfoType" uci:version="000.000.001.001">
		<xs:annotation>
			<xs:documentation>Provides a generic way to report the status information of an attribute that is not defined by other types or structures.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:NameValuePairType">
				<xs:sequence>
					<xs:element name="Description" type="uci:VisibleString256Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Description of a status attribute.  Likely used in an HMI to provide more details on the status attribute.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ComponentDetailedInfoState" type="uci:ComponentElementStateType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates the state of the detailed component information.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ComponentDetailedStatusType" uci:version="000.001.001.001">
		<xs:annotation>
			<xs:documentation>Indicates component specific/unique status information.  Similar to SubsystemStatusDetailed that supports reporting vendor specific data.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentElement_ID" type="uci:ComponentElementID_Type">
				<xs:annotation>
					<xs:documentation>The UUID of a part within a component that typically does not use UCI but needs to be identified via a UUID by a component.  Systems with redundant components and Subsystems can require use of UUIDs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentElementIdentifier" type="uci:ComponentElementIdentifierChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates an externally defined identifier for a type of component element that is specific to a system, subsystem, component, or service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentElementDescription" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates descriptive information about the component element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentElementState" type="uci:ComponentElementStateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the state of the component element.  This could be a roll up of component element states in sibling ComponentDetailedStatusInfoType.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentDetailedStatusInfo" type="uci:ComponentDetailedStatusInfoType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This contains detailed status of a component element.  This field can be used to provide status for component elements such as electrical systems, hydraulic systems, etc.  For example an electrical system may have a generator, AC or DC components that need to have a status reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentElementID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID of an element or sub-component within a component.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ComponentElementIdentifierChoiceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates an externally defined identifier for a type of component element that is specific to a system, subsystem, component, or service.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="ComponentElementNumericIdentifier" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates an externally defined numeric identifier for a type of component element that is specific to a system, subsystem, component, or service.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ComponentElementKey" type="uci:ForeignKeyType">
				<xs:annotation>
					<xs:documentation>Indicates an externally defined text identifier for a type of component element that is specific to a system, subsystem, component, or service.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ComponentElementStateType" uci:version="000.000.001.000">
		<xs:annotation>
			<xs:documentation>State data for an element within a component.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="State" type="uci:ComponentElementStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the state of an element within a component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StateDescription" type="uci:VisibleString64Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates descriptive information of the state.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ComponentExtendedStatusPET" abstract="true" uci:version="000.000.000.000">
