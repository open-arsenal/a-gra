		<xs:sequence>
			<xs:element name="SegmentRelativeHeading" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>The angle measured clockwise between True North to the vector projected from the Previous segment's endpoint to the current segment's endpoint measured in radians. This value must be recomputed when the platform captures the current endpoint and enters a new segment or if the platform transitions to a new route or path on the active route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SegmentRelativeVelocity" type="uci:SegmentRelativeVelocity2D_Type">
				<xs:annotation>
					<xs:documentation>The velocity relative to the vector projected from the Previous segment's endpoint to the Current segment's endpoint measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SegmentMetricsType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PathSegmentID" type="uci:SegmentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID for this PathSegment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Metrics" type="uci:MetricsType">
				<xs:annotation>
					<xs:documentation>Indicates summary metrics for the PathSegment referenced by the sibling PathSegmentID.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SegmentRangeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Specify a contiguous range of segments with a path.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BeginSegmentID" type="uci:SegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specify a segment within a path  at which the segment range begins. If not specified, the range begins at the first segment in the Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndSegmentID" type="uci:SegmentID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specify a segment within a path  at which the segment range ends. If not specified, the range ends at the last segment in the Path.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SegmentRelativeVelocity2D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AlongSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component with the positive value in the direction of the vector projected from the Previous segment's endpoint to the Current segment's endpoint. Measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AcrossSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component with the positive value in the direction of the vector orthogonal by 90 degrees clockwise from the AlongSpeed vector (i.e., projected from the Previous segment's endpoint to the Current segment's endpoint). Measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Inertial vertical speed component pointing down measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct.  The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SelectAntennaType" uci:version="002.001.001.001">
		<xs:annotation>
			<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the EA activity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Shared Antenna.  Shared Antennas are not taxonomically described in UCI.  It is left to external actors to organize, uniquely describe and identify them. AntennaID may only be blank if the "AntennaResourceTypeIndex" is present in the AntennaResourceChoice sibling. For example, a "Transmit Half Sub Array" may be required for the EA activity without identifying which AESA must be selected. AntennaID is the same as the Antenna SupportCapabilityID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaResourceChoice" type="uci:AntennaResourceChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Select a specific antenna resource (i.e. antenna resource instance) or a category of antenna resources (i.e. antenna resource type).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SelectDigitalComponentResourceType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>Used to select digital array (multi-function aperture) and digital payload (multi-function processor) resources.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MFA_Address" type="uci:MFA_AddressType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the Digital MFA and desired resource type within the MFA.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MFP_Address" type="uci:MFP_AddressType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>For a "digital back end," the MFP_Address defines the processing, data path, and network port information used by the Activity requesting resource access. The service allocating resources considers the other MFP_Addresses in use at the same time and manages not only aperture resources but also back end and network resources, considering also the overall throughput in use, defined by the sibling BeamBandWidthAndDataRate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BeamBandWidthAndSampleRate" type="uci:BeamBandWidthAndSampleRateType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>If present, the number of instances identifies how many beams will be set up simultaneously on the single allocated AntennaResourceInstance (or Type). The BeamBandWidth provides the maximum Instantaneous Band Width of the beam, and the SampleDataRate controls the max data rate the Digital Payload plans to accept in the aperture access times it is allocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkDataRate" type="uci:NetworkDataRateRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>For the sum of  beams requested/allocated on the MFA, the maximum (and optionally, minimum) data rate in Mbps the DigitalPayload can accept (in the allocation request) and the MFA will generate (in the allocation response).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SelectionQuerySpecificDataType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identify what kind of data is requested as part of the data update request.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:QuerySpecificDataPET">
				<xs:sequence>
					<xs:element name="Category" type="uci:DataUpdateRequestCategoryEnum">
						<xs:annotation>
							<xs:documentation>Request republishing all data of a specific category.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SelectPayloadResourceType" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>Used to identify the RF payload resource which is the subject of an RF_ResourceAllocationRequest.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PayloadResourceTypeIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Payload Resource the requesting subsystem would like to use. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PayloadResourceInstanceIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Payload Resource the requesting subsystem would like to use. Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SelectRF_ComponentResourceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Used to select RF array and payload resources.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AntennaResourceAndBeamConfigurations" type="uci:AntennaResourceAndBeamConfigurationsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Used only for RF apertures (accessed via a switched RF network). Indicates the unique ID of a Shared Antenna.  Shared Antennas are not taxonomically described in UCI.  It is left to external actors to organize, uniquely describe and identify them.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectPayloadResource" type="uci:SelectPayloadResourceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Only used for "RF back ends" (accessing apertures through a switched RF distribution matrix) as opposed to "digital back ends" (accessing apertures via digital data/control bus). Payloads can request resource type or a resource instance. Multiples are allowed, such as four payload channels for a four quadrant operation (though payload channels may be grouped into a single long baseline interferometer resource. A higher number of resources is supported, for growth cases.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SelfDefenseStatusMDT" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>Component of the vehicle to defend against attack.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SupportCapabilityStatusBaseType">
				<xs:sequence>
					<xs:element name="Chaff" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>This element indicates a chaff capability and the quantity of remaining chaff.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Flare" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>This element indicates a flare capability and the quantity of remaining flares.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Decoy" type="xs:unsignedInt">
						<xs:annotation>
							<xs:documentation>This element indicates a decoy capability and the quantity of remaining decoys.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DirectedEnergy" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>This element indicates a directed energy self defense capability.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SelfDefenseStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SelfDefenseStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SensorCharacterizationChoiceType" uci:version="002.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates collection requirements for each sensor characterization choice.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="PhemonemologySpecific" type="uci:CharacterizationChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates phenomenology specific collection requirements for a sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StabilityAndOrientationAssessment" type="uci:StabilityCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a stability orientation assessment sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StructureAssessment" type="uci:StructureAssessmentCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform a structure change detection sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IdentificationVerification" type="uci:IdentificationVerificationCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform an identification verification sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperationsChanges" type="uci:SatelliteOperationsChangesCharacterizationType">
				<xs:annotation>
					<xs:documentation>Indicates collection requirements to perform an operations changes sensor task.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SensorConstraintsBaseType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SensorType" type="uci:SensorTypeEnum" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a type of sensor. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOIR_Spectrum" type="uci:SensorSpectrumEnum" minOccurs="0" maxOccurs="14">
				<xs:annotation>
					<xs:documentation>Indicates an EOIR spectrum of a sensor. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Spectrum" type="uci:IEEE_FrequencyBandEnum" minOccurs="0" maxOccurs="12">
				<xs:annotation>
					<xs:documentation>Indicates the radio frequency of a sensor. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorCategory" type="uci:SensorCategoryEnum" minOccurs="0" maxOccurs="10">
				<xs:annotation>
					<xs:documentation>Indicates a logical grouping of sensors with certain owner/operator or sensor characteristics. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorSystemIdentity" type="xs:unsignedShort" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The unique identifier for the sensor system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorBasing" type="uci:EntityBasingEnum" minOccurs="0" maxOccurs="11">
				<xs:annotation>
					<xs:documentation>Indicates the geographic/orbital domain of operations of a sensor system. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OwnerOperatorCountry" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>DoD standard country code designator to which a sensor owes its allegiance.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorConstraintsType" uci:version="002.002.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:SensorConstraintsBaseType">
				<xs:sequence>
					<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Indicates the SystemID of a sensor system.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SensorCountConstraintType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Min" type="xs:int">
				<xs:annotation>
					<xs:documentation>Minimum number of sensors to be used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Max" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum number of sensors to be used. Unlimited if not present.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorFieldOfRegardType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Extents" type="uci:FieldOfRegardExtentsType">
				<xs:annotation>
					<xs:documentation>Indicates the azimuth and elevation extents of the field of regard.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Volume" type="uci:GeometricVolumeType">
				<xs:annotation>
					<xs:documentation>Specified a geometric volume that defines the sensor field of regard.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GeoLongitude" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>Indicates a longitude range corresponding to geocentric/geostationary orbits.

The Min value reflects the Western most extent and the Max value represents the Eastern most extent. As such, the Min value may be a greater number than the Max value.

Pay special attention to the values when the field crosses the Prime Meridian (0) and the 180th Meridian (-pi/pi).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SensorFieldOfViewType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Width" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>The width (x-component) of the sensor field of view, relative to the boresight of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Height" type="uci:AnglePositiveType">
				<xs:annotation>
					<xs:documentation>The height (y-component) of the sensor field of view, relative to the boresight of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorFunctionalityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the high level functional and processing capabilities of a sensor and related unit.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Collections" type="uci:SensorFunctionalCollectionsEnum">
				<xs:annotation>
					<xs:documentation>Indicates the high level functional collection capabilities of a sensor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Processing" type="uci:SensorFunctionalProcessingEnum">
				<xs:annotation>
					<xs:documentation>Indicates the high level processing capabilities of a sensor and associated unit.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorKinematicsChoiceType" uci:version="002.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Kinematics" type="uci:SignalNavDataType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the sensor system (or geographically disperse component of a sensor system) in LLA coordinates.   Each sibling element represents the kinematics at a different time which would be used to correlate to the timestamps of the measurements. If a sensor is stationary, only one element would need to be populated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitalKinematics" type="uci:SensorKinematicsOrbitalType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the sensor system (or geographically disperse component of a sensor system) in space-based coordinates. Each sibling element represents the kinematics at a different time that would be used to correlate to the timestamps of the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ECEF_Kinematics" type="uci:ECEF_SensorKinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates the kinematics of the sensor system (or geographically disperse component of a sensor system) in ECEF coordinates. Each sibling element represents the kinematics at a different time that would be used to correlate to the timestamps of the measurements.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SensorKinematicsOrbitalType" uci:version="002.000.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>Date/Time stamp of the sibling data elements.  Date/Time stamps on individual elements of the sibling data take precedence over this element when they are given.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorKinematics" type="uci:OrbitalKinematicsFrameChoiceType">
				<xs:annotation>
					<xs:documentation>The kinematics of a space-based sensor platform.  If the sibling SensorRelativeAttitude element is populated, then the child Attitude element describes the host platform, rather than the sensor itself.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorRelativeAttitude" type="uci:QuaternionAttitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the attitude of the sensor relative to its platform.  Only populated if the relative attitude between the sensor and its host platform is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorKinematicsType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComponentID" type="uci:ComponentID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the ID of the sensor/antenna component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the sensor/antenna in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle. For signal reports, must have sufficient accuracy to show changes from pulse to pulse.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationSigma" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the error of the orientation of the sensor/antenna in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system, relative to the angle of sensor/antenna orientation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorBoresightVelocity" type="uci:BoresightVelocityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Linear velocity vector indicating the motion of the sensor/antenna face based on the sensor/antenna local body coordinate fame.  This field indicates the movement of the sensor/antenna face at nanosecond resolution to ensure high accuracy of the measurement.  Sensor/antenna face movement may be based on effects such as sensor/antenna scanning, sensor/antenna installation location flexing compared to the vehicle body center, vehicle crabbing maneuvers, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SensorBoresightCovariance" type="uci:VelocityVelocityCovarianceCartesianType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the sensor/antenna boresight 1-sigma velocity-velocity covariance in the sensor/antenna local body coordinate system.  Velocity covariance is symmetric and therefore the covariance values expressed here are the minimum set.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SensorPointListType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>This is a set of points or directions desired for a sensor collection. The sensor coordinates are the origin. This can be used to specify a sensor search pattern.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AzimuthElevationRangePointList" type="uci:AzimuthElevationRangePointType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of azimuth angle, elevation angle and (if desired) range distance pairs/triplets desired for a sensor collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RightAscensionDeclinationPointList" type="uci:RightAscensionDeclinationPointType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of right ascension angle and declination angle pairs desired for a sensor collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Point3DList" type="uci:Point3D_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A list of latitudes, longitudes, altitudes, and optional times desired for a sensor collection.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SensorReferencedCoverageAreaType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Definition of a Sensor Reference Coverage Area (SRCA). Allows a Subsystem to include a sensor relative target definition used for air to ground collections.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Reference" type="uci:SensorReferencedCoverageAreaReferenceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the reference for pointing for a SensorReferencedCoverageArea Target.  The enumeration values are PLATFORM or SENSOR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AzimuthExtent" type="uci:AnglePairType">
				<xs:annotation>
					<xs:documentation>Azimuth extent of the look area.

When the sibling Reference is PLATFORM, pointing is relative to the body of the aircraft in an east north up coordinate system.  Zero azimuth and elevation will point out the nose of the platform. Azimuth increases counterclockwise as a rotation about the up vector.

When the sibling Reference is SENSOR, pointing is relative to the boresight of the sensor in an east north up coordinate system with north pointing in the direction of boresight.  Zero azimuth and elevation will point in the direction of boresight. Azimuth increases counterclockwise as a rotation about the up vector.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RangeElevationExtent" type="uci:RangeElevationExtentChoiceType">
				<xs:annotation>
					<xs:documentation>Indicates the range or elevation extent of the look area

When the sibling Reference is PLATFORM, pointing is relative to the body of the aircraft in an east north up coordinate system.  Zero azimuth and elevation will point out the nose of the platform.  Elevation is positive up as a rotation about the rotated east vector.

When the sibling Reference is SENSOR, pointing is relative to the boresight of the sensor in an east north up coordinate system with north pointing in the direction of boresight.  Zero azimuth and elevation will point in the direction of boresight.  Elevation is positive up as a rotation about the rotated east vector.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SeparationParametersType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AltitudeDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Defines the distance along a vertical plane perpendicular to the earth to consider when deconflicting routes. The distance is applied both above and below the route.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HorizontalDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Defines the distance along a horizontal plane parallel to the earth to consider when deconflicting routes. The distance is applied in both right and left directions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForwardDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Defines the distance to project the vehicle forward along its route when deconflicting routes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TrailingDistance" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Defines the distance to project the vehicle backward down its route when deconflicting routes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
