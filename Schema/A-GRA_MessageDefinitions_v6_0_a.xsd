			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ResendDataRequestMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ResendDataRequestStatusMDT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:RequestStatusBaseType">
				<xs:sequence>
					<xs:element name="RequestingServiceID" type="uci:ServiceID_Type">
						<xs:annotation>
							<xs:documentation>Indicates a unique ID assigned to the requesting service.  This should match the original ID from the ResendRequest message that this response is for.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="DestinationServiceID" type="uci:ServiceID_Type" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Optional destination Service ID used for messaging forwarding through a guard.  The guard will use this ID to mask the real destination of the service providing the response to the ResendRequest message.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Message" type="uci:MessageType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>This element contains the message or messages (derived from MessageType) that matched the corresponding ResendRequest.  If omitted, no matching messages were found.  This is a polymorphic extension point; any UCI message (which by definition is derived from MessageType) can be included here.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ResendDataRequestStatusMT" uci:version="002.000.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:ResendDataRequestStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ResolvedCharacterizationAspectCoverageType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies the desired aspects of the spacecraft to be characterized.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="BodyReference" type="uci:BodyReferenceEnum" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>See Base Description. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Attitude" type="uci:QuaternionType">
				<xs:annotation>
					<xs:documentation>Specifies set of spacecraft aspects to be covered in body coordinates.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AspectSpan" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Specifies span of attitude angles over which structural characterization data is required.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ResolvedCharacterizationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates collection requirements to perform resolved characterization in support a structure change detection sensor task.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Resolution" type="uci:DistanceResolutionSpecificationType">
				<xs:annotation>
					<xs:documentation>Desired physical resolution of structure.  Dimensions will depend on phenomenology.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinWindow" type="uci:DistanceResolutionSpecificationType">
				<xs:annotation>
					<xs:documentation>The minimum physical volume (or collapsed volume to one or two dimensions) that must be covered as part of collection.  This is needed in addition to minimum target size to ensure appropriate coverage of targets long in one dimension or in situations such as deployments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AspectCoverage" type="uci:ResolvedCharacterizationAspectCoverageType">
				<xs:annotation>
					<xs:documentation>Specifies the desired aspects of the spacecraft to be characterized.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocationPeriodDigitalType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessPeriodIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>May only be 1 or 2, tied to the AccessPeriodIndex of the RF_ResourceAllocationRequest. Generated at run time by the payload to define access patterns (period 1, period 2, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessLimit" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Max Percentage of time the Resource can be used in conjunction with the allocation, during the period, during TypicalAccessPeriodDuration described in the RF_ResourceAllocationRequest.  Subsystems (e.g. EA, ESM) will "throttle" their resource access using the MaxAccessDuration and PercentAccessLimit given by the Resource Manager to calculate a revisit rate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodPercentAccessExpected" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The EWRM may advise the payload as to the expected percent access which will be granted in the presence of other on-going allocations to other activities. The payload may use this prediction in order to decide to request alternate resources. This prediction applies to the sibling AccessPeriodIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodMaxAccessDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum contiguous time the resource can be accessed for the sibling AccessPeriodIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocationPeriodRF_Type" uci:version="001.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessPeriodIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>May only be 1 or 2, tied to the AccessPeriodIndex of the RF_ResourceAllocationRequest. Generated at run time by the payload to define access patterns (period 1, period 2, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessLimit" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Max Percentage of time the Resource can be used in conjunction with the allocation, during the period, during TypicalAccessPeriodDuration described in the RF_ResourceAllocationRequest.  Subsystems (e.g. EA, ESM) will "throttle" their resource access using the MaxAccessDuration and PercentAccessLimit given by the Resource Manager to calculate a revisit rate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccessPeriodRF_Mode" type="uci:RF_TypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the resource will be used for Rx, Tx, or Both per Access Period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodPercentAccessExpected" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The EWRM may advise the payload as to the expected percent access which will be granted in the presence of other on-going allocations to other activities. The payload may use this prediction in order to decide to request alternate resources. This prediction applies to the sibling AccessPeriodIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodMaxAccessDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum contiguous time the resource can be accessed for the sibling AccessPeriodIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorAllocationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceAllocationIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>When more than one allocation exists, the scheduler may switch between allocations from one scheduled time to the next, using the ResourceAllocationIndex to identify which allocation is in use in the scheduled time period. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemThreadIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to the SystemThread roll up of payload, antenna, and network/RFD resources, as summarized in the SystemThreadInformationFile, part of the Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Mode" type="uci:RF_TypeEnum">
				<xs:annotation>
					<xs:documentation>The RF Mode of the allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAccessPriority" type="uci:UnsignedIntegerMinMaxType">
				<xs:annotation>
					<xs:documentation>Priority of the access, in case of conflict. Higher priority wins.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExpectedPercentAccess" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Predicted duty cycle expected to be available to the Activity, based on other existing requests.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceRequestID" type="uci:RequestID_Type">
				<xs:annotation>
					<xs:documentation>Reference to the payload's original RF_ResourceAllocationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_ThreadInstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifier of the RF_ThreadInstance associated with the resource allocation. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. RF_ThreadInstanceIndices may be re-used after an allocation has been deallocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DigitalThreadInstanceIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Reference to a combination of multi-function capability, antenna, and network resources, defined in the Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorCommandExtensionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Used to differentiate control from Mission Processing to Resource Manager vs. Resource Manager to Capability.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RequestedCapabilityID" type="uci:CapabilityID_Type">
				<xs:annotation>
					<xs:documentation>Capability that is the subject of the command, even when Resource Manager will receive the command and process/modify it prior to sending it to the Capability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAllocatorCommandControlType" type="uci:ResourceAllocatorCommandControlEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>See annotations in enum definition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorConstituentIdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Utilized to list Capabilities and SupportCapabilities managed by Resource Manager.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the ID of Capabilities (Digital Payloads or RF Subsystems) controlled by the Resource Allocator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the support capability IDs required by the Resource Allocator function (antenna, RFDC).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorSourceCrossReferenceType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MissionProcessingCommandID" type="uci:CommandID_Type">
				<xs:annotation>
					<xs:documentation>CapabilityCommand sent from Mission Processing and associated with the Resource request and allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAllocatorCommandID" type="uci:CommandID_Type">
				<xs:annotation>
					<xs:documentation>CapabilityCommand sent from Resource Manager and associated with the Resource request and allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorStatusType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>This type represents the status and settings for Resource Allocator that allocates and schedules MFA resources.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceAllocatorConstituentIdentifiers" type="uci:ResourceAllocatorConstituentIdentifierType">
				<xs:annotation>
					<xs:documentation>Capabilities (Digital and RF Payloads) and SupportCapabilities (antennas/MFAs and RFDC) managed by the Resource Allocator.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportedActivities" type="uci:ResourceAllocatorSupportedActivitiesType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the allocations to each supported Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAllocatorSystemThreadStatus" type="uci:ResourceAllocatorSystemThreadStatusType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>SystemThread status and loading for SystemThreads under the cognizance of the SupportingCapabilityID (the RA or MFA allocator).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorSupportedActivitiesType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SupportedActivityID" type="uci:ActivityID_Type">
				<xs:annotation>
					<xs:documentation>ID of an Activity in the schedule.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SourceCrossReference" type="uci:ResourceAllocatorSourceCrossReferenceType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Provides command ID mapping to the resource request and allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Allocations" type="uci:ResourceAllocatorAllocationType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Identifies the allocation associated with the Activity, and may expand upon the RF_ResourceAllocation, such as providing multiple resource instances when RF_ResourceAllocation provided a resource type. Optional when a SupportedActivity does not have a schedule allocation in the particular schedule window.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceAllocatorSystemThreadStatusType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Provides status of SystemThreads (Payload, Antenna, and Network resources) managed by Resource Manager.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemThreadIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>SystemThreadIndex associated with status in sibling elements. Reference to the SystemThread roll up of payload, antenna, and network/RFD resources, as summarized in the SystemThreadInformationFile, part of the Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailabilityInfo" type="uci:AvailabilityInfoType">
				<xs:annotation>
					<xs:documentation>Provides availability status information of the sibling SystemThreadIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemThreadLoading" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Provides current utilization status of sibling SystemThreadIndex.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceDefinitionChoiceType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>Allows a request or allocation to be directed to either RF or digital resources.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AllocateRF_Resources" type="uci:ResourceDefinitionRF_Type">
				<xs:annotation>
					<xs:documentation>Allows the requester to identify RF aperture and payload resources, connected through an RF Distribution matrix and controlled by an RF Distribution and Control Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllocateDigitalResources" type="uci:ResourceDefinitionDigitalType">
				<xs:annotation>
					<xs:documentation>Allows the requester to identify digital MFA and digital MFP resources, along with sample rates and network rates, connected on a digital backbone.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="ResourceDefinitionDigitalType" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceRequestOptionIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Allows the resource manager to select a single identifier when presented with several options from which to pick an allocation. The requesting function defines the indices at the time of the request, numbering them 1, 2, 3, etc. The ResourceAllocator responds with an allocation which includes the chosen index.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StreamIndex" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Reference to a specific usage of a DigitalThreadInstanceIndex, assigned by ResourceAllocator at allocation time. Multiple streams may be required, such as for separate transmit and receive streams.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VAS_Endpoint" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Index/Stream of the Virtual Aperture Scheduler (VAS) for the Service to use to address schedule requests (either a system level VAS or a MFA VAS). Defined in Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAccessPriority" type="uci:UnsignedIntegerMinMaxType">
				<xs:annotation>
					<xs:documentation>ResourceAccessPriority is utilized in conflict resolution. Higher priority wins.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BlankingLimit" type="uci:BlankingLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Only present for Transmit allocations. Identifies the allowed blanking of the access by other functions. The overall blanking limit is allocated across Receive functions that can blank the Transmit, identified either by Subsystem (such as an ESM Subsystem) or a DigitalPayload function in either MFP or MFA.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodAccessAllocations" type="uci:ResourceAllocationPeriodDigitalType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The allocated percent access limit is expected to not be exceeded by the payload. The Expected access alerts the Digital Payload that the scheduled accesses have some likelihood of meeting or not meeting the desired duty cycle, based on the other Activities with allocations at the time of the request. Actual access allocation is not known until schedule time (and may be interrupted by low latency events).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PointingVector" type="uci:AperturePointingOptionsType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The effective pointing available (Field of Regard) of the aperture allocation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceDefinitionRF_Type" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceRequestOptionIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Allows the resource manager to select a single identifier when presented with several options from which to pick an allocation. The requesting function defines the indices at the time of the request, numbering them 1, 2, 3, etc. The ResourceAllocator responds with an allocation which includes the chosen index.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemThreadIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to the SystemThread roll up of payload, antenna, and network/RFD resources, as summarized in the SystemThreadInformationFile, part of the Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_ThreadInstanceIndex" type="xs:unsignedInt" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element contains the value of the RFTI Indices.  If  number of RFTI == 2, the value of RF_ThreadInstanceIndex[0]is used to access resources with the sibling  ResourceAccessPriority == Min;  the value of the RF_ThreadInstanceIndex[1] is used to access resources with the sibling ResourceAccessPriority == Max. ResourceAllocator generates the index in a an incrementing fashion 1, 2, 3... at resource allocation time, assuring that identifiers are unique across resource allocations. RF_ThreadInstanceIndices may be re-used after an allocation has been deallocated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AntennaID_AndBeamConfigurations" type="uci:AntennaAllocationAndBeamConfigurationsType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates allocated Antenna ID and the associated Beam Configuration Indices. Specific AntennaResourceInstances are also allocated.  Shared Antennas are not taxonomically described in UCI.  It is left to external actors to organize, uniquely describe and identify them. AntennaID is the same as the Antenna SupportCapabilityID.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodAccessAllocations" type="uci:ResourceAllocationPeriodRF_Type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Duty cycle allocations for each AccessPeriodIndex requested in the RF_ResourceAllocationRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BlankingLimit" type="uci:BlankingLimitType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Required for allocations of Tx resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Mode" type="uci:RF_TypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the resource will be used for Rx, Tx, or Both per Access Period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAccessPriority" type="uci:UnsignedIntegerMinMaxType">
				<xs:annotation>
					<xs:documentation>Allocates the ResourceAccessPriority which is allowed to be set by the Subsystem in the RF_ThreadInstanceSetupCommand. Indicates the minimum or maximum value in the Resource Access Priority range.  If the Resource Access Priority range is actually a discrete single priority, this element and the sibling Max element should be equal.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceRequestID_AndOptionType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Provides reference to both the ResourceRequestID and the OptionIndex within the RF_ResourceAllocationRequest which were allocated to the Activity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceRequestID" type="uci:RequestID_Type">
				<xs:annotation>
					<xs:documentation>Identifies the associated RF_ResourceAllocationRequest message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceRequestOptionIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the option from the RF_ResourceAllocationRequest which was allocated to the Activity. Allows the resource manager to select a single identifier when presented with several options from which to pick an allocation. The requesting function defines the indices at the time of the request, numbering them 1, 2, 3, etc. The ResourceAllocator responds with an allocation which includes the chosen index.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceRequestOptionType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ResourceRequestOptionIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Allows the resource manager to select a single identifier when presented with several options from which to pick an allocation. The requesting function defines the indices at the time of the request, numbering them 1, 2, 3, etc. The ResourceAllocator responds with an allocation which includes the chosen index.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceRequest" type="uci:ResourceRequestType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Each ResourceRequestOption contains up to two ResourceRequests, one for each RF_Mode if the operation has both transmit and receive resources. Each ResourceRequest structure defines the RF_Mode applicable, the AccessPeriod description of duty cycle and other utilization, the Select_Resources identification of the MFA and VA to be used in the RF_Mode, and an optional MaxPercentInterruption. The two ResourceRequest fields are grouped together under each ResourceRequestOption because a Service may provide multiple options on different arrays, and the grouping allows for Tx/Rx to be allocated as a group rather than treated as logically independent requests and allocations.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DurationRange" type="uci:DateTimeRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Time for which the resource allocation is valid. No Duration implies an indefinite duration, expected to be in effect until the sibling RequestingFunction is complete or a new ResourceRequest for the same RequestingFunction is sent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RequestedFrequencyRange" type="uci:FrequencyRangeType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Requested Frequency Range of the RF path for the activity to be performed. Optional if RequestState is CANCEL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Merit" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Weighting for the sibling ResourceRequestOptions when there multiple options being requested.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PerformanceMetric" type="uci:PerformanceMetricSetType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated set of metrics that describe the performance of this resource request option.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceRequestPeriodType" uci:version="001.002.000.001">
		<xs:annotation>
			<xs:documentation>A description of the requested duration and duty cycle of an access period.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="AccessPeriodIndex" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>The ID is used to differentiate the allocation and performance feedback for the two or more behaviors. In some cases, the groups may be "Active" and "Idle" periods, though it is not assumed that either of two periods has to be totally idle. Generated at run time by the payload to define access patterns (period 1, period 2, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccessPeriodRF_Mode" type="uci:RF_TypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether the resource will be used for Rx, Tx, or Both per Access Period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodRanking" type="uci:ComparableRankingType">
				<xs:annotation>
					<xs:documentation>The subsystem reports the current Ranking information to the EWRM, allowing for the ResourceAllocation management function to be independent of subsystem command handling, in case of multiple subsystems types (beyond EW) sharing apertures. Optional if ResourceRequestState is REMOVE.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypicalAccessPeriodDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Required if the payload behavior falls into categories of "active" and "idle" periods, in which case, this field describes the duration of either the active (such as beam passing) time or the idle (between beam passings) time. If the subsystem behavior is homogeneous, such as (EA) high duty cycle noise or (ESM) regularly repeating dwells, no TypicalAccessPeriodDuration is given, and the sibling elements describe average timescale behavior.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxAccessWidthRequested" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>During the access to the allocated resource, if the PercentAccessRequested is less than 100%, this time would be the max contiguous time accessed by the subsystem. It is the longest time the subsystem needs its high speed access granted before an access release.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypicalAccessRequestToReleaseDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Typical duration from which the subsystem request access to when the subsystem request access release, assuming it is granted upon initial request and not interrupted.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TypicalAccessReleaseToRequestDuration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Typical time from which the subsystem request access release to when the subsystem request access again.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentAccessDuringThePeriod" type="uci:PercentRangeType">
				<xs:annotation>
					<xs:documentation>Percentage of time the resource is being requested before allowable percent interruption.  The subsystem (e.g. EA, ESM) will use the Minimum PercentAccessRequested with the MaxAccessWidthRequested to request a needed percentage of time an access request to access release (i.e. Time on the Resource). PercentAccessRequested (Min) – [PercentAccessRequested (Min) X MaxPercentInterruption] = Needed Percentage of Time on Antenna Resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceRequestType" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DependentActivity" type="uci:DependentActivityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This indicates Activity's that this Activity is dependent on.  If the dependent Activity's Resource Allocation is removed or never allocated, this Activity's Resource Allocation will be removed or not fulfilled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxPercentInterruption" type="uci:PercentType">
				<xs:annotation>
					<xs:documentation>Percentage of time the requested access time can be interrupted (e.g. blanked). Percent of tolerable interruption of the PercentAccessRequested (Min).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Mode" type="uci:RF_TypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the resource will be used for Rx, Tx, or Both.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccessPeriod" type="uci:ResourceRequestPeriodType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Defines series of aperture access requests by the Subsystem. If the aperture access behavior is homogeneous, (such as unchanging throughout a threat scan period) only one AccessPeriod is described. If the payload has different behaviors such as higher duty cycle during a beam passing and less aperture access between beam passings, then two AccessPeriods are described. It is assumed, if there are two AccessPeriods, that they alternate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectResources" type="uci:ComponentResourceType">
				<xs:annotation>
					<xs:documentation>The set of Antenna and Payload Resources to be used for the sibling RF_Mode.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceSelectionType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Specifies the antenna resource to which the sibling ResourceAccessPriority applies. When the Shared Antenna/Resources are not specified, the RF_Mode must be present to control whether the sibling ResourceAccessPriority applies to transmit or receive beams of the resulting EA_Activity. ResourceSelection may only be omitted when a single instance of "PrioritizeResources" is present in the EA_Command, in which case, the ResourceAccessPriority applies to any and all beams (whether transmit or receive) associated with the EA_Command.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="RF_Mode" type="uci:RF_TypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Controls whether SelectAntenna applies to transmit or receive beams of the resulting EA_Activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectAntenna" type="uci:SelectAntennaType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the EA activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResourceStatusSelectedType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemThreadIndex" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Reference to the SystemThread roll up of payload, antenna, and network/RFD resources, as summarized in the SystemThreadInformationFile, part of the Shared Aperture Information Files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SelectedAntenna" type="uci:SelectAntennaType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of a Shared Antenna and/or AntennaResources to be used for the activity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RF_Mode" type="uci:RF_TypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates whether the resource will be used for Rx, Tx, or Both.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResourceAccessPriority" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the Resource Access Priority for this beam in this Activity. This is a positive ordinal integer value used to define arbitration priority for accesses to Shared Antenna Resources.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeriodPerformanceFeedback" type="uci:PeriodPerformanceFeedbackType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Performance feedback for each access period.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResponseActivityMDT" uci:version="003.000.002.000">
