			<xs:element name="AtmosphericDensityModel" type="uci:AtmosphereModelEnum">
				<xs:annotation>
					<xs:documentation>The name of the atmospheric density model used for the propagation. An atmospheric density model is either an empirical or physics-based model that aims to provide a realistic representation of neutral density in the upper atmosphere.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpaceWeatherData" type="uci:SpaceWeatherDataChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The space weather data to be used by the atmospheric density model.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DragModelCoefficient" type="uci:DragCoefficientChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The coefficient(s) used in modeling drag force.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EnergyDissipationRate" type="uci:EnergyDissipationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contains all other factors to be considered in the drag force model. May be omitted when atmospheric perturbations are not used for the subject RSO.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AtmosphericPropagationLossType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LossConstant" type="xs:double">
				<xs:annotation>
					<xs:documentation>Indicates the 2-way atmospheric propagation loss constant to be assumed when determining CNR and or range/power levels.  Total Loss = Range*Slope + Constant.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LossSlope" type="xs:double">
				<xs:annotation>
					<xs:documentation>Indicates 2-way atmospheric propagation loss slope, scaling with range, to be assumed when determining CNR and or range/power levels.  Total Loss = Range*Slope + Constant.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FrequencyBand" type="uci:IEEE_FrequencyBandEnum">
				<xs:annotation>
					<xs:documentation>Indicates the frequency band to which the sibling loss values apply.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
