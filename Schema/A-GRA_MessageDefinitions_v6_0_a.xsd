				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="DamageInformationSourceType" uci:version="001.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ProductMetadataID" type="uci:ProductMetadataID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates products used to make the report.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Observation" type="uci:DamageObservationSourceType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates observations used to make the report which don't have a corresponding Product for review.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DamageInformationWeatherSourceType" uci:version="001.000.002.000">
