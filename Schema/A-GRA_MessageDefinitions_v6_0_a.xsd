			<xs:enumeration value="DROP_TASKS">
				<xs:annotation>
					<xs:documentation>Recommend that the operator drop specified tasks.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAIL_TASKS">
				<xs:annotation>
					<xs:documentation>Recommend that the operator designate specified tasks as failed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXECUTE_RESPONSE">
				<xs:annotation>
					<xs:documentation>Recommend that the operator review applicable Responses in available ResponsePlans then initiate an appropriate Option.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OperatorPhoneNumberType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates up to a 20-digit US phone number. The operator may list several phone numbers including extensions and the string can include dots,hyphens and/or spaces.  Example formats include: 555-555-5555x5555, 5555555555, 555 555 5555x555555.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
			<xs:maxLength value="20" />
			<xs:pattern value="([0-9a-zA-Z\s\-\.]){1,20}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OperatorStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether the operator is available or not.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates an operator is available.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNAVAILABLE">
				<xs:annotation>
					<xs:documentation>Indicates that an operator is not available.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OperatorUniqueNameEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates an operator unique name for an affiliated asset outside GENC scope.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:annotation>
				<xs:documentation>Operator unique names that are not found in GENC_CountryNameEnum.</xs:documentation>
			</xs:annotation>
			<xs:enumeration value="ARAB_SATCOM_ORG">
				<xs:annotation>
					<xs:documentation>Full name is Arab Satellite Communications Organization.  Arabsat was created to deliver satellite-based, public and private telecommunications services to the Arab States, IAW International Standards.  Arabsat is a communications satellite operator in the Arab world, headquartered in the city of Riyadh, Saudi Arabia.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASIASAT_CORP">
				<xs:annotation>
					<xs:documentation>Asiasat is jointly owned by chinese state-owned CITIC Limited and private equity fund The Carlyle Group.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMMONWEALTH_OF_INDEPENDENT_STATES">
				<xs:annotation>
					<xs:documentation>The Commonwealth of Independent States is a regional intergovernmental organization of nine members, plus two founding non-member, post-Soviet republics in Eurasia.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ESA">
				<xs:annotation>
					<xs:documentation>Full name is European Space Agency (ESA).  The European Space Agency is an intergovernmental organisation of 22 member states dedicated to the exploration of space.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EUROPEAN_SPACE_RESEARCH_ORG">
				<xs:annotation>
					<xs:documentation>The European Space Research Organization was an international organisation founded by 10 European nations with the intention of jointly pursuing scientific research in space. It was founded in 1964.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EUMETSAT">
				<xs:annotation>
					<xs:documentation>Full name is the European Organisation for the Exploitation of Meteorological Satellites (EUMETSAT) and is an intergovernmental organisation created through an international convention agreed by a current total of 30 European Member States</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EUTELSAT">
				<xs:annotation>
					<xs:documentation>Full name is the European Telecommunications Satellite Organization (EUTELSAT) and is an intergovernmental organisation consisting of 49 member states. It is headquartered in Paris, France.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRANCE_GERMANY">
				<xs:annotation>
					<xs:documentation>Joint asset by both France and Germany.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRANCE_ITALY">
				<xs:annotation>
					<xs:documentation>Joint asset by both France and Italy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GLOBALSTAR">
				<xs:annotation>
					<xs:documentation>Globalstar, Inc. is an American satellite communications company that operates a low Earth orbit satellite constellation for satellite phone and low-speed data communications, somewhat similar to the Iridium satellite constellation and Orbcomm satellite systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INMARSAT">
				<xs:annotation>
					<xs:documentation>Full name is the International Maritime Satellite Organization (INMARSAT), was established as an intergovernmental organization in 1979 to supply maritime and other mobile communications services via satellite; it also was later transformed into a privately owned entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ISS">
				<xs:annotation>
					<xs:documentation>Full name is the International Space Station (ISS) and is a modular space station in low Earth orbit. It is a multinational collaborative project involving five participating space agencies: NASA, Roscosmos, JAXA, ESA, and CSA.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTELSAT">
				<xs:annotation>
					<xs:documentation>Full name is the International Telecommunications Satellite Organization (INTELSAT) and is an intergovernmental organization charged with overseeing the public service obligations of Intelsat.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NATO">
				<xs:annotation>
					<xs:documentation>Full name is the North Atlantic Treaty Organization (NATO), also called the North Atlantic Alliance, and is an intergovernmental military alliance between 28 European countries and 2 North American countries. The organization implements the North Atlantic Treaty that was signed on 4 April 1949.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="O3B_NETWORKS">
				<xs:annotation>
					<xs:documentation>O3b Networks Ltd. was a network communications service provider building and operating a medium Earth orbit satellite constellation primarily intended to provide voice and data communications to mobile operators and Internet service providers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBITAL_TELECOMM_SATELLITE_GLOBALSTAR">
				<xs:annotation>
					<xs:documentation>Globalstar asset as an orbital telecommunications satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REGIONAL_AFRICAN_SATCOM_ORG">
				<xs:annotation>
					<xs:documentation>The Regional African Satellite Communication (SATCOM) Organization will provide telecommunication services, direct TV broadcast services and Internet access in rural areas of Africa. Under an agreement with RASCOM, RascomStar-QAF will implement RASCOM's first 14communications satellite project.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_LAUNCH_SA">
				<xs:annotation>
					<xs:documentation>Sea Launch was a multinational spacecraft launch company founded in 1995 that provided orbital launch services from 1999–2014.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOCIETE_EUROPEENNE_DES_SATS">
				<xs:annotation>
					<xs:documentation>Based in Betzdorf, Luxembourg and founded in 1985 as Société Européenne des Satellites (SATS), the company was renamed SES Global in 2001 and has been simply "SES".  SES S.A. is a Luxembourgish satellite and terrestrial telecommunications network provider supplying video and data connectivity worldwide to broadcasters, content and internet service providers, mobile and fixed network operators, governments and institutions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TO_BE_DETERMINED">
				<xs:annotation>
					<xs:documentation>Asset origin yet to be determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpInteractionEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration indicating the interaction with an op type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CAPTURE">
				<xs:annotation>
					<xs:documentation>A reference is considered captured if the current or closest ever location of the reference is within a buffer or enters the op type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPTURE_AND_EXIT">
				<xs:annotation>
					<xs:documentation>A reference is considered captured if the current or closest ever location of the reference is within a buffer or enters the op type. Once captured, the reference immediately exits the op type.  A reference is considered exited if the reference was previously "captured" and the current or closest ever location of the reference is outside of a buffer or enters the op type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXIT">
				<xs:annotation>
					<xs:documentation>A reference is considered exited if the reference was previously "captured" and the current or closest ever location of the reference is outside of a buffer or enters the op type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpLineCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of an operational line.  Based on MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_LINE">
				<xs:annotation>
					<xs:documentation>A general line where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORWARD_EDGE_OF_BATTLE_AREA">
				<xs:annotation>
					<xs:documentation>The foremost limits of a series of areas in which ground combat units are deployed, excluding the areas in which the covering or screening forces are operating.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUN_TARGET_LINE">
				<xs:annotation>
					<xs:documentation>Straight line from the gun or guns to the target.  Altitude, if included, is the apex of the projectile.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CORRIDOR">
				<xs:annotation>
					<xs:documentation>Line with width describing the passageway designated for travel by friendly aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_BOUNDARY">
				<xs:annotation>
					<xs:documentation>Line that indicates a limit beyond which exists a hostile environment.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BUFFER_ZONE_BOUNDARY">
				<xs:annotation>
					<xs:documentation>Line beyond which friendly aircraft usually do not fly in peacetime.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOW_LEVEL_TRANSIT_ROUTE">
				<xs:annotation>
					<xs:documentation>Line describing the center line of a route through the forward missile engagement zone that must be flown by friendly aircraft to ensure they are not designated hostile by defense systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TACTICAL_ACTION_LINE">
				<xs:annotation>
					<xs:documentation>Line positioned in hostile airspace which may be used in conjunction with other criteria for hostile determination.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIRE_SUPPORT_COORDINATION_LINE">
				<xs:annotation>
					<xs:documentation>Line established by the appropriate ground commander to ensure coordination of fire not under his command but which may affect current tactical operations.  Attacks against ground targets behind this line must be coordinated with the appropriate ground commander.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORWARD_LINE_OF_OWN_TROOPS">
				<xs:annotation>
					<xs:documentation>Line defining the forward position of own troops within a ground area of responsibility, that does not usually coincide with the forward edge of battle area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LINE_OF_COMMUNICATIONS">
				<xs:annotation>
					<xs:documentation>Line the route that connects an operating military unit with its supply base.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JETWAY">
				<xs:annotation>
					<xs:documentation>Line with width that defines areas where commercial aircraft are flying through.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpPointEmergencyEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of an emergency point. Based on MIL-STD-6016 DFI/DUI 1641/001.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_EMERGENCY">
				<xs:annotation>
					<xs:documentation>A general emergency point where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DOWN_AIRCRAFT">
				<xs:annotation>
					<xs:documentation>The emergency point indicates the location of a downed aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAN_IN_WATER">
				<xs:annotation>
					<xs:documentation>The emergency point indicates the location of personnel in water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DITCHING">
				<xs:annotation>
					<xs:documentation>The emergency point indicates ditching.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BAILOUT">
				<xs:annotation>
					<xs:documentation>The emergency point indicates the location of a bailout.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISTRESSED_VESSEL">
				<xs:annotation>
					<xs:documentation>The emergency point indicates the location of a distressed vessel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>An emergency point that does not fit into any of the other predefined categories.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpPointGeneralEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of a general or commonly used operational point.  Some values are from MIL-STD-6016 Point Type DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LOSS_OF_COMM">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates that this point is a location to return to in a loss of comm. situation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXTIRPATION">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates that this point is an extirpation point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EGRESS">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates an egress point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INGRESS">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates an ingress point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates a rendezvous point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HANDOFF">
				<xs:annotation>
					<xs:documentation>The presence of this element indicates a point where hand-off of control responsibility will occur.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NAVIGATION">
				<xs:annotation>
					<xs:documentation>A point that indicates any hazard to navigation irrespective of environment i.e., shipwreck, tall antenna, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DETONATION_CENTER_POINT">
				<xs:annotation>
					<xs:documentation>A point on the surface of the earth at, or directly below or above, the center of a planned or actual detonation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TANKER">
				<xs:annotation>
					<xs:documentation>A point at which a tanker aircraft is or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_POINT">
				<xs:annotation>
					<xs:documentation>A point designated for an aircraft to orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAUNCH_TO_MISSION_TRANSITION">
				<xs:annotation>
					<xs:documentation>Indicates the point where the transition from launch operations to Mission operations occurs.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_TO_RECOVERY_TRANSITION">
				<xs:annotation>
					<xs:documentation>Indicates the point where the transition from Mission operations to recovery operations occurs.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMERGENCY">
				<xs:annotation>
					<xs:documentation>A point that describes the location of an emergency situation such as a downed aircraft.  Normally relevant additional information would be populated in the OpDescription element.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE">
				<xs:annotation>
					<xs:documentation>A point that doesn't have a specified "Op" purpose but is useful for display.  Normally relevant additional information would be populated in the OpDescription element.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORIGIN">
				<xs:annotation>
					<xs:documentation>Denotes the OpPoint is an origin point for beginning a mission. This could be a takeoff point for an aircraft, a base for a ground unit, or a dock for a ship.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DESTINATION">
				<xs:annotation>
					<xs:documentation>Denotes the OpPoint is a destination point for a system once a mission is complete. This could be a landing point for an aircraft, a base for a ground unit, or a dock for a ship.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpPointHazardEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of a hazard point.  Based on MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_HAZARD">
				<xs:annotation>
					<xs:documentation>A general hazard point where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NAVIGATION">
				<xs:annotation>
					<xs:documentation>A point that indicates any hazard to navigation irrespective of environment i.e., shipwreck, tall antenna, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MINE">
				<xs:annotation>
					<xs:documentation>A point at which a mine or mines is/are located.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMPACT_POINT">
				<xs:annotation>
					<xs:documentation>The real or expected point that a device has or will penetrate or contact a surface.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND_ZERO">
				<xs:annotation>
					<xs:documentation>A point on the surface of the earth at, or directly below or above, the center of a planned or actual nuclear detonation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIM_WEAPON_ENTRY_POINT">
				<xs:annotation>
					<xs:documentation>A point that a device is intended to pass through prior to arrival at the final destination or target. Primarily used in maritime operations to indicate the water entry point for an ASW weapon.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_LAUNCH_POINT">
				<xs:annotation>
					<xs:documentation>A point indicating the position from which a missile has been or will be launched.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELECTRONIC_ATTACK_DECOY">
				<xs:annotation>
					<xs:documentation>A point at which a device is located that produces false targets, i.e., target generation, chaff, and confusion deflector.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGAGEMENT_POINT">
				<xs:annotation>
					<xs:documentation>The real or expected point at which ordnance is being or will be delivered against a ground target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OIL_RIG">
				<xs:annotation>
					<xs:documentation>A point at which an oil rig is located.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>A hazard point that does not fit into any of the other predefined categories.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpPointReferenceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of a reference point.  Based on MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_REFERENCE">
				<xs:annotation>
					<xs:documentation>A general reference point where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MARSHALL_POINT">
				<xs:annotation>
					<xs:documentation>A point used to assemble, hold, or organize troops, aircraft, or ships for a mission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WAYPOINT">
				<xs:annotation>
					<xs:documentation>A point in space to which an aircraft may be vectored.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CORRIDOR_TAB">
				<xs:annotation>
					<xs:documentation>A point defining the boundary of a corridor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POSITION_INTENDED_MOVEMENT">
				<xs:annotation>
					<xs:documentation>A reference point established by the movement (PIM) officer in tactical command at a given time, and a forecast of the courses and speeds expected to be made good over the ground. PIMs are established to assist the return of aircraft, to aid outlying surface units in maintaining their stations, and for rendezvous purposes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISPOSITION_CENTER">
				<xs:annotation>
					<xs:documentation>A point designated as the center of a prescribed arrangement of stations to be occupied by several formations and single ships of a fleet or major subdivisions of a fleet for secondary purposes, such as cruising, approach, maintaining contact or battle. A prescribed arrangement of all the tactical units composing a flight or group of aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FORMATION_CENTER">
				<xs:annotation>
					<xs:documentation>A point designated as the center of an ordered arrangement of units, normally the geometric center. It is the point of origin of a formation axis.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_AREA">
				<xs:annotation>
					<xs:documentation>The center of a search area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VICTOR_LIMA">
				<xs:annotation>
					<xs:documentation>The reference point for aircraft conducting vector logic tactics on link 4A. Equivalent to link 4A data link reference point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUB_POSITION_INTENDED_MOVMENT">
				<xs:annotation>
					<xs:documentation>A reference point defining the geographic position and intended (SIM) movement of a submarine operating in direct support of a battle group, or of a submarine patrol area (SPA).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEFENDED_ASSET">
				<xs:annotation>
					<xs:documentation>A location or facility designated as having tactical significance and defended by air defense resources.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>A reference point that does not fit into any of the other predefined categories.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BULLSEYE">
				<xs:annotation>
					<xs:documentation>An established reference point from which the position of an object can be referenced.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpPointStationEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of a station point.  Based on MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="GENERAL_STATION">
				<xs:annotation>
					<xs:documentation>A general station point where the function must be described by other procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TOMCAT">
				<xs:annotation>
					<xs:documentation>A point occupied by a surface unit capable of performing air control functions whose purpose is to screen returning aircraft to prevent enemy aircraft from locating the force.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PICKET">
				<xs:annotation>
					<xs:documentation>A point outside a formation or geographic area where an aircraft or ship is stationed as a rescue or warning unit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>A point for a prearranged meeting at a given time and location from which to begin an action or phase of an operation or to which to return, after an operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REPLENISHMENT">
				<xs:annotation>
					<xs:documentation>A point where rearming and resupply of units other than aircraft may be conducted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RESCUE">
				<xs:annotation>
					<xs:documentation>A point used to mark the position of a rescue operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMBAT_AIR_PATROL">
				<xs:annotation>
					<xs:documentation>A point at which cap aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIRBORNE_EARLY_WARNING">
				<xs:annotation>
					<xs:documentation>A point at which AEW aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASW_FIXED_WING">
				<xs:annotation>
					<xs:documentation>A point denoting a station where a fixed wing aircraft on an antisubmarine warfare mission will operate.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASW_HELO">
				<xs:annotation>
					<xs:documentation>A point denoting a station where a helicopter whose mission is antisubmarine warfare will operate.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REPLENISHMENT_AIR">
				<xs:annotation>
					<xs:documentation>A point where aircraft rearming and resupply may be conducted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STRIKE_IP">
				<xs:annotation>
					<xs:documentation>A point in space that aircraft (IP) rendezvous or pass through prior to attacking a ground target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TACAN">
				<xs:annotation>
					<xs:documentation>A point at which a TACAN is located.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TANKER">
				<xs:annotation>
					<xs:documentation>A point at which a tanker aircraft is or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RACE_TRACK">
				<xs:annotation>
					<xs:documentation>An oval within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>A figure eight pattern within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RANDOM_CLOSED">
				<xs:annotation>
					<xs:documentation>A rectangle in which the aircraft will track randomly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_POINT">
				<xs:annotation>
					<xs:documentation>A point designated for an aircraft to orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>A point that does not fit into any of the other predefined categories.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The state of an Op Line/Point/Volume/Zone.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the operational type is active.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the operational type is inactive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpZoneCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of an operational zone.  Many, but not all, of the enumerations are from MIL-STD-6016 Point Type (DFI 363/DUI 003) and Point Amplification (DFI 379/DUI 002).  Some of the enumerations in this type can also have unique parameters that are specified in OpZoneCategoryType.  See individual enumerations for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIRBORNE_EARLY_WARNING">
				<xs:annotation>
					<xs:documentation>A point at which AEW aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMBAT_AIR_PATROL">
				<xs:annotation>
					<xs:documentation>A point at which CAP aircraft are or will be orbiting or maneuvering.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTRAINED_ENTRY_EXIT">
				<xs:annotation>
					<xs:documentation>Indicates an area with constrained entries and exits. The additional parameters used with this zone category are defined in the ConstrainedEntryExitType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONTAMINATED">
				<xs:annotation>
					<xs:documentation>Indicates the zone is contaminated, an area caused by the deposit and/or absorption of radioactive material, or of biological or chemical agents on and by structures, areas, personnel, or objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DANGER">
				<xs:annotation>
					<xs:documentation>A specified area above, below, or within which there may be a potential danger.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEFENDED_AREA">
				<xs:annotation>
					<xs:documentation>An area the source tn is capable of defending against ballistic missiles, etc.,(i.e. the source tn is operational with ready weapons and has designated the area for defense).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DIRECTED_SEARCH_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a directed search area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EOB">
				<xs:annotation>
					<xs:documentation>Indicates the zone is the boundary for an electronic order of battle request.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXERCISE">
				<xs:annotation>
					<xs:documentation>An area for military maneuver or simulated wartime operation involving planning, preparation and execution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIGHTER_ENGAGE_AOR">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a fighter area of responsibility (AOR), an airspace of defined dimensions within which the responsibility for engagement normally rests with fighter aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FILTER_AREA">
				<xs:annotation>
					<xs:documentation>Indicates a geographic area of interest for the purpose of limiting data.  The additional parameters used with this zone category are defined in the OpZoneFilterAreaPET choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GENERAL_HAZARD">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hazard area that doesn't have a specified operational purpose.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GENERAL_STATION">
				<xs:annotation>
					<xs:documentation>A general zone describing an air station that must be amplified by voice or predetermined procedures.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND_AOR">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a ground area of responsibility (AOR), an area of ground within which the responsibility for engagement normally rests with the appropriate ground force commander.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_TACTICAL_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hostile tactical area, an area in which hostile tactical forces (to include ground, air, or maritime) are known to be or will be operating.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE_WEAPON">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a hostile weapon zone, an area in which hostile air defense systems are capable of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMPACT_POINT">
				<xs:annotation>
					<xs:documentation>The real or expected point that a device has or will penetrate or contact a surface.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JAMMING">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a jamming control zone.  The additional parameters used with this zone category are defined in the OpZoneJammingType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KEEP_IN">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a boundary within which applicable systems must stay.  The additional parameters used with this zone category are defined in the IngressEgressType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KILL">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a kill zone, an air defense system (SOC) area in which friendly fighters may use less restrictive rules of engagement.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_ENGAGEMENT">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a missile engagement zone, a primary engagement area designated for friendly surface to air missiles.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE_LAUNCH_POINT">
				<xs:annotation>
					<xs:documentation>A point indicating the position from which a missile has been or will be launched.  The additional parameters used with this zone category are defined in the OpZoneMissileLaunchDataType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_AREA">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area in which a mission will take place.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NAMED_AREA_OF_INTEREST">
				<xs:annotation>
					<xs:documentation>An area usually along an enemy mobility corridor where enemy activity (or inactivity) confirms a particular course of action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_COMM">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where communications use is restricted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_FIRE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where strike impact is restricted; the zone does not restrict the launch of weapons.  The additional parameters used with this zone category are defined in the OpZoneNoFireType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_FLY">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where flight is restricted.  The additional parameters used with this zone category are defined in the OpZoneNoFlyType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_IMAGE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area where image collection is restricted.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>A figure eight pattern within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RACE_TRACK">
				<xs:annotation>
					<xs:documentation>An oval within a rectangle that the aircraft is or will be tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_RANDOM_CLOSED">
				<xs:annotation>
					<xs:documentation>A rectangle in which the aircraft will track randomly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area that doesn't have a specified operational purpose.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>An area where a search is being or will be conducted. normally associated with a SAR mission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHORAD">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a short range area defense (SHORAD), an area defended by friendly army short range air defense systems.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBMARINE_PATROL_AREA">
				<xs:annotation>
					<xs:documentation>A restricted area established to allow submarine operations to be unimpeded by the operation, or possible attack from friendly forces in wartime, or to be conducted without submerged mutual interference in peacetime.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TARGET_AREA_OF_INTEREST">
				<xs:annotation>
					<xs:documentation>An engagement area usually along an enemy mobility corridor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VEHICLE_CONFIGURATION">
				<xs:annotation>
					<xs:documentation>Indicates the zone is a region where specific vehicle configuration parameters should be changed.  The additional parameters used with this zone category are defined in the VehicleCommandDataType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEAPON_RESTRICTION">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area within which a set of restricted weapons cannot be used against a target type and/or within in the zone.  The additional parameters used with this zone category are defined in the OpZoneWeaponRestrictionType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WEATHER_CONDITIONS">
				<xs:annotation>
					<xs:documentation>Indicates the zone is an area within which weather conditions have a potential for mission impact.  The additional parameters used with this zone category are defined in the OpZoneWeatherType choice in OpZoneCategoryType.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OpZoneFilterEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The determination of whether data is included or excluded.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates the filter zone will include data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates the filter zone will exclude data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BOTH">
				<xs:annotation>
					<xs:documentation>Indicates the filter zone will have included and excluded data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalBreakupEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates ways in which orbiting objects break-up and/or in which break-ups are predicted/modeled.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="COLLISION">
				<xs:annotation>
					<xs:documentation>Indicates a space based object breaking into pieces as a result of a physical collision with another object, such as another satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINGLE_OBJECT_BREAKUP">
				<xs:annotation>
					<xs:documentation>Indicates a space based object breaking into pieces as a result of an internal explosion due to unvented fuel, overheated batteries or other causes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalConjunctionEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of Orbital Conjunction.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="KINEMATIC_COLLISION">
				<xs:annotation>
					<xs:documentation>Indicates a kinematic collision.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KINEMATIC_NEAR_MISS">
				<xs:annotation>
					<xs:documentation>Indicates a kinematic near miss.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RF_INTERFERENCE">
				<xs:annotation>
					<xs:documentation>Indicates RF interference.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LASER_INTERFERENCE">
				<xs:annotation>
					<xs:documentation>Indicates laser interference.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalDebrisEstimateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether estimate results are provided as a file or detailed in the OrbitalDebrisEstimate message.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FILE">
				<xs:annotation>
					<xs:documentation>Indicates that the orbital debris estimate results are contained in a file.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MESSAGE">
				<xs:annotation>
					<xs:documentation>Indicates that the orbital debris estimate results are embedded in a message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalEventEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates a list of orbital events.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="APOGEE">
				<xs:annotation>
					<xs:documentation>The point in the orbit that is furthest from the Earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASCENDING_NODE">
				<xs:annotation>
					<xs:documentation>Where the orbit passes upward through the equatorial plane.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DESCENDING_NODE">
				<xs:annotation>
					<xs:documentation>Where the orbit passes downward through the equatorial plane.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGINE_CUTOFF">
				<xs:annotation>
					<xs:documentation>When the thruster stops firing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGINE_START">
				<xs:annotation>
					<xs:documentation>When the thruster begins to fire.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAUNCH">
				<xs:annotation>
					<xs:documentation>When the vehicle leaves the launch-pad or ground.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOCAL_SOLAR_TIME">
				<xs:annotation>
					<xs:documentation>This is where the time reference is in relation to the position of the sun.  As an example: Local Solar Noon is when the Sun is directly over head.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_INJECTION">
				<xs:annotation>
					<xs:documentation>Orbit injection is the time of adjustment of a spacecraft's momentum to allow for entry into a stable orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PERIGEE">
				<xs:annotation>
					<xs:documentation>The point in the orbit that is least distant from the Earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WITHIN_EARTH_FIXED_VOLUME">
				<xs:annotation>
					<xs:documentation>This is a volume that is defined by vectors in reference to  the earth. This is a polygon of latitude/longitude points plus a 1/2 cone angle along with min and max altitude (sort of a flared bowl volume).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalKinematicsSourceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the kinematics source as defined below.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ELEMENT_SET">
				<xs:annotation>
					<xs:documentation>The element set is a carryover from the legacy Two Line Element set (TLE) format, and is provided to support processes that transform to/from that format.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EPHEMERIS">
				<xs:annotation>
					<xs:documentation>Describes satellite orbits at date and time intervals.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINGLE_POSITION">
				<xs:annotation>
					<xs:documentation>From a single orbit location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLAN">
				<xs:annotation>
					<xs:documentation>From a planning service's orbit plan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalManeuverStateEnum" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>This enumeration indicates the state of the orbital maneuver.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EXPECTED_MANEUVER_NOT_DETECTED">
				<xs:annotation>
					<xs:documentation>Indicates an instance where a once predicted orbital maneuver never occurred.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_CHANGE_DETECTED">
				<xs:annotation>
					<xs:documentation>Indicates that an orbit change has been detected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_DETECTED">
				<xs:annotation>
					<xs:documentation>Indicates that a maneuver has been detected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_TRANSFER_ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates that an orbit transfer is currently active.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_REDACTED">
				<xs:annotation>
					<xs:documentation>Indicates that a previously reported maneuver was falsely reported.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalManeuverTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of orbital maneuver.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ALTITUDE_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes the satellite's orbital altitude.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLANE_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes plane of the satellite's orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAINTENANCE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that positions the satellite for maintenance operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STATION_KEEPING">
				<xs:annotation>
					<xs:documentation>Indicates kinematic changes, possibly of a magnitude less than what is technically a maneuver, with the purpose of maintaining its current orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in the orbit and position of a satellite closely matching those of another satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY_OPERATIONS">
				<xs:annotation>
					<xs:documentation>Indicates a phase of a rendezvous maneuver in which a satellite approaches another satellite more closely.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalModelNameEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates orbital model propagators that are used for predicting satellite position and velocity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SGP4">
				<xs:annotation>
					<xs:documentation>An orbital model propagator used for predicting satellites in LEO or non-LEO. Stands for Simplified General Perturbations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GPS">
				<xs:annotation>
					<xs:documentation>An orbital model used for GPS (Global Positioning System) orbits.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HPOP">
				<xs:annotation>
					<xs:documentation>An orbital model propagator used for calculating the orbits suitable for short periods and at varying altitudes with different orbits, and produces highly accurate orbit calculations. Stands for High-Precision Orbit Propagator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPICE">
				<xs:annotation>
					<xs:documentation>An orbital model propagator that contains information regarding a spacecraft ephemeris, ephemeris of a celestial object, and information regarding on-board satellite instruments, orientation, and events. Stands for Spacecraft, Planet, Instrument, Camera-matrix, Events.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SP3">
				<xs:annotation>
					<xs:documentation>An orbital model propagator used for providing precise GPS orbits.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELEVEN_PARAMETER">
				<xs:annotation>
					<xs:documentation>An orbital model propagator that models geostationary satellites.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOP">
				<xs:annotation>
					<xs:documentation>An orbital model propagator used for calculating orbits for longer time periods, such as multiple months and years, and used to calculate the averaged influences of perturbations. This stands for Long-Term Orbit Predictor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SP">
				<xs:annotation>
					<xs:documentation>An orbital model propagator used for highly accurate orbits. Stands for Special-Perturbations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of Tier 1 capabilities that an Orbital Surveillance system may support.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LOCATION_BASED">
				<xs:annotation>
					<xs:documentation>The ability to perform location based searches.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBJECT_BASED">
				<xs:annotation>
					<xs:documentation>The ability to perform object-based searches and collections.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZONE_BASED">
				<xs:annotation>
					<xs:documentation>The ability to perform zone/volume based searches.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceMessageOutputsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all message output types of Orbital Surveillance Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ORBITAL_SURVEILLANCE_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message. For example, the OrbitalSurveillanceActivity message for an Orbital Surveillance Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the OBSERVATION_MEASUREMENT_REPORT message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_NOTIFICATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the ENTITY_NOTIFICATION message which provides a notification related to an Entity (ex: ORBITAL_BREAKUP, KINEMATICS, ORBITAL_MANEUVER, MISSED_OBSERVATION, NEW).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_ELEMENT_SET">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityOrbitalElementSet message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_EPHEMERIS">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityOrbitalEphemeris message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_VCM">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityOrbitalVCM message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the Entity message. Systems that are able to also verify the identity of an object could possibly only report the associated kinematics message with a reference to the Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_LOST">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityLost message. This output may be expected if a system is unable to verify the identity of a specific target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_CSO">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityOrbitalCSO message. This output could result if a series of determinations indicate that multiple resident space objects (RSO) are in close proximity to one another.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_MANEUVER">
				<xs:annotation>
					<xs:documentation>Indicates results of the capability will be reported via the EntityOrbitalManeuver message. For instance, this output could result when a system has custody of a resident space object (RSO) and observes a sudden change in the object's orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceSensorCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of target motion collection capabilities that an orbital surveillance system may support.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="POWERED_FLIGHT_COLLECTION">
				<xs:annotation>
					<xs:documentation>Collection on a target that is applying force to affect its trajectory.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBITAL_OBJECT_COLLECTION">
				<xs:annotation>
					<xs:documentation>Collection on a target whose current motion is affected only by natural forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceSensorMessageOutputsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all message output types of Orbital Surveillance Sensor Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the ObservationMeasurementReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBITAL_SURVEILLANCE_SENSOR_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message. For example, the OrbitalSurveillanceSensorActivity message for a Orbital Surveillance Sensor Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_KINEMATICS_ORBITAL">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_ELEMENT_SET">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the EntityOrbitalElementSet message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_EPHEMERIS">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the EntityOrbitalEphemeris message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY_ORBITAL_VCM">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the EntityOrbitalVCM message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceSizeDataEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the reporting requirements for RCS and Visual Magnitude sensor collections used for size estimation characterization.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AVERAGE">
				<xs:annotation>
					<xs:documentation>Report average apparent size across collection span or spans for phenomenology (e.g., RCS, visual magnitude).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="P05_50_95">
				<xs:annotation>
					<xs:documentation>Report fifth percentile, median, and 95 percentile apparent size values across collection span or spans for phenomenology (e.g., RCS, visual magnitude).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceSizeTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Desired size or apparent size type to address information need.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ANY">
				<xs:annotation>
					<xs:documentation>Any type of size information is acceptable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AREA">
				<xs:annotation>
					<xs:documentation>Size in physical area (meters squared) is desired.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RCS">
				<xs:annotation>
					<xs:documentation>RCS size in dBsm is desired.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VISUAL_MAGNITUDE">
				<xs:annotation>
					<xs:documentation>Size in received visual magnitude is desired. The visual magnitude based on the optical signal amplitude received at the telescope aperture (as opposed to referenced to a standard distance).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WATTS_PER_STERADIAN">
				<xs:annotation>
					<xs:documentation>Size from infrared measurement is desired.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitalSurveillanceSubCapabilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of Tier 2 capabilities that an Orbital Surveillance system may support (the desired outcome of the collection).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AREA_SEARCH">
				<xs:annotation>
					<xs:documentation>Indicates that the search is to cover a specified volume referenced to an Earth-centric (or potentially expanded to other celestial reference) rather than an orbit-centric volume. Typically used for surveillance and general detection of new objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRIMARY_TARGET_SEARCH">
				<xs:annotation>
					<xs:documentation>Indicates that the search is for an object on or near the kinematics specified in target and detection of secondary objects is secondary.  Used in a case of a maneuvered, lost or new object with an expected orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBIT_ACCURACY">
				<xs:annotation>
					<xs:documentation>Indicates a task to achieve/maintain specified orbit accuracy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_PHENOMENOLOGY_SPECIFIC">
				<xs:annotation>
					<xs:documentation>Indicates a Task to characterize an object using one or more specified phenomenologies.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_STABILITY_CHANGE_DETECTION">
				<xs:annotation>
					<xs:documentation>Indicates a task to check for a change in stability or attitude.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_STABILITY_ORIENTATION_ASSESSMENT">
				<xs:annotation>
					<xs:documentation>Indicates a task to assess the stability and orientation of an object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_SIZE_ESTIMATION">
				<xs:annotation>
					<xs:documentation>Indicates a task to provide an estimated size of the object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_STRUCTURAL">
				<xs:annotation>
					<xs:documentation>Indicates a task to characterize the structure of the object down to a component size appropriate to the specified resolution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_PHOTOMETRY">
				<xs:annotation>
					<xs:documentation>Indicates a task to provide visual magnitude measurements vs time of target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CHARACTERIZATION_COLOR_PHOTOMETRY">
				<xs:annotation>
					<xs:documentation>Indicates a task to provide synchronized measurements of amplitude vs time of target in three or more sub-bands of the visible spectrum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_CSO_CLEARING">
				<xs:annotation>
					<xs:documentation>Indicates a task, involving multiple objects, to perform closely spaced object clearing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_BREAKUP_CHARACTERIZATION">
				<xs:annotation>
					<xs:documentation>Indicates a task, involving multiple objects, to collect data to characterize the spread of objects after a breakup.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_VERIFICATION">
				<xs:annotation>
					<xs:documentation>Indicates a task to verify the existence of multiple objects and that the object count matches the number specified in the combination of primary and secondary targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_CSO_GEOMETRIC_CHARACTERIZATION">
				<xs:annotation>
					<xs:documentation>Indicates a task to look for objects in the vicinity of the primary (if no secondaries specified) and provide information on relative geometries between any secondaries and the primary.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MULTI_OBJECT_METRIC">
				<xs:annotation>
					<xs:documentation>Indicates a task to indicate requirement to provide distinct position (and velocity, as possible) measurements on each object (with separate identifiers for each object) when multiple objects are in close proximity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_DETECTION">
				<xs:annotation>
					<xs:documentation>Indicates a task to detect maneuvers (may require more than one sensor) and near real-time processing.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPLOYMENT_DETECTION">
				<xs:annotation>
					<xs:documentation>Indicates a task that monitors primary target to detect deployment of secondary object or objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IDENTIFICATION_VERIFICATION">
				<xs:annotation>
					<xs:documentation>Task to collect data to determine or confirm the identity of a spacecraft.  Could be used in multi-object cases to request object-by-object identification to discriminate among closely-spaced objects (e.g., in a multi-payload launch).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STRUCTURE_CHANGE_DETECTION">
				<xs:annotation>
					<xs:documentation>Check for a change in object structure down to a component size appropriate to the specified resolution.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONS_CHANGES">
				<xs:annotation>
					<xs:documentation>Indicates a task to check for changes in patterns of observables that indicate potential changes to operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitAltitudeEnum" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the name of an orbit altitude range.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LOW">
				<xs:annotation>
					<xs:documentation>Apogee is nominally at least 160 km (100 miles), but less than 2000 km (1240 miles) in altitude above the WGS 84 oblate spheroid.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MED">
				<xs:annotation>
					<xs:documentation>Apogee is nominally at least 2000 km (1240 miles), but less than 35,786 km (22,336 miles) in altitude above the WGS 84 oblate spheroid.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HIGH">
				<xs:annotation>
					<xs:documentation>Apogee is nominally at or greater than 35,786 km (22,336 miles) in altitude above the WGS 84 oblate spheroid.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_EARTH">
				<xs:annotation>
					<xs:documentation>The central body of the orbit is no longer the Earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitChangeCapabilityEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the type of orbital maneuver.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPECIFIC_ORBIT">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in a custom orbit defined by its orbital elements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPECIFIC_POSITION">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in an orbit that places the spacecraft in the specified position with a given radial tolerance.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in the orbit and position of a satellite closely matching those of another satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY_OPERATIONS">
				<xs:annotation>
					<xs:documentation>Indicates a phase of a rendezvous maneuver in which a satellite approaches another satellite more closely.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LONGITUDE_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in a geosynchronous orbit that places the satellite at the specified longitude (orbital slot).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEMIMAJOR_AXIS_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes the satellite's orbital semi-major axis.  For circular orbits, this is equivalent to a change in orbital altitude.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INCLINATION_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes plane of the satellite's orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ECCENTRICITY_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes the eccentricity of the satellite's orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RACETRACK">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that places the satellite in a racetrack orbit about the specified longitudes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitClassEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the class of an orbit regime and are secondary descriptions of orbits within a regime.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CIRCULAR">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is less than or equal to 0.005.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELLIPTICAL">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 0.005 and less than or equal to 0.25.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HIGHLY_ELLIPTICAL">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 0.25 and less than 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PARABOLIC">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is exactly 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HYPERBOLIC">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_SYNCHRONOUS">
				<xs:annotation>
					<xs:documentation>An orbit where the orbit normal vector of the spacecraft is always oriented toward the Sun.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POLAR">
				<xs:annotation>
					<xs:documentation>An orbit that passes directly over the North and South Poles of the central body. The inclination is 90 degrees +/- 5 degrees.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RETROGRADE">
				<xs:annotation>
					<xs:documentation>An orbit whose inclination is greater than 90 degrees.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEMI_SYNCHRONOUS">
				<xs:annotation>
					<xs:documentation>An orbit whose orbit period is roughly half of the length of time of a sideral day of the central body.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L1">
				<xs:annotation>
					<xs:documentation>An orbit at the L1 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L2">
				<xs:annotation>
					<xs:documentation>An orbit at the L2 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L3">
				<xs:annotation>
					<xs:documentation>An orbit at the L3 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L4">
				<xs:annotation>
					<xs:documentation>An orbit at the L4 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L5">
				<xs:annotation>
					<xs:documentation>An orbit at the L5 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L1">
				<xs:annotation>
					<xs:documentation>An orbit at the L1 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L2">
				<xs:annotation>
					<xs:documentation>An orbit at the L2 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L3">
				<xs:annotation>
					<xs:documentation>An orbit at the L3 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L4">
				<xs:annotation>
					<xs:documentation>An orbit at the L4 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L5">
				<xs:annotation>
					<xs:documentation>An orbit at the L5 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MOLNIYA">
				<xs:annotation>
					<xs:documentation>A special case of a highly elliptical orbit with an inclination of 63.4 degrees (or 116.6 deg for Southern hemisphere apogee), an argument of perigee of 270 deg (or 90 deg for Southern hemisphere apogee), an eccentricity of about 0.74, and an orbit period of about 12 hours.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>An unknown or unidentified orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>An exquisite orbit that does not fit any of the other specified orbit classes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitConjunctionAssessmentEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the type of conjunction assessment to perform.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPECIFIED_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment is limited to the specified object or objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPECIFIED_ON_DEBRIS">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment should be based on the specified orbital object or objects against all debris object or objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPECIFIED_ON_ALL">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment should be on all objects (including debris objects) within the specified criteria.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALL_ON_ALL">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment should be on all objects using all types of criteria.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ALL_ACTIVE_ON_ALL">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment should be on all active objects.  Active objects are those that have the ability to maneuver.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEBRIS_ON_DEBRIS">
				<xs:annotation>
					<xs:documentation>Indicates the conjunction assessment should be on debris objects only.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the type of orbit.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CIRCLE">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be circular or elliptical.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RACETRACK">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be a racetrack, two semicircles connected by straight lines.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be a figure eight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitKinematicsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of orbital kinematics representation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ORBITAL_ELEMENT_SET">
				<xs:annotation>
					<xs:documentation>Orbit kinematics is represented by a Two Line Element set (TLE_BaseType).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VECTOR_COVARIANCE_MATRIX">
				<xs:annotation>
					<xs:documentation>Orbit kinematics is represented by a Vector Covariance Matrix (OrbitalVCM_Type).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SINGLE_VECTOR">
				<xs:annotation>
					<xs:documentation>Orbit kinematics is represented by a Single Vector (OrbitalKinematicsChoiceType).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ORBITAL_EPHEMERIS">
				<xs:annotation>
					<xs:documentation>Orbit kinematics is represented by an orbital ephemeris (OrbitalEphemerisChoiceType).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER_SEQUENCE">
				<xs:annotation>
					<xs:documentation>Orbit kinematics is represented by an Orbit Maneuver sequence (OrbitManeuverType).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitPlanManeuverTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The type of orbital maneuver.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ALTITUDE_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes the satellite's orbital altitude.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLANE_CHANGE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that changes plane of the satellite's orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAINTENANCE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that positions the satellite for maintenance operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STATION_KEEPING">
				<xs:annotation>
					<xs:documentation>Indicates kinematic changes, possibly of a magnitude less than what is technically a maneuver, with the purpose of maintaining its current orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in the orbit and position of a satellite closely matching those of another satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY_OPERATIONS">
				<xs:annotation>
					<xs:documentation>Indicates a phase of a rendezvous maneuver in which a satellite approaches another satellite more closely.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLLISION_AVOIDANCE">
				<xs:annotation>
					<xs:documentation>Indicates an urgent maneuver is necessary to avoid a potential collision with another Space object.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="THREAT_MITIGATION">
				<xs:annotation>
					<xs:documentation>Indicates an urgent maneuver is necessary to avoid a known threat.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEORBIT">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that will dispose of a satellite at the end of its useful life.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MOMENTUM_DUMP">
				<xs:annotation>
					<xs:documentation>Indicates kinematic changes, of a magnitude less than what is technically a maneuver, to maintain attitude control by desaturating reaction wheels without affecting overall momentum.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LAUNCH_TRANSFER_AND_INIT">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitPlanPartsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the kinds of orbit plan parts that make up a OrbitPlan.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOMINAL">
				<xs:annotation>
					<xs:documentation>Indicates a nominal orbit sequence.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANEUVER">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver orbit sequence.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STATION_KEEPING">
				<xs:annotation>
					<xs:documentation>Indicates the orbit plan includes propulsion actions to maintain the satellites orbit.  In order for space systems to maintain in their current orbit, intermittent "burns" (propulsion actions) are performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTITUDE">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in the satellite modifying its attitude without modifying its position.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RENDEZVOUS">
				<xs:annotation>
					<xs:documentation>Indicates a maneuver that results in the orbit and position of a satellite closely matching those of another satellite.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROXIMITY_OPERATIONS">
				<xs:annotation>
					<xs:documentation>Indicates a phase of a rendezvous maneuver in which a satellite approaches another satellite more closely.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitQualitativeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element includes other qualitative types of regions in space such as Space weather related zones.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AURORAL_REGIONS">
				<xs:annotation>
					<xs:documentation>Indicates portions of the ionosphere at high geomagnetic latitudes where scintillation is strong.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POLAR_REGIONS">
				<xs:annotation>
					<xs:documentation>Indicates portions of the ionosphere at high geomagnetic latitudes where scintillation is strong.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_LIT_HEMISPHERE">
				<xs:annotation>
					<xs:documentation>Indicates the sun lit hemisphere of the Earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitRegimeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the name of an orbit regime which are mostly altitude-based and are in line with traditional terminology (e.g., LEO, MEO, and GEO).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LEO">
				<xs:annotation>
					<xs:documentation>Low Earth Orbit. An Earth-centered orbit whose apogee altitude is greater than or equal to 160 km and less than 2000 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MEO">
				<xs:annotation>
					<xs:documentation>Medium Earth Orbit. An Earth-centered orbit whose apogee altitude is greater than or equal to 2000 km and less than 35,786 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEO">
				<xs:annotation>
					<xs:documentation>Geosynchronous Orbit. An Earth-centered orbit whose perigee and apogee altitudes are both 35,786 km +/- 100 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GSO">
				<xs:annotation>
					<xs:documentation>Geostationary Orbit. An Earth-centered orbit that is a special case of a GEO where the inclination is less than 1 degree or greater than 179 degrees so that the object remains approximately over the same point on Earth throughout its orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUPER_SYNCHRONOUS_GEO">
				<xs:annotation>
					<xs:documentation>Super-synchronous GEO. An Earth-centered orbit whose apogee altitude is greater than 35,786 km and whose perigee altitude is less than 35,786 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CISLUNAR">
				<xs:annotation>
					<xs:documentation>An Earth-centered orbit whose apogee radius is less than 385,000 km (about 60 Earth radii) and whose perigee radius is greater than 42,164 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GTO">
				<xs:annotation>
					<xs:documentation>Geosynchronous Transfer Orbit. An elliptical Earth-centered orbit whose apogee altitude is near 35,786 km (within 100 km).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LUNAR">
				<xs:annotation>
					<xs:documentation>A Moon-centered orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERPLANETARY">
				<xs:annotation>
					<xs:documentation>A Sun-centered orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERSTELLAR">
				<xs:annotation>
					<xs:documentation>An orbit beyond the gravitational influence of the Sun.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>An unknown or unidentified orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitValidationErrorEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates why an Orbit Sequence is invalid.  See individual enumerations for more details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ALTITUDE_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because it would result in an undesired change in altitude which could result in potentially catastrophic consequences.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ATTITUDE_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because the orientation of a payload, which could result in potentially catastrophic consequences.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BETA_ANGLE_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of limitations related to the beta angle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONTACT_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of a communication issue due to loss of telemetry, ground site contact limitations, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENVIRONMENTAL_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of external environmental factors such as solar weather, gravitational perturbations, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FLIGHT_RULES_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of flight rules limitations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FUEL_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of fuel limitations which could result in potentially catastrophic consequences.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INCLINATION_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily due to inclination limitations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SATELLITE_LIMITATIONS">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because of limitations related to the physical satellite such as constraints related to the bus, payload, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REQUIRED_INPUT_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily because a required field somewhere was forgotten, or not filled in.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN_ERROR">
				<xs:annotation>
					<xs:documentation>Indicates the orbit was rejected, failed, or generally can't be completed satisfactorily due to an unkown issue.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrderOfBattleEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the Order of battle data. From MIDB the associated values are [ABCDEGJMNSX] Position 3, OB_TYPE     A Air Force     B Joint Forces     C Civilian     D Defensive Missile Forces     E Net     G Army     J Space Order of Battle (SOB)     M Ministry, Other Than Ministry of Defense (MOD)     N Navy     S Strategic Missile Forces     X Air Defense Order of Battle (ADOB). not all are represented here.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR_FORCE">
				<xs:annotation>
					<xs:documentation>Specifies the Air Force Order of Battle (in MIDB equates to A).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JOINT_FORCE">
				<xs:annotation>
					<xs:documentation>Specifies the Joint Forces Order of Battle (in MIDB equates to B).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CIVILIAN">
				<xs:annotation>
					<xs:documentation>Specifies the Civilian Order of Battle (in MIDB equates to C).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEFENSIVE_MISSILE_FORCE">
				<xs:annotation>
					<xs:documentation>Specifies the Defensive Missile Forces Order of Battle (in MIDB equates to D).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NET">
				<xs:annotation>
					<xs:documentation>Specifies the Net Order of Battle (in MIDB equates to E).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARMY">
				<xs:annotation>
					<xs:documentation>Specifies the Army/Ground Order of Battle (in MIDB equates to G).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE">
				<xs:annotation>
					<xs:documentation>Specifies the Space Order of Battle (SOB) (in MIDB equates to J).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MINISTRY">
				<xs:annotation>
					<xs:documentation>Specifies the Ministry (other than Ministry of Defense) Order of Battle (in MIDB equates to M).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
