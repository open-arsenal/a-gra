				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AVAILABLE">
				<xs:annotation>
					<xs:documentation>RF Thread is currently available for allocation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
