		<xs:choice>
			<xs:element name="Split" type="uci:EntityManagementSplitType">
				<xs:annotation>
					<xs:documentation>Indicates a request to split one or more Entities from a multi-contributor Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Merge" type="uci:EntityManagementMergeType">
				<xs:annotation>
					<xs:documentation>Indicates a request to merge two or more Entities into a single Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Drop" type="uci:EntityManagementDropType">
				<xs:annotation>
					<xs:documentation>Indicates a request to drop/remove an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetDropRestriction" type="uci:EntityManagementDropRestrictType">
				<xs:annotation>
					<xs:documentation>Indicates a request to add a drop restriction to an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClearDropRestriction" type="uci:EntityManagementDropRestrictType">
				<xs:annotation>
					<xs:documentation>Indicates a request to remove an existing drop restriction from an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Swap" type="uci:EntityManagementSwapType">
				<xs:annotation>
					<xs:documentation>Indicates a request to swap the characteristics between two Fused Entities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetFusionEligibility" type="uci:EntityManagementSetFusionEligibilityType">
				<xs:annotation>
					<xs:documentation>Indicates a request to set the fusion eligibility of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetIdentity" type="uci:EntityManagementSetIdentityType">
				<xs:annotation>
					<xs:documentation>Indicates a request to set the identity of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClearIFF" type="uci:EntityManagementClearIdentityType">
				<xs:annotation>
					<xs:documentation>Reset the specified identity field to the default value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetDownLocation" type="uci:EntityManagementDownType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the DownLocation of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetKinematics" type="uci:EntityManagementKinematicsType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Kinematics of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetMode" type="uci:EntityManagementSetModeType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Mode of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetActivityBy" type="uci:EntityManagementSetActivityByType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Activities of an Entity. The new list of Activities replaces the existing list for the entity. An empty list clears all Activities for the entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetStrength" type="uci:EntityManagementSetStrengthType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Strength of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetPlatformStatus" type="uci:EntityManagementSetPlatformStatusType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the PlatformStatus of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetEndurance" type="uci:EntityManagementSetEnduranceType">
				<xs:annotation>
					<xs:documentation>Set the endurance of an entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetLink16Metadata" type="uci:EntityManagementSetLink16MetadataType">
				<xs:annotation>
					<xs:documentation>Indicates a request to modify the Link16Metadata of an Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProposeCorrelation" type="uci:EntityManagementProposeCorrelationType">
				<xs:annotation>
					<xs:documentation>This one choice may be sent by fusion and read by data links. Data links are expected to drop any requests with other choices filled in, and fusion is expected to drop any requests with this choice populated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetVoiceControl" type="uci:EntityManagementSetVoiceControlType">
				<xs:annotation>
					<xs:documentation>Set the voice control frequency of an entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetCapability" type="uci:EntityManagementSetCapabilityType">
				<xs:annotation>
					<xs:documentation>Adds or removes capabilities from an Entity. The new list of capabilities replaces the existing list for the entity. An empty list clears all capabilities for the entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SetSignalSummary" type="uci:EntityManagementSetSignalSummaryType">
				<xs:annotation>
					<xs:documentation>Set the signalSummary of an entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
