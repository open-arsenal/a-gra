	<xs:simpleType name="ModulationEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the type of signal modulation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AM">
				<xs:annotation>
					<xs:documentation>Indicates amplitude modulation. Information is added to a carrier frequency by varying the amplitude of the RF energy.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODULATION_A">
				<xs:annotation>
					<xs:documentation>Correlates to COARPs specific Modulation A.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MODULATION_B">
				<xs:annotation>
					<xs:documentation>Correlates to COARPs specific Modulation B.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FM">
				<xs:annotation>
					<xs:documentation>Indicates frequency modulation. Information is added to a carrier wave by varying the carrier's center frequency.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PM">
				<xs:annotation>
					<xs:documentation>Indicates phase modulation. The information wave is added to the carrier frequency by changing the phase relationship within the carrier sine wave.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TONEAM">
				<xs:annotation>
					<xs:documentation>Indicates a tone AM modulation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TONEFM">
				<xs:annotation>
					<xs:documentation>Indicates a tone FM modulation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PSK">
				<xs:annotation>
					<xs:documentation>Indicates phase shift keying.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BPSK">
				<xs:annotation>
					<xs:documentation>Indicates binary PSK, using M=2 symbols.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="QPSK">
				<xs:annotation>
					<xs:documentation>Indicates quadrature PSK using M=4 symbols.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PSK8">
				<xs:annotation>
					<xs:documentation>Indicates PSK using M=8 symbols.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PSK16">
				<xs:annotation>
					<xs:documentation>Indicates PSK using M=16 symbols.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PSK32">
				<xs:annotation>
					<xs:documentation>Indicates PSK using M=32 symbols.</xs:documentation>
