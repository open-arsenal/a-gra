	<xs:simpleType name="PO_CapabilityEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>The enumeration of all capabilities that a Passive Optical sensor may support.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SPOT_IMAGE">
				<xs:annotation>
					<xs:documentation>Specifies that images are to be or have been collected.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AREA_IMAGE">
				<xs:annotation>
					<xs:documentation>This capability indicates that this payload has the ability to image an area on a surface, e.g. the surface of the earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LINE_SWEEP">
				<xs:annotation>
					<xs:documentation>This capability indicates that this payload has the ability to sweep an area on a surface, e.g. the surface of the earth.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FULL_MOTION_VIDEO">
				<xs:annotation>
					<xs:documentation>Specifies that the sensor is capable to or has collected full motion video for a designated area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FOCUS_SWEEP">
				<xs:annotation>
					<xs:documentation>Specifies that a focus sweep is to be or has been performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_VOLUME">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the sensor has the ability to search a 3D area.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_CUED">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the sensor has the ability to search a 3D area around a cued location.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH_ATR">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the sensor has the ability to search a 3D area and can automatically pick out specific targets of interest.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK_SINGLE">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the sensor has the ability to track a single target which it is given via a single cue or Entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK_MULTI">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the sensor has the ability to track multiple targets which it is given via multiple cues or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CALIBRATE">
				<xs:annotation>
					<xs:documentation>Specifies that a calibration sweep is to be or has been performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>Specifies that a search for targets is to be performed using the collected image data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TARGET_CLASSIFICATION">
				<xs:annotation>
					<xs:documentation>Specifies that an identification for targets is to be performed using the collected image data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Specifies that a tracking of targets is to be performed using the collected image data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AUTO_CUE">
				<xs:annotation>
					<xs:documentation>This capability indicates that this payload has the ability to cue itself to image some target. For example, if the payload was searching for a target or targets and found it, that payload might want to "automatically" take more images of the area where the target was found.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PERSISTENT_IMAGING">
				<xs:annotation>
					<xs:documentation>This capability indicates that this payload has the ability to revisit the same target for as long as the pitch range allows.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANOMALY_DETECTION">
				<xs:annotation>
					<xs:documentation>This capability indicates that this payload has the ability to detect anomalies in the scene (e.g. in the terrain).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VISUAL_MAGNITUDE_MEASUREMENT">
				<xs:annotation>
					<xs:documentation>Indicates a Capability to measure and report a particular orbiting object's optical visual magnitude.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SOB_CORRELATION">
				<xs:annotation>
					<xs:documentation>Indicates a Capability to identify the kind and/or instance of a particular orbiting object and report it in relation to a known catalog and/or space order of battle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_CollectionConstraintsEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>The enumeration of all collection constraints that may apply to a Passive Optical sensor.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MAP_ANGLE">
				<xs:annotation>
					<xs:documentation>True Map Angle. The true map angle is defined in the Northeast Down (NED) coordinate system with the origin at the aircraft (aircraft local NED) as the angle between the scene entry line of sight and the instantaneous aircraft track heading vector. The aircraft track heading vector is obtained by rotating the north unit vector of the aircraft local NED coordinate system in the aircraft local NE plane through the aircraft track heading angle.  This angle is always positive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GRAZING_ANGLE">
				<xs:annotation>
					<xs:documentation>The angle at the target between the plane of the terrain and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling ElevationAngleConstraints.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOOKAHEAD_ANGLE">
				<xs:annotation>
					<xs:documentation>The angle from true north to the line-of-sight vector from the sensor to the target tangent plane.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELEVATION_ANGLE">
				<xs:annotation>
					<xs:documentation>The angle at the target between the flat surface (ellipsoid surface ignoring terrain) and the line of sight to the sensor.  If the slope of the terrain is zero, this element is equivalent to the sibling GrazingAngleConstraints.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SLANT_RANGE">
				<xs:annotation>
					<xs:documentation>Distance from the sensor reference point (e.g. aperture reference point) to the ground reference point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLLECTION_PATTERN">
				<xs:annotation>
					<xs:documentation>This element defines the type of pattern that a vehicle should use to collect over a large area.  This can be specified when creating Tasks to collect over OpZones, ZoneTargets, Entities (which have been specified as zones), etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_ELEVATION">
				<xs:annotation>
					<xs:documentation>The angle from the target plane at intersection of the optical line of sight with the earth's surface at the time of the first image line.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_AZIMUTH">
				<xs:annotation>
					<xs:documentation>The angle from True North clockwise (as viewed from space) at the time of the first image line.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SWEEP_SPEED">
				<xs:annotation>
					<xs:documentation>The rate at which the sensor look-point moves across the terrain.  This is only applicable to area or line targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GIMBAL_ORIENTATION">
				<xs:annotation>
					<xs:documentation>The orientation of the gimbal with respect to its reference frame.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_EnvironmentEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This enumeration provides additional environment information about the area of interest that the sensor is currently processing.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over air.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over ground.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MARITIME">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE">
				<xs:annotation>
					<xs:documentation>This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over Space.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_BALANCED">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of ground and marine algorithms. This specific enumeration value provides additional information to the sensor indicating that the area of interest represents a fairly equal amount of water and land.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_AIR_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans an air/Space boundary and the area will have to be covered by a mixture of air and Space algorithms. This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over air.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_GROUND_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of ground and marine algorithms. This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over ground.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_MARITIME_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans a shoreline boundary and the area will have to be covered by a mixture of ground and marine algorithms. This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over water.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MIXED_SPACE_DOMINANT">
				<xs:annotation>
					<xs:documentation>Indication that the area of interest spans an air/Space boundary and the area will have to be covered by a mixture of air and space algorithms. This specific enumeration value provides additional information to the sensor indicating that the area of interest is predominantly over Space.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_FilterEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all filter types supported by a Passive Optical sensor.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SHUTTER">
				<xs:annotation>
					<xs:documentation>A filter which blocks light of any frequency.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CLEAR">
				<xs:annotation>
					<xs:documentation>A filter that lets through light of any frequency, primarily used to protect the lens.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LASER_PROTECT">
				<xs:annotation>
					<xs:documentation>A filter that blocks lasers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BANDPASS">
				<xs:annotation>
					<xs:documentation>A filter which allows light that falls within some frequency range to pass through.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTI_FLARE">
				<xs:annotation>
					<xs:documentation>A filter that reduces flare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>Indicates the Passive Optical filter does not fall into any of the categories listed here.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_FPA_ChannelOperationEnum" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all capabilities that a Passive Optical sensor's FPA channel may support.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="BAND_RANGE">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of modifying the range of frequencies of photons that they will collect and measure. This capability is rare since the channel's band is usually a result of the process used to manufacture the FPA and is therefore fixed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PIXEL_AGGREGATION">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability can change the way pixel values are computed. Normally the reported pixel value is directly related to the number of photons collected in one of the FPA's collection buckets. Some FPAs support the ability to aggregate buckets when generate the pixel value. For example, instead of using a single bucket, 2 or 4 buckets are used (linear arrays) or a 2x2 or a 4x4 set of buckets are used.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_DELAY_INTEGRATION">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability can increase their sensitivity to the arriving photons by adding a "time" dimension to the FPA and then moving the collection buckets along that time dimension as the collection is performed. This basically increases the length of time photons are collected generally without increasing any smear in the image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PIXEL_SCALING">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of enhancing the value of the pixels it returns by specifying a "offset" that is applied to the measurement that increases the brightness of the pixel and a "gain" that is used to increase the channels sensitivity. For such channels, the resulting pixel value is computed as "offset + (gain * measuredValue)".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PIXEL_POLARITY">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of the Focal Plane Arrays (FPA) to specify whether a zero pixel value represents "hot" or "cold". This capability is generally only available with FPAs that measure photons in the infrared frequencies.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLLECTION_TIME">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of modifying the length of time used by a channel to measure arriving photons. Increasing this value increases the channel's sensitivity but also increases the smear in the generated pixels. Setting this length of time is generally depending on how fast the sensor's line of sight (LOS) is moving across the surface being imaged.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_UNIFORMITY_CORRECTION">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of correcting differences in sensitivity between the FPA's collection elements. Theoretically, each collection element within a FPA should have the same sensitivity as all other collection elements within the FPA. However due to limits in the manufacturing process, this is never the case. To correct this defect in the manufacturing process, FPAs may contain logic to adjust this "non-uniformity" such that resulting measurements appear as if they were made from a totally uniform FPA.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SCAN_DIRECTION">
				<xs:annotation>
					<xs:documentation>FPA channel's having this capability support the ability of changing the direction pixels are read out of a FPA. Data from an FPA is generally read out as a line of data. For example, with a line array, the generated pixels can be read out of the array either starting from the left side of the array or the right side of the array.   The ability to set which element is reported first is especially useful in generating images having the correct orientation, i.e. which side of the array is up. This orientation is dependent upon which side of the aircraft the sensor is point at, the left or right side of the plane. Setting this scan direction makes sure the pixels are always returned in the proper orientation regardless of which side of the aircraft the sensor is pointing at.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_GimbalOrientationReferenceFrameEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all reference frames that the gimbal's orientation may be in referenced to.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="REFERENCE_FRAME_GIMBAL">
				<xs:annotation>
					<xs:documentation>This reference frame is defined with respect to the coordinate frame of the gimbal. The orientation of this reference frame with respect to other reference frames can be described by the InstallationDetails in the SubsystemConfiguration and/or ComponentConfiguration messages associated with the sibling Component_ID.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REFERENCE_FRAME_PLATFORM">
				<xs:annotation>
					<xs:documentation>This reference frame is defined with respect to the coordinate frame of the platform.  The Roll-axis is positive in the forward direction of the vehicle (e.g. aircraft nose).  The Pitch-axis is positive to the right of the forward direction of the vehicle (e.g. aircraft right wing).  The Yaw-axis is positive down through the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_LockPersistenceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates what the tracker does when the target is lost.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="REACQUIRE">
				<xs:annotation>
					<xs:documentation>Command to the target tracker to continuously try to reacquire on a target if the target is lost.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BREAK">
				<xs:annotation>
					<xs:documentation>Command to the target tracker to break lock on a target if the target is lost.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_MessageOutputsEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The enumeration of all message output types of Passive Optical Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PO_ACTIVITY">
				<xs:annotation>
					<xs:documentation>Indicates dynamic status for the Capability will be reported via its associated Activity message. For example, the PO_Activity message for a PO Capability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENTITY">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the Entity message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRODUCT_METADATA_LOCATION">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via products described by ProductMetadata and ProductLocation messages.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSERVATION_MEASUREMENT_REPORT">
				<xs:annotation>
					<xs:documentation>Indicates results of the Capability will be reported via the ObservationMeasurementReport message.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_ProcessingStageTypeEnum" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>The enumeration of all processing stages that can be included in a passive optical sensor.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PIXEL_SCALING">
				<xs:annotation>
					<xs:documentation>The pixels that make up the final images which are generated from the raw optical data can be further processed to enhance images brightness and contrast. This is accomplished by computing a new pixel value from the original pixel value using the following formula "newPixelvalue = offset + (gain * origPixelValue)" where the gain and offset are either set automatically or manually.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HSB_COLOR_CONTROL">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to modify an image's color via hue, saturation and/or brightness.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RGB_COLOR_CONTROL">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to modify an image's color via red, green, blue settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GAMMA_CORRECTION">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to perform a gamma correction on an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHARPNESS">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to sharpen an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EDGE_ENHANCEMENT">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to enhance the edges within an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COMPOSITING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to composite multiple images (generally generated from different optical bands) into a single image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GOOGLE_EARTH_MAPPING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to map an image onto a Google Earth map.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DTD_MAPPING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to map an image onto a DTD map.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELECTRONIC_ZOOMING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to electronically zoom into or out of an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOISE_FILTERING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to remove noise in an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPATIAL_FILTERING">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is used to spatially filter an image.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMAGE_ENHANCEMENT">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is some proprietary or special general image enhancement stage.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>An image processing stage of this type is one that has not yet been enumerated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_TechniqueEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the passive optical search and track techniques.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TARGET_CLASSIFICATION">
				<xs:annotation>
					<xs:documentation>Detects targets and classifies them based on their features.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANOMALY_DETECTION">
				<xs:annotation>
					<xs:documentation>Detects changes between specified images.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOT_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks hot objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NEUTRAL_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks temperate objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="COLD_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks cold objects.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PATTERN_TRACK">
				<xs:annotation>
					<xs:documentation>A specialized track technique to track various patterns based on the sensor algorithms.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POINT_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks point source targets within the Field of view of the sensor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EDGE_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks target edges.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SCENE_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks an area within the field of view of the sensor based on the scene content.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEO_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks geodetic locations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INERTIAL_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks with a fixed LOS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LASER_TRACK">
				<xs:annotation>
					<xs:documentation>Tracks laser designated targets.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OBSTACLE_DETECTION">
				<xs:annotation>
					<xs:documentation>Detects obstacles in the flight path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REGISTRATION">
				<xs:annotation>
					<xs:documentation>Compares adjacent frames looking for fast movers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="REGISTRATION_STRIDE">
				<xs:annotation>
					<xs:documentation>Compares frames a stride number apart looking for slow movers.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CONSTELLATION">
				<xs:annotation>
					<xs:documentation>Tracks a set of points indicative of a larger entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFFSET_TRACK">
				<xs:annotation>
					<xs:documentation>Offsets the track of a target from the center of the subsystem LOS.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_TrackCapabilityTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Commanded values supported for track parameters that are available for a capability and can be used to customize target detections.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="COMMAND_TRACK_MODE">
				<xs:annotation>
					<xs:documentation>Command option in the target tracker to attempt to acquire a target, lock onto the target, or release the target and stop tracking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK_AREA_CONTROL">
				<xs:annotation>
					<xs:documentation>Command option to adjust the size of the area in which the target tracker tries to acquire a target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK_LOCK_PERSISTENCE">
				<xs:annotation>
					<xs:documentation>Indicates whether capability supports Lock Persistence option in Track Details.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PO_TrackCommandEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Commands the tracker to an acquisition state.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACQUIRE">
				<xs:annotation>
