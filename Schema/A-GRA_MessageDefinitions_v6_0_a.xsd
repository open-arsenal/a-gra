	<xs:complexType name="ActionPlanMDT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ActionPlanID" type="uci:ActionPlanID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the ActionPlan.  Minor updates to the Plan can be indicated by an update of the value in the child Version element.  More significant updates, replacements, etc. might warrant a new Plan with a different child UUID value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlanCommandID" type="uci:ActionPlanCommandID_ChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the *PlanCommand which this ActionPlan originated from.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Plan" type="uci:ActionPlanType">
				<xs:annotation>
					<xs:documentation>Indicates the details of the ActionPlan.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForPlanningUseOnly" type="xs:boolean">
				<xs:annotation>
