			</xs:element>
			<xs:element name="FPA_ID" type="uci:PO_FPA_ID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Processing stages process the optical data produced by one or more Focal Plane Arrays (FPAs). This field specifies those FPAs whose generated data is processed by this stage. This information is useful in identifying which processing stage to configure if required.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProcessingStageControlsStatus" type="uci:ComponentControlsStatusType">
				<xs:annotation>
					<xs:documentation>Indicates the status of the processing stage's controls. An enabled processing stage will be used in the processing of the image data.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Settings" type="uci:PO_ComponentStatusProcessingStageSettingsType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the settings for this processing stage.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PO_ComponentStatusProductGeneratorSettingsType" uci:version="002.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
