			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RecommendedWeaponsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Quantity" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the number of weapons (of the type specified in the Weapon element) available for designation to the specified target/Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreType">
				<xs:annotation>
					<xs:documentation>Indicates a type of weapon available for designation to the specified target/Entity. This element represents the MIL-STD-6016-specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReconnaissanceStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemType" type="uci:RECCE_SystemEnum">
				<xs:annotation>
					<xs:documentation>The type of reconnaissance system installed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemStatus" type="uci:CapabilityAvailabilityEnum">
				<xs:annotation>
					<xs:documentation>Status of the reconnaissance system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RectangleType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Dimensions and orientation of a rectangular or square shape.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Width" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Size of the rectangle perpendicular to the orientation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Height" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Size of the rectangle parallel to the orientation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>This element represents the orientation as the angle between the height axis and true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RectangularConeType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type describes the geometric parameters of a rectangular cone.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Length" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Angle in radians from the boresight to the longer edge of the rectangular cone.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Width" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Angle in radians from the boresight to the shorter edge of the rectangular cone.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Range" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the range from the vertex to the end of the cone.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
