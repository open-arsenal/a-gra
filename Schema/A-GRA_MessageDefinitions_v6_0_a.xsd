				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STR">
				<xs:annotation>
					<xs:documentation>Storage; preparation required prior to operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="O">
