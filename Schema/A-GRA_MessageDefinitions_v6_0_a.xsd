	<xs:simpleType name="GravityModelEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Specifies the type of gravity model that a propagator may use to represent the central body's gravitational forces.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EGM96">
				<xs:annotation>
					<xs:documentation>The Earth Gravitational Model 1996 (EGM-96) is a geopotential model of the Earth consisting of spherical harmonic coefficients derived from many data regions of the globe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EGM2008">
				<xs:annotation>
					<xs:documentation>The Earth Gravitational Model 2008 (EGM-2008) is a geopotential model of the Earth consisting of spherical harmonic coefficients derived from many data regions of the globe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EGM2020">
				<xs:annotation>
					<xs:documentation>The Earth Gravitational Model 2020 (EGM-2020) is a geopotential model of the Earth consisting of spherical harmonic coefficients derived from many data regions of the globe.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WGS84">
				<xs:annotation>
					<xs:documentation>Specifies the propagation model in terms of the WGS-84 ellipsoid.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WGS72">
				<xs:annotation>
					<xs:documentation>Specifies the propagation model in terms of the WGS-72 ellipsoid to predict orbital data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JGM1">
				<xs:annotation>
					<xs:documentation>The Joint Gravity Model (JGM) is a type of propagation model that combines existing gravity models and other tracking data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JGM2">
				<xs:annotation>
					<xs:documentation>The Joint Gravity Model (JGM) is a type of propagation model that combines existing gravity models and other tracking data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JGM3">
				<xs:annotation>
					<xs:documentation>The Joint Gravity Model (JGM) is a type of propagation model that combines existing gravity models and other tracking data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEM_T3">
				<xs:annotation>
					<xs:documentation>The Goddard Earth Model (GEM-T3) is a geopotential model of the Earth's gravitational field developed from satellite tracking, altimeter and surface gravimetric data.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GL0660B">
				<xs:annotation>
