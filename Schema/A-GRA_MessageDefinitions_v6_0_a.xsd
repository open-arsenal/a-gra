	<xs:complexType name="TurretReportMDT" uci:version="002.001.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TurretReportID" type="uci:TurretReportID_Type">
				<xs:annotation>
					<xs:documentation>Indicates a unique ID assigned to the TurretReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SupportCapabilityID" type="uci:SupportCapabilityID_Type">
