					<xs:documentation>Date/Time stamp, in Zulu format, at which the Spectral Density data begins.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EndTimestamp" type="uci:DateTimeType" minOccurs="0">
